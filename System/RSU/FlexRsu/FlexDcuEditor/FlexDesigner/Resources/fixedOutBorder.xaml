<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FlexDesigner">
  
  <local:fixed_out_find x:Key="_fixed_out_find"/>

  <Style TargetType="Border" x:Key="fixedOutBorderBlack">
    <Setter Property="BorderBrush" Value="Black"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Path=(local:DesignerItem.HiddenProperties), Converter={StaticResource _fixed_out_find}, ConverterParameter=2, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" Value="0" >
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)" From="Black" To="Blue" Duration="00:00:00.4" RepeatBehavior="Forever" AutoReverse="True"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <!--<Setter Property="BorderBrush" Value="Blue"/>-->
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=(local:DesignerItem.HiddenProperties), Converter={StaticResource _fixed_out_find}, ConverterParameter=2, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}" Value="1" >
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)" From="Black" To="Red" Duration="00:00:00.4" RepeatBehavior="Forever" AutoReverse="True"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <!--<Setter Property="BorderBrush" Value="Red"/>-->
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>