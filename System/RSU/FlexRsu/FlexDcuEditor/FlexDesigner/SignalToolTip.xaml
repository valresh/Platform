<UserControl x:Class="FlexDesigner.SignalToolTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexDesigner"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid Grid.Row="2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
      <TextBlock Padding="10,0,10,0" Text="{Binding Path=srcValue, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl} }}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
      <TextBlock Padding="10,0,10,0" Text="{Binding Path=srcName, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl} }}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </StackPanel>
    <StackPanel Grid.Column="1">
      <TextBlock Padding="10,0,10,0" Text="{Binding Path=destValue, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl} }}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
      <TextBlock Padding="10,0,10,0" Text="{Binding Path=destName, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType={x:Type UserControl} }}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </StackPanel>
  </Grid>
</UserControl>
