<Expander IsExpanded="True" Header="T-Soft исследования" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                              xmlns:FlexDesigner="clr-namespace:FlexDesigner;assembly=FlexDesigner"
                                              xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
                                              xmlns:FlexelTSoftResearch="clr-namespace:FlexelTSoftResearch">
  <FlexDesigner:Toolbox ItemSize="60,60" Header="SKVO">
    <ItemsControl.Items>
      <Grid Width="60" Height="70" Background="LightBlue" x:Name="PidSKVO" FlexDesigner:DesignerItem.ShowItemName="True" FlexDesigner:DesignerItem.ShowExecOrder="True">
        <Grid.ToolTip>
          <TextBlock Text="Прогрессивный ПИД"/>
        </Grid.ToolTip>
        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="PidSKVO"/>
        <Border Width="50" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="PidSKVO"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,10 5,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,20 5,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,30 5,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,40 5,40"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,50 5,50"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,60 5,60"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,10 60,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,20 60,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,30 60,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,40 60,40"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,50 60,50"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,60 60,60"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="LOCK_IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,10"/>
              <FlexDesigner:Connector x:Name="INTERLOCK" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,20"/>
              <FlexDesigner:Connector x:Name="CAS_IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,30"/>
              <FlexDesigner:Connector x:Name="IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,40"/>
              <FlexDesigner:Connector x:Name="TRK_IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,50"/>
              <FlexDesigner:Connector x:Name="TRK_IND" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,60"/>
              <FlexDesigner:Connector x:Name="LOCK" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,10"/>
              <FlexDesigner:Connector x:Name="HH" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,20"/>
              <FlexDesigner:Connector x:Name="H" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,30"/>
              <FlexDesigner:Connector x:Name="OUT" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,40"/>
              <FlexDesigner:Connector x:Name="L" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,50"/>
              <FlexDesigner:Connector x:Name="LL" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,60"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
        <FlexDesigner:DesignerItem.HiddenProperties>
          <FlexDesigner:HiddenPropertiesContainer>
            <FlexDesigner:HiddenProperty Key="DESCR" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR1" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR2" Value=""/>
            <FlexDesigner:HiddenProperty Key="VALUE_FORMAT" Value="#.##"/>
            <FlexDesigner:HiddenProperty Key="EU" Value="%"/>
            <FlexDesigner:HiddenProperty Key="MODE" Value="0"/>
            <FlexDesigner:HiddenProperty Key="SP" Value="0"/>
            <FlexDesigner:HiddenProperty Key="P" Value="100"/>
            <FlexDesigner:HiddenProperty Key="I" Value="10"/>
            <FlexDesigner:HiddenProperty Key="MAXIMUM" Value="100"/>
            <FlexDesigner:HiddenProperty Key="MINIMUM" Value="0"/>
            <FlexDesigner:HiddenProperty Key="MAX_OUT" Value="100"/>
            <FlexDesigner:HiddenProperty Key="MIN_OUT" Value="0"/>
            <FlexDesigner:HiddenProperty Key="INVERSE" Value="1"/>
            <FlexDesigner:HiddenProperty Key="HH_LIM_PV" Value=""/>
            <FlexDesigner:HiddenProperty Key="H_LIM_PV" Value=""/>
            <FlexDesigner:HiddenProperty Key="L_LIM_PV" Value=""/>
            <FlexDesigner:HiddenProperty Key="LL_LIM_PV" Value=""/>
            <FlexDesigner:HiddenProperty Key="HYST" Value="1"/>
          </FlexDesigner:HiddenPropertiesContainer>
        </FlexDesigner:DesignerItem.HiddenProperties>
      </Grid>
        
    </ItemsControl.Items>
  </FlexDesigner:Toolbox>
</Expander>
  