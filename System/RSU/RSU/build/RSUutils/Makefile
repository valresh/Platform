QMAKE_TARGET  = RSUutils
DESTDIR       = ../../../../EXE/
TARGET        = libRSUutils.so.1.0.0
TARGETA       = ../../../../EXE/libRSUutils.a
TARGET0       = libRSUutils.so
TARGETD       = libRSUutils.so.1.0.0
TARGET1       = libRSUutils.so.1
TARGET2       = libRSUutils.so.1.0


first: all
####### Build rules

../../../../EXE/libRSUutils.so.1.0.0:  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d ../../../../EXE/ || mkdir -p ../../../../EXE/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) ../../../../EXE/$(TARGET)
	-$(MOVE) $(TARGET) ../../../../EXE/$(TARGET)
	-$(DEL_FILE) ../../../../EXE/$(TARGET0)
	-$(DEL_FILE) ../../../../EXE/$(TARGET1)
	-$(DEL_FILE) ../../../../EXE/$(TARGET2)
	-$(MOVE) $(TARGET0) ../../../../EXE/$(TARGET0)
	-$(MOVE) $(TARGET1) ../../../../EXE/$(TARGET1)
	-$(MOVE) $(TARGET2) ../../../../EXE/$(TARGET2)



staticlib: ../../../../EXE/libRSUutils.a

../../../../EXE/libRSUutils.a:  $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)

