		<table>
			<tableMenu/>
			<contextMenu/>
			<columns>
				<column id="Tree">
					<title>Tree</title>
					<action/>
					<menu/>
					<content>
						&lt;div noselect="" language="javascript" ondblclick="event.cancelBubble = this.noselect; return !this.noselect;" onmouseup="event.cancelBubble = this.noselect; return !this.noselect;" class="TreeNodeGroup" ExpandCollapseTrigger=0&gt;
							&lt;div language="javascript" class="TreeNodePlusMinus" onclick="event.cancelBubble = true;"
                                onmouseup="if( event.button == 0 ) { this.parentElement.setAttribute('ExpandCollapseTrigger', 1); event.cancelBubble = true; }"&gt;
                                    &lt;img class="PlusMinusIcon" src="Images/blank.gif" alt="PlusMinus"/&gt;
							&lt;/div&gt;
							&lt;div style="float:left; position:relative; width:21px; height:11px; margin:4px 0px 0px 0px;"
&gt;
								&lt;input type="checkbox" onclick="pinPaneViewModel.select(null, event);" /&gt;
							&lt;/div&gt;
							&lt;div class="TreeAssetIcon"&gt;
								&lt;img src="Images/blank.gif" alt="Icon"/&gt;
							&lt;/div&gt;
							&lt;div class="treeNodeLabel" onmouseenter="treeViewModel.mouseEnter(null, event);" onmouseleave="treeViewModel.mouseLeave(null, event);"&gt;&lt;/div&gt;
										&lt;/div&gt;
					</content>
					<bindings>
						<in fields="Depth" properties="style.pixelLeft" xforms="xfPadding" />
						<in fields="Depth" properties="style.visibility" xforms="xfDisabledVisible" />
						<in fields="NumChildren;Expanded" properties="firstChild.nextSibling.firstChild.nextSibling.src" xforms="xfPlusMinusImg" />
						<in fields="RemoteType;SubType;ItemNumber;Redundant;Flags" properties="firstChild.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling.firstChild.nextSibling.src" xforms="xfIconImg" />
						<in fields="EntityName;RemoteType;SubType;ItemNumber;Description" properties="lastChild.previousSibling.innerText" xforms="xfName" />
						<in fields="Selected;EntityName" properties="firstChild.nextSibling.nextSibling.nextSibling.firstChild.nextSibling.checked" xforms="xfSelectionToChecked"/>
						<in fields="FullName;Description;AssociatedAsset" properties="title" xforms="xfTitle" />
						<out properties="ExpandCollapseTrigger" fields="Expanded"/>
					</bindings>
				</column>
			</columns>
		</table>
	</TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
        <property name="Version">4.5</property>
        <property name="WaitForInit">0</property>
        <property name="WaitForSelectionList">0</property>
    </dataobject>
</datasource>
