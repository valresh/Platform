        <PROPERTY name="TemplateXML"><![CDATA[
<TableTemplate>
	<FieldXML>
		<fields>
			<field id="Selected"/>
			<field id="NodeHandle" rowId="true"/>
			<field id="Depth"/>
			<field id="Expanded"/>
			<field id="NumChildren"/>
			<field id="EntityName"/>
			<field id="FullName"/>
			<field id="Description"/>
			<field id="RemoteType"/>
			<field id="SubType"/>
			<field id="ItemNumber"/>
			<field id="Redundant"/>
			<field id="Assignable"/>
			<field id="Flags"/>
			<field id="AssociatedAsset"/>
			<field id="IsAssigned"/>
			<field id="HasFilteredEquipmentDescendents"/>
			<field id="TagName"/>
		</fields>
	</FieldXML>
	<XFormXML>
		<xforms>
			<defaultValue id="xfEmptyVariantToString" value="" type="string"/>
			<script id="xfIconImg" language="VBScript">
				Return = GetNodeImagePath(Value)
			</script>
			<script id="xfDisabledImg" language="VBScript">
				Return = GetDisabledImagePath(Value)
			</script>
			<script id="xfPadding" language="VBScript">
				if ( IsEmpty(Value) ) then
				    Return = 0
				else
				    Return = (Value - 1) * 16
				end if
			</script>
			<script id="xfPlusMinusImg" language="VBScript">
				if (IsEmpty(Value(0)) or (Value(0) = 0)) then
					Return = "Images/blank.gif"
				elseif (Value(1)) then
					Return = "Images/TreeCloseEquip.png"
				else
					Return = "Images/TreeOpenEquip.png"
				end if
			</script>
			<script id="xfDisabledVisible" language="VBScript">
				if( IsEmpty(Value) ) then
					Return = "hidden"
				else
					Return = "visible"
				end if
			</script>
			<script id="xfInvertAssignable" language="VBScript">
				if( IsEmpty(Value) or (not Value) ) then
					Return = true
				else
					Return = false
				end if
			</script>
			<script id="xfDisabledBorderLight" language="VBScript">
				if( IsEmpty(Value) or (not Value(0)) ) then
					Return = ""
				else
					if( Value(1) = 1 ) then
						Return = "1px solid threedlightshadow"
					else
						Return = "1px solid threedshadow"
					end if
				end if
			</script>
			<script id="xfDisabledBorderDark" language="VBScript">
				if( IsEmpty(Value) or (not Value(0)) ) then
					Return = ""
				else
					if( Value(1) = 1 ) then
						Return = "1px solid threedshadow"
					else
						Return = "1px solid threedlightshadow"
					end if
				end if
			</script>
			<script id="xfMatchColor" language="VBScript">
				if( IsEmpty(Value) or (Value) ) then
					Return = ""
				else
					Return = "lightgrey"
				end if
			</script>
			<script id="xfName" language="VBScript">
				if (Value(1) = 5 And Trim(Value(4)) &lt;&gt; "") Then
					Return = Value(4)
				Else
					Return = GetNodeDisplayName(Value)
				End If
			</script>
			<script id="xfTitle" language="VBScript">
				Return = GetItemTitle(Value)
			</script>
			<script id="xfOpacity" language="VBScript">
				if( IsEmpty(Value) or (Value) ) then
					Return = ""
				else
					Return = "alpha(opacity=50)"
				end if
			</script>
			<script id="xfStatusIconImg" language="VBScript">
				Dim str
				str = LCase(CStr(Value(0)))
				if (IsEmpty(Value(0)) or (str = "none") or (str = "1")) then
					Return = "Images/blank.gif"
				elseif (str = "disabled" or str = LCase("Disabled") or str = "2" or Value(1)) then
					Return = "Images/SSDDisabled.gif"
				elseif (InStr(str,"fail") = 1 or str = LCase("Fail") or str = LCase("Failed") or str = "3") then
					Return = "Images/SSDFailed.gif"
				elseif (str = "marginal" or str = LCase("Marginal") or str = "4") then
					Return = "Images/SSDMarginal.gif"
				elseif (str = "ok" or str = LCase("OK") or str = "5") then
					Return = "Images/SSDOK.gif"
				elseif (str = "unknown" or str = LCase("Unknown") or str = "0") then
					Return = "Images/SSDUnknown.gif"
				else
					Return = "Images/SSDUnknown.gif"
				end if
			</script>
			<script id="xfSelection" language="VBScript">
				Dim s
				s = ""
				If Not IsEmpty(Value(0)) Then
					If Value(0) Then
						If g_bAreaTableIsActive Then
							If Value(1) Then
								s = "Selected_Active_Cells"
							Else
								s = "Selected_Active_Unassigned_Cells"
							End If
						Else
							If Value(1) Then
								s = "Selected_Inactive_Cells"
							Else
								s = "Selected_Inactive_Unassigned_Cells"
							End If
						End If
					ElseIf Not Value(1) Then
						s = "Unassigned_Cells"
					End If
				End If
				Return = s
			</script>
		</xforms>
	</XFormXML>
	<HTMLWrapperXML>
		<HTMLWrappers>
			<MenuItemWrapper>
				<Begin>
					&lt;div style="position: relative; width: 170px; padding-bottom: 2px; padding-top: 1px; padding-right: 5px;" onmouseenter="OnEnter_MenuItem(this)" onmouseleave="OnLeave_MenuItem(this)"&gt;&lt;span&gt;
				</Begin>
