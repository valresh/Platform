			</GroupSeparator>
		</HTMLWrappers>
	</HTMLWrapperXML>
	<MenuGroupXML>
		<MenuGroups>
		</MenuGroups>
	</MenuGroupXML>
	<BaseFilterXML>
		<BaseFilterDef>
		</BaseFilterDef>
	</BaseFilterXML>
	<SortXML>
		<SortDef DefaultSortColumn="Tree" DefaultSortDir="asc">
			<colref id="Tree"
				SortAscString="EquipmentFilter asc,EntityName asc"
				SortDescString="EquipmentFilter desc,EntityName desc"
				SortDir="asc"
				SortOrder="1"/>
		</SortDef>
	</SortXML>
	<ReportTemplateXML>
	</ReportTemplateXML>
	<ColumnStateXML>
		<state>
			<colref id="Tree" width="490" hidden="false" />
		</state>
	</ColumnStateXML>
	<TableDefinitionXML>
		<table>
			<tableMenu/>
			<contextMenu/>
			<columns>
				<column id="Tree">
					<title>Tree</title>
					<action/>
					<menu/>
					<content>
						&lt;div noselect="" language="javascript" onclick="treeViewModel.select(null, event);" ondblclick="event.cancelBubble = this.noselect; return !this.noselect;" onmouseup="event.cancelBubble = this.noselect; return !this.noselect;" class="TreeNodeGroup" ExpandCollapseTrigger=0&gt;
                        	&lt;div language="javascript" class="TreeNodePlusMinus" onclick="event.cancelBubble = true;"
                                onmouseup="if( event.button == 0 ) { this.parentElement.setAttribute('ExpandCollapseTrigger', 1); event.cancelBubble = true; }"&gt;
                                    &lt;img class="PlusMinusIcon" src="Images/blank.gif" alt="PlusMinus"/&gt;
							&lt;/div&gt;

							&lt;div class="TreeAssetIcon"&gt;
								&lt;img src="Images/blank.gif" alt="Icon"/&gt;
							&lt;/div&gt;
							&lt;div class="TreeNodeAlarmIcon"&gt;
								&lt;img src="Images/blank.gif" alt="Status"/&gt;
							&lt;/div&gt;

							&lt;div class="treeNodeLabel" onmouseenter="treeViewModel.mouseEnter(null, event);" onmouseleave="treeViewModel.mouseLeave(null, event);"&gt;&lt;/div&gt;
										&lt;/div&gt;
					</content>
					<bindings>
						<in fields="Depth" properties="style.pixelLeft" xforms="xfPadding" />
						<in fields="NumChildren;Expanded" properties="firstChild.nextSibling.firstChild.nextSibling.src" xforms="xfPlusMinusImg" />
						<in fields="RemoteType;SubType;ItemNumber;Redundant;Flags" properties="firstChild.nextSibling.nextSibling.nextSibling.firstChild.nextSibling.src" xforms="xfIconImg" />
						<in fields="EntityName;RemoteType;SubType;ItemNumber;Description" properties="firstChild.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling.innerText" xforms="xfName" />
						<in fields="Selected;IsAssigned" properties="firstChild.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling.id" xforms="xfSelection"/>
						<in fields="FullName;Description;AssociatedAsset" properties="title" xforms="xfTitle" />
						<out properties="ExpandCollapseTrigger" fields="Expanded"/>
					</bindings>
				</column>
			</columns>
		</table>
	</TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
