<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="4px" height="98px"><versionheaders><versionheader name="PS" value="6.31"/></versionheaders><scripts><script event="" language="JScript" id="D3ABAF81-1037-4D62-A034-71A09D420996"><![CDATA[var bShapeLoaded = false;]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%currentpoint%}"/><parameter name="DACFBName" type="Text" description="" defaultvalue="AI"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=oSource class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 0%; FONT-FAMILY: Arial; WIDTH: 0%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #ff0000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 48.97%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[if (bShapeLoaded == true )
{
	var oShape = this.parentElement.parentElement;
	var sFBName = oShape.GetCustomProperty("Text","DACFBName");
	Standard_AlarmLimit(this, sFBName);
}]]></script><script event="onupdate" language="JScript"><![CDATA[var sFBName = this.parentElement.parentElement.GetCustomProperty("Text","DACFBName");
	Standard_AlarmLimit(this, sFBName);
	bShapeLoaded = true;]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Text::DACFBName%}.pv"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Text::DACFBName%}.pveuhi,{%Text::DACFBName%}.pveulo,{%Text::DACFBName%}.pvhhalmtp,{%Text::DACFBName%}.pvhhalmpr,{%Text::DACFBName%}.pvhialmtp,{%Text::DACFBName%}.pvhialmpr,{%Text::DACFBName%}.pvllalmtp,{%Text::DACFBName%}.pvllalmpr,{%Text::DACFBName%}.pvloalmtp,{%Text::DACFBName%}.pvloalmpr,{%Text::DACFBName%}.pv.$LIMITS,{%Text::DACFBName%}