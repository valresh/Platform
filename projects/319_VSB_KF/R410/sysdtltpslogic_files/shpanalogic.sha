			end if
		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
			shpOutValues.SetCustomProperty "Parameter", "param10", sParam
		else 
			sParam = ""
		end if
	end if
	if me.value > 10 then
		sParam = combo_PRMDESC11.value
		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"			
			if bPMType then
				shpOutValues.SetCustomProperty "Parameter", "param11num", sParam
			else 
				shpOutValues.SetCustomProperty "Parameter", "param11", sParam
			end if
		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
			shpOutValues.SetCustomProperty "Parameter", "param11", sParam
		else 
			sParam = ""
		end if
	end if
	if me.value > 11 then
		sParam = combo_PRMDESC12.value
		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"			
			if bPMType then
				shpOutValues.SetCustomProperty "Parameter", "param12num", sParam
			else
				shpOutValues.SetCustomProperty "Parameter", "param12", sParam
			end if
		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
			shpOutValues.SetCustomProperty "Parameter", "param12", sParam
		else 
			sParam = ""
		end if
	end if

	shpOutValues.ReloadContent		' trigger fetch of above data values
	'call UpdateValuesCount	 	' hides values below NOLINPTS count in shpOutValues

	shpOutValues.style.visibility = "Visible" 'if never changed from zero, ok to leave hidden]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NODESC"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><group><group><element><html><content><![CDATA[
