		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
			shpOutValues.SetCustomProperty "Parameter", "param7", sParam
		else 
			sParam = ""
		end if
	end if
	if me.value then
		sParam = combo_PRMDESC8.value
		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"			
			if bPMType then
				shpOutValues.SetCustomProperty "Parameter", "param8num", sParam
			else
