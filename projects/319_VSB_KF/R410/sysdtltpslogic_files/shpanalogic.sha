<DIV tabIndex=-1 id=txtPERIODnbr class="hvg.textbox.1 DetailText" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 83.33%; FONT-FAMILY: Verdana; WIDTH: 45.97%; POSITION: absolute; COLOR: #000000; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:15;lineColorBlink:False;LineStyle:0;styleClass:DetailText;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:80;" HDX_LOCK="-1">PERIOD:<BR></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=param_PERIODval title="" class="hsc.alpha.1 " style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 83.33%; FONT-FAMILY: Verdana; WIDTH: 28.16%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: black; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 27.58%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:21;numericDisplayFormat:%.5f;styleClass:;textColor:Black;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	on error resume next

	if QualityOK(me) and not QualityOK(param_PERIOD) then
		txtPERIOD.value = FormatNumber(me.value)
		GrpPERIOD.style.visibility = "Inherit"
		Call UpdateGeneralGroup()
	elseif not QualityOK(param_PERIOD) then
		GrpPERIOD.style.visibility = "Hidden"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PERIOD"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=param_PERIOD title="" class="hsc.alpha.1 " style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 83.33%; FONT-FAMILY: Verdana; WIDTH: 26.43%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: black; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 17.24%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="fillColor:White;fillColorBlink:False;HDXBINDINGID:-4;lineColor:transparent;lineColorBlink:False;numberOfChars:21;numericDisplayFormat:%s;styleClass:;textColor:black;textColorBlink:False;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	on error resume next

	if QualityOK(me) then
		txtPERIOD.value = me.value
		GrpPERIOD.style.visibility = "Inherit"
		Call UpdateGeneralGroup()
	elseif not QualityOK(param_PERIODval) then
		GrpPERIOD.style.visibility = "Hidden"
