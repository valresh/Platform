<DIV tabIndex=-1 id=shpOutValues_group002 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 100%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:246;lineColorBlink:False;Width:100;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=shpOutValues class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 46.87%; FONT-FAMILY: Arial; WIDTH: 13.88%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 56.11%; TOP: 8.2%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;Height:240;lineColorBlink:False;Width:100;" value = "1" src = ".\shpanalogic_files\shpLogicValues.sha" parameters = "Point?tagname:{%Point::CurrentPoint%}     ;Parameter?param1:;Parameter?param2:;Parameter?param3:;Parameter?param4:;Parameter?param5:;Parameter?param6:;Parameter?param7:;Parameter?param8:;Parameter?param9:;Parameter?param10:;Parameter?param11:;Parameter?param12:;Parameter?param1num:;Parameter?param2num:;Parameter?param3num:;Parameter?param4num:;Parameter?param5num:;Parameter?param6num:;Parameter?param7num:;Parameter?param8num:;Parameter?param9num:;Parameter?param10num:;Parameter?param11num:;Parameter?param12num:;:;" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content></html></group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alpNODESC class="hsc.alpha.1 Hidden_Data" style="BORDER-TOP-STYLE: none; FONT-SIZE: 7pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 2.14%; FONT-FAMILY: Small Fonts; WIDTH: 6.94%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: red; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 40.97%; TOP: 95.7%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:9;numericDisplayFormat:%.0f;styleClass:Hidden_Data;textColor:red;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['	grpData.style.visibility = "Inherit" 'now show data

	' drive LOSRC(n) text-value "point.param" to shpOutValues via custom properties to get actual point.param process values
	'example is, if LOSRC(n) is "L3" then the value to show is <thispoint>.L(3).external
'	shpOutValues.autoReloadContent = false


	if alpNODETYP.value = "PM" or alpNODETYP.value = "PM1" then
		bPMType = TRUE
	else
		bPMTime = FALSE
	end if

	if me.value > 0 then
		sParam = combo_PRMDESC1.value
		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"	
			if bPMType then		
				shpOutValues.SetCustomProperty "Parameter", "param1num", sParam
			else
				shpOutValues.SetCustomProperty "Parameter", "param1", sParam
			end if
		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
			shpOutValues.SetCustomProperty "Parameter", "param1", sParam
		else 
			sParam = ""
		end if
	end if

	if me.value > 1 then
		sParam = combo_PRMDESC2.value
		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"			
			if bPMType then		
				shpOutValues.SetCustomProperty "Parameter", "param2num", sParam
			else
				shpOutValues.SetCustomProperty "Parameter", "param2", sParam
			end if
		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
			shpOutValues.SetCustomProperty "Parameter", "param2", sParam
		else 
			sParam = ""
		end if
	end if

	if me.value > 2 then
		sParam = combo_PRMDESC3.value
		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"			
			if bPMType then
				shpOutValues.SetCustomProperty "Parameter", "param3num", sParam
			else
				shpOutValues.SetCustomProperty "Parameter", "param3", sParam
			end if
		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
			shpOutValues.SetCustomProperty "Parameter", "param3", sParam
		else 
			sParam = ""
		end if
	end if

	if me.value > 3 then
		sParam = combo_PRMDESC4.value
		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"			
