<?xml version="1.0"?><shapefile version="1" type="dynamic" title="Operator menu" description="Operator menu derived from Background having check for DVM licence." useFirstShapeForBadValue="0" width="240px" height="35px"><versionheaders><versionheader name="PS" value="5.7"/></versionheaders><scripts><script event="" language="JavaScript" id="CFD45B49-72AB-4fb7-9CC8-A7D18331606B"><![CDATA[
        //------------------------------------------------------------------------
        // CreateExtensionDiv
        //------------------------------------------------------------------------
        // <summary>
        // Creates a single div in the specified parent element with the specified
        // styles and attributes.
        // </summary>
        // <param name="extId">The ID for the new div.</param>
        // <param name="extClass">The class(es) for the new div.</param>
        // <param name="extXStyle">The style used to give the div its horizontal position ('left' or 'right')</param>
        // <param name="extXPos">The expression for the div's horizontal position.</param>
        // <param name="extYStyle">The style used to give the div its vertical position ('top or 'bottom')</param>
        // <param name="extYPos">The expression for the div's vertical position.</param>
        // <param name="extWidth">The expression for the div's width.</param>
        // <param name="extHeight">The expression for the div's height.</param>
        // <param name="extDisplay">The expression for the div's display style - null or '' if this is not needed.</param>
        // <param name="objExtParent">The element to insert the new div as a child of.</param>
        // <returns>
        // true if the div was created with no problems, false otherwise.
        // </returns>
        //------------------------------------------------------------------------
        function CreateExtensionDiv(extId, extClass, extXStyle, extXPos, extYStyle, extYPos, extWidth, extHeight, extDisplay, objExtParent)
        {
          try
          {
            var objExt = window.document.getElementById(extId);
            if (objExt == null)
            {
              objExt = window.document.createElement("div");
              objExt.id = extId;
              objExt.className = extClass;
              objExt.style.position = "absolute";
              objExt.style.overflow = "hidden";
              objExt.style.setExpression(extXStyle, extXPos, "JavaScript");
              objExt.style.setExpression(extYStyle, extYPos, "JavaScript");
              objExt.style.setExpression("width", extWidth, "JavaScript");
              objExt.style.setExpression("height", extHeight, "JavaScript");
              if (typeof(extDisplay) == "string" && extDisplay.length > 0)
              {
                objExt.style.setExpression("display", extDisplay, "JavaScript");
              }
              
              // Insert the new extension div into the proper location in a seperate thread, so that
              // the time it takes doesn't delay the calculation of the size and location of the
              // other extensions. This also breaks out of the onreadystatechange handler thread before
              // mucking around with the DOM, which could potentially change the readyState again.
              window.setTimeout(function(){ objExtParent.appendChild(objExt); }, 5);
            }
            return true;
          }
          catch(e)
          {
            alert("Exception creating background extension '" + extId + "': " + (typeof(e) == "string" ? e : e.description));
          }
          return false;
        }
        
        //------------------------------------------------------------------------
        // CreateBackgroundExtensions
        //------------------------------------------------------------------------
        // <summary>
        // Create empty elements inside the background that match the colored
        // parts of the shape to give the impression that the Page stretches
        // all the way to the edges of the Background.
        // </summary>
        // <returns>
        // true if the extensions were created with no problems, false otherwise.
        // </returns>
        //------------------------------------------------------------------------
        function CreateBackgroundExtensions()
        {
          try
          {
              var objPage = window.document.getElementById("Page");
              var objBackground = window.document.getElementById("Background");      
              if (objPage == null || objBackground == null)
              {
                return false;
              }
                                          
              // Put the action bar extension in first: it needs to go _under_ the TabSet extension.
                 CreateExtensionDiv("", "OperatorsMenu",
                                   "left", "'0px'", "bottom", "'0px'", 
                                   "OperatorsMenu.offsetWidth", "Background.clientHeight - Page.offsetHeight", 
									null, objPage);


          }
          catch(e)
          {
             alert("Exception creating background extensions: " + (typeof(e) == "string" ? e : e.description));
          }  
          return false;
        }
        
        //------------------------------------------------------------------------
        // ResolveMenuPaths
        //------------------------------------------------------------------------
        // <summary>
        // Work out where the desired menu definitions and images actually live. 
        // </summary>
        // <returns>
        // true if the paths were resolved, false otherwise.
        // </returns>
        //------------------------------------------------------------------------
        function ResolveMenuPaths(topLeftIconElement, topLeftIconFile, operatorsMenuElement)
        {
          try
          {
            if (typeof(window.document.documentElement.SystemDisplayScripts) == "object")
            {
              var iconPath = document.documentElement.ResolveReference("Images/")
              
              if (topLeftIconFile != "")
              {
                topLeftIconElement.src = iconPath + "/" + topLeftIconFile;
                topLeftIconElement.style.display = "inline";
              }
              
              operatorsMenuElement.setAttribute("IconPath", iconPath, 1);
              operatorsMenuElement.setAttribute("MenuXML", document.documentElement.ResolveReference("Menus/OperatorsMenu.xml"), 1);
              return true;
            }
          }
          catch(e)
          {
            alert("Exception resolving menu path for '" + navMenuFile + "': " + (typeof(e) == "string" ? e : e.description));
          }
          return false;
        }
      ]]></script><script event="onshapeload" language="JavaScript" id=""><![CDATA[
    // Move the shape to take up the whole page.
        this.style.left = "0px";
        this.style.top = "0px";
        this.style.width = "240px";
        this.style.setExpression("height", "Page.clientHeight", "JavaScript");
        // Adjust the sizes of page elements that depend on whether the tabs and action bar are shown.
         LeftBar.className = "";
        // Put the display title in the title bar
		if (!CreateBackgroundExtensions())
        {
          document.attachEvent("onreadystatechange", CreateBackgroundExtensions);
        }
        
        // Initialize the top-left corner and NavPane.
        var topLeftTitleText = "{%Value::TopLeftTitle%}";
        var topLeftIconFile = "{%Value::TopLeftIcon%}";
   
        TopLeftTitle.innerText = topLeftTitleText; 
		 if (topLeftTitleText == "")
          {
            // We need to use the title and icon defined by the MenuXML file.
            OperatorsMenu.attachEvent("onreadystatechange", function(){ try{ ApplyMenuText(NavPane, TopLeftTitle, TopLeftIcon); } catch(e){}});
            topLeftIconFile = ""; // Only use the custom icon if we are not getting one from the menu.
          }          
         
        var fnResolveMenuContent = function(){ return ResolveMenuPaths(TopLeftIcon, topLeftIconFile, OperatorsMenu); }
        if (!fnResolveMenuContent())
        {
          document.documentElement.attachEvent("onreadystatechange", fnResolveMenuContent);
        }
        
      ]]></script></scripts><parameters><parameter name="TopLeftTitle" type="Value" description="The text for the top-left title (leave blank to use the default title for the menu)." defaultvalue=""/><parameter name="TopLeftIcon" type="Value" description="The file name of the icon to use in the top-left title (only used if the TopLeftTitle parameter is not empty)." defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV class=NoExpressions id=LeftBar style="PADDING-RIGHT: 0px; PADDING-LEFT: 0px; PADDING-BOTTOM: 0px; PADDING-TOP: 0px"><DIV class=TopLeft id=TopLeft><A class=DropDown id=OperatorsMenuButton onclick="javascript: try{ ToggleDropDownMenu(OperatorsMenu, this); return false; } catch(e){}" href=""><IMG id=TopLeftIcon src="" shapesrc=".\sysNavOperateMenu_files\TopLeftIcon%}"> <SPAN id=TopLeftTitle>{%Value::TopLeftTitle%}</SPAN> </A></DIV></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=popup id=OperatorsMenuContainer><DIV class=NavPane id=OperatorsMenu style="DISPLAY: none; Z-INDEX: 100; ; LEFT: expression(OperatorsMenuButton.currentStyle.marginLeft); POSITION: absolute; ; TOP: expression(OperatorsMenuButton.offsetTop + OperatorsMenuButton.offsetHeight)" MenuXML="OperatorsMenu.xml"></DIV></DIV>]]></content></html></element><element><html><content><![CDATA[<SPAN class=hsc.checkbox.1 id=DVMInstalled style="LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HSCCheckBoxBehavior) url(#BindingBehavior); WIDTH: 150px; BOTTOM: 0%; POSITION: absolute; HEIGHT: 20px; BACKGROUND-COLOR: transparent" tabIndex=0 hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;inverseLogic:0;textColorBlink:False;"><INPUT style="BACKGROUND-COLOR: transparent" tabIndex=0 type=checkbox></INPUT> <SPAN style="COLOR: #000000">DVMInstalled</SPAN> </SPAN>]]></content><scripts><script event="onupdate" language="JavaScript"><![CDATA[
                  var newValue = DVMInstalled.value
                  var oldValue = DVMInstalled.getAttribute("OldValue");
                  if (oldValue == null || oldValue != newValue)
                  {
                    DVMInstalled.setAttribute("OldValue", newValue);
                    var licenceOverrides = "DVM" + "Installed=" + newValue; // Literal is split to avoid name-substitution when shape is loaded.       
                    
					OperatorsMenu.setAttribute("LicenceValues",  licenceOverrides);
                    OperatorsMenu.className = "NavPane NavMenu";
                  }
                ]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="FileRefFile" varianttype="VT_UI4" value="8"/><property name="FileRefRecord" varianttype="VT_UI4" value="1"/><property name="FileRefWord" varianttype="VT_UI4" value="10"/><property name="FileRefFlags" varianttype="VT_UI4" value="0"/><property name="FileRefFormat" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldStart" varianttype="VT_UI1" value="6"/><property name="FileRefBitFieldWidth" varianttype="VT_UI1" value="1"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.CheckBox" refcount="1"/></binding></element><html><content><![CDATA[
<DIV class=hvg.group.1 id=SystemDisplayContainer style="LEFT: 0px; BEHAVIOR: url(#HDXVectorFactory#group); OVERFLOW: hidden; WIDTH: 240px; POSITION: absolute; TOP: 0px; HEIGHT: 35px" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:35;lineColorBlink:False;Width:240;"></DIV>]]></content></html></group></shape></shapes></shapefile>