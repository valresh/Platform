<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="286px" height="48px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[ntimer = window.setInterval("myfunction(group001)",500)]]></script><script event="" language="VBScript" id="AD889B50-8EDA-4DBB-B5C4-A83B02263985"><![CDATA[dim ntimer 
dim sha, obj
function myfunction(sha)
set obj = sha.parentelement
if obj.objects("visi").value =1 then
	obj.style.visibility="visible"
	obj.style.Top=45 'position the group besides the navigation pane
	obj.style.posLeft=80 'position the group below the title bar
	obj.objects("rect4").style.posLeft=80 'moving the shaects diferently
	obj.objects("rect4").style.Top=45 'moving rect4 to match top and left coordinate of group
	obj.objects("pushbutton1").style.posLeft=80 'moving pushbutton1 to match top and left coordinate of group
	obj.objects("pushbutton1").style.Top=45
	obj.objects("rect4").style.width=1020 'resizing rect4 to cover the required area without resizing the text
	obj.objects("rect4").style.height=820
	obj.objects("pushbutton1").style.width=1020 'resizing rect4 to cover the required area without resizing the text
	obj.objects("pushbutton1").style.height=800
	obj.objects("text1").style.posTop=800 'aligning the text middle to the rect4
	obj.objects("text1").style.posLeft=220 'aligning the text center to the rect4
	For i=1 to page.all.length-1
		If (page.all(i).style.posLeft > obj.objects("rect4").style.posLeft) And (page.all(i).style.posTop > obj.objects("rect4").style.posTop) Then
			page.all(i).style.visibility = "hidden"
		End If 
		' this code is used to hide any objects beyond shapes boundary after resizing. 
	next 
	obj.objects("text1").style.visibility="visible"
end if
window.clearInterval(ntimer)
end function]]></script></scripts><shapes><shape><group><element><html><content><![CDATA[<INPUT class=hsc.button.1 id=pushbutton1 style="BORDER-RIGHT: #ffffff 1px; BORDER-TOP: #ffffff 1px; FONT-WEIGHT: normal; FONT-SIZE: 11pt; LEFT: 0%; VISIBILITY: inherit; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BORDER-LEFT: #ffffff 1px; WIDTH: 100%; COLOR: #000000; BORDER-BOTTOM: #ffffff 1px; BACKGROUND-REPEAT: no-repeat; FONT-STYLE: normal; FONT-FAMILY: Helvetica; POSITION: absolute; TOP: 0%; HEIGHT: 100%; BACKGROUND-COLOR: #ffffff; TEXT-ALIGN: center; TEXT-DECORATION: none" tabIndex=-1 type=button hdxproperties="fillColor:#ffffff;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColor:#000000;textColorBlink:False;">]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="0"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value=""/><property name="TaskParam2" varianttype="VT_BSTR" value=""/><property name="TaskParam3" varianttype="VT_BSTR" value=""/><property name="TaskParam4" varianttype="VT_BSTR" value=""/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=text1 style="FONT-WEIGHT: bold; FONT-SIZE: 12pt; LEFT: 23.42%; VISIBILITY: inherit; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior); OVERFLOW: hidden; WIDTH: 53.14%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Helvetica; POSITION: absolute; TOP: 27.08%; HEIGHT: 41.66%; TEXT-ALIGN: center" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:20;indicateAlarmState:0;indicateScanState:0;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;value:;Width:152;">Option not licensed</DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=rect4 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0.69%; VISIBILITY: inherit; BEHAVIOR: url(#HDXVectorFactory#rect) url(#BindingBehavior); OVERFLOW: hidden; WIDTH: 98.6%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 97.91%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:#ffffff;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:47;indicateAlarmState:0;indicateScanState:0;LineColor:transparent;lineColorBlink:False;Width:282;"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN class=hsc.checkbox.1 id=visi style="LEFT: 50.69%; VISIBILITY: hidden; BEHAVIOR: url(#HSCCheckBoxBehavior) url(#BindingBehavior); FONT: 8pt Helvetica; OVERFLOW: hidden; WIDTH: 24.82%; CURSOR: default; POSITION: absolute; TOP: 54.16%; HEIGHT: 37.5%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;inverseLogic:0;textColor:#ff0000;textColorBlink:False;" printInverse="false" printValue="true"><INPUT style="MARGIN: 1px; BACKGROUND-COLOR: transparent" tabIndex=-1 type=checkbox></INPUT><SPAN style="COLOR: #ff0000">Visible</SPAN></SPAN>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.CheckBox" refcount="1"/></binding></element><html><content><![CDATA[
<DIV class=hvg.group.1 id=group001 style="FONT-SIZE: 0pt; LEFT: 103px; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 286px; POSITION: absolute; TOP: 186px; HEIGHT: 48px" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:48;lineColorBlink:False;Width:286;"></DIV>]]></content></html></group></shape></shapes></shapefile>