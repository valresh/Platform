<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="Shape to display the name, value, units and optionally status of one of the 4 HART dynamic variables PV, SV, TV or QV." useFirstShapeForBadValue="0" width="148px" height="40px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="onshapeload" language="JScript" id=""><![CDATA[	SL_LogEvent(this, "onshapeload");
	SL_DynamicVariable_Initialize(this);]]></script><script event="" language="JScript" id="4C7A6EFC-59A6-4E66-BAE0-D69A1E68F818"><![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///
/// History:
///
/// [RLEAPFI-407]   May 14, 2018        Removed the Hover behaviour for the units as it was preventing the setting of the long symbol as tooltip.
/// [RLEAPFI-639]	April 25, 2018		Add logic to check the quality of the value and status before updating the PV, SV, TV and QV controls.
/// EXP510.1-31		April 24, 2018		Initial Experion R510 testbed release
///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="Point Name" defaultvalue=""/><parameter name="UseNumDecimals" type="Value" description="Use fixed number of decimal places" defaultvalue="0"/><parameter name="NumDecimals" type="Value" description="Number of decimal places" defaultvalue="0"/><parameter name="VariableType" type="Value" description="The HART Dynamic Variable assignment, either PV, SV, TV or QV." defaultvalue="PV"/><parameter name="IgnoreStatus" type="Value" description="0 = Use variable status to determine text color, 1 = Ignore variable status" defaultvalue="0"/><parameter name="UnitParameter" type="Parameter" description="The name of the Point Parameter that contains the HART code for the engineering units of the digital variable." defaultvalue="HDYNEU[1]"/><parameter name="ValueParameter" type="Parameter" description="The name of the Point Parameter that contains the value for the digital variable." defaultvalue="HDYNVAL[1]"/><parameter name="StatusParameter" type="Parameter" description="The name of the Point Parameter that contains the status of the curret value of the digital variable." defaultvalue="HDYNST[1]"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxVariableSymbol title="" class="hvg.textbox.1 SLFP_PVSymbol_Digital" style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 40%; FONT-FAMILY: arial; WIDTH: 20.27%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ffffff; TEXT-ALIGN: left; LEFT: 0.67%; TOP: 2.5%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:16;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:SLFP_PVSymbol_Digital;textColor:#FFFFFF;textColorBlink:False;TotalRotation:-1;Width:30;"><FONT size=3>Text</FONT></DIV>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaVariableValue title="" class="hsc.alpha.1 HSC.ScriptDataObject.1 SLFP_PVValue_Digital" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 45%; FONT-FAMILY: arial; WIDTH: 52.7%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 24.32%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateNaNState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%.2f;styleClass:SLFP_PVValue_Digital;textColor:#FFFFFF;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");
	SL_DynamicVariable_SetValue(this.parentElement.parentElement);]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::ValueParameter%},{%Parameter::StatusParameter%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaUnit title="" class="hsc.alpha.1 HSC.ScriptDataObject.1 SLFP_PVUnits_Digital" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 40%; FONT-FAMILY: arial; WIDTH: 21.62%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 78.37%; TOP: 2.5%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SLFP_PVUnits_Digital;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");
	SL_SetProcessVariableUnits(this);]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::UnitParameter%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaVariableName title="" class="hsc.alpha.1  SLFP_PVName_Digital" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 42.5%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 45%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SLFP_PVName_Digital;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content></html><binding/></element><html><content><![CDATA[
<DIV tabIndex=-1 id=groupIndicator class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 40px; WIDTH: 148px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:40;lineColorBlink:False;Width:148;"></DIV>]]></content></html></group></shape></shapes></shapefile>