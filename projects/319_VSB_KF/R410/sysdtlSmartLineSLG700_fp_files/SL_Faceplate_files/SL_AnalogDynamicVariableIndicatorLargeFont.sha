<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="148px" height="40px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="onshapeload" language="JScript" id=""><![CDATA[	SL_AnalogPV_Initialize(this);]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="Point Name" defaultvalue="&lt;CurrentPoint&gt;"/><parameter name="UseNumDecimals" type="Value" description="Use fixed number of decimal places" defaultvalue="0"/><parameter name="NumDecimals" type="Value" description="Number of decimal places" defaultvalue="0"/><parameter name="VariableType" type="Value" description="Analog PV (0) or Dynamic Variable: 1=PV, 2=SV, 3=TV, 4=QV" defaultvalue="PV"/><parameter name="IgnoreStatus" type="Value" description="0 = Use variable status to determine text color, 1 = Ignore variable status" defaultvalue="0"/><parameter name="UnitParameter" type="Parameter" description="The name of the Point Parameter that contains the HART code for the engineering units of the analog variable." defaultvalue="HEU"/><parameter name="ValueParameter" type="Parameter" description="The name of the Point Parameter that contains the value for the analog variable." defaultvalue="PV"/><parameter name="StatusParameter" type="Parameter" description="The name of the Point Parameter that contains the status of the curret value of the analog variable." defaultvalue="PVSTS"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxVariableSymbol title="Process Variable calculated from the analog signal from the transmitter." class="hvg.textbox.1 SLFP_PVSymbol_Analog" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 45%; FONT-FAMILY: arial; WIDTH: 20.27%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ffffff; TEXT-ALIGN: left; LEFT: 0%; TOP: 10%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:18;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:SLFP_PVSymbol_Analog;textColor:#FFFFFF;textColorBlink:False;TotalRotation:-1;Width:30;">Text</DIV>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaVariableValue title="" class="hsc.alpha.1 HSC.ScriptDataObject.1 SLFP_PVValue_Analog" style="BORDER-TOP-STYLE: none; FONT-SIZE: 16pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 57.5%; FONT-FAMILY: arial; WIDTH: 52.7%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 23.64%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateNaNState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%.2f;styleClass:SLFP_PVValue_Analog;textColor:#FFFFFF;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	//SL_LogFunctionEntry(null, "alphaVariableValueAnalog_ondatachange");

    try
    {
		var variableType = this.parentElement.parentElement.GetCustomProperty("Value", "VariableType");
		var ignoreStatus = this.parentElement.parentElement.GetCustomProperty("Value", "IgnoreStatus");

		if (variableType == 0)
		{
			var valueParameter;
			var statusParameter;
			var statusCode;
			var statusInfo;

			valueParameter =  "SLAnalogPoint.PV";
			statusParameter = "SLAnalogPoint.PVSTS";
			statusCode = this.DataValue(statusParameter);
			statusInfo = SL_GetAnalogPVStatus(statusCode);

			var variableValue = this.DataValue(valueParameter);

			if (variableValue !== undefined)
			{
				var useNumDecimals = this.parentElement.parentElement.GetCustomProperty("Value", "UseNumDecimals");
				var numDecimals = this.parentElement.parentElement.GetCustomProperty("Value", "NumDecimals");
		 		if (useNumDecimals == 0)
				{
					numDecimals = SL_GetNumDecimals(variableValue);	
				}
		
				this.value = variableValue.toFixed(numDecimals);
			}
			else
			{
				this.value = "unknown";	
			}

			var textColor;

			if ((ignoreStatus == 0) && (statusInfo != ""))
			{
				textColor = statusInfo.textColorDarkBG;
			}
			else
			{
				textColor = statusDisplayScheme[0].textColorDarkBG;
			}

			this.textColor = textColor;
			alphaUnit.textColor = textColor;		
		}
    }
    catch (error)
    {
	    SL_LogErrorgMessage(null, "alphaVariableValueAnalog_ondatachange", "Could not set process variable value: " + "valueParameter = " + valueParameter + ", Status Parameter = " + statusParameter);
        SL_LogErrorgMessage(null, "alphaVariableValueAnalog_ondatachange", error.toString());
    }

    //SL_LogFunctionExit(null, "alphaVariableValueAnalog_ondatachange");]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PV,PVSTS,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaVariableName title="" class="hsc.alpha.1 SLFP_PVName_Analog" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 42.5%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 57.5%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SLFP_PVName_Analog;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var variableType = this.parentElement.parentElement.GetCustomProperty("Value", "VariableType");

	if (variableType == 0)
	{
		var deviceCode = this.DataValue("SLAnalogPoint.HDEVTYPE7");
		var deviceType = SL_GetDeviceType(deviceCode);

		switch (deviceType)
		{
			case "Level":
			case "Multivariable":
				var deviceVariableCodeParameter = "SLAnalogPoint.HDYNDVC[1]";
				var deviceVariableCode = this.DataValue(deviceVariableCodeParameter);

				this.value = SL_GetDeviceVariableName(deviceCode, deviceVariableCode);
				break;

			case "Pressure":
			case "Temperature":
				//this.value = SL_GetDeviceVariableName(deviceCode, 0);
				break;
			
			default:
				this.value = "";
		}
	}]]></script></scripts></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaUnit title="" class="hsc.alpha.1 HSC.ScriptDataObject.1 SLFP_PVUnits_Analog" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 40%; FONT-FAMILY: arial; WIDTH: 21.62%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 77.7%; TOP: 15%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SLFP_PVUnits_Analog;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_SetProcessVariableUnits(this);]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HEU,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=groupIndicator class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 40px; WIDTH: 148px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:40;lineColorBlink:False;Width:148;"></DIV>]]></content></html></group></shape></shapes></shapefile>