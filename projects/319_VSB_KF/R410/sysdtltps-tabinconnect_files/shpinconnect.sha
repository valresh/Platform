<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 49.46%; FONT-FAMILY: Helvetica; HEIGHT: 100%; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 0%" id=txt_nbrInpts class="hvg.textbox.1 Label_Text" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:Label_Text;textColor:black;textColorBlink:False;TotalRotation:-1;Width:92;">NOLINPTS =</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; WIDTH: 51.07%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 83.33%; COLOR: black; FONT-SIZE: 10pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 5.55%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 48.92%; ROWS: 1" id=alp_nbrInputs class="hsc.alpha.1 DetailDataLeft" title="" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:9;numericDisplayFormat:%.0f;styleClass:DetailDataLeft;textColor:Black;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	dim bChangedCount
	bChangedCount = false

	if not sd.QualityGood("CurrentPoint.NOLINPTS") then
		exit sub 'leaving entire group hidden
	end if

	'used to drive presentation of LISRC(n) point.param names to shpValues 
	if intCount <> sd.DataValue("CurrentPoint.NOLINPTS") then bChangedCount = true
	intCount = sd.DataValue("CurrentPoint.NOLINPTS")

	if bChangedCount then

		if me.value > 0 then
			alp_source1.style.visibility = "Inherit"
			txt_L1.style.visibility = "Inherit"
		end if
		if me.value > 1 then
			alp_source2.style.visibility = "Inherit"
			txt_L2.style.visibility = "Inherit"
		end if
		if me.value > 2 then
			alp_source3.style.visibility = "Inherit"
			txt_L3.style.visibility = "Inherit"
		end if
		if me.value > 3 then
			alp_source4.style.visibility = "Inherit"
			txt_L4.style.visibility = "Inherit"
		end if
		if me.value > 4 then
			alp_source5.style.visibility = "Inherit"
			txt_L5.style.visibility = "Inherit"
		end if
		if me.value > 5 then
			alp_source6.style.visibility = "Inherit"
			txt_L6.style.visibility = "Inherit"
		end if
		if me.value > 6 then
			alp_source7.style.visibility = "Inherit"
			txt_L7.style.visibility = "Inherit"
		end if
		if me.value > 7 then
			alp_source8.style.visibility = "Inherit"
			txt_L8.style.visibility = "Inherit"
		end if
		if me.value > 8 then
			alp_source9.style.visibility = "Inherit"
			txt_L9.style.visibility = "Inherit"
		end if
		if me.value > 9 then
			alp_source10.style.visibility = "Inherit"
			txt_L10.style.visibility = "Inherit"
		end if
		if me.value > 10 then
			alp_source11.style.visibility = "Inherit"
			txt_L11.style.visibility = "Inherit"
		end if
		if me.value > 11 then
			alp_source12.style.visibility = "Inherit"
			txt_L12.style.visibility = "Inherit"
		end if


	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NOLINPTS"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
