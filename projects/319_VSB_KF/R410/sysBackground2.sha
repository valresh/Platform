<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="sysBackground" description="Background layout and navigation menus for a standard system display" useFirstShapeForBadValue="0" width="1020px" height="589px">
  <versionheaders>
    <versionheader name="PS" value="5.5"/>
  </versionheaders>
  <scripts>
    <script event="" language="JavaScript" id="CFD45B49-72AB-4fb7-9CC8-A7D18331606B">
      <![CDATA[
        //------------------------------------------------------------------------
        // CreateExtensionDiv
        //------------------------------------------------------------------------
        // <summary>
        // Creates a single div in the specified parent element with the specified
        // styles and attributes.
        // </summary>
        // <param name="extId">The ID for the new div.</param>
        // <param name="extClass">The class(es) for the new div.</param>
        // <param name="extXStyle">The style used to give the div its horizontal position ('left' or 'right')</param>
        // <param name="extXPos">The expression for the div's horizontal position.</param>
        // <param name="extYStyle">The style used to give the div its vertical position ('top or 'bottom')</param>
        // <param name="extYPos">The expression for the div's vertical position.</param>
        // <param name="extWidth">The expression for the div's width.</param>
        // <param name="extHeight">The expression for the div's height.</param>
        // <param name="extDisplay">The expression for the div's display style - null or '' if this is not needed.</param>
        // <param name="objExtParent">The element to insert the new div as a child of.</param>
        // <returns>
        // true if the div was created with no problems, false otherwise.
        // </returns>
        //------------------------------------------------------------------------
        function CreateExtensionDiv(extId, extClass, extXStyle, extXPos, extYStyle, extYPos, extWidth, extHeight, extDisplay, objExtParent)
        {
          try
          {
            var objExt = window.document.getElementById(extId);
            if (objExt == null)
            {
              objExt = window.document.createElement("div");
              objExt.id = extId;
              objExt.className = extClass;
              objExt.style.position = "absolute";
              objExt.style.overflow = "hidden";
              objExt.style.setExpression(extXStyle, extXPos, "JavaScript");
              objExt.style.setExpression(extYStyle, extYPos, "JavaScript");
              objExt.style.setExpression("width", extWidth, "JavaScript");
              objExt.style.setExpression("height", extHeight, "JavaScript");
              if (typeof(extDisplay) == "string" && extDisplay.length > 0)
              {
                objExt.style.setExpression("display", extDisplay, "JavaScript");
              }
              
              // Insert the new extension div into the proper location in a seperate thread, so that
              // the time it takes doesn't delay the calculation of the size and location of the
              // other extensions. This also breaks out of the onreadystatechange handler thread before
              // mucking around with the DOM, which could potentially change the readyState again.
              window.setTimeout(function(){ objExtParent.appendChild(objExt); objExt = null;}, 5);
		    }
            return true;
          }
          catch(e)
          {
            alert("Exception creating background extension '" + extId + "': " + (typeof(e) == "string" ? e : e.description));
          }
          return false;
        }
        
        //------------------------------------------------------------------------
        // CreateBackgroundExtensions
        //------------------------------------------------------------------------
        // <summary>
        // Create empty elements inside the background that match the colored
        // parts of the shape to give the impression that the Page stretches
        // all the way to the edges of the Background.
        // </summary>
        // <returns>
        // true if the extensions were created with no problems, false otherwise.
        // </returns>
        //------------------------------------------------------------------------
        function CreateBackgroundExtensions()
        {
          try
          {
              var objPage = window.document.getElementById("Page");
              var objBackground = window.document.getElementById("Background");      
              if (objPage == null || objBackground == null)
              {
                return false;
              }
                                          
              // Put the action bar extension in first: it needs to go _under_ the TabSet extension.
              CreateExtensionDiv("bgActionBar", "ActionBar",
                                  "right", "'0px'", "bottom", "'0px'",
                                  "Background.clientWidth - Page.offsetWidth + ActionBarBackground.offsetWidth", 
                                  "Background.clientHeight - TitleBarBackground.offsetHeight",
                                  "ActionBarBackground.currentStyle.display", objBackground);

              // Extend the TitleBar on the right-hand edge
              CreateExtensionDiv("bgTitleBar", "TitleBar", 
                                  "right", "'0px'", "top", "'0px'", 
                                  "Background.clientWidth - Page.offsetWidth", 
                                  "TitleBarBackground.offsetHeight", 
                                  null, objBackground);
              
              // Extend the TabSet on the right-hand edge.
              CreateExtensionDiv("bgTabSet", "TabSet", 
                                  "right", "'0px'", "top", "TitleBarBackground.offsetHeight", 
                                  "Background.clientWidth - Page.offsetWidth", "TabSetBackground.offsetHeight", 
                                  "TabSetBackground.currentStyle.display", objBackground);
			objPage=null;
			objBackground =null;
		  }
          catch(e)
          {
             alert("Exception creating background extensions: " + (typeof(e) == "string" ? e : e.description));
          }  
          return false;
        }
        
      ]]>
      </script>

      <script event="onshapeload" language="JavaScript" id="">
        <![CDATA[
        // Move the shape to take up the whole page.
        this.style.left = "0px";
        this.style.top = "0px";
        this.style.setExpression("width", "Page.clientWidth", "JavaScript");
        this.style.setExpression("height", "Page.clientHeight", "JavaScript");
        
        // Adjust the sizes of page elements that depend on whether the tabs and action bar are shown.
        var showActionBar = "{%Value::ShowActionBar%}" == "true";
        var showTabs = "{%Value::ShowTabs%}" == "true";
        
        TabSetBackground.style.display = (showTabs ? "block" : "none");
        PageEdge.style.display = ((showActionBar && showTabs) ? "block" : "none");
        ActionBarBackground.style.display = (showActionBar ? "block" : "none");

        DisplayAreaBackground.className = (showTabs ? "" : "NoTabs");
        DetailsAreaBackground.className = (showActionBar ? "DetailsArea" : "NoActionBar DetailsArea");
        LeftBar.className = "";
       
        // Put the display title in the title bar
        if ("{%Value::ShowDisplayTitle%}"=="true")
        {
          TitleBarBackground.innerHTML = document.title;
        }
                   
        if (!(CreateBackgroundExtensions()))
        {
          document.attachEvent("onreadystatechange", CreateBackgroundExtensions);
        }
        showActionBar = null;
        showTabs= null;
        
      ]]>
    </script>
  </scripts>
  <parameters>
    <parameter name="ShowTabs" type="Value" description="Whether tabs should be shown: 'true', 'false' or 'auto'." defaultvalue="auto"/>
    <parameter name="ShowActionBar" type="Value" description="Whether the action bar should be shown: 'true' or 'false'" defaultvalue="false"/>
    <parameter name="ShowDisplayTitle" type="Value" description="'true' if the title of the display should be shown in the titlebar area, 'false' if the display title should not be shown." defaultvalue="true"/>
  </parameters>
  <shapes>
    <shape>
      <group>
        <element>
          <html>
			  <content>
				  <![CDATA[<SPAN id="DVMInstalled" class="hsc.checkbox.1"  
                style="BEHAVIOR: url(#HSCCheckBoxBehavior) url(#BindingBehavior);  
                      BOTTOM: 0%;
                      HEIGHT: 20px; 
                      LEFT: 0%;
                      POSITION: absolute;
                      VISIBILITY: hidden;
                      WIDTH: 150px;" 
                tabIndex=0 
                hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;inverseLogic:0;textColorBlink:False;">
                  <INPUT tabIndex=0 type=checkbox></INPUT>
                  <SPAN>DVMInstalled</SPAN>
                </SPAN>]]>
			  </content>
		  </html>
		  <binding>
		  </binding>
        </element>
        <html>
          <content>
            <![CDATA[<DIV id="SystemDisplayContainer" class="hvg.group.1" 
              style="BEHAVIOR: url(#HDXVectorFactory#group);
                    HEIGHT: 589px;
                    LEFT: 0px;                    
                    POSITION: absolute;
                    overflow: hidden; 
                    TOP: 0px; 
                    WIDTH: 1020px;" 
              tabIndex="-1" 
              hdxproperties="fillColorBlink:False;Height:589;lineColorBlink:False;Width:1020;">
              <div id="LeftBar" class="NoExpressions" style="padding: 0px;">
	                   </div>
              <div id="RightBar" class="NoExpressions">
	              <div id="TitleBarBackground" class="TitleBar">
                  <span style="display: none;">[Display Title shown = '{%Value::ShowDisplayTitle%}']</span>
                  &nbsp;
                </div>
	              <div id="TabSetBackground" class="TabSet">
                  <div style="display: none;">[Tabs shown = '{%Value::ShowTabs%}']</div>
             		  <v:roundrect id="PageEdge" strokecolor="#FFFFFF" fillcolor="#FFFFFF" arcsize="0.5">
                  </v:roundrect>
                </div>
	              <div id="DisplayAreaBackground" class="NoExpressions">
	                <div id="ActionBarBackground" class="ActionBar">
                    <div style="display: none; color: red;">
                      ['Action Bar shown = '{%Value::ShowActionBar%}']
                    </div>
                  </div>
		              <div id="DetailsAreaBackground" class="DetailsArea" 
                    style="padding: 0px;">
                    <table id="PositionGrid"
                      cellspacing="20px" 
                      style=" display: none;
                              border: none; 
                              height: 100%; 
                              left: 0px; 
                              position: absolute; 
                              top: 0px; 
                              table-layout: fixed; 
                              width: 100%;">
                      <style>td { border: 1px solid blue; }</style>
                      <tr><td>&nbsp;</td><td>&nbsp;</td></tr>
                      <tr><td>&nbsp;</td><td>&nbsp;</td></tr>
                    </table>
                  </div>
	              </div>
              </div>
            </DIV>]]>
          </content>
        </html>
      </group>
    </shape>
  </shapes>
</shapefile>
