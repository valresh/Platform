<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="10px" height="100px"><versionheaders><versionheader name="PS" value="6.1"/></versionheaders><scripts><script event="" language="VBScript" id="EA1B846A-5181-4183-A88D-CCDD37C13682"><![CDATA[dim bIndZ
bIndZ=0

sub lims(oSource,oSource1,oSource2,oSource3)
dim oShape,oGroup,oSymbH,oSymbL,ofs
on error resume next
set oGroup=oSource.parentnode
set oShape=oGroup.parentnode

sphi=oSource.value
splo=oSource1.value
pvhi=oSource2.value
pvlo=oSource3.value

set oSymbH=oShape.objects("PlgHigh")
set oSymbL=oShape.objects("PlgLow")

ofs=round(oGroup.style.pixelheight*pvlo/(pvhi-pvlo))
oSymbH.style.pixeltop=ofs+oGroup.style.pixelheight-oSymbH.style.pixelheight-round(oGroup.style.pixelheight*sphi/(pvhi-pvlo))
ss="SPHi: " & sphi & " " & page.all("ConAlpEUdesc").value
oSymbH.title=ss

oSymbL.style.pixeltop=ofs+oGroup.style.pixelheight-round(oGroup.style.pixelheight*splo/(pvhi-pvlo))
ss="SPLo: " & splo & " " & page.all("ConAlpEUdesc").value
oSymbL.title=ss
if bIndZ=0 then 
    oSymbH.style.zindex=-1
    oSymbL.style.zindex=-2
else
    oSymbH.style.zindex=0
    oSymbL.style.zindex=0
end if
end sub]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/><parameter name="cp_spp" type="Parameter" description="" defaultvalue="pid_pla.spp"/><parameter name="cp_splolm" type="Parameter" description="" defaultvalue="pid_pla.splo"/><parameter name="cp_sphilm" type="Parameter" description="" defaultvalue="pid_pla.sphi"/><parameter name="cp_pveulo" type="Parameter" description="" defaultvalue="pid_pla.pveulo"/><parameter name="cp_pveuhi" type="Parameter" description="" defaultvalue="pid_pla.pveuhi"/></parameters><shapes><shape><group><element><html><content><![CDATA[<SPAN class=hsc.indicator.1 id=ConIndSP style="BORDER-RIGHT: transparent 1px; BORDER-TOP: transparent 1px; FONT-WEIGHT: 400; FONT-SIZE: 0pt; LEFT: 0%; BEHAVIOR: url(#HSCIndicatorBehavior) url(#BindingBehavior); OVERFLOW: hidden; BORDER-LEFT: transparent 1px; WIDTH: 100%; COLOR: #000000; BORDER-BOTTOM: transparent 1px; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 100%; BACKGROUND-COLOR: transparent; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="borderStyle:inset;borderWidth:1px;fillColor:transparent;fillColorBlink:0;fillDirection:0;fillStyle:8;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:1;levelFillColor:#00bf00;levelFillColorBlink:0;lineColor:transparent;lineColorBlink:0;" printInverse="false" printLevelFillColor="#00bf00" printFillColor="transparent" printValuePercent="33" globalscripts></SPAN>]]></content><scripts><script event="onmouseout" language="VBScript"><![CDATA[me.style.zindex=0]]></script><script event="onmouseover" language="VBScript"><![CDATA[me.style.zindex=-2]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="17"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_spp%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Indicator" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=PlgHigh style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#polygon); OVERFLOW: hidden; WIDTH: 90%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 1%; HEIGHT: 4%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:#008000;fillColorBlink:False;Height:4;LineColor:transparent;lineColorBlink:False;LineStyle:0;points:0 100 100 100 0 0 0 100 ;textColor:#008000;Width:9;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=PlgLow style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#polygon); OVERFLOW: hidden; WIDTH: 90%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 6%; HEIGHT: 4%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:#008000;fillColorBlink:False;Height:4;LineColor:transparent;lineColorBlink:False;LineStyle:0;points:0.000000 0.000000 100.000000 0.000000 0.000000 100.000000 0.000000 0.000000 ;textColor:#008000;Width:9;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ConAlpPVEUHi style="BORDER-RIGHT: transparent 1px; PADDING-RIGHT: 2px; BORDER-TOP: transparent 1px; PADDING-LEFT: 2px; FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 20%; VISIBILITY: hidden; PADDING-BOTTOM: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; BORDER-LEFT: transparent 1px; WIDTH: 40%; COLOR: #000000; PADDING-TOP: 2px; BORDER-BOTTOM: transparent 1px; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 30%; HEIGHT: 4%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; ROWS: 1" tabIndex=-1 hdxproperties="borderStyle:inset;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;" printDisplayValue="9999.99">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[call lims(ConAlpSPHILM,ConAlpSPLOLM,me,ConAlpPVEULo)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_pveuhi%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ConAlpPVEULo style="BORDER-RIGHT: transparent 1px; PADDING-RIGHT: 2px; BORDER-TOP: transparent 1px; PADDING-LEFT: 2px; FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 20%; VISIBILITY: hidden; PADDING-BOTTOM: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; BORDER-LEFT: transparent 1px; WIDTH: 40%; COLOR: #000000; PADDING-TOP: 2px; BORDER-BOTTOM: transparent 1px; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 34%; HEIGHT: 4%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; ROWS: 1" tabIndex=-1 hdxproperties="borderStyle:inset;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;" printDisplayValue="9999.99">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[call lims(ConAlpSPHILM,ConAlpSPLOLM,ConAlpPVEUHi,me)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="V