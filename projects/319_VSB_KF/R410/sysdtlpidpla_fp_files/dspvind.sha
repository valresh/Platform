<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="16px" height="100px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src="..\Styles\SysFaceplate.css"/></stylesheets><scripts><script event="" language="VBScript" id="F8AA8681-D4BA-462B-91EC-9DEBBCFDB5AB"><![CDATA[sub sspv_pos(oSource,oSource1,oSource2)
dim oShape,oGroup,oSymb
	on error resume next
	set oGroup=oSource.parentnode
	set oShape=oGroup.parentnode
	sspv=oSource.value
	pvhi=oSource1.value
	pvlo=oSource2.value  
	set oSymb=oShape.objects("LinSSPV")
	oSymb.style.pixeltop=round(oGroup.style.pixelheight*pvlo/(pvhi-pvlo))+oGroup.style.pixelheight-round(oGroup.style.pixelheight*sspv/(pvhi-pvlo))
	ss="Steady State PV: " & sspv & " " & page.all("ConAlpEUdesc").value
	oSymb.title=ss 
end sub]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/><parameter name="cp_pvp" type="Parameter" description="" defaultvalue="pid_pla.pvp"/><parameter name="cp_pveulo" type="Parameter" description="" defaultvalue="pid_pla.pveulo"/><parameter name="cp_pveuhi" type="Parameter" description="" defaultvalue="pid_pla.pveuhi"/><parameter name="cp_sspv" type="Parameter" description="pid_pla.steadystatepv" defaultvalue="pid_pla.pv"/><parameter name="tagname" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="tagname" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="tagname" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<SPAN tabIndex=-1 id=ConIndPV class="hsc.indicator.1 LevelFill_Indicator_Style" style="OVERFLOW: hidden; FONT-SIZE: 0pt; TEXT-DECORATION: none; BORDER-TOP: transparent 1px; HEIGHT: 100%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 1px; WIDTH: 100%; BORDER-BOTTOM: transparent 1px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 0%; BORDER-LEFT: transparent 1px; TOP: 0%; BEHAVIOR: url(#HSCIndicatorBehavior) url(#BindingBehavior); BACKGROUND-COLOR: transparent" hdxproperties="borderStyle:inset;borderWidth:1;fillColor:#ffffff;fillColorBlink:0;fillDirection:0;fillStyle:0;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:1;levelFillColor:#00bfbf;levelFillColorBlink:0;lineColor:black;lineColorBlink:0;styleClass:LevelFill_Indicator_Style;" globalscripts printValuePercent="33" printFillColor="#ffffff" printLevelFillColor="#00bfbf" printInverse="false"></SPAN>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType