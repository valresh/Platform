dim bVisibilityUpdated
bVisibilityUpdated = FALSE

function QualityOK(PointObj)

'	Returns TRUE if the given object (parameter) is 'valid'
	if (PointObj.quality and &HFF) = &HC0 then
		QualityOK = true
	else
		QualityOK = false	
	end if

end function

function Configured(PointObj)

'	Returns TRUE if the given object (parameter) is 'configured' 
	if (PointObj.quality and &HFF) = &H04 then
		Configured = false	
	else
		Configured = true
	end if

end function]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue=""/><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 0.13%; FONT-FAMILY: Arial; HEIGHT: 0.19%; VISIBILITY: hidden; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect); TOP: 0%; LEFT: 0%" id=rectSpacerTL class=hvg.base.1 tabIndex=-1 hdxproperties="FillColor:#ff0000;fillColorBlink:False;Height:1;lineColorBlink:False;Width:1;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[<INPUT style="POSITION: absolute; BORDER-BOTTOM-COLOR: #ffffff; BACKGROUND-COLOR: #ece9d8; FONT-STYLE: normal; BORDER-TOP-COLOR: #ffffff; WIDTH: 13.05%; BACKGROUND-REPEAT: no-repeat; FONT-FAMILY: Arial; HEIGHT: 4.9%; VISIBILITY: hidden; COLOR: #000000; BORDER-RIGHT-COLOR: #ffffff; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); TOP: 88.03%; LEFT: 6.25%" id=btnPROCESS_PPS class=hsc.button.1 tabIndex=0 value=PROCESS type=button hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;indicateBadState:False;indicateNaNState:False;indicateScanState:False;lineColorBlink:False;textColorBlink:False;" HDX_LOCK="-1">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA['	Cause an immediate processing-request for this point
	sd.SetDataValueSynchronous "tagname.PPS", 1]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; FONT-STYLE: normal; WIDTH: 21.11%; FONT-FAMILY: Arial; HEIGHT: 4.7%; COLOR: #000000; FONT-SIZE: 16pt; OVERFLOW: hidden; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 31.56%; LEFT: 41.8%" id=txtLoading class=hvg.textbox.1 tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:152;" HDX_LOCK="-1">** Loading **</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; WIDTH: 10%; FONT-FAMILY: Small Fonts; HEIGHT: 2.35%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 7pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); TOP: 3.92%; LEFT: 19.86%" id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:12;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:72;" HDX_LOCK="-1">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim bTPNServerOK
	on error resume next

	if bVisibilityUpdated = FALSE then
		GrpAlarmLimitsHeader.style.visibility = "Inherit"
		GrpPointDataHeader.style.visibility = "Inherit"
		GrpGeneralHeader.style.visibility = "Inherit"
	end if

	if not sd.QualityGood("tagname.NODE_NO") then
		txtLoading.value = "** Missing TPN Data **"
		txtLoading.style.visibility = "Inherit"
		bTPNServerOK = FALSE
	else
		bTPNServerOK = TRUE
		txtLoading.style.visibility = "Hidden"
	end if


'GENERAL group
	if sd.QualityGood("tagname.PVAUTO") then 
		if IsNan(sd.DataValue("tagname.PVAUTO")) then
			param_PVAUTO.value = "NaN"
		else
			param_PVAUTO.value = FormatNumber(sd.DataValue("tagname.PVAUTO"))
		end if
		GrpPVAUTO.style.visibility = "Inherit"
	else
		GrpPVAUTO.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.CONTCUT") then
		if sd.DataValue("tagname.CONTCUT") <> 0 then
			text_CONTCUT.value = "ON"
		else
			text_CONTCUT.value = "OFF"
		end if
		GrpCONTCUT.style.visibility = "Inherit"
	else
		GrpCONTCUT.style.visibility = "Hidden"
	end if
 	if sd.QualityGood("tagname.PRIMMOD.NAME") then
		param_PRIMMOD.value = sd.DataValue("tagname.PRIMMOD.NAME")
		GrpPRIMMOD.style.visibility = "Inherit"
	else
		GrpPRIMMOD.style.visibility = "Hidden"
	end if
 	if sd.QualityGood("tagname.KEYWORD") then
		param_KEYWORD.value = sd.DataValue("tagname.KEYWORD")
		GrpKEYWORD.style.visibility = "Inherit"
	else
		GrpKEYWORD.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PVSOURCE") then
		GrpPVSOURCE.style.visibility = "Inherit"
	else
		GrpPVSOURCE.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PVNORMAL") then
		GrpPVNORMAL.style.visibility = "Inherit"
	else
		GrpPVNORMAL.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.CTLALGID") then
		param_CTLALGID.value = sd.DataValue("tagname.CTLALGID")
		GrpCTLALGID.style.visibility = "Inherit"
	else
		GrpCTLALGID.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ALGIDDAC") then
		param_ALGIDDAC.value = sd.DataValue("tagname.ALGIDDAC")
		GrpALGIDDAC.style.visibility = "Inherit"
	else
		GrpALGIDDAC.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OPCRDOP") then
		param_OPCRDOP.value = sd.DataValue("tagname.OPCRDOP")
		GrpOPCRDOP.style.visibility = "Inherit"
	else
		GrpOPCRDOP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.IPCRDOP") then
		param_IPCRDOP.value = sd.DataValue("tagname.IPCRDOP")
		GrpIPCRDOP.style.visibility = "Inherit"
	else
		GrpIPCRDOP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OPCRDTY") then
		param_OPCRDTY.value = sd.DataValue("tagname.OPCRDTY")
		GrpOPCRDTY.style.visibility = "Inherit"
	else
		GrpOPCRDTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.IPCRDTY") then
		param_IPCRDTY.value = sd.DataValue("tagname.IPCRDTY")
		GrpIPCRDTY.style.visibility = "Inherit"
	else
		GrpIPCRDTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.INPTSSLT") then
		param_INPTSSLT.value = FormatNumber(sd.DataValue("tagname.INPTSSLT"),0)
		GrpSUBSLOT.style.visibility = "Inherit"
	else
		GrpSUBSLOT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BOXNUM") then 
		param_BOXNUM.value = FormatNumber(sd.DataValue("tagname.BOXNUM"),0)
		GrpBOXNUM.style.visibility = "Inherit"
	else
		GrpBOXNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PNTBOXTY") and not sd.DataValue("tagname.PNTBOXTY") = "NOTCONFG" then
		param_PNTBOXTY.value = sd.DataValue("tagname.PNTBOXTY")
		GrpPNTBOXTY.style.visibility = "Inherit"
	else
		GrpPNTBOXTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.HWYNUM") then
		param_HWYNUM.value = FormatNumber(sd.DataValue("tagname.HWYNUM"),0)
		GrpHWYNUM.style.visibility = "Inherit"
	else
		GrpHWYNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.SLOTNUM") then
		param_SLOTNUM.value = FormatNumber(sd.DataValue("tagname.SLOTNUM"),0)
	else
		GrpSLOTNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODETYP") then
		param_NODETYP.value = sd.DataValue("tagname.NODETYP")
		GrpNODETYP.style.visibility = "Inherit"
	else
		GrpNODETYP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODENUM") then 
		param_NODENUM.value = FormatNumber(sd.DataValue("tagname.NODENUM"),0)
		GrpNODENUM.style.visibility = "Inherit"
	else
		GrpNODENUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NTWKNUM") then
		param_NTWKNUM.value = FormatNumber(sd.DataValue("tagname.NTWKNUM"),0)
		GrpNTWKNUM.style.visibility = "Inherit"
	else
		GrpNTWKNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.UNITNAME") then 
		param_UNITNAME.value = sd.DataValue("tagname.UNITNAME")
		GrpUNITNAME.style.visibility = "Inherit"
	else
		GrpUNITNAME.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PVALGID") then
		param_PVALGID.value = sd.DataValue("tagname.PVALGID")
		GrpPVALGID.style.visibility = "Inherit"
	else
		GrpPVALGID.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODE_NO") then
		param_NODE_NO.value = FormatNumber(sd.DataValue("tagname.NODE_NO"),0)
		GrpNODE_NO.style.visibility = "Inherit"
	else
		GrpNODE_NO.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ENT_TYPE") then
		param_ENT_TYPE.value = sd.DataValue("tagname.ENT_TYPE")
		GrpENT_TYPE.style.visibility = "Inherit"
	else
		GrpENT_TYPE.style.visibility = "Hidden"
	end if
	
	if sd.QualityGood("tagname.PNTMODTY") then
		param_PNTMODTY.value = sd.DataValue("tagname.PNTMODTY")
		GrpPNTMODTY.style.visibility = "Inherit"
	else
		GrpPNTMODTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.MODNUM") then
		param_MODNUM.value = sd.DataValue("tagname.MODNUM")
		GrpMODNUM.style.visibility = "Inherit"
	else
		GrpMODNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NORMCYCL") then
		param_NORMCYCL.value = sd.DataValue("tagname.NORMCYCL")
		GrpNORMCYCL.style.visibility = "Inherit"
	else
		GrpNORMCYCL.style.visibility = "Hidden"
	end if


	if not sd.QualityConfigError("tagname.PPSTYPE") then
		param_PPSTYPE.value = sd.DataValue("tagname.PPSTYPE")
		GrpPPSTYPE.style.visibility = "Inherit"
	else
		GrpPPSTYPE.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.RESTART") then
		param_RESTART.value = sd.DataValue("tagname.RESTART")
		GrpRESTART.style.visibility = "Inherit"
	else
		GrpRESTART.style.visibility = "Hidden"
	end if

	if not sd.QualityConfigError("tagname.S1CURSTS") then
		param_S1CURSTS.value = sd.DataValue("tagname.S1CURSTS")
		GrpS1CURSTS.style.visibility = "Inherit"
	else
		GrpS1CURSTS.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.S1ACCLVL") then
		param_S1ACCLVL.value = sd.DataValue("tagname.S1ACCLVL")
		GrpS1ACCLVL.style.visibility = "Inherit"
	else
		GrpS1ACCLVL.style.visibility = "Hidden"
	end if

	if not sd.QualityConfigError("tagname.S2CURSTS") then
		param_S2CURSTS.value = sd.DataValue("tagname.S2CURSTS")
		GrpS2CURSTS.style.visibility = "Inherit"
	else
		GrpS2CURSTS.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.S2ACCLVL") then
		param_S2ACCLVL.value = sd.DataValue("tagname.S2ACCLVL")
		GrpS2ACCLVL.style.visibility = "Inherit"
	else
		GrpS2ACCLVL.style.visibility = "Hidden"
	end if


' CPU Saver - BELOW UNBOUND PARAMETERS!
	if bVisibilityUpdated and bTPNServerOK and not bPeriodicVisibilityUpdate then 
		bDataChangeRequest = TRUE
		exit sub
	end if
	bPeriodicVisibilityUpdate = FALSE 'cpu saver flag

	if sd.QualityGood("tagname.PPS") then
		btnPROCESS_PPS.style.visibility = "Inherit"
	else
		btnPROCESS_PPS.style.visibility = "Hidden"
	end if

' ALARM limits

	if not sd.QualityConfigError("tagname.SALMDSC1") then
		GrpSALMDSC1.style.visibility = "Inherit"
		if sd.QualityGood("tagname.SWALM1PR") then
			if sd.DataValue("tagname.SWALM1PR") = "EMERGNCY" then
				almPrty1.value = 1
			elseif sd.DataValue("tagname.SWALM1PR") = "HIGH" then
				almPrty1.value = 2
			elseif sd.DataValue("tagname.SWALM1PR") = "LOW" then
				almPrty1.value = 3
			elseif sd.DataValue("tagname.SWALM1PR") = "JOURNAL" then
				almPrty1.value = 4
			elseif sd.DataValue("tagname.SWALM1PR") = "PRINTER" then
				almPrty1.value = 5
			elseif sd.DataValue("tagname.SWALM1PR") = "JNLPRINT" then
				almPrty1.value = 6
			else
				almPrty1.value = 0 'empty
			end if
		end if
	else
		GrpSALMDSC1.style.visibility = "Hidden"
		almPrty1.value = 0 'empty
	end if
	if not sd.QualityConfigError("tagname.SALMDSC2") then
		GrpSALMDSC2.style.visibility = "Inherit"
		if sd.QualityGood("tagname.SWALM2PR") then
			if sd.DataValue("tagname.SWALM2PR") = "EMERGNCY" then
				almPrty2.value = 1
			elseif sd.DataValue("tagname.SWALM2PR") = "HIGH" then
				almPrty2.value = 2
			elseif sd.DataValue("tagname.SWALM2PR") = "LOW" then
				almPrty2.value = 3
			elseif sd.DataValue("tagname.SWALM2PR") = "JOURNAL" then
				almPrty2.value = 4
			elseif sd.DataValue("tagname.SWALM2PR") = "PRINTER" then
				almPrty2.value = 5
			elseif sd.DataValue("tagname.SWALM2PR") = "JNLPRINT" then
				almPrty2.value = 6
			else
				almPrty2.value = 0 'empty
			end if
		end if
	else
		GrpSALMDSC2.style.visibility = "Hidden"
		almPrty2.value = 0 'empty
	end if

	if not sd.QualityConfigError("tagname.SALMDSC3") then
		GrpSALMDSC3.style.visibility = "Inherit"
		if sd.QualityGood("tagname.SWALM3PR") then
			if sd.DataValue("tagname.SWALM3PR") = "EMERGNCY" then
				almPrty3.value = 1
			elseif sd.DataValue("tagname.SWALM3PR") = "HIGH" then
				almPrty3.value = 2
			elseif sd.DataValue("tagname.SWALM3PR") = "LOW" then
				almPrty3.value = 3
			elseif sd.DataValue("tagname.SWALM3PR") = "JOURNAL" then
				almPrty3.value = 4
			elseif sd.DataValue("tagname.SWALM3PR") = "PRINTER" then
				almPrty3.value = 5
			elseif sd.DataValue("tagname.SWALM3PR") = "JNLPRINT" then
				almPrty3.value = 6
			else
				almPrty3.value = 0 'empty
			end if
		end if
	else
		GrpSALMDSC3.style.visibility = "Hidden"
	end if

' POINT DATA groups
	if not sd.QualityConfigError("tagname.PTEXECST") then
		GrpPTEXECST.style.visibility = "Inherit"
	else
		GrpPTEXECST.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.ALENBST") then
		GrpALENBST.style.visibility = "Inherit"
	else
		GrpALENBST.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.REDTAG") then
		GrpREDTAG.style.visibility = "Inherit"
	else
		GrpREDTAG.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.NMODE") then
		GrpNMODE.style.visibility = "Inherit"
	else
		GrpNMODE.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.NMODATTR") then
		GrpNMODATTR.style.visibility = "Inherit"
	else
		GrpNMODATTR.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.PNTFORM") then
		GrpPNTFORM.style.visibility = "Inherit"
	else
		GrpPNTFORM.style.visibility = "Hidden"
	end if

' GrpPointData2
	if not sd.QualityConfigError("tagname.S1REQSTS") then
		GrpS1REQSTS.style.visibility = "Inherit"
	else
		GrpS1REQSTS.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.S2REQSTS") then
		GrpS2REQSTS.style.visibility = "Inherit"
	else
		GrpS2REQSTS.style.visibility = "Hidden"
	end if

	if not sd.QualityConfigError("tagname.$AUXUNIT") then
		GrpAUXUNIT.style.visibility = "Inherit"
	else
		GrpAUXUNIT.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.ASSOCDSP") then
		GrpASSOCDSP.style.visibility = "Inherit"
	else
		GrpASSOCDSP.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.$CDETAIL") then
		GrpCDETAIL.style.visibility = "Inherit"
	else
		GrpCDETAIL.style.visibility = "Hidden"
	end if

	if bVisibilityUpdated = FALSE then
		GrpGeneral.style.visibility = "Inherit"
		GrpAlarmLimits.style.visibility = "Inherit"
		GrpPointData1.style.visibility = "Inherit"
		GrpPointData2.style.visibility = "Inherit"
		txtLoading.style.visibility = "Hidden"
	end if

