'--------------------------------------------
' BayMeasurements
'--------------------------------------------
sub IEC_BayMeasurements_AlpState_OnUpdate(oSource) 
   dim oShape
   on error resume next
   Set oShape = oSource.parentnode.parentnode
if (oSource.quality and iQualityBad)<>iQualityBad then
	if typename(oShape.objects("alpBayMeasurements")) <> "Nothing" then
		if oShape.objects("txtTagnameEU").value <> "" and oShape.objects("txtTagnameEU").value <> vbnullstring and oShape.objects("txtTagnameEU").value <> " "then
			oShape.objects("alpBayMeasurements").value = oSource.value & " (" &  oShape.objects("txtTagnameEU").value & ")"
		else
		oShape.objects("alpBayMeasurements").value = oSource.value
		end if
	end if
end if
  if err.number<>0 and window.external.environment = 0 then window.external.LogMessage " IEC_BayMeasurements_OnShapeLoad ->" & oSource.id & " " & err.description    
end sub
