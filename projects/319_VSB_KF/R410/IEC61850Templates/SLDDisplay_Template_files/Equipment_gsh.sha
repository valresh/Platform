' PowerCable
'--------------------------------------------
sub IEC_PowerCable_OnShapeLoad(oSource) 
   dim oShape, vStyle
   on error resume next
   set oShape=oSource
   vStyle = oShape.getCustomProperty("Style","cp_StyleForColor")
if ucase(page.getstyleclassproperty("Enable_VoltageColor","key")) = "ON" then
