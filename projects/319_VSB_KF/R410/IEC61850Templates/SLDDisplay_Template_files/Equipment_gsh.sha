'--------------------------------------------
' Circuit Breaker
'--------------------------------------------
sub IEC_CircuitBreaker_AlpState_OnUpdate(oSource) 
   dim iState,oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
	   iState=oSource.value
	   index=oShape.getCustomProperty("Style","cp_styleForState" & iState)
	   if typename(oShape.objects("LinST0")) <> "Nothing" then oShape.objects("LinST0").styleclass="LinST0_" & index	   
	   if typename(oShape.objects("LinST1")) <> "Nothing" then oShape.objects("LinST1").styleclass="LinST1_" & index	
	   if typename(oShape.objects("LinT1")) <> "Nothing" then oShape.objects("LinT1").styleclass="LinTx_" & index	   
	   if typename(oShape.objects("LinT2")) <> "Nothing" then oShape.objects("LinT2").styleclass="LinTx_" & index
   if err.number<>0 and window.external.environment = 0 then window.external.LogMessage " IEC_CircuitBreaker_AlpState_OnUpdate ->" & oSource.id & " " & err.description    
end sub
