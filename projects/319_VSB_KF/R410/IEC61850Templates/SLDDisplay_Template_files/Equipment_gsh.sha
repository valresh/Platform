'--------------------------------------
'ResizePage
'--------------------------------------
sub ResizePage()
	dim oDisplayTitle,oBackground, oNextPage
	on error resume next
	document.getElementById("shaBackground").style.pixelWidth = Background.clientWidth
	document.getElementById("shaDisplayTitle").style.pixelWidth = Background.clientWidth
	document.getElementById("shaNextPage").style.pixelLeft = Background.clientWidth - document.getElementById("shaNextPage").style.pixelWidth - 4
	document.getElementById("PicHoneywell").disabled = true
	if err.number<>0 and window.external.environment = 0 then window.external.LogMessage "ResizePage ->" & " " & err.description       
end sub
'--------------------------------------
'Quality
'--------------------------------------
sub IEC_Graph_AlpError_OnUpdate(oSource)
	dim oShape
	on error resume next
	set oShape=oSource.parentnode.parentnode
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
  		if typename(oShape.objects("TxtError"))<>"Nothing" then oShape.objects("TxtError").styleclass="TxtError_NoError"
	elseif (oSource.quality and iQualityBad)=iQualityBad then
  		if typename(oShape.objects("TxtError"))<>"Nothing" then oShape.objects("TxtError").styleclass="TxtError_InError"
	else
  		if typename(oShape.objects("TxtError"))<>"Nothing" then oShape.objects("TxtError").styleclass="TxtError_NoError"
	end if
	if err.number<>0 and window.external.environment = 0 then window.external.LogMessage "IEC_Graph_AlpError_OnUpdate ->" & oSource.id & " " & err.description       
end sub
'--------------------------------------------
' AuxiliaryNetwork
'--------------------------------------------
sub IEC_AuxiliaryNetwork_OnShapeLoad(oSource) 
   dim oShape, vStyle
   on error resume next
   set oShape=oSource
   vStyle = oShape.getCustomProperty("Style","cp_StyleForColor")
if ucase(page.getstyleclassproperty("Enable_VoltageColor","key")) = "ON" then
   if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_AuxiliaryNetwork" &" " & vStyle
   if typename(oShape.objects("txtSymbol")) <> "Nothing" then oShape.objects("txtSymbol").styleclass="Symbol_AuxiliaryNetwork" &" " & vStyle	
else
   if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_AuxiliaryNetwork"
   if typename(oShape.objects("txtSymbol")) <> "Nothing" then oShape.objects("txtSymbol").styleclass="Symbol_AuxiliaryNetwork" &" " & vStyle
end if
   if err.number<>0 and window.external.environment = 0 then window.external.LogMessage " IEC_AuxiliaryNetwork_OnShapeLoad ->" & oSource.id & " " & err.description    
end sub
