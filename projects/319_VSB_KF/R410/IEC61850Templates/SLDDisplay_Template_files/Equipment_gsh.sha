'--------------------------------------------
' PageNavigation
'--------------------------------------------
sub IEC_PageNavigation_OnShapeLoad(oSource) 
   dim oShape, sNextPage
   on error resume next
   set oShape=oSource
   sNextPage = oShape.getCustomProperty("Text","NextDisplayPage")
if sNextPage <> vbnullstring and sNextPage <> "" then
	oShape.style.visibility = "Inherit"
else
	oShape.style.visibility = "Hidden"
end if
   if err.number<>0 and window.external.environment = 0 then window.external.LogMessage " IEC_PageNavigation_OnShapeLoad ->" & oSource.id & " " & err.description    
end sub
