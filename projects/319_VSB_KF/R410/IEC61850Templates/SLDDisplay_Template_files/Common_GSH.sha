sub Nav_Button_Down(oSource)
dim oShape, oInfBorderLine1,oInfBorderLine2,oSuperiorBorderLine1,oSuperiorBorderLine2
on error resume next
set oShape = oSource.parentnode.parentnode
set oInfBorderLine1=oshape.objects("InferiorBorderLin1")
set oInfBorderLine2=oshape.objects("InferiorBorderLin2")
set oSuperiorBorderLine1=oshape.objects("SuperiorBorderLin1")
set oSuperiorBorderLine2=oshape.objects("SuperiorBorderLin2")
oInfBorderLine1.styleclass="NavSuperiorLine1"
oInfBorderLine2.styleclass="NavSuperiorLine2"
oSuperiorBorderLine1.styleclass="NavInferiorLine1"
oSuperiorBorderLine2.styleclass="NavInferiorLine2"
if err.number<>0 then window.external.LogMessage "Nav_Button_Down ->" & oSource.id & " " & err.description
end sub
sub Nav_Button_Up(oSource)
