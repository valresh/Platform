end sub
' -------------------------------------
'Building Blocks
' -------------------------------------
sub All_DigState_AlpPV_OnUpdate(oSource)
   dim oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   set oPV=oShape.objects("ScConAlpPV")
  	iPV=oSource.breakpointvalueenum
   	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
   	oPV.styleclass="ScConAlpPV_" & index		
   if err.number<>0 and window.external.environment = 0 then window.external.LogMessage " All_DigState_AlpPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub
sub All_DigStateCText_AlpPV_OnUpdate(oSource)
   dim oShape,oPVObj
   on error resume next
   set oShape=oSource.parentnode.parentnode
   set oPVObj=oShape.objects("TxtPV")
   if (oSource.quality and iQualityBad)=iQualityBad and  (oSource.quality and iQualityOffScan)<>iQualityOffScan then
      oPVObj.innertext="--------" 
      oPVObj.textcolor=vbRed
   else
	  oPVObj.innertext=oShape.GetCustomProperty("Text","cp_TextForPV" &  cstr(oSource.value))
      oPVObj.styleclass="ScConAlpPV_" & oShape.getcustomproperty("Style","cp_StyleForPV" & cstr(oSource.value))
   end if
   if err.number<>0 and window.external.environment = 0 then window.external.LogMessage " All_DigStateCText_AlpPV_OnUpdate ->" & oSource.id & " " & err.description 
end sub
'-------------------------------------
'Interlock and Bypass
'-------------------------------------
sub All_ILBPGraph_AlpError_OnUpdate(oSource)
	dim oShape
	on error resume next
    set oShape=oSource.parentnode.parentnode
	if oShape.getcustomproperty("Point","Tag2_Inhibited")<>"" then 
		iQuality2 =(oSource.dataquality("Tag2_Inhibited.cp_Tag2_pv") and iQualityGood)
	else
		iQuality2 = iQualityGood
	end if
    if ((oSource.quality and iQualityGood)=iQualityGood) and (iQuality2=iQualityGood) then
       oShape.objects("TxtError").styleclass="TxtError_NoError"
    else
       oShape.objects("TxtError").styleclass="TxtError_InError"
    end if
    if err.number<>0 and window.external.environment = 0 then window.external.LogMessage " Scd_ILBPGraph_AlpError_OnUpdate ->" & oSource.id & " " & err.description    
end sub
sub All_ILBP_AlpPV_OnUpdate(oSource,param)
	dim oShape, iPV
	on error resume next
	set oShape=oSource.parentnode.parentnode
	if param<=2 then
	  iValueONInt = cint(oShape.getcustomproperty("Num","cp_PlgInterlock_ONValue"))
	  if iValueONInt=cint(oSource.value) then : iInt=1 : else : iInt=0 : end if
	end if
	if param=2 then
	  iValueONByp = cint(oShape.getcustomproperty("Num","cp_TxtBypass_ONValue"))
      if iValueONByp=cint(oSource.datavalue("Tag2_Inhibited.cp_Tag2_pv")) then : iByp=1 : else : iByp=0 : end if
    end if
    if param=2 then 
	  iPV=2*iInt+iByp
    elseif param=1 then
	  iPV=iInt 
	end if
	if param=3 then iPV="ForPV" & cint(oSource.value)    
	index = oShape.getcustomproperty("Style","cp_Style" & iPV)
  oShape.objects("PlgInterLock").styleclass = "PlgInterLock_" & index	
  if param>=2 then oShape.objects("TxtBypass").styleclass = "TxtBypass_" & index
	if typename(oShape.objects("TxtType"))<>"Nothing" then oShape.objects("TxtType").styleclass = "TxtType_" & index
	if err.number<>0 and window.external.environment = 0 then window.external.LogMessage "All_ILBP_AlpPV_OnUpdate ->" & oSource.id & " " & err.description      			
end sub
'--------------------------------------
'Alarm Object 
'--------------------------------------
sub All_ObjAlm_OnUpdate(oSource)
    dim oShape
    on error resume next
	set oShape=oSource.parentnode.parentnode
	sAlmName=oShape.getcustomproperty("Text","cp_AlmObjName")
	if sAlmName="-" then exit sub 
	set oAlmIcon=oSource
	iPriority=oAlmIcon.priority
	bUnAcknowledged=not oAlmIcon.acknowledged
    bRTN=oAlmIcon.RTN
	set oAlmObj=oShape.objects(sAlmName)
	sAlmObjAlmStyleUnack=sAlmName & "_Alarm_Unack"
	sAlmObjAlmStyleAck=sAlmName & "_Alarm_Ack"
	sAlmObjNoAlmStyle=sAlmName & "_NoAlarm"
	oAlmObj.styleclass = sAlmObjNoAlmStyle
    sAlmObjProp=oAlmObj.GetStyleProperty("hw-Alarm-Property")	
    select case iPriority
		case 0:
			oAlmObj.styleclass=sAlmObjNoAlmStyle
        case 1:			
            sAlmObjPropColor=oAlmObj.id & "." & sAlmObjProp & "=" & """" & AlarmStateIconfactory.lowcolor & """"
			execute(sAlmObjPropColor)
        case 2:
            sAlmObjPropColor=oAlmObj.id & "." & sAlmObjProp & "=" & """" & AlarmStateIconfactory.highcolor  & """"
			execute(sAlmObjPropColor)
        case 3:
			sAlmObjPropColor=oAlmObj.id & "." & sAlmObjProp & "=" & """" & AlarmStateIconfactory.urgentcolor & """"
			execute(sAlmObjPropColor)
		case else:	
			oAlmObj.styleclass=sAlmObjNoAlmStyle			    
	end select
	    if bUnAcknowledged then
			oAlmObj.styleclass=sAlmObjAlmStyleUnack
		else	
			oAlmObj.styleclass=sAlmObjAlmStyleAck
		end if  
    if bRTN then oAlmObj.styleclass=sAlmObjNoAlmStyle
	if err.number<>0 and window.external.environment = 0 then window.external.LogMessage "All_ObjAlm_OnUpdate ->" & oSource.id & " " & err.description 
end sub
'--------------------------------------
'Alarm Object 
'--------------------------------------
'Provide Left Click behavior for radar objects. Invoke Faceplate
sub All_Radar_OnClick(oSource)
	dim oShape,soldsel, index, Quality
  	on error resume next
	if bTrdResp=true then bCancel=true	' Check to prevent message zone flickering, when All_TrdSel_lib_h_01_R300.sha is not present in the current display.
										' See Trend_Sup_GSH.sha trdresp subroutine
 	set oShape=oSource.parentnode.parentnode
	call SelectBox_Color(oSource)
	index = right(oSource.id,2)
	if left(index,1)>"9" then index=right(oSource.id,1)
    if typename(oshape.objects("ConAlarmState" & index))<> "Nothing" then
		set otarget=oshape.objects("ConAlarmState" & index)
	elseif  typename(oshape.objects("ScConAlpPV" & index))<> "Nothing" then
		set otarget=oshape.objects("ScConAlpPV" & index)
	end if
	sfaceplatefile=oshape.getcustomproperty("text","faceplatefile" & index)
    if sfaceplatefile="" then
   	   set oSource.onfocus = nothing
       otarget.click 
	   oTarget.style.color = oTarget.textcolor
    elseif sfaceplatefile="-" then
       'if not isobject(oSource.onfocus) then set oSource.onfocus=getref("ObjSel")
       'oSource.focus
	   call ObjSel
    else
       scurrentpoint=oshape.getcustomproperty("point","EdgeTag"& index)
       sPoints= "?CurrentPoint=" & sCurrentPoint 
       for n=1 to oshape.customProperties.Count -1
  	      if oshape.customProperties.Item(n).type = "Point" or oshape.customProperties.Item(n).type = "Parameter" then 
    	    sPoints = sPoints & "&" & oshape.customProperties.Item(n).name & "=" & oshape.customProperties.Item(n).value
	      end if
       next	   
       sfaceplatefile = mid(sfaceplatefile,1,instr(1,sfaceplatefile,".htm")+3)
	   Quality = oTarget.quality
       if (Quality and iQualityAccessNotPermitted) <> iQualityAccessNotPermitted then call hdxpopupbehavior.createpopupwindow(sfaceplatefile & spoints,0,0,1)
    end if 
end sub
'Provide Right Click behavior for radar object. Invoke Context Menu.
sub All_Radar_OnCMenu(oSource)
    dim oShape,soldsel
    on error resume next
    if bTrdResp=true then bCancel=true	' Check to prevent message zone flickering, when All_TrdSel_lib_h_01_R300.sha is not present in the current display.
										' See Trend_Sup_GSH.sha trdresp subroutine
    set oShape=oSource.parentnode.parentnode
    call SelectBox_Color(oSource)
    'if not isobject(oSource.onactivate) then set oSource.onactivate=getref("ObjSel_Radar")
	index = right(oSource.id,1)
    sCMfile=oshape.getcustomproperty("text","ContextMenuFile" & index)
    if isnull(page.getattribute("CMenu_GSH")) then
		use_cm_shape=false
	else 
		use_cm_shape = true
	end if
    if sCMfile="-" then
      'oSource.focus
    elseif sCMfile="" or use_cm_shape = false then
	  	'oSource.focus
		if typename(oshape.objects("ConAlarmState" & index))<> "Nothing" then
		    oShape.objects("ConAlarmState" & index).fireevent("oncontextmenu")      
		elseif  typename(oshape.objects("ScConAlpPV" & index))<> "Nothing" then
			oShape.objects("ScConAlpPV" & index).fireevent("oncontextmenu")
		end if
    else
      'oSource.focus
      hdxpopupbehavior.invokeshortcutmenu sCMfile,0,0    
    end if
	call ObjSel_Radar
end sub
'Focus ConAlarmState for radar objects.
sub ObjSel_Radar
	dim oShape
	on error resume next
    set oShape=document.getelementbyid(page.getattribute("lastselection")).parentnode.parentnode
	index=right(page.getattribute("lastselection"),1)
	if typename(oshape.objects("ConAlarmState" & index))<> "Nothing" then
	    oShape.objects("ConAlarmState" & index).focus
	elseif  typename(oshape.objects("ScConAlpPV" & index))<> "Nothing" then
	    oShape.objects("ScConAlpPV" & index).focus
	end if
end sub
'Rotating Devices Interaction with process lines
sub All_ProcessLines_OnUpdate(oSource,iNumStates)
	dim oShape, sKey, oObj, sSecondKey, sOpenStyle, sClosedStyle, bValveOpen
	on error resume next
	set oShape=oSource.parentnode.parentnode
	sClosedStyle=oShape.getcustomproperty("Text","cp_CLine_Style")
	sOpenStyle=oShape.getcustomproperty("Text","cp_OLine_Style")
	bValveOpen=false
	if (cint(oSource.value) = cint(oShape.getcustomproperty("Num","cp_Ovalue"))) then bValveOpen = true
	sKey=oShape.getcustomproperty("Text","cp_keyword")
	if sKey="" then exit sub
	if iNumStates = 3 then sSecondKey=oShape.getcustomproperty("Text","cp_keyword2")	
	for each oObj in Page.all
		 if instr(UCASE(oObj.id), UCASE(sKey))>0 then
			 	oObj.styleclass = sClosedStyle
				if bValveOpen then oObj.styleclass = sOpenStyle
		 end if  
		 if iNumStates = 3 then
			 if sSecondKey="" then exit sub
				 if instr(UCASE(oObj.id), UCASE(sSecondKey))>0 then
				 	oObj.styleclass = sClosedStyle
					if not bValveOpen then oObj.styleclass = sOpenStyle
				 end if  
		 end if                                         
	next
	if err.number <>0 and window.external.environment = 0 then window.external.LogMessage " All_ProcessLines_OnUpdate ->" & oSource.id & " " & err.description 
end sub
'--------------------------------------
' Display Tabs (Navigations)
'--------------------------------------
sub All_Tab_Nav_OnClick(oSource)
Dim oShape, sDspName
on error resume next
	set oShape=oSource.parentnode.parentnode
	if page.getattribute("GSH_Yoking")<> "" and window.external.windowmode = 1 and ucase(page.getstyleclassproperty("Enable_Yoking","key"))="ON" then 'Advanced SP
	 call ReadAndCallAssociates(oSource)
	else
	 sDspName = oShape.GetCustomProperty("Text","DspName")
	 if sDspName<>"" and oSource.title<>window.external.currentpage then
	 	window.external.parent.RequestTask 21, 1, 0, 0, 0, sDspName
	 end if
	end if
	if err.number<>0 then window.external.LogMessage " All_Tab_Nav_OnClick ->" & oSource.id & " " & err.description   
end sub
sub TabOnShapeLoad(oSource,sAGPresent)
	'sAGPresent = true the shape contains an alarm group
	dim oShape, sTitle, oLine1, oLine2
	on error resume next
	'set oShape= oSource.parentnode.parentnode
	sTitle= window.external.CurrentPage
	'Set Navigation or disable buttons
	if oSource.getcustomproperty("text","DspName")="" then
		document.getelementbyid(oSource.id &"_ScPshNav").disabled=true
		document.getelementbyid(oSource.id &"_ScPshNav").title="Display is not configured"
	else
		document.getelementbyid(oSource.id &"_ScPshNav").title=oSource.getcustomproperty("text","DspName")
	end if
	'Check if this is the current display
	if Ucase(document.getElementById(oSource.id &"_ScPshNav").title)= Ucase(sTitle) or Ucase(document.getElementById(oSource.id &"_ScPshNav").title & ".HTM")= Ucase(sTitle) then
		document.getElementById(oSource.id &"_PolR").styleclass = "TabLinesSelected"
		document.getElementById(oSource.id &"_PolL").styleclass = "TabLinesSelected"
		document.getElementById(oSource.id &"_BaseLine").linecolor="transparent"
		document.getElementById(oSource.id &"_RecBack").fillcolor=page.GetStyleClassProperty("Background","hw-fill-color")
		document.getElementById(oSource.id &"_BaseLine").linecolor=page.GetStyleClassProperty("Background","hw-fill-color")'"transparent"
		document.getelementbyid(oSource.id &"_ScPshNav").disabled=true
	end if
	'Set CorrectStyle for PolAlm
	'if sAGPresent then document.getElementById(oSource.id &"_PolAlm").styleclass = "TabLineAlarm" 'Removed vka
	'Check if there is an Alarm Group
	if sAGPresent and oSource.GetCustomProperty("Point","GrpAlm")="" then 
			document.getElementById(oSource.id &"_RecBack").fillcolor = "#FFFFFF"
			document.getElementById(oSource.id &"_PolAlm").style.visibility = "hidden"
	end if
	if err.number<>0 then window.external.LogMessage " TabOnShapeLoad ->" & oSource.id & " " & err.description   
End sub
sub NavBar_AlmColor_OnUpdate(oSource)
	on error resume next
	dim oShape, oAlm, oAlmBox
	sAlmName="PolAlm"
	set oShape= oSource.parentnode.parentnode
	iUUrgent=oSource.dataValue("GrpAlm.TotalUrgentUnackAlarms")
	iUHigh=oSource.dataValue("GrpAlm.TotalHighUnackAlarms")
	iULow=oSource.dataValue("GrpAlm.TotalLowUnackAlarms")
	iAUrgent=oSource.dataValue("GrpAlm.TotalUrgentAlarms")
	iAHigh=oSource.dataValue("GrpAlm.TotalHighAlarms")
	iALow=oSource.dataValue("GrpAlm.TotalLowAlarms")
	iRTNUrgent = oSource.dataValue("GrpAlm.TotalUrgentRTNUnackAlarms")
	iRTNHigh = oSource.dataValue("GrpAlm.TotalHighRTNUnackAlarms")
	iRTNLow = oSource.dataValue("GrpAlm.TotalLowRTNUnackAlarms")
	if Typename (oShape.Objects("ConAlarmState")) <> "Nothing" then
		if iUUrgent>0 and iUUrgent>iRTNUrgent then
	 	  	oShape.Objects("ConAlarmState").priority=3
			oShape.Objects("ConAlarmState").RTN=false
			oShape.Objects("ConAlarmState").acknowledged=false
			iPriority=3
			bUnAcknowledged = True
			bRTN = False
		elseif iUHigh>0 and iUHigh>iRTNHigh then
	 	    oShape.Objects("ConAlarmState").priority=2
			oShape.Objects("ConAlarmState").RTN=false
			oShape.Objects("ConAlarmState").acknowledged=false
			iPriority=2
			bUnAcknowledged = True
			bRTN = False
		elseif iULow>0 and iULow>iRTNLow then
	 	    oShape.Objects("ConAlarmState").priority=1
			oShape.Objects("ConAlarmState").RTN=false
			oShape.Objects("ConAlarmState").acknowledged=false
			iPriority=1
			bUnAcknowledged = True
			bRTN = False
		elseif iRTNUrgent>0 then
			oShape.Objects("ConAlarmState").priority=3
			oShape.Objects("ConAlarmState").RTN=true
			oShape.Objects("ConAlarmState").acknowledged=false
			iPriority=0
			bUnAcknowledged = False
			bRTN = True
		elseif iRTNHigh>0 then
			oShape.Objects("ConAlarmState").priority=2
			oShape.Objects("ConAlarmState").RTN=true
			oShape.Objects("ConAlarmState").acknowledged=false
			iPriority=0
			bUnAcknowledged = False
			bRTN = True
		elseif iRTNLow>0 then
			oShape.Objects("ConAlarmState").priority=1
			oShape.Objects("ConAlarmState").RTN=true
			oShape.Objects("ConAlarmState").acknowledged=false
			iPriority=0
			bUnAcknowledged = False
			bRTN = True
		elseif iAUrgent>0 then
	  	  	oShape.Objects("ConAlarmState").priority=3
		  	oShape.Objects("ConAlarmState").RTN=false
			oShape.Objects("ConAlarmState").acknowledged=true
	 	  	iPriority=3
			bUnAcknowledged = False
			bRTN = False
		elseif iAHigh>0 then
	 	   	oShape.Objects("ConAlarmState").priority=2
			oShape.Objects("ConAlarmState").RTN=false
			oShape.Objects("ConAlarmState").acknowledged=true
	 	  	iPriority=2
			bUnAcknowledged = False
			bRTN = False
		elseif iALow>0 then
	 	   	oShape.Objects("ConAlarmState").priority=1
		   	oShape.Objects("ConAlarmState").RTN=false
			oShape.Objects("ConAlarmState").acknowledged=true
	 	  	iPriority=1
			bUnAcknowledged = False
			bRTN = False
		else
	 	    oShape.Objects("ConAlarmState").priority=0
		    oShape.Objects("ConAlarmState").RTN=false
		    oShape.Objects("ConAlarmState").acknowledged=true
	 	  	iPriority=0
			bUnAcknowledged = False
			bRTN = False
		end if
	else
		if iUUrgent>0 and iUUrgent>iRTNUrgent then
	 	  	iPriority=3
			bUnAcknowledged = True
			bRTN = False
		elseif iUHigh>0 and iUHigh>iRTNHigh  then
	 	  	iPriority=2
			bUnAcknowledged = True
			bRTN = False
		elseif iULow>0 and iULow>iRTNLow then
	 	  	iPriority=1
			bUnAcknowledged = True
			bRTN = False
		elseif iAUrgent>0 then
	 	  	iPriority=3
			bUnAcknowledged = False
			bRTN = False
		elseif iAHigh>0 then
	 	  	iPriority=2
			bUnAcknowledged = False
			bRTN = False
		elseif iALow>0 then
	 	  	iPriority=1
			bUnAcknowledged = False
			bRTN = False
		else
	 	  	iPriority=0
			bUnAcknowledged = False
			bRTN = False
		end if
	end if
	if sAlmName="-" then exit sub 
	set oAlmObj=oShape.objects(sAlmName)
	sAlmObjAlmStyleUnack=sAlmName & "_Alarm_Unack"
	sAlmObjAlmStyleAck=sAlmName & "_Alarm_Ack"
	sAlmObjNoAlmStyle=sAlmName & "_NoAlarm"
	'oAlmObj.styleclass = sAlmObjNoAlmStyle
    sAlmObjProp=oAlmObj.GetStyleProperty("hw-Alarm-Property")
	    select case iPriority
			case 0:
				oAlmObj.styleclass=sAlmObjNoAlmStyle
	        case 1:
	            sAlmObjPropColor=oAlmObj.id & "." & sAlmObjProp & "=" & """" & AlarmStateIconfactory.lowcolor & """"
				execute(sAlmObjPropColor)
	        case 2:
	            sAlmObjPropColor=oAlmObj.id & "." & sAlmObjProp & "=" & """" & AlarmStateIconfactory.highcolor & """"
				execute(sAlmObjPropColor)
	        case 3:
	            sAlmObjPropColor=oAlmObj.id & "." & sAlmObjProp & "=" & """" & AlarmStateIconfactory.urgentcolor & """"
				execute(sAlmObjPropColor)
			case else:	
				oAlmObj.styleclass=sAlmObjNoAlmStyle
		end select
		if bUnAcknowledged then
			oAlmObj.styleclass=sAlmObjAlmStyleUnack
		elseif iPriority>0 then
			oAlmObj.styleclass=sAlmObjAlmStyleAck
		end if
		if bRTN then oAlmObj.styleclass=sAlmObjNoAlmStyle
	if err.number<>0 then window.external.LogMessage " NavBar_AlmColor_OnUpdate ->" & oSource.id & " " & err.description    
end sub]]></script></scripts><parameters><parameter name="Revision" type="Num" description="Revision" defaultvalue="R430 Rev.1"/></parameters><shapes><shape><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; FONT-STYLE: normal; WIDTH: 103px; FONT-FAMILY: Arial; HEIGHT: 40px; VISIBILITY: hidden; COLOR: #0000ff; FONT-SIZE: 8pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 10px; LEFT: 42px" id=TxtGSH class=hvg.textbox.1 tabIndex=-1 globalscripts hdxproperties="FillColor:#afeeee;fillColorBlink:False;FillStyle:0;Height:40;lineColorBlink:False;LineStyle:1;textColor:#0000ff;textColorBlink:False;TotalRotation:-1;value:;Width:103;">Common General Script Holder<BR>{%Num::Revision%} </DIV>]]></content></html></element></shape></shapes></shapefile>