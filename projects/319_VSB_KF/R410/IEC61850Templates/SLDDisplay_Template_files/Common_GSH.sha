on error resume next
set oShape = oSource.parentnode.parentnode
set oInfBorderLine1=oshape.objects("InferiorBorderLin1")
set oInfBorderLine2=oshape.objects("InferiorBorderLin2")
set oSuperiorBorderLine1=oshape.objects("SuperiorBorderLin1")
