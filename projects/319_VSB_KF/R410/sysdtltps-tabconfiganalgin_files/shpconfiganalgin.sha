	else
		GrpAUTROPT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.$AUTRTIM") then
		GrpAUTRTIM.style.visibility = "Inherit"
	else
		GrpAUTRTIM.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PVALDBEU") then
		GrpPVALDBEU.style.visibility = "Inherit"
	else
		GrpPVALDBEU.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.$REALARM") then
		GrpREALARM.style.visibility = "Inherit"
	else
		GrpREALARM.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.$ALDLOPT") then
		GrpALDLOPT.style.visibility = "Inherit"
	else
		GrpALDLOPT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.DLYTIME") then
		GrpDLYTIME.style.visibility = "Inherit"
	else
		GrpDLYTIME.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PVROCPPR") then
		GrpPVROCPPR.style.visibility = "Inherit"
	else
		GrpPVROCPPR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PVROCPR") then
		GrpPVROCPR.style.visibility = "Inherit"
	else
		GrpPVROCPR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.BCLEALPR") then
		GrpBCLEALPR.style.visibility = "Inherit"
	else
		GrpBCLEALPR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.BCLFALPR") then
		GrpBCLFALPR.style.visibility = "Inherit"
	else
		GrpBCLFALPR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.CLEALMPR") then
		GrpCLEALMPR.style.visibility = "Inherit"
	else
		GrpCLEALMPR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.CLFALMPR") then
		GrpCLFALMPR.style.visibility = "Inherit"
	else
		GrpCLFALMPR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.$RPSELCT") then
		GrpRPSELCT.style.visibility = "Inherit"
	else
		GrpRPSELCT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PVROCNPR") then
		GrpPVROCNPR.style.visibility = "Inherit"
	else
		GrpPVROCNPR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.$RNSELCT") then
		GrpRNSELCT.style.visibility = "Inherit"
	else
		GrpRNSELCT.style.visibility = "Hidden"
	end if


	if sd.QualityGood("tagname.$DLBADAL") then
		GrpDLBADAL.style.visibility = "Inherit"
	else
		GrpDLBADAL.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PVFLTOPT") then
		GrpPVFLTOPT.style.visibility = "Inherit"
	else
		GrpPVFLTOPT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.LOCUTOFF") then
		GrpLOCUTOFF.style.visibility = "Inherit"
	else
		GrpLOCUTOFF.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.INPTDIR") then
		GrpINPTDIR.style.visibility = "Inherit"
	else
		GrpINPTDIR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PVTEMP") then
		GrpPVTEMP.style.visibility = "Inherit"
	else
		GrpPVTEMP.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.SENSRTYP") then
		GrpSENSRTYP.style.visibility = "Inherit"
		GrpSENSRTYP001.style.visibility = "Inherit"
	else
		GrpSENSRTYP.style.visibility = "Hidden"
		GrpSENSRTYP001.style.visibility = "Inherit"
	end if

	if sd.QualityGood("tagname.SLWSRCID") then
		GrpSLWSRCID.style.visibility = "Inherit"
	else
		GrpSLWSRCID.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.BADPVPR") then
		GrpBADPVPR.style.visibility = "Inherit"
	else
		GrpBADPVPR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.$OLDEVDS") then
		GrpOLDEVDS.style.visibility = "Inherit"
	else
		GrpOLDEVDS.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.CCSRC") then
		GrpCCSRC.style.visibility = "Inherit"
	else
		GrpCCSRC.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.SMPLTFM") then
		GrpSMPLTFM.style.visibility = "Inherit"
	else
		GrpSMPLTFM.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.$CDETAIL") then
		GrpCDETAIL.style.visibility = "Inherit"
	else
		GrpCDETAIL.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.$AUXUNIT") then
		GrpAUXUNIT.style.visibility = "Inherit"
	else
		GrpAUXUNIT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.TCRNGOPT") then
		GrpTCRNGOPT.style.visibility = "Inherit"
	else
		GrpTCRNGOPT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PIUOTDCF") then
		GrpPIUOTDCF.style.visibility = "Inherit"
		GrpPIUOTDCF001.style.visibility = "Inherit"
	else
		GrpPIUOTDCF.style.visibility = "Hidden"
		GrpPIUOTDCF001.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.CJTACT") then
		GrpCJTACT.style.visibility = "Inherit"
	else
		GrpCJTACT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.DECONF") then
		GrpDECONF.style.visibility = "Inherit"
	else
		GrpDECONF.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PVRAW") then
		GrpPVRAW.style.visibility = "Inherit"
	else
		GrpPVRAW.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.URL") then
		GrpURL.style.visibility = "Inherit"
	else
		GrpURL.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.URV") then
		GrpURV.style.visibility = "Inherit"
	else
		GrpURV.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.LRV") then
		GrpLRV.style.visibility = "Inherit"
	else
		GrpLRV.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.LRL") then
		GrpLRL.style.visibility = "Inherit"
	else
		GrpLRL.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.STI_EU") then
		GrpSTI_EU.style.visibility = "Inherit"
	else
		GrpSTI_EU.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.SECVAR") then
		GrpSECVAR.style.visibility = "Inherit"
	else
		GrpSECVAR.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.DAMPING") then
		GrpDAMPING.style.visibility = "Inherit"
	else
		GrpDAMPING.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.SERIALNO") then
		GrpSERIALNO.style.visibility = "Inherit"
	else
		GrpSERIALNO.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.STATE") then
		GrpSTATE.style.visibility = "Inherit"
	else
		GrpSTATE.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.COMMAND") then
		GrpCOMMAND.style.visibility = "Inherit"
	else
		GrpCOMMAND.style.visibility = "Hidden"
	end if

	'Transmitter Scratch Pad, Transmitter Status, and Database Discrepancy are all pulled from S1 parameter
	'read 16 chars, add space, then next 16 for scratch pad (one line)
	'then do the same for next two 32 (plus space) character lines for Transmitter Status
	'if the STATE parameter is "DBCHANGE" then Database Discrepancy is shown as next 16 chars.
	'to avoid script errors on string manipulations, we always test for existing string length before accessing chars
	if sd.QualityGood("tagname.S1") then

		sTemp1 = sd.DataValue("tagname.S1")       'first 64 chars of S1 is considered 'transmitter scratch pad'
		sTemp2 = ""
		sTemp3 = ""

		if LEN(sTemp1) >= 16 then
			'peel off 16 into sTemp2 and sTemp3 and pop a space between for scratch pad value
			sTemp2 = LEFT(sTemp1, 16)
			sTemp1 = RIGHT(sTemp1, LEN(sTemp1)-16)
		end if

		if LEN(sTemp1) >= 16 then
			sTemp3 = LEFT(sTemp1, 16)
			sTemp1 = RIGHT(sTemp1, LEN(sTemp1)-16) ' peel off 16 used above
		end if

		txtScratchPadValue.innerText = sTemp2 & " " & sTemp3 'first two 16-chars with space delimiter between

		sTemp2 = ""		'clear for reuse for statusvalue1
		sTemp3 = ""

		if LEN(sTemp1) >= 16 then
			'do this again, for 1st of two Transmitter Status value lines (each 16-chars twice with space between)
			sTemp2 = LEFT(sTemp1, 16)				' 1st half of status value1
			sTemp1 = RIGHT(sTemp1, LEN(sTemp1)-16)	' peel 16
		end if

		if LEN(sTemp1) >= 16 then
			sTemp3 = LEFT(sTemp1, 16)				' 2nd half of status value1
			sTemp1 = RIGHT(sTemp1, LEN(sTemp1)-16)	' peel 16
		end if
		txtStatusValue1.innerText = sTemp2 & " " & sTemp3

		sTemp2 = ""		'clear for reuse for statusvalue2
		sTemp3 = ""

		if LEN(sTemp1) >= 16 then
			'do this again, for 1st of two Transmitter Status value lines (each 16-chars twice with space between)
			sTemp2 = LEFT(sTemp1, 16)				' 1st half of status value1
			sTemp1 = RIGHT(sTemp1, LEN(sTemp1)-16)	' peel 16
		end if

		if LEN(sTemp1) >= 16 then
			sTemp3 = LEFT(sTemp1, 16)				' 2nd half of status value1
			sTemp1 = RIGHT(sTemp1, LEN(sTemp1)-16)	' peel 16
		end if
		txtStatusValue2.innerText = sTemp2 & " " & sTemp3

		if sd.QualityGood("CurrentPoint.STATE") and LEN(sTemp1) > 0 then
			if sd.DataValue("CurrentPoint.STATE") = "DBCHANGE" then
				'what is left is the database discrepancy value
				if LEN(sTemp1) <= 16 then
					txtDiscrepancyValue.innerText = sTemp1 
				else
					sTemp2 = ""
					sTemp3 = ""
					sTemp2 = LEFT(sTemp1, 16)
					sTemp1 = RIGHT(sTemp1, LEN(sTemp1)-16)	
					if LEN(sTemp1) > 0 then
						sTemp3 = sTemp1
					end if
					txtDiscrepancyValue.innerText = sTemp2 & " " & sTemp3  'in case two strings' worth
				end if
				grpDatabaseDiscrepancy.style.visibility = "Inherit"
			else
				grpDatabaseDiscrepancy.style.visibility = "Hidden"
			end if
		else
			grpDatabaseDiscrepancy.style.visibility = "Hidden"
		end if
	else
		txtScratchPadValue.innerText = ""
		txtStatusValue1.innerText = ""
		txtStatusValue2.innerText = ""
		grpDatabaseDiscrepancy.style.visibility = "Hidden"
	end if

	if bVisibilityUpdated = FALSE then

		GrpLeft.style.visibility = "Inherit"
		GrpCenter.style.visibility = "Inherit"
		GrpRight.style.visibility = "Inherit"
		GrpLeftLower.style.visibility = "Inherit"
		GrpCenterLower.style.visibility = "Inherit"
		GrpRightLower.style.visibility = "Inherit"
	
		if sd.DataValue("tagname.PNTMODTY") = "STIM" then  'show Smart Transmitter Data parameters
			GrpSTIM.style.visibility = "Inherit"
		end if
	end if

	bVisibilityUpdated = TRUE
	call UpdateMainGroups]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVFORMAT,PVSRCOPT,PVCHAR,PVCLAMP,PVHHPR,$HHSELCT,PVHIPR,$HISELCT,PVLOPR,$LOSELCT,PVLLPR,$LLSELCT,$REALARM,$ALDLOPT,DLYTIME,PVROCPPR,$RPSELCT,PVROCNPR,$RNSELCT,$DLBADAL,PVFLTOPT,LOCUTOFF,PVTEMP,SENSRTYP,SLWSRCID,$OLDEVDS,PVROCPR,PVALDB,PVALDBEU,ASSOCDSP,$AUXUNIT,$CDETAIL,PLCADDR,PVRAWHI,PVRAWLO,INPTDIR,PIUOTDCF,SLWSRCID,TCRNGOPT,CCSRC,SMPLTFM,CJTACT,DECONF,PVRAW,URL,URV,LRV,