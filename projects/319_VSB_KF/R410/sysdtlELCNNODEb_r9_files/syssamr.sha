<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="416px" height="210px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><parameters><parameter name="TagName" type="Point" description="" defaultvalue=""/><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="TagNamePrimary" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: center; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; BORDER-LEFT-STYLE: none; WIDTH: 11.53%; FONT-FAMILY: Arial; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 8.57%; VISIBILITY: hidden; COLOR: #ff0000; BORDER-RIGHT-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); TOP: 29.04%; LEFT: 25%; ROWS: 1" id=sd class="hsc.alpha.1 HSC.ScriptDataObject.1 " tabIndex=-1 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;styleClass:;textColor:#ff0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	'Determine the value for "Status"
	if me.qualityGood("TagNamePrimary.REDINOP") and me.qualityGood("TagNamePrimary.REDCONFG") then
		txtAMRStatusAlt.textColor = vbBlack
		if me.DataValue("TagNamePrimary.REDINOP") = 1 then
			txtAMRStatusAlt.value = "OPERATIONAL"
		elseif me.DataValue("TagNamePrimary.REDCONFG") = 1 then
			txtAMRStatusAlt.value = "CONFIGURED"
		else
			txtAMRStatusAlt.value = "NOT CONFIGURED"
		end if
	else
		'Emulate the behavior of the other points when data is loading
		txtAMRStatusAlt.textColor = vbRed
		txtAMRStatusAlt.value = "--------"
	end if

	'Determine the value for "Buffer Utilization"
	if me.qualityGood("TagName.REDBFMIN") and me.qualitygood("TagName.REDBFZ") then
		txtAMRBufferAlt.textColor = vbBlack
		Dim bufferSize
		bufferSize = me.DataValue("TagName.REDBFZ")
		txtAMRBufferAlt.value = formatnumber((100-(100*(me.DataValue("TagName.REDBFMIN")) / bufferSize)),0)
	else
		'Emulate the behavior of the other points when data is loading
		txtAMRBufferAlt.textColor = vbRed
		txtAMRBufferAlt.value = "--------"
	end if

	'Determine the value for "Resynchronization count"
	if me.qualityGood("TagName.RESYNCS(1)") then
		txtAMRResyncAlt.textColor = vbBlack
		txtAMRResyncAlt.value = me.DataValue("TagName.RESYNCS(1)")
	else
		'Emulate the behavior of the other points when data is loading
		txtAMRResyncAlt.textColor = vbRed
		txtAMRResyncAlt.value = "--------"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagNamePrimary%},{%Point::TagNamePrimary%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="RESYNCS(1),REDBFMIN,REDBFZ,REDCONFG,REDINOP,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,,"/></dataobjectdef></dataobject><class ID="HSC.A