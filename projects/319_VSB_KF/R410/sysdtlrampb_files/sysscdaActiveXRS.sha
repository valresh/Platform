<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="814px" height="444px"><versionheaders><versionheader name="PS" value="5.3"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[On Error Resume Next
	
	Dim NumSig
	NumSig=0
	If (len(Me.Objects("PrimSig").Value)) <> 255  Then
		NumSig=1
	End If
	If NumSig=1 And len(Me.Objects("SecSig").Value) <> 255  Then
		NumSig=2
	End If

	me.Objects("RsGraph1").PointName = window.external.DetailPointID 
	me.Objects("RsGraph1").ServerName = window.external.DetailPointServerNetworkName 
	me.Objects("RsGraph1").SecurityLevel = window.external.SecurityLevel 
	me.Objects("RsGraph1").OperatorName = window.external.OperatorID 
	me.Objects("RsGraph1").StationServerName = window.external.ServerName 
	me.Objects("RsGraph1").StationNumber = window.external.StationNumber	
	me.Objects("RsGraph1").ElectronicSignature = me.Objects("ESig").value
	me.Objects("RsGraph1").ControlConfirm = me.Objects("CtrlConfirmProp").value
	me.Objects("RsGraph1").NumberSignatures = NumSig

	me.Objects("CmActiveX1").height = me.style.height
	me.Objects("CmActiveX1").width = me.style.width]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/></parameters><shapes><shape><group><element><html><content><![CDATA[
