<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="768px" height="194px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="" language="JScript" id="679EE490-D427-4D16-A238-8D748032D9D4"><![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///
/// History:
///
/// [RLEAPFI-590]	April 30, 2018		Set the style of Device Type, Device ID and Device Revision to Waring on mismatch..
/// [RLEAPFI-638]	April 24, 2018		Correct the alignment of text within the shape to the specification for the Device Details tab's columns.
/// EXP510.1-31		April 24, 2018		Initial Experion R510 testbed release
///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="Point Name" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxGroupTitle title="Configuration of the I/O Channel as stored in the Experion Server database. Some of these parameters have corresponding elements that are stored in the transmitter." class="hvg.textbox.1 SL_SectionHeader" style="FONT-SIZE: 14pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 13.91%; FONT-FAMILY: arial; WIDTH: 32.42%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:27;lineColorBlink:False;LineStyle:0;styleClass:SL_SectionHeader;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:249;">I/O Channel Configuration</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxDeviceLocation title="This text entry can be used to describe the location of the transmitter within the facility. " class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 13.91%; FONT-FAMILY: arial; WIDTH: 19.53%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 73.71%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:27;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:150;">Device Location</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxDrawingNumber title="This text field can be used to indicate either a drawing number or the local stock number of a replacement." class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 13.91%; FONT-FAMILY: arial; WIDTH: 19.53%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 85.56%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:27;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:150;">Drawing Number</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxDeviceRevision title="Revision number of the firmware expected to be loaded in the transmitter. This revision number is used by Experion to determine the process, configuration and status information available from the transmitter." class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 13.91%; FONT-FAMILY: arial; WIDTH: 19.53%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 38.14%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:27;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:150;">Device Revision</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxChannelNumber title="The channel on the Series C HART Enabled I/O module that this transmitter is wired to." class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 13.91%; FONT-FAMILY: arial; WIDTH: 19.53%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 61.85%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:27;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:150;">Channel Number</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaDeviceRevision title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Numeric_Left_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 13.91%; FONT-FAMILY: arial; WIDTH: 10.67%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 22.13%; TOP: 38.14%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%.0f;styleClass:SL_Numeric_Left_Normal;textColor:#404040;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");

	if (this.DataValue("SLAnalogPoint.HREVMISM") == 1)
	{
		textboxDeviceRevision.StyleClass = "SL_Label_Warning";
		this.StyleClass = "SL_Numeric_Left_Warning";
	}
	else
	{
		textboxDeviceRevision.StyleClass = "SL_Label_Normal";
		this.StyleClass = "SL_Numeric_Left_Normal";
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="HDVREVCD"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HREVMISM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaChannelNumber title="" class="hsc.alpha.1 SL_Numeric_Left_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 13.91%; FONT-FAMILY: arial; WIDTH: 10.67%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 22.13%; TOP: 61.85%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%.0f;styleClass:SL_Numeric_Left_Normal;textColor:#404040;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="CHANNUM"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaDeviceLocation class="hsc.alpha.1 SL_Text_N