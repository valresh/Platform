<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="8px" height="100px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src="..\Styles\SysFaceplate.css"/></stylesheets><scripts><script event="" language="VBScript" id="907A5BEF-524D-4DF2-BDA4-B351EC7BF94C"><![CDATA[sub ssop_pos(oSource,oSource1,oSource2)
dim oShape,oGroup,oSymb
	on error resume next
	set oGroup=oSource.parentnode
	set oShape=oGroup.parentnode
	ssop=oSource.value
	cvhi=oSource1.value
	cvlo=oSource2.value  
	set oSymb=oShape.objects("LinSSOP")
	oSymb.style.pixeltop=round(oGroup.style.pixelheight*cvlo/(cvhi-cvlo))+oGroup.style.pixelheight-round(oGroup.style.pixelheight*ssop/(cvhi-cvlo))
	ss="Steady State OPEU: " & ssop & " " & page.all("ConAlpEUdesc").value
	oSymb.title=ss 
end sub]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/><parameter name="cp_op" type="Parameter" description="" defaultvalue="pid_pla.op"/><parameter name="cp_cveulo" type="Parameter" description="" defaultvalue="pid_pla.cveulo"/><parameter name="cp_cveuhi" type="Parameter" description="" defaultvalue="pid_pla.cveuhi"/><parameter name="cp_SSOP" type="Parameter" description="" defaultvalue="pid_pla.steadystateopeu"/></parameters><shapes><shape><group><element><html><content><![CDATA[<SPAN tabIndex=-1 id=ConIndOP class="hsc.indicator.1 LevelFill_Indicator_Style" style="OVERFLOW: hidden; FONT-SIZE: 0pt; TEXT-DECORATION: none; BORDER-TOP: transparent 1px; HEIGHT: 100%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 1px; WIDTH: 100%; BORDER-BOTTOM: transparent 1px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 0%; BORDER-LEFT: transparent 1px; TOP: 0%; BEHAVIOR: url(#HSCIndicatorBehavior) url(#BindingBehavior)" hdxproperties="borderStyle:inset;borderWidth:1;fillColor:#ffffff;fillColorBlink:0;fillDirection:0;fillStyle:0;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:1;levelFillColor:#bfbf00;levelFillColorBlink:0;lineColor:black;lineColorBlink:0;styleClass:LevelFill_Indicator_Style;" printValuePercent="33" printFillColor="#ffffff" printLevelFillColor="#bfbf00" printInverse="false"></SPAN>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="17"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_op%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Indicator" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=LinSSOP class=hvg.base.1 style="OVERFLOW: hidden; FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 1%; FONT-FAMILY: Arial; WIDTH: 87.5%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 28%; BEHAVIOR: url(#HDXVectorFactory#line); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;Height:1;lineColorBlink:False;LineWidth:2;points:0.000000 0.000000 100.000000 0.000000 ;Width:7;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ConAlpCVEUHi class=hsc.alpha.1 style="OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 12pt; TEXT-DECORATION: none; BORDER-TOP: transparent 2px; HEIGHT: 4%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 2px; WIDTH: 50%; BORDER-BOTTOM: transparent 2px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 2px; PADDING-LEFT: 2px; LEFT: 37.5%; BORDER-LEFT: transparent 2px; TOP: 40%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:inset;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;" printDisplayValue="9999.99">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
call ssop_pos(ConAlpSSOP,me,ConALpCVEULo)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_cveuhi%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ConAlpCVEULo class=hsc.alpha.1 style="OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 12pt; TEXT-DECORATION: none; BORDER-TOP: transparent 2px; HEIGHT: 4%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 2px; WIDTH: 50%; BORDER-BOTTOM: transparent 2px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 2px; PADDING-LEFT: 2px; LEFT: 37.5%; BORDER-LEFT: transparent 2px; TOP: 48%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:inset;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;" printDisplayValue="9999.99">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
call ssop_pos(ConAlpSSOP,ConAlpCVEUHi,me)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_cveulo%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ConAlpSSOP class=hsc.alpha.1 style="OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 12pt; TEXT-DECORATION: none; BORDER-TOP: transparent 2px; HEIGHT: 4%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 2px; WIDTH: 50%; BORDER-BOTTOM: transparent 2px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 2px; PADDING-LEFT: 2px; LEFT: 37.5%; BORDER-LEFT: transparent 2px; TOP: 56%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:inset;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;" printDisplayValue="9999.99">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
