<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="160px" height="50px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><parameters><parameter name="mypoint" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="myeippcodename" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/><parameter name="myprimmodname" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/><parameter name="mylogicsrcname" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/><parameter name="boxpoint" type="Point" description="" defaultvalue=""/><parameter name="myboxntwkname" type="Parameter" description="" defaultvalue=""/><parameter name="mybefaftidname" type="Parameter" description="" defaultvalue="NAME"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=LOGICSRC class="hsc.alpha.1 Data_value_left" style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 32%; FONT-FAMILY: Verdana; WIDTH: 99.37%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: black; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 and me.value <> "0" then
			shpmain.objects("txtLOGICSRC").innerText = me.innerText
			shpmain.objects("txtLabelLOGICSRC").innerText = "LOG" & "ICSRC:" 'dont ask
			shpmain.objects("GrpLOGICSRC").style.visibility = "Inherit"
		else
			shpmain.objects("GrpLOGICSRC").style.visibility = "Hidden"
			shpmain.objects("txtLOGICSRC").innerText = ""
			shpmain.objects("txtLabelLOGICSRC").innerText = ""
		end if
		call UpdateGeneralGroup
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::mylogicsrcname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=EIPPCODE class="hsc.alpha.1 Data_value_left" style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 32%; FONT-FAMILY: Verdana; WIDTH: 99.37%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: black; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 24%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 and me.value <> "0" then
			shpmain.objects("txtEIPPCODE").innerText = me.innerText
			shpmain.objects("txtLabelEIPPCODE").innerText = "EIP" & "PCODE:" 'dont ask
			shpmain.objects("GrpEIPPCODE").style.visibility = "Inherit"
		else
			shpmain.objects("GrpEIPPCODE").style.visibility = "Hidden"
			shpmain.objects("txtEIPPCODE").innerText = ""
			shpmain.objects("txtLabelEIPPCODE").innerText = ""

		end if
		call UpdateGeneralGroup
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myeippcodename%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=PRIMMOD class="hsc.alpha.1 Data_value_left" style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 32%; FONT-FAMILY: Verdana; WIDTH: 99.37%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: black; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 48%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 and me.value <> "0" then
			shpmain.objects("txtPRIMMOD").innerText = me.innerText
			shpmain.objects("txtLabelPRIMMOD").innerText = "PRI" & "MMOD:" 'dont ask
			shpmain.objects("GrpPRIMMOD").style.visibility = "Inherit"
		else
			shpmain.objects("GrpPRIMMOD").style.visibility = "Hidden"
			shpmain.objects("txtPRIMMOD").innerText = ""
			shpmain.objects("txtLabelPRIMMOD").innerText = ""

		end if
		call UpdateGeneralGroup
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myprimmodname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=BOXNTWK class="hsc.alpha.1 Data_value_left" style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 32%; FONT-FAMILY: Verdana; WIDTH: 99.37%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: black; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 68%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;textColorBlink:False;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if me.value = "FTE" then
		window.external.parent.logmessage "$BOXNTWK is FTE: this is an EHB point"
		g_bEmulatedHG = TRUE
	else
		window.external.parent.logmessage "$BOXNTWK is >>" & me.value & "<< this is NOT an EHB point"		
	end if

	call UpdateEHBStatus()]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::boxpoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myboxntwkname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group002 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 50px; WIDTH: 160px; POSITION: absolute; LEFT: 46px; TOP: 31px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:50;lineColorBlink:False;Width:160;"></DIV>]]></content></html></group></shape></shapes></shapefile>