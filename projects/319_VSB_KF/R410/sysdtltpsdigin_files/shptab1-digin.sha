dim bVisibilityUpdated
bVisibilityUpdated = FALSE]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectSpacerTL001 class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 0.19%; FONT-FAMILY: Arial; WIDTH: 0.13%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 33.05%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect); VISIBILITY: hidden" hdxproperties="FillColor:#ff0000;fillColorBlink:False;Height:1;lineColorBlink:False;Width:1;"></DIV>]]></content></html></element><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=lineGeneral001 class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 5.55%; FONT-FAMILY: Arial; WIDTH: 99.46%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 83.33%; BEHAVIOR: url(#HDXVectorFactory#line)" hdxproperties="fillColorBlink:False;Height:1;lineColorBlink:False;points:0.000000 0.000000 100.000000 0.000000 ;Width:185;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtInputHeader class="hvg.textbox.1 Label_Text" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 94.44%; FONT-FAMILY: Helvetica; WIDTH: 60.75%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; TEXT-ALIGN: left; LEFT: 0.53%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:Label_Text;textColor:black;textColorBlink:False;TotalRotation:-1;Width:113;">Input</DIV>]]></content></html></element><html><content><![CDATA[
<DIV tabIndex=-1 id=GrpInputHeader class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 3.51%; WIDTH: 25.83%; POSITION: absolute; LEFT: 34.58%; TOP: 3.51%; BEHAVIOR: url(#HDXVectorFactory#group); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;Height:18;lineColorBlink:False;Width:186;"></DIV>]]></content></html></group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectSpacerBR class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 0.19%; FONT-FAMILY: Arial; WIDTH: 0.13%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 99.86%; TOP: 99.8%; BEHAVIOR: url(#HDXVectorFactory#rect); VISIBILITY: hidden" hdxproperties="FillColor:#ff0000;fillColorBlink:False;Height:1;lineColorBlink:False;Width:1;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectSpacerTL class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 0.19%; FONT-FAMILY: Arial; WIDTH: 0.13%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0.19%; BEHAVIOR: url(#HDXVectorFactory#rect); VISIBILITY: hidden" hdxproperties="FillColor:#ff0000;fillColorBlink:False;Height:1;lineColorBlink:False;Width:1;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" style="FONT-SIZE: 7pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 3.12%; FONT-FAMILY: Small Fonts; WIDTH: 7.5%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ff0000; TEXT-ALIGN: center; LEFT: 35.83%; TOP: 86.52%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:16;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:54;" HDX_LOCK="-1">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim bTPNServerOK

	on error resume next

	if bVisibilityUpdated = FALSE then
		GrpGeneralHeader.style.visibility = "Inherit"
		GrpPointDataHeader.style.visibility = "Inherit"
		GrpConfigHeader.style.visibility = "Inherit"
		GrpInputHeader.style.visibility = "Inherit"
	end if

	if not sd.QualityGood("tagname.NODE_NO") then
		txtLoading.innerText = "** Missing TPN Data **"
		txtLoading.style.visibility = "Inherit"
		bTPNServerOK = FALSE
	else
		bTPNServerOK = TRUE
		txtLoading.style.visibility = "Hidden"
	end if

' Update all UNBOUND parameters

' GrpGeneral
	if not sd.QualityGood("tagname.CONTCUT") then
		GrpCONTCUT.style.visibility = "Hidden"
	else
		GrpCONTCUT.style.visibility = "Visible"
	  	if sd.DataValue("tagname.CONTCUT") then
	    	param_CONTCUT.value = "ON"
	  	else 
	  		param_CONTCUT.value = "OFF"
	  	end if
	end if
	if not sd.QualityGood("tagname.ENT_TYPE") then
		GrpENT_TYPE.style.visibility = "Hidden"
	else
		GrpENT_TYPE.style.visibility = "Visible"
		param_ENT_TYPE.value = sd.DataValue("tagname.ENT_TYPE")
	end if
	if not sd.QualityGood("tagname.ALGIDDAC") then
		GrpALGIDDAC.style.visibility = "Hidden"
	else
		GrpALGIDDAC.style.visibility = "Visible"
		param_ALGIDDAC.value = sd.DataValue("tagname.ALGIDDAC")
	end if
	if not sd.QualityGood("tagname.NODE_NO") then
		GrpNODE_NO.style.visibility = "Hidden"
	else
		GrpNODE_NO.style.visibility = "Visible"
		param_NODE_NO.value = sd.DataValue("tagname.NODE_NO")
	end if
	if not sd.QualityGood("tagname.NTWKNUM") then
		GrpNTWKNUM.style.visibility = "Hidden"
	else
		GrpNTWKNUM.style.visibility = "Visible"
		param_NTWKNUM.value = sd.DataValue("tagname.NTWKNUM")
	end if
	if not sd.QualityGood("tagname.NODENUM") then
		GrpNODENUM.style.visibility = "Hidden"
	else
		GrpNODENUM.style.visibility = "Visible"
		param_NODENUM.value = sd.DataValue("tagname.NODENUM")
	end if

	if sd.QualityGood("tagname.UNITNAME") then 
		param_UNITNAME.value = sd.DataValue("tagname.UNITNAME")
		GrpUNITNAME.style.visibility = "Inherit"
	else
		GrpUNITNAME.style.visibility = "Hidden"
	end if

	if not sd.QualityGood("tagname.NODETYP") then
		GrpNODETYP.style.visibility = "Hidden"
	else
		GrpNODETYP.style.visibility = "Visible"
		param_NODETYP.value = sd.DataValue("tagname.NODETYP")
	end if
	if not sd.QualityGood("tagname.MODNUM") then
		GrpMODNUM.style.visibility = "Hidden"
	else
		GrpMODNUM.style.visibility = "Visible"
		param_MODNUM.value = sd.DataValue("tagname.MODNUM")
	end if
	if not sd.QualityGood("tagname.PNTMODTY") then
		GrpPNTMODTY.style.visibility = "Hidden"
	else
		GrpPNTMODTY.style.visibility = "Visible"
		param_PNTMODTY.value = sd.DataValue("tagname.PNTMODTY")
	end if
	if not sd.QualityGood("tagname.PLCADDR") then
		GrpPLCADDR.style.visibility = "Hidden"
	else
		GrpPLCADDR.style.visibility = "Visible"
		param_PLCADDR.value = sd.DataValue("tagname.PLCADDR")
	end if
	if not sd.QualityGood("tagname.PVAUTO") then
		GrpPVAUTO.style.visibility = "Hidden"
	else
		GrpPVAUTO.style.visibility = "Visible"
		param_PVAUTO.value = sd.DataValue("tagname.PVAUTO")
	end if
	if not sd.QualityGood("tagname.PVSOURCE") then
		GrpPVSOURCE.style.visibility = "Hidden"
	else
		GrpPVSOURCE.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.PVNORMAL") then
		GrpPVNORMAL.style.visibility = "Hidden"
	else
		GrpPVNORMAL.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.FBTIME") then
		GrpFBTIME.style.visibility = "Hidden"
	else
		GrpFBTIME.style.visibility = "Visible"
		param_FBTIME.value = sd.DataValue("tagname.FBTIME")
	end if
	if not sd.QualityGood("tagname.CMDFALTM") then
		GrpCMDFALTM.style.visibility = "Hidden"
	else
		GrpCMDFALTM.style.visibility = "Visible"
		param_CMDFALTM.value = sd.DataValue("tagname.CMDFALTM")
	end if
	if not sd.QualityGood("tagname.SVTV") then
		GrpSVTV.style.visibility = "Hidden"
	else
		GrpSVTV.style.visibility = "Visible"
		param_SVTV.value = sd.DataValue("tagname.SVTV")
	end if
	if not sd.QualityGood("tagname.IPCRDOP") then
		GrpIPCRDOP.style.visibility = "Hidden"
	else
		GrpIPCRDOP.style.visibility = "Visible"
		param_IPCRDOP.value = sd.DataValue("tagname.IPCRDOP")
	end if
	if not sd.QualityGood("tagname.IPCRDTY") then
		GrpIPCRDTY.style.visibility = "Hidden"
	else
		GrpIPCRDTY.style.visibility = "Visible"
		param_IPCRDTY.value = sd.DataValue("tagname.IPCRDTY")
	end if
	if not sd.QualityGood("tagname.HWYNUM") then
		GrpHWYNUM.style.visibility = "Hidden"
	else
		GrpHWYNUM.style.visibility = "Visible"
		param_HWYNUM.value = sd.DataValue("tagname.HWYNUM")
	end if
	if not sd.QualityGood("tagname.PNTBOXTY") then
		GrpPNTBOXTY.style.visibility = "Hidden"
	else
		GrpPNTBOXTY.style.visibility = "Visible"
		param_PNTBOXTY.value = sd.DataValue("tagname.PNTBOXTY")
	end if

	if not sd.QualityGood("tagname.KEYWORD") then
		GrpKEYWORD.style.visibility = "Hidden"
	else
		GrpKEYWORD.style.visibility = "Visible"
		param_KEYWORD.value = sd.DataValue("tagname.KEYWORD")
	end if

	if not sd.QualityGood("tagname.INTVARNM") then
		GrpINTVARNM.style.visibility = "Hidden"
	else
		GrpINTVARNM.style.visibility = "Visible"
		param_INTVARNM.value = sd.DataValue("tagname.INTVARNM")
	end if

	if not sd.QualityGood("tagname.PCADDRI1") then
		GrpPCADDRI1.style.visibility = "Hidden"
	else
		GrpPCADDRI1.style.visibility = "Visible"
		param_PCADDRI1.value = sd.DataValue("tagname.PCADDRI1")
	end if

	if not sd.QualityGood("tagname.PNTFORM") then
		GrpPNTFORM.style.visibility = "Hidden"
	else
		GrpPNTFORM.style.visibility = "Visible"
		param_PNTFORM.value = sd.DataValue("tagname.PNTFORM")
	end if
	if not sd.QualityGood("tagname.PVRAW") then
		GrpPVRAW.style.visibility = "Hidden"
	else
		GrpPVRAW.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.OVERVAL") then
		GrpOVERVAL.style.visibility = "Hidden"
	else
		GrpOVERVAL.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.DIGALARM") then
		GrpDIGALARM.style.visibility = "Hidden"
	else
		GrpDIGALARM.style.visibility = "Visible"
		param_DIGALARM.value = sd.DataValue("tagname.DIGALARM")
	end if
	if not sd.QualityGood("tagname.EIPSTATE") then
		GrpEIPSTATE.style.visibility = "Hidden"
	else
		GrpEIPSTATE.style.visibility = "Visible"
		param_EIPSTATE.value = sd.DataValue("tagname.EIPSTATE")
	end if
	if not sd.QualityGood("tagname.S1S2S3S4") then
		GrpS1S2S3S4.style.visibility = "Hidden"
	else
		GrpS1S2S3S4.style.visibility = "Visible"
		param_S1S2S3S4.value = sd.DataValue("tagname.S1S2S3S4")
	end if

'GrpSlotIn
	if sd.QualityGood("tagname.BOXNUM") then 
		window.external.parent.logmessage "detail showing BOXNUM parameter" & sd.DataValue("tagname.BOXNUM")
		param_BOXNUM.value = FormatNumber(sd.DataValue("tagname.BOXNUM"),0)
		if g_bEmulatedHG = TRUE then 
			txtEHGIndicator.style.visibility = "Inherit"
			window.external.parent.logmessage "EHB: IS emulated (showing E next to BOX param)"
		else
			window.external.parent.logmessage "EHB: IS NOT emulated (not showing E next to BOX param)"
			txtEHGIndicator.style.visibility = "Hidden"
		end if
		GrpBOXNUM.style.visibility = "Visible"
	else
		window.external.parent.logmessage "detail BOXNUM parameter is invalid"
		GrpBOXNUM.style.visibility = "Hidden"
	end if

	if not sd.QualityGood("tagname.SLOTNUM") then
		GrpSLOTNUM.style.visibility = "Hidden"
	else
		GrpSLOTNUM.style.visibility = "Visible"
		param_SLOTNUM.value = sd.DataValue("tagname.SLOTNUM")
	end if
	if not sd.QualityGood("tagname.INPTSSLT") then
		GrpINPTSSLT.style.visibility = "Hidden"
	else
		GrpINPTSSLT.style.visibility = "Visible"
		param_INPTSSLT.value = sd.DataValue("tagname.INPTSSLT")
	end if
	if sd.QualityGood("tagname.NMBRINPT") then
		if sd.DataValue("tagname.NMBRINPT") = 1 then
			txtInputHeader.innerText = "Single Input"
		elseif sd.DataValue("tagname.NMBRINPT") = 2 then
			txtInputHeader.innerText = "Dual Input"
		else
			txtInputHeader.innerText = "Input"
		end if
	end if

'GrpConfig
	if not sd.QualityGood("tagname.ASSOCDSP") then
		GrpASSOCDSP.style.visibility = "Hidden"
	else
		GrpASSOCDSP.style.visibility = "Visible"
		if param_ASSOCDSP.innerText = "" then
			param_ASSOCDSP.innerText = "      "
		end if
	end if
	if not sd.QualityGood("tagname.$CDETAIL") then
		GrpCDETAIL.style.visibility = "Hidden"
	else
		GrpCDETAIL.style.visibility = "Visible"
		if param_CDETAIL.innerText = "" then
			param_CDETAIL.innerText = "      "
		end if
	end if
	if not sd.QualityGood("tagname.OFFNRMAL") then
		GrpOFFNRMAL.style.visibility = "Hidden"
	else
		GrpOFFNRMAL.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.CCSRC") or sd.DataValue("tagname.CCSRC") = -1 then
		GrpCCSRC.style.visibility = "Hidden"
	else
		GrpCCSRC.style.visibility = "Visible"
		param_CCSRC.value = FormatNumber(sd.DataValue("tagname.CCSRC"),0)
	end if


' CPU Saver BELOW ALL EXPLICIT UNBOUND PARAMETER UPDATES!
	if bVisibilityUpdated and bTPNServerOK and not bPeriodicVisibilityUpdate then 
		bDataChangeRequest = TRUE
		exit sub
	end if

	bPeriodicVisibilityUpdate = FALSE 'cpu saver flag

' GrpPointData
	if not sd.QualityGood("tagname.PTEXECST") then
		GrpPTEXECST.style.visibility = "Hidden"
	else
		GrpPTEXECST.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.ALENBST") then
		GrpALENBST.style.visibility = "Hidden"
	else
		GrpALENBST.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.EMS") then
		GrpEMS.style.visibility = "Hidden"
	else
		GrpEMS.style.visibility = "Visible"
	end if

' GrpConfig
	if not sd.QualityGood("tagname.UBOXCLR") then
		GrpUBOXCLR.style.visibility = "Hidden"
	else
		GrpUBOXCLR.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.LBOXCLR") then
		GrpLBOXCLR.style.visibility = "Hidden"
	else
		GrpLBOXCLR.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.PVSRCOPT") then
		GrpPVSRCOPT.style.visibility = "Hidden"
	else
		GrpPVSRCOPT.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.INPTDIR") then
		GrpINPTDIR.style.visibility = "Hidden"
	else
		GrpINPTDIR.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.DITYPE") then
		GrpDITYPE.style.visibility = "Hidden"
	else
		GrpDITYPE.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.EVTOPT") then
		GrpEVTOPT.style.visibility = "Hidden"
	else
		GrpEVTOPT.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.ALMOPT") then
		GrpALMOPT.style.visibility = "Hidden"
	else
		GrpALMOPT.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.DLYTIME") then
		GrpDLYTIME.style.visibility = "Hidden"
	else
		GrpDLYTIME.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.OFFNRMPR") then
		GrpOFFNRMPR.style.visibility = "Hidden"
	else
		GrpOFFNRMPR.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.$AUXUNIT") then
		GrpAUXUNIT.style.visibility = "Hidden"
	else
		GrpAUXUNIT.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.$MPROD1") then
		GrpMPROD1.style.visibility = "Hidden"
	else
		GrpMPROD1.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.$MPROD2") then
		GrpMPROD2.style.visibility = "Hidden"
	else
		GrpMPROD2.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.$MPROD3") then
		GrpMPROD3.style.visibility = "Hidden"
	else
		GrpMPROD3.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.$MPROD4") then
		GrpMPROD4.style.visibility = "Hidden"
	else
		GrpMPROD4.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.PVCHGDLY") then
		GrpPVCHGDLY.style.visibility = "Hidden"
	else
		GrpPVCHGDLY.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.DEBOUNCE") then
		GrpDEBOUNCE.style.visibility = "Hidden"
	else
		GrpDEBOUNCE.style.visibility = "Visible"
	end if

	if bVisibilityUpdated = FALSE then
		GrpGeneral.style.visibility = "Inherit"
		GrpPointData.style.visibility = "Inherit"
		GrpConfig.style.visibility = "Inherit"			
		txtLoading.style.visibility = "Hidden"
	end if

	bVisibilityUpdated = TRUE
	call UpdateMainGroups]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVAUTO,PVSOURCE,PVNORMAL,FBTIME,CMDFALTM,SVTV,CONTCUT,ENT_TYPE,NODE_NO,NODENUM,SLOTNUM,ALENBST,PNTFORM,ASSOCDSP,$CDETAIL,OFFNRMPR,$AUXUNIT,PLCADDR,NODETYP,STATETXT(0),STATETXT(1),STATETXT(2),NTWKNUM,MODNUM,PNTMODTY,PTEXECST,PVRAW,INPTDIR,DITYPE,EVTOPT,ALMOPT,DLYTIME,PVSRCOPT,UBOXCLR,LBOXCLR,OFFNRMAL,$MPROD1,$MPROD2,$MPROD3,$MPROD4,INPTSSLT,BOXNUM,NMBRINPT,EIPSTATE,S1S2S3S4,OVERVAL,EMS,PNTBOXTY,HWYNUM,IPCRDOP,IPCRDTY,DIGALARM,ALGIDDAC,INTVARNM,PVCHGDLY,DEBOUNCE,CCSRC,