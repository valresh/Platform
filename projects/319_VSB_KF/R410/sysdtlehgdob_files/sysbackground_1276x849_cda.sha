<?xml version="1.0"?><shapefile version="1" type="dynamic" title="sysBackground" description="Background layout for new standard detail display" useFirstShapeForBadValue="0" width="1276px" height="849px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="JavaScript" id="CFD45B49-72AB-4fb7-9CC8-A7D18331606B"><![CDATA[

        //------------------------------------------------------------------------

        // CreateExtensionDiv

        //------------------------------------------------------------------------

        // <summary>

        // Creates a single div in the specified parent element with the specified

        // styles and attributes.

        // </summary>

        // <param name="extId">The ID for the new div.</param>

        // <param name="extClass">The class(es) for the new div.</param>

        // <param name="extXStyle">The style used to give the div its horizontal position ('left' or 'right')</param>

        // <param name="extXPos">The expression for the div's horizontal position.</param>

        // <param name="extYStyle">The style used to give the div its vertical position ('top or 'bottom')</param>

        // <param name="extYPos">The expression for the div's vertical position.</param>

        // <param name="extWidth">The expression for the div's width.</param>

        // <param name="extHeight">The expression for the div's height.</param>

        // <param name="extDisplay">The expression for the div's display style - null or '' if this is not needed.</param>

        // <param name="objExtParent">The element to insert the new div as a child of.</param>

        // <returns>

        // true if the div was created with no problems, false otherwise.

        // </returns>

        //------------------------------------------------------------------------

        function CreateExtensionDiv(extId, extClass, extXStyle, extXPos, extYStyle, extYPos, extWidth, extHeight, extDisplay, objExtParent)

        {

          try

          {

            var objExt = window.document.getElementById(extId);

            if (objExt == null)

            {

              objExt = window.document.createElement("div");

              objExt.id = extId;

              objExt.className = extClass;

              objExt.style.position = "absolute";

              objExt.style.overflow = "hidden";

              objExt.style.setExpression(extXStyle, extXPos, "JavaScript");

              objExt.style.setExpression(extYStyle, extYPos, "JavaScript");

              objExt.style.setExpression("width", extWidth, "JavaScript");

              objExt.style.setExpression("height", extHeight, "JavaScript");

              if (typeof(extDisplay) == "string" && extDisplay.length > 0)

              {

                objExt.style.setExpression("display", extDisplay, "JavaScript");

              }

              

              // Insert the new extension div into the proper location in a seperate thread, so that

              // the time it takes doesn't delay the calculation of the size and location of the

              // other extensions. This also breaks out of the onreadystatechange handler thread before

              // mucking around with the DOM, which could potentially change the readyState again.

              window.setTimeout(function(){ objExtParent.appendChild(objExt); }, 5);

            }

            return true;

          }

          catch(e)

          {

            alert("Exception creating background extension '" + extId + "': " + (typeof(e) == "string" ? e : e.description));

          }

          return false;

        }

        

        //------------------------------------------------------------------------

        // CreateBackgroundExtensions

        //------------------------------------------------------------------------

        // <summary>

        // Create empty elements inside the background that match the colored

        // parts of the shape to give the impression that the Page stretches

        // all the way to the edges of the Background.

        // </summary>

        // <returns>

        // true if the extensions were created with no problems, false otherwise.

        // </returns>

        //------------------------------------------------------------------------

        function CreateBackgroundExtensions()

        {

          try

          {

              var objPage = window.document.getElementById("Page");

              var objBackground = window.document.getElementById("Background");      

              if (objPage == null || objBackground == null)

              {

                return false;

              }

                                          

              // Extend the TitleBar on the right-hand edge

              CreateExtensionDiv("bgTitleBar", "TitleBar", 

                                  "right", "'0px'", "top", "'0px'", 

                                  "Background.clientWidth - Page.offsetWidth", 

                                  "TitleBarBackground.offsetHeight", 

                                  null, objBackground);

              

              // Extend the TabSet on the right-hand edge.

              CreateExtensionDiv("bgTabSet", "TabSet", 

                                  "right", "'0px'", "top", "TitleBarBackground.offsetHeight", 

                                  "Background.clientWidth - Page.offsetWidth", "TabSetBackground.offsetHeight", 

                                  "TabSetBackground.currentStyle.display", objBackground);

              

              // Extend the NavPane on the bottom edge.



              CreateExtensionDiv("bgNavPane", "NavPane",

                                   "left", "'0px'", "bottom", "'0px'", 

                                   "NavPane.offsetWidth", "Background.clientHeight - Page.offsetHeight", 

                                   null, objBackground);



              return true;

          }

          catch(e)

          {

             alert("Exception creating background extensions: " + (typeof(e) == "string" ? e : e.description));

          }  

          return false;

        }

        



      ]]></script><script event="onshapeload" language="JavaScript" id=""><![CDATA[

        // Move the shape to take up the whole page.

        this.style.left = "0px";

        this.style.top = "0px";

        this.style.setExpression("width", "Page.clientWidth", "JavaScript");

        this.style.setExpression("height", "Page.clientHeight", "JavaScript");

        

        // Adjust the sizes of page elements that depend on whether the tabs and action bar are shown.

        var showTabs = "{%Value::ShowTabs%}" == "true";

        

        TabSetBackground.style.display = (showTabs ? "block" : "none");

        PageEdge.style.display = "none";

        DisplayAreaBackground.className = (showTabs ? "" : "NoTabs");

        DetailsAreaBackground.className = "NoActionBar DetailsArea";

        LeftBar.className = "";

       

                   

        // Ensure that the background-extensions get added to the DOM.

        // Make sure the object that extends the NavPane to the edge of the display will be created,

        // and that the menu-elements generated only after the window has finished loading. This is

        // because Bad Things happen if you muck with the DOM before it's fully parsed.

        if (!CreateBackgroundExtensions())

        {

          document.attachEvent("onreadystatechange", CreateBackgroundExtensions);

        }

        

        

      ]]></script></scripts><parameters><parameter name="ShowTabs" type="Value" description="Whether tabs should be shown: 'true', 'false' or 'auto'." defaultvalue="true"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV class=NoExpressions id=LeftBar style="PADDING-RIGHT: 0px; PADDING-LEFT: 0px; PADDING-BOTTOM: 0px; PADDING-TOP: 0px"><DIV class=TopLeft id=TopLeft></DIV>
<DIV class=NavPane id=NavPane>
<DIV class=hsc.image.1 id=picture001 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0px; BEHAVIOR: url(#HDXVectorFactory#image); OVERFLOW: hidden; WIDTH: 279px; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0px; HEIGHT: 748px; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:748;lineColorBlink:False;Src:.\sysBackground_1276X849_CDA_files\FP_BKG_CDA.png;Width:279;" shapesrc=".\sysBackground_1276X849_CDA_files\FP_BKG_CDA.png"></DIV></DIV></DIV>]]></content></html></element><element><html><content><![CDATA[
