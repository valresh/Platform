	<menuitem id="mnu_alarm" acceleratorKey="">
		<script type="onclick">
			window.external.application.InvokeCommand('Acknowledge Alarm');
			window.external.CloseShortcutMenu();
		</script>
		<script type="onpage">
			if( !window.external.IsInAlarm( window.external.parentWindow.document.activeElement )) 
				this.disabled=true; 
			if( !window.external.IsAccessPermitted( window.external.parentWindow.document.activeElement ))
				this.disabled=true;
			return true;
		</script>
		<text>Acknowledge Alarm</text>
		<image>.\Toolbar\tb002.png</image>
	</menuitem>
