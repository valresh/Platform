<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="802px" height="432px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><scripts><script event="" language="VBScript" id="66D0FD05-731E-4364-876D-93F1BE273BAE"><![CDATA[Dim intERDBStatus

Dim blnCtrlConfirmProp
Dim blnESig
Dim blnPrimSig
Dim blnSecSig
Dim blnChartInitialized

blnCtrlConfirmProp = False
blnESig = False
blnPrimSig = False
blnSecSig = False
blnChartInitialized = False]]></script><script event="onshapeload" language="VBScript" id=""><![CDATA[	On Error resume Next
	intERDBStatus = -1

	CmActiveX1.height = me.style.height
	CmActiveX1.width = me.style.width]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=LimitMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0.87%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 50.37%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 85.18%; HEIGHT: 3.93%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:404;">Unable to open Display. Maximum limit reached. Try again Later.</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=FailMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 1.12%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 22.44%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 89.58%; HEIGHT: 5.32%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:23;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:180;">Cannot Connect to ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=CtrlConfirmProp style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 8.97%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 3.49%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 94.21%; HEIGHT: 4.86%; BACKGROUND-COLOR: white; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=-1 hdxproperties="fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:2;numericDisplayFormat:%.0f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error resume Next
	blnCtrlConfirmProp = True

	If NOT(blnChartInitialized) Then
		If(blnCtrlConfirmProp AND blnESig AND blnPrimSig AND blnSecSig ) Then
			Dim NumSig
			NumSig=0
			If (len(PrimSig.Value)) <> 255  Then
				NumSig=1
			End If
			If NumSig=1 And len(SecSig.Value) <> 255  Then
				NumSig=2
			End If


			CmActiveX1.PointName = window.external.DetailPointID 
			CmActiveX1.ServerName = window.external.DetailPointServerNetworkName 
			CmActiveX1.SecurityLevel = window.external.SecurityLevel 

			CmActiveX1.OperatorName = window.external.OperatorID 
			CmActiveX1.StationServerName = window.external.ServerName 
			CmActiveX1.StationNumber = window.external.StationNumber	
			CmActiveX1.ElectronicSignature = ESig.value
			CmActiveX1.ControlConfirm = me.value
			CmActiveX1.NumberSignatures = NumSig
			CmActiveX1.StationAcronym = window.external.Parent.RuntimeStatus.StationAcronym

			blnChartInitialized = True
		End If
	End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="ControlConfirmRequired"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ESig style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: transparent; LEFT: 0.99%; VISIBILITY: hidden; BORDER-BOTTOM-COLOR: transparent; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 7.48%; COLOR: #000000; BORDER-TOP-STYLE: none; BORDER-TOP-COLOR: transparent; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 94.44%; HEIGHT: 4.62%; BACKGROUND-COLOR: white; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-RIGHT-COLOR: transparent; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="borderStyle:none;borderWidth:;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:1;numericDisplayFormat:%.0f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error resume Next
	blnESig = True

	If  NOT(blnChartInitialized) Then
		If(blnCtrlConfirmProp AND blnESig AND blnPrimSig AND blnSecSig) Then

			Dim NumSig
			NumSig=0
			If (len(PrimSig.Value)) <> 255  Then
				NumSig=1
			End If
			If NumSig=1 And len(SecSig.Value) <> 255  Then
				NumSig=2
			End If

			CmActiveX1.PointName = window.external.DetailPointID 
			CmActiveX1.ServerName = window.external.DetailPointServerNetworkName 
			CmActiveX1.SecurityLevel = window.external.SecurityLevel 

			CmActiveX1.OperatorName = window.external.OperatorID 
			CmActiveX1.StationServerName = window.external.ServerName 
			CmActiveX1.StationNumber = window.external.StationNumber	
			CmActiveX1.ElectronicSignature = me.value
			CmActiveX1.ControlConfirm = CtrlConfirmProp.value
			CmActiveX1.NumberSignatures = NumSig
			CmActiveX1.StationAcronym = window.external.Parent.RuntimeStatus.StationAcronym

			blnChartInitialized = True
		End If
	End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="FileRefFile" varianttype="VT_UI4" value="121"/><property name="FileRefRecord" varianttype="VT_UI4" value="1"/><property name="FileRefWord" varianttype="VT_UI4" value="1733"/><property name="FileRefFlags" varianttype="VT_UI4" value="0"/><property name="FileRefFormat" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldStart" varianttype="VT_UI1" value="10"/><property name="FileRefBitFieldWidth" varianttype="VT_UI1" value="1"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=PrimSig style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: transparent; LEFT: 13.21%; VISIBILITY: hidden; BORDER-BOTTOM-COLOR: transparent; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 12.46%; COLOR: #000000; BORDER-TOP-STYLE: none; BORDER-TOP-COLOR: transparent; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 94.44%; HEIGHT: 5.09%; BACKGROUND-COLOR: white; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: break-word; BORDER-RIGHT-COLOR: transparent; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="borderStyle:none;borderWidth:;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:-1;lineColor:black;lineColorBlink:False;numberOfChars:24;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error resume Next
	blnPrimSig = True

	If  NOT(blnChartInitialized) Then
		If(blnCtrlConfirmProp AND blnESig AND blnPrimSig AND blnSecSig) Then

			Dim NumSig
			NumSig=0
			If (len(PrimSig.Value)) <> 255  Then
				NumSig=1
			End If
			If NumSig=1 And len(SecSig.Value) <> 255  Then
				NumSig=2
			End If

			CmActiveX1.PointName = window.external.DetailPointID 
			CmActiveX1.ServerName = window.external.DetailPointServerNetworkName 
			CmActiveX1.SecurityLevel = window.external.SecurityLevel 

			CmActiveX1.OperatorName = window.external.OperatorID 
			CmActiveX1.StationServerName = window.external.ServerName 
			CmActiveX1.StationNumber = window.external.StationNumber	
			CmActiveX1.ElectronicSignature = ESig.value
			CmActiveX1.ControlConfirm = CtrlConfirmProp.value
			CmActiveX1.NumberSignatures = NumSig
			CmActiveX1.StationAcronym = window.external.Parent.RuntimeStatus.StationAcronym

			blnChartInitialized = True
		End If
	End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PrimarySignatureMeaning"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.Alarm" refcount="1"/><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=SecSig title="" style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: transparent; LEFT: 27.05%; VISIBILITY: hidden; BORDER-BOTTOM-COLOR: transparent; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 11.34%; COLOR: #000000; BORDER-TOP-STYLE: none; BORDER-TOP-COLOR: transparent; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 93.98%; HEIGHT: 6.01%; BACKGROUND-COLOR: white; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: break-word; BORDER-RIGHT-COLOR: transparent; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="borderStyle:none;borderWidth:;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:-1;lineColor:black;lineColorBlink:False;numberOfChars:24;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error resume Next
	blnSecSig = True

	If  NOT(blnChartInitialized) Then
		If(blnCtrlConfirmProp AND blnESig AND blnPrimSig AND blnSecSig) Then

			Dim NumSig
			NumSig=0
			If (len(PrimSig.Value)) <> 255  Then
				NumSig=1
			End If
			If NumSig=1 And len(SecSig.Value) <> 255  Then
				NumSig=2
			End If

			CmActiveX1.PointName = window.external.DetailPointID 
			CmActiveX1.ServerName = window.external.DetailPointServerNetworkName 
			CmActiveX1.SecurityLevel = window.external.SecurityLevel 

			CmActiveX1.OperatorName = window.external.OperatorID 
			CmActiveX1.StationServerName = window.external.ServerName 
			CmActiveX1.StationNumber = window.external.StationNumber	
			CmActiveX1.ElectronicSignature = ESig.value
			CmActiveX1.ControlConfirm = CtrlConfirmProp.value
			CmActiveX1.NumberSignatures = NumSig
			CmActiveX1.StationAcronym = window.external.Parent.RuntimeStatus.StationAcronym

			blnChartInitialized = True
		End If
	End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="SecondarySignatureMeaning"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.Alarm" refcount="1"/><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=LostMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 38.77%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 25.43%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 89.35%; HEIGHT: 5.09%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:22;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:204;">Lost Connection with ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=SuccMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 65.08%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 34.78%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 89.58%; HEIGHT: 4.39%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:19;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:279;">Re-established Connection with ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[
<OBJECT class=hsc.activexcontrol.1 id=CmActiveX1 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; WIDTH: 99.62%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 98.61%; TEXT-DECORATION: none" tabIndex=-1 classid=clsid:B094BC79-20ED-11D4-A744-0000F87B069E><PARAM NAME="_Version" VALUE="65536"><PARAM NAME="_ExtentX" VALUE="21140"><PARAM NAME="_ExtentY" VALUE="11271"><PARAM NAME="_StockProps" VALUE="32"><PARAM NAME="BorderStyle" VALUE="0">]]></content><scripts><script event="InvokeChart(lpszPointName)" language="VBScript"><![CDATA[on error resume next
window.external.RequestTask 21, 73, 0, 0, 0, lpszPointName]]></script><script event="InvokeERDBStatus(nERDBStatus)" language="VBScript"><![CDATA[On Error Resume Next
	
	'Update the ERDB Status in the Display
    

If ((nERDBStatus = ErdbDiscFromA Or nERDBStatus = ErdbDiscFromB) And intERDBStatus <> -1) Then
	    'objEStat.Value = "LOST"
		window.external.MessageZoneText = Me.parentElement.children.namedItem("LostMessage").Value
    ElseIf ((nERDBStatus = ErdbDiscFromA Or nERDBStatus = ErdbDiscFromB) And intERDBStatus = -1) Then
	'objEStat.Value = "FAIL"
		window.external.MessageZoneText = Me.parentElement.children.namedItem("FailMessage").Value
    ElseIf (intERDBStatus = -1) Then
        

	'objEStat.Value = "INIT"
		window.external.MessageZoneText = ""
    Else
        'objEStat.Value = "SUCCESS"
		window.external.MessageZoneText = Me.parentElement.children.namedItem("SuccMessage").Value

    End If
    
    intERDBStatus = nERDBStatus]]></script></scripts></html></element><html><content><![CDATA[
<DIV class=hvg.group.1 id=group001 style="FONT-SIZE: 0pt; LEFT: 0px; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 802px; POSITION: absolute; TOP: 0px; HEIGHT: 432px" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:432;lineColorBlink:False;Width:802;"></DIV>]]></content></html></group></shape></shapes></shapefile>
