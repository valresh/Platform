	</FieldXML>
	<XFormXML>
		<xforms>
			<script id="xfLocationFormat" language="JScript">
				var rootLocation = "/Assets";
				if (Value)
				{
					var posn = Value.indexOf( rootLocation );
					if ( posn == 0 )
						return Value.substr( rootLocation.length );
					else
						return Value;
				}
				return "";
			</script>
			<script id="xfDTCellFormat" language="jscript">
				try {
					return DTFormat.Localize(Value, g_dateTimeFormat);
				} catch(e) {
					return "";
				}
			</script>
			<script id="xfDTTooltipFormat" language="jscript">
				try {
					return DTFormat.Localize(Value, g_dateTimeFormatTip);
				} catch(e) {
					return "";
				}
			</script>
			<script id="xfNumCellFormat" language="jscript">
				try {
					return DTFormat.Localize(Value, g_dateTimeFormat);
				} catch(e) {
					return "";
				}
			</script>
			<script id="xfSelection" language="VBScript">
				Dim s
				s = "Unselected_Cells"
				If Value Then
					If g_bTableIsActive Then 
						s = "Selected_Active_Cells"
					Else
						s = "Selected_Inactive_Cells"
					End If
				End If
				Return = s
			</script>
			<script id="xfCentreAlarmIcon" language="jscript">
				return window.external.IsOnTouchPanel;
			</script>
			<script id="xfVisibility" language="VBScript">
				Dim s
				s = ""
				If Value Then
					s = "visible"
				Else
					s = "hidden"
				End If
				Return = s
			</script>
			<enum id="xfDeleted">
				<entry value="0" text=""/>
				<entry value="-1" text="line-through"/>
			</enum>
			<defaultValue id="EmptyVariantToString" value="" type="string"/>
		</xforms>
	</XFormXML>
