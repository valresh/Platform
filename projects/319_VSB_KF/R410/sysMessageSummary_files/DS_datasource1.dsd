			<CommandGroup id="ContextMenuGroup">
				<StandardCommand id="Command_Acknowledge" Command="Acknowledge">
					&lt;div title="Acknowledge the selected message" style="width: 100%;" class="contextMenu_Ack"&gt;
					&amp;nbsp;Acknowledge Message
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_Confirm" Command="Confirm">
					&lt;div title="Confirm the selected message" style="width: 100%;" class="contextMenu_Confirm"&gt;
					&amp;nbsp;Confirm Message
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_Clear" Command="ClearMessage">
					&lt;div title="Clear the selected message" style="width: 100%;" class="contextMenu_Clear"&gt;
					&amp;nbsp;Clear Message
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_PointDetail" Command="PointDetail">
					&lt;div title="Navigate to the detail page of the selected message" style="padding: 1px; width: 100%;" class="contextMenu_PointDetail"&gt;
					&amp;nbsp;Detail Display
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_AssociatedDisplay" Command="AssociatedDisplay">
					&lt;div title="Navigate to the associated display of the selected message" style="padding: 1px; width: 100%;" class="contextMenu_AssDisplay"&gt;
					&amp;nbsp;Associated Display
					&lt;/div&gt;
				</StandardCommand>
				<ScriptCommand 
					id="ContextMenu_ProcedureExplorer"
					script="if (InvokeProcedureExplorer){InvokeProcedureExplorer(getActivityPointFromNotificationSummary());}"
					language="jscript">
					&lt;div title="Open the Procedure Explorer" style="padding: 1px; width: 100%;" class="contextMenu_PE"&gt;
					&amp;nbsp;Procedure Explorer
					&lt;/div&gt;
				</ScriptCommand>
			</CommandGroup>
			<CommandGroup id="TableMenuGroup">
				<ScriptCommand 
					id="Command_ShowColumnOrganizer"
					script="ShowColumnOrganizer(this.menu.site.container); return true;"
					language="jscript">
					&lt;div title="The column organizer allows you to add and remove columns from view" style="padding: 1px; width: 100%;" class="contextMenu_ColOrganiser"&gt;
					&amp;nbsp;Show Column Organizer
					&lt;/div&gt;
				</ScriptCommand>
				<StandardCommand id="Command_ClearFilters" Command="ClearFilters">
					&lt;div title="Clear all filters that are currently applied" style="padding: 1px; width: 100%;" class="contextMenu_ClearFilters"&gt;				
					&amp;nbsp;Clear All Filters
					&lt;/div&gt;
				</StandardCommand>
			</CommandGroup>
