	<TableDefinitionXML>
		<table>
			<tableMenu>
				<GroupRef GroupId="TableMenuGroup"/>
			</tableMenu>
			<contextMenu>
				<GroupRef GroupId="ContextMenuGroup"/>
			</contextMenu>
			<columns>
				<column id="Message State Indication" name="Message State" fixed="true">
					<title tooltip="Click to filter or sort by message state">&lt;span class="blankHeader"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="IconColumnFilterMainGroup"/>
						<GroupRef GroupId="MessageTypeFilterGroup"/>
						<GroupRef GroupId="AckStateFilterGroup"/>
						<GroupRef GroupId="IconSortGroup"/>
					</menu>
					<content>
						&lt;div _opacityACKED="60"
							_opacityON="100"
							_opacityOFF="30"
							class="messageIcon"
							style="behavior: url(#AlarmStateIconFactory#MessageIcon); 
							       width: 100%; 
							       height: 100%;
							       position: relative;
							       z-index: 10;
							       white-space: nowrap;
 							       text-align: center;"&gt;&lt;/div&gt;
					</content>
					<bindings>
						<in fields="Confirmable" properties="Confirmable"/>
						<in fields="Confirmed" properties="Confirmed"/>
						<in fields="Acknowledged" properties="Acknowledged"/>
						<in fields="NumSignaturesReqd" properties="SignatureMode"/>
						<in fields="Deleted" properties="Deleted"/>
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
						<in fields="Selected" properties="centre" xforms="xfCentreAlarmIcon"/>
					</bindings>
				</column>
				<column id="Message Time" name="Message Time">
					<title tooltip="Click to filter or sort by message time">&lt;span class="textHeader"&gt;Date &amp; Time&lt;/span&gt;</title>
