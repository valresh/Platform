					<bindings>
						<in fields="Time;TimeMicroSeconds" xforms="xfDTCellFormat" properties="innerText" />
						<in fields="Time;TimeMicroSeconds" xforms="xfDTTooltipFormat" properties="title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
