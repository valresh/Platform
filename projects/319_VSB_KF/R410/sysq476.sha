<?xml version="1.0"?><shapefile version="1" type="sequence" title="" description="" useFirstShapeForBadValue="0" width="16px" height="16px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="vbscript" id="0D03BDD1-EAF6-4D7D-9870-2976FE87250F"><![CDATA[Sub InstallCodebase()
	urlbase	 = location.protocol & "//" & location.host
	instpage = urlbase & WebDisplayLocation.content & "/" & WebInstallPageName.content
	install  = Escape(urlbase & WebPackageLocation.content & "/" & WebPackageName.content)
	redirect = Escape(location.href)
	window.location = instpage & "?install=" & install & "&redirect=" & redirect
End Sub
]]></script></scripts><shapes><shape><group><element><html><content><![CDATA[
