<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="474px" height="232px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><parameters><parameter name="Mypoint" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; WIDTH: 11.18%; FONT-FAMILY: Small Fonts; HEIGHT: 4.74%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 7pt; OVERFLOW: hidden; TOP: 4.31%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); LEFT: 16.66%" id=sdx class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:11;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:53;" HDX_LOCK="-1">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim nPkgs

	nPkgs = sdx.DataValue("Mypoint.NOPKG") 
	if nPkgs = 0 then
		grpPackages.style.visibility = "Hidden"
	else
		grpPackages.style.visibility = "Inherit"
		grpPkg1.style.visibility = "Inherit"
		grpPkg2.style.visibility = "Hidden"
		grpPkg3.style.visibility = "Hidden"
		grpPkg4.style.visibility = "Hidden"
		grpPkg5.style.visibility = "Hidden"
		grpPkg6.style.visibility = "Hidden"
		grpPkg7.style.visibility = "Hidden"
		grpPkg8.style.visibility = "Hidden"
		grpPkg9.style.visibility = "Hidden"
		grpPkg10.style.visibility = "Hidden"

		if nPkgs > 1 then
			grpPkg2.style.visibility = "Inherit"
		end if
		if nPkgs > 2 then
			grpPkg3.style.visibility = "Inherit"
		end if
		if nPkgs > 3 then
			grpPkg4.style.visibility = "Inherit"
		end if
		if nPkgs > 4 then
			grpPkg5.style.visibility = "Inherit"
		end if
		if nPkgs > 5 then
			grpPkg6.style.visibility = "Inherit"
		end if
		if nPkgs > 6 then
			grpPkg7.style.visibility = "Inherit"
		end if
		if nPkgs > 7 then
			grpPkg8.style.visibility = "Inherit"
		end if
		if nPkgs > 8 then
			grpPkg9.style.visibility = "Inherit"
		end if
		if nPkgs > 9 then
			grpPkg10.style.visibility = "Inherit"
		end if
	end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Mypoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="NOPKG,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="32767,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><group><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 45.15%; FONT-FAMILY: Arial; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 100%; COLOR: #000000; FONT-SIZE: 12pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 54.85%; ROWS: 1" id=alpha001 class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:16;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" val