<DIV style="POSITION: absolute; TEXT-ALIGN: right; FONT-STYLE: normal; WIDTH: 33.33%; FONT-FAMILY: Verdana; HEIGHT: 36.36%; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 6.81%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 0%" id=txtItemLabel class=hvg.textbox.1 tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:154;"></DIV>]]></content></html></element><element><html><content><![CDATA[<SPAN style="POSITION: absolute; TEXT-ALIGN: left; BACKGROUND-COLOR: white; WIDTH: 24.24%; FONT: 12pt Verdana; HEIGHT: 43.18%; OVERFLOW: hidden; TOP: 0%; CURSOR: default; TEXT-DECORATION: none; BEHAVIOR: url(#HSCCheckBoxBehavior) url(#BindingBehavior); LEFT: 34.41%" id=chkDuration class=hsc.checkbox.1 tabIndex=0 hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;inverseLogic:0;textColorBlink:False;"><INPUT style="BACKGROUND-COLOR: white; MARGIN: 1px" tabIndex=0 type=checkbox></INPUT><SPAN style="COLOR: #000000">Duration</SPAN></SPAN>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[	dim sTimeObject
	dim sTimeDurObject

	if g_nSelectedItem = 0 then exit sub

	if g_nSelectedItem < 10 then
		sTimeObject = "param_tim0" & g_nSelectedItem
		sTimeDurObject = "param_timDur0" & g_nSelectedItem
	else
		sTimeObject = "param_tim" & g_nSelectedItem
		sTimeDurObject = "param_timDur" & g_nSelectedItem
	end if

	if me.value = 0 then
		chkTime.value = 0
		call ShowThisObject(sTimeDurObject)
		call HideThisObject(sTimeObject)
	else
		chkTime.value = 1
		call HideThisObject(sTimeDurObject)
		call ShowThisObject(sTimeObject)
	end if]]></script></scripts></html><binding/></element><element><html><content><![CDATA[<SPAN style="POSITION: absolute; TEXT-ALIGN: left; BACKGROUND-COLOR: white; WIDTH: 20.12%; FONT: 12pt Verdana; HEIGHT: 47.72%; OVERFLOW: hidden; TOP: 2.27%; CURSOR: default; TEXT-DECORATION: none; BEHAVIOR: url(#HSCCheckBoxBehavior) url(#BindingBehavior); LEFT: 59.52%" id=chkTime class=hsc.checkbox.1 tabIndex=0 hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;inverseLogic:0;textColorBlink:False;"><INPUT style="BACKGROUND-COLOR: white; MARGIN: 1px" tabIndex=0 type=checkbox></INPUT><SPAN style="COLOR: #000000">Time</SPAN></SPAN>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[	dim sTimeObject
	dim sTimeDurObject

	if g_nSelectedItem = 0 then exit sub

	if g_nSelectedItem < 10 then
		sTimeObject = "param_tim0" & g_nSelectedItem
		sTimeDurObject = "param_timDur0" & g_nSelectedItem
	else
		sTimeObject = "param_tim" & g_nSelectedItem
		sTimeDurObject = "param_timDur" & g_nSelectedItem
	end if

	if me.value = 0 then
		chkDuration.value = 0
		call HideThisObject(sTimeDurObject)
		call ShowThisObject(sTimeObject)
	else
		chkDuration.value = 1
		call ShowThisObject(sTimeDurObject)
		call HideThisObject(sTimeObject)
	end if]]></script></scripts></html><binding/></element><element><html><content><![CDATA[<INPUT style="POSITION: absolute; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; BACKGROUND-COLOR: #d4d0c8; FONT-STYLE: normal; BORDER-TOP-COLOR: #ffffff; WIDTH: 18.61%; BACKGROUND-REPEAT: no-repeat; FONT-FAMILY: Verdana; HEIGHT: 47.72%; COLOR: #000000; BORDER-RIGHT-COLOR: #ffffff; FONT-SIZE: 10pt; BORDER-LEFT-COLOR: #ffffff; TOP: 2.27%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); LEFT: 81.38%" id=pbCancel class=hsc.button.1 tabIndex=0 value="Cancel " type=button hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" BaseFilterTranslateSQLchars="" BaseFilterXML="" BaseFilter="">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[	grpTimeType.style.visibility = "Hidden"]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[
