><parameter name="enum_13" type="Parameter" description="" defaultvalue=""/><parameter name="enum_14" type="Parameter" description="" defaultvalue=""/><parameter name="enum_15" type="Parameter" description="" defaultvalue=""/><parameter name="enum_16" type="Parameter" description="" defaultvalue=""/><parameter name="enum_17" type="Parameter" description="" defaultvalue=""/><parameter name="enum_18" type="Parameter" description="" defaultvalue=""/><parameter name="enum_19" type="Parameter" description="" defaultvalue=""/><parameter name="enum_20" type="Parameter" description="" defaultvalue=""/><parameter name="days_01" type="Parameter" description="" defaultvalue=""/><parameter name="days_02" type="Parameter" description="" defaultvalue=""/><parameter name="days_03" type="Parameter" description="" defaultvalue=""/><parameter name="days_04" type="Parameter" description="" defaultvalue=""/><parameter name="days_05" type="Parameter" description="" defaultvalue=""/><parameter name="days_06" type="Parameter" description="" defaultvalue=""/><parameter name="days_07" type="Parameter" description="" defaultvalue=""/><parameter name="days_08" type="Parameter" description="" defaultvalue=""/><parameter name="days_09" type="Parameter" description="" defaultvalue=""/><parameter name="days_10" type="Parameter" description="" defaultvalue=""/><parameter name="days_11" type="Parameter" description="" defaultvalue=""/><parameter name="days_12" type="Parameter" description="" defaultvalue=""/><parameter name="days_13" type="Parameter" description="" defaultvalue=""/><parameter name="days_14" type="Parameter" description="" defaultvalue=""/><parameter name="days_15" type="Parameter" description="" defaultvalue=""/><parameter name="days_16" type="Parameter" description="" defaultvalue=""/><parameter name="days_17" type="Parameter" description="" defaultvalue=""/><parameter name="days_18" type="Parameter" description="" defaultvalue=""/><parameter name="days_19" type="Parameter" description="" defaultvalue=""/><parameter name="days_20" type="Parameter" description="" defaultvalue=""/><parameter name="dur_01" type="Parameter" description="" defaultvalue=""/><parameter name="dur_02" type="Parameter" description="" defaultvalue=""/><parameter name="dur_03" type="Parameter" description="" defaultvalue=""/><parameter name="dur_04" type="Parameter" description="" defaultvalue=""/><parameter name="dur_05" type="Parameter" description="" defaultvalue=""/><parameter name="dur_06" type="Parameter" description="" defaultvalue=""/><parameter name="dur_07" type="Parameter" description="" defaultvalue=""/><parameter name="dur_08" type="Parameter" description="" defaultvalue=""/><parameter name="dur_09" type="Parameter" description="" defaultvalue=""/><parameter name="dur_10" type="Parameter" description="" defaultvalue=""/><parameter name="dur_11" type="Parameter" description="" defaultvalue=""/><parameter name="dur_12" type="Parameter" description="" defaultvalue=""/><parameter name="dur_13" type="Parameter" description="" defaultvalue=""/><parameter name="dur_14" type="Parameter" description="" defaultvalue=""/><parameter name="dur_15" type="Parameter" description="" defaultvalue=""/><parameter name="dur_16" type="Parameter" description="" defaultvalue=""/><parameter name="dur_17" type="Parameter" description="" defaultvalue=""/><parameter name="dur_18" type="Parameter" description="" defaultvalue=""/><parameter name="dur_19" type="Parameter" description="" defaultvalue=""/><parameter name="dur_20" type="Parameter" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; WIDTH: 7.1%; FONT-FAMILY: Small Fonts; HEIGHT: 1.99%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 7pt; OVERFLOW: hidden; TOP: 1.99%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); LEFT: 0%" id=sdx class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:11;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:53;" HDX_LOCK="-1">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim pType(20)
	dim sTempStr
	dim sTempStr2
	dim sLocIdx

	if nUpdateCount > 5 then
'			window.external.Parent.LogMessage "nUpdateCount > 5, don't bother processing"
		exit sub
	else
		nUpdateCount = nUpdateCount + 1
	end if
	
on error resume next 'first time through we're not quite ready to read the displaydatarespository

	'assign the actual values of these strings "Parameter name"
	pname1 = DisplayDataRepository.GetValue ("CDSParam1")
	pname2 = DisplayDataRepository.GetValue ("CDSParam2")
	pname3 = DisplayDataRepository.GetValue ("CDSParam3")
	pname4 = DisplayDataRepository.GetValue ("CDSParam4")
	pname5 = DisplayDataRepository.GetValue ("CDSParam5")
	pname6 = DisplayDataRepository.GetValue ("CDSParam6")
	pname7 = DisplayDataRepository.GetValue ("CDSParam7")
	pname8 = DisplayDataRepository.GetValue ("CDSParam8")
	pname9 = DisplayDataRepository.GetValue ("CDSParam9")
	pname10 = DisplayDataRepository.GetValue ("CDSParam10")
	pname11 = DisplayDataRepository.GetValue ("CDSParam11")
	pname12 = DisplayDataRepository.GetValue ("CDSParam12")
	pname13 = DisplayDataRepository.GetValue ("CDSParam13")
	pname14 = DisplayDataRepository.GetValue ("CDSParam14")
	pname15 = DisplayDataRepository.GetValue ("CDSParam15")
	pname16 = DisplayDataRepository.GetValue ("CDSParam16")
	pname17 = DisplayDataRepository.GetValue ("CDSParam17")
	pname18 = DisplayDataRepository.GetValue ("CDSParam18")
	pname19 = DisplayDataRepository.GetValue ("CDSParam19")
	pname20 = DisplayDataRepository.GetValue ("CDSParam20")

	idx1 = DisplayDataRepository.GetValue("CDSIdx1")
	idx2 = DisplayDataRepository.GetValue("CDSIdx2")
	idx3 = DisplayDataRepository.GetValue("CDSIdx3")
	idx4 = DisplayDataRepository.GetValue("CDSIdx4")
	idx5 = DisplayDataRepository.GetValue("CDSIdx5")
	idx6 = DisplayDataRepository.GetValue("CDSIdx6")
	idx7 = DisplayDataRepository.GetValue("CDSIdx7")
	idx8 = DisplayDataRepository.GetValue("CDSIdx8")
	idx9 = DisplayDataRepository.GetValue("CDSIdx9")
	idx10 = DisplayDataRepository.GetValue("CDSIdx10")
	idx11 = DisplayDataRepository.GetValue("CDSIdx11")
	idx12 = DisplayDataRepository.GetValue("CDSIdx12")
	idx13 = DisplayDataRepository.GetValue("CDSIdx13")
	idx14 = DisplayDataRepository.GetValue("CDSIdx14")
	idx15 = DisplayDataRepository.GetValue("CDSIdx15")
	idx16 = DisplayDataRepository.GetValue("CDSIdx16")
	idx17 = DisplayDataRepository.GetValue("CDSIdx17")
	idx18 = DisplayDataRepository.GetValue("CDSIdx18")
	idx19 = DisplayDataRepository.GetValue("CDSIdx19")
	idx20 = DisplayDataRepository.GetValue("CDSIdx20")

	'for use below, the types, to determine which objects to show, and which to hide
	pType(1) = DisplayDataRepository.GetValue("CDSType1")
	pType(2) = DisplayDataRepository.GetValue("CDSType2")
	pType(3) = DisplayDataRepository.GetValue("CDSType3")
	pType(4) = DisplayDataRepository.GetValue("CDSType4")
	pType(5) = DisplayDataRepository.GetValue("CDSType5")
	pType(6) = DisplayDataRepository.GetValue("CDSType6")
	pType(7) = DisplayDataRepository.GetValue("CDSType7")
	pType(8) = DisplayDataRepository.GetValue("CDSType8")
	pType(9) = DisplayDataRepository.GetValue("CDSType9")
	pType(10) = DisplayDataRepository.GetValue("CDSType10")
	pType(11) = DisplayDataRepository.GetValue("CDSType11")
	pType(12) = DisplayDataRepository.GetValue("CDSType12")
	pType(13) = DisplayDataRepository.GetValue("CDSType13")
	pType(14) = DisplayDataRepository.GetValue("CDSType14")
	pType(15) = DisplayDataRepository.GetValue("CDSType15")
	pType(16) = DisplayDataRepository.GetValue("CDSType16")
	pType(17) = DisplayDataRepository.GetValue("CDSType17")
	pType(18) = DisplayDataRepository.GetValue("CDSType18")
	pType(19) = DisplayDataRepository.GetValue("CDSType19")
	pType(20) = DisplayDataRepository.GetValue("CDSType20")

	for i = 1 to 20
		if i < 10 then 
			sLocIdx = "0" & i
		else
			sLocIdx = i
		end if
	if pType(i) = "2" then 'REAL
		sTempStr = "param_string" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_enum" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_tim" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_timDur" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "shp_ent" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_real" & sLocIdx
		sTempStr2 = "real_" & sLocIdx
			call ShowThisObject(sTempStr)
	elseif pType(i) = "3" or pType(i) = "4" then 'ENUM
		sTempStr = "param_string" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_real" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_tim" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_timDur" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "shp_ent" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_enum" & sLocIdx
		sTempStr2 = "enum_" & sLocIdx
			call ShowThisObject(sTempStr)
	elseif pType(i) = "5" then 'TIME
		sTempStr = "param_string" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_enum" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "shp_ent" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_real" & sLocIdx
		call HideThisObject(sTempStr)
	elseif pType(i) = "6" then 'ENUM
		sTempStr = "param_string" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_real" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_tim" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_timDur" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_enum" & sLocIdx
		call HideThisObject(sTempStr)
'		window.external.Parent.LogMessage "cdsmain shape driving entity1 to subshape: " & param_string01.value 
		sTempStr = "shp_ent" & sLocIdx
		call ShowThisObject(sTempStr)
	elseif pType(i) = "8" then 'STRING
		sTempStr = "param_enum" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_real" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_tim" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_timDur" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "shp_ent" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_string" & sLocIdx
		sTempStr2 = "str_" & sLocIdx
		call ShowThisObject(sTempStr)
	elseif pType(i) = "0" then
		sTempStr = "param_enum" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_real" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_tim" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_timDur" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "shp_ent" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_string" & sLocIdx
		call HideThisObject(sTempStr)
	else										'unknown type, hide all
		sTempStr = "param_enum" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_real" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_tim" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_timDur" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_timDur" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "shp_ent" & sLocIdx
		call HideThisObject(sTempStr)
		sTempStr = "param_string" & sLocIdx
		call HideThisObject(sTempStr)

	end if

 next]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},{%Point::Mypoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::enum_01%},{%Parameter::enum_02%},{%Parameter::enum_03%},{%Parameter::enum_04