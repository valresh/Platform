	window.clearInterval(intTimerID2)
  	intTimerID2 = window.setInterval ("HideSelectedActivity", g_nHideSelectedActivityTimeout)]]></script><script event="onupdate" language="VBScript"><![CDATA[	dim nval
	dim sType
	on error resume next

	sType = DisplayDataRepository.GetValue("CDSType13")
	if sType <> "5" then exit sub

' 	do not update if an operation is pending with time vs. duration anywhere (like here)
	if g_nSelectedItem > 0 then exit sub

	nVal = me.value
	if me.value = "NaN" then 
		me.style.visibility = "Hidden"
		param_timDur13.style.visibility = "Hidden"
		exit sub
	end if	
	if CDbl(nVal) < 29856 then
		me.style.visibility = "Hidden"
		param_timDur13.style.visibility = "Inherit"
	else
		me.style.visibility = "Inherit"
		param_timDur13.style.visibility = "Hidden"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::Mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::str_13%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="10"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 26.8%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 90.9%; VISIBILITY: hidden; COLOR: black; FONT-SIZE: 12pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 32.7%; ROWS: 1" id=param_timDur13 class="hsc.alpha.1 " title="" tabIndex=0 hdxproperties="dateFormat:0;dateTimeFormat:0;fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:42;numericDisplayFormat:%s;styleClass:;textColor:Black;timeFormat:2;timeIncludeMS:0;">5/25/2011 16:56:46</TEXTAREA>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[	g_nSel