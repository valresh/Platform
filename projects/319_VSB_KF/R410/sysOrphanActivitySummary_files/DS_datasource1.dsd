                        &lt;img src="Images/Spacer.gif"&gt;
                        (Custom Filter...)
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterDialog>
            </SQLFilterGroup>
            <SuperGroup id="PublicNameColumnFilterSuperGroup" DefaultItem="Filter_PublicNameColumnAll">
                <GroupRef GroupId="PublicNameColumnFilterMainGroup"/>
            </SuperGroup>
            <SortGroup id="PublicNameSortGroup">
                <SortItem id="Sort_PublicNameAsc" AssociatedColumn="PublicName" SortDir="asc">
                    <Selected>
                        &lt;div title="Sort the activities in ascending order (A-Z) by public name" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        Sort Ascending
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Sort the activities in ascending order (A-Z) by public name" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        Sort Ascending
                        &lt;/div&gt;
