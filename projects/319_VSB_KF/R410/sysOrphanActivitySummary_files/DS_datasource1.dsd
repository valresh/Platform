                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Show activities with any public name" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        (All Public Names)
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterPredefined>
                <SQLFilterLCS id="Filter_PublicNameColumnLCS" FilterString="" FilterDescription="" FilterDescriptionField="PublicName" Selected="false" Template="PublicName = '@@PublicName@@'">
                    <Selected>
                        &lt;div title="Show activities with the same public name as the currently selected activity" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        (Like Currently Selected)
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Show activities with the same public name as the currently selected activity" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
