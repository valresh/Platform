                        Sort Descending
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Sort the activities in descending order (Z-A) by public name" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        Sort Descending
                        &lt;/div&gt;
                    </NotSelected>
                </SortItem>
            </SortGroup>
            <CommandGroup id="ContextMenuGroup">
                <StandardCommand id="Command_PointDetail" Command="PointDetail">
                    &lt;div title="Navigate to the detail page of the selected activity" style="padding: 1px; width: 100%;"&gt;
                    &lt;img style="position: relative; top: 2px; left: 2px; margin-right: 6px;" src="Images/PointDetails.gif"&gt;
                    &amp;nbsp;Detail Display
                    &lt;/div&gt;
                </StandardCommand>
                <StandardCommand id="Command_AssociatedDisplay" Command="AssociatedDisplay">
                    &lt;div title="Navigate to the associated display of the selected activity" style="padding: 1px; width: 100%;"&gt;
                    &lt;img style="position: relative; top: 2px; left: 3px; margin-right: 9px;" src="Images/AssociatedDisplay.gif"&gt;
                    &amp;nbsp;Associated Display
                    &lt;/div&gt;
                </StandardCommand>
            </CommandGroup>
            <CommandGroup id="TableMenuGroup">
                <ScriptCommand 
                    id="Command_ShowColumnOrganizer"
                    script="ShowColumnOrganizer(this.menu.site.container); return true;"
                    language="jscript">
                    &lt;div title="The column organizer allows you to add and remove columns from view" style="padding: 1px; width: 100%;"&gt;
                    &lt;img style="position: relative; top: 2px; left: 2px; margin-right: 3px;" src="Images/ColumnOrganizer.gif"&gt;
                    &amp;nbsp;Show Column Organizer
                    &lt;/div&gt;
                </ScriptCommand>
                <StandardCommand id="Command_ClearFilters" Command="ClearFilters">
                    &lt;div title="Clear all filters that are currently applied" style="padding: 1px; width: 100%;"&gt;				
                    &lt;img style="position: relative; top: 2px; left: 2px; margin-right: 3px;" src="Images/Filter.gif"&gt;
                    &amp;nbsp;Clear All Filters
                    &lt;/div&gt;
                </StandardCommand>
            </CommandGroup>
        </MenuGroups>
    </MenuGroupXML>
    <BaseFilterXML>
        <BaseFilterDef>
        </BaseFilterDef>
    </BaseFilterXML>
    <SortXML>
        <SortDef DefaultSortColumn="ActivityName" DefaultSortDir="desc">
            <colref id="ActivityIcon"
                SortAscString="Quality asc"
                SortDescString="Quality desc"
                SortAscDescription="Bad Quality last"
                SortDescDescription="Bad Quality first"
                SortDir="none"
                SortOrder="0"/>
            <colref id="ActivityType"
                SortAscString="ActivityType asc"
                SortDescString="ActivityType desc"
                SortAscDescription="Type ascending"
                SortDescDescription="Type descending"
                SortDir="none"
                SortOrder="0"/>
            <colref id="ActivityName"
                SortAscString="ActivityName asc"
                SortDescString="ActivityName desc"
                SortAscDescription="Batch ID ascending"
                SortDescDescription="Batch ID descending"
                SortDir="none"
                SortOrder="0"/>
            <colref id="ActivityEntity"
                SortAscString="ActivityEntity asc"
                SortDescString="ActivityEntity desc"
                SortAscDescription="Activity Entity ascending"
                SortDescDescription="Activity Entity descending"
                SortDir="none"
                SortOrder="0"/>
            <colref id="PublicName"
                SortAscString="PublicName asc"
                SortDescString="PublicName desc"
                SortAscDescription="Public Name ascending"
                SortDescDescription="Public Name descending"
                SortDir="none"
                SortOrder="0"/>
            <colref id="Asset"
                SortAscString="Asset asc"
                SortDescString="Asset desc"
                SortAscDescription="Asset ascending"
                SortDescDescription="Asset descending"
                SortDir="none"
                SortOrder="0"/>
            <colref id="Description"
                SortAscString="Description asc"
                SortDescString="Description desc"
                SortAscDescription="Description ascending"
                SortDescDescription="Description descending"
                SortDir="none"
                SortOrder="0"/>
            <colref id="CreateTime"
                SortAscString="CreateTime asc"
                SortDescString="CreateTime desc"
                SortAscDescription="Create Time ascending"
                SortDescDescription="Create Time descending"
                SortDir="desc"
                SortOrder="1"/>
            <colref id="StartTime"
                SortAscString="StartTime asc"
                SortDescString="StartTime desc"
                SortAscDescription="Start Time ascending"
                SortDescDescription="Start Time descending"
                SortDir="none"
                SortOrder="0"/>
            <colref id="EndTime"
                SortAscString="EndTime asc"
                SortDescString="EndTime desc"
                SortAscDescription="End Time ascending"
                SortDescDescription="End Time descending"
                SortDir="none"
                SortOrder="0"/>
            <colref id="Stage"
                SortAscString="Stage asc"
                SortDescString="Stage desc"
                SortAscDescription="Stage ascending"
                SortDescDescription="Stage descending"
                SortDir="none"
                SortOrder="0"/>            
        </SortDef>
    </SortXML>
    <ReportTemplateXML>
        <ReportTemplate>
            <colref id="ActivityIcon" header="" field="Quality" />
            <colref id="ActivityType" header="Activity Type" field="ActivityType" />
            <colref id="ActivityName" header="Batch ID" field="ActivityName" />
            <colref id="ActivityEntity" header="Activity Entity" field="ActivityEntity" />
            <colref id="PublicName" header="Public Name" field="PublicName" />
            <colref id="Asset" header="Asset" field="Asset" />
            <colref id="Description" header="Description" field="Description" />
            <colref id="CreateTime" header="Create Time" field="CreateTime" />
            <colref id="StartTime" header="Start Time" field="StartTime" />
            <colref id="EndTime" header="End Time" field="EndTime" />
            <colref id="Stage" header="Stage" field="Stage" />
        </ReportTemplate>
    </ReportTemplateXML>
    <ColumnStateXML>
        <state>
            <colref id="ActivityIcon" width="60" />
            <colref id="ActivityName" width="200" />
            <colref id="ActivityEntity" width="200" />
            <colref id="PublicName" width="180" hidden="false" />
            <colref id="Asset" width="180" />
            <colref id="ActivityType" width="180" />
            <colref id="Description" width="480" />
            <colref id="Stage" width="180"/>
            <colref id="CreateTime" width="360"/>
            <colref id="StartTime" width="360"/>
            <colref id="EndTime" width="360"/>
        </state>
    </ColumnStateXML>
    <TableDefinitionXML>
        <table>
            <tableMenu>
                <GroupRef GroupId="TableMenuGroup"/>
            </tableMenu>
            <contextMenu>
                <GroupRef GroupId="ContextMenuGroup"/>
            </contextMenu>
            <columns>
                <column id="ActivityIcon" name="Activity Icon">
                    <title tooltip="Click to filter or sort by Activity Icon">&lt;span class="blankHeader"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="ActivityIconColumnFilterMainGroup"/>
                        <GroupRef GroupId="PreDefActIconFilterGroup"/>
                        <GroupRef GroupId="ActivityIconSortGroup"/>
                    </menu>
                    <content>
                        &lt;div style="behavior: url(#AlarmStateIconFactory#ActivityIcon); 
                                   width: 100%; 
                                   height: 100%;
                                   position: relative;
                                   top: 0px;
                                   z-index: 10;
                                   white-space: nowrap;
                                    text-align: center;"&gt;&lt;/div&gt;
                    </content>
                    <bindings>
                        <in fields="Quality" properties="Questionable" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
						<in fields="Selected" properties="centre" xforms="xfCentreAlarmIcon"/>
                    </bindings>
                </column>
                <column id="ActivityType" name="Type">
                    <title tooltip="Click to filter or sort by activity type">&lt;span class="textHeader"&gt;Type&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="ActivityTypeColumnFilterMainGroup"/>
                        <GroupRef GroupId="PreDefActTypeFilterGroup"/>
                        <GroupRef GroupId="ActivityTypeSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="ActivityType" xforms="EmptyVariantToString" properties="innerText;title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="ActivityName" name="Batch ID">
                    <title tooltip="Click to filter or sort by batch ID">&lt;span class="textHeader"&gt;Batch ID&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="ActivityNameColumnFilterMainGroup"/>
                        <GroupRef GroupId="ActivityNameSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="ActivityName" xforms="EmptyVariantToString" properties="innerText;title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="ActivityEntity" name="Activity Entity">
                    <title tooltip="Click to filter or sort by activity entity">&lt;span class="textHeader"&gt;Activity Entity&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="ActivityEntityColumnFilterMainGroup"/>
                        <GroupRef GroupId="ActivityEntitySortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="ActivityEntity" xforms="EmptyVariantToString" properties="innerText;title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="PublicName" name="Public Name">
                    <title tooltip="Click to filter or sort by public name">&lt;span class="textHeader"&gt;Public Name&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="PublicNameColumnFilterMainGroup"/>
                        <GroupRef GroupId="PublicNameSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="PublicName" xforms="EmptyVariantToString" properties="innerText;title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="Asset" name="Asset">
                    <title tooltip="Click to filter or sort by asset">&lt;span class="textHeader"&gt;Asset&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="AssetFilterGroup"/>
                        <GroupRef GroupId="AssetSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="Asset" xforms="EmptyVariantToString" properties="innerText;title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="Description" name="Description">
                    <title tooltip="Click to filter or sort by description">&lt;span class="textHeader"&gt;Description&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="DescriptionColumnFilterMainGroup"/>
                        <GroupRef GroupId="DescriptionSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="Description" xforms="EmptyVariantToString" properties="innerText;title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="CreateTime" name="Create Time">
                    <title tooltip="Click to filter or sort by activity creation time">&lt;span class="textHeader"&gt;Create Time&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="CreateTimeColumnFilterMainGroup"/>
                        <GroupRef GroupId="CreateTimeFilterGroup"/>
                        <GroupRef GroupId="CreateTimeSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="CreateTime;CreateTimeMicroSeconds" xforms="xfDTCellFormat" properties="innerText" />
                        <in fields="CreateTime;CreateTimeMicroSeconds" xforms="xfDTTooltipFormat" properties="title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="StartTime" name="Start Time">
                    <title tooltip="Click to filter or sort by activity start time">&lt;span class="textHeader"&gt;Start Time&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="StartTimeColumnFilterMainGroup"/>
                        <GroupRef GroupId="StartTimeFilterGroup"/>
                        <GroupRef GroupId="StartTimeSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="StartTime;StartTimeMicroSeconds" xforms="xfDTCellFormat" properties="innerText" />
                        <in fields="StartTime;StartTimeMicroSeconds" xforms="xfDTTooltipFormat" properties="title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="EndTime" name="End Time">
                    <title tooltip="Click to filter or sort by activity end time">&lt;span class="textHeader"&gt;End Time&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="EndTimeColumnFilterMainGroup"/>
                        <GroupRef GroupId="EndTimeFilterGroup"/>
                        <GroupRef GroupId="EndTimeSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="EndTime;StartTimeMicroSeconds" xforms="xfDTCellFormat" properties="innerText" />
                        <in fields="EndTime;StartTimeMicroSeconds" xforms="xfDTTooltipFormat" properties="title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
                <column id="Stage" name="Stage">
                    <title tooltip="Click to filter or sort by activity stage">&lt;span class="textHeader"&gt;Stage&lt;/span&gt;</title>
                    <action/>
                    <menu>
                        <GroupRef GroupId="StageColumnFilterMainGroup"/>
                        <GroupRef GroupId="StageFilterGroup"/>
                        <GroupRef GroupId="StageSortGroup"/>
                    </menu>
                    <content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
                    <bindings>
                        <in fields="Stage" xforms="EmptyVariantToString" properties="innerText;title" />
                        <in fields="Selected" properties="id" xforms="xfSelection"/>
                    </bindings>
                </column>
            </columns>
        </table>
    </TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
</DATAOBJECT>
<DATAOBJECT id="2" type="HMIPage.EntitySource" format="propertybag">
<PROPERTY name="Version">4.5</PROPERTY>
<PROPERTY name="SummaryType">6</PROPERTY> 
<PROPERTY name="AutoMigrate">0</PROPERTY>
<PROPERTY name="WaitForSelectionList">1</PROPERTY>
<PROPERTY name="StartLocation"></PROPERTY>
<PROPERTY name="AuxFilter">IsAssigned or HasAssignedDescendents</PROPERTY>
<PROPERTY name="TemplateXML"><![CDATA[
<TableTemplate>
    <FieldXML>
        <fields>
            <field id="Selected"/>
            <field id="NodeHandle" rowId="true"/>
            <field id="Depth"/>
            <field id="Expanded"/>
            <field id="NumChildren"/>
            <field id="SiblingNumber"/>
            <field id="PointNumber"/>
            <field id="IsAssigned"/>
            <field id="HasAssignedDescendents"/>
            <field id="EntityName"/>
            <field id="TagName"/>
            <field id="FullName"/>
            <field id="RemoteType"/>
            <field id="SubType"/>
            <field id="ItemNumber"/>
            <field id="Redundant"/>
            <field id="Type"/>
            <field id="DirectConnect"/>
            <field id="Flags"/>
        </fields>
    </FieldXML>
    <XFormXML>
        <xforms>
            <defaultValue id="xfEmptyVariantToString" value="" type="string"/>
            <script id="xfSelection" language="VBScript">
                Dim s
                s = "Unselected_Cells"
                If Not IsEmpty(Value(0)) Then
                    If Value(0) Then
                    If g_bAreaTableIsActive Then
                        If Value(1) Then 
                            s = "Selected_Active_Cells"
                        Else
                            s = "Selected_Active_Unassigned_Cells"
                        End If
                    Else
                        If Value(1) Then
                            s = "Selected_Inactive_Cells"
                        Else
                            s = "Selected_Inactive_Unassigned_Cells"
                        End If
                    End If
                    ElseIf Not Value(1) Then
                    s = "Unassigned_Cells"
                    End If
                End If
                Return = s
            </script>
            <script id="xfBold" language="VBScript">
                if (true) then
                    Return = ""
                else
                    Return = "bold"
                end if
            </script>
            <script id="xfIconImg" language="VBScript">
                Return = GetNodeImagePath(Value)
            </script>
            <script id="xfIconVisible" language="VBScript">
                if (true) then
                    Return = "visible"
                else
                    Return = "hidden"
                end if
            </script>
            <script id="xfPadding" language="VBScript">
                if ( IsEmpty(Value) ) then
                    Return = 0
                else
                    Return = (Value - 1) * 16
                end if
            </script>
            <script id="xfPlusMinusImg" language="VBScript">
                if (IsEmpty(Value(0)) or (Value(0) = 0)) then
                    Return = "Images/blank.gif"
                elseif (Value(1)) then
                    Return = "Images/minus.gif"
                else
                    Return = "Images/plus.gif"
                end if
            </script>
            <script id="xfNameAndCount" language="VBScript">
                Return = GetNodeDisplayName(Value)
                if( false ) then
                    if( Value(4) &gt; 0 ) then
                    Return = Return &amp; " (" &amp; Value(4) &amp; ")"
                    end if
                end if
            </script>
            <script id="xfUnavailableImg" language="VBScript">
                Return = GetUnavailableImagePath(Value)
            </script>
        </xforms>
    </XFormXML>
    <HTMLWrapperXML>
        <HTMLWrappers>
            <MenuItemWrapper>
                <Begin>
                    &lt;div style="position: relative; width: 170px; padding-bottom: 2px; padding-top: 1px; padding-right: 5px;" onmouseenter="OnEnter_MenuItem(this)" onmouseleave="OnLeave_MenuItem(this)"&gt;&lt;span&gt;
                </Begin>
                <End>
                    &lt;/span&gt;&lt;/div&gt;
                </End>
            </MenuItemWrapper>
            <FilterAppliedWrapper>
                <Begin>
                    &lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; margin-right: 1px; background-color: mediumblue; color: white; font-weight: bold;"&gt;
                </Begin>
                <End>
                    &lt;/span&gt;
                </End>
            </FilterAppliedWrapper>
            <SortAscIndicator>
                &amp;nbsp;&lt;img src="Images/SortArrowUp.gif"&gt;
            </SortAscIndicator>
            <SortDescIndicator>
                &amp;nbsp;&lt;img src="Images/SortArrowDown.gif"&gt;
            </SortDescIndicator>
            <GroupSeparator>
                &lt;div style="position:relative; width: 160px; height: 2px; overflow: hidden; display: block; border: 1px inset; margin: 3px;" &gt;&lt;/div&gt;
            </GroupSeparator>
        </HTMLWrappers>
    </HTMLWrapperXML>
    <MenuGroupXML>
        <MenuGroups>
        </MenuGroups>
    </MenuGroupXML>
    <BaseFilterXML>
        <BaseFilterDef>
        </BaseFilterDef>
    </BaseFilterXML>
    <SortXML>
        <SortDef DefaultSortColumn="Tree" DefaultSortDir="asc">
            <colref id="Tree" 
                SortAscString="EntityName asc"
                SortDescString="EntityName desc"
                SortDir="asc"
                SortOrder="1"/>
        </SortDef>
    </SortXML>
    <ColumnStateXML>
        <state>
            <colref id="Tree" width="100" hidden="false" />
        </state>
    </ColumnStateXML>
    <TableDefinitionXML>
        <table>
            <tableMenu/>
            <contextMenu/>
            <columns>
                <column id="Tree">
                    <title>Tree</title>
                    <action/>
                    <menu/>
                    <content>
                        &lt;div language="javascript" onmousedown="if( event.button != 1 ) { event.cancelBubble = true; return false; }"
                            style="top: 0px; left: 0px; height: 100%; width: 100%; position: absolute; padding-top: 0px;" language="javascript" ExpandCollapseTrigger=0&gt;
                            &lt;div style="position: absolute;"&gt;	    
                                &lt;div style="position: absolute; display: inline; left: 2px; top: 3px;"
                                    onmousedown="if( event.button == 1 ) { this.parentElement.parentElement.ExpandCollapseTrigger = 1; event.cancelBubble = true; }"&gt;
                                    &lt;img style="position: relative; top: -3px; width: 9px; height: 9px;" src="Images/blank.gif"/&gt;
                                &lt;/div&gt;
                                &lt;div language="javascript" ondblclick="AreaTable.Binding.DataObjects(0).PointDetail();" style="position: absolute; left: 15px; top: 1px; display: inline;"&gt;
                                    &lt;div style="position: absolute; left: 0px; top: 0px; width: 19px; height: 19px; display: inline;"&gt;
                                        &lt;img style="position: absolute; 
                                            left: 0px;
                                            width: 19px; 
                                            height: 19px; 
                                             z-index: 2;" 
                                        src="Images/blank.gif"&gt;
                                    &lt;/div&gt;
                                    &lt;div style="position: absolute; left: 0px; top: 0px; width: 19px; height: 19px; display: inline;"&gt;
                                        &lt;img style="position: absolute; 
                                            left: 0px;
                                            width: 19px; 
                                            height: 19px; 
                                             z-index: 2;" 
                                        src="Images/blank.gif"&gt;
                                    &lt;/div&gt;
                                &lt;/div&gt;
                                &lt;div language="javascript" ondblclick="AreaTable.Binding.DataObjects(0).PointDetail();" style="position: absolute; left: 36px; top: 1px; display: inline;"&gt;&lt;/div&gt;
                            &lt;/div&gt;  
                        &lt;/div&gt;
                    </content>
                    <bindings>
                        <in fields="Depth" properties="firstChild.style.pixelLeft" xforms="xfPadding" />
                        <in fields="NumChildren;Expanded" properties="firstChild.firstChild.firstChild.src" xforms="xfPlusMinusImg" />
                        <in fields="RemoteType;SubType;ItemNumber;Redundant;Flags" properties="firstChild.firstChild.nextSibling.firstChild.firstChild.src" xforms="xfIconImg" />
                        <in fields="EntityName;Type;SubType;DirectConnect" properties="firstChild.firstChild.nextSibling.firstChild.nextSibling.firstChild.src" xforms="xfUnavailableImg" />
                        <in fields="EntityName;RemoteType;SubType;ItemNumber" properties="firstChild.lastChild.innerText;title" xforms="xfNameAndCount" />
                        <in fields="Selected" properties="firstChild.lastChild.style.fontWeight" xforms="xfBold" />
                        <in fields="Selected;IsAssigned" properties="firstChild.lastChild.id" xforms="xfSelection"/>
                        <in fields="Selected" properties="firstChild.firstChild.nextSibling.firstChild.style.visibility;firstChild.firstChild.nextSibling.firstChild.nextSibling.style.visibility" xforms="xfIconVisible"/>
                        <out properties="ExpandCollapseTrigger" fields="Expanded"/>
                    </bindings>
                </column>
            </columns>
        </table>
    </TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
</DATAOBJECT>
</DATASOURCE>

