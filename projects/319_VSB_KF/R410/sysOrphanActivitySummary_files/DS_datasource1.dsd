                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterLCS>
                <SQLFilterDialog id="Filter_PublicNameColumnCustom" DialogState="" Selected="false" url="Dialogs/StringFilterDialog.htm" format="scroll: no; dialogHeight: 210px; dialogWidth: 500px; center: Yes; help: No; resizable: No; status: No;" param="Show all activities where the public name:$$PARAMDELIM$$PublicName" modal="true">
                    <Selected>
                        &lt;div title="Define a custom filter based on the public name" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        (Custom Filter...)
                        &lt;/div&gt;
                    </Selected>
