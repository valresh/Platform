                        &lt;div title="Show activities with the same activity stage as the currently selected activity" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        (Like Currently Selected)
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Show activities with the same activity stage as the currently selected activity" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        (Like Currently Selected)
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterLCS>	
                <SQLFilterDialog id="Filter_StageColumnCustom" DialogState="" Selected="false" url="Dialogs/StringFilterDialog.htm" format="scroll: no; dialogHeight: 210px; dialogWidth: 500px; center: Yes; help: No; resizable: No; status: No;" param="Show all activities where the stage:$$PARAMDELIM$$Stage" modal="true">
                    <Selected>
                        &lt;div title="Define a custom filter based on the Stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        (Custom Filter...)
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Define a custom filter based on the stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        (Custom Filter...)
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterDialog>
            </SQLFilterGroup>
            <SQLFilterGroup id="StageFilterGroup" SelectionPolicy="multi">
                <SQLFilterPredefined id="Filter_StageColumnINIT" FilterString="StageEnum = 1" FilterDescription="INIT" Selected="false">
                    <Selected>
                        &lt;div title="Show activities in INIT stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        INIT
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Show activities in INIT stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        INIT
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterPredefined>
                <SQLFilterPredefined id="Filter_StageColumnPreExec" FilterString="StageEnum = 8" FilterDescription="Pre-Exec" Selected="false">
                    <Selected>
                        &lt;div title="Show activities in PreExecution stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        PreExecution
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Show activities in PreExecution stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        PreExecution
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterPredefined>
                <SQLFilterPredefined id="Filter_StageColumnExec" FilterString="StageEnum = 16" FilterDescription="Exec" Selected="false">
                    <Selected>
                        &lt;div title="Show activities in Executing stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        Executing
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Show activities in Executing stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        Executing
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterPredefined>
                <SQLFilterPredefined id="Filter_StageColumnPostExec" FilterString="StageEnum = 24" FilterDescription="Post-Exec" Selected="false">
                    <Selected>
                        &lt;div title="Show activities in PostExecution stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        PostExecution
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Show activities in PostExecution stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        PostExecution
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterPredefined>
                <SQLFilterPredefined id="Filter_StageColumnFAILED" FilterString="StageEnum = 32" FilterDescription="FAILED" Selected="false">
                    <Selected>
                        &lt;div title="Show activities in FAILED stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        FAILED
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Show activities in FAILED stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        FAILED
                        &lt;/div&gt;
                    </NotSelected>
                </SQLFilterPredefined>
            </SQLFilterGroup>
            <SuperGroup id="StageColumnFilterSuperGroup" DefaultItem="Filter_StageColumnAll">
                <GroupRef GroupId="StageColumnFilterMainGroup"/>
                <GroupRef GroupId="StageFilterGroup"/>
            </SuperGroup>
            <SortGroup id="StageSortGroup">
                <SortItem id="Sort_StageAsc" AssociatedColumn="Stage" SortDir="asc">
                    <Selected>
                        &lt;div title="Sort the activities in ascending order (A-Z) by activity stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        Sort Ascending
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Sort the activities in ascending order (A-Z) by activity stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        Sort Ascending
                        &lt;/div&gt;
                    </NotSelected>
                </SortItem>
                <SortItem id="Sort_StageDesc" AssociatedColumn="Stage" SortDir="desc">
                    <Selected>
                        &lt;div title="Sort the activities in descending order (Z-A) by activity stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
                        Sort Descending
                        &lt;/div&gt;
                    </Selected>
                    <NotSelected>
                        &lt;div title="Sort the activities in descending order (Z-A) by activity stage" style="width: 100%;"&gt;
                        &lt;img src="Images/Spacer.gif"&gt;
                        Sort Descending
                        &lt;/div&gt;
                    </NotSelected>
                </SortItem>
            </SortGroup>
            <SQLFilterGroup id="PublicNameColumnFilterMainGroup" SelectionPolicy="supersingle">
                <SQLFilterPredefined id="Filter_PublicNameColumnAll" FilterString="" FilterDescription="" Selected="true">
                    <Selected>
                        &lt;div title="Show activities with any public name" style="width: 100%;"&gt;
                        &lt;img src="Images/Dot.gif"&gt;
