	sText = me.innerText
	me.hostpopulation = false
	me.ResetContent
	me.AddString "ON"
	me.AddString "OFF"
	me.innerText = sText]]></script><script event="onchange" language="VBScript"><![CDATA[	on error resume next

'	param_FORCE.value = me.innerText
	dim bRet
	if me.innerText = "OFF" then
		bRet = sd.SetDataValueSynchronous ("tagname.S4", 0) 	'wait for write!
	else
		bRet = sd.SetDataValueSynchronous ("tagname.S4", -1)
	end if

'	Now, assuming an actual synchonous write, update presentation, in case write failed.
	if bRet = False then
		if sd.DataValue("tagname.S4") = "0" then
			combo_S4.innerText = "OFF" 
		else
			combo_S4.innerText = "ON"
		end if
	end if]]></script></scripts></html><binding/></element><html><content><![CDATA[
