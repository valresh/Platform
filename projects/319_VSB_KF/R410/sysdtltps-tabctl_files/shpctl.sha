		bRet = sd.SetDataValueSynchronous ("tagname.S1", 0) 	'wait for write!
	else
		bRet = sd.SetDataValueSynchronous ("tagname.S1", -1)
	end if

'	Now, assuming an actual synchonous write, update presentation, in case write failed.
	if bRet = False then
		if sd.DataValue("tagname.S1") = "0" then
			combo_S1.innerText = "OFF" 
		else
			combo_S1.innerText = "ON"
		end if
	end if]]></script></scripts></html><binding/></element><html><content><![CDATA[
