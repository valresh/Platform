<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 99.48%; FONT-FAMILY: Arial; HEIGHT: 5.55%; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#line); TOP: 83.33%; LEFT: 0%" id=lineGeneral003 class=hvg.base.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:1;lineColorBlink:False;points:0.000000 0.000000 100.000000 0.000000 ;Width:193;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 60.82%; FONT-FAMILY: Helvetica; HEIGHT: 94.44%; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 0%; LEFT: 0.51%" id=txtGeneral003 class="hvg.textbox.1 Label_Text" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:Label_Text;textColor:black;textColorBlink:False;TotalRotation:-1;Width:118;">General</DIV>]]></content></html></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 27.71%; HEIGHT: 3.55%; VISIBILITY: hidden; FONT-SIZE: 0pt; BEHAVIOR: url(#HDXVectorFactory#group); TOP: 3.55%; LEFT: 0.85%" id=GrpGeneralHeader class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:18;lineColorBlink:False;Width:194;" HDX_LOCK="-1"></DIV>]]></content></html></group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 0.14%; FONT-FAMILY: Arial; HEIGHT: 0.19%; VISIBILITY: hidden; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect); TOP: 0%; LEFT: 0%" id=rectSpacerTL001 class=hvg.base.1 tabIndex=-1 hdxproperties="FillColor:#ff0000;fillColorBlink:False;Height:1;lineColorBlink:False;Width:1;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; WIDTH: 9.14%; FONT-FAMILY: Small Fonts; HEIGHT: 2.37%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 7pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); TOP: 34.78%; LEFT: 7.42%" id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:12;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:64;" HDX_LOCK="-1">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim bTPNServerOK
	on error resume next

	if not bPVSPFormatSet then
	'   Format SP and PV related parameters to SPFORMAT and PVFORMAT as available
		bPVSPFormatSet = True
	    
	    If sd.QualityGood("tagname.PVFORMAT") Then
    
	        Select Case sd.DataValue("tagname.PVFORMAT")
	        Case "D0"
	            formatPV = 0
	        Case "D1"
	            formatPV = 1
	        Case "D2"
	            formatPV = 2
	        Case "D3"
	            formatPV = 3
	        Case "D4"
	            formatPV = 4
	        Case "D5"
	            formatPV = 5
	        Case "D6"
	            formatPV = 6
	        Case Else
	            formatPV = -1  ' if using FormatNumber, -1 means "computer's regional setting"
	        End Select
	    End If   

	    If sd.QualityGood("tagname.SPFORMAT") Then
    
	        Select Case sd.DataValue("tagname.SPFORMAT")
	        Case "D0"
	            formatSP = 0
	        Case "D1"
	            formatSP = 1
	        Case "D2"
	            formatSP = 2
	        Case "D3"
	            formatSP = 3
	        Case "D4"
	            formatSP = 4
	        Case "D5"
	            formatSP = 5
	        Case "D6"
	            formatSP = 6
	        Case Else
	            formatSP = -1  ' use default - i.e. computer's regional setting
	        End Select
	    End If   'defaulted to 2

		if formatSP = -1 then 'default to PVFORMAT
			formatSP = formatPV
		end if

        If Not formatPV = -1 Then
			param_PVAUTO.numericdisplayformat = "%." & formatPV & "f"
        End If

        If Not formatSP = -1 Then          
		    param_SP.numericdisplayformat = "%." & formatSP & "f"
			param_PVTV.numericdisplayformat = "%." & formatSP & "f"
			param_SPHILM.numericdisplayformat = "%." & formatSP & "f"
			param_SPLOLM.numericdisplayformat = "%." & formatSP & "f"
        End If

	end if 

	if bVisibilityUpdated = FALSE then
		GrpGeneralHeader.style.visibility = "Inherit"
		GrpRangeLimitsHeader.style.visibility = "Inherit"
		GrpPVInputsHeader.style.visibility = "Inherit"
		GrpTuningParametersHeader.style.visibility = "Inherit"
	end if

	if not sd.QualityGood("tagname.NODE_NO") then
		txtLoading.value = "** Missing TPN Data **"
		txtLoading.style.visibility = "Inherit"
		bTPNServerOK = FALSE
	else
		bTPNServerOK = TRUE
		txtLoading.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.BYPASS") then
		if sd.DataValue("tagname.BYPASS") = "0" then
			combo_BYPASS.innerText = "OFF"
			GrpBYPASS.style.visibility = "Inherit"
		elseif sd.DataValue("tagname.BYPASS") = "1" then
			combo_BYPASS.innerText = "ON"
			GrpBYPASS.style.visibility = "Inherit"
		else
			GrpBYPASS.style.visibility = "Hidden"
		end if
	else
		GrpBYPASS.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BYPASSX1") then
		if sd.DataValue("tagname.BYPASSX1") = "0" then
			combo_BYPASSX1.innerText = "OFF"
			GrpBYPASSX1.style.visibility = "Inherit"
		elseif sd.DataValue("tagname.BYPASSX1") = "1" then
			combo_BYPASSX1.innerText = "ON"
			GrpBYPASSX1.style.visibility = "Inherit"
		else
			GrpBYPASSX1.style.visibility = "Hidden"
		end if
	else
		GrpBYPASSX1.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BYPASSX2") then
		if sd.DataValue("tagname.BYPASSX2") = "0" then
			combo_BYPASSX2.innerText = "OFF"
			GrpBYPASSX2.style.visibility = "Inherit"
		elseif sd.DataValue("tagname.BYPASSX2") = "1" then
			combo_BYPASSX2.innerText = "ON"
			GrpBYPASSX2.style.visibility = "Inherit"
		else
			GrpBYPASSX2.style.visibility = "Hidden"
		end if
	else
		GrpBYPASSX2.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BYPASSX3") then
		if sd.DataValue("tagname.BYPASSX3") = "0" then
			combo_BYPASSX3.innerText = "OFF"
			GrpBYPASSX3.style.visibility = "Inherit"
		elseif sd.DataValue("tagname.BYPASSX3") = "1" then
			combo_BYPASSX3.innerText = "ON"
			GrpBYPASSX3.style.visibility = "Inherit"
		else
			GrpBYPASSX3.style.visibility = "Hidden"
		end if
	else
		GrpBYPASSX3.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BYPASSX4") then
		if sd.DataValue("tagname.BYPASSX4") = "0" then
			combo_BYPASSX4.innerText = "OFF"
			GrpBYPASSX4.style.visibility = "Inherit"
		elseif sd.DataValue("tagname.BYPASSX4") = "1" then
			combo_BYPASSX4.innerText = "ON"
			GrpBYPASSX4.style.visibility = "Inherit"
		else
			GrpBYPASSX4.style.visibility = "Hidden"
		end if
	else
