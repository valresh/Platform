<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="182px" height="122px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><scripts><script event="" language="VBScript" id="F1B11C1E-9F95-4589-8844-9AEC59C32E75"><![CDATA[dim SetHeapStart]]></script><script event="onshapeload" language="VBScript" id=""><![CDATA[dim tpscmd
set tpscmd = CreateObject("TPS.Commands")
dim stnum
dim Mynode 
dim PRSTS_TAG

MyNode = tpscmd.NodeNumber

if MyNode < 10 then
	PRSTS_TAG = "$PRSTS0" & Cstr(MyNode)
else
	PRSTS_TAG = "$PRSTS" & Cstr(MyNode)
end if

txt_node.value =  Cstr(MyNode)

me.setCustomProperty "Point", "NodeNumber", PRSTS_TAG
SetHeapStart = false
txt_console.value = cstr(tpscmd.consolenumber)
tpscmd.ReadDDB 1, 0, 2, stnum
txt_station.value = Cstr(stnum)]]></script></scripts><parameters><parameter name="NodeNumber" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
