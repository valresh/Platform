<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 44.94%; FONT-FAMILY: Verdana; HEIGHT: 100%; VISIBILITY: hidden; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 0%; LEFT: 0%" id=txtOPFINAL class="hvg.textbox.1 DetailText" tabIndex=-1 HDX_LOCK="-1" hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:DetailText;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:80;">OPFINAL:</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: right; BACKGROUND-COLOR: transparent; BORDER-LEFT-STYLE: none; WIDTH: 56.17%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 100%; VISIBILITY: hidden; COLOR: black; BORDER-RIGHT-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); TOP: 0%; LEFT: 43.82%; ROWS: 1" id=param_OPFINAL class="hsc.alpha.1 DetailData" title="" tabIndex=0 HDX_LOCK="-1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:21;numericDisplayFormat:%.2f;styleClass:DetailData;textColor:Black;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="OPFINAL"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 100%; HEIGHT: 21.05%; FONT-SIZE: 0pt; BEHAVIOR: url(#HDXVectorFactory#group); TOP: 77.63%; LEFT: 0%" id=GrpOPFINAL class=hvg.group.1 tabIndex=-1 HDX_LOCK="-1" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:178;"></DIV>]]></content></html></group><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 39.88%; FONT-FAMILY: Verdana; HEIGHT: 100%; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 0%; LEFT: 0%" id=txtCTLALGID class="hvg.textbox.1 DetailText" tabIndex=-1 HDX_LOCK="-1" hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;styleClass:DetailText;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:71;">CTL ALG:<BR>:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: right; WIDTH: 61.79%; FONT-FAMILY: Verdana; HEIGHT: 100%; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 0%; LEFT: 38.2%" id=param_CTLALGID class="hvg.textbox.1 DetailData" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;styleClass:DetailData;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:110;">Text</DIV>]]></content></html></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 100%; HEIGHT: 21.05%; FONT-SIZE: 0pt; BEHAVIOR: url(#HDXVectorFactory#group); TOP: 0%; LEFT: 0%" id=GrpCTLALGID class=hvg.group.1 tabIndex=-1 HDX_LOCK="-1" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:178;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 24.72%; HEIGHT: 15.2%; VISIBILITY: hidden; FONT-SIZE: 0pt; BEHAVIOR: url(#HDXVectorFactory#group); TOP: 4.2%; LEFT: 1.94%" id=GrpGeneral class=hvg.group.1 tabIndex=-1 HDX_LOCK="-1" hdxproperties="fillColorBlink:False;Height:76;lineColorBlink:False;Width:178;"></DIV>]]></content></html></group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; WIDTH: 8.88%; FONT-FAMILY: Small Fonts; HEIGHT: 2.4%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 7pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); TOP: 34%; LEFT: 7.22%" id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" tabIndex=-1 HDX_LOCK="-1" hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:12;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:64;">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	if not bPVSPFormatSet then
	'   Format SP and PV related parameters to SPFORMAT and PVFORMAT as available
		bPVSPFormatSet = True
	    
	    If sd.QualityGood("tagname.PVFORMAT") Then
    
	        Select Case sd.DataValue("tagname.PVFORMAT")
	        Case "D0"
	            formatPV = 0
	        Case "D1"
	            formatPV = 1
	        Case "D2"
	            formatPV = 2
	        Case "D3"
	            formatPV = 3
	        Case "D4"
	            formatPV = 4
	        Case "D5"
	            formatPV = 5
	        Case "D6"
	            formatPV = 6
	        Case Else
	            formatPV = -1  ' if using FormatNumber, -1 means "computer's regional setting"
	        End Select
	    End If   

	    If sd.QualityGood("tagname.SPFORMAT") Then
    
	        Select Case sd.DataValue("tagname.SPFORMAT")
	        Case "D0"
	            formatSP = 0
	        Case "D1"
	            formatSP = 1
	        Case "D2"
	            formatSP = 2
	        Case "D3"
	            formatSP = 3
	        Case "D4"
	            formatSP = 4
	        Case "D5"
	            formatSP = 5
	        Case "D6"
	            formatSP = 6
	        Case Else
	            formatSP = -1  ' use default - i.e. computer's regional setting
	        End Select
	    End If   'defaulted to 2

		if formatSP = -1 then 'default to PVFORMAT
			formatSP = formatPV
		end if

        If Not formatPV = -1 Then
			param_PVAUTO.numericdisplayformat = "%." & formatPV & "f"
        End If

        If Not formatSP = -1 Then          
			param_SP.numericdisplayformat = "%." & formatSP & "f"
			param_SPHILM.numericdisplayformat = "%." & formatSP & "f"
			param_SPLOLM.numericdisplayformat = "%." & formatSP & "f"
        End If

	end if 

	if bInherit = FALSE then
		GrpGeneralHeader.style.visibility = "Inherit"
		GrpRangeLimitsHeader.style.visibility = "Inherit"
		GrpPVInputsHeader.style.visibility = "Inherit"
		GrpTuningParametersHeader.style.visibility = "Inherit"
	end if

	if not sd.QualityConfigError("tagname.CTLALGID") then
		param_CTLALGID.value = sd.DataValue("tagname.CTLALGID")
		GrpCTLALGID.style.visibility = "Inherit"
	else
		GrpCTLALGID.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.OPFINAL") then
		GrpOPFINAL.style.visibility = "Inherit"
	else
		GrpOPFINAL.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.OPEU") then
		GrpOPEU.style.visibility = "Inherit"
	else
		GrpOPEU.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.CV") then
		GrpCV.style.visibility = "Inherit"
	else
		GrpCV.style.visibility = "Hidden"
	end if

' Tuning Parameters group 1
	if not sd.QualityConfigError("tagname.RATE1") then
		GrpRATE1.style.visibility = "Inherit"
	else
		GrpRATE1.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKV1") then
		GrpSOAKV1.style.visibility = "Inherit"
	else
		GrpSOAKV1.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKT1") then
		GrpSOAKT1.style.visibility = "Inherit"
	else
		GrpSOAKT1.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.RATE2") then
		GrpRATE2.style.visibility = "Inherit"
	else
		GrpRATE2.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKV2") then
		GrpSOAKV2.style.visibility = "Inherit"
	else
		GrpSOAKV2.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKT2") then
		GrpSOAKT2.style.visibility = "Inherit"
	else
		GrpSOAKT2.style.visibility = "Hidden"
	end if

	if not sd.QualityConfigError("tagname.RATE3") then
		GrpRATE3.style.visibility = "Inherit"
	else
		GrpRATE3.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKV3") then
		GrpSOAKV3.style.visibility = "Inherit"
	else
		GrpSOAKV3.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKT3") then
		GrpSOAKT3.style.visibility = "Inherit"
	else
		GrpSOAKT3.style.visibility = "Hidden"
	end if

	if not sd.QualityConfigError("tagname.RATE4") then
		GrpRATE4.style.visibility = "Inherit"
	else
		GrpRATE4.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKV4") then
		GrpSOAKV4.style.visibility = "Inherit"
	else
		GrpSOAKV4.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKT4") then
		GrpSOAKT4.style.visibility = "Inherit"
	else
		GrpSOAKT4.style.visibility = "Hidden"
	end if

	if not sd.QualityConfigError("tagname.RATE5") then
		GrpRATE5.style.visibility = "Inherit"
	else
		GrpRATE5.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKV5") then
		GrpSOAKV5.style.visibility = "Inherit"
	else
		GrpSOAKV5.style.visibility = "Hidden"
	end if
	if not sd.QualityConfigError("tagname.SOAKT5") then
		GrpSOAKT5.style.visibility = "Inherit"
