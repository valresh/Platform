<?xml version="1.0"?><shapefile version="1" type="sequence" title="" description="" useFirstShapeForBadValue="0" width="150px" height="202px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src="..\Styles\SysFaceplate.css"/></stylesheets><scripts><script event="" language="VBScript" id="125EAA07-87C9-4B01-853D-1353FB31604E"><![CDATA[sub PROTECTIVEInterlock(oSource)
dim oShape 
on error resume next
set oShape=oSource.parentnode.parentnode
dim iTop
iTop = 0
	if oShape.objects("ConAlpPro1").value = 1 then
		oShape.objects("ConProgrp1").style.visibility = "inherit" : oShape.objects("ConProgrp1").style.pixeltop = iTop : iTop = oShape.objects("ConProgrp1").style.pixeltop + 45
		oShape.objects("ConRectProtective").style.pixelheight = iTop + 20 : oShape.objects("ConTxtPro").style.pixelTop = iTop
	else
		oShape.objects("ConTxtPro").style.pixelTop = iTop
		oShape.objects("ConProgrp1").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpPro4").value = 1 then
		oShape.objects("ConProgrp4").style.visibility = "inherit" : oShape.objects("ConProgrp4").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConProgrp4").style.pixeltop 
		oShape.objects("ConRectProtective").style.pixelheight = iTop + 20
	else
		oShape.objects("ConProgrp4").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpPro7").value = 1 then
		oShape.objects("ConProgrp7").style.visibility = "inherit" : oShape.objects("ConProgrp7").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConProgrp7").style.pixeltop
		oShape.objects("ConRectProtective").style.pixelheight = iTop + 20
	else
		oShape.objects("ConProgrp7").style.visibility = "Hidden"
	end if
	
	if oShape.objects("ConAlpPro8").value = 1 then
		oShape.objects("ConProgrp8").style.visibility = "inherit" : oShape.objects("ConProgrp8").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConProgrp8").style.pixeltop
		oShape.objects("ConRectProtective").style.pixelheight = iTop + 20
	else
		oShape.objects("ConProgrp8").style.visibility = "Hidden"
	end if
	if iTop = oShape.objects("ConProgrp1").style.pixeltop + 45 then
		oShape.objects("ConTxtPro").style.visibility = "Hidden"
		oShape.objects("ConRectProtective").style.pixelheight = iTop 
	else
		oShape.objects("ConTxtPro").style.visibility = "inherit"
	end if
end sub]]></script></scripts><parameters><parameter name="PointId" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
