dim oShape 
on error resume next
set oShape=oSource.parentnode.parentnode
dim iTop
iTop = 0
	if oShape.objects("ConAlpCMD1").value = 1 then
		oShape.objects("ConCMDgrp1").style.visibility = "inherit" : oShape.objects("ConCMDgrp1").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp1").style.pixeltop 
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
	else
		oShape.objects("ConCMDgrp1").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpCMD2").value = 1 then
		oShape.objects("ConCMDgrp2").style.visibility = "inherit" : oShape.objects("ConCMDgrp2").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp2").style.pixeltop 
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
	else
		oShape.objects("ConCMDgrp2").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpCMD3").value = 1 then
		oShape.objects("ConCMDgrp3").style.visibility = "inherit" : oShape.objects("ConCMDgrp3").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp3").style.pixeltop
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
	else
		oShape.objects("ConCMDgrp3").style.visibility = "Hidden"
	end if
	
	if oShape.objects("ConAlpCMD4").value = 1 then
		oShape.objects("ConCMDgrp4").style.visibility = "inherit" : oShape.objects("ConCMDgrp4").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp4").style.pixeltop 
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
	else
		oShape.objects("ConCMDgrp4").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpCMD5").value = 1 then
		oShape.objects("ConCMDgrp5").style.visibility = "inherit" : oShape.objects("ConCMDgrp5").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp5").style.pixeltop
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
	else
		oShape.objects("ConCMDgrp5").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpCMD6").value = 1 then
		oShape.objects("ConCMDgrp6").style.visibility = "inherit" : oShape.objects("ConCMDgrp6").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp6").style.pixeltop
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
		
	else
		oShape.objects("ConCMDgrp6").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpCMD7").value = 1 then
		oShape.objects("ConCMDgrp7").style.visibility = "inherit" : oShape.objects("ConCMDgrp7").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp7").style.pixeltop
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
	else
		oShape.objects("ConCMDgrp7").style.visibility = "Hidden"
	end if
	
	if oShape.objects("ConAlpCMD8").value = 1 then
		oShape.objects("ConCMDgrp8").style.visibility = "inherit" : oShape.objects("ConCMDgrp8").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp8").style.pixeltop
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
	else
		oShape.objects("ConCMDgrp8").style.visibility = "Hidden"
	end if
end sub]]></script></scripts><parameters><parameter name="PointId" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
