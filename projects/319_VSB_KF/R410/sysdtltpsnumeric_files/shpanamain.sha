dim bVisibilityUpdated
bVisibilityUpdated = FALSE

public formatPV
public formatSP
public bPVSPFormatSet
formatPV = -1
formatSP = -1
bPVSPFormatSet = False


function QualityOK(PointObj)

'	Returns TRUE if the given object (parameter) is 'valid'
	if (PointObj.quality and &HFF) = &HC0 then
		QualityOK = true
	else
		QualityOK = false	
	end if

end function

function Configured(PointObj)

'	Returns TRUE if the given object (parameter) is 'configured' 
	if (PointObj.quality and &HFF) = &H04 then
		Configured = false	
	else
		Configured = true
	end if

end function]]></script></scripts><parameters><parameter name="tagname" type="Point" description="HSCpoint" defaultvalue=""/><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 0.14%; FONT-FAMILY: Arial; HEIGHT: 0.19%; VISIBILITY: hidden; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect); TOP: 0%; LEFT: 0%" id=rectSpacerTL class=hvg.base.1 tabIndex=-1 hdxproperties="FillColor:#ff0000;fillColorBlink:False;Height:1;lineColorBlink:False;Width:1;" HDX_LOCK="-1"></DIV>]]></content></html></element><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 99.46%; FONT-FAMILY: Arial; HEIGHT: 6.25%; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#line); TOP: 93.75%; LEFT: 0%" id=lineGeneral class=hvg.base.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:1;lineColorBlink:False;points:0.000000 0.000000 100.000000 0.000000 ;Width:185;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 38.17%; FONT-FAMILY: Helvetica; HEIGHT: 100%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 0%; LEFT: 1.07%" id=Unt002 class="hvg.textbox.1 Label_Text" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:16;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;styleClass:Label_Text;textColor:black;textColorBlink:False;TotalRotation:-1;Width:71;">General</DIV>]]></content></html></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 26.57%; HEIGHT: 3.1%; VISIBILITY: hidden; FONT-SIZE: 0pt; BEHAVIOR: url(#HDXVectorFactory#group); TOP: 3.48%; LEFT: 0.85%" id=GrpGeneralHeader class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:186;" HDX_LOCK="-1"></DIV>]]></content></html></group><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 61.82%; FONT-FAMILY: Helvetica; HEIGHT: 94.44%; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 0%; LEFT: 1.07%" id=txtRangeLimits class="hvg.textbox.1 Label_Text" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:Label_Text;textColor:black;textColorBlink:False;TotalRotation:-1;Width:115;">Range Limits<BR></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 99.46%; FONT-FAMILY: Arial; HEIGHT: 5.55%; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#line); TOP: 83.33%; LEFT: 0%" id=lineRangeLimits class=hvg.base.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:1;lineColorBlink:False;points:0.000000 0.000000 100.000000 0.000000 ;Width:185;" HDX_LOCK="-1"></DIV>]]></content></html></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 26.57%; HEIGHT: 3.48%; VISIBILITY: hidden; FONT-SIZE: 0pt; BEHAVIOR: url(#HDXVectorFactory#group); TOP: 3.48%; LEFT: 35.57%" id=GrpRangeLimitsHeader class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:18;lineColorBlink:False;Width:186;" HDX_LOCK="-1"></DIV>]]></content></html></group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; WIDTH: 10.28%; FONT-FAMILY: Small Fonts; HEIGHT: 2.32%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 7pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: ; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); TOP: 3.68%; LEFT: 12.14%" id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:12;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:72;">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim bTPNServerOK
	on error resume next

	if not bPVSPFormatSet then
	'   Format SP and PV related parameters to SPFORMAT and PVFORMAT as available
		bPVSPFormatSet = True
	    
	    If sd.QualityGood("tagname.PVFORMAT") Then
    
	        Select Case sd.DataValue("tagname.PVFORMAT")
	        Case "D0"
	            formatPV = 0
	        Case "D1"
	            formatPV = 1
	        Case "D2"
	            formatPV = 2
	        Case "D3"
	            formatPV = 3
	        Case "D4"
	            formatPV = 4
	        Case "D5"
	            formatPV = 5
	        Case "D6"
	            formatPV = 6
	        Case Else
	            formatPV = -1  ' if using FormatNumber, -1 means "computer's regional setting"
	        End Select
	    End If   

	    If sd.QualityGood("tagname.SPFORMAT") Then
    
	        Select Case sd.DataValue("tagname.SPFORMAT")
	        Case "D0"
	            formatSP = 0
	        Case "D1"
	            formatSP = 1
	        Case "D2"
	            formatSP = 2
	        Case "D3"
	            formatSP = 3
	        Case "D4"
	            formatSP = 4
	        Case "D5"
	            formatSP = 5
	        Case "D6"
	            formatSP = 6
	        Case Else
	            formatSP = -1  ' use default - i.e. computer's regional setting
	        End Select
	    End If   'defaulted to 2

		if formatSP = -1 then 'default to PVFORMAT
			formatSP = formatPV
		end if

        If Not formatPV = -1 Then
			param_PVEXEUHI.numericdisplayformat = "%." & formatPV & "f"
			param_PVEUHI.numericdisplayformat = "%." & formatPV & "f"
			param_PVEULO.numericdisplayformat = "%." & formatPV & "f"
			param_PVEXEULO.numericdisplayformat = "%." & formatPV & "f"
			param_PVDSPHI.numericdisplayformat = "%." & formatPV & "f"
			param_PVDSPLO.numericdisplayformat = "%." & formatPV & "f"
			param_PVRAWHI.numericdisplayformat = "%." & formatPV & "f"
			param_PVRAWHI.numericdisplayformat = "%." & formatPV & "f"
			param_RANGEHI.numericdisplayformat = "%." & formatPV & "f"
			param_RANGELO.numericdisplayformat = "%." & formatPV & "f"
			param_PVHHTP.numericdisplayformat = "%." & formatPV & "f"
			param_PVHITP.numericdisplayformat = "%." & formatPV & "f"
			param_PVLOTP.numericdisplayformat = "%." & formatPV & "f"
			param_PVLLTP.numericdisplayformat = "%." & formatPV & "f"
			param_PVROCPTP.numericdisplayformat = "%." & formatPV & "f"
			param_PVROCNTP.numericdisplayformat = "%." & formatPV & "f"
			param_PVSGCHTP.numericdisplayformat = "%." & formatPV & "f"
			param_PVAUTO.numericdisplayformat = "%." & formatPV & "f"
			param_AV.numericdisplayformat = "%." & formatPV & "f"
			param_OLDAV.numericdisplayformat = "%." & formatPV & "f"
			param_AVTV.numericdisplayformat = "%." & formatPV & "f"
			param_AVEUHI.numericdisplayformat = "%." & formatPV & "f"
			param_AVEULO.numericdisplayformat = "%." & formatPV & "f"
			param_RV.numericdisplayformat = "%." & formatPV & "f"
			param_PVRAW.numericdisplayformat = "%." & formatPV & "f"
			param_XEUHI.numericdisplayformat = "%." & formatPV & "f"
			param_XEULO.numericdisplayformat = "%." & formatPV & "f"
			param_CVEUHI.numericdisplayformat = "%." & formatPV & "f"
			param_CVEULO.numericdisplayformat = "%." & formatPV & "f"
			param_ZEUHI.numericdisplayformat = "%." & formatPV & "f"
			param_ZEULO.numericdisplayformat = "%." & formatPV & "f"
			param_MOPHILM.numericdisplayformat= "%." & formatPV & "f"
 			param_MOPLOLM.numericdisplayformat= "%." & formatPV & "f"
        End If
        If Not formatSP = -1 Then          
		    param_SP.numericdisplayformat = "%." & formatSP & "f"
			param_ADVSP.numericdisplayformat = "%." & formatSP & "f"
			param_SPTV.numericdisplayformat = "%." & formatSP & "f"
			param_PVTV.numericdisplayformat = "%." & formatSP & "f"
			param_SPDSPLO.numericdisplayformat = "%." & formatSP & "f"
			param_SPDSPHI.numericdisplayformat = "%." & formatSP & "f"
			param_SPEULO.numericdisplayformat = "%." & formatSP & "f"
			param_SPEUHI.numericdisplayformat = "%." & formatSP & "f"
        End If

	end if   

	if bVisibilityUpdated = FALSE then
		GrpGeneralHeader.style.visibility = "Inherit"
		GrpRangeLimitsHeader.style.visibility = "Inherit"
		GrpAlarmLimitsHeader.style.visibility = "Inherit"
		GrpPointDataHeader.style.visibility = "Inherit"	
		GrpCLSwitchHeader.style.visibility = "Inherit"
	end if

	if not sd.QualityGood("tagname.NODE_NO") then
		txtLoading.value = "** Missing TPN Data **"
		txtLoading.style.visibility = "Inherit"
		bTPNServerOK = FALSE
	else
		bTPNServerOK = TRUE
		txtLoading.style.visibility = "Hidden"
	end if

'GrpGeneral
	if sd.QualityGood("tagname.CONTCUT") then
		GrpCONTCUT.style.visibility = "Inherit"
		if sd.DataValue("tagname.CONTCUT") <> 0 then
			param_CONTCUT.value = "ON"
		else
			param_CONTCUT.value = "OFF"
		end if
	else
		GrpCONTCUT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OUTSLTNM") then
		if sd.IsNan("tagname.OUTSLTNM") then
			param_OUTSLTNM.value = "NaN"
		else
			param_OUTSLTNM.value = FormatNumber(sd.DataValue("tagname.OUTSLTNM"),0)
		end if
		GrpOUTSLTNM.style.visibility = "Inherit"
	else
		GrpOUTSLTNM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OUTBOXNM") then
		if sd.IsNan("tagname.OUTBOXNM") then
			param_OUTBOXNM.value = "NaN"
		else
			param_OUTBOXNM.value = FormatNumber(sd.DataValue("tagname.OUTBOXNM"),0)
		end if
		GrpOUTBOXNM.style.visibility = "Inherit"
	else
		GrpOUTBOXNM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OUTSSLT") then
		if sd.IsNan("tagname.OUTSSLT") then
			param_OUTSSLT.value = "NaN"
		else
			param_OUTSSLT.value = FormatNumber(sd.DataValue("tagname.OUTSSLT"),0)
		end if
		GrpOUTSSLT.style.visibility = "Inherit"
	else
		GrpOUTSSLT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.CTLALGID") then
		param_CTLALGID.value = sd.DataValue("tagname.CTLALGID")
		GrpCTLALGID.style.visibility = "Inherit"
	else
		GrpCTLALGID.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ALGIDDAC") then
		param_ALGIDDAC.value = sd.DataValue("tagname.ALGIDDAC")
		GrpALGIDDAC.style.visibility = "Inherit"
	else
		GrpALGIDDAC.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OPCRDTY") then
		param_OPCRDTY.value = sd.DataValue("tagname.OPCRDTY")
		GrpOPCRDTY.style.visibility = "Inherit"
	else
		GrpOPCRDTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.IPCRDOP") then
		param_IPCRDOP.value = sd.DataValue("tagname.IPCRDOP")
		GrpIPCRDOP.style.visibility = "Inherit"
	else
		GrpIPCRDOP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.IPCRDTY") then
		param_IPCRDTY.value = sd.DataValue("tagname.IPCRDTY")
		GrpIPCRDTY.style.visibility = "Inherit"
	else
		GrpIPCRDTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.INPTSSLT") then
		param_INPTSSLT.value = FormatNumber(sd.DataValue("tagname.INPTSSLT"),0)
		GrpSUBSLOT.style.visibility = "Inherit"
	else
		GrpSUBSLOT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PLCADDR") then
		param_PLCADDR.value = FormatNumber(sd.DataValue("tagname.PLCADDR"),0)
		GrpPLCADDR.style.visibility = "Inherit"
	else
		GrpPLCADDR.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BOXNUM") then 
		param_BOXNUM.value = FormatNumber(sd.DataValue("tagname.BOXNUM"),0)
		if g_bEmulatedHG = TRUE then 
			txtEHGIndicator.style.visibility = "Inherit"
			window.external.parent.logmessage "EHB: IS emulated (showing E next to BOX param)"
		else
			window.external.parent.logmessage "EHB: IS NOT emulated (not showing E next to BOX param)"
			txtEHGIndicator.style.visibility = "Hidden"
		end if
		GrpBOXNUM.style.visibility = "Inherit"
	else
		GrpBOXNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PNTBOXTY") and not sd.DataValue("tagname.PNTBOXTY") = "NOTCONFG" then
		param_PNTBOXTY.value = sd.DataValue("tagname.PNTBOXTY")
		GrpPNTBOXTY.style.visibility = "Inherit"
	else
		GrpPNTBOXTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.HWYNUM") then
		param_HWYNUM.value = FormatNumber(sd.DataValue("tagname.HWYNUM"),0)
		GrpHWYNUM.style.visibility = "Inherit"
	else
		GrpHWYNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.SLOTNUM") then
		param_SLOTNUM.value = FormatNumber(sd.DataValue("tagname.SLOTNUM"),0)
		GrpSLOTNUM.style.visibility = "Inherit"
	else
		GrpSLOTNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODETYP") then
		param_NODETYP.value = sd.DataValue("tagname.NODETYP")
		GrpNODETYP.style.visibility = "Inherit"
	else
		GrpNODETYP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODENUM") then 
		param_NODENUM.value = FormatNumber(sd.DataValue("tagname.NODENUM"),0)
		GrpNODENUM.style.visibility = "Inherit"
	else
		GrpNODENUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NTWKNUM") then
		param_NTWKNUM.value = FormatNumber(sd.DataValue("tagname.NTWKNUM"),0)
		GrpNTWKNUM.style.visibility = "Inherit"
	else
		GrpNTWKNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.UNITNAME") then 
		param_UNITNAME.value = sd.DataValue("tagname.UNITNAME")
		GrpUNITNAME.style.visibility = "Inherit"
	else
		GrpUNITNAME.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PVALGID") then
		param_PVALGID.value = sd.DataValue("tagname.PVALGID")
		GrpPVALGID.style.visibility = "Inherit"
	else
		GrpPVALGID.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODE_NO") then
		param_NODE_NO.value = FormatNumber(sd.DataValue("tagname.NODE_NO"),0)
		GrpNODE_NO.style.visibility = "Inherit"
	else
		GrpNODE_NO.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ENT_TYPE") then
		param_ENT_TYPE.value = sd.DataValue("tagname.ENT_TYPE")
		GrpENT_TYPE.style.visibility = "Inherit"
	else
		GrpENT_TYPE.style.visibility = "Hidden"
	end if
	
	if sd.QualityGood("tagname.PNTMODTY") then
		param_PNTMODTY.value = sd.DataValue("tagname.PNTMODTY")
		GrpPNTMODTY.style.visibility = "Inherit"
	else
		GrpPNTMODTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.MODNUM") then
		param_MODNUM.value = sd.DataValue("tagname.MODNUM")
		GrpMODNUM.style.visibility = "Inherit"
	else
		GrpMODNUM.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.KEYWORD") then
		param_KEYWORD.value = sd.DataValue("tagname.KEYWORD")
		GrpKEYWORD.style.visibility = "Inherit"
	else
		GrpKEYWORD.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.BEFAFT") then
		if sd.DataValue("tagname.BEFAFT") = "BEFORE" or sd.DataValue("tagname.BEFAFT") = "AFTER" then
			bOkBEFAFTID = TRUE
			txtBEFAFT.value = sd.DataValue("tagname.BEFAFT") & ":"
			GrpBEFAFTID.style.visibility = "Inherit"
		else
			GrpBEFAFTID.style.visibility = "Hidden"
		end if
	else
		GrpBEFAFTID.style.visibility = "Hidden"
	end if

'	if not sd.QualityGood("tagname.CCSRC") or sd.DataValue("tagname.CCSRC") = -1 then
	if sd.QualityGood("tagname.CCSRC.external") then
		GrpCCSRC.style.visibility = "Visible"
		param_CCSRC.value = sd.DataValue("tagname.CCSRC.external")
'		param_CCSRC.value = FormatNumber(sd.DataValue("tagname.CCSRC"),0)
	else
		GrpCCSRC.style.visibility = "Hidden"
	end if

' CPU Saver - BELOW UNBOUND PARAMETERS
	if bVisibilityUpdated and bTPNServerOK and not bPeriodicVisibilityUpdate then 
		bDataChangeRequest = TRUE
		exit sub
	end if

	bPeriodicVisibilityUpdate = FALSE 'cpu saver flag

'GENERAL group
	if sd.QualityGood("tagname.PVAUTO") then 
		GrpPVAUTO.style.visibility = "Inherit"
	else
		GrpPVAUTO.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.SPTV") then 
		GrpSPTV.style.visibility = "Inherit"
	else
		GrpSPTV.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.ADVSP") then
		GrpADVSP.style.visibility = "Inherit"
	else
		GrpADVSP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.RATIO") then
		GrpRATIO.style.visibility = "Inherit"
	else
		GrpRATIO.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BIAS") then
		GrpBIAS.style.visibility = "Inherit"
	else
		GrpBIAS.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.RESETVAL") then
		GrpRESETVAL.style.visibility = "Inherit"
	else
		GrpRESETVAL.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.AVTVFL") then
		GrpAVTVFL.style.visibility = "Inherit"
	else
		GrpAVTVFL.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OLDAV") then
		GrpOLDAV.style.visibility = "Inherit"
	else
		GrpOLDAV.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OVERFLOW") then
		GrpOVERFLOW.style.visibility = "Inherit"
	else
		GrpOVERFLOW.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.REMSOAKT") then
		GrpREMSOAKT.style.visibility = "Inherit"
	else
		GrpREMSOAKT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.SOAKRMN") then
		GrpSOAKRMN.style.visibility = "Inherit"
	else
		GrpSOAKRMN.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NXTSOAKV") then
		GrpNXTSOAKV.style.visibility = "Inherit"
	else
		GrpNXTSOAKV.style.visibility = "Hidden"
	end if
' special test: hide "CYCLE" if PERIOD = "NOPERIOD"
	if sd.QualityGood("tagname.NORMCYCL") then
		if sd.QualityGood("tagname.PERIOD") then
			if sd.DataValue("tagname.PERIOD") = "NOPERIOD" then
				GrpCYCLE.style.visibility = "Hidden"
			else
				GrpCYCLE.style.visibility = "Inherit"
			end if
		else
			GrpCYCLE.style.visibility = "Inherit"
		end if
	else
		GrpCYCLE.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PPS") then
		btnPROCESS_PPS.style.visibility = "Inherit"
	else
		btnPROCESS_PPS.style.visibility = "Hidden"
	end if

' following four combos remain bound to leverage Experion combobox population (only do visibility)
	if sd.QualityGood("tagname.TVPROC") then
		GrpTVPROC.style.visibility = "Inherit"
	else
		GrpTVPROC.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.BYPASS") then
		GrpBYPASS.style.visibility = "Inherit"
	else
		GrpBYPASS.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.EMS") then
		GrpEMS.style.visibility = "Inherit"
	else
		GrpEMS.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.CURSEGID") then
		GrpCURSEGID.style.visibility = "Inherit"
	else
		GrpCURSEGID.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.SEGMENT") then
		GrpSEGMENT.style.visibility = "Inherit"
	else
		GrpSEGMENT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ASPPROC") then
		GrpASPPROC.style.visibility = "Inherit"
	else
