//var numDecimals;
//var fontSize;]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="Point Name" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<SPAN tabIndex=0 id=indicator001 class=hsc.indicator.1 style="FONT-SIZE: 0pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 64.24%; FONT-FAMILY: Arial; WIDTH: 12.58%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 30.44%; TOP: 18.48%; BEHAVIOR: url(#HSCIndicatorBehavior) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="borderStyle:Solid;borderWidth:2px;fillColor:transparent;fillColorBlink:0;fillDirection:0;fillStyle:0;HDXBINDINGID:-4;levelFillColor:#ffffff;levelFillColorBlink:0;lineColor:transparent;lineColorBlink:0;pointerDirection:0;positiveDirection:0;rangeOrigin:0;visibleRangeHi:100;visibleRangeLo:0;"></SPAN>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[	var loopCurrent = (this.value/100) * (20 - 4) + 4;
	shapeLoopCurrent.SetCustomProperty("Value", "CalculatedValue", loopCurrent);

	var clampedValue = Math.min(Math.max(this.value, this.rangeLo), this.rangeHi);
	var position = this.style.pixelTop + this.style.pixelHeight * (1 - clampedValue/100);
	var refPosition = shapeHDYNVAL1.style.pixelTop;
	line001.style.pixelTop = position;
	textboxNow.style.pixelTop = position - Math.round(textboxNow.style.pixelHeight/2);
	shapeLoopCurrent.style.pixelTop = position - Math.round(shapeLoopCurrent.style.pixelHeight/2);
	shapeHDYNVAL1.style.pixelTop = position - Math.round(shapeHDYNVAL1.style.pixelHeight/2);
	shapePV.style.pixelTop = position - Math.round(shapePV.style.pixelHeight/2);
	var diffPosition = shapeHDYNVAL1.style.pixelTop - refPosition;
	shapePVRAW.style.pixelTop = shapePVRAW.style.pixelTop + diffPosition;]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="1"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PVRAW"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="hsc.indicator" refcount="1"/></binding></element><element><html><content><![CDATA[
