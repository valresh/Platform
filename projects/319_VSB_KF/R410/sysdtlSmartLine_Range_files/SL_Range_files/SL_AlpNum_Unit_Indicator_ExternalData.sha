//var useNumDecimals;
//var numDecimals;
//var fontSize;]]></script><script event="onshapeload" language="JScript" id=""><![CDATA[	var numDecimals = this.GetCustomProperty("Value", "NumDecimals");
	var fontSize = this.GetCustomProperty("Value", "FontSize");
	alpha001.style.fontSize = String(fontSize) + "pt";
	textbox001.style.fontSize = String(fontSize) + "pt";

	textbox001.value = this.GetCustomProperty("Value", "Unit");
	alpha001.numericDisplayFormat = "%." + String(numDecimals) + "f";]]></script></scripts><parameters><parameter name="Unit" type="Value" description="Static unit" defaultvalue=""/><parameter name="NumDecimals" type="Value" description="Number of decimal places" defaultvalue="0"/><parameter name="FontSize" type="Value" description="Font size" defaultvalue="12"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alpha001 class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 91.66%; FONT-FAMILY: Arial; WIDTH: 46.96%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateNaNState:0;lineColor:#000000;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding/></element><element><html><content><![CDATA[
