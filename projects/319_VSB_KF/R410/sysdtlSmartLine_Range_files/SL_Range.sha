<DIV tabIndex=-1 id=polygonCursorDigitalPV class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 2.39%; FONT-FAMILY: Arial; WIDTH: 1.76%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 9.82%; TOP: 58.45%; BEHAVIOR: url(#HDXVectorFactory#polygon)" hdxproperties="FillColor:#e0e0e0;fillColorBlink:False;Height:17;LineColor:#e0e0e0;lineColorBlink:False;points:8.695656 0 100 52.94118 0 100 0 0 0 0 ;Width:16;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectExtScaleDigitalPV class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 57.46%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 11.69%; TOP: 18.3%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#c0c0c0;fillColorBlink:False;Height:408;LineColor:transparent;lineColorBlink:False;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[
