ge="JScript"><![CDATA[	var	numDecimals = SL_GetNumDecimals(this.value);

	this.numericDisplayFormat = "%." + String(numDecimals) + "f";

	if (this.value == alphaLo.value)
	{
		polylineTickExtLo.style.visibility = "visible";
		lineTickExtLo.style.visibility = "hidden";
	}
	else
	{
		polylineTickExtLo.style.visibility = "hidden";
		lineTickExtLo.style.visibility = "visible";
	}

	if (alphaExtLo.value != alphaLRL.value)
	{
		lineLRL_ExtLo.lineColor = statusDisplayScheme[3].lineColor;
	}
	else
	{
		lineLRL_ExtLo.lineColor = statusDisplayScheme[0].lineColor;
	}]]></script><script event="onchange" language="JScript"><![CDATA[	SL_LogEvent(this, "onchange");

	window.external.showCallout(this, "Are you sure you want to change the ExtLo range value from " + this.currentValue + " to " + this.value + "?", 1, 60);

	// Store the newly entered value temporarily so that it can be set as the current value if the user confirms the action.
	alphaExtLo_temp = this.value;

	// Prevent the database from being updated with the entered value until the user confirms the action.
	this.CancelChange();
	window.event.returnValue = "false";]]></script><script event="OnCalloutResponse" language="JScript"><![CDATA[	SL_LogEvent(this, "OnCalloutResponse");

	if (window.external.calloutresponse == "Y")
	{
		this.value = alphaExtLo_temp;
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PVEXEULO"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="-1"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/><class ID="HSC.ParameterFormat" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaExtHi title="" class="hsc.alpha.1 SL_Numeric_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 2.81%; FONT-FAMILY: arial; WIDTH: 7.06%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 73.06%; TOP: 17.18%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;styleClass:SL_Numeric_Normal;textColor:#404040;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[	var	numDecimals = SL_GetNumDecimals(this.value);

	this.numericDisplayFormat = "%." + String(numDecimals) + "f";

	if (this.value == alphaHi.value)
	{
		polylineTickExtHi.style.visibility = "visible";
		lineTickExtHi.style.visibility = "hidden";
	}
	else
	{
		polylineTickExtHi.style.visibility = "hidden";
		lineTickExtHi.style.visibility = "visible";
	}

	if (alphaExtHi.value != alphaURL.value)
	{
		lineURL_ExtHi.lineColor = statusDisplayScheme[3].lineColor;
	}
	else
	{
		lineURL_ExtHi.lineColor = statusDisplayScheme[0].lineColor;
	}]]></script><script event="OnCalloutResponse" language="JScript"><![CDATA[	SL_LogEvent(this, "OnCalloutResponse");

	if (window.external.calloutresponse == "Y")
	{
		this.value = alphaExtHi_temp;
	}]]></script><script event="onchange" language="JScript"><![CDATA[	SL_LogEvent(this, "onchange");

	window.external.showCallout(this, "Are you sure you want to change the ExtHi range value from " + this.currentValue + " to " + this.value + "?", 1, 60);

	// Store the newly entered value temporarily so that it can be set as the current value if the user confirms the action.
	alphaExtHi_temp = this.value;

	// Prevent the database from being updated with the entered value until the user confirms the action.
	this.CancelChange();
	window.event.returnValue = "false";]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PVEXEUHI"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=groupRange class="hvg.group.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 0pt; HEIGHT: 710px; WIDTH: 906px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:710;lineColorBlink:False;Width:906;"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");

	// If the current state is "Active":
	//      - show the message on how to enable editing
	//      - disable the AI Channel range value controls
	//      - hide the border on the AI Channel range value controls
	//      - hide the Accept Transmitter Range control
	// If the current state is "Inactive":
	//      - hide the message on how to enable editing
	//      - enable the AI Channel range value controls
	//      - show the border on the AI Channel range value controls
	//      - show the Accept Transmitter Range control if there is a range mismatch

	var executionState = new SL_ScriptData("PTEXECST");
	executionState.Fetch(this, "SLAnalogPoint");

	if (executionState.changed && executionState.valid)
	{
		// Initialize variables for the "Active" case;
		var borderStyle = "none";
		var disableControls = true;
		var showEditingMessage = true;

		if (executionState.value == "Inactive")
		{
			borderStyle = "solid";
			disableControls = false;
			showEditingMessage = false;
			editingEnabled = true;
		}

		alphaExtHi.style.borderStyle = borderStyle;
		alphaExtHi.disabled = disableControls;

		alphaHi.style.borderStyle = borderStyle;
		alphaHi.disabled = disableControls;

		alphaLo.style.borderStyle = borderStyle;
		alphaLo.disabled = disableControls;

		alphaExtLo.style.borderStyle = borderStyle;
		alphaExtLo.disabled = disableControls;

		SL_SetVisibility(textboxEditingMessage, showEditingMessage);

		SL_LogDebugLevelMessage(4, "groupRange_ondatachange", "Execution State = " + executionState.value + ", Disable Controls = " + disableControls + ", Border Style = " + borderStyle + ", Show Editing Message = " + showEditingMessage);
	}

	var rangeMismatch = new SL_ScriptData("HPVMISM");
	rangeMismatch.Fetch(this, "SLAnalogPoint");
	if ((rangeMismatch.changed || executionState.changed) && rangeMismatch.valid)
	{
		SL_SetVisibility(ovalRangeMismatch, rangeMismatch.value);
		SL_SetVisibility(textboxRangeMismatch, rangeMismatch.value);

		var editingEnabled = (executionState.valid && (executionState.value == "Inactive"));
		SL_SetVisibility(textboxAcceptTransmitterRange, (editingEnabled && rangeMismatch.value));

		SL_LogDebugLevelMessage(4, "groupRange_ondatachange", "Range Mismatch = " + rangeMismatch.value + ", Accept Transmitter Range Visibility = " + textboxAcceptTransmitterRange.style.visibility);
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PTEXECST,HPVMISM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></group></shape></shapes></shapefile>