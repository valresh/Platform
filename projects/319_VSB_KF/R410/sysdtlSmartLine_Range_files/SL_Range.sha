<DIV tabIndex=-1 id=rectAtFailLoLoopCurrent class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 46.19%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 47.24%; TOP: 24.5%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#ffc627;fillColorBlink:False;Height:328;LineColor:transparent;lineColorBlink:False;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectAtFailHiLoopCurrent class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 47.88%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 47.24%; TOP: 21.69%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#ffc627;fillColorBlink:False;Height:340;LineColor:transparent;lineColorBlink:False;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectExtRangeLoopCurrent class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 47.88%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 47.24%; TOP: 22.25%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#e0e0e0;fillColorBlink:False;Height:340;LineColor:transparent;lineColorBlink:False;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelTransform class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.39%; FONT-FAMILY: arial; WIDTH: 17.66%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 85.35%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:160;">Transfer Function</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelDamping class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.39%; FONT-FAMILY: arial; WIDTH: 17.66%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 88.59%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:160;">Damping</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelPercentOfRange class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.39%; FONT-FAMILY: arial; WIDTH: 17.66%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 91.83%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:160;">% of Range</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ovalRangeMismatch class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 2.11%; FONT-FAMILY: Arial; WIDTH: 1.65%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0.28%; BEHAVIOR: url(#HDXVectorFactory#oval)  url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="FillColor:#ffc627;fillColorBlink:False;HDXBINDINGID:-4;Height:15;indicateAlarmState:False;indicateScanState:False;LineColor:#ffc627;lineColorBlink:False;Width:15;"></DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelDigitalPV class="hvg.textbox.1  HSC.ScriptDataObject.1 " style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.39%; FONT-FAMILY: Arial; WIDTH: 24.28%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #404040; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0.88%; TOP: 78.3%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:17;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:220;">Digital PV</DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var digitalPVUnitCode = this.DataValue("SLAnalogPoint.HEU");	

	this.value = "Digital PV (" + HART_GetShortSymbolFromStandardUnitCode(digitalPVUnitCode) + ")";]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HEU,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaDigitalPV class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 2.53%; FONT-FAMILY: Arial; WIDTH: 8.38%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 1.1%; TOP: 58.3%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[	var	numDecimals = SL_GetNumDecimals(this.value);

	this.numericDisplayFormat = "%." + String(numDecimals) + "f";

	var position;
	var badValue = (this.value === undefined) || isNaN(this.value);
	var badURVLRV = (alphaURV.value === undefined) || isNaN(alphaURV.value) || (alphaLRV.value === undefined) || isNaN(alphaLRV.value) ||
						(alphaURV.value <= alphaLRV.value);
	if (!badValue)
	{
		this.textColor = statusDisplayScheme[0].textColor;
	}
	else
	{
		this.textColor = statusDisplayScheme[3].textColor;
	}

	if (!badValue && !badURVLRV)
	{
		if ((this.value >= alphaLRV.value) && (this.value <= alphaURV.value))
		{
			position = Math.round(rectScaleDigitalPV.style.pixelTop + rectScaleDigitalPV.style.pixelHeight - rectScaleDigitalPV.style.pixelHeight *
						(this.value - alphaLRV.value) / (alphaURV.value - alphaLRV.value));
			polygonCursorDigitalPV.style.visibility = "visible";
			polygonCursorDigitalPV.style.pixelTop = Math.round(position - (polygonCursorDigitalPV.style.pixelHeight/2));
		}
		else if (this.value < alphaLRV.value)
		{
			if ((alphaLRL.value !== undefined) && (!isNaN(alphaLRL.value)) && (this.value >= alphaLRL.value))
			{				
				position = Math.round(rectExtScaleDigitalPV.style.pixelTop + rectExtScaleDigitalPV.style.pixelHeight - (rectExtScaleDigitalPV.style.pixelTop + rectExtScaleDigitalPV.style.pixelHeight - (rectScaleDigitalPV.style.pixelTop + rectScaleDigitalPV.style.pixelHeight)) *
						(this.value - alphaLRL.value) / (alphaLRV.value - alphaLRL.value));
				polygonCursorDigitalPV.style.visibility = "visible";
				polygonCursorDigitalPV.style.pixelTop = Math.round(position - (polygonCursorDigitalPV.style.pixelHeight/2));				
			}
			else
			{
				position = rectExtScaleDigitalPV.style.pixelTop + rectExtScaleDigitalPV.style.pixelHeight + offset;
				polygonCursorDigitalPV.style.visibility = "hidden";							
			}
		}
		else if ((alphaURL.value !== undefined) && (!isNaN(alphaURL.value)) && (this.value <= alphaURL.value))
		{
			position = Math.round(rectExtScaleDigitalPV.style.pixelTop + (rectScaleDigitalPV.style.pixelTop - rectExtScaleDigitalPV.style.pixelTop) *
						(alphaURL.value - this.value) / (alphaURL.value - alphaURV.value));
			polygonCursorDigitalPV.style.visibility = "visible";
			polygonCursorDigitalPV.style.pixelTop = Math.round(position - (polygonCursorDigitalPV.style.pixelHeight/2));				
		}
		else
		{
			position = rectExtScaleDigitalPV.style.pixelTop - offset ;
			polygonCursorDigitalPV.style.visibility = "hidden";
		}
	}
	else
	{
			position = rectExtScaleDigitalPV.style.pixelTop - offset;
			polygonCursorDigitalPV.style.visibility = "hidden";
	}

	this.style.pixelTop = Math.round(position - (alphaDigitalPV.style.pixelHeight/2));]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="HDYNVAL[1]"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="-1"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ParameterFormat" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ovalDigitalPVStatus class="hvg.base.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 2.11%; FONT-FAMILY: Arial; WIDTH: 1.65%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 11.12%; BEHAVIOR: url(#HDXVectorFactory#oval) url(#HSCScriptDataBehavior) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="FillColor:#e0e0e0;fillColorBlink:False;HDXBINDINGID:-4;Height:15;LineColor:#e0e0e0;lineColorBlink:False;Width:15;"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var deviceCode = this.DataValue("SLAnalogPoint.HDEVTYPE7");
	var deviceType = SL_GetDeviceType(deviceCode);
	
	if ((deviceType != "Pressure") && (deviceType != "Temperature"))
	{
		var digitalPVStatusCode = this.DataValue("SLAnalogPoint.HDYNST[1]");
		var digitalPVStatusInfo = SL_GetHARTDeviceVariableStatus(digitalPVStatusCode);

		if (digitalPVStatusInfo != "")
		{
			this.style.visibility = "visible";
			alphaDigitalPVStatus.style.visibility = "visible";
			this.lineColor = digitalPVStatusInfo.lineColor;
			this.fillColor = digitalPVStatusInfo.fillColor;
			polygonCursorDigitalPV.lineColor = digitalPVStatusInfo.lineColor;
			polygonCursorDigitalPV.fillColor = digitalPVStatusInfo.fillColor;

			if (digitalPVStatusInfo.limitStatus != "")
			{
				if (digitalPVStatusInfo.moreStatusAvailable != "")
				{
					alphaDigitalPVStatus.value = digitalPVStatusInfo.processDataStatus + ", " + 
						digitalPVStatusInfo.limitStatus + ", " + digitalPVStatusInfo.moreStatusAvailable;
				}
				else
				{
					alphaDigitalPVStatus.value = digitalPVStatusInfo.processDataStatus + ", " + 
						digitalPVStatusInfo.limitStatus;					
				}
			}
			else
			{
				alphaDigitalPVStatus.value = digitalPVStatusInfo.processDataStatus;
			}
		}
		else
		{
			this.style.visibility = "hidden";
			alphaDigitalPVStatus.style.visibility = "hidden";
			polygonCursorDigitalPV.lineColor = statusDisplayScheme[0].lineColor;
			polygonCursorDigitalPV.fillColor = statusDisplayScheme[0].fillColor;
		}
	}
	else
	{
		this.style.visibility = "hidden";
		alphaDigitalPVStatus.style.visibility = "hidden";
		polygonCursorDigitalPV.lineColor = statusDisplayScheme[0].lineColor;
		polygonCursorDigitalPV.fillColor = statusDisplayScheme[0].fillColor;
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HDYNST[1],HDEVTYPE7,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxRangeMismatch class="hvg.textbox.1 SL_GroupHeader" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.53%; FONT-FAMILY: arial; WIDTH: 33.11%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #404040; TEXT-ALIGN: left; LEFT: 3.53%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:SL_GroupHeader;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:300;">Device PV Range Mismatch</DIV>]]></content></html></element><element><html><content><![CDATA[
