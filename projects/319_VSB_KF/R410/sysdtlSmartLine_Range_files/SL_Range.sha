<DIV tabIndex=-1 id=lineTickHi class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 0.14%; FONT-FAMILY: Arial; WIDTH: 3.31%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 80.24%; TOP: 24.5%; BEHAVIOR: url(#HDXVectorFactory#line)" hdxproperties="fillColorBlink:False;Height:1;LineColor:#c0c0c0;lineColorBlink:False;LineStyle:1;LineWidth:1;points:0 0 100 0 ;Width:30;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=lineTickLo class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 0.14%; FONT-FAMILY: Arial; WIDTH: 3.31%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 80.24%; TOP: 69.57%; BEHAVIOR: url(#HDXVectorFactory#line)" hdxproperties="fillColorBlink:False;Height:1;LineColor:#c0c0c0;lineColorBlink:False;LineStyle:1;LineWidth:1;points:0 0 100 0 ;Width:30;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=polylineTickExtLo class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 6.19%; FONT-FAMILY: Arial; WIDTH: 1.98%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 80.24%; TOP: 69.57%; BEHAVIOR: url(#HDXVectorFactory#polyline)" hdxproperties="fillColorBlink:False;Height:44;LineColor:#c0c0c0;lineColorBlink:False;points:100 0 66.66667 100 66.66667 100 0 100 ;Width:18;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=lineTickExtLo class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 0.14%; FONT-FAMILY: Arial; WIDTH: 3.31%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 80.24%; TOP: 75.77%; BEHAVIOR: url(#HDXVectorFactory#line)" hdxproperties="fillColorBlink:False;Height:1;LineColor:#c0c0c0;lineColorBlink:False;LineStyle:1;LineWidth:1;points:0 0 100 0 ;Width:30;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectExtScalePV class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 57.46%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 83.77%; TOP: 18.3%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#c0c0c0;fillColorBlink:False;Height:408;LineColor:transparent;lineColorBlink:False;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=polylineNot2ScaleHi_ExtHi class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 2.25%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 83.77%; TOP: 20.14%; BEHAVIOR: url(#HDXVectorFactory#polyline)" hdxproperties="fillColorBlink:False;Height:16;LineColor:#ffffff;lineColorBlink:False;LineWidth:2;points:0.000000 56.250000 96.153847 0.000000 0.000000 100.000000 0.000000 100.000000 100.000000 43.750000 100.000000 37.500000 ;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectScalePV class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 45.07%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 83.77%; TOP: 24.5%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#e0e0e0;fillColorBlink:False;Height:320;LineColor:transparent;lineColorBlink:False;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=polygonCursorPV class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 2.39%; FONT-FAMILY: Arial; WIDTH: 1.76%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 86.53%; TOP: 58.45%; BEHAVIOR: url(#HDXVectorFactory#polygon)" hdxproperties="FillColor:#e0e0e0;fillColorBlink:False;Height:17;LineColor:#e0e0e0;lineColorBlink:False;points:91.30434 0 0 52.94118 100 100 100 0 100 0 ;Width:16;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaPV title="" class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 2.53%; FONT-FAMILY: Arial; WIDTH: 8.38%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 88.63%; TOP: 58.3%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[	var	numDecimals = SL_GetNumDecimals(this.value);

	this.numericDisplayFormat = "%." + String(numDecimals) + "f";

	var position;
	var badValue = (this.value === undefined) || isNaN(this.value);
	var badHiLo = (alphaHi.value === undefined) || isNaN(alphaHi.value) || (alphaLo.value === undefined) || isNaN(alphaLo.value) ||
						(alphaHi.value <= alphaLo.value);

	if (!badValue)
	{
		this.textColor = statusDisplayScheme[0].textColor;
	}
	else
	{
		this.textColor = statusDisplayScheme[3].textColor;
	}

	if (!badValue && !badHiLo)
	{
		if ((this.value >= alphaLo.value) && (this.value <= alphaHi.value))
		{
			position = Math.round(rectScalePV.style.pixelTop + rectScalePV.style.pixelHeight - rectScalePV.style.pixelHeight *
						(this.value - alphaLo.value) / (alphaHi.value - alphaLo.value));
			polygonCursorPV.style.visibility = "visible";
			polygonCursorPV.style.pixelTop = Math.round(position - (polygonCursorPV.style.pixelHeight/2));
		}
		else if (this.value < alphaLo.value)
		{
			if ((alphaExtLo.value !== undefined) && (!isNaN(alphaExtLo.value)) && (this.value >= alphaExtLo.value))
			{	
				position = Math.round(rectExtScalePV.style.pixelTop + rectExtScalePV.style.pixelHeight - (rectExtScalePV.style.pixelTop + rectExtScalePV.style.pixelHeight - (rectScalePV.style.pixelTop + rectScalePV.style.pixelHeight)) *
						(this.value - alphaExtLo.value) / (alphaLo.value - alphaExtLo.value));
				polygonCursorPV.style.visibility = "visible";
				polygonCursorPV.style.pixelTop = Math.round(position - (polygonCursorPV.style.pixelHeight/2));				
			}
			else
			{
				position = rectExtScalePV.style.pixelTop + rectExtScalePV.style.pixelHeight + offset;
				polygonCursorPV.style.visibility = "hidden";							
			}
		}
		else if ((alphaExtHi.value !== undefined) && (!isNaN(alphaExtHi.value)) && (this.value <= alphaExtHi.value))
		{
			position = Math.round(rectExtScalePV.style.pixelTop + (rectScalePV.style.pixelTop - rectExtScalePV.style.pixelTop) *
						(alphaExtHi.value - this.value) / (alphaExtHi.value - alphaHi.value));
			polygonCursorPV.style.visibility = "visible";
			polygonCursorPV.style.pixelTop = Math.round(position - (polygonCursorPV.style.pixelHeight/2));				
		}
		else
		{
			position = rectExtScalePV.style.pixelTop - offset;
			polygonCursorPV.style.visibility = "hidden";
		}
	}
	else
	{
			position = rectExtScalePV.style.pixelTop - offset;
			polygonCursorPV.style.visibility = "hidden";
	}

	this.style.pixelTop = Math.round(position - (alphaPV.style.pixelHeight/2));]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="-1"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ParameterFormat" refcount="2"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=polylineNot2ScaleLo_extLo class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 2.25%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 83.66%; TOP: 71.4%; BEHAVIOR: url(#HDXVectorFactory#polyline)" hdxproperties="fillColorBlink:False;Height:16;LineColor:#ffffff;lineColorBlink:False;LineWidth:2;points:0.000000 56.250000 96.153847 0.000000 0.000000 100.000000 0.000000 100.000000 100.000000 43.750000 100.000000 37.500000 ;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaLoopCurrent class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 2.53%; FONT-FAMILY: Arial; WIDTH: 8.38%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 36.75%; TOP: 58.3%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #ffffff; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#ffffff;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.1f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var pvRAW = this.DataValue("SLAnalogPoint.PVRAW");
	var loopCurrent = (pvRAW / 100) * (20.0 - 4.0) + 4.0;
	this.value = loopCurrent.toFixed(2);
	var position;
	if ((this.value >= 0) || (this.value< 0))
	{	
		this.textColor = statusDisplayScheme[0].textColor;
		if ((this.value >= 3.1) && (this.value <= 21.5))
		{
			position = Math.round(rectFullRangeLoopCurrent.style.pixelTop + rectFullRangeLoopCurrent.style.pixelHeight *
				(1 - (this.value - 3.1) / (21.5 - 3.1)));
			polygonCursorLoopCurrent.style.visibility = "visible";
			polygonCursorLoopCurrent.style.pixelTop = Math.round(position - (polygonCursorLoopCurrent.style.pixelHeight/2));
		}
		else if (this.value < 3.1)
		{
			position = rectFullRangeLoopCurrent.style.pixelTop + rectFullRangeLoopCurrent.style.pixelHeight + offset;
			polygonCursorLoopCurrent.style.visibility = "hidden";
		}
		else
		{
			position = rectFullRangeLoopCurrent.style.pixelTop - offset;
			polygonCursorLoopCurrent.style.visibility = "hidden";
		}
	}
	else
	{
		this.textColor = statusDisplayScheme[3].textColor;
		position = rectFullRangeLoopCurrent.style.pixelTop - offset;
		polygonCursorLoopCurrent.style.visibility = "hidden";
	}

	this.style.pixelTop = Math.round(position - (alphaLoopCurrent.style.pixelHeight/2));]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVRAW,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
