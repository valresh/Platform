<DIV tabIndex=-1 id=ovalLoopCurrentStatus class="hvg.base.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 2.11%; FONT-FAMILY: Arial; WIDTH: 1.65%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 34.65%; TOP: 11.12%; BEHAVIOR: url(#HDXVectorFactory#oval) url(#HSCScriptDataBehavior) url(#BindingBehavior); VISIBILITY: inherit" hdxproperties="FillColor:#e0e0e0;fillColorBlink:False;HDXBINDINGID:-4;Height:15;LineColor:#e0e0e0;lineColorBlink:False;Width:15;"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var loopCurrentMode = this.DataValue("SLAnalogPoint.loop_current_mode");
	var loopCurrentFailed = this.DataValue("SLAnalogPoint.HDEVMALF");
	var loopCurrentFixed = this.DataValue("SLAnalogPoint.HCURRFIX");
	var loopCurrentSaturated = this.DataValue("SLAnalogPoint.HCURRSAT");

	if (loopCurrentMode == 0)
	{
		this.fillColor = statusDisplayScheme[3].fillColor;
		this.lineColor = statusDisplayScheme[3].lineColor;
		polygonCursorLoopCurrent.fillColor = statusDisplayScheme[3].fillColor;
		polygonCursorLoopCurrent.lineColor = statusDisplayScheme[3].lineColor;
		alphaLoopCurrentStatus.value = "Disabled";
	}
	else if (loopCurrentFailed == 1)
	{
		this.fillColor = statusDisplayScheme[3].fillColor;
		this.lineColor = statusDisplayScheme[3].lineColor;
		polygonCursorLoopCurrent.fillColor = statusDisplayScheme[3].fillColor;
		polygonCursorLoopCurrent.lineColor = statusDisplayScheme[3].lineColor;
		alphaLoopCurrentStatus.value = "Failed";
	}
	else if (loopCurrentFixed == 1)
	{
		this.fillColor = statusDisplayScheme[1].fillColor;
		this.lineColor = statusDisplayScheme[1].lineColor;
		polygonCursorLoopCurrent.fillColor = statusDisplayScheme[1].fillColor;
		polygonCursorLoopCurrent.lineColor = statusDisplayScheme[1].lineColor;
		alphaLoopCurrentStatus.value = "Fixed";
	}
	else if (loopCurrentSaturated == 1)
	{
		this.fillColor = statusDisplayScheme[2].fillColor;
		this.lineColor = statusDisplayScheme[2].lineColor;
		polygonCursorLoopCurrent.fillColor = statusDisplayScheme[2].fillColor;
		polygonCursorLoopCurrent.lineColor = statusDisplayScheme[2].lineColor;
		alphaLoopCurrentStatus.value = "Saturated";
	}
	else
	{
		this.fillColor = statusDisplayScheme[0].fillColor;
		this.lineColor = statusDisplayScheme[0].lineColor;
		polygonCursorLoopCurrent.fillColor = statusDisplayScheme[0].fillColor;
		polygonCursorLoopCurrent.lineColor = statusDisplayScheme[0].lineColor;
		alphaLoopCurrentStatus.value = "Good";
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="loop_current_mode,HDEVMALF,HCURRFIX,HCURRSAT,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
