<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="906px" height="710px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="" language="JScript" id="485137D7-B633-4BCB-8C6F-283C9DF1EB97"><![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///
/// SL_AlpNum_Unit_OneString.sha
///
/// <summary>
/// Formats a numeric value and the corresponding unit symbol into a single string displayed in a textbox.
/// </summary>
///
/// Revision History
///
/// EXP510.1-34		May 21, 2018	Improved debug messaging and error handling
/// EXP510.1-32		May 4,  2018	Initial Experion R510 testbed release
///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

function SL_ValueAndUnits_onDataChange(alphaNumeric)
{
	if ((alphaNumeric != undefined) && (alphaNumeric != null))
	{
		try
		{
			SL_LogFunctionParameters(2, "SL_ValueAndUnits_onDataChange", "alphaNumeric = " + alphaNumeric.id);

			// Walk back up the hierarchy to get the parent shape so that the custom properties can be fetched.
			var shape = alphaNumeric.parentElement;
			if ((shape != undefined) && (shape != null))
			{
				// Check to see if the units come from a point parameter or are static.
				var unitScriptData = new SL_ScriptData("UnitParam");
				var unitString;

				if (shape.GetCustomProperty("Parameter", "UnitParam") != "")
				{
					unitScriptData.Fetch(alphaNumeric, "SLAnalogPoint");
					if (unitScriptData.valid)
					{
						unitString = HART_GetShortSymbolFromStandardUnitCode(unitScriptData.value);
					}
				}
				else
				{
					unitScriptData.valid = true;
					unitString = shape.GetCustomProperty("Value", "Unit");
				}

				var valueScriptData = new SL_ScriptData("SLAnalogPtParam");
				var valueString = "";

				valueScriptData.Fetch(alphaNumeric, "SLAnalogPoint");

				if (valueScriptData.changed || unitScriptData.changed)
				{
					if (typeof(valueScriptData.value) == "number")
					{
						var useNumDecimals = shape.GetCustomProperty("Value", "UseNumDecimals");
						var numDecimals = shape.GetCustomProperty("Value", "NumDecimals");
						if (useNumDecimals == 0)
						{
							numDecimals = SL_GetNumDecimals(valueScriptData.value);
						}

						valueString = valueScriptData.value.toFixed(numDecimals).toString();
					}

					if ((unitString != undefined) && (unitString != ""))
					{
						valueString += " " + unitString;
					}
					alphaNumeric.value = valueString;

					var styleName = "SL_Numeric_";

					if (shape.GetCustomProperty("Value", "TextAlign") == 1)
						styleName += "Left_";

					if (valueScriptData.valid && unitScriptData.valid)
					{
						styleName += "Normal";
					}
					else
					{
						styleName += "BadQuality";
					}
					alphaNumeric.StyleClass = styleName;
					
					SL_LogDebugLevelMessage(4, "SL_ValueAndUnits_onDataChange", "string = " + valueString + ", style = " + styleName);
				}
			}
		}
		catch (error)
		{
			SL_LogErrorMessage("SL_ValueAndUnits_onDataChange", "Could not set the value, unit or style for: alphaNumeric = " + alphaNumeric.id, error);
			alphaNumeric.StyleClass = "SL_Numeric_Error";
		}
	}

}]]></script><script event="" language="JScript" id="5D2F9E1C-60C6-44A8-A251-844E2D3D06AB"><![CDATA[//for positioning digital PV and PV values when they are bad or out of range (pixels above top of scale or bottom of scale)
var offset = 0;
//for positioning loop current value when it is bad or out of range (pixels above top of scale or bottom of scale)
var offsetLoopCurrent = 0;

var alphaExtHi_temp = 0.0;
var alphaHi_temp = 0.0;
var alphaLo_temp = 0.0;
var alphaExtLo_temp = 0.0;]]></script><script event="onshapeload" language="JScript" id=""><![CDATA[	SL_LogEvent(this, "onshapeload");

	textboxAcceptTransmitterRange.disabled = false;
	textboxAcceptTransmitterRange.style.visibility = "hidden";

	textboxEditingMessage.disabled = false;
	textboxEditingMessage.style.visibility = "hidden";

	alphaExtHi.disabled = true;
	alphaHi.disabled = true;
	alphaLo.disabled = true;
	alphaExtLo.disabled = true;]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="Point Name" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectFullRangeLoopCurrent class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 51.83%; FONT-FAMILY: Arial; WIDTH: 2.75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 47.24%; TOP: 20.28%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#ffc627;fillColorBlink:False;FillStyle:0;Height:368;LineColor:transparent;lineColorBlink:False;Width:25;"></DIV>]]></content></html></element><element><html><content><![CDATA[
