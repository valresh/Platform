<DIV tabIndex=-1 id=textboxLabelFailureMode title="Determines the loop current value used to report a device failure. Hover over the parameter to see the corresponding current level." class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.81%; FONT-FAMILY: arial; WIDTH: 17.66%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 34.65%; TOP: 85.35%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:20;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:160;">Failure Mode</DIV>]]></content></html></element><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shapeFilteringTime_alphaValueUnitString class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Numeric_BadQuality" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 100%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #404040; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#404040;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SL_Numeric_BadQuality;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");
	SL_ValueAndUnits_onDataChange(this);]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="TF,,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=shapeFilteringTime class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 3.09%; FONT-FAMILY: Arial; WIDTH: 13.24%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 84.1%; TOP: 88.59%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink)" hdxproperties="fillColorBlink:False;Height:22;lineColorBlink:False;Width:120;" value = "1" src = ".\SL_Range_files\SL_AlpNum_Unit_OneString.sha" parameters = "Point?SLAnalogPoint:{%Point::SLAnalogPoint%};Parameter?SLAnalogPtParam:TF;Value?Unit:min;Parameter?UnitParam:;Value?UseNumDecimals:1;Value?NumDecimals:2;Value?TextAlign:0;" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content><scripts><script event="onshapeload" language="JScript"><![CDATA[	SL_LogEvent(this, "onshapeload");
	SL_SetReverseVideo(shapeFilteringTime_alphaValueUnitString, this.GetCustomProperty("Value", "TextAlign"), "Numeric");]]></script></scripts></html></group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaTransform title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Text_Right_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.09%; FONT-FAMILY: arial; WIDTH: 15.01%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 13.46%; TOP: 85.35%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SL_Text_Right_Normal;textColor:#404040;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var transformCode = parseInt(this.DataValue("SLAnalogPoint.HPVXFRCODE"));
	var transformType = SL_GetTransformCharType(transformCode);
	this.value = transformType;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HPVXFRCODE,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaFailureMode title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Text_Right_BadQuality" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.09%; FONT-FAMILY: arial; WIDTH: 15.01%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 47.9%; TOP: 85.35%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #404040; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#404040;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SL_Text_Right_BadQuality;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	if (SL_CheckScriptDataQuality(this, "SLAnalogPoint", "HPVALMCODE"))
    {
		var failureMode = this.DataValue("SLAnalogPoint.HPVALMCODE");

		if (failureMode == 1)
		{
			this.value = "Low";
			this.title = "A device failure will be indicated by a loop current less than 3.6 mA.";

			rectAtFailLoLoopCurrent.style.visibility = "visible";
			rectFailLoRangeLoopCurrent.style.visibility = "visible";
			polylineTick3_6mA.style.visibility = "visible";
			textboxLabel3_6mA.style.visibility = "visible";
			rectAtFailHiLoopCurrent.style.visibility = "hidden";
			rectFailHiRangeLoopCurrent.style.visibility = "hidden";
			polylineTick21_0mA.style.visibility = "hidden";
			textboxLabel21_0mA.style.visibility = "hidden";
		}
		else
		{
			this.value = "High";
			this.title = "A device failure will be indicated by a loop current greater than 21.0 mA.";

			rectAtFailLoLoopCurrent.style.visibility = "hidden";
			rectFailLoRangeLoopCurrent.style.visibility = "hidden";
			polylineTick3_6mA.style.visibility = "hidden";
			textboxLabel3_6mA.style.visibility = "hidden";
			rectAtFailHiLoopCurrent.style.visibility = "visible";
			rectFailHiRangeLoopCurrent.style.visibility = "visible";
			polylineTick21_0mA.style.visibility = "visible";
			textboxLabel21_0mA.style.visibility = "visible";
		}

		this.StyleClass = "SL_Text_Right_Normal";
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HPVALMCODE,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaCharacterization title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Text_Right_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.09%; FONT-FAMILY: arial; WIDTH: 15.01%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 82.22%; TOP: 85.35%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SL_Text_Right_Normal;textColor:#404040;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var charCode = parseInt(this.DataValue("SLAnalogPoint.PVCHAR"));
	var charType = SL_GetTransformCharType(charCode);
	this.value = charType;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVCHAR,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaPVClamping title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Text_Right_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.09%; FONT-FAMILY: arial; WIDTH: 15.01%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 82.22%; TOP: 91.83%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SL_Text_Right_Normal;textColor:#404040;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var pvClampOption = this.DataValue("SLAnalogPoint.PVCLAMP");

	if (pvClampOption == 1)
	{
		this.value = "ON";
	}
	else
	{
		this.value = "OFF";
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVCLAMP,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaPVSource class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Text_Right_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.09%; FONT-FAMILY: arial; WIDTH: 15.01%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 82.22%; TOP: 95.07%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SL_Text_Right_Normal;textColor:#404040;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var pvSourceOption = this.DataValue("SLAnalogPoint.PVSRCOPT");
	var pvSource = parseInt(this.DataValue("SLAnalogPoint.PVSOURCE"));
	var pvSourceString = "Auto";

	if (pvSourceOption == 1)
	{
		switch(pvSource)
		{
			case 0:	
			pvSourceString = "External";
			break;

			case 1:
			pvSourceString = "Man";
			break;

			case 2:
			default:
			pvSourceString = "Auto";
			break;
		}
	}
	this.value= pvSourceString;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVSRCOPT,PVSOURCE,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shapeDamping_alphaValueUnitString class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Numeric_BadQuality" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 100%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #404040; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#404040;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SL_Numeric_BadQuality;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");
	SL_ValueAndUnits_onDataChange(this);]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HPVDAMP,,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=shapeDamping class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 3.09%; FONT-FAMILY: Arial; WIDTH: 13.24%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 15.34%; TOP: 88.59%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink)" hdxproperties="fillColorBlink:False;Height:22;lineColorBlink:False;Width:120;" value = "1" src = ".\SL_Range_files\SL_AlpNum_Unit_OneString.sha" parameters = "Point?SLAnalogPoint:{%Point::SLAnalogPoint%};Parameter?SLAnalogPtParam:HPVDAMP;Value?Unit:s;Parameter?UnitParam:;Value?UseNumDecimals:1;Value?NumDecimals:2;Value?TextAlign:0;" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content><scripts><script event="onshapeload" language="JScript"><![CDATA[	SL_LogEvent(this, "onshapeload");
	SL_SetReverseVideo(shapeDamping_alphaValueUnitString, this.GetCustomProperty("Value", "TextAlign"), "Numeric");]]></script></scripts></html></group><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shapePercentOfRange_alphaValueUnitString class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Numeric_BadQuality" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 100%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #404040; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#404040;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SL_Numeric_BadQuality;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");
	SL_ValueAndUnits_onDataChange(this);]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="percentRange,,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=shapePercentOfRange class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 3.09%; FONT-FAMILY: Arial; WIDTH: 13.24%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 15.34%; TOP: 91.83%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink)" hdxproperties="fillColorBlink:False;Height:22;lineColorBlink:False;Width:120;" value = "1" src = ".\SL_Range_files\SL_AlpNum_Unit_OneString.sha" parameters = "Point?SLAnalogPoint:{%Point::SLAnalogPoint%};Parameter?SLAnalogPtParam:percentRange;Value?Unit:%;Parameter?UnitParam:;Value?UseNumDecimals:1;Value?NumDecimals:2;Value?TextAlign:0;" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content><scripts><script event="onshapeload" language="JScript"><![CDATA[	SL_LogEvent(this, "onshapeload");
	SL_SetReverseVideo(shapePercentOfRange_alphaValueUnitString, this.GetCustomProperty("Value", "TextAlign"), "Numeric");]]></script></scripts></html></group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaSaturationLimits title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Text_Right_BadQuality" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.09%; FONT-FAMILY: arial; WIDTH: 15.01%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 47.9%; TOP: 88.59%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #404040; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#404040;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SL_Text_Right_BadQuality;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	if (SL_CheckScriptDataQuality(this, "SLAnalogPoint", "Namur_option"))
    {
		var namurOption = this.DataValue("SLAnalogPoint.Namur_option");

		if (namurOption == 0)
		{
			this.value = "Honeywell";
			this.title = "The upper saturation limit for the loop current is 20.8 mA.";

			rectExtRangeLoopCurrent.style.visibility = "visible";
			lineTick20_8mA.style.visibility = "visible";
			textboxLabel20_8mA.style.visibility = "visible";
			rectExtRangeNamurLoopCurrent.style.visibility = "hidden";
			lineTick20_5mA.style.visibility = "hidden";
			textboxLabel20_5mA.style.visibility = "hidden";
		}
		else if (namurOption == 1)
		{
			this.value = "NAMUR";
			this.title = "The upper saturation limit for the loop current is 20.5 mA.";

			rectExtRangeLoopCurrent.style.visibility = "hidden";
			lineTick20_8mA.style.visibility = "hidden";
			textboxLabel20_8mA.style.visibility = "hidden";
			rectExtRangeNamurLoopCurrent.style.visibility = "visible";
			lineTick20_5mA.style.visibility = "visible";
			textboxLabel20_5mA.style.visibility = "visible";
		}
		else
		{
			this.value = "Unknown";
			rectExtRangeLoopCurrent.style.visibility = "visible";
			lineTick20_8mA.style.visibility = "visible";
			textboxLabel20_8mA.style.visibility = "visible";
			rectExtRangeNamurLoopCurrent.style.visibility = "hidden";
			lineTick20_5mA.style.visibility = "hidden";
			textboxLabel20_5mA.style.visibility = "hidden";
		}

		this.StyleClass = "SL_Text_Right_Normal";
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="Namur_option,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxAcceptTransmitterRange title="Click here to copy the Transmitter range values to the corresponding AI Channel range values." class="hvg.textbox.1  HSC.ScriptDataObject.1 " style="FONT-SIZE: 12pt; OVERFLOW: hidden; CURSOR: hand; TEXT-DECORATION: ; HEIGHT: 3.09%; FONT-FAMILY: arial; WIDTH: 29.8%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #1792e5; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 70.19%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:22;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#1792E5;textColorBlink:False;TotalRotation:-1;Width:270;">Accept Transmitter Range</DIV>]]></content><scripts><script event="OnCalloutResponse" language="JScript"><![CDATA[	SL_LogEvent(this, "OnCalloutResponse");

	if (window.external.calloutresponse == "Y")
	{
		// Write to the point parameter that will trigger the action to update the range values.
		this.DataValue("SLAnalogPoint.ACCEPTRNG") = 1;
		//this.disabled = true;
	}]]></script><script event="onclick" language="JScript"><![CDATA[	SL_LogEvent(this, "onclick");
	window.external.showCallout(this, "Are you sure you want to accept the Transmitter range values?", 1, 60);]]></script><script event="onmouseenter" language="JScript"><![CDATA[	this.style.textDecorationUnderline = true;]]></script><script event="onmouseleave" language="JScript"><![CDATA[	this.style.textDecorationUnderline = false;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="ACCEPTRNG,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxEditingMessage class="hvg.textbox.1 " style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 3.09%; FONT-FAMILY: arial; WIDTH: 29.8%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #404040; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 70.19%; TOP: 2.25%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:22;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:270;">(Inactivate&nbsp;channel to enable editing)</DIV>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaHi class="hsc.alpha.1 SL_Numeric_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 2.81%; FONT-FAMILY: arial; WIDTH: 7.06%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 73.06%; TOP: 23.38%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;styleClass:SL_Numeric_Normal;textColor:#404040;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[	var	numDecimals = SL_GetNumDecimals(this.value);

	this.numericDisplayFormat = "%." + String(numDecimals) + "f";

	if (this.value == alphaExtHi.value)
	{
		polylineTickExtHi.style.visibility = "visible";
		lineTickExtHi.style.visibility = "hidden";
	}
	else
	{
		polylineTickExtHi.style.visibility = "hidden";
		lineTickExtHi.style.visibility = "visible";
	}

	if (alphaHi.value != alphaURV.value)
	{
		lineURV_LoopCurrent.lineColor = statusDisplayScheme[3].lineColor;
		lineLoopCurrent_Hi.lineColor = statusDisplayScheme[3].lineColor;
	}
	else
	{
		lineURV_LoopCurrent.lineColor = statusDisplayScheme[0].lineColor;
		lineLoopCurrent_Hi.lineColor = statusDisplayScheme[0].lineColor;
	}]]></script><script event="onchange" language="JScript"><![CDATA[	SL_LogEvent(this, "onchange");

	window.external.showCallout(this, "Are you sure you want to change the Hi range value from " + this.currentValue + " to " + this.value + "?", 1, 60);

	// Store the newly entered value temporarily so that it can be set as the current value if the user confirms the action.
	alphaHi_temp = this.value;

	// Prevent the database from being updated with the entered value until the user confirms the action.
	this.CancelChange();
	window.event.returnValue = "false";]]></script><script event="OnCalloutResponse" language="JScript"><![CDATA[	SL_LogEvent(this, "OnCalloutResponse");

	if (window.external.calloutresponse == "Y")
	{
		this.value = alphaHi_temp;
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PVEUHI"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="-1"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/><class ID="HSC.ParameterFormat" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaLo class="hsc.alpha.1 SL_Numeric_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 2.81%; FONT-FAMILY: arial; WIDTH: 7.06%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 73.06%; TOP: 68.45%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;styleClass:SL_Numeric_Normal;textColor:#404040;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language=