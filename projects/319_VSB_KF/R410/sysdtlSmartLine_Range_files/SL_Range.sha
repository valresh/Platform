<DIV tabIndex=-1 id=textboxLabelPVClamping class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; CURSOR: hand; TEXT-DECORATION: ; HEIGHT: 2.39%; FONT-FAMILY: arial; WIDTH: 17.66%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 68.76%; TOP: 91.83%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:160;">PV Clamping</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelPVSource class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.39%; FONT-FAMILY: arial; WIDTH: 17.66%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 68.76%; TOP: 95.07%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:160;">PV Source</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelPV class="hvg.textbox.1  HSC.ScriptDataObject.1 " style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.39%; FONT-FAMILY: arial; WIDTH: 24.28%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #404040; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 72.95%; TOP: 78.3%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:17;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:220;">PV</DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var pVUnitCode = this.DataValue("SLAnalogPoint.HEU");	

	this.value = "PV (" + HART_GetShortSymbolFromStandardUnitCode(pVUnitCode) + ")";]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PVEXEULO"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HEU,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ovalPVStatus class="hvg.base.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 2.11%; FONT-FAMILY: Arial; WIDTH: 1.65%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 68.76%; TOP: 11.12%; BEHAVIOR: url(#HDXVectorFactory#oval) url(#HSCScriptDataBehavior) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="FillColor:#e0e0e0;fillColorBlink:False;HDXBINDINGID:-4;Height:15;LineColor:#e0e0e0;lineColorBlink:False;Width:15;"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var pvStatusCode = this.DataValue("SLAnalogPoint.PVSTS");
	var pvStatusInfo = SL_GetAnalogPVStatus(pvStatusCode);

	if (pvStatusInfo != "")
	{
		this.style.visibility = "visible";
		alphaPVStatus.style.visibility = "visible";
		this.lineColor = pvStatusInfo.lineColor;
		this.fillColor = pvStatusInfo.fillColor;
		alphaPVStatus.value = pvStatusInfo.statusString;
		polygonCursorPV.lineColor = pvStatusInfo.lineColor;
		polygonCursorPV.fillColor = pvStatusInfo.fillColor;
	}
	else
	{
		this.style.visibility = "hidden";
		alphaPVStatus.style.visibility = "hidden";
		polygonCursorPV.lineColor = statusDisplayScheme[0].lineColor;
		polygonCursorPV.fillColor = statusDisplayScheme[0].fillColor;		
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVSTS,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
