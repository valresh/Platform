<?xml version="1.0"?><shapefile version="1" type="sequence" title="" description="" useFirstShapeForBadValue="0" width="152px" height="202px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src="..\Styles\SysFaceplate.css"/></stylesheets><scripts><script event="" language="VBScript" id="0BE2C8FE-F2D1-4BA6-91B5-FD51D924D10A"><![CDATA[sub PermissiveInterlock(oSource)
dim oShape 
on error resume next
set oShape=oSource.parentnode.parentnode
dim iTop
iTop = 0
	if oShape.objects("ConAlpPer1").value = 0 then 
		oShape.objects("ConPergrp1").style.visibility = "inherit" : oShape.objects("ConPergrp1").style.pixeltop = iTop  : iTop = oShape.objects("ConPergrp1").style.pixeltop + 20
		oShape.objects("ConRectPermisive").style.pixelheight = iTop + 20
	else
		oShape.objects("ConPergrp1").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpPer6").value = 0 then
		if iTop = 0 then
			itop =  - 20
		end if
			oShape.objects("ConPergrp6").style.visibility = "inherit" : oShape.objects("ConPergrp6").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConPergrp6").style.pixeltop
			oShape.objects("ConRectPermisive").style.pixelheight = iTop + 45
	else
		oShape.objects("ConPergrp6").style.visibility = "Hidden"
	end if
end sub]]></script></scripts><parameters><parameter name="PointId" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
