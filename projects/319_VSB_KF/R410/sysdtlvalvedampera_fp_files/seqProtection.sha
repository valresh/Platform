<?xml version="1.0"?><shapefile version="1" type="sequence" title="" description="" useFirstShapeForBadValue="0" width="150px" height="202px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src="..\Styles\SysFaceplate.css"/></stylesheets><scripts><script event="" language="VBScript" id="56EDD823-BAEE-4A13-82D6-B6CFCA86FAB6"><![CDATA[sub PROTECTIVEInterlock(oSource)
dim oShape 
on error resume next
set oShape=oSource.parentnode.parentnode
dim iTop
iTop = 0
	if oShape.objects("ConAlpPro1").value = 1 then
		'oShape.objects("ConProgrp1").style.visibility = "inherit" :  iTop = oShape.objects("ConProgrp1").style.pixeltop + 45 'oShape.objects("ConProgrp1").style.pixeltop = iTop :
		oShape.objects("ConProgrp1").style.visibility = "inherit" : oShape.objects("ConProgrp1").style.pixeltop = iTop  : iTop = oShape.objects("ConProgrp1").style.pixeltop + 20
		oShape.objects("ConRectProtective").style.pixelheight = iTop + 20
	else
		oShape.objects("ConProgrp1").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpPro8").value = 1 then
		if iTop = 0 then
			itop =  - 20
		end if
'		oShape.objects("ConProgrp8").style.visibility = "inherit" : iTop = oShape.objects("ConProgrp8").style.pixeltop ' oShape.objects("ConProgrp8").style.pixeltop = iTop :
		oShape.objects("ConProgrp8").style.visibility = "inherit" : oShape.objects("ConProgrp8").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConProgrp8").style.pixeltop
		oShape.objects("ConRectProtective").style.pixelheight = iTop + 45
	else
		oShape.objects("ConProgrp8").style.visibility = "Hidden"
	end if
end sub]]></script></scripts><parameters><parameter name="PointId" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
