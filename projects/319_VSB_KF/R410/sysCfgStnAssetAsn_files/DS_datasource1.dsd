tart">12</property><property name="FileRefBitFieldWidth">4</property><property name="FileRefFile">2</property><property name="FileRefFlags">512</property><property name="FileRefFormat">5</property><property name="FileRefRecord">1</property><property name="FileRefWord">118</property><property name="ObjectType">1</property><property name="ParameterFormat">0</property><property name="PresentationType">2</property><property name="SecurityLevel">5</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="8" type="HMIPage.Generic" format="propertybag"><property name="AddressFlags">0</property><property name="AddressType">1</property><property name="CalloutElement"></property><property name="FileRefBitFieldStart">8</property><property name="FileRefBitFieldWidth">4</property><property name="FileRefFile">2</property><property name="FileRefFlags">512</property><property name="FileRefFormat">5</property><property name="FileRefRecord">1</property><property name="FileRefWord">118</property><property name="ObjectType">0</property><property name="ParameterFormat">0</property><property name="PresentationType">0</property><property name="SecurityLevel">5</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="9" type="HMIPage.Generic" format="propertybag"><property name="AddressFlags">0</property><property name="AddressType">240</property><property name="CalloutElement"></property><property name="ObjectType">0</property><property name="ParameterFormat">0</property><property name="PresentationType">0</property><property name="SecurityLevel">0</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="10" type="HMIPage.EntitySource" format="propertybag"><property name="AutoMigrate">0</property><property name="AuxFilter">(Type != 8) or (SubType != 1001) or (ItemNumber != 2)</property><property name="LinkAssetEntities">1</property><property name="StartLocation"></property><property name="SummaryType">0</property><property name="TemplateXML">&lt;TableTemplate&gt;&lt;FieldXML&gt;
  &lt;fields&gt;
   &lt;field id="Selected"/&gt;
   &lt;field id="NodeHandle" rowId="true"/&gt;
   &lt;field id="Depth"/&gt;
   &lt;field id="Expanded"/&gt;
   &lt;field id="NumChildren"/&gt;
   &lt;field id="EntityName"/&gt;
   &lt;field id="TagName"/&gt;
   &lt;field id="FullName"/&gt;
   &lt;field id="Description"/&gt;
   &lt;field id="RemoteType"/&gt;
   &lt;field id="SubType"/&gt;
   &lt;field id="ItemNumber"/&gt;
   &lt;field id="Redundant"/&gt;
   &lt;field id="FlexStationPermission(%RecordOffset%)"/&gt;
   &lt;field id="FlexStationPermissionMatchesDescendents(%RecordOffset%)"/&gt;
   &lt;field id="FlexStationPropagatedPermission(%RecordOffset%)"/&gt;
   &lt;field id="FlexStationPermAllowWrite(%RecordOffset%)"/&gt;
   &lt;field id="FlexStationPermAllowPropagatedWrite(%RecordOffset%)"/&gt;
   &lt;field id="Assignable"/&gt;
   &lt;field id="Flags"/&gt;
   &lt;field id="AssociatedAsset"/&gt;
   &lt;field id="IsAssocAssetSelected"/&gt;
  &lt;/fields&gt;
 &lt;/FieldXML&gt;&lt;XFormXML&gt;
  &lt;xforms&gt;
   &lt;defaultValue id="xfEmptyVariantToString" value="" type="string"/&gt;
   &lt;script id="xfIconImg" language="VBScript"&gt;
    Return = GetNodeImagePath(Value)
   &lt;/script&gt;
   &lt;script id="xfPermImg" language="VBScript"&gt;
    Return = GetPermissionImagePath(Value)
   &lt;/script&gt;
   &lt;script id="xfPadding" language="VBScript"&gt;
    Return = (Value - 1) * 16
   &lt;/script&gt;
   &lt;script id="xfPlusMinusImg" language="VBScript"&gt;
    if (Value(0) = 0) then
     Return = "Images/blank.gif"
    elseif (Value(1)) then
     Return = "Images/minus.gif"
    else
     Return = "Images/plus.gif"
    end if
   &lt;/script&gt;
   &lt;script id="xfPermissionVisible" language="VBScript"&gt;
    if( IsEmpty(Value) ) then
     Return = "hidden"
    else 
     Return = "visible"
    end if
   &lt;/script&gt;
   &lt;script id="xfPermissionDropdown" language="VBScript"&gt;
    if( IsEmpty(Value(0)) or (not Value(0)) Or EBINotAssignable(alphaServerType.value, Value(1)) ) then
     Return = "none"
    else 
     Return = ""
    end if
   &lt;/script&gt;
   &lt;script id="xfInvertAssignable" language="VBScript"&gt;
    if( IsEmpty(Value(0)) or (not Value(0)) Or EBINotAssignable(alphaServerType.value, Value(1)) ) then
     Return = true
    else
     Return = false
    end if
   &lt;/script&gt;
   &lt;script id="xfPermissionBorderLight" language="VBScript"&gt;
    if( IsEmpty(Value(0)) or (not Value(0)) Or EBINotAssignable(alphaServerType.value, Value(1)) ) then
     Return = ""
    else
     Return = "1px solid threedlightshadow"
    end if
   &lt;/script&gt;
   &lt;script id="xfPermissionBorderDark" language="VBScript"&gt;
    if( IsEmpty(Value(0)) or (not Value(0)) Or EBINotAssignable(alphaServerType.value, Value(1)) ) then
     Return = ""
    else
     Return = "1px solid threedshadow"
    end if
   &lt;/script&gt;
   &lt;script id="xfMatchColor" language="VBScript"&gt;
    if( IsEmpty(Value) or (Value) ) then
     Return = ""
    else
     Return = "lightgrey"
    end if
   &lt;/script&gt;
   &lt;script id="xfName" language="VBScript"&gt;
    Return = GetNodeDisplayName(Value)
   &lt;/script&gt;
   &lt;script id="xfTitle" language="VBScript"&gt;
    Return = GetItemTitle(Value)
   &lt;/script&gt;
   &lt;script id="xfOpacity" language="VBScript"&gt;
    if( IsEmpty(Value) or (Value) ) then
     Return = ""
    else
     Return = "alpha(opacity=50)"
    end if
   &lt;/script&gt;
   &lt;script id="xfHighlightBGColor" language="VBScript"&gt;
     if( IsEmpty(Value) or (Value) ) then
        Return = "darkblue"
     else
        Return = "white"
     end if
    &lt;/script&gt;            
    &lt;script id="xfHighlightFGColor" language="VBScript"&gt;
     if( (IsEmpty(Value(0)) or (Value(0))) or (IsEmpty(Value(1)) or (Value(1))) ) then
        Return = "white"
     else
        Return = "black"
     end if
     &lt;/script&gt;            
     &lt;script id="xfLowHighlightBGColor" language="VBScript"&gt;
      if( IsEmpty(Value(0)) or (not Value(0)) ) then
        if ( IsEmpty(Value(1)) or (not Value(1)) ) then
            Return = "white"
        else
            Return = "#15317E"
        end if
      end if
     &lt;/script&gt;   
  &lt;/xforms&gt;
 &lt;/XFormXML&gt;&lt;HTMLWrapperXML&gt;
  &lt;HTMLWrappers&gt;
   &lt;MenuItemWrapper&gt;
    &lt;Begin&gt;
     &amp;lt;div style="position: relative; width: 170px; padding-bottom: 2px; padding-top: 1px; padding-right: 5px;" onmouseenter="OnEnter_MenuItem(this)" onmouseleave="OnLeave_MenuItem(this)"&amp;gt;&amp;lt;span&amp;gt;
    &lt;/Begin&gt;
    &lt;End&gt;
     &amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;
    &lt;/End&gt;
   &lt;/MenuItemWrapper&gt;
   &lt;FilterAppliedWrapper&gt;
    &lt;Begin&gt;
     &amp;lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; margin-right: 1px; background-color: mediumblue; color: white; font-weight: bold;"&amp;gt;
    &lt;/Begin&gt;
    &lt;End&gt;
     &amp;lt;/span&amp;gt;
    &lt;/End&gt;
   &lt;/FilterAppliedWrapper&gt;
   &lt;SortAscIndicator&gt;
    &amp;amp;nbsp;&amp;lt;img src="Images/SortArrowUp.gif"&amp;gt;
   &lt;/SortAscIndicator&gt;
   &lt;SortDescIndicator&gt;
    &amp;amp;nbsp;&amp;lt;img src="Images/SortArrowDown.gif"&amp;gt;
   &lt;/SortDescIndicator&gt;
   &lt;GroupSeparator&gt;
    &amp;lt;div style="position:relative; width: 160px; height: 2px; overflow: hidden; display: block; border: 1px inset; margin: 3px;" &amp;gt;&amp;lt;/div&amp;gt;
   &lt;/GroupSeparator&gt;
  &lt;/HTMLWrappers&gt;
 &lt;/HTMLWrapperXML&gt;&lt;MenuGroupXML&gt;
  &lt;MenuGroups&gt;
  &lt;/MenuGroups&gt;
 &lt;/MenuGroupXML&gt;&lt;BaseFilterXML&gt;
  &lt;BaseFilterDef&gt;
  &lt;/BaseFilterDef&gt;
 &lt;/BaseFilterXML&gt;&lt;SortXML&gt;
  &lt;SortDef DefaultSortColumn="Tree" DefaultSortDir="asc"&gt;
   &lt;colref id="Tree" 
    SortAscString="EntityName asc"
    SortDescString="EntityName desc"
    SortDir="asc"
    SortOrder="1"/&gt;
  &lt;/SortDef&gt;
 &lt;/SortXML&gt;&lt;ReportTemplateXML&gt;&lt;/ReportTemplateXML&gt;&lt;ColumnStateXML&gt;
  &lt;state&gt;
   &lt;colref id="Tree" width="490" hidden="false" /&gt;
  &lt;/state&gt;
 &lt;/ColumnStateXML&gt;&lt;TableDefinitionXML&gt;
  &lt;table&gt;
   &lt;tableMenu/&gt;
   &lt;contextMenu/&gt;
   &lt;columns&gt;
    &lt;column id="Tree"&gt;
     &lt;title&gt;Tree&lt;/title&gt;
     &lt;action/&gt;
     &lt;menu/&gt;
     &lt;content&gt;
         &amp;lt;div noselect="" language="javascript" ondblclick="event.cancelBubble = this.noselect; return !this.noselect;" onmousedown="event.cancelBubble = this.noselect; return !this.noselect;" style="position: absolute; padding-top: 3px; width: 100%; height: 100%;" ExpandCollapseTrigger=0&amp;gt;
      &amp;lt;div language="javascript" style="position: relative; display: inline; padding-left: 2px;"
       onmousedown="if( event.button == 1 ) { this.parentElement.ExpandCollapseTrigger = 1; event.cancelBubble = true; }"&amp;gt;
       &amp;lt;img style="position: relative; top: -5px; width: 9px; height: 9px;" src="Images/blank.gif"/&amp;gt;
      &amp;lt;/div&amp;gt;
      &amp;lt;div matching="" permLocal="" permPropagated="" allowWrite="" allowPropagatedWrite="" language="javascript" onclick="if( !this.parentElement.noselect ) ShowPermissionMenu(0, this.offsetHeight + 4, this);"
         style="position: relative; 
             top: -3px; 
             height: 17px; 
             width: 30px; 
             overflow: hidden; 
             display: inline; 
             margin: 1px; 
             text-align: center;"&amp;gt;
          &amp;lt;img src="Images/blank.gif" style="position: relative; left: 0px; bottom: 0px; width: 13px; height: 13px;" /&amp;gt;
       &amp;lt;DIV style="BEHAVIOR: url(#HDXVectorFactory#polygon);position: absolute; display: inline; overflow: hidden; height: 4px; width: 8px; bottom: 1px; right: 1px; " 
          hdxproperties="FillColor:#000000;LineStyle:0;points:100.000000 0.000000 0.000000 0.000000 50.000000 100.000000;"&amp;gt;
       &amp;lt;/DIV&amp;gt;
      &amp;lt;/div&amp;gt;
             &amp;lt;div style="position: relative; display: inline;"&amp;gt;
       &amp;lt;img style="position: relative; 
               top: -3px;
               left: 0px;
               width: 18px; 
               height: 18px; 
                z-index: 2;" 
        src="Images/blank.gif"/&amp;gt;
      &amp;lt;/div&amp;gt;
             &amp;lt;div style="position: relative; height: 100%; left: -2px; top: 1px; display: inline;"&amp;gt;&amp;lt;/div&amp;gt;
         &amp;lt;/div&gt;
     &lt;/content&gt;
     &lt;bindings&gt;
      &lt;in fields="Depth" properties="style.paddingLeft" xforms="xfPadding" /&gt;
      &lt;in fields="NumChildren;Expanded" properties="firstChild.firstChild.src" xforms="xfPlusMinusImg" /&gt;
      &lt;in fields="RemoteType;SubType;ItemNumber;Redundant;Flags" properties="lastChild.previousSibling.firstChild.src" xforms="xfIconImg" /&gt;
      &lt;in fields="EntityName;RemoteType;SubType;ItemNumber" properties="lastChild.innerText" xforms="xfName" /&gt;
      &lt;in fields="FullName;Description;AssociatedAsset" properties="title" xforms="xfTitle" /&gt;
      &lt;in fields="Assignable" properties="firstChild.nextSibling.style.visibility" xforms="xfPermissionVisible" /&gt;
      &lt;in fields="Assignable;TagName" properties="firstChild.nextSibling.style.borderRight;firstChild.nextSibling.style.borderBottom" xforms="xfPermissionBorderDark" /&gt;
      &lt;in fields="Assignable;TagName" properties="firstChild.nextSibling.style.borderTop;firstChild.nextSibling.style.borderLeft" xforms="xfPermissionBorderLight" /&gt;
      &lt;in fields="Assignable;TagName" properties="firstChild.nextSibling.lastChild.style.display" xforms="xfPermissionDropdown" /&gt;
      &lt;in fields="Assignable;TagName" properties="noselect" xforms="xfInvertAssignable" /&gt;
      &lt;in fields="Assignable" properties="firstChild.nextSibling.firstChild.style.filter;lastChild.previousSibling.firstChild.style.filter;lastChild.style.filter" xforms="xfOpacity" /&gt;
      &lt;in fields="FlexStationPermissionMatchesDescendents(%RecordOffset%)" properties="firstChild.nextSibling.matching" /&gt;
      &lt;in fields="FlexStationPermissionMatchesDescendents(%RecordOffset%)" properties="firstChild.nextSibling.style.backgroundColor" xforms="xfMatchColor"/&gt;
      &lt;in fields="FlexStationPermission(%RecordOffset%);AssociatedAsset" properties="firstChild.nextSibling.firstChild.src" xforms="xfPermImg" /&gt;
      &lt;in fields="FlexStationPermAllowWrite(%RecordOffset%)" properties="firstChild.nextSibling.allowWrite" /&gt;
      &lt;in fields="FlexStationPermAllowPropagatedWrite(%RecordOffset%)" properties="firstChild.nextSibling.allowPropagatedWrite" /&gt;
      &lt;in fields="Selected" properties="lastChild.style.backgroundColor" xforms="xfHighlightBGColor" /&gt;                        
      &lt;in fields="Selected;IsAssocAssetSelected" properties="lastChild.style.color" xforms="xfHighlightFGColor" /&gt;
      &lt;in fields="Selected;IsAssocAssetSelected" properties="lastChild.style.backgroundColor" xforms="xfLowHighlightBGColor" /&gt;
      &lt;out properties="firstChild.nextSibling.permLocal" fields="FlexStationPermission(%RecordOffset%)" /&gt;
      &lt;out properties="firstChild.nextSibling.permPropagated" fields="FlexStationPropagatedPermission(%RecordOffset%)" /&gt;
      &lt;out properties="ExpandCollapseTrigger" fields="Expanded"/&gt;
     &lt;/bindings&gt;
    &lt;/column&gt;
   &lt;/columns&gt;
  &lt;/table&gt;
 &lt;/TableDefinitionXML&gt;&lt;/TableTemplate&gt;</property><property name="Version">4.5</property><property name="WaitForInit">0</property><property name="WaitForSelectionList">0</property></dataobject><dataobject id="11" type="HMIPage.PushButton" format="propertybag"><property name="Flags">0</property><property name="PBActionType">3</property><property name="RepeatFlag">0</property><property name="SecurityLevel">2</property><property name="StationIndex">0</property><property name="TaskLrn">21</property><property name="TaskParam1">7</property><property name="TaskParam2">sysCfgStnAssetProfiles</property><property name="TaskParam3">0</property><property name="TaskParam4">0</property><property name="version">1.3</property></dataobject><dataobject id="12" type="HMIPage.Generic" format="propertybag"><property name="AddressFlags">1</property><property name="AddressType">1</property><property name="CalloutElement"></property><property name="FileRefBitFieldStart">14</property><property name="FileRefBitFieldWidth">2</property><property name="FileRefFile">2</property><property name="FileRefFlags">512</property><property name="FileRefFormat">5</property><property name="FileRefRecord">1</property><property name="FileRefWord">1</property><property name="ObjectType">0</property><property name="ParameterFormat">0</property><property name="PresentationType">0</property><property name="SecurityLevel">0</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="14" type="HMIPage.PushButton" format="propertybag"><property name="Flags">0</property><property name="PBActionType">1</property><property name="RepeatFlag">0</property><property name="SecurityLevel">2</property><property name="StationIndex">0</property><property name="TaskLrn">21</property><property name="TaskParam1">1</property><property name="TaskParam2">syscfgassetprofsumm</property><property name="TaskParam3">0</property><property name="TaskParam4">0</property>