<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="930px" height="702px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><parameters><parameter name="TagName" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=sd class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 2.56%; FONT-FAMILY: Arial; WIDTH: 5.16%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ff0000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 60.43%; TOP: 22.22%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	'Determine the value for CABLESTS
	if me.qualityGood("TagName.CABLESTS") then
		Dim value
		value = me.DataValue("TagName.CABLESTS")
		txtCABLESTSalt.textColor = vbBlack
		if value = 0 then
			txtCABLESTSalt.value = "NULL STATE"
		elseif value = 1 then
			txtCABLESTSalt.value = "OK"
		elseif value = 2 then
			txtCABLESTSalt.value = "A SUSPECT"
		elseif value = 3 then
			txtCABLESTSalt.value = "B SUSPECT"
		elseif value = 4 or value = 7 or value = 8 then
			'If A is SUSPECT while B is MARGINAL (or vice-versa), then just say they are both SUSPECT
			'We don't have room to say "Cable A Suspect & Cable B Marginal"
			txtCABLESTSalt.value = "A & B SUSPECT"
		elseif value = 5 then
			txtCABLESTSalt.value = "A MARGINAL"
		elseif value = 6 then
			txtCABLESTSalt.value = "B MARGINAL"
		elseif value = 9 then
			txtCABLESTSalt.value = "A & B MARGINAL"
		else
			'It should be impossible to ever see this since 0-9 are the only valid values
			txtCABLESTSalt.value = ""
		end if
	else
		'Emulate the behavior of the other points when data is loading
		txtCABLESTSalt.textColor = vbRed
		txtCABLESTSalt.value = "--------"
	end if

	'Determine the value for ACTIVCBL
	if me.qualityGood("TagName.ACTIVCBL") then
		txtACTIVCBLalt.textColor = vbBlack
		if me.DataValue("TagName.ACTIVCBL") = 0 then
			txtACTIVCBLalt.value = "A"
		elseif me.DataValue("TagName.ACTIVCBL") = 1 then
			txtACTIVCBLalt.value = "B"
		else
			txtACTIVCBLalt.value = ""
		end if
	else
		'Emulate the behavior of the other points when data is loading
		txtACTIVCBLalt.textColor = vbRed
		txtACTIVCBLalt.value = "--------"
	end if

	'Determine the value for MODE
	if me.qualityGood("TagName.$NIMMODE") then
		txtMODEalt.textColor = vbBlack
		if me.DataValue("TagName.$NIMMODE") = 0 then
			txtMODEalt.value = "PRIMARY"
		elseif me.DataValue("TagName.$NIMMODE") = 1 then
			txtMODEalt.value = "SECONDARY"
		elseif me.DataValue("TagName.$NIMMODE") = 2 then
			txtMODEalt.value = "NOT REDUNDANT"
		else
			txtMODEalt.value = ""
		end if
	else
		'Emulate the behavior of the other points when data is loading
		txtMODEalt.textColor = vbRed
		txtMODEalt.value = "--------"
	end if

	'We need to manually set the value for $AUTOSAV because we're modifying the standard behavior with a callout to enable/disable
	if me.qualityGood("TagName.$AUTOSAV") then
		alpAUTOSAV.textColor = vbBlack
		alpAUTOSAV.value = me.DataValue("TagName.$AUTOSAV")
	else
		'Emulate the behavior of the other points when data is loading
		alpAUTOSAV.textColor = vbRed
		alpAUTOSAV.value = "--------"
	end if

	'Show the ENB Group only if one or more of the values is greater than zero
	dim isNonZero
	isNonZero = false
	if me.qualityGood("TagName.$EPNI2TX") then
		if me.DataValue("TagName.$EPNI2TX") > 0 then
			isNonZero = true
		end if
	end if
	if me.qualityGood("TagName.$EPNI2RX") then
		if me.DataValue("TagName.$EPNI2RX") > 0 then
			isNonZero = true
		end if
	end if
	if me.qualityGood("TagName.$P2PU2EU") then
		if me.DataValue("TagName.$P2PU2EU") > 0 then
			isNonZero = true
		end if
	end if
	if me.qualityGood("TagName.$P2PEU2U") then
		if me.DataValue("TagName.$P2PEU2U") > 0 then
			isNonZero = true
		end if
	end if
	if isNonZero then
		grpEMB.style.visibility = "Inherit"
	end if

	'Virtual support
	if sd.QualityGood("Tagname.ISVIRTUALPLATFORM") then
		if sd.DataValue("Tagname.ISVIRTUALPLATFORM") = 1 then
			grpHWCable.style.visibility = "Hidden"
		else
			grpHWCable.style.visibility = "Inherit"
		end if
	else 
		grpHWCable.style.visibility = "Inherit"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="ACTIVCBL,CABLESTS,$NIMMODE,$EPNI2TX,$EPNI2RX,$P2PU2EU,$P2PEU2U,$AUTOSAV,ISVIRTUALPLATFORM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,1,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,0,60,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,,,,,,"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><group><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=alpNODMAXC title="" class="hsc.alpha.1 " style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 8.92%; FONT-FAMILY: arial; WIDTH: 62.14%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 37.38%; TOP: 89.28%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%.0f;printDisplayValue:9999.99;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="$NODMAXC"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="V