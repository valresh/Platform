	sNGPASTOR = "TagName.NGPASTOR(" & me.value & ")"
	sNGPAGSDE = "TagName.NGPAGSDE(" & me.value & ")"

	txtLCNIndexA.value = "(" & me.value & ")"
	txtLCNIndexB.value = "(" & me.value & ")"
	txtLCNIndexC.value = "(" & me.value & ")"
	txtNGPAREADVal.value = sdx.DataValue(sNGPAREAD)
	txtNGPASTORVal.value = sdx.DataValue(sNGPASTOR)
	txtNGPAGSDEVal.value = sdx.DataValue(sNGPAGSDE)]]></script><script event="onactivate" language="VBScript"><![CDATA[	'populate LCN Index combobox with choices 0..255
	dim counter
	for counter = 0 to 96
