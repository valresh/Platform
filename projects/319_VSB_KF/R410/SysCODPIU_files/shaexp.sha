<DIV tabIndex=-1 id=DCConAlpState0 class="hvg.textbox.1 HSC.ScriptDataObject.1" style="OVERFLOW: hidden; FONT-SIZE: 12pt; TEXT-DECORATION: ; HEIGHT: 5.71%; FONT-FAMILY: Arial; WIDTH: 60%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 19.33%; TOP: 33.14%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:20;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:90;">LOWER</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[if me.QualityGood("TagName.HRBALG_HLPIUDCA.PVEM") then
	if ucase(me.DataValue("TagName.HRBALG_HLPIUDCA.PVEM")) = ucase(me.value) then
		DCshpPV0.value = 3
	else
		DCshpPV0.value = 2
	end if
end if
if me.QualityGood("TagName.HRBALG_HLPIUDCA.OPEM") then
	if ucase(me.DataValue("TagName.HRBALG_HLPIUDCA.OPEM")) = ucase(me.value) then
