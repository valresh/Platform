end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="HRBALG_HLPIUACA.PATHBRKSTS"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_HLPIUACA.PATHBRKSTS,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN tabIndex=-1 id=ACConIndSP title="" class="hsc.indicator.1 HSC.ScriptDataObject.1" style="OVERFLOW: hidden; FONT-SIZE: 0pt; TEXT-DECORATION: none; BORDER-TOP: transparent 1px; HEIGHT: 27.71%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 1px; WIDTH: 8.66%; BORDER-BOTTOM: transparent 1px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 64.66%; BORDER-LEFT: transparent 1px; TOP: 25.42%; BEHAVIOR: url(#HSCIndicatorBehavior) url(#BindingBehavior) url(#HSCScriptDataBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: transparent" hdxproperties="borderStyle:inset;borderWidth:1px;fillColor:transparent;fillColorBlink:0;fillDirection:0;fillStyle:8;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;levelFillColor:#00bf00;levelFillColorBlink:0;lineColor:transparent;lineColorBlink:0;" HDX_LOCK="-1" globalscripts printValuePercent="33" printFillColor="transparent" printLevelFillColor="#00bf00" printInverse="false" SHORTCUTMENUFILE SHORTCUTMENUCUSTOM="1"></SPAN>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("Tagname.HRBALG_HLPIUACA.SPEM") then
	me.value = me.DataValue("Tagname.HRBALG_HLPIUACA.SPEM")
end if

if not me.QualityBad("Tagname.DACA.PVEUHI")and not me.QualityBad("Tagname.DACA.PVEULO")then
	 me.rangeHi = me.DataValue("Tagname.DACA.PVEUHI")
	 me.rangeLo = me.DataValue("Tagname.DACA.PVEULO")
else
	me.rangeHi = 100
	me.rangeLo = 0
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_HLPIUACA.SPEM,DACA.PVEUHI,DACA.PVEULO,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN tabIndex=-1 id=ACConIndPV title="" class="hsc.indicator.1 HSC.ScriptDataObject.1" style="OVERFLOW: hidden; FONT-SIZE: 0pt; TEXT-DECORATION: none; BORDER-TOP: transparent 1px; HEIGHT: 27.71%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 1px; WIDTH: 12.66%; BORDER-BOTTOM: transparent 1px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 72%; BORDER-LEFT: transparent 1px; TOP: 25.42%; BEHAVIOR: url(#HSCIndicatorBehavior) url(#BindingBehavior) url(#HSCScriptDataBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: transparent" hdxproperties="borderStyle:inset;borderWidth:1px;fillColor:#ffffff;fillColorBlink:0;fillDirection:0;fillStyle:0;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;levelFillColor:#00bfbf;levelFillColorBlink:0;lineColor:black;lineColorBlink:0;" HDX_LOCK="-1" globalscripts printValuePercent="33" printFillColor="#ffffff" printLevelFillColor="#00bfbf" printInverse="false" SHORTCUTMENUCUSTOM="0"></SPAN>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("Tagname.HRBALG_HLPIUACA.PVEM") then
	 me.value =  me.DataValue("Tagname.HRBALG_HLPIUACA.PVEM")
end if
if not me.QualityBad("Tagname.DACA.PVEUHI")and not me.QualityBad("Tagname.DACA.PVEULO")then
	 me.rangeHi = me.DataValue("Tagname.DACA.PVEUHI")
	 me.rangeLo = me.DataValue("Tagname.DACA.PVEULO")
else
