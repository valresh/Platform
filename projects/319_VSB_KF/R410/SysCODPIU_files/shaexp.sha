if not me.QualityBad("Tagname.HRBALG_HLPIUACA.PATHBRKSTS") then
	if me.DataValue("Tagname.HRBALG_HLPIUACA.PATHBRKSTS") = 1 then
		me.style.visibility = "Hidden"
	else
		me.style.visibility = "Inherit"
	end if
else
