<DIV tabIndex=-1 id=DCAlarmState title="Bad Quality, Urgent, Active, Acknowledged" class="hsc.alarmstate.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 5.71%; FONT-FAMILY: Arial; WIDTH: 13.33%; WHITE-SPACE: nowrap; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 3.33%; TOP: 57.71%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="acknowledged:True;HDXBINDINGID:-4;priority:3;quality:0;rtn:False;showDisableIcon:True;showJournalOnlyIcon:False;showTooltip:True;sizeableIcon:False;staticIcon:False;" ObjectType="6"></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[if me.QualityGood("TagName.DEVCTLA.HIALM.TYPE") and me.DataValue("TagName.DEVCTLA.HIALM.TYPE") <> 0 then
	me.style.visibility = "Inherit"
else
