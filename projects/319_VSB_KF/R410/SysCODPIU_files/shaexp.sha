if not me.QualityBad("Tagname.HRBALG_PIUAIA.SPEM") then
	me.value = me.DataValue("Tagname.HRBALG_PIUAIA.SPEM")
end if

if not me.QualityBad("Tagname.DACA.PVEUHI")and not me.QualityBad("Tagname.DACA.PVEULO")then
	 me.rangeHi = me.DataValue("Tagname.DACA.PVEUHI")
	 me.rangeLo = me.DataValue("Tagname.DACA.PVEULO")
else
	me.rangeHi = 100
	me.rangeLo = 0
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_PIUAIA.SPEM,DACA.PVEUHI,DACA.PVEULO,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN tabIndex=-1 id=AIConIndPV title="" class="hsc.indicator.1 HSC.ScriptDataObject.1" style="OVERFLOW: hidden; FONT-SIZE: 0pt; TEXT-DECORATION: none; BORDER-TOP: transparent 1px; HEIGHT: 27.71%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 1px; WIDTH: 12.66%; BORDER-BOTTOM: transparent 1px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 72%; BORDER-LEFT: transparent 1px; TOP: 25.42%; BEHAVIOR: url(#HSCIndicatorBehavior) url(#BindingBehavior) url(#HSCScriptDataBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: transparent" hdxproperties="borderStyle:inset;borderWidth:1px;fillColor:#ffffff;fillColorBlink:0;fillDirection:0;fillStyle:0;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;levelFillColor:#00bfbf;levelFillColorBlink:0;lineColor:black;lineColorBlink:0;" HDX_LOCK="-1" globalscripts printValuePercent="33" printFillColor="#ffffff" printLevelFillColor="#00bfbf" printInverse="false" SHORTCUTMENUCUSTOM="0"></SPAN>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("Tagname.HRBALG_PIUAIA.PVEM") then
	 me.value =  me.DataValue("Tagname.HRBALG_PIUAIA.PVEM")
end if
if not me.QualityBad("Tagname.DACA.PVEUHI")and not me.QualityBad("Tagname.DACA.PVEULO")then
	 me.rangeHi = me.DataValue("Tagname.DACA.PVEUHI")
	 me.rangeLo = me.DataValue("Tagname.DACA.PVEULO")
else
	me.rangeHi = 100
	me.rangeLo = 0
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_PIUAIA.PVEM,DACA.PVEUHI,DACA.PVEULO,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=AIConAlpPVEUHi title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 " style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 10pt; HEIGHT: 17.24%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 78.12%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 8.33%; BORDER-LEFT-STYLE: none; BORDER-RIGHT-COLOR: transparent; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:none;borderWidth:;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numberOfChars:12;numericDisplayFormat:%.2f;styleClass:;textColor:#000000;textColorBlink:False;" HD