end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::tagname%},{%point::tagname%},{%point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="STATE3,PVSTATES(2),STATETEXT(2),"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,1,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN tabIndex=-1 id=DOConCboOP title="" class="hsc.combo.1 " style="OVERFLOW: hidden; FONT-SIZE: 12pt; BORDER-TOP: transparent 2px; HEIGHT: 7.97%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 2px; WIDTH: 73.33%; BORDER-BOTTOM: transparent 2px; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #00ffff; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: right; PADDING-TOP: 2px; PADDING-LEFT: 2px; LEFT: 24%; BORDER-LEFT: transparent 2px; TOP: 73.91%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: #000000; TEXT-INDENT: 2px" HDX_LOCK="-1" hdxproperties="borderStyle:Inset;borderWidth:2;fillColor:#000000;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:True;lineColor:#000000;lineColorBlink:False;styleClass:;textColor:#00ffff;textColorBlink:False;" printValue="Combobox">Combobox</SPAN>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error Resume Next
if strComp(DOConCboOP.value , DOConAlpStateText1.value) = 0 then
	DOConAlpStateText1.textColor = RGB(0, 255, 68)
	DOConAlpStateText2.textColor = RGB(0, 255, 255)
	DOConAlpStateText3.textColor = RGB(0, 255, 255)
elseif strComp(DOConCboOP.value , DOConAlpStateText2.value) = 0 then
	DOConAlpStateText1.textColor = RGB(0, 255, 255)
	DOConAlpStateText2.textColor = RGB(0, 255, 68)
	DOConAlpStateText3.textColor = RGB(0, 255, 255)
elseif strComp(DOConCboOP.value , DOConAlpStateText3.value) = 0 then
	DOConAlpStateText1.textColor = RGB(0, 255, 255)
	DOConAlpStateText2.textColor = RGB(0, 255, 255)
	DOConAlpStateText3.textColor = RGB(0, 255, 68)
else
	DOConAlpStateText1.textColor = RGB(0, 255, 255)
	DOConAlpStateText2.textColor = RGB(0, 255, 255)
	DOConAlpStateText3.textColor = RGB(0, 255, 255)
