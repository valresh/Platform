	dim bRet
	bRet = sd.SetDataValueSynchronous ("tagname.PVNORMAL", me.value)	'wait for write!
	if bRet = False then
		me.innerText = sd.DataValue("tagname.PVNORMAL") 			'reassign in case write failed!
	end if]]></script><script event="onmousedown" language="VBScript"><![CDATA[  me.ResetContent
  me.AddString sd.DataValue("tagname.STATETXT(0)")
  me.AddString sd.DataValue("tagname.STATETXT(1)")
  me.AddString sd.DataValue("tagname.STATETXT(2)")
  me.AddString "NONE"
  me.value = sd.DataValue("tagname.PVNORMAL")]]></script></scripts></html><binding/></element><html><content><![CDATA[
