type="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="Hsc.ComboBox" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=GrpP2 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 28.57%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 71.42%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:184;" HDX_LOCK="-1"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=GrpPermissives class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 10.93%; WIDTH: 26.21%; POSITION: absolute; LEFT: 35.75%; TOP: 38.08%; BEHAVIOR: url(#HDXVectorFactory#group); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;Height:56;lineColorBlink:False;Width:184;"></DIV>]]></content></html></group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" style="FONT-SIZE: 7pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 3.32%; FONT-FAMILY: Small Fonts; WIDTH: 8.54%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ff0000; TEXT-ALIGN: center; LEFT: 42.45%; TOP: 24.02%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:17;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:60;">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim bTPNServerOK
	on error resume next

	if bVisibilityUpdated = FALSE then
		GrpOverridesHeader.style.visibility = "Inherit"
		GrpPointDataHeader.style.visibility = "Inherit"
		GrpGeneralHeader.style.visibility = "Inherit"				
		GrpPermissivesHeader.style.visibility = "Inherit"
		GrpAlarmLimitsHeader.style.visibility = "Inherit"
		GrpRangeLimitsHeader.style.visibility = "Inherit"
	end if

	if not sd.QualityGood("tagname.NODE_NO") then
		txtLoading.value = "** Missing TPN Data **"
		txtLoading.style.visibility = "Inherit"
		bTPNServerOK = FALSE
	else
		bTPNServerOK = TRUE
		txtLoading.style.visibility = "Hidden"
	end if

'GrpGeneral

	if not sd.QualityGood("tagname.CONTCUT") then
		GrpCONTCUT.style.visibility = "Hidden"
	else
		GrpCONTCUT.style.visibility = "Visible"
	  	if sd.DataValue("tagname.CONTCUT") then
	    	txt_CONTCUT.value = "ON"
	  	else 
	  		txt_CONTCUT.value = "OFF"
	  	end if
	end if
	if not sd.QualityGood("tagname.SVEUDESC") then
		GrpSVEUDESC.style.visibility = "Hidden"
	else
		GrpSVEUDESC.style.visibility = "Visible"
		param_SVEUDESC.value = sd.DataValue("tagname.SVEUDESC")
	end if
	if not sd.QualityGood("tagname.KEYWORD") then
		GrpKEYWORD.style.visibility = "Hidden"
	else
