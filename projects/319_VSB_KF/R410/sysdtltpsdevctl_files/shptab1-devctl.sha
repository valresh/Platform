	bVisibilityUpdated = TRUE
	call UpdateMainGroups]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVAUTO,PVSOURCE,PVNORMAL,FBTIME,CMDFALTM,SVTV,SI0,I1,I0,I2,PTEXECST,ALENBST,NMODATTR,PNTFORM,PERIOD,CONTCUT,SVEUDESC,ENT_TYPE,NODE_NO,NTWKNUM,NODENUM,NODETYP,SLOTNUM,P1,P0,P2,SVHHTP,SVHITP,SVEUHI,SVEULO,STATETXT(0),STATETXT(1),STATETXT(2),$MODESEL(5),REDTAG,SVDESC,BYPASS,STSMSG,SECVAR,SVHHPR,SVHIPR,KEYWORD,NOLINPTS,L(1).external,L(2).external,L(3).external,L(4).external,L(5).external,L(6).external,L(7).external,L(8).external,L(9).external,L(10).external,L(11).external,L(12).external,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" valu