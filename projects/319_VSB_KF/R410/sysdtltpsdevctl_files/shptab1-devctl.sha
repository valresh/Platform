  me.AddString "NOTCONFG"
  me.AddString "ACTIVE"
  me.AddString "INACTIVE"
  me.AddString "READY"
  me.AddString "DONE"
  me.AddString "WAITING"
  me.value = sd.DataValue("tagname.PTEXECST")]]></script><script event="onchange" language="VBScript"><![CDATA[	on error resume next

	dim bRet
	bRet = sd.SetDataValueSynchronous ("tagname.PTEXECST", me.value)	'wait for write!
