                WIDTH: 150px;" 
                tabIndex=0 
                hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;inverseLogic:0;textColorBlink:False;">
                <INPUT tabIndex=0 type=checkbox></INPUT>
                <SPAN>ConsoleStationLicence</SPAN>
              </SPAN>]]>
            </content>
            <scripts>
              <script event="onupdate" language="JavaScript">
                <![CDATA[
                  var newValue = ConsoleStationLicence.value
		  if (newValue=="1")
		  {
			newValue="True";
		  }
		  else
		  {
			newValue="False";
		  }
                  var oldValue = ConsoleStationLicence.getAttribute("OldValue");
                  if (oldValue == null || oldValue != newValue)
