        <html>
          <content>
            <![CDATA[<DIV id="SystemDisplayContainer" class="hvg.group.1" 
              style="BEHAVIOR: url(#HDXVectorFactory#group);
                    HEIGHT: 849px;
                    LEFT: 0px;                    
                    POSITION: absolute;
                    overflow: hidden; 
                    TOP: 0px; 
                    WIDTH: 1276px;" 
              tabIndex="-1" 
              hdxproperties="fillColorBlink:False;Height:849;lineColorBlink:False;Width:1276;">
              <div id="LeftBar" class="NoExpressions" style="padding: 0px;">
	              <div id="TopLeft" class="TopLeft">
                  <a id="OperatorsMenuButton"
                      class="DropDown"
                      href=""
		      style ="padding-left: 2px;text-align:left;"
                      onclick="javascript: try{ ToggleDropDownMenu(OperatorsMenu, this); return false; } catch(e){}"
                      onmouseleave="javascript: try{ if (OperatorsMenu.currentStyle.display.toLowerCase() == 'block') { ToggleDropDownMenu(OperatorsMenu, this);}  return false; } catch(e){}">
			                <img id="TopLeftIcon" src="" style="display: none;"/>
                      <span id="TopLeftTitle"><span style="display: none;">[Menu Icon and Title]</span></span>
                  </a>
                </div>
		            <div id="NavPane" class="NavPane">
                  <div style="display: none;">
                    [Menu from {%Value::MenuXML%}]
                  </div>
                </div>
	            </div>
              <div id="OperatorsMenuContainer" class="popup">
                <div id="OperatorsMenu" class="NavPane"
                    style="position: absolute; display: none;
                            left: expression(OperatorsMenuButton.currentStyle.marginLeft);
                            top: expression(OperatorsMenuButton.offsetTop + OperatorsMenuButton.offsetHeight);
                            width: expression(OperatorsMenuButton.offsetWidth); z-index: 100;"
                    MenuXML="OperatorsMenu.xml"
                    onmouseenter ="javascript: try{ ToggleDropDownMenu(OperatorsMenu, OperatorsMenuButton); return false; } catch(e){}"
                    onmouseleave = "javascript: try{ if (OperatorsMenu.currentStyle.display.toLowerCase() == 'block') { ToggleDropDownMenu(OperatorsMenu, OperatorsMenuButton);}           return false; } catch(e){}">
                </div>
              </div>
              <div id="RightBar" class="NoExpressions">
	              <div id="TitleBarBackground" class="TitleBar" style="padding-left: 25px; padding-top: 10px;">
                  <span style="display: none;">[Display Title shown = '{%Value::ShowDisplayTitle%}']</span>
                  &nbsp;
                </div>
	              <div id="TabSetBackground" class="TabSet">
                  <div style="display: none;">[Tabs shown = '{%Value::ShowTabs%}']</div>
             		  <v:roundrect id="PageEdge" strokecolor="#FFFFFF" fillcolor="#FFFFFF" arcsize="0.5">
                  </v:roundrect>
                </div>
	              <div id="DisplayAreaBackground" class="NoExpressions">
	                <div id="ActionBarBackground" class="ActionBar">
                    <div style="display: none; color: red;">
                      [Action Bar shown = '{%Value::ShowActionBar%}']
                    </div>
                  </div>
                  <div id="DetailsAreaBackground" class="DetailsArea"  style="padding: 0px;">
                    <TABLE style="BORDER-BOTTOM: medium none; POSITION: absolute; BORDER-LEFT: medium none; WIDTH: 890px; DISPLAY: none; TABLE-LAYOUT: fixed; HEIGHT: 100%; BORDER-TOP: medium none; TOP: 0px; BORDER-RIGHT: medium none; LEFT: 47px" id=PositionGrid cellSpacing=0 cellPadding=0>
                      <STYLE>td { width: 58px; background: url(".\Images\margin_bg.gif") #ffffff; } td.layout_column { width: 100px; background: url(".\Images\column_bg.gif") #eeeeee; }</STYLE>
                      <TBODY>
						<TR>
                          <TD class=layout_column>&nbsp;</TD>
                          <TD>&nbsp;</TD>
                          <TD class=layout_column>&nbsp;</TD>
                          <TD>&nbsp;</TD>
                          <TD class=layout_column>&nbsp;</TD>
                          <TD>&nbsp;</TD>
                          <TD class=layout_column>&nbsp;</TD>
                          <TD>&nbsp;</TD>
                          <TD class=layout_column>&nbsp;</TD>
                          <TD>&nbsp;</TD>
                          <TD class=layout_column>&nbsp;</TD>
                        </TR>
                      </TBODY>
                    </TABLE>
                  </div>
                </div>
              </div>
            </DIV>]]>
          </content>
        </html>
      </group>
