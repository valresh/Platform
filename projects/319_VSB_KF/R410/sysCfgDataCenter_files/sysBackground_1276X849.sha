		<element>
          <html>
            <content>
              <![CDATA[<SPAN id="ConsoleStationLicence" class="hsc.checkbox.1"  
                style="BEHAVIOR: url(#HSCCheckBoxBehavior) url(#BindingBehavior);  
                BOTTOM: 0%;
                HEIGHT: 20px; 
