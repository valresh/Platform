                </SPAN>]]>
            </content>
            <scripts>
              <script event="onupdate" language="JavaScript">
                <![CDATA[
                  var newValue = DVMInstalled.value
				 if (newValue=="1")
				{
					newValue="True";
				}
				else
				{
					newValue="False";
				}
                  var oldValue = DVMInstalled.getAttribute("OldValue");
                  if (oldValue == null || oldValue != newValue)
                  {
                    DVMInstalled.setAttribute("OldValue", newValue);
                    licenceOverrides = "DVM" + "Installed=" + newValue; // Literal is split to avoid name-substitution when shape is loaded.       
                    NavPane.setAttribute("LicenceValues",  licenceOverrides);
                    NavPane.className = "NavPane NavMenu";
                    OperatorsMenu.setAttribute("LicenceValues",  licenceOverrides);
                    OperatorsMenu.className = "NavPane NavMenu";
                  }
                ]]>
              </script>
            </scripts>
          </html>
