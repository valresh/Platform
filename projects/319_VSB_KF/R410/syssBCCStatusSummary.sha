<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="660px" height="42px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[	Call UpdateIcons("Page_onshapeload", me)]]></script><script event="" language="VBScript" id="AC6D1B60-B849-43B2-9888-63EC15DC3C54"><![CDATA[option explicit

sub UpdateIcons(strSource, elemShp)
	dim cBCC
	dim cNodes
	dim cRunning, cStopped
	dim cSynched, cNotSynched
	dim nSysStsBCC, nSysStsBorA
	dim iBCC
	dim iSvr
	dim nCPUStatus, nLNKStatus, strObject
	dim obj

	' get number of implemented BCCs
	set obj = elemShp.objects("txtmaxBCC")
	cBCC = 0
	if isobject(obj) then
		if obj.innertext <> "NaN" then
			if isnumeric(obj.value) then
				cBCC = clng(obj.value)
			else
				cBCC = -1
			end if
		else
			cBCC = -2
		end if
	else
		cBCC = -3
	end if
	' cap BCCs to 5 as we only have data elements to BCCSTS record 5 in shape
	if cBCC > 5 then 
		cBCC = 5
	end if

	elemShp.objects("txtRunning").value = "???"
	elemShp.objects("txtSynched").value = "???"

	' check if any BCCs
	if cBCC <= 0 then
		' no BCCs so hide this control and exit
		elemShp.objects("grpMain").style.visibility = "hidden"
		elemShp.objects("txtRunning").innerText= "0"
		elemShp.objects("txtSynched").innerText= "0"
		elemShp.objects("shpFailMargOKRunning").value = 3
		elemShp.objects("shpFailMargOKSynched").value = 3
		exit sub
	end if

	' initialize counts
	cNodes = cBCC * 2
	cRunning = 0
	cStopped = 0
	cSynched = 0
	cNotSynched = 0

	' get current primary details
	set obj = elemShp.objects("txtnBCC")
	nSysStsBCC = -1
	if isobject(obj) then
		if isnumeric(obj.value) then
			nSysStsBCC = clng(obj.value)
		end if
	end if

	set obj = elemShp.objects("txtnBorA")
	nSysStsBorA = -1
	if isobject(obj) then
		if isnumeric(obj.value) then
			nSysStsBorA = clng(obj.value)
		end if
	end if


	' determine number of nodes that are running and synched
	' by looping through all the records
	for iBCC = 0 to cBCC
		' and by looping through all the servers in those records
		for iSvr = 0 to 1

			' process CPUSTS from BCCSTS
			strObject = "CPUSTS" & iBCC 
			if iSvr = 0 then
				strObject = strObject & "A"
			else
				strObject = strObject & "B"
			end if
			nCPUStatus = elemShp.objects("txt" & strObject).value

			' check running flag in CPUSTS
			if (nCPUStatus and &h4000) <> 0 then
				cRunning = cRunning + 1
			else
				cStopped = cStopped + 1
			end if

			' process LNKSTS
			if  iBCC = nSysStsBCC and iSvr = nSysStsBorA then
				' this is the current primary server so don't need to check LNKSTS
			else
				' this is not the current primary server so use LNKSTS from BCCSTS
				strObject = "LNKSTS" & iBCC 
				if iSvr = 0 then
					strObject = strObject & "A"
				else
					strObject = strObject & "B"
				end if
				nLNKStatus = elemShp.objects("txt" & strObject).value

				' check synched flag in LNKSTS
				if (nLNKStatus and &h00000400) <> 0 then
					cSynched = cSynched + 1
				else
					cNotSynched = cNotSynched + 1
				end if
			end if

		next 'iSvr
	next 'iBCC

	' update count elements
	elemShp.objects("txtRunning").style.visibility = "hidden"
	elemShp.objects("txtRunning").value = cRunning
	elemShp.objects("txtRunning").style.visibility = "inherit"
	elemShp.objects("txtSynched").value = cSynched
	elemShp.objects("txtSynched").style.visibility = "inherit"

	' update Running/Stopped icons
	if cStopped = 0 then
		' all good, so set icons to OK
		elemShp.objects("shpFailMargOKRunning").value = 3
	else 
	    if cRunning = 0 then
			' all bad, so set icons to Fail
		    elemShp.objects("shpFailMargOKRunning").value = 1
	    else
			' somewhere between good and bad so set icons to marginal
		    elemShp.objects("shpFailMargOKRunning").value = 2
	    end if
	end if

	' update Synched/NotSynched icons
	if cNotSynched = 0 then
		' all good, so set icons to OK
		elemShp.objects("shpFailMargOKSynched").value = 3
	else 
		if cSynched = 0 then
			' all bad, so set icons to Fail
			elemShp.objects("shpFailMargOKSynched").value = 1
		else
			' somewhere between good and bad so set icons to marginal
			elemShp.objects("shpFailMargOKSynched").value = 2
		end if
	end if

	elemShp.objects("grpMain").style.visibility = "inherit"

end sub]]></script></scripts><parameters><parameter name="BCCCount" type="Value" description="Number of BCCs excluding MCC" defaultvalue="0"/></parameters><shapes><shape><group><element><html><content><![CDATA[
