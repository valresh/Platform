	exit sub
end if
if me.value=1 then
	strThisServer.style.visibility="inherit"
	chkMsvrCheckLine1Inv.style.visibility="inherit"
	chkMsvrCheckLine1.style.visibility="hidden"
else
	strThisServer.style.visibility="hidden"
	chkMsvrCheckLine1Inv.style.visibility="hidden"
	chkMsvrCheckLine1.style.visibility="inherit"
end if
intMsvrLineNum1.value=me.value
