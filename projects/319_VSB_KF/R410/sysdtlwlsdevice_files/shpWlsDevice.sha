<DIV style="POSITION: absolute; TEXT-ALIGN: left; FONT-STYLE: normal; WIDTH: 5%; FONT-FAMILY: arial; HEIGHT: 44%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 10pt; OVERFLOW: hidden; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior) url(#HSCScriptDataBehavior); TOP: 0%; LEFT: 15%" id=Statussd class="hvg.textbox.1  HSC.ScriptDataObject.1 " tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:10;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#ff0000;textColorBlink:False;TotalRotation:-1;Width:9;" HDX_LOCK="-1">Scrpit Data</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[If not Statussd.QualityBad("TagName.STAT_MODEL") then
	if Statussd.DataValue("TagName.STAT_MODEL") = StatusDevTypeEJX.value then
		DeviceCommonStatus.style.visibility = "Hidden"
		DeviceCommonStatus1.style.visibility = "Hidden"
		DeviceCommonStatus2.style.visibility = "Hidden"
		GrpCommonStatus_XYR6000Press.style.visibility = "Hidden"
		GrpCommonStatus_XYRMAIDIDO.style.visibility = "Hidden"
		GrpEJX.style.visibility = "Visible"
		DeviceCommonDiagnosticInfo.style.visibility = "Hidden"
		GrpDiagnosticInfo.style.visibility = "Hidden"
		GrpXYR600Corr.style.visibility = "Hidden"
		GrpXYR6000Press.style.visibility = "Hidden"
		GrpXYR6000Temp.style.visibility = "Hidden"
		GrpXYRHLAI.style.visibility = "Hidden"
		GrpXYRMAIDIDO.style.visibility = "Hidden"		
	elseif Statussd.DataValue("TagName.STAT_MODEL") = StatusDevtypeXYRTempDI.value then
		DeviceCommonStatus.style.visibility = "Visible"
		DeviceCommonStatus1.style.visibility = "Visible"
		DeviceCommonStatus1.style.top = 438
		DeviceCommonStatus2.style.visibility = "Visible"
		'DeviceCommonStatus2.style.top = 362
		GrpCommonStatus_XYR6000Press.style.visibility = "Hidden"
		GrpCommonStatus_XYRMAIDIDO.style.visibility = "Hidden"
		DeviceCommonDiagnosticInfo.style.visibility = "Visible"
		GrpXYRMAIDIDO.style.visibility = "Hidden"
		GrpDiagnosticInfo.style.visibility = "Visible"
		GrpDiagnosticInfo.style.top = 330
		GrpXYR600Corr.style.visibility = "Hidden"
		GrpXYR6000Press.style.visibility = "Hidden"
