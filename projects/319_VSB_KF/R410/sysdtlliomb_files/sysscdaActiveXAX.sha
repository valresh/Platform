<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="794px" height="410px"><versionheaders><versionheader name="PS" value="4.5"/></versionheaders><scripts><script event="" language="VBScript" id="E215F5D9-EBCC-4DA7-AF47-3AF639986106"><![CDATA[Const ErdbConnToA = 0
Const ErdbDiscFromA = 1
Const ErdbConnToB = 2
Const ErdbDiscFromB = 3

Dim intERDBStatus]]></script><script event="onshapeload" language="VBScript" id=""><![CDATA[On Error Resume Next
	'variable to store the NUMSIG parametere
	Dim NumSig
	NumSig=0
	If (len(Me.Objects("PrimSig").Value)) <> 255  Then
		NumSig=1
	End If
	If NumSig=1 And len(Me.Objects("SecSig").Value) <> 255  Then
		NumSig=2
	End If
	
	me.Objects("AXConfigFrm1").PointName = window.external.DetailPointID '"SCE_TEST"
	me.Objects("AXConfigFrm1").ServerName = window.external.DetailPointServerNetworkName '"ie10dt2kc01900"
	me.Objects("AXConfigFrm1").SecurityLevel = window.external.SecurityLevel '2
	me.Objects("AXConfigFrm1").OperatorName = window.external.OperatorID '"Stn01"
	me.Objects("AXConfigFrm1").StationServerName = window.external.ServerName '"ie10dt2kc01900"
	me.Objects("AXConfigFrm1").StationNumber = window.external.StationNumber	'1
	me.Objects("AXConfigFrm1").ElectronicSignature = me.Objects("ESig").value
	me.Objects("AXConfigFrm1").ControlConfirm = me.Objects("CtrlConfirmProp").value
	me.Objects("AXConfigFrm1").NumberSignatures = NumSig

	intERDBStatus = -1

	me.Objects("CmActiveX1").height = me.style.height
	me.Objects("CmActiveX1").width = me.style.width]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<OBJECT class=hsc.activexcontrol.1 id=AxConfigFrm1 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0.25%; WIDTH: 98.23%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 100%; TEXT-DECORATION: none" tabIndex=-1 classid=clsid:5CC9BF76-270B-4160-A966-1472C9518BAD><PARAM NAME="_Version" VALUE="65536"><PARAM NAME="_ExtentX" VALUE="20638"><PARAM NAME="_ExtentY" VALUE="10848"><PARAM NAME="_StockProps" VALUE="160"><PARAM NAME="BorderStyle" VALUE="0"><PARAM NAME="Appearance" VALUE="0">]]></content><scripts><script event="InvokeERDBStatus(nERDBStatus)" language="VBScript"><![CDATA[On Error Resume Next

    If ((nERDBStatus = ErdbDiscFromA Or nERDBStatus = ErdbDiscFromB) And intERDBStatus <> -1) Then
        'objEStat.Value = "LOST"
		window.external.MessageZoneText = Me.parentElement.children.namedItem("LostMessage").Value

    ElseIf ((nERDBStatus = ErdbDiscFromA Or nERDBStatus = ErdbDiscFromB) And intERDBStatus = -1) Then
        'objEStat.Value = "FAIL"
		window.external.MessageZoneText = Me.parentElement.children.namedItem("FailMessage").Value

    ElseIf (intERDBStatus = -1) Then
        'objEStat.Value = "INIT"
		window.external.MessageZoneText = ""

    Else
        'objEStat.Value = "SUCCESS"
		window.external.MessageZoneText = Me.parentElement.children.namedItem("SuccMessage").Value

    End If
        
    intERDBStatus = nERDBStatus]]></script></scripts></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=txtMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 46.47%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 80%; HEIGHT: 5.12%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:369;">Failed to get the Installed Path of PsAxCtlDoc.vbd file.</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=LimitMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 50.37%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 84.14%; HEIGHT: 4.14%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:400;">Unable to open Display. Maximum limit reached. Try again Later.</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=FailMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0.25%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 22.41%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 88.78%; HEIGHT: 5.6%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:23;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:178;">Cannot Connect to ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ESig style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: transparent; LEFT: 0.12%; VISIBILITY: hidden; BORDER-BOTTOM-COLOR: transparent; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 7.43%; COLOR: #000000; BORDER-TOP-STYLE: none; BORDER-TOP-COLOR: transparent; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 93.9%; HEIGHT: 4.87%; BACKGROUND-COLOR: white; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-RIGHT-COLOR: transparent; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="borderStyle:none;borderWidth:;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:1;numericDisplayFormat:%.0f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value=