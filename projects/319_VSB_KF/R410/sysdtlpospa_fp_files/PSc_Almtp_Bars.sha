call AlmTP_OnUpdate(me, ConAlpLoAlmPR, RecL)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Text::DACFBName%}.pvloalm.tp"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ConAlpHiAlmTP style="BORDER-RIGHT: transparent 2px; PADDING-RIGHT: 2px; BORDER-TOP: transparent 2px; PADDING-LEFT: 2px; FONT-WEIGHT: 400; FONT-SIZE: 8pt; LEFT: 0%; VISIBILITY: hidden; PADDING-BOTTOM: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); OVERFLOW: hidden; BORDER-LEFT: transparent 2px; WIDTH: 75%; COLOR: #ff0000; PADDING-TOP: 2px; BORDER-BOTTOM: transparent 2px; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 38.88%; HEIGHT: 8.33%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; ROWS: 1" tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;" printDisplayValue="9999.99" globalscripts>9999.99</TEXTAREA>]]>