<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="8px" height="144px"><versionheaders><versionheader name="PS" value="6.1"/></versionheaders><scripts><script event="" language="VBScript" id="0E93F254-D320-45DE-99D9-49D9AA177E42"><![CDATA[sub AlmTP_OnUpdate(oSource, oSource1, oRect)
dim iTop, iHeight, oShape, sToolTipTxt, sEUDesc ,Hilimit
on error resume next
if isnumeric(oSource.currentvalue)and oSource1.value>1 then 
 set oShape=oSource.parentnode.parentnode
 itop=oSource.parentnode.style.pixeltop
 iheight=oSource.parentnode.style.pixelheight
 iheight=oSource.parentnode.style.pixelheight
 pvRange = (oShape.objects("ConAlpPVEUHi").value-oShape.objects("ConAlpPVEULo").value)
 pvRangelo =   oShape.objects("ConAlpPVEULo").value
 iVal = oSource.value

 if oShape.objects("ConAlpHHAlmTP").value = "NaN" or oShape.objects("ConAlpHiAlmTP").value = "NaN"then
    HiFlag = 0
 elseif (oShape.objects("ConAlpHHAlmTP").value-oShape.objects("ConAlpHiAlmTP").value) = 0 then  
    HiFlag = 0
 else 
    HiFlag = 1
 end if

 if (oShape.objects("ConAlpLoAlmTP").value = "NaN" or oShape.objects("ConAlpLLAlmTP").value) = "NaN" then
    LoFlag = 0
 elseif (oShape.objects("ConAlpLoAlmTP").value-oShape.objects("ConAlpLLAlmTP").value) = 0 then  
    LoFlag = 0
 else 
    LoFlag = 1
 end if

 
 'If (oShape.objects("ConAlpHHAlmTP").value-oShape.objects("ConAlpHiAlmTP").value) = 0 then
 '    HiFlag = 0
 'else
 '    HiFlag = 1
 'end if
 
 'If (oShape.objects("ConAlpLoAlmTP").value-oShape.objects("ConAlpLLAlmTP").value) = 0 then
 '    LoFlag = 0
 'else
 '    LoFlag = 1
 'end if
Select Case Right(oRect.id, 1)

            Case "H"
                If pvRange * iHeight <> 0 Then
                    oRect.Style.pixelHeight = (iHeight ) - (iVal - pvRangeLo) / pvRange * iHeight
                Else
                    oRect.Style.pixelHeight = iHeight
                End If
                oRect.Style.pixelTop = iTop
                
                If Right(oRect.id, 2) = "HH" Then
                    If oRect.Style.pixelHeight < 1 Then oRect.Style.pixelHeight = 1
					
				 Else
					 
					If (oRect.Style.pixelHeight <= 1) Then oRect.Style.pixelHeight = 1  + HiFlag
					 
				 End If 
				
			

            Case "L"
                If pvRange * iHeight <> 0 Then
                    oRect.Style.pixelHeight = (iVal - pvRangeLo) / pvRange * iHeight
                Else
                    oRect.Style.pixelHeight = 0
                End If
                
                If Right(oRect.id, 2) = "LL" Then
                    If oRect.Style.pixelHeight < 1 Then oRect.Style.pixelHeight = 1     'min LoLo pixel height is 3, for tooltip access
                Else
				    'If oRect.Style.pixelHeight <= 1 Then oRect.Style.pixelHeight = 2
                    If ( oRect.Style.pixelHeight <= 1) Then oRect.Style.pixelHeight = 1  + LoFlag   'min Lo pixel height is 4, so not *arbitrarily* occluded by above
                End If

                oRect.Style.pixelTop = iTop + iHeight - oRect.Style.pixelHeight

  End Select
  call AlmPriority_OnUpdate(oSource1,oRect)
 
else
 oRect.style.visibility="hidden"
end if

end sub

sub AlmPriority_OnUpdate(oSource,oRect)
On Error resume next
if oRect.style.pixelheight>0 then 
  select case oSource.value
    case 2 
			oRect.Fillcolor=AlarmStateIconFactory.lowcolor
			oRect.style.visibility="visible"
    case 3 
			oRect.Fillcolor=AlarmStateIconFactory.highcolor
			oRect.style.visibility="visible"
    case 4 
			oRect.Fillcolor=AlarmStateIconFactory.urgentcolor
			oRect.style.visibility="visible"
    case else
		    	oRect.style.pixelheight=0
		        oRect.Fillcolor=transparent
    end select
else
    oRect.style.visibility="hidden"
end if

end sub]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%currentpoint%}"/><parameter name="DACFBName" type="Text" description="" defaultvalue="daca"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ConAlpLLAlmTP style="BORDER-RIGHT: transparent 2px; PADDING-RIGHT: 2px; BORDER-TOP: transparent 2px; PADDING-LEFT: 2px; FONT-WEIGHT: 400; FONT-SIZE: 8pt; LEFT: 0%; VISIBILITY: hidden; PADDING-BOTTOM: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); OVERFLOW: hidden; BORDER-LEFT: transparent 2px; WIDTH: 75%; COLOR: #ff0000; PADDING-TOP: 2px; BORDER-BOTTOM: transparent 2px; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 44.44%; HEIGHT: 8.33%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; ROWS: 1" tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;" printDisplayValue="9999.99" globalscripts>9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
call AlmTP_OnUpdate(me, ConAlpLLAlmPR, RecLL)
call AlmTP_OnUpdate(ConAlpLoAlmTP, ConAlpLoAlmPR, RecL)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Text::DACFBName%}.pvllalm.tp"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ConAlpLoAlmTP style="BORDER-RIGHT: transparent 2px; PADDING-RIGHT: 2px; BORDER-TOP: transparent 2px; PADDING-LEFT: 2px; FONT-WEIGHT: 400; FONT-SIZE: 8pt; LEFT: 0%; VISIBILITY: hidden; PADDING-BOTTOM: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); OVERFLOW: hidden; BORDER-LEFT: transparent 2px; WIDTH: 75%; COLOR: #ff0000; PADDING-TOP: 2px; BORDER-BOTTOM: transparent 2px; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 50%; HEIGHT: 8.33%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; ROWS: 1" tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;" printDisplayValue="9999.99" globalscripts>9999.99</TEXT