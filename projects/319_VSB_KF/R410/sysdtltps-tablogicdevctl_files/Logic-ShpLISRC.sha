<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="94px" height="20px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="VBScript" id="68587E74-9581-4E66-B95A-17765C127EDB"><![CDATA[function QualityOK(PointObj)
	if (PointObj.quality and &HFF) = &HC0 then
		QualityOK = true
	else
		QualityOK = false
	end if	
end function]]></script></scripts><parameters><parameter name="MyPoint1" type="Point" description="" defaultvalue=""/><parameter name="MyParam1" type="Parameter" description="" defaultvalue=""/><parameter name="MyParam2" type="Parameter" description="Automatically added Parameter" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 100%; FONT-FAMILY: Arial; HEIGHT: 100%; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect); TOP: 0%; LEFT: 0%" id=rect001 class=hvg.base.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:20;LineColor:#000000;lineColorBlink:False;LineStyle:0;Width:94;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: right; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; BORDER-LEFT-STYLE: none; WIDTH: 100%; FONT-FAMILY: Arial; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 100%; VISIBILITY: hidden; COLOR: #000000; BORDER-RIGHT-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); TOP: 0%; LEFT: 0%; ROWS: 1" id=alpLISRCVal class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numericDisplayFormat:%.2f;textColor:#000000;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if QualityOK(me) then
		me.style.visibility = "Inherit"
window.external.Parent.LogMessage "Devctl: shpLISRC updated value (QualityGood) is: " & me.value
	else
window.external.Parent.LogMessage "Devctl: shpLISRC updated value (QualityBad) is: " & me.value
		me.style.visibility = "Hidden"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::MyPoint1%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::MyParam1%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
