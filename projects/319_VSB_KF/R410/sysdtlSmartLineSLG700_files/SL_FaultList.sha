<DIV tabIndex=-1 id=textboxViewDetails title="Click here to navigate to the Faults and Resolution tab to see possibe causes and suggested resolutions for each active condition." class="hvg.textbox.1 SL_Link_Right" style="FONT-SIZE: 11pt; OVERFLOW: hidden; CURSOR: hand; TEXT-DECORATION: ; HEIGHT: 9.18%; FONT-FAMILY: arial; WIDTH: 41.66%; POSITION: absolute; COLOR: #1792e5; TEXT-ALIGN: right; LEFT: 57.98%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:18;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:SL_Link_Right;textColor:#1792E5;textColorBlink:False;TotalRotation:-1;Width:120;">View Details</DIV>]]></content><scripts><script event="onmouseenter" language="JScript"><![CDATA[	this.style.textDecorationUnderline = true;]]></script><script event="onmouseleave" language="JScript"><![CDATA[	this.style.textDecorationUnderline = false;]]></script><script event="onclick" language="JScript"><![CDATA[SL_LogEvent(this, "onclick");

	try
	{
		LoadDisplayTab(displayTabName);
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_FaultList.textboxViewDetails_onclick", "Could not navigate to the Faults and Resolutions page.", error);
	}]]></script></scripts></html></element><html><content><![CDATA[
<DIV tabIndex=-1 id=groupFaultList class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 196px; WIDTH: 288px; POSITION: absolute; LEFT: 85px; TOP: 38px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:196;lineColorBlink:False;Width:288;"></DIV>]]></content></html></group></shape></shapes></shapefile>