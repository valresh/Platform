<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="288px" height="196px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="onshapeload" language="JScript" id=""><![CDATA[	SL_LogEvent(this, "onshapeload");

	transmitterType = this.GetCustomProperty("Value", "TransmitterType");
	displayTabName = "sysdtlSmartLine" + transmitterType + "_FaultsResolutions.htm";]]></script><script event="" language="JScript" id="CE670CD2-6F50-4EC7-9D87-89A41572EA69"><![CDATA[function groupFaultList_updateView(shape)
{

	SL_LogFunctionParameters(2, "groupFaultList_updateView", "shape = " + shape.id);

	// Find out number of rows available to show active faults in the shape.
	var faultList = shape.objects("groupFaults");
	maxRows = faultList.children.length;

	// Determine how many rows of faults there are to show. This is limited to
	// the number of rows in the shape.
	var maxFaults = Math.min(maxRows, SL_Device.allFaults.length);

	// Fill in the top rows with any available status information
	var fillColor;
	var lineColor;

	if (maxFaults > 0)
	{
		// Make the "View Details" link visible if there are any active faults to show.
		shape.objects("textboxViewDetails").style.visibility = "visible";

		for (i = 0; i < maxFaults; i++)
		{
			switch (SL_Device.allFaults[i].criticality)
			{
				case 0:
					fillColor = statusDisplayScheme[3].fillColor;
					lineColor = statusDisplayScheme[3].lineColor;
					break;

				case 1:
				default:
					fillColor = statusDisplayScheme[2].fillColor;
					lineColor = statusDisplayScheme[2].lineColor;
					break;
			}

			faultList.children[i].objects("alphaFault").value = SL_Device.allFaults[i].name;
			faultList.children[i].objects("ovalCriticality").fillColor = fillColor;
			faultList.children[i].objects("ovalCriticality").lineColor = lineColor;
			faultList.children[i].style.visibility = "visible";
		}
	}
	else
	{
		faultList.children[0].objects("alphaFault").value = "No fault conditions";
		faultList.children[0].objects("ovalCriticality").fillColor = statusDisplayScheme[0].fillColor;
		faultList.children[0].objects("ovalCriticality").lineColor = statusDisplayScheme[0].lineColor;
		faultList.children[0].style.visibility = "visible";

		maxFaults = 1;
	}

	// Clear out any leftover text from any remaining empty rows.
	for (i = maxFaults; i < maxRows; i++)
	{
		faultList.children[i].objects("alphaFault").value = "";
		faultList.children[i].style.visibility = "hidden";
	}
}]]></script></scripts><parameters><parameter name="TransmitterType" type="Value" description="Transmitter type: Level, Pressure, Temperature, Multivariable" defaultvalue=""/><parameter name="TransmitterModel" type="Value" description="String that identifies the transmitter model, such as STT850." defaultvalue=""/><parameter name="NumberOfDeviceStatusBytes" type="Value" description="The number of device specific status buyes incorporated in command 220." defaultvalue=""/><parameter name="SLAnalogPoint" type="Point" description="" defaultvalue="&lt;CurrentPoint&gt;"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxHeader class="hvg.textbox.1 SL_GroupHeader" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 9.18%; FONT-FAMILY: arial; WIDTH: 57.29%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:18;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:SL_GroupHeader;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:165;">Fault Conditions</DIV>]]></content></html></element><group><group><group><element><html><content><![CDATA[
