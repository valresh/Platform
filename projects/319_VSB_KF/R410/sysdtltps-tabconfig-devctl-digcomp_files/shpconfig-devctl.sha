<DIV tabIndex=-1 id=txtPVSGCHPR class="hvg.textbox.1 DetailText" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 100%; FONT-FAMILY: Verdana; WIDTH: 45.45%; POSITION: absolute; COLOR: #000000; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:DetailText;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:80;" HDX_LOCK="-1">PVSGCHPR:</DIV>]]></content></html></element><element><html><content><![CDATA[<SPAN tabIndex=0 id=combo_PVSGCHPR title="" class="hsc.combo.1 DetailCombo" style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 100%; FONT-FAMILY: Verdana; WIDTH: 54.55%; POSITION: absolute; COLOR: black; TEXT-ALIGN: left; LEFT: 44.89%; TOP: 0%; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: white; TEXT-INDENT: 2px" hdxproperties="borderStyle:none;fillColor:White;fillColorBlink:False;HDXBINDINGID:-4;lineColor:transparent;lineColorBlink:False;styleClass:DetailCombo;textColor:black;textColorBlink:False;">Combobox</SPAN>]]></content><scripts><script event="onmousedown" language="VBScript"><![CDATA[	dim sText
	sText = me.innerText
	me.hostpopulation = false
	me.ResetContent
	me.AddString "ON"
	me.AddString "OFF"
	me.innerText = sText]]></script><script event="onupdate" language="VBScript"><![CDATA[	if me.value = "TRUE" then
		me.innerText = "ON"
	else 
		me.innerText = "OFF"
	end if]]></script><script event="onchange" language="VBScript"><![CDATA[	on error resume next

	dim bRet
	if me.innerText = "OFF" then
		bRet = sd.SetDataValueSynchronous ("CurrentPoint.OVERFLOW", "FALSE") '0 	'wait for write!
	else
		bRet = sd.SetDataValueSynchronous ("CurrentPoint.OVERFLOW", "TRUE") '-1
	end if

'	Now, assuming an actual synchonous write, update presentation, in case write failed.
	if bRet = False then
		if sd.DataValue("tagname.OVERFLOW") = "FALSE" then '0 then
			combo_OVERFLOW.innerText = "OFF" 
		else
			combo_OVERFLOW.innerText = "ON"
		end if
