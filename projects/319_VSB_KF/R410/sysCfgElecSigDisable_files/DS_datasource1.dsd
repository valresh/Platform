<datasource version="2"><hmipage pageType="0" updateRate="0" forwardAction="4" forwardString="-1" backwardAction="4" backwardString="-1" previousIdleTime="0" areaRequestType="0" areaString="" securityLevel="0" requestTaskOnPageCallup="0" callUpTaskSecurityLevel="2" callUpTaskStationIndex="0" callUpTaskTaskLrn="0" callUpTaskTaskParam1="1" callUpTaskTaskParam2="11" callUpTaskTaskParam3="0" callUpTaskTaskParam4="0" periodicTaskOnPageCallup="0" periodicTaskSecurityLevel="2" periodicTaskStationIndex="0" periodicTaskTaskLrn="0" periodicTaskTaskParam1="1" periodicTaskTaskParam2="11" periodicTaskTaskParam3="0" periodicTaskTaskParam4="0" periodicTaskPeriod="60" persistFlags="0" safeviewCategory="HW_System_Display" pageTitle="Electronic Signature Enable/Disable" pageKey="0" pageFlags="1" zoomingAllowed="1" singleUse="0" appSetName="" associateWithAlarmGroup="0" useDefaultAlarmGroup="1" alarmGroup="%display name%_almgrp" pinchZoomEnabled="0"/><dataobject id="2" type="HMIPage.Generic" format="propertybag"><property name="AddressFlags">0</property><property name="AddressType">1</property><property name="CalloutElement"></property><property name="FileRefBitFieldStart">0</property><property name="FileRefBitFieldWidth">1</property><property name="FileRefFile">121</property><property name="FileRefFlags">0</property><property name="FileRefFormat">5</property><property name="FileRefRecord">1</property><property name="FileRefWord">1727</property><property name="ObjectType">0</property><property name="ParameterFormat">0</property><property name="PresentationType">0</property><property name="SecurityLevel">0</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="3" type="HMIPage.Generic" format="propertybag"><property name="AddressFlags">0</property><property name="AddressType">1</property><property name="CalloutElement"></property><property name="FileRefBitFieldStart">10</property><property name="FileRefBitFieldWidth">1</property><property name="FileRefFile">121</property><property name="FileRefFlags">0</property><property name="FileRefFormat">5</property><property name="FileRefRecord">1</property><property name="FileRefWord">1733</property><property name="ObjectType">0</property><property name="ParameterFormat">0</property><property name="PresentationType">0</property><property name="SecurityLevel">0</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="6" type="HMIPage.Generic" format="propertybag"><property name="AddressFlags">0</property><property name="AddressType">1</property><property name="CalloutElement"></property><property name="FileRefBitFieldStart">7</property><property name="FileRefBitFieldWidth">1</property><property name="FileRefFile">8</property><property name="FileRefFlags">0</property><property name="FileRefFormat">5</property><property name="FileRefRecord">1</property><property name="FileRefWord">1</property><property name="ObjectType">0</property><property name="ParameterFormat">0</property><property name="PresentationType">0</property><property name="SecurityLevel">5</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="8" type="HMIPage.Generic" format="propertybag"><property name="AddressFlags">0</property><property name="AddressType">1</property><property name="CalloutElement"></property><property name="FileRefBitFieldStart">6</property><property name="FileRefBitFieldWidth">1</property><property name="FileRefFile">8</property><property name="FileRefFlags">0</property><property name="FileRefFormat">5</property><property name="FileRefRecord">1</property><property name="FileRefWord">16</property><property name="ObjectType">0</property><property name="ParameterFormat">0</property><property name="PresentationType">0</property><property name="SecurityLevel">0</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="98" type="HMIPage.EntitySource" format="propertybag"><property name="AutoMigrate">0</property><property name="AuxFilter">(Type != 8) or (SubType != 1001) or (ItemNumber != 2)</property><property name="LinkAssetEntities">0</property><property name="StartLocation"></property><property name="SummaryType">0</property><property name="TemplateXML">&lt;TableTemplate&gt;&lt;FieldXML&gt;
		&lt;fields&gt;
			&lt;field id="NodeHandle" rowId="true"/&gt;
			&lt;field id="Depth"/&gt;
			&lt;field id="Expanded"/&gt;
			&lt;field id="NumChildren"/&gt;
			&lt;field id="EntityName"/&gt;
			&lt;field id="RemoteType"/&gt;
			&lt;field id="SubType"/&gt;
			&lt;field id="ItemNumber"/&gt;
			&lt;field id="Redundant"/&gt;
			&lt;field id="SignatureDisabled"/&gt;
			&lt;field id="SignatureDisabledMatchesDescendents"/&gt;
			&lt;field id="SignaturePropagatedDisabled"/&gt;
			&lt;field id="Assignable"/&gt;
			&lt;field id="Flags"/&gt;
		&lt;/fields&gt;
	&lt;/FieldXML&gt;&lt;XFormXML&gt;
		&lt;xforms&gt;
			&lt;defaultValue id="xfEmptyVariantToString" value="" type="string"/&gt;
			&lt;script id="xfIconImg" language="VBScript"&gt;
				Return = GetNodeImagePath(Value)
			&lt;/script&gt;
			&lt;script id="xfDisabledImg" language="VBScript"&gt;
				Return = GetDisabledImagePath(Value)
			&lt;/script&gt;
			&lt;script id="xfPadding" language="VBScript"&gt;
				Return = (Value - 1) * 16
			&lt;/script&gt;
			&lt;script id="xfPlusMinusImg" language="VBScript"&gt;
				if (Value(0) = 0) then
					Return = "Images/blank.gif"
				elseif (Value(1)) then
					Return = "Images/minus.gif"
				else
					Return = "Images/plus.gif"
				end if
			&lt;/script&gt;
			&lt;script id="xfDisabledVisible" language="VBScript"&gt;
				if( IsEmpty(Value) ) then
					Return = "hidden"
				else 
					Return = "visible"
				end if
			&lt;/script&gt;
			&lt;script id="xfInvertAssignable" language="VBScript"&gt;
				if( IsEmpty(Value) or (not Value) ) then
					Return = true
				else
					Return = false
				end if
			&lt;/script&gt;
			&lt;script id="xfDisabledBorderLight" language="VBScript"&gt;
				if( IsEmpty(Value) or (not Value(0)) ) then
					Return = ""
				else
					if( Value(1) = 1 ) then 
						Return = "1px solid threedlightshadow"
					else
						Return = "1px solid threedshadow"
					end if
				end if
			&lt;/script&gt;
			&lt;script id="xfDisabledBorderDark" language="VBScript"&gt;
				if( IsEmpty(Value) or (not Value(0)) ) then
					Return = ""
				else
					if( Value(1) = 1 ) then 
						Return = "1px solid threedshadow"
					else
						Return = "1px solid threedlightshadow"
					end if
				end if
			&lt;/script&gt;
			&lt;script id="xfMatchColor" language="VBScript"&gt;
				if( IsEmpty(Value) or (Value) ) then
					Return = ""
				else
					Return = "lightgrey"
				end if
			&lt;/script&gt;
			&lt;script id="xfName" language="VBScript"&gt;
				Return = GetNodeDisplayName(Value)
			&lt;/script&gt;
			&lt;script id="xfOpacity" language="VBScript"&gt;
				if( IsEmpty(Value) or (Value) ) then
					Return = ""
				else
					Return = "alpha(opacity=50)"
				end if
			&lt;/script&gt;
		&lt;/xforms&gt;
	&lt;/XFormXML&gt;&lt;HTMLWrapperXML&gt;
		&lt;HTMLWrappers&gt;
			&lt;MenuItemWrapper&gt;
				&lt;Begin&gt;
					&amp;lt;div style="position: relative; width: 170px; padding-bottom: 2px; padding-top: 1px; padding-right: 5px;" onmouseenter="OnEnter_MenuItem(this)" onmouseleave="OnLeave_MenuItem(this)"&amp;gt;&amp;lt;span&amp;gt;
				&lt;/Begin&gt;
				&lt;End&gt;
					&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;
				&lt;/End&gt;
			&lt;/MenuItemWrapper&gt;
			&lt;FilterAppliedWrapper&gt;
				&lt;Begin&gt;
					&amp;lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; margin-right: 1px; background-color: mediumblue; color: white; font-weight: bold;"&amp;gt;
				&lt;/Begin&gt;
				&lt;End&gt;
					&amp;lt;/span&amp;gt;
				&lt;/End&gt;
			&lt;/FilterAppliedWrapper&gt;
			&lt;SortAscIndicator&gt;
				&amp;amp;nbsp;&amp;lt;img src="Images/SortArrowUp.gif"&amp;gt;
			&lt;/SortAscIndicator&gt;
			&lt;SortDescIndicator&gt;
				&amp;amp;nbsp;&amp;lt;img src="Images/SortArrowDown.gif"&amp;gt;
			&lt;/SortDescIndicator&gt;
			&lt;GroupSeparator&gt;
				&amp;lt;div style="position:relative; width: 160px; height: 2px; overflow: hidden; display: block; border: 1px inset; margin: 3px;" &amp;gt;&amp;lt;/div&amp;gt;
			&lt;/GroupSeparator&gt;
		&lt;/HTMLWrappers&gt;
	&lt;/HTMLWrapperXML&gt;&lt;MenuGroupXML&gt;
		&lt;MenuGroups&gt;
		&lt;/MenuGroups&gt;
	&lt;/MenuGroupXML&gt;&lt;BaseFilterXML&gt;
		&lt;BaseFilterDef&gt;
		&lt;/BaseFilterDef&gt;
	&lt;/BaseFilterXML&gt;&lt;SortXML&gt;
		&lt;SortDef DefaultSortColumn="Tree" DefaultSortDir="asc"&gt;
			&lt;colref id="Tree" 
				SortAscString="EntityName asc"
				SortDescString="EntityName desc"
				SortDir="asc"
				SortOrder="1"/&gt;
		&lt;/SortDef&gt;
	&lt;/SortXML&gt;&lt;ReportTemplateXML&gt;&lt;/ReportTemplateXML&gt;&lt;ColumnStateXML&gt;
		&lt;state&gt;
			&lt;colref id="Tree" width="490" hidden="false" /&gt;
		&lt;/state&gt;
	&lt;/ColumnStateXML&gt;&lt;TableDefinitionXML&gt;
		&lt;table&gt;
			&lt;tableMenu/&gt;
			&lt;contextMenu/&gt;
			&lt;columns&gt;
				&lt;column id="Tree"&gt;
					&lt;title&gt;Tree&lt;/title&gt;
					&lt;action/&gt;
					&lt;menu/&gt;
					&lt;content&gt;
					    &amp;lt;div noselect="" language="javascript" ondblclick="event.cancelBubble = this.noselect; return !this.noselect;" onmousedown="event.cancelBubble = this.noselect; return !this.noselect;" style="position: absolute; padding-top: 3px; width: 100%; height: 100%;" ExpandCollapseTrigger=0&amp;gt;
						&amp;lt;div language="javascript" style="position: relative; display: inline; padding-left: 2px;"
							onmousedown="if( event.button == 1 ) { this.parentElement.ExpandCollapseTrigger = 1; event.cancelBubble = true; }"&amp;gt;
							&amp;lt;img style="position: relative; top: -5px; width: 9px; height: 9px;" src="Images/blank.gif"/&amp;gt;
						&amp;lt;/div&amp;gt;
						&amp;lt;div matching="" disabledLocal="" disabledPropagated="" language="javascript" onclick="if( !this.parentElement.noselect ) ApplyDisabled(this.disabledLocal == 0 ? 1 : 0, this, 5)"
									style="position: relative; 
										   top: -3px; 
										   height: 17px; 
										   width: 30px; 
										   overflow: hidden; 
										   display: inline; 
										   margin: 1px; 
										   text-align: center;"&amp;gt;
						    &amp;lt;img src="Images/blank.gif" style="width: 15px; height: 15px;" /&amp;gt;
						&amp;lt;/div&amp;gt;
					        &amp;lt;div style="position: relative; display: inline;"&amp;gt;
							&amp;lt;img style="position: relative; 
								       left: 0px;
								       width: 18px; 
								       height: 18px; 
 								       z-index: 2;" 
								src="Images/blank.gif"/&amp;gt;
						&amp;lt;/div&amp;gt;
					        &amp;lt;div style="position: absolute; height: 100%; width: 100%; left: 67px; padding-top: 3px; top: 1px; display: inline;" &amp;gt;&amp;lt;/div&amp;gt;
					    &amp;lt;/div&gt;
					&lt;/content&gt;
					&lt;bindings&gt;
						&lt;in fields="Depth" properties="style.paddingLeft;lastChild.style.paddingLeft" xforms="xfPadding" /&gt;
						&lt;in fields="NumChildren;Expanded" properties="firstChild.firstChild.src" xforms="xfPlusMinusImg" /&gt;
						&lt;in fields="RemoteType;SubType;ItemNumber;Redundant;Flags" properties="lastChild.previousSibling.firstChild.src" xforms="xfIconImg" /&gt;
						&lt;in fields="EntityName;RemoteType;SubType;ItemNumber" properties="lastChild.innerText;title" xforms="xfName" /&gt;
						&lt;in fields="Assignable" properties="firstChild.nextSibling.style.visibility" xforms="xfDisabledVisible" /&gt;
						&lt;in fields="Assignable;SignatureDisabled" properties="firstChild.nextSibling.style.borderRight;firstChild.nextSibling.style.borderBottom" xforms="xfDisabledBorderDark" /&gt;
						&lt;in fields="Assignable;SignatureDisabled" properties="firstChild.nextSibling.style.borderLeft;firstChild.nextSibling.style.borderTop" xforms="xfDisabledBorderLight" /&gt;
						&lt;in fields="Assignable" properties="noselect" xforms="xfInvertAssignable" /&gt;
						&lt;in fields="Assignable" properties="firstChild.nextSibling.firstChild.style.filter;lastChild.previousSibling.firstChild.style.filter;lastChild.style.filter" xforms="xfOpacity" /&gt;
						&lt;in fields="SignatureDisabled" properties="firstChild.nextSibling.firstChild.src" xforms="xfDisabledImg" /&gt;
						&lt;in fields="SignatureDisabled" properties="firstChild.nextSibling.disabledLocal" /&gt;
						&lt;in fields="SignatureDisabledMatchesDescendents" properties="firstChild.nextSibling.matching" /&gt;
						&lt;in fields="SignatureDisabledMatchesDescendents" properties="firstChild.nextSibling.style.backgroundColor" xforms="xfMatchColor"/&gt;
						&lt;out properties="firstChild.nextSibling.disabledLocal" fields="SignatureDisabled" /&gt;
						&lt;out properties="firstChild.nextSibling.disabledPropagated" fields="SignaturePropagatedDisabled" /&gt;
						&lt;out properties="ExpandCollapseTrigger" fields="Expanded"/&gt;
					&lt;/bindings&gt;
				&lt;/column&gt;
			&lt;/columns&gt;
		&lt;/table&gt;
	&lt;/TableDefinitionXML&gt;&lt;/TableTemplate&gt;</property><property name="Version">4.5</property><property name="WaitForInit">0</property><property name="WaitForSelectionList">0</property></dataobject></datasource>
