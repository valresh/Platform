>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim nIndex
	dim sMyPointParamName
	dim sTimeObject
	dim sTimeDurObject

	nIndex = 0
'	window.external.parent.logmessage "boxtimes alp_NTIME, gParamsThisPage: " & gParamsThisPage

'	if not bTimesSet then
'		if not bArrayPoint then 
	g_nNTIME = me.DataValue("boxpoint.NTIME") 'pick up from 'box point' else picked up in UpdatePage (for Array points) from point itself
'			window.external.parent.logmessage "NOT array point - setting nTimes to: " & nTimes
'			bTimesSet = TRUE
'		end if
'	end if

	if me.QualityGood("boxpoint.TIMESTIX") then
		txt_TIMESTIX.value = me.DataValue("boxpoint.TIMESTIX")
		txt_TIMESTIX.style.visibility = "Inherit"
'		txt_labelTIMESTIX.style.visibility = "Inherit"
	end if

	if me.QualityGood("boxpoint.TIMEDESC") then
		txt_TIMEDESC.value = me.DataValue("boxpoint.TIMEDESC")
	end if

	do while nIndex < 80 'and nIndex < g_nNTIME 'nTimes being the total count
		nIndex = nIndex + 1
		sMyPointParamName = "boxpoint.param" & nIndex
		sTimeObject = "alp_TIME" & nIndex
		sTimeDurObject = "alp_TIMEDur" & nIndex

		if nIndex > g_nParamsThisPage or not me.QualityGood(sMyPointParamName)then
			call HideThisObject(sTimeDurObject)
			call HideThisObject(sTimeObject)
		elseif me.DataValue(sMyPointParamName) < 29856 then 'its a duration
			call ShowThisObject(sTimeDurObject)
			call HideThisObject(sTimeObject)
		else
			call HideThisObject(sTimeDurObject)
			call ShowThisObject(sTimeObject)
		end if
	loop]]></script><script event="onupdate" language="VBScript"><![CDATA['	window.external.Parent.logmessage "alp_NTIME OnUpdate to value: " & me.value

	if me.value <> "NaN" then
		txt_NTIME.style.visibility = "Inherit"
		txt_NTIME.value = me.value
		if me.value > 0 then
			call UpdatePageCount(me.value) 'now that we have the box numeric count, populate the combobox accordingly
		end if

	else
		call UpdatePageCount (-1)  ' just to kill the "Reading Box Data" text
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="32767"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::boxpoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NTIME"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::boxpoint%},{%Point::box