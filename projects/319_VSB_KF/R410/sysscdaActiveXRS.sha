<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="814px" height="444px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><scripts><script event="" language="VBScript" id="72263D02-D043-439E-BA97-76A21F0B1194"><![CDATA[Dim blnCtrlConfirmProp
Dim blnESig
Dim blnPrimSig
Dim blnSecSig
Dim blnChartInitialized

blnCtrlConfirmProp = False
blnESig = False
blnPrimSig = False
blnSecSig = False
blnChartInitialized = False]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<OBJECT class=hsc.activexcontrol.1 id=RsGraph1 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; WIDTH: 99.87%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 98.64%; TEXT-DECORATION: none" tabIndex=-1 classid=clsid:D5AC2D5A-0B53-11D2-BB46-00C04FAD0B1B><PARAM NAME="_Version" VALUE="65536"><PARAM NAME="_ExtentX" VALUE="21511"><PARAM NAME="_ExtentY" VALUE="11589"><PARAM NAME="_StockProps" VALUE="0">]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=LimitMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 49.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 85.58%; HEIGHT: 3.82%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:404;">Unable to open Display. Maximum limit reached. Try again Later.</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=FailMessage style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0.24%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 22.11%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 89.86%; HEIGHT: 5.18%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:23;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:180;">Cannot Connect to ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=CtrlConfirmProp style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 8.35%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 3.19%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 94.59%; HEIGHT: 4.72%; BACKGROUND-COLOR: white; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=-1 hdxproperties="fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:2;numericDisplayFormat:%.0f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	blnCtrlConfirmProp = True

	If NOT(blnChartInitialized) Then
		If(blnCtrlConfirmProp AND blnESig AND blnPrimSig AND blnSecSig ) Then
			Dim NumSig
			NumSig=0
			If (len(PrimSig.Value)) <> 255  Then
				NumSig=1
			End If
			If NumSig=1 And len(SecSig.Value) <> 255  Then
				NumSig=2
			End If

			RSGraph1.PointName = window.external.DetailPointID 
			RSGraph1.ServerName = window.external.DetailPointServerNetworkName 
			RSGraph1.SecurityLevel = window.external.SecurityLevel 

			RSGraph1.OperatorName = window.external.OperatorID 
			RSGraph1.StationServerName = window.external.ServerName 
			RSGraph1.StationNumber = window.external.StationNumber	
			RSGraph1.ElectronicSignature = ESig.value
			RSGraph1.ControlConfirm = me.value
			RSGraph1.NumberSignatures = NumSig

			blnChartInitialized = True
		End If
	End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="ControlConfirmRequired"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ESig style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: transparent; LEFT: 0.12%; VISIBILITY: hidden; BORDER-BOTTOM-COLOR: transparent; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 7.37%; COLOR: #000000; BORDER-TOP-STYLE: none; BORDER-TOP-COLOR: transparent; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 94.59%; HEIGHT: 4.5%; BACKGROUND-COLOR: white; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-RIGHT-COLOR: transparent; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="borderStyle:none;borderWidth:;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:1;numericDisplayFormat:%.0f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	blnESig = True

	If  NOT(blnChartInitialized) Then
		If(blnCtrlConfirmProp AND blnESig AND blnPrimSig AND blnSecSig) Then

			Dim NumSig
			NumSig=0
			If (len(PrimSig.Value)) <> 255  Then
				NumSig=1
			End If
			If NumSig=1 And len(SecSig.Value) <> 255  Then
				NumSig=2
			End If

			RSGraph1.PointName = window.external.DetailPointID 
			RSGraph1.ServerName = window.external.DetailPointServerNetworkName 
			RSGraph1.SecurityLevel = window.external.SecurityLevel 

			RSGraph1.OperatorName = window.external.OperatorID 
			RSGraph1.StationServerName = window.external.ServerName 
			RSGraph1.StationNumber = window.external.StationNumber	
			RSGraph1.ElectronicSignature = me.value
			RSGraph1.ControlConfirm = CtrlConfirmProp.value
			RSGraph1.NumberSignatures = NumSig

			blnChartInitialized = True
		End If
	End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="FileRefFile" varianttype="VT_UI4" value="121"/><property name="FileRefRecord" varianttype="VT_UI4" value="1"/><property name="FileRefWord" varianttype="VT_UI4" value="1733"/><property name="FileRefFlags" varianttype="VT_UI4" value="0"/><property name="FileRefFormat" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldStart" varianttype="VT_UI1" value="10"/><property name="FileRefBitFieldWidth" varianttype="VT_UI1" value="1"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=PrimSig style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: transparent; LEFT: 12.16%; VISIBILITY: hidden; BORDER-BOTTOM-COLOR: transparent; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 12.28%; COLOR: #000000; BORDER-TOP-STYLE: none; BORDER-TOP-COLOR: transparent; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 94.59%; HEIGHT: 4.95%; BACKGROUND-COLOR: white; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: break-word; BORDER-RIGHT-COLOR: transparent; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="borderStyle:none;borderWidth:;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:-1;lineColor:black;lineColorBl