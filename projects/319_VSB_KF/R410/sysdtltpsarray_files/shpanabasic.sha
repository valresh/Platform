dim bVisibilityUpdated
bVisibilityUpdated = FALSE

public formatPV
public formatSP
public bPVSPFormatSet
formatPV = -1
formatSP = -1
bPVSPFormatSet = False

function QualityOK(PointObj)

'	Returns TRUE if the given object (parameter) is 'valid'
	if (PointObj.quality and &HFF) = &HC0 then
		QualityOK = true
	else
		QualityOK = false	
	end if

end function

function Configured(PointObj)

'	Returns TRUE if the given object (parameter) is 'configured' 
	if (PointObj.quality and &HFF) = &H04 then
		Configured = false	
	else
		Configured = true
	end if

end function]]></script></scripts><parameters><parameter name="tagname" type="Point" description="HSCpoint" defaultvalue=""/><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 0.13%; FONT-FAMILY: Arial; HEIGHT: 0.19%; VISIBILITY: hidden; FONT-SIZE: 12pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect); LEFT: 0%" id=rectSpacerTL class=hvg.base.1 tabIndex=-1 hdxproperties="FillColor:#ff0000;fillColorBlink:False;Height:1;lineColorBlink:False;Width:1;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[<INPUT style="POSITION: absolute; BORDER-BOTTOM-COLOR: #ffffff; BACKGROUND-COLOR: #ece9d8; FONT-STYLE: normal; BORDER-TOP-COLOR: #ffffff; WIDTH: 13.05%; BACKGROUND-REPEAT: no-repeat; FONT-FAMILY: Arial; HEIGHT: 4.88%; VISIBILITY: hidden; COLOR: #000000; BORDER-RIGHT-COLOR: #ffffff; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: #ffffff; TOP: 87.3%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); LEFT: 15.69%" id=btnPROCESS_PPS class=hsc.button.1 tabIndex=0 value=PROCESS type=button hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;indicateBadState:False;indicateNaNState:False;indicateScanState:False;lineColorBlink:False;textColorBlink:False;" HDX_LOCK="-1">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA['	Cause an immediate processing-request for this point

	nConfirmCount = 0
	window.clearInterval(intConfirmPPSTimerID) 'clear old/other timers
  	intConfirmPPSTimerID = window.setInterval ("ConfirmPPS()", 500)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; FONT-STYLE: normal; WIDTH: 35.27%; FONT-FAMILY: Arial; HEIGHT: 4.68%; COLOR: #000000; FONT-SIZE: 16pt; OVERFLOW: hidden; TOP: 43.94%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 30%" id=txtLoading class=hvg.textbox.1 tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:254;" HDX_LOCK="-1">** Loading **</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; WIDTH: 10%; FONT-FAMILY: Small Fonts; HEIGHT: 2.34%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 7pt; OVERFLOW: hidden; TOP: 59.37%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); LEFT: 52.91%" id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:12;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:72;" HDX_LOCK="-1">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim bTPNServerOK
	on error resume next

	if not bPVSPFormatSet then
	'   Format SP and PV related parameters to SPFORMAT and PVFORMAT as available
		bPVSPFormatSet = True
	    
	    If sd.QualityGood("tagname.PVFORMAT") Then
    
	        Select Case sd.DataValue("tagname.PVFORMAT")
	        Case "D0"
	            formatPV = 0
	        Case "D1"
	            formatPV = 1
	        Case "D2"
	            formatPV = 2
	        Case "D3"
	            formatPV = 3
	        Case "D4"
	            formatPV = 4
	        Case "D5"
	            formatPV = 5
	        Case "D6"
	            formatPV = 6
	        Case Else
	            formatPV = -1  ' if using FormatNumber, -1 means "computer's regional setting"
	        End Select
	    End If   

	    If sd.QualityGood("tagname.SPFORMAT") Then
    
	        Select Case sd.DataValue("tagname.SPFORMAT")
	        Case "D0"
	            formatSP = 0
	        Case "D1"
	            formatSP = 1
	        Case "D2"
	            formatSP = 2
	        Case "D3"
	            formatSP = 3
	        Case "D4"
	            formatSP = 4
	        Case "D5"
	            formatSP = 5
	        Case "D6"
	            formatSP = 6
	        Case Else
	            formatSP = -1  ' use default - i.e. computer's regional setting
	        End Select
	    End If   'defaulted to 2

		if formatSP = -1 then 'default to PVFORMAT
			formatSP = formatPV
		end if

        If Not formatPV = -1 Then
			param_PVAUTO.numericdisplayformat = "%." & formatPV & "f"
        End If
        If Not formatSP = -1 Then          
			param_ADVSP.numericdisplayformat = "%." & formatSP & "f"
        End If

	end if   



	if bVisibilityUpdated = FALSE then
		GrpGeneral.style.visibility = "Inherit"
		GrpPointData1.style.visibility = "Inherit"
		GrpPointData2.style.visibility = "Inherit"
		GrpAlarmLimits.style.visibility = "Inherit"
		GrpGeneralHeader.style.visibility = "Inherit"
		GrpPointDataHeader.style.visibility = "Inherit"
		GrpAlarmLimitsHeader.style.visibility = "Inherit"
		txtLoading.style.visibility = "Hidden"
	end if

	if not sd.QualityGood("tagname.NODE_NO") then
		txtLoading.value = "** Missing TPN Data **"
		txtLoading.style.visibility = "Inherit"
		bTPNServerOK = FALSE
	else
		txtLoading.style.visibility = "Hidden"
		bTPNServerOK = TRUE
	end if

	if sd.QualityGood("tagname.CONTCUT") then
		if sd.DataValue("tagname.CONTCUT") <> 0 then
			text_CONTCUT.value = "ON"
		else
			text_CONTCUT.value = "OFF"
		end if
		GrpCONTCUT.style.visibility = "Inherit"
	else
		GrpCONTCUT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.OUTSLTNM") then
		if sd.IsNan("tagname.OUTSLTNM") then
			param_OUTSLTNM.value = "NaN"
		else
			param_OUTSLTNM.value = FormatNumber(sd.DataValue("tagname.OUTSLTNM"))
		end if
		GrpOUTSLTNM.style.visibility = "Inherit"
	else
		GrpOUTSLTNM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OUTBOXNM") then
		if sd.IsNan("tagname.OUTBOXNM") then
			param_OUTBOXNM.value = "NaN"
		else
			param_OUTBOXNM.value = FormatNumber(sd.DataValue("tagname.OUTBOXNM"))
		end if
		GrpOUTBOXNM.style.visibility = "Inherit"
	else
		GrpOUTBOXNM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OUTSSLT") then
		if sd.IsNan("tagname.OUTSSLT") then
			param_OUTSSLT.value = "NaN"
		else
			param_OUTSSLT.value = FormatNumber(sd.DataValue("tagname.OUTSSLT"))
		end if
		GrpOUTSSLT.style.visibility = "Inherit"
	else
		GrpOUTSSLT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BEFAFT") then
		if sd.DataValue("tagname.BEFAFT") = "BEFORE" or sd.DataValue("tagname.BEFAFT") = "AFTER" then
			bOkBEFAFTID = TRUE
			txtBEFAFT.value = sd.DataValue("tagname.BEFAFT") & ":"
			GrpBEFAFTID.style.visibility = "Inherit"
		else
			GrpBEFAFTID.style.visibility = "Hidden"
		end if
	else
		GrpBEFAFTID.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.CTLALGID") then
		param_CTLALGID.value = sd.DataValue("tagname.CTLALGID")
		GrpCTLALGID.style.visibility = "Inherit"
	else
		GrpCTLALGID.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ALGIDDAC") then
		param_ALGIDDAC.value = sd.DataValue("tagname.ALGIDDAC")
		GrpALGIDDAC.style.visibility = "Inherit"
	else
		GrpALGIDDAC.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.INPTSSLT") then
		param_INPTSSLT.value = FormatNumber(sd.DataValue("tagname.INPTSSLT"),0)
		GrpSUBSLOT.style.visibility = "Inherit"
	else
		GrpSUBSLOT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BOXNUM") then 
		param_BOXNUM.value = FormatNumber(sd.DataValue("tagname.BOXNUM"),0)
		GrpBOXNUM.style.visibility = "Inherit"
	else
		GrpBOXNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PNTBOXTY") and not sd.DataValue("tagname.PNTBOXTY") = "NOTCONFG" then
		param_PNTBOXTY.value = sd.DataValue("tagname.PNTBOXTY")
		GrpPNTBOXTY.style.visibility = "Inherit"
	else
		GrpPNTBOXTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.HWYNUM") then
		param_HWYNUM.value = FormatNumber(sd.DataValue("tagname.HWYNUM"),0)
		GrpHWYNUM.style.visibility = "Inherit"
	else
		GrpHWYNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.SLOTNUM") then
		param_SLOTNUM.value = FormatNumber(sd.DataValue("tagname.SLOTNUM"),0)
	else
		GrpSLOTNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODETYP") then
		param_NODETYP.value = sd.DataValue("tagname.NODETYP")
		GrpNODETYP.style.visibility = "Inherit"
	else
		GrpNODETYP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODENUM") then 
		param_NODENUM.value = FormatNumber(sd.DataValue("tagname.NODENUM"),0)
		GrpNODENUM.style.visibility = "Inherit"
	else
		GrpNODENUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NTWKNUM") then
		param_NTWKNUM.value = FormatNumber(sd.DataValue("tagname.NTWKNUM"),0)
		GrpNTWKNUM.style.visibility = "Inherit"
	else
		GrpNTWKNUM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.UNITNAME") then 
		param_UNITNAME.value = sd.DataValue("tagname.UNITNAME")
		GrpUNITNAME.style.visibility = "Inherit"
	else
		GrpUNITNAME.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PVALGID") then
		param_PVALGID.value = sd.DataValue("tagname.PVALGID")
		GrpPVALGID.style.visibility = "Inherit"
	else
		GrpPVALGID.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NODE_NO") then
		param_NODE_NO.value = FormatNumber(sd.DataValue("tagname.NODE_NO"),0)
		GrpNODE_NO.style.visibility = "Inherit"
	else
		GrpNODE_NO.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ENT_TYPE") then
		param_ENT_TYPE.value = sd.DataValue("tagname.ENT_TYPE")
		GrpENT_TYPE.style.visibility = "Inherit"
	else
		GrpENT_TYPE.style.visibility = "Hidden"
	end if

' special test: hide "CYCLE" if PERIOD = "NOPERIOD"
	if sd.QualityGood("tagname.NORMCYCL") then
		if sd.QualityGood("tagname.PERIOD") then
			if sd.DataValue("tagname.PERIOD") = "NOPERIOD" then
				GrpCYCLE.style.visibility = "Hidden"
			else
				GrpCYCLE.style.visibility = "Inherit"
			end if
		else
			GrpCYCLE.style.visibility = "Inherit"
		end if
	else
		GrpCYCLE.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PNTMODTY") then
		param_PNTMODTY.value = sd.DataValue("tagname.PNTMODTY")
		GrpPNTMODTY.style.visibility = "Inherit"
	else
		GrpPNTMODTY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.MODNUM") then
		param_MODNUM.value = sd.DataValue("tagname.MODNUM")
		GrpMODNUM.style.visibility = "Inherit"
	else
		GrpMODNUM.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.ACT_TYPE") then
		param_ACT_TYPE.value = sd.DataValue("tagname.ACT_TYPE")
		GrpACT_TYPE.style.visibility = "Inherit"
	else
		GrpACT_TYPE.style.visibility = "Hidden"
	end if
	if not sd.QualityGood("tagname.RCASENB") then
		GrpRCASENB.style.visibility = "Hidden"
	else
		GrpRCASENB.style.visibility = "Visible"
	end if
	if sd.QualityGood("tagname.CONFWAIT") then
		param_CONFWAIT.value = sd.DataValue("tagname.CONFWAIT")
		GrpCONFWAIT.style.visibility = "Inherit"
	else
		GrpCONFWAIT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.KEYWORD") then
		param_KEYWORD.value = sd.DataValue("tagname.KEYWORD")
		GrpKEYWORD.style.visibility = "Inherit"
	else
		GrpKEYWORD.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.PROGSTAT") then
		param_PROGSTAT.value = sd.DataValue("tagname.PROGSTAT")
		GrpPROGSTAT.style.visibility = "Inherit"
	else
		GrpPROGSTAT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.RUN_INIT") then
		if sd.DataValue("tagname.RUN_INIT") <> 0 then
			param_RUN_INIT.value = "ON"
		else
			param_RUN_INIT.value = "OFF"
		end if
		GrpRUN_INIT.style.visibility = "Inherit"
	else
		GrpRUN_INIT.style.visibility = "Hidden"
	end if


' CPU Saver - BELOW UNBOUND PARAMETERS
	if bVisibilityUpdated and bTPNServerOK and not bPeriodicVisibilityUpdate then 
		bDataChangeRequest = TRUE
		exit sub
	end if

	bPeriodicVisibilityUpdate = FALSE 'cpu saver flag

'GENERAL group
	if sd.QualityGood("tagname.PVAUTO") then 
		GrpPVAUTO.style.visibility = "Inherit"
	else
		GrpPVAUTO.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.ADVSP") then
		GrpADVSP.style.visibility = "Inherit"
	else
		GrpADVSP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.RATIO") then
		GrpRATIO.style.visibility = "Inherit"
	else
		GrpRATIO.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.BIAS") then
		GrpBIAS.style.visibility = "Inherit"
	else
		GrpBIAS.style.visibility = "Hidden"
	end if

' following four combos remain bound to leverage Experion combobox population (only do visibility)
	if sd.QualityGood("tagname.ASPPROC") then
		GrpASPPROC.style.visibility = "Inherit"
	else
		GrpASPPROC.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PVSOURCE") then
		GrpPVSOURCE.style.visibility = "Inherit"
	else
		GrpPVSOURCE.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PPS") then
		btnPROCESS_PPS.style.visibility = "Inherit"
	else
		btnPROCESS_PPS.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.ACCESKEY") then
		GrpACCESKEY.style.visibility = "Inherit"
	else
		GrpACCESKEY.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.INH_STAT") then
		GrpINH_STAT.style.visibility = "Inherit"
	else
		GrpINH_STAT.style.visibility = "Hidden"
	end if


' POINT DATA groups
	if sd.QualityGood("tagname.RV") then 
		GrpRV.style.visibility = "Inherit"
	else
		GrpRV.style.visibility = "Hidden"
	end if

	if sd.QualityGood("tagname.S1S2S3S4") then
		GrpS1S2S3S4.style.visibility = "Inherit"
	else
		GrpS1S2S3S4.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PVRAW") then
		GrpPVRAW.style.visibility = "Inherit"
	else
		GrpPVRAW.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ROLLOVER") then
		GrpROLLOVER.style.visibility = "Inherit"
	else
		GrpROLLOVER.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OVERVAL") then
		GrpOVERVAL.style.visibility = "Inherit"
	else
		GrpOVERVAL.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ALENBST") then
		GrpALENBST.style.visibility = "Inherit"
	else
		GrpALENBST.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ESWENBST") then
		GrpESWENBST.style.visibility = "Inherit"
	else
		GrpESWENBST.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NMODATTR") then
		GrpNMODATTR.style.visibility = "Inherit"
	else
		GrpNMODATTR.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.NMODE") then
		GrpNMODE.style.visibility = "Inherit"
	else
		GrpNMODE.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.REDTAG") then
		GrpREDTAG.style.visibility = "Inherit"
	else
		GrpREDTAG.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PTEXECST") then
		GrpPTEXECST.style.visibility = "Inherit"
	else
		GrpPTEXECST.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.$OPALEN") then
		GrpOPALEN.style.visibility = "Inherit"
	else
		GrpOPALEN.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.TIMEBASE") then
		GrpTIMEBASE.style.visibility = "Inherit"
	else
		GrpTIMEBASE.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.EIPSTATE") then
		GrpEIPSTATE.style.visibility = "Inherit"
	else
		GrpEIPSTATE.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PRESET") then
		GrpPRESET.style.visibility = "Inherit"
	else
		GrpPRESET.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PDEVTP") then
		GrpPDEVTP.style.visibility = "Inherit"
	else
		GrpPDEVTP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.TIMELEFT") then
		GrpTIMELEFT.style.visibility = "Inherit"
	else
		GrpTIMELEFT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.STSMSG") then
		GrpSTSMSG.style.visibility = "Inherit"
	else
		GrpSTSMSG.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PNTFORM") then
		GrpPNTFORM.style.visibility = "Inherit"
	else
		GrpPNTFORM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.INTVARNM") then
		GrpINTVARNM.style.visibility = "Inherit"
	else
		GrpINTVARNM.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.DOTYPE") then
		GrpDOTYPE.style.visibility = "Inherit"
	else
		GrpDOTYPE.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.OPTDIR") then
		GrpOPTDIR.style.visibility = "Inherit"
	else
		GrpOPTDIR.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.$AUXUNIT") then
		GrpAUXUNIT.style.visibility = "Inherit"
	else
		GrpAUXUNIT.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.PPSTYPE") then
		GrpPPSTYPE.style.visibility = "Inherit"
	else
		GrpPPSTYPE.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.RESTART") then
		GrpRESTART.style.visibility = "Inherit"
	else
		GrpRESTART.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.ASSOCDSP") then
		GrpASSOCDSP.style.visibility = "Inherit"
	else
		GrpASSOCDSP.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.$CDETAIL") then
		GrpCDETAIL.style.visibility = "Inherit"
	else
		GrpCDETAIL.style.visibility = "Hidden"
	end if

'GrpAlarmLimits
	if sd.QualityGood("tagname.C1DESC") then
		GrpC1DESC.style.visibility = "Inherit"
		GrpAlarmLimitsHeader.style.visibility = "Visible"
	else
		GrpC1DESC.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.C2DESC") then
		GrpC2DESC.style.visibility = "Inherit"
		GrpAlarmLimitsHeader.style.visibility = "Visible"
	else
		GrpC2DESC.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.C3DESC") then
		GrpC3DESC.style.visibility = "Inherit"
		GrpAlarmLimitsHeader.style.visibility = "Visible"
	else
		GrpC3DESC.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.C4DESC") then
		GrpC4DESC.style.visibility = "Inherit"
		GrpAlarmLimitsHeader.style.visibility = "Visible"
	else
		GrpC4DESC.style.visibility = "Hidden"
	end if
	if GrpAlarmLimitsHeader.style.visibility <> "Hidden" then
		if sd.DataValue("tagname.C1FL") <> 0 then '"C1ALM" then
			if sd.DataValue("tagname.C1PR") = "EMERGNCY" then
				GrpC1DESC.style.backgroundColor = AlarmStateIconFactory.UrgentColor 'txtEmergncyPrty.fillColor
			elseif sd.DataValue("tagname.C1PR") = "HIGH" then
				GrpC1DESC.style.backgroundColor = AlarmStateIconFactory.HighColor 'txtHighPrty.fillColor
			elseif sd.DataValue("tagname.C1PR") = "LOW" then
				GrpC1DESC.style.backgroundColor = AlarmStateIconFactory.LowColor 'txtLowPrty.fillColor
			elseif sd.DataValue("tagname.C1PR") = "JOURNAL" then
				GrpC1DESC.style.backgroundColor = AlarmStateIconFactory.JournalColor 'txtLowPrty.fillColor
			else 
				GrpC1DESC.style.backgroundColor = txtOtherAlmPrty.fillColor
			end if
		end if
		if sd.DataValue("tagname.C2FL") <> 0 then ' "C2ALM" then
			if sd.DataValue("tagname.C2PR") = "EMERGNCY" then
				GrpC2DESC.style.backgroundColor = AlarmStateIconFactory.UrgentColor 'txtEmergncyPrty.fillColor
			elseif sd.DataValue("tagname.C2PR") =  "HIGH" then
				GrpC2DESC.style.backgroundColor = AlarmStateIconFactory.HighColor 'txtHighPrty.fillColor
			elseif sd.DataValue("tagname.C2PR") = "LOW" then
				GrpC2DESC.style.backgroundColor = AlarmStateIconFactory.LowColor 'txtLowPrty.fillColor
			elseif sd.DataValue("tagname.C2PR") = "JOURNAL" then
				GrpC2DESC.style.backgroundColor = AlarmStateIconFactory.JournalColor 'txtLowPrty.fillColor
			else 
				GrpC2DESC.style.backgroundColor = txtOtherAlmPrty.fillColor
			end if
		end if
		if sd.DataValue("tagname.C3FL") <> 0 then ' "C3ALM" then
			if sd.DataValue("tagname.C3PR") = "EMERGNCY" then
				GrpC3DESC.style.backgroundColor = AlarmStateIconFactory.UrgentColor 'txtEmergncyPrty.fillColor
			elseif sd.DataValue("tagname.C3PR") = "HIGH" then
				GrpC3DESC.style.backgroundColor = AlarmStateIconFactory.HighColor 'txtHighPrty.fillColor
			elseif sd.DataValue("tagname.C3PR") = "LOW" then
				GrpC3DESC.style.backgroundColor = AlarmStateIconFactory.LowColor 'txtLowPrty.fillColor
			elseif sd.DataValue("tagname.C3PR") = "JOURNAL" then
				GrpC3DESC.style.backgroundColor = AlarmStateIconFactory.JournalColor 'txtLowPrty.fillColor
			else 
				GrpC3DESC.style.backgroundColor = txtOtherAlmPrty.fillColor
			end if
		end if
		if sd.DataValue("tagname.C4FL") <> 0 then ' "C4ALM" then
			if sd.DataValue("tagname.C4PR") = "EMERGNCY" then
				GrpC4DESC.style.backgroundColor = AlarmStateIconFactory.UrgentColor 'txtEmergncyPrty.fillColor
			elseif sd.DataValue("tagname.C4PR") = "HIGH" then
				GrpC4DESC.style.backgroundColor = AlarmStateIconFactory.HighColor 'txtHighPrty.fillColor
			elseif sd.DataValue("tagname.C4PR") = "LOW" then
				GrpC4DESC.style.backgroundColor = AlarmStateIconFactory.LowColor 'txtLowPrty.fillColor
			elseif sd.DataValue("tagname.C4PR") = "JOURNAL" then
				GrpC4DESC.style.backgroundColor = AlarmStateIconFactory.JournalColor 'txtLowPrty.fillColor
			else 
				GrpC4DESC.style.backgroundColor = txtOtherAlmPrty.fillColor
			end if
		end if			
	end if

	bVisibilityUpdated = TRUE
	call UpdateMainGroups]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" val