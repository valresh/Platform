evel">0</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="27" type="HMIPage.Generic" format="propertybag"><property name="AddressFlags">0</property><property name="AddressType">1</property><property name="CalloutElement"></property><property name="FileRefFile">173</property><property name="FileRefFlags">512</property><property name="FileRefFormat">0</property><property name="FileRefRecord">1</property><property name="FileRefStrRefLength">40</property><property name="FileRefWord">1</property><property name="ObjectType">0</property><property name="ParameterFormat">0</property><property name="PresentationType">12</property><property name="SecurityLevel">0</property><property name="UpdatePeriod">0</property><property name="version">1.3</property></dataobject><dataobject id="98" type="HMIPage.EntitySource" format="propertybag"><property name="AutoMigrate">0</property><property name="AuxFilter">((Type == 6) or ((Type == 8) and (ItemNumber == 1) and (SubType == 1001)) or ((Type == 8) and (SubType == 1018) and (ItemNumber == 0))) and (IsAssigned or HasAssignedDescendents)</property><property name="LinkAssetEntities">0</property><property name="StartLocation"></property><property name="SummaryType">1</property><property name="TemplateXML">&lt;TableTemplate&gt;&lt;FieldXML&gt;
		&lt;fields&gt;
			&lt;field id="NodeHandle" rowId="true"/&gt;
			&lt;field id="Depth"/&gt;
			&lt;field id="Expanded"/&gt;
			&lt;field id="NumChildren"/&gt;
			&lt;field id="EntityName"/&gt;
			&lt;field id="FullName"/&gt;
			&lt;field id="Description"/&gt;
			&lt;field id="RemoteType"/&gt;
			&lt;field id="SubType"/&gt;
			&lt;field id="ItemNumber"/&gt;
			&lt;field id="Redundant"/&gt;
			&lt;field id="AlarmDisabled"/&gt;
			&lt;field id="AlarmDisabledMatchesDescendents"/&gt;
			&lt;field id="AlarmPropagatedDisabled"/&gt;
			&lt;field id="ConsoleAlarmDisabled(%RecordOffset%)"/&gt;
			&lt;field id="ConsoleAlarmDisabledMatchesDescendents(%RecordOffset%)"/&gt;
			&lt;field id="ConsoleAlarmPropagatedDisabled(%RecordOffset%)"/&gt;
			&lt;field id="ConsoleAlarmSynch(%RecordOffset%)"/&gt;
			&lt;field id="ConsoleAlarmSynchText(%RecordOffset%)"/&gt;
			&lt;field id="Assignable"/&gt;
			&lt;field id="IsAssigned"/&gt;
			&lt;field id="Flags"/&gt;
			&lt;field id="AssociatedAsset"/&gt;
		&lt;/fields&gt;
	&lt;/FieldXML&gt;&lt;XFormXML&gt;
		&lt;xforms&gt;
			&lt;defaultValue id="xfEmptyVariantToString" value="" type="string"/&gt;
			&lt;script id="xfIconImg" language="VBScript"&gt;
				Return = GetNodeImagePath(Value)
			&lt;/script&gt;
			&lt;script id="xfDisabledImg" language="VBScript"&gt;
				Return = GetDisabledImagePath(Value)
			&lt;/script&gt;
			&lt;script id="xfPadding" language="VBScript"&gt;
				Return = (Value - 1) * 16
			&lt;/script&gt;
			&lt;script id="xfPlusMinusImg" language="VBScript"&gt;
				if (Value(0) = 0) then
					Return = "Images/blank.gif"
				elseif (Value(1)) then
					Return = "Images/minus.gif"
				else
					Return = "Images/plus.gif"
				end if
			&lt;/script&gt;
			&lt;script id="xfDisabledVisible" language="VBScript"&gt;
				if( IsEmpty(Value) ) then
					Return = "hidden"
				else 
					Return = "visible"
				end if
			&lt;/script&gt;
			&lt;script id="xfInvertAssignable" language="VBScript"&gt;
				//Check if asset is assigned
				if( IsEmpty(Value(1)) or (not Value(1)) ) then
					Return = true
				else
					//Invert Assignable Value 
					if( IsEmpty(Value(0)) or (not Value(0)) ) then
						Return = true
					else
						Return = false
					end if
				end if
			&lt;/script&gt;
			&lt;script id="xfDisabledBorderLight" language="VBScript"&gt;
				if( IsEmpty(Value) or (not Value(0)) ) then
					Return = ""
				else
					if( Value(1) = 1 ) then 
						Return = "1px solid threedlightshadow"
					else
						Return = "1px solid threedshadow"
					end if
				end if
			&lt;/script&gt;
			&lt;script id="xfDisabledBorderDark" language="VBScript"&gt;
				if( IsEmpty(Value) or (not Value(0)) ) then
					Return = ""
				else
					if( Value(1) = 1 ) then 
						Return = "1px solid threedshadow"
					else
						Return = "1px solid threedlightshadow"
					end if
				end if
			&lt;/script&gt;
			&lt;script id="xfMatchColor" language="VBScript"&gt;
				if( IsEmpty(Value) or (Value) ) then
					Return = ""
				else
					Return = "lightgrey"
				end if
			&lt;/script&gt;
			&lt;script id="xfName" language="VBScript"&gt;
				Return = GetNodeDisplayName(Value)
			&lt;/script&gt;
			&lt;script id="xfTruncation" language="JScript" &gt;
				if(typeof assetDivRemainingWidth == 'undefined') {
					assetDivRemainingWidth = GetRemainingWidthForLastChild("asset_div");
					//An extra pixel which could not be accounted for has been added
					assetDivRemainingWidth -= 1
				}
				//Calcualting and returning the remaining width for the div containing the asset name text
				return (assetDivRemainingWidth - (Value-1)*16)
			&lt;/script&gt;
			&lt;script id="xfSyncTruncation" language="JScript" &gt;
				if(typeof syncStatusRemainingWidth == 'undefined') {
					syncStatusRemainingWidth = GetRemainingWidthForLastChild("sync_status");
				}
				return syncStatusRemainingWidth
			&lt;/script&gt;
			&lt;script id="xfTitle" language="VBScript"&gt;
				Return = GetItemTitle(Value)
			&lt;/script&gt;
			&lt;script id="xfTextOpacity" language="VBScript"&gt;
				//Change opacity of asset text if asset is not assigned or asset is assigned but not assignable
				if( IsEmpty(Value) or (Value) ) then
					Return = ""
				else
					Return = "alpha(opacity=50)"
				end if
			&lt;/script&gt;		
			&lt;script id="xfOpacity" language="VBScript"&gt;
				//Change opacity of row if asset is not assigned or asset is assigned but not assignable
				if( IsEmpty(Value(1)) or (Value(1)) ) then
					if( IsEmpty(Value(0)) or (Value(0)) ) then
						Return = ""
					else
						Return = "alpha(opacity=50)"
					end if
				else
					Return = "alpha(opacity=50)"
				end if
			&lt;/script&gt;
			&lt;script id="xfDisabledText" language="VBScript"&gt;
				if( IsEmpty(Value) ) then
					Return = ""
				else
					if( Value = 1 ) then 
						Return = "Disabled"
					else
						Return = ""
					end if
				end if
			&lt;/script&gt;
			&lt;script id="xfSyncLED" language="VBScript"&gt;
				if( IsEmpty(Value) ) then
					Return = ""
				else
					if( Value = 0 ) then
						Return = "led_grey"
					elseif( Value = 1 ) then
						Return = "led_grey"
					elseif( Value = 2 ) then
						Return = "led_green"
					elseif( Value = 3 ) then
						Return = "led_black"
					elseif( Value = 4 ) then
						Return = "led_yellow"
					elseif( Value = 5 ) then
						Return = "led_black"
					elseif( Value = 6 ) then
						Return = "led_black"
					elseif( Value = 7 ) then
						Return = "led_grey"
					elseif( Value = 8) then
						Return = "led_black"
					end if
				end if
			&lt;/script&gt;
			&lt;script id="xfSyncVisibility" language="VBScript"&gt;
				if( IsEmpty(Value) ) then
					Return = "hidden"
				else
					if( Value = 0 ) then
						Return = "hidden"
					elseif( Value = 1 ) then
						Return = "hidden"
					elseif( Value = 2 ) then
						Return = "visible"
					elseif( Value = 3 ) then
						Return = "visible"
					elseif( Value = 4 ) then
						Return = "visible"
					elseif( Value = 5 ) then
						Return = "hidden"
					elseif( Value = 6 ) then
						Return = "visible"
					elseif( Value = 7 ) then
						Return = "hidden"
					elseif( Value = 8 ) then
						Return = "visible"
					end if
				end if
			&lt;/script&gt;
		&lt;/xforms&gt;
	&lt;/XFormXML&gt;&lt;HTMLWrapperXML&gt;
		&lt;HTMLWrappers&gt;
			&lt;MenuItemWrapper&gt;
				&lt;Begin&gt;
					&amp;lt;div style="position: relative; width: 170px; padding-bottom: 2px; padding-top: 1px; padding-right: 5px;" onmouseenter="OnEnter_MenuItem(this)" onmouseleave="OnLeave_MenuItem(this)"&amp;gt;&amp;lt;span&amp;gt;
				&lt;/Begin&gt;
				&lt;End&gt;
					&amp;lt;/span&amp;gt;&amp;lt;/div&amp;gt;
				&lt;/End&gt;
			&lt;/MenuItemWrapper&gt;
			&lt;FilterAppliedWrapper&gt;
				&lt;Begin&gt;
					&amp;lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; margin-right: 1px; background-color: mediumblue; color: white; font-weight: bold;"&amp;gt;
				&lt;/Begin&gt;
				&lt;End&gt;
					&amp;lt;/span&amp;gt;
				&lt;/End&gt;
			&lt;/FilterAppliedWrapper&gt;
			&lt;SortAscIndicator&gt;
				&amp;amp;nbsp;&amp;lt;img src="Images/SortArrowUp.gif"&amp;gt;
			&lt;/SortAscIndicator&gt;
			&lt;SortDescIndicator&gt;
				&amp;amp;nbsp;&amp;lt;img src="Images/SortArrowDown.gif"&amp;gt;
			&lt;/SortDescIndicator&gt;
			&lt;GroupSeparator&gt;
				&amp;lt;div style="position:relative; width: 160px; height: 2px; overflow: hidden; display: block; border: 1px inset; margin: 3px;" &amp;gt;&amp;lt;/div&amp;gt;
			&lt;/GroupSeparator&gt;
		&lt;/HTMLWrappers&gt;
	&lt;/HTMLWrapperXML&gt;&lt;MenuGroupXML&gt;
		&lt;MenuGroups&gt;
		&lt;/MenuGroups&gt;
	&lt;/MenuGroupXML&gt;&lt;BaseFilterXML&gt;
		&lt;BaseFilterDef&gt;
		&lt;/BaseFilterDef&gt;
	&lt;/BaseFilterXML&gt;&lt;SortXML&gt;
		&lt;SortDef DefaultSortColumn="Console" DefaultSortDir="asc"&gt;
			&lt;colref id="Console" 
				SortAscString="EntityName asc"
				SortDescString="EntityName desc"
				SortDir="asc"
				SortOrder="1"/&gt;
		&lt;/SortDef&gt;
	&lt;/SortXML&gt;&lt;ReportTemplateXML&gt;&lt;/ReportTemplateXML&gt;&lt;ColumnStateXML&gt;
		&lt;state&gt;
			&lt;colref id="Console" width="490" hidden="false" /&gt;
			&lt;colref id="Synch" width="370" hidden="false" /&gt;
			&lt;colref id="Cluster" width="120" hidden="false" /&gt;
		&lt;/state&gt;
	&lt;/ColumnStateXML&gt;&lt;TableDefinitionXML&gt;
		&lt;table&gt;
			&lt;tableMenu/&gt;
			&lt;contextMenu/&gt;
			&lt;columns&gt;
				&lt;column id="Console"&gt;
					&lt;title&gt;Console&lt;/title&gt;
					&lt;action/&gt;
					&lt;menu/&gt;
					&lt;content&gt;
					    &amp;lt;div id="asset_div" noselect="" language="javascript" ondblclick="event.cancelBubble = this.noselect; return !this.noselect;" onmousedown="event.cancelBubble = this.noselect; return !this.noselect;" style="position: absolute; width: 100%; height: 100%; border-bottom: 1px solid #C8C8C8;" ExpandCollapseTrigger=0&amp;gt;
