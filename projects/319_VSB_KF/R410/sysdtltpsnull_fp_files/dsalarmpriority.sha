<DIV class=hvg.group.1 id=GrpGhost style="FONT-SIZE: 0pt; LEFT: 10%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 85%; POSITION: absolute; TOP: 10%; HEIGHT: 85%" tabIndex=-1 hdxproperties="fillColorBlink:0;Height:17;lineColorBlink:0;Width:17;"></DIV>]]></content></html></group><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=ConAlpPointid style="FONT-WEIGHT: 400; FONT-SIZE: 8pt; BORDER-LEFT-COLOR: #ffffff; LEFT: 40%; VISIBILITY: hidden; BORDER-BOTTOM-COLOR: #ffffff; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 30%; COLOR: #ff0000; BORDER-TOP-STYLE: none; BORDER-TOP-COLOR: #ffffff; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 20%; HEIGHT: 80%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-RIGHT-COLOR: #ffffff; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=-1 hdxproperties="fillColor:transparent;fillColorBlink:0;HDXBINDINGID:-4;indicateAlarmState:-1;indicateScanState:0;lineColor:#ffffff;lineColorBlink:0;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:0;" printDisplayValue = "9999.99">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
