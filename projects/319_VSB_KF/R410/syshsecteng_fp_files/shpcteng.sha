if me.QualityBad("CurrentPoint.PULSE1.PULSEWIDTH") and me.QualityBad("CurrentPoint.PULSE2.PULSEWIDTH") and me.QualityBad("CurrentPoint.PULSE3.PULSEWIDTH") then
	me.parentElement.style.visibility = "Hidden"
elseif not me.QualityBad("CurrentPoint.PULSE1.PULSEWIDTH") then
	me.value = me.DataValue("CurrentPoint.PULSE1.PULSEWIDTH")
	me.parentElement.style.visibility = "Inherit"
elseif not me.QualityBad("CurrentPoint.PULSE2.PULSEWIDTH") then
	me.value = me.DataValue("CurrentPoint.PULSE2.PULSEWIDTH")
	me.parentElement.style.visibility = "Inherit"
elseif not me.QualityBad("CurrentPoint.PULSE3.PULSEWIDTH") then
	me.value = me.DataValue("CurrentPoint.PULSE3.PULSEWIDTH")
	me.parentElement.style.visibility = "Inherit"
else
	me.parentElement.style.visibility = "Hidden"
end if]]></script><script event="onchange" language="VBScript"><![CDATA[On Error Resume Next

if not me.QualityBad("CurrentPoint.PULSE1.PULSEWIDTH") then
 	me.DataValue("CurrentPoint.PULSE1.PULSEWIDTH")= 	me.value
end if
if not me.QualityBad("CurrentPoint.PULSE2.PULSEWIDTH") then
 	me.DataValue("CurrentPoint.PULSE2.PULSEWIDTH")= 	me.value
end if
if not me.QualityBad("CurrentPoint.PULSE3.PULSEWIDTH") then
 	me.DataValue("CurrentPoint.PULSE3.PULSEWIDTH")= 	me.value
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PULSE1.PULSEWIDTH,PULSE2.PULSEWIDTH,PULSE3.PULSEWIDTH,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
