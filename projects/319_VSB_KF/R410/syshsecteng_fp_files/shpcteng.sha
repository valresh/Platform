	me.parentElement.style.visibility = "Hidden"
else
	if me.DataValue("CurrentPoint.SIGNALSELA.SELIN") = 0 then
		me.value = "None"
	elseif me.DataValue("CurrentPoint.SIGNALSELA.SELIN") = 1 then
		me.value = "SelectX"
	elseif me.DataValue("CurrentPoint.SIGNALSELA.SELIN") = 2 then
		me.value = "SelectX"
	elseif me.DataValue("CurrentPoint.SIGNALSELA.SELIN") = 3 then
		me.value = "SelectX"
	else
		me.value = ""
	end if
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::CurrentPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="SIGNALSELA.SELIN,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
