elseif ucase(me.value) = ucase("Select Y") then
	me.DataValue("CurrentPoint.SWITCHA.SELXFL[2]") = 1 
elseif ucase(me.value) = ucase("Select Z") then
	me.DataValue("CurrentPoint.SWITCHA.SELXFL[3]") = 1 
end if]]></script><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
me.ResetContent()
me.AddString "Select X"
me.AddString "Select Y"
me.AddString "Select Z"
if me.QualityBad("CurrentPoint.SWITCHA.SELXFL[1]") and me.QualityBad("CurrentPoint.SWITCHA.SELXFL[2]") and me.QualityBad("CurrentPoint.SWITCHA.SELXFL[3]") then
	me.parentElement.style.visibility = "Hidden"
else
	if me.DataValue("CurrentPoint.SWITCHA.SELXFL[1]") = 1 then
		me.value = "Select X"
	elseif me.DataValue("CurrentPoint.SWITCHA.SELXFL[2]") = 1 then
		me.value = "Select Y"
	elseif me.DataValue("CurrentPoint.SWITCHA.SELXFL[3]") = 1 then
		me.value = "Select Z"
	end if

end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="SWITCHA.SELXFL[1],SWITCHA.SELXFL[2],SWITCHA.SELXFL[3],"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
