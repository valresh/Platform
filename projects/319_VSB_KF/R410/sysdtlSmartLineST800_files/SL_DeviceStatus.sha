<DIV tabIndex=-1 id=textboxLabelLoopCurrentSaturated class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 8.67%; FONT-FAMILY: arial; WIDTH: 72.99%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 14.28%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:200;">Loop Current Saturated</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=0 id=textboxLoopCurrentSaturated class="hvg.textbox.1  HSC.ScriptDataObject.1 SL_Text_Right_BadQuality" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 8.67%; FONT-FAMILY: arial; WIDTH: 21.89%; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; LEFT: 78.1%; TOP: 14.28%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:#404040;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:17;lineColorBlink:False;LineStyle:0;styleClass:SL_Text_Right_BadQuality;textColor:#FFFFFF;textColorBlink:False;TotalRotation:-1;Width:60;"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_DeviceStatus_ondatachange(this, "SLAnalogPoint", "HCURRSAT", "YES", "NO");]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HCURRSAT,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=groupDeviceStatus class="hvg.group.1  HSC.ScriptDataObject.1" style="FONT-SIZE: 0pt; HEIGHT: 196px; WIDTH: 274px; POSITION: absolute; LEFT: 94px; TOP: 24px; BEHAVIOR: url(#HDXVectorFactory#group) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:196;lineColorBlink:False;styleClass:;Width:274;"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");

	var displayType = SL_FetchScriptData(this, "SLAnalogPoint", "display_type_code");
	if (displayType.changed && displayType.valid)
	{
		var maintenanceModeVisibility = "hidden";
		var displayTypeString = SL_LocalDisplayTypes[displayType.value].type;

		if ((displayTypeString == "Advanced") || (displayTypeString == "Basic"))
			maintenanceModeVisibility = "visible";

		SL_LogDebugLevelMessage(5, "groupDeviceStatus_ondatachange", "display type = " + displayType.value + ", maintenance mode visibility = " + maintenanceModeVisibility);

		textboxMaintenanceMode.style.visibility = maintenanceModeVisibility;
		textboxLabelMaintenanceMode.style.visibility = maintenanceModeVisibility;
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="display_type_code,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></group></shape></shapes></shapefile>