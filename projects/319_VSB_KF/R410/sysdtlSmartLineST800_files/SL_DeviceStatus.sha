<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="274px" height="196px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="" language="JScript" id="547DF5F5-9281-499E-8113-D2E06DDB8FA7"><![CDATA[function SL_DeviceStatus_ondatachange(dataProvider, pointName, parameterName, trueValue, falseValue)
{
	SL_LogEvent(dataProvider, "ondatachange");

	var scriptData = SL_FetchScriptData(dataProvider, pointName, parameterName);
	if (scriptData.changed)
	{
		if (scriptData.value == 1)
		{
			dataProvider.value = trueValue;
		}
		else
		{
			dataProvider.value = falseValue;
		}

		if (scriptData.valid)
		{
			dataProvider.styleClass = "SL_Text_Right_Normal";
		}
		else
		{
			dataProvider.styleClass = "SL_Text_Right_BadQuality";
		}
	}
}]]></script><script event="onshapeload" language="JScript" id=""><![CDATA[	var tamperModeSupported = false;
	if (this.GetCustomProperty("Value", "TamperMode") == 1)
		tamperModeSupported = true;

	SL_SetVisibility(textboxLabelTamperDetectMode, tamperModeSupported);
	SL_SetVisibility(textboxTamperDetectMode, tamperModeSupported);

	var maintenanceModeSupported = false;
	if (this.GetCustomProperty("Value", "MaintenanceMode") == 1)
		maintenanceModeSupported = true;

	SL_SetVisibility(textboxLabelMaintenanceMode, maintenanceModeSupported);
	SL_SetVisibility(textboxMaintenanceMode, maintenanceModeSupported);]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="Point name" defaultvalue=""/><parameter name="TamperMode" type="Value" description="Boolean indicating if Tamper Detect Mode is supported." defaultvalue=""/><parameter name="MaintenanceMode" type="Value" description="Boolean indicating if Maintenance Mode is supported." defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelConfigChanged class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 8.67%; FONT-FAMILY: arial; WIDTH: 72.99%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 29.59%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:200;">Configuration Changed</DIV>]]></content></html></element><element><html><content><![CDATA[
