<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="280px" height="66px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="" language="JScript" id="7A923436-F0A8-4253-BDD8-45911C58B076"><![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///
/// SL_Overview_Process.sha
///
/// <summary>
/// Combines the user controls to display the process related parameters that are common to all SmartLine transmitters:
///		Loop Current
///		Percent of Range
/// </summary>
///
/// Revision History
///
/// EXP510.1-34		May 21, 2018	Upgraded the shape for the Percent of Range value and string
/// EXP510.1-32		May 4, 2018		Initial Experion R510 testbed release
///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]></script><script event="" language="JScript" id="485137D7-B633-4BCB-8C6F-283C9DF1EB97"><![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///
/// SL_AlpNum_Unit_OneString.sha
///
/// <summary>
/// Formats a numeric value and the corresponding unit symbol into a single string displayed in a textbox.
/// </summary>
///
/// Revision History
///
/// EXP510.1-34		May 21, 2018	Improved debug messaging and error handling
/// EXP510.1-32		May 4,  2018	Initial Experion R510 testbed release
///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

function SL_ValueAndUnits_onDataChange(alphaNumeric)
{
	if ((alphaNumeric != undefined) && (alphaNumeric != null))
	{
		try
		{
			SL_LogFunctionParameters(2, "SL_ValueAndUnits_onDataChange", "alphaNumeric = " + alphaNumeric.id);

			// Walk back up the hierarchy to get the parent shape so that the custom properties can be fetched.
			var shape = alphaNumeric.parentElement;
			if ((shape != undefined) && (shape != null))
			{
				// Check to see if the units come from a point parameter or are static.
				var unitScriptData = new SL_ScriptData("UnitParam");
				var unitString;

				if (shape.GetCustomProperty("Parameter", "UnitParam") != "")
				{
					unitScriptData.Fetch(alphaNumeric, "SLAnalogPoint");
					if (unitScriptData.valid)
					{
						unitString = HART_GetShortSymbolFromStandardUnitCode(unitScriptData.value);
					}
				}
				else
				{
					unitScriptData.valid = true;
					unitString = shape.GetCustomProperty("Value", "Unit");
				}

				var valueScriptData = new SL_ScriptData("SLAnalogPtParam");
				var valueString = "";

				valueScriptData.Fetch(alphaNumeric, "SLAnalogPoint");

				if (valueScriptData.changed || unitScriptData.changed)
				{
					if (typeof(valueScriptData.value) == "number")
					{
						var useNumDecimals = shape.GetCustomProperty("Value", "UseNumDecimals");
						var numDecimals = shape.GetCustomProperty("Value", "NumDecimals");
						if (useNumDecimals == 0)
						{
							numDecimals = SL_GetNumDecimals(valueScriptData.value);
						}

						valueString = valueScriptData.value.toFixed(numDecimals).toString();
					}

					if ((unitString != undefined) && (unitString != ""))
					{
						valueString += " " + unitString;
					}
					alphaNumeric.value = valueString;

					var styleName = "SL_Numeric_";

					if (shape.GetCustomProperty("Value", "TextAlign") == 1)
						styleName += "Left_";

					if (valueScriptData.valid && unitScriptData.valid)
					{
						styleName += "Normal";
					}
					else
					{
						styleName += "BadQuality";
					}
					alphaNumeric.StyleClass = styleName;
					
					SL_LogDebugLevelMessage(4, "SL_ValueAndUnits_onDataChange", "string = " + valueString + ", style = " + styleName);
				}
			}
		}
		catch (error)
		{
			SL_LogErrorMessage("SL_ValueAndUnits_onDataChange", "Could not set the value, unit or style for: alphaNumeric = " + alphaNumeric.id, error);
			alphaNumeric.StyleClass = "SL_Numeric_Error";
		}
	}

}]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="Point name" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxHeader class="hvg.textbox.1 SL_GroupHeader" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 30.3%; FONT-FAMILY: arial; WIDTH: 78.57%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:20;lineColorBlink:False;LineStyle:0;styleClass:SL_GroupHeader;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:220;">Process</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelLoopCurrent class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; CURSOR: hand; TEXT-DECORATION: ; HEIGHT: 30.3%; FONT-FAMILY: arial; WIDTH: 71.42%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 34.84%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:20;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:200;">Loop Current</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelPercentOfRange class="hvg.textbox.1 SL_Label_Normal" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 30.3%; FONT-FAMILY: arial; WIDTH: 71.42%; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: left; LEFT: 0%; TOP: 69.69%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:20;lineColorBlink:False;LineStyle:0;styleClass:SL_Label_Normal;textColor:#404040;textColorBlink:False;TotalRotation:-1;Width:200;">%&nbsp;of Range</DIV>]]></content></html></element><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shapePercentOfRange_alphaValueUnitString class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Numeric_BadQuality" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 100%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #404040; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#404040;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SL_Numeric_BadQuality;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");
	SL_ValueAndUnits_onDataChange(this);]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="percentRange,,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=shapePercentOfRange class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 30.3%; FONT-FAMILY: Arial; WIDTH: 42.85%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 56.78%; TOP: 69.69%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink)" hdxproperties="fillColorBlink:False;Height:20;lineColorBlink:False;Width:120;" value = "1" src = ".\SL_Overview_Process_files\SL_AlpNum_Unit_OneString.sha" parameters = "Point?SLAnalogPoint:{%Point::SLAnalogPoint%};Parameter?SLAnalogPtParam:percentRange;Value?Unit:%;Parameter?UnitParam:;Value?UseNumDecimals:1;Value?NumDecimals:1;Value?TextAlign:0;" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content><scripts><script event="onshapeload" language="JScript"><![CDATA[	SL_LogEvent(this, "onshapeload");
	SL_SetReverseVideo(shapePercentOfRange_alphaValueUnitString, this.GetCustomProperty("Value", "TextAlign"), "Numeric");]]></script></scripts></html></group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaLoopCurrent class="hsc.alpha.1  HSC.ScriptDataObject.1 SL_Numeric_Normal" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 30.3%; FONT-FAMILY: arial; WIDTH: 42.85%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #404040; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 56.42%; TOP: 34.84%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SL_Numeric_Normal;textColor:#404040;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var loopCurrent = (this.DataValue("SLAnalogPoint.PVRAW")/100) * (20 - 4) + 4;
	this.value = loopCurrent.toFixed(2) + " mA";]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PVRAW,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=groupOverviewProcess class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 66px; WIDTH: 280px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:66;lineColorBlink:False;Width:280;"></DIV>]]></content></html></group></shape></shapes></shapefile>