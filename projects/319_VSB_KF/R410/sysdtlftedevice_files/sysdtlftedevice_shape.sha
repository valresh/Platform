<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="Computer System Properties" description="System properties shape for computers detail display - simple version - as little scripting as possible" useFirstShapeForBadValue="0" width="720px" height="470px"><versionheaders><versionheader name="PS" value="5.2"/></versionheaders><scripts><script event="" language="VBScript" id="8D681DCA-0E96-4302-97D6-EE134C594C9E"><![CDATA['
' General Section (sysdtlftedevice_shape.sha)

'
sub InitFteDeviceShape(objShape, sPoint, sPdTagLcl)
DIM sPartPath

	if sPdTagLcl = "" and objShape.GetCustomProperty("Parameter", "parDeviceIndex") <> "" then
		with objShape
			.autoReloadContent = false
			.SetCustomProperty "Parameter", "parDeviceIndex", ""
			.SetCustomProperty "Parameter", "parDeviceType", ""
			.SetCustomProperty "Parameter", "parDiagMsgInterval", ""
			.SetCustomProperty "Parameter", "parDupDetState", ""
			.SetCustomProperty "Parameter", "parHseDeviceVer", ""
			.SetCustomProperty "Parameter", "parMaxDevIx", ""
			.SetCustomProperty "Parameter", "parNumHseIf", ""
			.SetCustomProperty "Parameter", "parStatusAA", ""
			.SetCustomProperty "Parameter", "parStatusAB", ""
			.SetCustomProperty "Parameter", "parStatusBA", ""
			.SetCustomProperty "Parameter", "parStatusBB", ""
			.SetCustomProperty "Parameter", "parAnnuncInterval", ""
			.SetCustomProperty "Parameter", "parAnnuncVer", ""
			.SetCustomProperty "Parameter", "parDeviceID", ""
			.SetCustomProperty "Parameter", "parDevRedundState", ""
			.SetCustomProperty "Parameter", "parLanRedundPort", ""
			.SetCustomProperty "Parameter", "parOperIpAddr", ""
			.SetCustomProperty "Parameter", "parSmkState", ""
			.SetCustomProperty "Point", "SpsPoint", ""
			.ReloadContent
		end with
	elseif sPdTagLcl <> "" then
		sPartPath = "localhost.[ROOT\HONEYWELL].TPS_FTENODE.PDTAG='" & sPdTagLcl & "'."
		if objShape.GetCustomProperty("Parameter", "parDeviceIndex") <> sPartPath & "DeviceIndex" then
			with objShape
				.autoReloadContent = false
				.SetCustomProperty "Parameter", "parDeviceIndex", sPartPath & "DeviceIndex"
				.SetCustomProperty "Parameter", "parDeviceType", sPartPath & "DeviceType"
				.SetCustomProperty "Parameter", "parDiagMsgInterval", sPartPath & "DiagnosticMsgInterval"
				.SetCustomProperty "Parameter", "parDupDetState", sPartPath & "DuplicateDetectionState"
				.SetCustomProperty "Parameter", "parHseDeviceVer", sPartPath & "HseDeviceVersionNumber"
				.SetCustomProperty "Parameter", "parMaxDevIx", sPartPath & "MaxDeviceIndex"
				.SetCustomProperty "Parameter", "parNumHseIf", sPartPath & "NumHseInterfaces"
				.SetCustomProperty "Parameter", "parStatusAA", sPartPath & "StatusAA"
				.SetCustomProperty "Parameter", "parStatusAB", sPartPath & "StatusAB"
				.SetCustomProperty "Parameter", "parStatusBA", sPartPath & "StatusBA"
				.SetCustomProperty "Parameter", "parStatusBB", sPartPath & "StatusBB"
				.SetCustomProperty "Parameter", "parAnnuncInterval", sPartPath & "AnnunciationInterval"
				.SetCustomProperty "Parameter", "parAnnuncVer", sPartPath & "AnnunciationVersionNumber"
				.SetCustomProperty "Parameter", "parDeviceID", sPartPath & "DeviceID"
				.SetCustomProperty "Parameter", "parDevRedundState", sPartPath & "DeviceRedundancyState"
				.SetCustomProperty "Parameter", "parLanRedundPort", sPartPath & "LanRedundancyPort"
				.SetCustomProperty "Parameter", "parOperIpAddr", sPartPath & "OperationalIpAddress"
				.SetCustomProperty "Parameter", "parSmkState", sPartPath & "SmkState"
				.SetCustomProperty "Point", "SpsPoint", sPoint
				.ReloadContent
			end with
		end if
	end if
end sub

' returns the data value
' on return, Err.Number can be:
' 0 - quality good, returned data in sResult
' vbObjectError + 1000 - quality not good
' vbObjectError + 1001 - cannot access data
' other - error accessing data
function SimpleDataFetch(objAccess, sDataPath)
DIM fQualGood
	on error resume next
	Err.Clear
	fQualGood = objAccess.QualityGood(sDataPath)
	if Err.Number <> 0 then
		SimpleDataFetch = 0
		' return whatever non-zero value is in Err.Number
	else
		if fQualGood then
			SimpleDataFetch = objAccess.DataValue(sDataPath)
		else
			SimpleDataFetch = 0
			Err.Raise vbObjectError + 1000
		end if
	end if
end function

' returns the data value and visually updates element to show data state
' on return, Err.Number can be:
' 0 - quality good, returned data in sResult, visuals set for good data
' vbObjectError + 1000 - quality not good, text and visuals set for bad qual
' vbObjectError + 1001 - cannot access data, element hidden
' other - error accessing data, no visual changes
function DataFetchShowState(objAccess, sDataPath)
DIM fQualGood
	on error resume next
	DataFetchShowState = SimpleDataFetch(objAccess, sDataPath)
	select case Err.Number
		case 0						objAccess.style.visibility = "inherit" : objAccess.textColor = vbBlack : objAccess.fillColor  = "transparent"
		case vbObjectError + 1000	objAccess.style.visibility = "inherit" : objAccess.textColor = vbRed : objAccess.fillColor  = vbBlack : objAccess.value = sErrorString
		case vbObjectError + 1001	objAccess.style.visibility = "hidden"
		case other					' do nothing - should correct itself soon
	end select
end function
' General Section (sysdtlftedevice_shape.sha)
']]></script></scripts><parameters><parameter name="PdTag" type="Value" description="selects specific fte device" defaultvalue=""/><parameter name="SpsPoint" type="Point" description="Internal" defaultvalue=""/><parameter name="parDeviceIndex" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parDeviceType" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parDiagMsgInterval" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parDupDetState" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parHseDeviceVer" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parMaxDevIx" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parNumHseIf" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parStatusAA" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parStatusAB" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parStatusBA" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parStatusBB" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parAnnuncInterval" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parAnnuncVer" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parDeviceID" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parDevRedundState" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parLanRedundPort" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parOperIpAddr" type="Parameter" description="Internal" defaultvalue=""/><parameter name="parSmkState" type="Parameter" description="Internal" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=rectSizeHolder style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#rect); OVERFLOW: hidden; WIDTH: 100%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 100%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:470;LineColor:#0000ff;lineColorBlink:False;LineStyle:1;textColor:#000000;Width:720;"></DIV>]]></content></html></element><group><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=SmkState_caption style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 29.68%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 89.22%; HEIGHT: 10.34%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:171;">SMK State:</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=SmkState_alpha title="Smk State" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 30.55%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); OVERFLOW: hidden; WIDTH: 69.44%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 89.22%; HEIGHT: 10.34%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:80;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
'Sub SmkState_alpha_ondatachange
DIM sDataPath, sResult, nResult, sString
	on error resume next
	sDataPath = "{%Point::SPSPoint%}.{%Parameter::parSmkState%}"
	sResult = DataFetchShowState(me, sDataPath)
	if Err.Number = 0 then
		nResult = (CInt(sResult) / 2) and 127
		if nResult = 1 then
			sString = textSmkStNoTag.value
		elseif nResult = 2 then
			sString = textSmkStOper.value
		else
			sString = textSmkStUndefState.value
		end if
		if (CInt(sResult) and 1) <> 0 then sString = sString & textSmkStSNTPSync.value
		me.value = sString
	end if
'End Sub SmkState_alpha_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SpsPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::parSmkState%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=OperIpAddr_caption style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 29.68%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 79.31%; HEIGHT: 10.34%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:171;">Operational Ip Address:</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=OperIpAddr_alpha title="Operational IP Address" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 30.55%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); OVERFLOW: hidden; WIDTH: 69.44%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 79.31%; HEIGHT: 10.34%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:80;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
