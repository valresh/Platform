<DIV class=hvg.textbox.1 id=DupDetState_caption style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0.27%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 23.75%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 20.63%; HEIGHT: 5.1%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:171;">Duplicate Detection State:</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=DupDetState_alpha title="Duplicate Detection State" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 24.72%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); OVERFLOW: hidden; WIDTH: 55.55%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 20.63%; HEIGHT: 5.1%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:80;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
'Sub DupDetState_alpha_ondatachange
DIM sDataPath, sResult
	on error resume next
	sDataPath = "{%Point::SPSPoint%}.{%Parameter::parDupDetState%}"
	sResult = DataFetchShowState(me, sDataPath)
	if Err.Number = 0 then
		select case sResult
			case "0" me.value = textDupDetNoDuplicates.value
			case "1" me.value = textDupDetDupDevIndex.value
			case "2" me.value = textDupDetNoDupPdTag.value
			case "3" me.value = textDupDetDupBoth.value
			case else me.value = textDupDetUndefState.value
		end select
	end if
'End Sub DupDetState_alpha_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SpsPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::parDupDetState%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=DiagMsgIntvl_caption style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0.27%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 23.75%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 15.74%; HEIGHT: 5.1%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:171;">Diagnostic Message Interval:</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=DiagMsgIntvl_alpha title="Diagnostic Message Interval" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 24.72%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); OVERFLOW: hidden; WIDTH: 55.55%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 15.74%; HEIGHT: 5.1%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:80;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
'Sub DiagMsgIntvl_alpha_ondatachange
DIM sDataPath, sResult
	on error resume next
	sDataPath = "{%Point::SPSPoint%}.{%Parameter::parDiagMsgInterval%}"
	sResult = DataFetchShowState(me, sDataPath)
	if Err.Number = 0 then me.value = sResult
'End Sub DiagMsgIntvl_alpha_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SpsPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::parDiagMsgInterval%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=DevType_caption style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0.27%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 23.75%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 10.85%; HEIGHT: 5.1%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:171;">Device Type:</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=DevType_alpha title="Device Type" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 24.72%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); OVERFLOW: hidden; WIDTH: 55.55%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 10.85%; HEIGHT: 5.1%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:80;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
'Sub DevType_alpha_ondatachange
DIM sDataPath, sString, nResult
	on error resume next
	sDataPath = "{%Point::SPSPoint%}.{%Parameter::parDeviceType%}"
	nResult = CInt(DataFetchShowState(me, sDataPath))
	if Err.Number = 0 then
		if (nResult and 7) = 0 then
			me.value = textDevTypeNonRedund.value
		else
			sString = ""
			if (nResult and 128) <> 0 then sString = sString & textDevTypeLinking.value
			if (nResult and 64) <> 0 then sString = sString & textDevTypeIOGateway.value
			if (nResult and 32) <> 0 then sString = sString & textDevTypeHSEField.value
			if (nResult and 16) <> 0 then sString = sString & textDevTypeH1.value
			if (nResult and 3) = 1 then
				sString = sString & textDevTypeD2.value
			elseif (nResult and 3) = 2 then
				sString = sString & textDevTypeD3.value
			end if
			' sString always starts with a comma, so stip that
			me.value = mid(sString, 2)
		end if
	end if
'End Sub DevType_alpha_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SpsPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::parDeviceType%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=DevIndex_caption style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0.27%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 23.75%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 5.95%; HEIGHT: 5.1%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:171;">Device Index:</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=DevIndex_alpha title="Device Index" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 24.72%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); OVERFLOW: hidden; WIDTH: 55.55%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 5.95%; HEIGHT: 5.1%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:80;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
'Sub DevIndex_alpha_ondatachange
DIM sDataPath, sResult
	on error resume next
	sDataPath = "{%Point::SPSPoint%}.{%Parameter::parDeviceIndex%}"
	sResult = DataFetchShowState(me, sDataPath)
	if Err.Number = 0 then
		if sResult <> 0 then
			grFTEOnly.style.visibility = "inherit"
			me.value = sResult
		else
			me.value = textDevIxNotAssigned.value
		end if
	end if
'End Sub DevIndex_alpha_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SpsPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::parDeviceIndex%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=pdtag_caption style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0.27%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 23.75%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 1.06%; HEIGHT: 5.1%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:171;">PdTag:</DIV>]]></content></html></element><element><html><content><![CDATA[
