'Sub NumHseIf_alpha_ondatachange
DIM sDataPath, sResult
	on error resume next
	sDataPath = "{%Point::SPSPoint%}.{%Parameter::parNumHseIf%}"
	sResult = DataFetchShowState(me, sDataPath)
	if Err.Number = 0 then
		me.value = sResult
		if sResult > 1 then grFTEOnly.style.visibility = "inherit"
	end if
'End Sub NumHseIf_alpha_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SpsPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::parNumHseIf%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
