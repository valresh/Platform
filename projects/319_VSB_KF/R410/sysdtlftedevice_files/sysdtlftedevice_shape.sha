<DIV class=hvg.textbox.1 id=DevRedundState_caption style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 29.68%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 59.48%; HEIGHT: 10.34%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:24;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:171;">Device Redundancy State:</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=DevRedundState_alpha title="Device Redundancy State" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 30.55%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); OVERFLOW: hidden; WIDTH: 69.44%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 59.48%; HEIGHT: 10.34%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:80;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
'Sub DevRedundState_alpha_ondatachange
DIM sDataPath, nResult
	on error resume next
	sDataPath = "{%Point::SPSPoint%}.{%Parameter::parDevRedundState%}"
	nResult = CInt(DataFetchShowState(me, sDataPath))
	if Err.Number = 0 then
		if (nResult and 12) = 0 then
			sString = textRedundStNonRedund.value
		else
			if (nResult and 12) = 4 then
				sString = textRedundStRedundPrim.value
			else
				sString = textRedundStRedundSec.value
			end if
			if (nResult and 3) = 1 then
				sString = sString & textDevTypeD2.value
			elseif (nResult and 3) = 2 then
				sString = sString & textDevTypeD3.value
			end if
		end if
		me.value = sString
	end if
'End Sub DevRedundState_alpha_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SpsPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::parDevRedundState%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
