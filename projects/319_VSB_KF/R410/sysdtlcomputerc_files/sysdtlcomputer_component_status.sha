<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="720px" height="474px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><scripts><script event="" language="VBScript" id="4F3B60C4-140C-4F86-B7CD-E2D49E3F5B6F"><![CDATA['
'General Section (sysdtlcomputer_component_detail.sha)
Dim nStartStopBtnState
Dim sDtlProgId, sDtlDevSts, sDtlCompType

sub InitCompStatus(objShape, sCompName)
Dim sParamBase, obj, objGrp
	sDtlProgId = ""
	nStartStopBtnState = 0			' undefined - disable button
	set objGrp = objShape.Objects("grpInitiallyHidden")
	for each obj in objGrp.children
		obj.style.visibility = "hidden"
	next
	objShape.autoReloadContent = false
	objShape.SetCustomProperty "Value", "StatusCompName", sCompName
	if sCompName = "" then
		with objShape
			.SetCustomProperty "Parameter", "parCategories", ""
			.SetCustomProperty "Parameter", "parDeviceInfo", ""
			.SetCustomProperty "Parameter", "parDeviceStatus", ""
			.SetCustomProperty "Parameter", "parComponentType", ""
			.SetCustomProperty "Parameter", "parConfigDll", ""
			.SetCustomProperty "Parameter", "parAlias", ""
			.SetCustomProperty "Parameter", "parAuxDisplayProgId", ""
			.SetCustomProperty "Parameter", "parProgId", ""
			.SetCustomProperty "Parameter", "parComponentInfo", ""
			.SetCustomProperty "Parameter", "parPID", ""
			.SetCustomProperty "Parameter", "parComponentStatus", ""
		end with
	else
		sParamBase = "[ROOT\HONEYWELL].TPS_HCICOMPONENT.NAME='" & sCompName & "'"
		with objShape
			.SetCustomProperty "Parameter", "parCategories", sParamBase & ".Categories"
			.SetCustomProperty "Parameter", "parDeviceInfo", sParamBase & ".DeviceStatusArray.3"
			.SetCustomProperty "Parameter", "parDeviceStatus", sParamBase & ".DeviceStatusArray.1"
			.SetCustomProperty "Parameter", "parComponentType", sParamBase & ".ComponentType"
			.SetCustomProperty "Parameter", "parConfigDll", sParamBase & ".ConfigDll"
			.SetCustomProperty "Parameter", "parAlias", sParamBase & ".Alias"
			.SetCustomProperty "Parameter", "parAuxDisplayProgId", sParamBase & ".AuxDisplayProgId"
			.SetCustomProperty "Parameter", "parProgId", sParamBase & ".ProgId"
			.SetCustomProperty "Parameter", "parComponentInfo", sParamBase & ".Description"
			.SetCustomProperty "Parameter", "parPID", sParamBase & ".StatusArray.2"
			.SetCustomProperty "Parameter", "parComponentStatus", sParamBase & ".StatusArray.1"
		end with
	end if
	objShape.ReloadContent
end sub
' End General Section  (sysdtlcomputer_component_detail.sha)
']]></script></scripts><parameters><parameter name="StatusCompName" type="Value" description="Name of component this shape is to display" defaultvalue=""/><parameter name="parCategories" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parDeviceInfo" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parDeviceStatus" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parComponentType" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parConfigDll" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parAlias" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parAuxDisplayProgId" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parProgId" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parComponentInfo" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parPID" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="parComponentStatus" type="Parameter" description="filled in by InitCompStatus" defaultvalue=""/><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><group><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=rectSizeHolder style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#rect); OVERFLOW: hidden; WIDTH: 100%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 99.15%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:470;LineColor:#00ff00;lineColorBlink:False;LineStyle:1;textColor:#000000;Width:720;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=recHeaderArea style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#rect); OVERFLOW: hidden; WIDTH: 100%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 8.43%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:40;lineColorBlink:False;Width:720;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textTitleStartStop style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 67.36%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 8.05%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 95.78%; HEIGHT: 3.37%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:58;">Start/Stop</DIV>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA['
' textTitleStartStop_onclick
'
' this is the routine to configure the start/stop button
' based on information we have already collected depends on:
'		sCompStsComputerTarget - set by InitCompStatus
'		nStartStopBtnState - set by textDisplayCompStatus.ondatachange
'		sDtlProgId - set by alphaDisplayProgid.onupdate
	Dim nState, sServer
	nState = nStartStopBtnState
	sServer = window.external.Parent.RuntimeStatus.ServerName
	if sDtlProgId = "" then nState = 3				' or yet unknown progid
	' if we let them stop SPS, we won't be able to do anything
	' so for that one specific case, disable the stop button
	if (nState = 2) and (StrComp(sDtlProgId, "Hci.spsdss", vbTextCompare) = 0) then nState = 3
	ctlStart.Computer = sCompStsComputerTarget
	ctlStart.Component = sSelectedComponent
	ctlStop.Computer = sCompStsComputerTarget
	ctlStop.Component = sSelectedComponent
	ctlCheckpoint.Computer = sCompStsComputerTarget
	ctlCheckpoint.Component = sSelectedComponent
	select case nState
		case 0	ctlStop.enabled = FALSE  : ctlStart.enabled = FALSE			' unknown, disable both
		case 1	ctlStop.enabled = FALSE  : ctlStart.enabled = TRUE		' stopped, enable start
		case 2	ctlStop.enabled = TRUE : ctlStart.enabled = FALSE			' running, enable stop
		case 3	ctlStop.enabled = FALSE  : ctlStart.enabled = FALSE			' special case, disable both
	end select

' textTitleStartStop_onclick
']]></script></scripts></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textTitleStop style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 59.02%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 8.05%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 95.78%; HEIGHT: 3.37%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:58;">Stop</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textTitleStart style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 50.69%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 8.05%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 95.78%; HEIGHT: 3.37%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:58;">Start</DIV>]]></content></html></element><group><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alphaDevStatus style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 57.47%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); OVERFLOW: hidden; WIDTH: 22.99%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 0%; HEIGHT: 75%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;indicateScanState:0;lineColor:transparent;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
'Sub alphaDevStatus_onupdate
	on error resume next
	if NOT IsStsGoodQuality(me) then exit sub
	sDtlDevSts = me.value
	' have to update device status based on all 3 values below, so call convert from all 3 places
	alphaDisplayDevStatus.value = ConvertDevStatus(sDtlDevSts, sDtlCompType, sSelectedComponentStatus)
	alphaDisplayDevStatus.style.visibility = "inherit"
'End Sub alphaDevStatus_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::parDeviceStatus%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alphaCompType style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 28.73%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); OVERFLOW: hidden; WIDTH: 22.98%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 0%; HEIGHT: 75%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;indicateScanState:0;lineColor:transparent;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
'Sub alphaCompType_onupdate
	on error resume next
	if NOT IsStsGoodQuality(me) then exit sub
	sDtlCompType = me.value
	select case sDtlCompType
		case "1"	alphaDisplayCompType.value = "OPC"
		case "2"	alphaDisplayCompType.value = "TRS"
		case "3"	alphaDisplayCompType.value = "HCI"
		case "4"	alphaDisplayCompType.value = "MONITORED"
		case "5"	alphaDisplayCompType.value = "HCI / STATUS"
		case "6"	alphaDisplayCompType.value = "HCI / STATUS (MONITORED)"
		case other	alphaDisplayCompType.value = "**none**"
	end select
	alphaDisplayCompType.style.visibility = "inherit"
	' have to update device status based on all 3 values below, so call convert from all 3 places
	alphaDisplayDevStatus.value = ConvertDevStatus(sDtlDevSts, sDtlCompType, sSelectedComponentStatus)
	alphaDisplayDevStatus.style.visibility = "inherit"
'End Sub alphaCompType_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::parComponentType%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alphaCompStatus style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); OVERFLOW: hidden; WIDTH: 22.98%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 0%; HEIGHT: 85%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;indicateScanState:0;lineColor:transparent;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
'Sub alphaCompStatus_onupdate
DIM sResult
	on error resume next
	if NOT IsStsGoodQuality(me) then exit sub
	nStartStopBtnState = 0		' assume unknown, will disable button is not set below
	sResult = me.value
	alphaDisplayCompStatus.value = ConvertStatus(sResult)
	alphaDisplayCompStatus.style.visibility = "inherit"
	if sSelectedComponentStatus <> sResult then
		sSelectedComponentStatus = sResult
		UpdateAuxDisplayButton
	end if
	nStartStopBtnState = StatusToStartStop(sResult)
	textTitleStartStop.onclick		' update start/stop button
	' have to update device status based on all 3 values below, so call convert from all 3 places
	alphaDisplayDevStatus.value = ConvertDevStatus(sDtlDevSts, sDtlCompType, sSelectedComponentStatus)
	alphaDisplayDevStatus.style.visibility = "inherit"
'End Sub alphaCompStatus_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::parComponentStatus%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV class=hvg.group.1 id=grpData style="FONT-SIZE: 0pt; LEFT: 75.83%; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 24.16%; POSITION: absolute; TOP: 95.78%; HEIGHT: 4.21%" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:20;lineColorBlink:False;Width:174;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV class=hvg.group.1 id=grpAlwaysHidden style="FONT-SIZE: 0pt; LEFT: 0%; VISIBILITY: hidden; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 100%; POSITION: absolute; TOP: 0%; HEIGHT: 100%" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:474;lineColorBlink:False;Width:720;"></DIV>]]></content></html></group><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textDevInfoCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 66.45%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">Device Info:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textDevStatusCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 60.75%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">Device Status:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textCompTypeCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 55.06%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">Component Type:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textConfigDllCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 49.36%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">Config Dll:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textAliasCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 43.67%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">Alias:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textAuxDisplayProgidCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 37.97%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">Aux. Display ProgID:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textProgidCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 32.27%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">ProgID:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textCompInfoCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 26.58%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">Component Info:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textPidCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 20.67%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">PID:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textCompStatusCaption style="FONT-WEIGHT: 400; FONT-SIZE: 10pt; LEFT: 0.83%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 27.63%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 14.97%; HEIGHT: 5.48%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:26;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:199;">Component Status:</DIV>]]></content></html></element><element><html><content><![CDATA[
