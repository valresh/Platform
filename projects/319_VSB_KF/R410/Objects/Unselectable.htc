***************************************************************************
This lightweight, attached behavior prevents the contents of an HTML 
element from being selected.
***************************************************************************
-->
<public:component name="Unselectable" urn="Unselectable" lightWeight="true">
	<public:attach event="onselectstart" onevent="javascript: try{ CancelEvent(); } catch(e){}" for="element"/>
	<public:attach event="ondragstart" onevent="javascript: try{ CancelEvent(); } catch(e){}" for="element"/>
</public:component>
<script language="JavaScript" type="text/JavaScript">

	//-----------------------------------------------------------------------
	// CancelEvent
	//-----------------------------------------------------------------------
	// This function prevents a DHTML event from proceeding any further.
	//-----------------------------------------------------------------------
	function CancelEvent()
	{
		window.event.returnValue = false;
	}
</script>