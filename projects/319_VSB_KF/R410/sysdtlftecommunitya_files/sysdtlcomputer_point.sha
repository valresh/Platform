<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="150px" height="14px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><parameters><parameter name="SPSPoint" type="Point" description="input" defaultvalue=""/><parameter name="SPSPath" type="Parameter" description="input" defaultvalue=""/><parameter name="SPSValue" type="Value" description="output" defaultvalue=""/><parameter name="SPSValueStatus" type="Value" description="output" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV class="hvg.textbox.1 HSC.ScriptDataObject.1" id=textSPSValue style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 0%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); OVERFLOW: hidden; WIDTH: 100%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 0%; HEIGHT: 100%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:14;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:150;">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
'Sub textSPSValue_ondatachange
DIM sDataPath, sValue, fQualGood
	on error resume next
	group001.parentElement.autoReloadContent = false
	sDataPath = "{%Point::SPSPoint%}." & group001.parentElement.GetCustomProperty("Parameter", "SPSPath")
	Err.Clear
	fQualGood = me.QualityGood(sDataPath)
	if (Err.Number = 0) and fQualGood and me.DataChanged(sDataPath) then
		sValue = me.DataValue(sDataPath)
		me.value = sValue					' useful for debug
		group001.parentElement.SetCustomProperty "Value", "SPSValue", sValue
		group001.parentElement.SetCustomProperty "Value", "SPSValueStatus", "good"
	else
		me.value = "bad"					' useful for debug
		group001.parentElement.SetCustomProperty "Value", "SPSValueStatus", "bad"
	end if
	group001.parentElement.onclick
'End Sub textSPSValue_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SPSPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::SPSPath%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV class=hvg.group.1 id=group001 style="FONT-SIZE: 0pt; LEFT: 0px; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 150px; POSITION: absolute; TOP: 0px; HEIGHT: 14px" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:14;lineColorBlink:False;Width:150;"></DIV>]]></content></html></group></shape></shapes></shapefile>
