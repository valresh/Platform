	selectedRowIndex = 0;

	DisplayFaultsResolutions();
	HighlightFault();
	ShowHidePrevNext();

	//DisplayFaultsResolutions(objRef_groupFaults, objRef_alphaCause, objRef_alphaResolution);
	//HighlightFault(objRef_groupFaults);
	//ShowHidePrevNext(objRef_pushbuttonPrev, objRef_pushbuttonNext);]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=pushbuttonNext class=hsc.button.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; BORDER-TOP: #ffffff 1px; HEIGHT: 2.77%; FONT-FAMILY: Arial; BORDER-RIGHT: #ffffff 1px; WIDTH: 4.8%; BACKGROUND-REPEAT: no-repeat; BORDER-BOTTOM: #ffffff 1px; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 15.73%; BORDER-LEFT: #ffffff 1px; TOP: 95.29%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent" type=button value="Next> " hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColor:#000000;textColorBlink:False;" BaseFilterTranslateSQLchars="" BaseFilterXML="" BaseFilter="">]]></content><scripts><script event="onclick" language="JScript"><![CDATA[	pageIndex = pageIndex + 1;
