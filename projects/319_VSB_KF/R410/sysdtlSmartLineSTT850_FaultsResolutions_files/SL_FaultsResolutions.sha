<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="998px" height="722px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="onshapeload" language="JScript" id=""><![CDATA[	var objRef_groupFaults = groupFaults;
	var objRef_alphaCause = alphaCause;
	var objRef_alphaResolution = alphaResolution;;
	var objRef_pushbuttonPrev = pushbuttonPrev;
	var objRef_pushbuttonNext = pushbuttonNext;]]></script><script event="" language="JScript" id="3B7D534E-0C71-4F38-85D0-8C3485EC9F6E"><![CDATA[var tag = "";
var byteIndex;
var bitIndex;
var deviceCode;
var deviceRevision;
//var faultInfo;
var criticalFaults = [];
var nonCriticalFaults = [];
var allFaults = [];
var pages = 0;
var pageIndex = 0;
var numberOfBytesCmd48;
var numberOfBytesCmd220;
var maxRows = 0;
var selectedRowIndex = 0;

var objRef_groupFaults;
var objRef_alphaCause;
var objRef_alphaResolution;
var objRef_pushbuttonPrev;
var objRef_pushbuttonNext;


function HighlightFault()
{
	for (i = 0; i < maxRows; i++)
	{
		if (i == selectedRowIndex)
		{
			objRef_groupFaults.children[i].objects("rectBackground").fillColor = "#FFFFFF";
		}
		else
		{
			objRef_groupFaults.children[i].objects("rectBackground").fillColor = "transparent";
		}
	}
}

function PopulateCauseResolution()
{
	// Select the desired faultInfo structure from the array of all active faults
	var faultIndex = selectedRowIndex + (pageIndex * maxRows);

	if ((SL_Device.allFaults.length > faultIndex) && (faultIndex >= 0))
	{
		var faultInfo = SL_Device.allFaults[faultIndex];

		// Populate the Cause and Resolution textboxes.
		objRef_alphaCause.value = faultInfo.description;
		objRef_alphaResolution.value = faultInfo.resolution;
	}
	else
		SL_LogErrorMessage("PopulateCauseResolution", "Attempt to select an invalid fault condition: Row Index = " + selectedRowIndex + ", Page Index = " + pageIndex + ", Max Rows = " + maxRows + ", Fault Index = " + faultIndex + ", Number Of Faults = " + SL_Device.allFaults.length, null);
}

function SelectFault(objRef_shapeFault)
{
	if (SL_Device.allFaults.length > 0)
	{
		selectedRowIndex = parseInt(objRef_shapeFault.GetCustomProperty("Value", "RowIndex"));

		HighlightFault();
		PopulateCauseResolution();
	}
}


function DisplayFaultsResolutions(parentShape)
{
	var i;
	var j;
	var fillColor;
	var lineColor;

	var faultIndex = pageIndex * maxRows;
	var rowIndex = 0;

	// Fill in the top rows with any available status information, this will be limited by either the total number of
	// active faults or the maximum rows for displaying faults in one "page".
	//
	// The special case of no active fault conditions is handled by creating a pseudo fault with:
	//		Title:		"No fault conditions"
	//		Fill Color:	Grey
	//		Cause:		None
	//		Resolution:	None

	var maxFaults = Math.min(maxRows, SL_Device.allFaults.length);

	for (rowIndex = 0; rowIndex < maxRows; rowIndex++, faultIndex++)
	{
		var faultShape = parentShape.objects("groupFaults").children[rowIndex];

		if (faultIndex < SL_Device.allFaults.length)
		{
			switch (SL_Device.allFaults[faultIndex].criticality)
			{
				case 0:
					fillColor = statusDisplayScheme[3].fillColor;
					lineColor = statusDisplayScheme[3].lineColor;
					break;

				case 1:
					fillColor = statusDisplayScheme[2].fillColor;
					lineColor = statusDisplayScheme[2].lineColor;
					break;

				default:
			}

			faultShape.objects("alphaFault").value = SL_Device.allFaults[faultIndex].name;
			faultShape.objects("ovalCriticality").fillColor = fillColor;
			faultShape.objects("ovalCriticality").lineColor = lineColor;
			faultShape.style.visibility = "visible";

			//objRef_groupFaults.children[rowIndex].objects("alphaFault").value = SL_Device.allFaults[faultIndex].name;
			//objRef_groupFaults.children[rowIndex].objects("ovalCriticality").fillColor = fillColor;
			//objRef_groupFaults.children[rowIndex].objects("ovalCriticality").lineColor = lineColor;
			//objRef_groupFaults.children[rowIndex].style.visibility = "visible";
		}
		else
		{
			if (rowIndex == 0)
			{
				faultShape.objects("alphaFault").value = "No fault conditions";
				faultShape.objects("ovalCriticality").fillColor = statusDisplayScheme[0].fillColor;
				faultShape.objects("ovalCriticality").lineColor = statusDisplayScheme[0].lineColor;
				faultShape.style.visibility = "visible";

				//objRef_groupFaults.children[rowIndex].objects("alphaFault").value = "No fault conditions";
				//objRef_groupFaults.children[rowIndex].objects("ovalCriticality").fillColor = statusDisplayScheme[0].fillColor;
				//objRef_groupFaults.children[rowIndex].objects("ovalCriticality").lineColor = statusDisplayScheme[0].lineColor;
				//objRef_groupFaults.children[rowIndex].style.visibility = "visible";
			}
			else
			{
				faultShape.style.visibility = "hidden";
				//objRef_groupFaults.children[rowIndex].style.visibility = "hidden";
			}
		}
	}

	if (SL_Device.allFaults.length > 0)
	{
		if ((selectedRowIndex + (pageIndex * maxRows)) > SL_Device.allFaults.length)
		{
			selectedRowIndex = 0;
		}
		parentShape.objects("alphaCause").style.visibility = "visible";
		parentShape.objects("alphaResolution").style.visibility = "visible";
		PopulateCauseResolution();
		HighlightFault();
	}
	else
	{
		selectedRowIndex = 0;
		HighlightFault();
		parentShape.objects("alphaCause").style.visibility = "hidden";
		parentShape.objects("alphaResolution").style.visibility = "hidden";
	}
}

function ShowHidePrevNext()
{
	if (pages <= 1) 
	{
		objRef_pushbuttonPrev.style.visibility = "hidden";
		objRef_pushbuttonNext.style.visibility = "hidden";
	}
	else if (pageIndex == 0)
	{
		objRef_pushbuttonPrev.style.visibility = "hidden";
		objRef_pushbuttonNext.style.visibility = "visible";
	}
	else if (pageIndex == (pages - 1))
	{
		objRef_pushbuttonPrev.style.visibility = "visible";
		objRef_pushbuttonNext.style.visibility = "hidden";
	}
	else
	{
		objRef_pushbuttonPrev.style.visibility = "visible";
		objRef_pushbuttonNext.style.visibility = "visible";
	}
}


function groupFaultsResolutions_updateView(parentShape)
{

	SL_LogFunctionEntry(null, "groupFaultsResolutions_updateView");

	try
	{
		var faultList = parentShape.objects("groupFaults");
		SL_LogDebugLevelMessage(2, "groupFaultsResolutions_updateView", "faultList = " + faultList.id);
		SL_LogDebugLevelMessage(2, "groupFaultsResolutions_updateView", "SL_Device.allFaults.length = " + SL_Device.allFaults.length);
		if (SL_Device.allFaults.length > 0)
		{
			faultList.style.cursor = "hand";
		}
		else
		{
			faultList.style.cursor = "default";
		}

		//Find out number of pages needed to show all active faults
		maxRows = faultList.children.length;
		pages = Math.ceil(SL_Device.allFaults.length/maxRows);
		SL_LogDebugLevelMessage(2, "groupFaultsResolutions_updateView", "maxRows = " + maxRows + " pages = " + pages);

		//Reset page index to first page if it exceeds the number of pages
		if (pageIndex >= pages)
		{
			pageIndex = 0;
		}
	
		objRef_groupFaults = parentShape.objects("groupFaults");
		objRef_alphaCause = parentShape.objects("alphaCause");
		objRef_alphaResolution = parentShape.objects("alphaResolution");
		SL_LogDebugLevelMessage(2, "groupFaultsResolutions_updateView", "objRef_groupFaults = " + objRef_groupFaults.id);
		SL_LogDebugLevelMessage(2, "groupFaultsResolutions_updateView", "objRef_alphaCause = " + objRef_alphaCause.id);
		SL_LogDebugLevelMessage(2, "groupFaultsResolutions_updateView", "objRef_alphaResolution = " + objRef_alphaResolution.id);

		DisplayFaultsResolutions(parentShape);
		//DisplayFaultsResolutions(objRef_groupFaults, objRef_alphaCause, objRef_alphaResolution);

		objRef_pushbuttonPrev = parentShape.objects("pushbuttonPrev");
		objRef_pushbuttonNext = parentShape.objects("pushbuttonNext");
		SL_LogDebugLevelMessage(2, "groupFaultsResolutions_updateView", "objRef_pushbuttonPrev = " + objRef_pushbuttonPrev.id);
		SL_LogDebugLevelMessage(2, "groupFaultsResolutions_updateView", "objRef_pushbuttonNext = " + objRef_pushbuttonNext.id);

		ShowHidePrevNext();
		//ShowHidePrevNext(objRef_pushbuttonPrev, objRef_pushbuttonNext);
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_FaultsResolutions.groupFaults_updateView", "Could not update the faults and resolutions list.", error);
	}

}]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
