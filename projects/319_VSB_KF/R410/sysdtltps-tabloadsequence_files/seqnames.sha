<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="161px" height="29px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><parameters><parameter name="mypoint" type="Point" description="" defaultvalue=""/><parameter name="myparameter" type="Parameter" description="" defaultvalue=""/><parameter name="myparameter2" type="Parameter" description="" defaultvalue=""/></parameters><shapes><shape><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 161px; FONT-FAMILY: Arial; WORD-WRAP: break-word; BORDER-TOP-STYLE: none; HEIGHT: 29px; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 12pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 12px; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); LEFT: 21px; ROWS: 1" id=alpSeqNamesArray class="hsc.alpha.1  HSC.ScriptDataObject.1 " title="" tabIndex=0 hdxproperties="durationFormat:-1;fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:255;numericDisplayFormat:%s;styleClass:;textColor:#000000;">State</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim sTemp

'msgbox "ondatachange param1/2: " & me.DataValue("mypoint.myparameter") & ", " & me.DataValue("mypoint.myparameter2") 

'textbox001.value = me.DataValue("mypoint.myparameter")
'textbox002.value = me.DataValue("mypoint.myparameter2")

	if me.QualityGood("mypoint.myparameter") then
		sTemp = me.DataValue("mypoint.myparameter")
		call UpdateSequenceNames(sTemp)
	else
		window.external.MessageZoneText("Failed to retrieve sequence point names from TPN Server")
	end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::mypoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::myparameter%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="60,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element></shape></shapes></shapefile>