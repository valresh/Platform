<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="420px" height="20px"><versionheaders><versionheader name="PS" value="5.3"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[Set o = me
Value = me.GetCustomProperty("Value","strValue")
Flag = me.GetCustomProperty("Value","bFlag")
DataType = me.GetCustomProperty("Value","nDataType")

If Flag = "True" then
	intTimerID = window.setInterval ("UpdateValue()", 100)
End If]]></script><script event="" language="VBScript" id="DE3FF63B-BDDD-4641-B931-C0EE14D6A961"><![CDATA[Dim intTimerID
Dim Value
Dim DataType
Dim Flag
Dim o


Function UpdateValue()
'If o <> Null Then
	If( (DataType=4) OR (DataType=6) OR (DataType=20) OR (DataType=7) ) Then	
		o.Objects("alpDyn1").value = Value		'Bool/Boolean/Enum/SdEnum/bitstring
	ElseIf(DataType=32) Then	
		o.Objects("alpDyn2").value = Value		'TimeOfDay
	ElseIf(DataType=5) Then	
		o.Objects("alpDyn4").value = Value		'Time
	Else
		o.Objects("alpDyn3").value = Value		'Treat rest all in text control
	End If
'End If
	window.clearInterval(intTimerID)
End Function]]></script></scripts><parameters><parameter name="PointName" type="Point" description="" defaultvalue=""/><parameter name="ParamName" type="Parameter" description="" defaultvalue=""/><parameter name="strValue" type="Value" description="" defaultvalue=""/><parameter name="nDataType" type="Value" description="" defaultvalue=""/><parameter name="bFlag" type="Value" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alpDyn1 style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 21.9%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 0%; HEIGHT: 90%; BACKGROUND-COLOR: white; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:-1;lineColor:black;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">State</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::PointName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::ParamName%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefF