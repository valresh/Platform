		else 
			sParam = ""
		end if
		shpOutValues.SetCustomProperty "Parameter", "param2", sParam
'		shpOutValues.Objects("alp_value2").style.visibility = "Visible"
'msgbox "alp_value2 visiblity is: " & shpOutValues.Objects("alp_value2").style.visibility
	end if

