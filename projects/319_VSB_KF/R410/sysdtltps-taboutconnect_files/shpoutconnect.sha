		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"			
		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
		else 
			sParam = ""
		end if
		shpOutValues.SetCustomProperty "Parameter", "param12", sParam
	end if

	shpOutValues.ReloadContent		' trigger fetch of above data values
	'call UpdateValuesCount	 	' hides values below NOLINPTS count in shpOutValues

	if me.value < 12 then
		shpOutValues.Objects("alp_value12").style.visibility = "Hidden"
	end if
	if me.value < 11 then
		shpOutValues.Objects("alp_value11").style.visibility = "Hidden"
	end if
	if me.value < 10 then
		shpOutValues.Objects("alp_value10").style.visibility = "Hidden"
	end if
	if me.value < 9 then
		shpOutValues.Objects("alp_value9").style.visibility = "Hidden"
	end if
