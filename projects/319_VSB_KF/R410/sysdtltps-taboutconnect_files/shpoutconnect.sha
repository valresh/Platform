		alp_enable3.style.visibility = "Hidden"
	else
		alp_source3.style.visibility = "Inherit"
		alp_dest3.style.visibility = "Inherit"
		alp_enable3.style.visibility = "Inherit"
	end if
	if me.value < 2 then
		alp_source2.style.visibility = "Hidden"
		alp_dest2.style.visibility = "Hidden"
		alp_enable2.style.visibility = "Hidden"
	else
		alp_source2.style.visibility = "Inherit"
		alp_dest2.style.visibility = "Inherit"
		alp_enable2.style.visibility = "Inherit"
	end if
	if me.value < 1 then
		alp_source1.style.visibility = "Hidden"
		alp_dest1.style.visibility = "Hidden"
		alp_enable1.style.visibility = "Hidden"
	else
		alp_source1.style.visibility = "Inherit"
		alp_dest1.style.visibility = "Inherit"
		alp_enable1.style.visibility = "Inherit"
	end if

'	grpData.style.visibility = "Inherit" 'now show data

	' drive LOSRC(n) text-value "point.param" to shpOutValues via custom properties to get actual point.param process values
	'example is, if LOSRC(n) is "L3" then the value to show is <thispoint>.L(3).external
	shpOutValues.autoReloadContent = false

	if me.value > 0 then
		sParam = alp_source1.value
		if Left(sParam, 1) = "L" then
			sTempIdx = Right(sParam, Len(sParam)-1)
			sParam = "L(" & sTempIdx & ").external"			
		elseif Len(sParam) > 2 then  'FL, SO, or NN (or else shape will not get good quality on param)
			sTempIdx = Right(sParam, Len(sParam)-2)
			sParam = Left(sParam,2) & "(" & sTempIdx & ").external"
		else 
			sParam = ""
		end if
		shpOutValues.SetCustomProperty "Parameter", "param1", sParam
'		shpOutValues.Objects("alp_value1").style.visibility = "Visible"
	end if
	
