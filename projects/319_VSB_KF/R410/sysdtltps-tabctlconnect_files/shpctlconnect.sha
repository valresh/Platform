		combo_constat1.style.visibility = "Hidden"
		combo_constat2.style.visibility = "Hidden"
		combo_constat3.style.visibility = "Hidden"
		combo_constat4.style.visibility = "Hidden"
		combo_constat5.style.visibility = "Hidden"
		combo_constat6.style.visibility = "Hidden"
		combo_constat7.style.visibility = "Hidden"
		combo_constat8.style.visibility = "Hidden"
		alp_accstat1.style.visibility = "Hidden"
		alp_accstat2.style.visibility = "Hidden"
		alp_accstat3.style.visibility = "Hidden"
		alp_accstat4.style.visibility = "Hidden"
		alp_accstat5.style.visibility = "Hidden"
		alp_accstat6.style.visibility = "Hidden"
		alp_accstat7.style.visibility = "Hidden"
		alp_accstat8.style.visibility = "Hidden"
		txt_ConnectStatHdr.style.visibility = "Hidden"
		txt_AccStatHdr.style.visibility = "Hidden"
	end if

	if not me.QualityGood("CurrentPoint.COACCSTS(1)") then
		combo_constatout1.style.visibility = "Hidden"
		combo_constatout2.style.visibility = "Hidden"
		combo_constatout3.style.visibility = "Hidden"
		combo_constatout4.style.visibility = "Hidden"
		combo_constatout5.style.visibility = "Hidden"
		combo_constatout6.style.visibility = "Hidden"
		combo_constatout7.style.visibility = "Hidden"
		combo_constatout8.style.visibility = "Hidden"
		alp_accstatout1.style.visibility = "Hidden"
		alp_accstatout2.style.visibility = "Hidden"
		alp_accstatout3.style.visibility = "Hidden"
		alp_accstatout4.style.visibility = "Hidden"
		alp_accstatout5.style.visibility = "Hidden"
		alp_accstatout6.style.visibility = "Hidden"
		alp_accstatout7.style.visibility = "Hidden"
		alp_accstatout8.style.visibility = "Hidden"
		txt_ConnectStatOutHdr.style.visibility = "Hidden"
		txt_AccStatOutHdr.style.visibility = "Hidden"
	end if

	GrpDataUpper.style.visibility = "Inherit"
	GrpDataLower.style.visibility = "Inherit"]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},{%Point::CurrentPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="NOCINPTS,NOCOPTS,BADOC1FL.EXTERNAL,BADOC2FL.EXTERNAL,BADOC3FL.EXTERNAL,BADOC4FL.EXTERNAL,CIACCSTS(1),COACCSTS(1),PV,ENT_TYPE,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,1,1,1,1,1,0,0,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates"