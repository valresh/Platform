<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 17.54%; FONT-FAMILY: Verdana; HEIGHT: 10.22%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 1.13%; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 82.3%" id=txt_badoc1fl class="hvg.textbox.1 DetailDataLeft" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:DetailDataLeft;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:120;">Text</DIV>]]></content></html></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 90%; HEIGHT: 34.37%; VISIBILITY: hidden; FONT-SIZE: 0pt; TOP: 59.57%; BEHAVIOR: url(#HDXVectorFactory#group); LEFT: 4.21%" id=GrpDataLower class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:176;lineColorBlink:False;Width:684;"></DIV>]]></content></html></group><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 48.31%; FONT-FAMILY: Helvetica; HEIGHT: 100%; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 0%" id=txt_nocinpts class="hvg.textbox.1 Label_Text" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:Label_Text;textColor:black;textColorBlink:False;TotalRotation:-1;Width:86;">NOCINPTS =</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; WIDTH: 53.37%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 88.88%; COLOR: black; FONT-SIZE: 10pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 46.06%; ROWS: 1" id=alp_nocinpts class="hsc.alpha.1 DetailDataLeft" title="" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:9;numericDisplayFormat:%.0f;styleClass:DetailDataLeft;textColor:Black;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if not sd.QualityGood("CurrentPoint.NOCINPTS") then
		combo_constat8.style.visibility = "Hidden"
		alp_accstat8.style.visibility = "Hidden"
		alp_source8.style.visibility = "Hidden"
		alp_dest8.style.visibility = "Hidden"
		combo_constat7.style.visibility = "Hidden"
		alp_accstat7.style.visibility = "Hidden"
		alp_source7.style.visibility = "Hidden"
		alp_dest7.style.visibility = "Hidden"
		combo_constat6.style.visibility = "Hidden"
		alp_accstat6.style.visibility = "Hidden"
		alp_source6.style.visibility = "Hidden"
		alp_dest6.style.visibility = "Hidden"
		combo_constat5.style.visibility = "Hidden"
		alp_accstat5.style.visibility = "Hidden"
		alp_source5.style.visibility = "Hidden"
		alp_dest5.style.visibility = "Hidden"
		combo_constat4.style.visibility = "Hidden"
		alp_accstat4.style.visibility = "Hidden"
		alp_source4.style.visibility = "Hidden"
		alp_dest4.style.visibility = "Hidden"
		combo_constat3.style.visibility = "Hidden"
		alp_accstat3.style.visibility = "Hidden"
		alp_source3.style.visibility = "Hidden"
		alp_dest3.style.visibility = "Hidden"
		combo_constat2.style.visibility = "Hidden"
		alp_accstat2.style.visibility = "Hidden"
		alp_source2.style.visibility = "Hidden"
		alp_dest2.style.visibility = "Hidden"
		combo_constat1.style.visibility = "Hidden"
		alp_accstat1.style.visibility = "Hidden"
		alp_source1.style.visibility = "Hidden"
		alp_dest1.style.visibility = "Hidden"
		txt_ConnectStatHdr.style.visibility = "Hidden"
		txt_AccStatHdr.style.visibility = "Hidden"
		grp_nocinpts.style.visibility = "Hidden"
		exit sub
	end if

	' valid NOCINPTS

	if me.value < 8 then
		combo_constat8.style.visibility = "Hidden"
		alp_accstat8.style.visibility = "Hidden"
		alp_source8.style.visibility = "Hidden"
		alp_dest8.style.visibility = "Hidden"
	end if
	if me.value < 7 then
		combo_constat7.style.visibility = "Hidden"
		alp_accstat7.style.visibility = "Hidden"
		alp_source7.style.visibility = "Hidden"
		alp_dest7.style.visibility = "Hidden"
	end if
	if me.value < 6 then
		combo_constat6.style.visibility = "Hidden"
		alp_accstat6.style.visibility = "Hidden"
		alp_source6.style.visibility = "Hidden"
		alp_dest6.style.visibility = "Hidden"
	end if
	if me.value < 5 then
		combo_constat5.style.visibility = "Hidden"
		alp_accstat5.style.visibility = "Hidden"
		alp_source5.style.visibility = "Hidden"
		alp_dest5.style.visibility = "Hidden"
	end if
	if me.value < 4 then
		combo_constat4.style.visibility = "Hidden"
		alp_accstat4.style.visibility = "Hidden"
		alp_source4.style.visibility = "Hidden"
		alp_dest4.style.visibility = "Hidden"
	end if
	if me.value < 3 then
		combo_constat3.style.visibility = "Hidden"
		alp_accstat3.style.visibility = "Hidden"
		alp_source3.style.visibility = "Hidden"
		alp_dest3.style.visibility = "Hidden"
	end if
	if me.value < 2 then
		combo_constat2.style.visibility = "Hidden"
		alp_accstat2.style.visibility = "Hidden"
		alp_source2.style.visibility = "Hidden"
		alp_dest2.style.visibility = "Hidden"
	end if
	if me.value < 1 then
		combo_constat1.style.visibility = "Hidden"
		alp_accstat1.style.visibility = "Hidden"
		alp_source1.style.visibility = "Hidden"
		alp_dest1.style.visibility = "Hidden"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NOCINPTS"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 23.42%; HEIGHT: 3.51%; FONT-SIZE: 0pt; TOP: 96.28%; BEHAVIOR: url(#HDXVectorFactory#group); LEFT: 4.21%" id=grp_nocinpts class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:18;lineColorBlink:False;Width:178;"></DIV>]]></content></html></group><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 44.88%; FONT-FAMILY: Helvetica; HEIGHT: 100%; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 0%" id=txt_nocopts class="hvg.textbox.1 Label_Text" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:Label_Text;textColor:black;textColorBlink:False;TotalRotation:-1;Width:79;">NOCOPTS =</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; WIDTH: 53.97%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 88.88%; COLOR: black; FONT-SIZE: 10pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 5.55%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 45.45%; ROWS: 1" id=alp_nocopts class="hsc.alpha.1 DetailDataLeft" title="" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:9;numericDisplayFormat:%.0f;styleClass:DetailDataLeft;textColor:Black;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if not sd.QualityGood("CurrentPoint.NOCOPTS") then
		combo_constatout8.style.visibility = "Hidden"
		alp_accstatout8.style.visibility = "Hidden"
		alp_destout8.style.visibility = "Hidden"
		combo_constatout7.style.visibility = "Hidden"
		alp_accstatout7.style.visibility = "Hidden"
		alp_destout7.style.visibility = "Hidden"
		combo_constatout6.style.visibility = "Hidden"
		alp_accstatout6.style.visibility = "Hidden"
		alp_destout6.style.visibility = "Hidden"
		combo_constatout5.style.visibility = "Hidden"
		alp_accstatout5.style.visibility = "Hidden"
		alp_destout5.style.visibility = "Hidden"
		combo_constatout4.style.visibility = "Hidden"
		alp_accstatout4.style.visibility = "Hidden"
		alp_destout4.style.visibility = "Hidden"
		combo_constatout3.style.visibility = "Hidden"
		alp_accstatout3.style.visibility = "Hidden"
		alp_destout3.style.visibility = "Hidden"
		combo_constatout2.style.visibility = "Hidden"
		alp_accstatout2.style.visibility = "Hidden"
		alp_destout2.style.visibility = "Hidden"
		combo_constatout1.style.visibility = "Hidden"
		alp_accstatout1.style.visibility = "Hidden"
		alp_destout1.style.visibility = "Hidden"
		txt_ConnectStatOutHdr.style.visibility = "Hidden"
		txt_AccStatOutHdr.style.visibility = "Hidden"
		grp_nocopts.style.visibility = "Hidden"
		txt_OutputStatusHdr.style.visibility = "Hidden"
		exit sub
	end if



	if me.value < 8 then
		combo_constatout8.style.visibility = "Hidden"
		alp_accstatout8.style.visibility = "Hidden"
		alp_destout8.style.visibility = "Hidden"
	end if
	if me.value < 7 then
		combo_constatout7.style.visibility = "Hidden"
		alp_accstatout7.style.visibility = "Hidden"
		alp_destout7.style.visibility = "Hidden"
	end if
	if me.value < 6 then
		combo_constatout6.style.visibility = "Hidden"
		alp_accstatout6.style.visibility = "Hidden"
		alp_destout6.style.visibility = "Hidden"
	end if
	if me.value < 5 then
		combo_constatout5.style.visibility = "Hidden"
		alp_accstatout5.style.visibility = "Hidden"
		alp_destout5.style.visibility = "Hidden"
	end if
	if me.value < 4 then
		combo_constatout4.style.visibility = "Hidden"
		alp_accstatout4.style.visibility = "Hidden"
		alp_destout4.style.visibility = "Hidden"
		txt_badoc4fl.style.visibility = "Hidden"
	else
		if sd.QualityGood("CurrentPoint.BADOC4FL.EXTERNAL") then
			txt_badoc4fl.style.visibility = "Inherit"
			if sd.DataValue("CurrentPoint.BADOC4FL.EXTERNAL") = "ON" then
				txt_badoc4fl.value = "BAD"
			else
				txt_badoc4fl.value = "GOOD"
			end if
		else
			txt_badoc4fl.style.visibility = "Hidden"
		end if
	end if
	if me.value < 3 then
		combo_constatout3.style.visibility = "Hidden"
		alp_accstatout3.style.visibility = "Hidden"
		alp_destout3.style.visibility = "Hidden"
		txt_badoc3fl.style.visibility = "Hidden"
	else
		if sd.QualityGood("CurrentPoint.BADOC3FL.EXTERNAL") then
			txt_badoc3fl.style.visibility = "Inherit"
			if sd.DataValue("CurrentPoint.BADOC3FL.EXTERNAL") = "ON" then
				txt_badoc3fl.value = "BAD"
			else
				txt_badoc3fl.value = "GOOD"
			end if
		else
			txt_badoc3fl.style.visibility = "Hidden"
		end if
	end if
	if me.value < 2 then
		combo_constatout2.style.visibility = "Hidden"
		alp_accstatout2.style.visibility = "Hidden"
		alp_destout2.style.visibility = "Hidden"
		txt_badoc2fl.style.visibility = "Hidden"
	else
		if sd.QualityGood("CurrentPoint.BADOC2FL.EXTERNAL") then
			txt_badoc2fl.style.visibility = "Inherit"
			if sd.DataValue("CurrentPoint.BADOC2FL.EXTERNAL") = "ON" then
				txt_badoc2fl.value = "BAD"
			else
				txt_badoc2fl.value = "GOOD"
			end if
		else
			txt_badoc2fl.style.visibility = "Hidden"
		end if
	end if
	if me.value < 1 then
		combo_constatout1.style.visibility = "Hidden"
		alp_accstatout1.style.visibility = "Hidden"
		alp_destout1.style.visibility = "Hidden"
		txt_badoc1fl.style.visibility = "Hidden"
	else
		' don't show "Output" for REGAM
		if sd.QualityGood("CurrentPoint.ENT_TYPE") and sd.DataValue("CurrentPoint.ENT_TYPE") <> "REGAM" then
			txt_OutputStatusHdr.style.visibility = "Inherit"
		end if
		if sd.QualityGood("CurrentPoint.BADOC1FL.EXTERNAL") then
			txt_badoc1fl.style.visibility = "Inherit"
			if sd.DataValue("CurrentPoint.BADOC1FL.EXTERNAL") = "ON" then
				txt_badoc1fl.value = "BAD"
			else
				txt_badoc1fl.value = "GOOD"
			end if
		else
			txt_badoc1fl.style.visibility = "Hidden"
		end if
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NOCOPTS"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 23.15%; HEIGHT: 3.51%; FONT-SIZE: 0pt; TOP: 96.28%; BEHAVIOR: url(#HDXVectorFactory#group); LEFT: 30.92%" id=grp_nocopts class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:18;lineColorBlink:False;Width:176;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 760px; HEIGHT: 512px; FONT-SIZE: 0pt; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group); LEFT: -15px" id=group008 class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:512;lineColorBlink:False;Width:760;"></DIV>]]></content></html></group></shape></shapes></shapefile>