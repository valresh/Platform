<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="794px" height="446px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="VBScript" id="172008C7-8447-442D-9618-A9CB39E2EEE3"><![CDATA[Dim intERDBStatus
Dim blnCtrlConfirmProp
Dim blnESig
Dim blnPrimSig
Dim blnSecSig
Dim blnChartInitialized

ErdbConnToA = 0
ErdbDiscFromA = 1
ErdbConnToB = 2
ErdbDiscFromB = 3

blnCtrlConfirmProp = False
blnESig = False
blnPrimSig = False
blnSecSig = False
blnChartInitialized = False

'Chart Security Fix 
Dim intTimerID
Dim Value
Dim DataType
Dim Flag
Dim o

Function UpdateValue()

	If( (DataType=4) OR (DataType=6) OR (DataType=20) ) Then	
		o.Objects("alpDyn1").value = Value		'Bool/Boolean/Enum/SdEnum
	ElseIf(DataType=32) Then	
		o.Objects("alpDyn2").value = Value		'TimeOfDay
	ElseIf(DataType=5) Then	
		o.Objects("alpDyn4").value = Value		'Time
	Else
		o.Objects("alpDyn3").value = Value		'Treat rest all in text control
	End If

	window.clearInterval(intTimerID)
End Function]]></script><script event="onshapeload" language="VBScript" id=""><![CDATA[	On Error Resume Next
	intERDBStatus = -1

	AxConfigFrm1.height = me.style.height
	AxConfigFrm1.width = me.style.width]]></script><script event="" language="VBScript" id="0C622983-C8BF-41F3-9594-8A1F0DCFC19A"><![CDATA[Dim intTimerID
Dim Value
Dim DataType
Dim Flag
Dim o


Function UpdateValue()
'If o <> Null Then
	If( (DataType=4) OR (DataType=6) OR (DataType=20) ) Then	
		o.Objects("alpDyn1").value = Value		'Bool/Boolean/Enum/SdEnum
	ElseIf(DataType=32) Then	
		o.Objects("alpDyn2").value = Value		'TimeOfDay
	ElseIf(DataType=5) Then	
		o.Objects("alpDyn4").value = Value		'Time
	Else
		o.Objects("alpDyn3").value = Value		'Treat rest all in text control
	End If
'End If
	window.clearInterval(intTimerID)
End Function]]></script><script event="" language="VBScript" id="FF7A6640-19A2-4A6C-89D6-FDB0C92A3992"><![CDATA[Dim intTimerID
Dim Value
Dim DataType
Dim Flag
Dim o


Function UpdateValue()
'If o <> Null Then
	If( (DataType=4) OR (DataType=6) OR (DataType=20) OR (DataType=7)  ) Then	
		o.Objects("alpDyn1").value = Value		'Bool/Boolean/Enum/SdEnum/bitstring
	ElseIf(DataType=32) Then	
		o.Objects("alpDyn2").value = Value		'TimeOfDay
	ElseIf(DataType=5) Then	
		o.Objects("alpDyn4").value = Value		'Time
	Else
		o.Objects("alpDyn3").value = Value		'Treat rest all in text control
	End If
'End If
	window.clearInterval(intTimerID)
End Function]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/><parameter name="currentpoint" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=LimitMessage class=hvg.textbox.1 style="OVERFLOW: hidden; FONT-SIZE: 12pt; HEIGHT: 3.81%; FONT-FAMILY: Arial; WIDTH: 50.37%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 0%; TOP: 77.13%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:400;">Unable to open Display. Maximum limit reached. Try again Later.</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=FailMessage class=hvg.textbox.1 style="OVERFLOW: hidden; FONT-SIZE: 12pt; HEIGHT: 5.15%; FONT-FAMILY: Arial; WIDTH: 22.41%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 0.25%; TOP: 81.39%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;Height:23;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:178;">Cannot Connect to ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=CtrlConfirmProp class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 4.48%; FONT-FAMILY: Arial; WIDTH: 3.27%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 9.94%; BORDER-LEFT-STYLE: none; TOP: 86.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:2;numericDisplayFormat:%.0f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['On Error Resume Next
blnCtrlConfirmProp = True

	If NOT(blnChartInitialized) Then
		If(blnCtrlConfirmProp AND blnESig AND blnPrimSig AND blnSecSig ) Then
			Dim NumSig
			NumSig=0
			If (len(PrimSig.Value)) <> 255  Then
				NumSig=1
			End If
			If NumSig=1 And len(SecSig.Value) <> 255  Then
				NumSig=2
			End If
			'msgbox window.external.DetailPointID 
			if  SIndex= 1 then
			AXConfigFrm1.PointName = alpCurrentpointName.value
			else
			AXConfigFrm1.PointName = alpSelectedBlock.value
			end if

			'AXConfigFrm1.PointName = alpblockname.value'window.external.DetailPointID 
			AXConfigFrm1.ServerName = window.external.status.ClusterServerName 
			AXConfigFrm1.SecurityLevel = window.external.SecurityLevel 
			AXConfigFrm1.OperatorName = window.external.OperatorID 
			AXConfigFrm1.StationServerName = window.external.ServerName 
			AXConfigFrm1.StationNumber = window.external.StationNumber	
			AXConfigFrm1.ElectronicSignature = ESig.value
			AXConfigFrm1.ControlConfirm = me.value
			AXConfigFrm1.NumberSignatures = NumSig
			AXConfigFrm1.StationAcronym = window.external.Parent.RuntimeStatus.StationAcronym

			blnChartInitialized = True
		End If
	End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="ControlConfirmRequired"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=ESig class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 4.48%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 7.43%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0.12%; BORDER-LEFT-STYLE: none; BORDER-RIGHT-COLOR: transparent; TOP: 86.09%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="borderStyle:none;borderWidth:;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:1;numericDisplayFormat:%.0f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['On Error Resume Next
blnESig = True

	If  NOT(blnChartInitialized) Then
		If(blnCtrlConfirmProp AND blnESig AND blnPrimSig AND blnSecSig) Then

			Dim NumSig
			NumSig=0
			If (len(PrimSig.Value)) <> 255  Then
				NumSig=1
			End If
			If NumSig=1 And len(SecSig.Value) <> 255  Then
				NumSig=2
			End If
'			msgbox window.external.DetailPointID 
			if  SIndex= 1 then
			AXConfigFrm1.PointName = alpCurrentpointName.value
			else
			AXConfigFrm1.PointName = alpSelectedBlock.value
			end if
			'AXConfigFrm1.PointName = alpblockname.value'window.external.DetailPointID 
			AXConfigFrm1.ServerName = window.external.status.ClusterServerName 
			AXConfigFrm1.SecurityLevel = window.external.SecurityLevel 

			AXConfigFrm1.OperatorName = window.external.OperatorID 
			AXConfigFrm1.StationServerName = window.external.ServerName 
			AXConfigFrm1.StationNumber = window.external.StationNumber	
			AXConfigFrm1.ElectronicSignature = me.value
			AXConfigFrm1.ControlConfirm = CtrlConfirmProp.value
			AXConfigFrm1.NumberSignatures = NumSig
			AXConfigFrm1.StationAcronym = window.external.Parent.RuntimeStatus.StationAcronym

			blnChartInitialized = True
		End If
	End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="FileRefFile" varianttype="VT_UI4" value="121"/><property name="FileRefRecord" varianttype="VT_UI4" value="1"/><property name="FileRefWord" varianttype="VT_UI4" value="1733"/><property name="FileRefFlags" varianttype="VT_UI4" value="0"/><property name="FileRefFormat" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldStart" varianttype="VT_UI1" value="10"/><property name="FileRefBitFieldWidth" varianttype="VT_UI1" value="1"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=PrimSig class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: break-word; FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 4.93%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 12.46%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 15.11%; BORDER-LEFT-STYLE: none; BORDER-RIGHT-COLOR: transparent; TOP: 86.09%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="bo