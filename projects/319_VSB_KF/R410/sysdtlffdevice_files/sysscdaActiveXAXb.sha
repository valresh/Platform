value="12"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shpSub_alpDyn4 class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 90%; FONT-FAMILY: Tahoma; WIDTH: 29.76%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 23.57%; BORDER-LEFT-STYLE: none; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="dateFormat:0;dateTimeFormat:0;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:50;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;timeFormat:1;timeIncludeMS:0;">28.10.2005 23:05:43.005</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value=""/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="10"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=shpSub_group001 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 100%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:20;lineColorBlink:False;Width:420;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=shpSub class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 4.48%; FONT-FAMILY: Arial; WIDTH: 52.89%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0.25%; TOP: 87.21%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink)" hdxproperties="fillColorBlink:False;Height:20;lineColorBlink:False;Width:420;" value = "1" src = ".\sysscdaActiveXAXb_files\SubShape.sha" parameters = "Point?PointName:;Parameter?ParamName:;Value?strValue:;Value?nDataType:;Value?bFlag:;" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content><scripts><script event="onshapeload" language="VBScript"><![CDATA[Set o = me
Value = me.GetCustomProperty("Value","strValue")
Flag = me.GetCustomProperty("Value","bFlag")
DataType = me.GetCustomProperty("Value","nDataType")

If Flag = "True" then
	intTimerID = window.setInterval ("UpdateValue()", 100)
End If]]></script></scripts></html></group><element><html><content><![CDATA[
<OBJECT tabIndex=-1 id=AxConfigFrm1 class=hsc.activexcontrol.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 91.92%; FONT-FAMILY: Arial; WIDTH: 98.23%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0.25%; TOP: 0%" classid=clsid:5CC9BF76-270B-4160-A966-1472C9518BAD><PARAM NAME="_Version" VALUE="65536"><PARAM NAME="_ExtentX" VALUE="20637"><PARAM NAME="_ExtentY" VALUE="10847"><PARAM NAME="_StockProps" VALUE="160"><PARAM NAME="BorderStyle" VALUE="0"><PARAM NAME="Appearance" VALUE="0">]]></content><scripts><script event="InvokeERDBStatus(nERDBStatus)" language="VBScript"><![CDATA[On Error Resume Next
    If ((nERDBStatus = ErdbDiscFromA Or nERDBStatus = ErdbDiscFromB) And intERDBStatus <> -1) Then
		window.external.MessageZoneText = Me.parentElement.children.namedItem("LostMessage").Value
    ElseIf ((nERDBStatus = ErdbDiscFromA Or nERDBStatus = ErdbDiscFromB) And intERDBStatus = -1) Then
		window.external.MessageZoneText = Me.parentElement.children.namedItem("FailMessage").Value
    ElseIf (intERDBStatus = -1) Then
		window.external.MessageZoneText = ""
    Else
		window.external.MessageZoneText = Me.parentElement.children.namedItem("SuccMessage").Value
    End If
        
    intERDBStatus = nERDBStatus]]></script><script event="InvokeValueChanged(bstrPoint, bstrParam, vValue, nDataType)" language="VBScript"><![CDATA[shpSub.autoReloadContent = False
shpSub.SetCustomProperty "Point", "PointName", CStr(bstrPoint)
shpSub.SetCustomProperty "Parameter", "ParamName", CStr(bstrParam)
shpSub.SetCustomProperty "Value", "bFlag", "True"
shpSub.SetCustomProperty "Value", "strValue", CStr(vValue)
shpSub.SetCustomProperty "Value", "nDataType", CStr(nDataType)
shpSub.ReloadContent]]></script></scripts></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alpSelectedBlock class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 4.48%; FONT-FAMILY: Arial; WIDTH: 5.16%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 14.35%; BORDER-LEFT-STYLE: none; TOP: 95.29%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="fillColor:white;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[if  SIndex= 1 then
	AXConfigFrm1.PointName = alpCurrentpointName.value
else
	AXConfigFrm1.PointName = alpSelectedBlock.value
end if
blnChartInitialized = True]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::currentpoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="ASSOCBLKLST[{%Index%}]"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alpCurrentpointName class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 4.48%; FONT-FAMILY: Arial; WIDTH: 5.16%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 14.35%; BORDER-LEFT-STYLE: none; TOP: 95.29%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="fillColor:white;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[if  SIndex= 1 then
	AXConfigFrm1.PointName = alpCurrentpointName.value
else
	AXConfigFrm1.PointName = alpSelectedBlock.value
end if
blnChartInitialized = True]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::currentpoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="Name"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group001 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 446px; WIDTH: 794px; POSITION: absolute; LEFT: -1px; TOP: 1px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:446;lineColorBlink:False;Width:794;"></DIV>]]></content></html></group></shape></shapes></shapefile>