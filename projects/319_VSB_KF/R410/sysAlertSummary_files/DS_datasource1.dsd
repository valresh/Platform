							       height: 100%;
							       position: relative;
							       top: 0px;
							       z-index: 10;
							       white-space: nowrap;
 							       text-align: center;"&gt;
							&lt;img src="Images/CommentsAdded.gif" style="visibility: hidden;"/&gt;
						&lt;/div&gt;
					</content>
					<bindings>
						<in fields="CommentsAdded" xforms="xfVisibility" properties="firstChild.style.visibility" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
