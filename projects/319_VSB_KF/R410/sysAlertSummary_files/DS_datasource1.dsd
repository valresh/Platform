						<in fields="Severity" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Live Value" name="Live Value">
					<title tooltip="Live Value">&lt;span class="textHeader"&gt;Live Value&lt;/span&gt;</title>
					<action/>
					<menu/>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px; text-align: right;"/&gt;</content>
					<bindings>
						<in fields="LiveValue" xforms="xfNumCellFormat;EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Shelved Reason" name="Shelved Reason" default="false">
					<title tooltip="Click to filter or sort by the Shelved Reason">&lt;span class="textHeader"&gt;Shelved Reason&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="ShelvedReasonColumnFilterMainGroup"/>
						<GroupRef GroupId="ShelvedReasonSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="ShelvedReason" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Expiry Time" name="Expiry Time" default="false">
					<title tooltip="Click to filter or sort by the Expiry Time">&lt;span class="textHeader"&gt;Expiry Time&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="ExpiryTimeColumnFilterMainGroup"/>
						<GroupRef GroupId="ExpiryTimeSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="ExpiryTime;ExpiryMicroSeconds" xforms="xfDTCellFormat" properties="innerText" />
						<in fields="ExpiryTime;ExpiryMicroSeconds" xforms="xfDTTooltipFormat" properties="title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Remaining Time" name="Unshelved In" default="false">
					<title tooltip="Click to filter or sort by the time remaining until unshelved">&lt;span class="textHeader"&gt;Unshelved In&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="RemainingTimeSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="RemainingTime" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Unshelved Time" name="Unshelved Time" default="false">
					<title tooltip="Click to filter or sort by the Unshelved Time">&lt;span class="textHeader"&gt;Unshelved Time&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="UnshelvedTimeColumnFilterMainGroup"/>
						<GroupRef GroupId="UnshelvedTimeSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="UnshelvedTime;UnshelvedMicroSeconds" xforms="xfDTCellFormat" properties="innerText" />
						<in fields="UnshelvedTime;UnshelvedMicroSeconds" xforms="xfDTTooltipFormat" properties="title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Author" name="Author">
					<title tooltip="Click to filter or sort by author">&lt;span class="textHeader"&gt;Author&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="AuthorColumnFilterMainGroup"/>
						<GroupRef GroupId="AuthorFilterGroup"/>
						<GroupRef GroupId="AuthorSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Author" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Accessibility" name="Accessibility">
					<title tooltip="Click to sort by accessibility">&lt;span class="textHeader"&gt;Accessibility&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="AccessibilitySortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="AlertAccessibilityDes" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Classification" name="Classification">
					<title tooltip="Click to filter or sort by classification">&lt;span class="textHeader"&gt;Classification&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="ClassificationColumnFilterMainGroup"/>
						<GroupRef GroupId="ClassificationSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Classification" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Public Name" name="Public Name" default="false">
					<title tooltip="Click to filter or sort by public name">&lt;span class="textHeader"&gt;PublicName&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="PublicNameColumnFilterMainGroup"/>
						<GroupRef GroupId="PublicNameSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="PublicName" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Batch ID" name="Batch ID" default="false">
					<title tooltip="Click to filter or sort by Batch ID">&lt;span class="textHeader"&gt;Batch ID&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="BatchIDFilterMainGroup"/>
						<GroupRef GroupId="BatchIDSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="BatchID" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
			</columns>
		</table>
	</TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
</DATAOBJECT>
<DATAOBJECT id="2" type="HMIPage.EntitySource" format="propertybag">
<PROPERTY name="Version">4.5</PROPERTY>
<PROPERTY name="SummaryType">3</PROPERTY> 
<PROPERTY name="AutoMigrate">0</PROPERTY>
<PROPERTY name="WaitForSelectionList">1</PROPERTY>
<PROPERTY name="StartLocation"></PROPERTY>
<PROPERTY name="AuxFilter">IsAssigned or HasAssignedDescendents</PROPERTY>
<PROPERTY name="TemplateXML"><![CDATA[
<TableTemplate>
	<FieldXML>
		<fields>
			<field id="Selected"/>
			<field id="NodeHandle" rowId="true"/>
			<field id="Depth"/>
			<field id="Expanded"/>
			<field id="NumChildren"/>
			<field id="SiblingNumber"/>
			<field id="PointNumber"/>
			<field id="IsAssigned"/>
			<field id="HasAssignedDescendents"/>
			<field id="EntityName"/>
			<field id="TagName"/>
			<field id="FullName"/>
			<field id="TotalActiveAlerts(%StationNumber%)" />
			<field id="TotalRTNAlerts(%StationNumber%)" />
			<field id="TotalActiveUnackAlerts(%StationNumber%)"/>
			<field id="TotalDisabledAlerts(%StationNumber%)"/>
			<field id="TotalRTNUnackAlerts(%StationNumber%)"/>
			<field id="TotalActiveAckAlerts(%StationNumber%)"/>
			<field id="TotalShelvedAlerts(%StationNumber%)"/>
			<field id="RemoteType"/>
			<field id="SubType"/>
			<field id="ItemNumber"/>
			<field id="Redundant"/>
			<field id="Type"/>
			<field id="DirectConnect"/>
		</fields>
	</FieldXML>
	<XFormXML>
		<xforms>
			<defaultValue id="xfEmptyVariantToString" value="" type="string"/>
			<script id="xfSelection" language="VBScript">
				Dim s
				s = "Unselected_Cells"
				If Not IsEmpty(Value(0)) Then
				    If Value(0) Then
					If g_bAreaTableIsActive Then
						If Value(1) Then 
							s = "Selected_Active_Cells"
						Else
							s = "Selected_Active_Unassigned_Cells"
						End If
					Else
						If Value(1) Then
							s = "Selected_Inactive_Cells"
						Else
							s = "Selected_Inactive_Unassigned_Cells"
						End If
					End If
				    ElseIf Not Value(1) Then
					s = "Unassigned_Cells"
				    End If
				End If
				Return = s
			</script>
			<script id="xfBold" language="VBScript">
				if( IsEmpty(Value(0)) ) then
				    Return = ""
				elseif( (Value(0) = 0) and (Value(1) = 0) and (Value(2) = 0) ) then
				    Return = ""
				else
				    Return = "bold"
				end if
			</script>
			<script id="xfIconImg" language="VBScript">
				Return = GetNodeImagePath(Value)
			</script>
			<script id="xfIconVisible" language="VBScript">
				if ( IsEmpty(Value(0)) ) then
				    Return = "visible"
				elseif ( (Value(0) = 0) and (Value(1) = 0) and (Value(2) = 0) and (Value(3) = 0) and (Value(4) = 0) ) then
				    Return = "visible"
				else
				    Return = "hidden"
				end if
			</script>
			<script id="xfCategory" language="VBScript">
				if ( IsEmpty(Value(0)) ) then
				    Return = 0
				elseif ( (Value(0) = 0) and (Value(1) = 0) and (Value(2) = 0) and (Value(3) = 0) ) then
				    Return = 0
				else
				    Return = 17
				end if
			</script>
			<script id="xfDisabled" language="VBScript">
				if ( IsEmpty(Value(0)) ) then
				    Return = false
				elseif ( (Value(0) = 0) and (Value(1) = 0) and (Value(2) = 0) and (Value(3) > 0) ) then
				    Return = true
				else
				    Return = false
				end if
			</script>
			<script id="xfShelved" language="VBScript">
				if ( IsEmpty(Value(0)) ) then
				    Return = false
				elseif ( (Value(0) = 0) and (Value(1) = 0) and (Value(2) = 0) and (Value(3) = 0) and (Value(4) > 0) ) then
				    Return = true
				else
				    Return = false
				end if
			</script>
			<script id="xfAcked" language="VBScript">
				if ( IsEmpty(Value(0)) ) then
				    Return = True
				elseif ( Value(0) = 0 and Value(1) = 0 ) then
				    Return = True
				else 
				    Return = False
				end if
			</script>
			<script id="xfRTN" language="VBScript">
				if ( IsEmpty(Value(0)) ) then
				    Return = True
				elseif ( Value(0) = 0 and Value(1) > 0 ) then
				    Return = True
				else
				    Return = False
				end if
			</script>
			<script id="xfPadding" language="VBScript">
				if ( IsEmpty(Value) ) then
				    Return = 0
				else
				    Return = (Value - 1) * 16
				end if
			</script>
			<script id="xfPlusMinusImg" language="VBScript">
                On Error Resume Next
				if (IsEmpty(Value(0)) or (Value(0) = 0)) then
					Return = "Images/blank.gif"
				elseif (Value(1)) then
				    if not window.external.IsOnTouchPanel then
					    Return = "Images/Collapse.png"
			        else 
					    Return = "Images/Collapse_Touch.png"
					end if
				else
				    if not window.external.IsOnTouchPanel then
					    Return = "Images/Expand.png"
					else
					    Return = "Images/Expand_Touch.png"
					end if
				end if
			</script>
			<script id="xfNameAndCount" language="VBScript">
				Return = GetNodeDisplayName(Value)
				if( Return &lt;&gt; "" ) then
				    if( (Value(4) &gt; 0) or (Value(5) &gt; 0) or (Value(6) &gt; 0) ) then
					Return = Return &amp; " (" &amp; Value(4) + Value(5) + Value(6) &amp; ")"
				    end if
				end if
			</script>
			<script id="xfDisplay" language="VBScript">
				if( IsEmpty(Value) ) then
					Return = "none"
				else
					Return = "inline"
				end if
			</script>
			<script id="xfUnavailableImg" language="VBScript">
				Return = GetUnavailableImagePath(Value)
			</script>
		</xforms>
	</XFormXML>
	<HTMLWrapperXML>
		<HTMLWrappers>
			<MenuItemWrapper>
				<Begin>
					&lt;div style="position: relative; width: 170px; padding-bottom: 2px; padding-top: 1px; padding-right: 5px;" onmouseenter="OnEnter_MenuItem(this)" onmouseleave="OnLeave_MenuItem(this)"&gt;&lt;span&gt;
				</Begin>
				<End>
					&lt;/span&gt;&lt;/div&gt;
				</End>
			</MenuItemWrapper>
			<FilterAppliedWrapper>
				<Begin>
					&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; margin-right: 1px; background-color: mediumblue; color: white; font-weight: bold;"&gt;
				</Begin>
				<End>
					&lt;/span&gt;
				</End>
			</FilterAppliedWrapper>
			<SortAscIndicator>
				&amp;nbsp;&lt;img src="Images/SortArrowUp.gif"&gt;
			</SortAscIndicator>
			<SortDescIndicator>
				&amp;nbsp;&lt;img src="Images/SortArrowDown.gif"&gt;
			</SortDescIndicator>
			<GroupSeparator>
				&lt;div style="position:relative; width: 160px; height: 2px; overflow: hidden; display: block; border: 1px inset; margin: 3px;" &gt;&lt;/div&gt;
			</GroupSeparator>
		</HTMLWrappers>
	</HTMLWrapperXML>
	<MenuGroupXML>
		<MenuGroups>
			<CommandGroup id="LocationContextMenuGroup">
				<StandardCommand id="Command_ShelveLocation" Command="ShelveLocation">
					&lt;div title="Shelve the selected location" style="padding: 1px; width: 100%;" class="contextMenu_Shelve"&gt;
					&amp;nbsp;Shelve Location...
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_UnshelveLocation" Command="UnshelveLocation">
					&lt;div title="Unshelve the selected location" style="padding: 1px; width: 100%;" class="contextMenu_Unshelve"&gt;
					&amp;nbsp;Unshelve Location
					&lt;/div&gt;
				</StandardCommand>
			</CommandGroup>
		</MenuGroups>
	</MenuGroupXML>
	<BaseFilterXML>
		<BaseFilterDef>
		</BaseFilterDef>
	</BaseFilterXML>
	<SortXML>
		<SortDef DefaultSortColumn="Tree" DefaultSortDir="asc">
			<colref id="Tree" 
				SortAscString="EntityName asc"
				SortDescString="EntityName desc"
				SortDir="asc"
				SortOrder="1"/>
		</SortDef>
	</SortXML>
	<ColumnStateXML>
		<state>
			<colref id="Tree" width="100" hidden="false" />
		</state>
	</ColumnStateXML>
	<TableDefinitionXML>
		<table>
			<tableMenu/>
			<contextMenu>
				<GroupRef GroupId="LocationContextMenuGroup"/>
			</contextMenu>
			<columns>
				<column id="Tree">
					<title>Tree</title>
					<action/>
					<menu/>
					<content>
					    &lt;div language="javascript" onmousedown="if( event.button != 1 &amp;&amp; event.button != 2 ) { event.cancelBubble = true; return false; }"
						        language="javascript" ExpandCollapseTrigger=0&gt;
					      &lt;div class="TreeNodeGroup"&gt;	    
						&lt;div class="TreeNodePlusMinus"
							onmousedown="if( event.button == 1 ) { this.parentElement.parentElement.ExpandCollapseTrigger = 1; event.cancelBubble = true; }"
							onclick="event.cancelBubble = true; return false;"&gt;
							&lt;img class="PlusMinusIcon" src="Images/blank.gif"/&gt;
						&lt;/div&gt;
					        &lt;div language="javascript" ondblclick="AreaTable.Binding.DataObjects(0).PointDetail();" class="TreeNodeIconGroup"&gt;
					        &lt;div class="TreeAssetIcon"&gt;
								&lt;img src="Images/blank.gif"&gt;
							&lt;/div&gt;
					        &lt;div class="TreeAssetIcon"&gt;
								&lt;img src="Images/blank.gif"&gt;
							&lt;/div&gt;
							&lt;div _opacityACKED="60"
								_opacityON="100"
								_opacityOFF="30"
								_tooltipType="1"
								class="TreeNodeAlarmIcon"
								style="behavior: url(#AlarmStateIconFactory#AlarmIcon);"&gt;
							&lt;/div&gt;
						&lt;/div&gt;
					        &lt;div language="javascript" ondblclick="AreaTable.Binding.DataObjects(0).PointDetail();" class="treeNodeLabel"&gt;&lt;/div&gt;
					      &lt;/div&gt;  
					    &lt;/div&gt;
					</content>
					<bindings>
						<in fields="Depth" properties="firstChild.style.pixelLeft" xforms="xfPadding" />
						<in fields="Depth" properties="style.display" xforms="xfDisplay" />
						<in fields="NumChildren;Expanded" properties="firstChild.firstChild.firstChild.src" xforms="xfPlusMinusImg" />
						<in fields="RemoteType;SubType;ItemNumber;Redundant" properties="firstChild.firstChild.nextSibling.firstChild.firstChild.src" xforms="xfIconImg" />
						<in fields="EntityName;Type;SubType;DirectConnect" properties="firstChild.firstChild.nextSibling.firstChild.nextSibling.firstChild.src" xforms="xfUnavailableImg" />
						<in fields="EntityName;RemoteType;SubType;ItemNumber;TotalActiveAlerts(%StationNumber%);TotalRTNAlerts(%StationNumber%);TotalDisabledAlerts(%StationNumber%)" properties="firstChild.lastChild.innerText;title" xforms="xfNameAndCount" />
						<in fields="TotalActiveAlerts(%StationNumber%);TotalRTNAlerts(%StationNumber%);TotalDisabledAlerts(%StationNumber%)" properties="firstChild.lastChild.style.fontWeight" xforms="xfBold" />
						<in fields="Selected;IsAssigned" properties="firstChild.lastChild.id" xforms="xfSelection"/>
						<in fields="TotalActiveUnackAlerts(%StationNumber%);TotalRTNUnackAlerts(%StationNumber%);TotalActiveAckAlerts(%StationNumber%);TotalDisabledAlerts(%StationNumber%);TotalShelvedAlerts(%StationNumber%)" properties="firstChild.firstChild.nextSibling.firstChild.style.visibility;firstChild.firstChild.nextSibling.firstChild.nextSibling.style.visibility" xforms="xfIconVisible"/>
						<in fields="TotalActiveUnackAlerts(%StationNumber%);TotalRTNUnackAlerts(%StationNumber%);TotalActiveAckAlerts(%StationNumber%);TotalDisabledAlerts(%StationNumber%)" properties="firstChild.firstChild.nextSibling.lastChild.Category" xforms="xfCategory"/>
						<in fields="TotalActiveUnackAlerts(%StationNumber%);TotalRTNUnackAlerts(%StationNumber%)" properties="firstChild.firstChild.nextSibling.lastChild.Acknowledged" xforms="xfAcked"/>
						<in fields="TotalActiveUnackAlerts(%StationNumber%);TotalRTNUnackAlerts(%StationNumber%)" properties="firstChild.firstChild.nextSibling.lastChild.RTN" xforms="xfRTN"/>
						<in fields="TotalActiveUnackAlerts(%StationNumber%);TotalRTNUnackAlerts(%StationNumber%);TotalActiveAckAlerts(%StationNumber%);TotalDisabledAlerts(%StationNumber%)" properties="firstChild.firstChild.nextSibling.lastChild.Disabled" xforms="xfDisabled"/>
						<in fields="TotalActiveUnackAlerts(%StationNumber%);TotalRTNUnackAlerts(%StationNumber%);TotalActiveAckAlerts(%StationNumber%);TotalDisabledAlerts(%StationNumber%);TotalShelvedAlerts(%StationNumber%)" properties="firstChild.firstChild.nextSibling.lastChild.Shelved" xforms="xfShelved"/>
						<out properties="ExpandCollapseTrigger" fields="Expanded"/>
					</bindings>
				</column>
			</columns>
		</table>
	</TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
</DATAOBJECT>
<DATAOBJECT id="3" type="HMIPage.Generic" format="propertybag">
<PROPERTY name="AddressFlags">0</PROPERTY>
<PROPERTY name="AddressType">1</PROPERTY>
<PROPERTY name="FileRefFile">2</PROPERTY>
<PROPERTY name="FileRefFlags">2048</PROPERTY>
<PROPERTY name="FileRefFormat">1</PROPERTY>
<PROPERTY name="FileRefRecord">1</PROPERTY>
<PROPERTY name="FileRefWord">99</PROPERTY>
<PROPERTY name="ObjectType">0</PROPERTY>
<PROPERTY name="PresentationType">0</PROPERTY>
<PROPERTY name="SecurityLevel">0</PROPERTY>
<PROPERTY name="UpdatePeriod">0</PROPERTY>
<PROPERTY name="version">1.2</PROPERTY>
</DATAOBJECT>
<DATAOBJECT id="4" type="HMIPage.Generic" format="propertybag">
<PROPERTY name="AddressFlags">0</PROPERTY>
<PROPERTY name="AddressType">1</PROPERTY>
<PROPERTY name="FileRefFile">2</PROPERTY>
<PROPERTY name="FileRefFlags">2048</PROPERTY>
<PROPERTY name="FileRefFormat">1</PROPERTY>
<PROPERTY name="FileRefRecord">1</PROPERTY>
<PROPERTY name="FileRefWord">100</PROPERTY>
<PROPERTY name="ObjectType">0</PROPERTY>
<PROPERTY name="PresentationType">0</PROPERTY>
<PROPERTY name="SecurityLevel">0</PROPERTY>
<PROPERTY name="UpdatePeriod">0</PROPERTY>
<PROPERTY name="version">1.2</PROPERTY>
</DATAOBJECT>
</DATASOURCE>

