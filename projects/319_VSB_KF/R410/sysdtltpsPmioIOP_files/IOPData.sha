ue="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding>'>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[if not sd.QualityBad("BoxPoint.paramIOMCMD") then
   	sd.DataValue("BoxPoint.paramIOMCMD") = "SELCHNA"
end if]]></script></scripts></html><binding/></element><element><html><content><![CDATA[<INPUT tabIndex=7 id=pbSwapPrimary class="hsc.button.1 ActionButtonStyle" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; CURSOR: hand; BORDER-LEFT-STYLE: none; HEIGHT: 95.83%; FONT-FAMILY: arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 31.65%; BACKGROUND-IMAGE: url(file:./IOPData_files/btnBase_138x23.png); BACKGROUND-REPEAT: no-repeat; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; COLOR: black; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 68.11%; BORDER-RIGHT-COLOR: #ffffff; TOP: 0%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #959595" type=button value="Swap primary IOP" hdxproperties="fillColor:#959595;fillColorBlink:False;HDXBINDINGID:-4;indicateBadState:False;indicateNaNState:False;indicateScanState:False;lineColorBlink:False;styleClass:ActionButtonStyle;textColor:Black;textColorBlink:False;ToggleState:False;" HDX_LOCK="-1" shapesrc=".\IOPData_files\btnBase_138x23.png" BindingDef='<binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="5"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="5"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="180"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="5003"/><property name="TaskParam2" varianttype="VT_BSTR" value="0"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding>'>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[if not sd.QualityBad("BoxPoint.paramIOMCMD") then
	if sd.DataValue("BoxPoint.paramIOMCMD") = "SELCHNA" then
		sd.DataValue("BoxPoint.paramIOMCMD") = "SELCHNB"
	elseif sd.DataValue("BoxPoint.paramIOMCMD") = "SELCHNB" then
		sd.DataValue("BoxPoint.paramIOMCMD") = "SELCHNA"
	end if
'   	sd.DataValue("BoxPoint.paramIOMCMD") = "SWAP"  '<< didn't work
end if]]></script></scripts></html><binding/></element><html><content><![CDATA[
