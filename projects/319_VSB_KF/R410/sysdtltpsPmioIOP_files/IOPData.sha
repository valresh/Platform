<DIV tabIndex=-1 id=txtFTAPresent class="hvg.textbox.1 Field_Label_Style" style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 6.57%; FONT-FAMILY: arial; WIDTH: 45.66%; POSITION: absolute; COLOR: #000000; TEXT-ALIGN: left; LEFT: 0%; TOP: 78%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior); VISIBILITY: inherit" hdxproperties="FillColor:Transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:23;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;styleClass:Field_Label_Style;textColor:black;textColorBlink:False;TotalRotation:-1;Width:200;">FTA present:</DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtFTAPresent001 class="hvg.textbox.1 Field_Label_Style" style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 6.57%; FONT-FAMILY: arial; WIDTH: 45.66%; POSITION: absolute; COLOR: #000000; TEXT-ALIGN: left; LEFT: 0%; TOP: 85.14%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior); VISIBILITY: inherit" hdxproperties="FillColor:Transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:23;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;styleClass:Field_Label_Style;textColor:black;textColorBlink:False;TotalRotation:-1;Width:200;">Fail Option:</DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=sd class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 5.42%; FONT-FAMILY: Arial; WIDTH: 7.53%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #8b0000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 23.05%; TOP: 28.85%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#8b0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	if sd.QualityGood("BoxPoint.paramFAILOPT") then
		alpFAILOPT.style.visibility = "Inherit"
	else
		alpFAILOPT.style.visibility = "Hidden"
	end if

	if sd.QualityGood("BoxPoint.paramFAILOPTB") then
		alpFAILOPTB.style.visibility = "Inherit"
	else
		alpFAILOPTB.style.visibility = "Hidden"
	end if

	if sd.QualityGood("BoxPoint.SYNCHSTS({%Parameter::IOMNUMIndex%})") then
		alpRedunStatusA.style.visibility = "Inherit"
	else
		alpRedunStatusA.style.visibility = "Hidden"
	end if	

	if sd.QualityGood("UCNPOINT.IOPBHWREV") then
		if sd.DataValue("UCNPOINT.IOPBHWREV") = 0 then ' Module is NOT redundant, hide redundant data
			grpSecIOPErrors.style.visibility = "Hidden"
			g_bRedundant = FALSE
			txtSimulationB.style.visibility = "hidden"  'on main page
			alpModelNumberB.style.visibility = "hidden"

		else ' Module IS redundant, show redundant data
			grpSecIOPErrors.style.visibility = "Inherit"
			g_bRedundant = TRUE
			if g_bSimulated then  ' show for redundant whether simulated or not
				txtSimulationB.style.visibility = "visible"
				alpModelNumberB.style.visibility = "hidden"
			else
				txtSimulationB.style.visibility = "hidden"   
				alpModelNumberB.style.visibility = "Inherit"
			end if
		end if
	else ' cannot tell from IOPBHWREV value, assume non-redundant
		grpSecIOPErrors.style.visibility = "Hidden"
		g_bRedundant = FALSE
		txtSimulationB.style.visibility = "hidden"  'on main page
		alpModelNumberB.style.visibility = "hidden"
	end if


	if g_bRedundant then 'sd.DataValue("CurrentPoint.IOMHWREVB") > 0 then 'non redundant
		grpIOPB.style.visibility = "Inherit"
		grpCommand.style.visibility = "Inherit"
	else
		grpIOPB.style.visibility = "Hidden"
		grpCommand.style.visibility = "Hidden"
	end if

	if sd.QualityGood("BoxPoint.paramIOMCMD") then
		if sd.DataValue("BoxPoint.paramIOMCMD") = "SELCHNA" then
			pbSelectCableA.disabled = true
			pbSelectCableB.disabled = false
		elseif sd.DataValue("BoxPoint.paramIOMCMD") = "SELCHNB" then
			pbSelectCableA.disabled = false
			pbSelectCableB.disabled = true
		elseif sd.DataValue("BoxPoint.paramIOMCMD") = "NONE" then
			pbSelectCableA.disabled = false
			pbSelectCableB.disabled = false
		else
			pbSelectCableA.disabled = false
			pbSelectCableB.disabled = false
		end if
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::BoxPoint%},{%Point::CurrentPoint%},{%Point::UCNPoint%},{%Point::BoxPoint%},{%Point::BoxPoint%},{%Point::BoxPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::paramFAILOPT%},IOMTYPE,IOPBHWREV,{%Parameter::paramIOMCMD%},{%Parameter::paramFAILOPTB%},SYNCHSTS({%Parameter::IOMNUMIndex%}),"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,1,0,1,0,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="60,60,60,10,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,0,"/><proper