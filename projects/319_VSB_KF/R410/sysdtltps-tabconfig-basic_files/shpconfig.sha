bVisibilityUpdated = FALSE

public formatPV
public formatSP
public bPVSPFormatSet
formatPV = -1
formatSP = -1
bPVSPFormatSet = False]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue=""/><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectSpacerTL class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 0.18%; FONT-FAMILY: Arial; WIDTH: 0.13%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect); VISIBILITY: hidden" hdxproperties="FillColor:#ff0000;fillColorBlink:False;Height:1;lineColorBlink:False;Width:1;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" style="FONT-SIZE: 7pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.16%; FONT-FAMILY: Small Fonts; WIDTH: 10.02%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ff0000; TEXT-ALIGN: center; LEFT: 28.69%; TOP: 85.37%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:12;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:72;">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	if bVisibilityUpdated = FALSE then
		GrpConfigHeader.style.visibility = "Inherit"
	end if

	if not bPVSPFormatSet then
	'   Format SP and PV related parameters to SPFORMAT and PVFORMAT as available
		bPVSPFormatSet = True
	    
	    If sd.QualityGood("tagname.PVFORMAT") Then
    
	        Select Case sd.DataValue("tagname.PVFORMAT")
	        Case "D0"
	            formatPV = 0
	        Case "D1"
	            formatPV = 1
	        Case "D2"
	            formatPV = 2
	        Case "D3"
	            formatPV = 3
	        Case "D4"
	            formatPV = 4
	        Case "D5"
	            formatPV = 5
	        Case "D6"
	            formatPV = 6
	        Case Else
	            formatPV = -1  ' if using FormatNumber, -1 means "computer's regional setting"
	        End Select
	    End If   

	    If sd.QualityGood("tagname.SPFORMAT") Then
    
	        Select Case sd.DataValue("tagname.SPFORMAT")
	        Case "D0"
	            formatSP = 0
	        Case "D1"
	            formatSP = 1
	        Case "D2"
	            formatSP = 2
	        Case "D3"
	            formatSP = 3
	        Case "D4"
	            formatSP = 4
	        Case "D5"
	            formatSP = 5
	        Case "D6"
	            formatSP = 6
	        Case Else
	            formatSP = -1  ' use default - i.e. computer's regional setting
	        End Select
	    End If   'defaulted to 2

		if formatSP = -1 then 'default to PVFORMAT
			formatSP = formatPV
		end if

        If Not formatPV = -1 Then
			param_N.numericdisplayformat = "%." & formatPV & "f"
			param_M.numericdisplayformat = "%." & formatPV & "f"
			param_LOCUTOFF.numericdisplayformat = "%." & formatPV & "f"
			param_OPALDB.numericdisplayformat = "%." & formatPV & "f"
			param_FLTRCNST.numericdisplayformat = "%." & formatPV & "f"
			param_DLYTIME.numericdisplayformat = "%." & formatPV & "f"
			param_REALARM.numericdisplayformat = "%." & formatPV & "f"
			param_PVALDBEU.numericdisplayformat = "%." & formatPV & "f"

		End if

        If Not formatSP = -1 Then          
			param_SPTOL.numericdisplayformat = "%." & formatPV & "f"

			'room for more if ever necessary!
        End If

	end if 

