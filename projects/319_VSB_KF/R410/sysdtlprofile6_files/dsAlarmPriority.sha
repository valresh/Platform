<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="20px" height="20px"><versionheaders><versionheader name="PS" value="4.5"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[on error resume next
me.objects("TxtGhost").style.cursor="default"]]></script><script event="" language="VBScript" id="19C1303C-87F5-46C2-ADCE-CA32DA95EEFA"><![CDATA[Sub Alarmpr(oSource)
dim oShape,iUnackAlarm,iAlarmPriority
set oShape=oSource.parentnode.parentnode

iAckd=(oSource.alarm and &H00000800)/1024
iAlarmPriority=(oSource.alarm and &H00000030)/16

oShape.objects("Icon001").priority=iAlarmPriority
oShape.objects("Icon001").acknowledged=iAckd
if iAlarmPriority=0 and iAckd=0 then 
 oShape.objects("GrpGhost").style.visibility="visible"
else
 oShape.objects("GrpGhost").style.visibility="hidden"
end if
end sub]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/></parameters><shapes><shape><group><element><html><content><![CDATA[
