<DIV style="POSITION: absolute; TEXT-ALIGN: left; FONT-STYLE: normal; WIDTH: 93.33%; FONT-FAMILY: Tahoma; HEIGHT: 34.78%; COLOR: #000000; FONT-SIZE: 8pt; OVERFLOW: hidden; TOP: 65.21%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 0%" id=textDevIxNotAssigned class=hvg.textbox.1 title="Device Index: Not Assigned" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:113;">Not Assigned</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 100%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 30.43%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 32.6%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 0%; ROWS: 1" id=alphaCompStatus class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;indicateScanState:-1;lineColor:transparent;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[Dim sVal
	on error resume next
	if IsStsGoodQuality(me) then
		sVal = me.value
		select case sVal
			case "5" shpCompStsLED.value = 2
			case "4" shpCompStsLED.value = 3
			case "3" shpCompStsLED.value = 4
			case else shpCompStsLED.value = 1	' black
		end select
		shpCompStsLED.style.visibility = "inherit"
		textStatusLabel.style.visibility = "inherit"
	else
		shpCompStsLED.style.visibility = "hidden"
		textStatusLabel.style.visibility = "hidden"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::FteDevicePoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramCompStatus%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 46.66%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 30.43%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 0%; ROWS: 1" id=alphaDeviceIndex class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;indicateScanState:-1;lineColor:transparent;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[Dim sVal
	on error resume next
	if IsStsGoodQuality(me) then
		sVal = me.value
		if sVal = 0 then sVal = textDevIxNotAssigned.value
		textIndexValue.value = sVal
		textIndexValue.style.visibility = "inherit"
		textIndexLabel.style.visibility = "inherit"
		textIndexBad.style.visibility = "hidden"
	else
		textIndexBad.style.visibility = "inherit"
		textIndexValue.style.visibility = "hidden"
		textIndexLabel.style.visibility = "hidden"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::FteDevicePoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramDeviceIndex%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
