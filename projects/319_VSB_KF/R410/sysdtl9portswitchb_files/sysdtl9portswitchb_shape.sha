<?xml version="1.0"?><shapefile version="1" type="dynamic" title="Control Firewall 9 Port Switch Detail Display Shape" description="" useFirstShapeForBadValue="0" width="568px" height="476px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="VBScript" id="3DF190A9-E734-4E73-8CA8-73056A80BDC1"><![CDATA['
' General Section (sysdtl9portswitchb_shape.sha)
option explicit

Dim nSelectIx
Dim sParamBase
Dim sSPSPoint

sub Init9PortShape(objShape, sPoint, sBasePath)
Dim objPortSelectCombo
Dim ix
	on error resume next
	Err.Clear
	set objPortSelectCombo = objShape.Objects("cbPortSelect")
	if Err.Number = 0 And IsObject(objPortSelectCombo) then
		objPortSelectCombo.ResetContent
		objPortSelectCombo.AddString "Select a Port"
		objPortSelectCombo.AddString objShape.Objects("textUplinkLabel").value
		for ix = 1 to 8
			objPortSelectCombo.AddString "Port " & ix
		next
		objPortSelectCombo.selectedIndex = 0
		sParamBase = sBasePath
		sSPSPoint = sPoint
	end if

	nSelectIx = 0
end sub
' end General Section (sysdtl9portswitchb_shape.sha)
']]></script></scripts><shapes><shape><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; FONT-STYLE: normal; WIDTH: 8.8%; FONT-FAMILY: Tahoma; HEIGHT: 2.94%; VISIBILITY: hidden; COLOR: #000000; FONT-SIZE: 8pt; OVERFLOW: hidden; TOP: 2.94%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 4.4%" id=textUplinkLabel class=hvg.textbox.1 tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:14;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:50;">Uplink</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; FONT-STYLE: normal; WIDTH: 15.49%; FONT-FAMILY: Tahoma; HEIGHT: 4.2%; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 4.22%" id=txtPortSelect class=hvg.textbox.1 tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:20;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:88;">Selected Port</DIV>]]></content></html></element><element><html><content><![CDATA[<SPAN style="POSITION: absolute; TEXT-ALIGN: left; BACKGROUND-COLOR: white; FONT-STYLE: normal; TEXT-INDENT: 2px; WIDTH: 56.33%; FONT-FAMILY: Tahoma; HEIGHT: 4.2%; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior); LEFT: 21.12%" id=cbPortSelect class=hsc.combo.1 tabIndex=0 hdxproperties="borderStyle:inset;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColor:#000000;textColorBlink:False;">Combobox</SPAN>]]></content><scripts><script event="onchange" language="VBScript"><![CDATA[Dim ix

	on error resume next
	ix = me.selectedIndex

	' MsgBox "SelectionChange(" & ix & ") Prev: " & nSelectIx 
		
	' if no change just exit
	if ix = nSelectIx then exit sub

	' can't do anything if we have not been initialized yet
	if sParamBase = "" Or sSPSPoint = "" then 
		' MsgBox "Empty Custom Properties"
		nSelectIx = 0
		me.selectedIndex = nSelectIx
	else
		nSelectIx = ix
	end if

	' MsgBox "nSelectIx: " & nSelectIx
	if nSelectIx = 0 then
		shpValues.style.visibility = "hidden"
		shpValues.autoReloadContent = false
		shpValues.SetCustomProperty "Point", "SPSPoint", NULL
		shpValues.SetCustomProperty "Parameter", "TX_OCTETS_Param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_DROP_Param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_BROADCAST_Param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_MULTICAST_Param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_UNICAST_param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_COLLISION_param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_SINGLE_COLLISION_param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_MULTI_COLLISION_param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_DEFERRED_param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_LATE_COLLISION_param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_EXCESSIVE_param", NULL
		shpValues.SetCustomProperty "Parameter", "OUTPUT_FRAME_DISCARD_param", NULL
		shpValues.SetCustomProperty "Parameter", "TX_PAUSE_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_OCTETS_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_UNDERSIZE_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_PAUSE_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_32_64_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_65_127_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_128_255_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_256_511_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_512_1023_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_1024_1522_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_OVERSIZE_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_JABBER_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_ALIGN_ERROR_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_FCS_ERROR_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_GOOD_OCTETS_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_DROPPED_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_UNICAST_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_UNICAST_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_MULTICAST_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_BROADCAST_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_SA_CHANGES_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_FRAGMENTS_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_TOOBIG_DISCARDED_param", NULL
		shpValues.SetCustomProperty "Parameter", "RX_SYMBOL_ERROR_param", NULL
	else
		shpValues.autoReloadContent = false
		strParamBase = sParamBase & ",PortNumber=" & CStr(nSelectIx - 1)
 		' MsgBox "strParamBase: " & strParamBase
		shpValues.SetCustomProperty "Point", "SPSPoint", sSPSPoint
		shpValues.SetCustomProperty "Parameter", "TX_OCTETS_Param", strParamBase & ".TX_OCTETS"
		shpValues.SetCustomProperty "Parameter", "TX_DROP_Param", strParamBase & ".TX_DROP"
		shpValues.SetCustomProperty "Parameter", "TX_BROADCAST_Param", strParamBase & ".TX_BROADCAST"
		shpValues.SetCustomProperty "Parameter", "TX_MULTICAST_Param", strParamBase & ".TX_MULTICAST"
		shpValues.SetCustomProperty "Parameter", "TX_UNICAST_param", strParamBase & ".TX_UNICAST"
		shpValues.SetCustomProperty "Parameter", "TX_COLLISION_param", strParamBase & ".TX_COLLISION"
		shpValues.SetCustomProperty "Parameter", "TX_SINGLE_COLLISION_param", strParamBase & ".TX_SINGLE_COLLISION"
		shpValues.SetCustomProperty "Parameter", "TX_MULTI_COLLISION_param", strParamBase & ".TX_MULTI_COLLISION"
		shpValues.SetCustomProperty "Parameter", "TX_DEFERRED_param", strParamBase & ".TX_DEFERRED"
		shpValues.SetCustomProperty "Parameter", "TX_LATE_COLLISION_param", strParamBase & ".TX_LATE_COLLISION"
		shpValues.SetCustomProperty "Parameter", "TX_EXCESSIVE_param", strParamBase & ".TX_EXCESSIVE"
		shpValues.SetCustomProperty "Parameter", "OUTPUT_FRAME_DISCARD_param", strParamBase & ".OUTPUT_FRAME_DISCARD"
		shpValues.SetCustomProperty "Parameter", "TX_PAUSE_param", strParamBase & ".TX_PAUSE"
		shpValues.SetCustomProperty "Parameter", "RX_OCTETS_param", strParamBase & ".RX_OCTETS"
		shpValues.SetCustomProperty "Parameter", "RX_UNDERSIZE_param", strParamBase & ".RX_UNDERSIZE"
		shpValues.SetCustomProperty "Parameter", "RX_PAUSE_param", strParamBase & ".RX_PAUSE"
		shpValues.SetCustomProperty "Parameter", "RX_32_64_param", strParamBase & ".RX_32_64"
		shpValues.SetCustomProperty "Parameter", "RX_65_127_param", strParamBase & ".RX_65_127"
		shpValues.SetCustomProperty "Parameter", "RX_128_255_param", strParamBase & ".RX_128_255"
		shpValues.SetCustomProperty "Parameter", "RX_256_511_param", strParamBase & ".RX_256_511"
		shpValues.SetCustomProperty "Parameter", "RX_512_1023_param", strParamBase & ".RX_512_1023"
		shpValues.SetCustomProperty "Parameter", "RX_1024_1522_param", strParamBase & ".RX_1024_1522"
		shpValues.SetCustomProperty "Parameter", "RX_OVERSIZE_param", strParamBase & ".RX_OVERSIZE"
		shpValues.SetCustomProperty "Parameter", "RX_JABBER_param", strParamBase & ".RX_JABBER"
		shpValues.SetCustomProperty "Parameter", "RX_ALIGN_ERROR_param", strParamBase & ".RX_ALIGN_ERROR"
		shpValues.SetCustomProperty "Parameter", "RX_FCS_ERROR_param", strParamBase & ".RX_FCS_ERROR"
		shpValues.SetCustomProperty "Parameter", "RX_GOOD_OCTETS_param", strParamBase & ".RX_GOOD_OCTETS"
		shpValues.SetCustomProperty "Parameter", "RX_DROPPED_param", strParamBase & ".RX_DROPPED"
		shpValues.SetCustomProperty "Parameter", "RX_UNICAST_param", strParamBase & ".RX_UNICAST"
		shpValues.SetCustomProperty "Parameter", "RX_MULTICAST_param", strParamBase & ".RX_MULTICAST"
		shpValues.SetCustomProperty "Parameter", "RX_BROADCAST_param", strParamBase & ".RX_BROADCAST"
		shpValues.SetCustomProperty "Parameter", "RX_SA_CHANGES_param", strParamBase & ".RX_SA_CHANGES"
		shpValues.SetCustomProperty "Parameter", "RX_FRAGMENTS_param", strParamBase & ".RX_FRAGMENTS"
		shpValues.SetCustomProperty "Parameter", "RX_TOOBIG_DISCARDED_param", strParamBase & ".RX_TOOBIG_DISCARDED"
		shpValues.SetCustomProperty "Parameter", "RX_SYMBOL_ERROR_param", strParamBase & ".RX_SYMBOL_ERROR"
		
		shpValues.ReloadContent
		shpValues.style.visibility = "inherit"
	end if]]></script></scripts></html><binding/></element><group><group><element><html><content><![CDATA[
