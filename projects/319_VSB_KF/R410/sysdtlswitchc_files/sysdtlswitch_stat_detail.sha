<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="720px" height="470px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><scripts><script event="" language="VBScript" id="0B9F1CD7-F4B0-4C23-9545-2712BF32A218"><![CDATA['
' General Section (sysdtlswitch_stat_detail.sha)

sub InitStatusDetail(objShape, sIfKey)
Dim sParmBase, obj
	if sIfKey = "" then
		with objShape
			.autoReloadContent = false
			.SetCustomProperty "Parameter", "ParamInDiscards", ""
			.SetCustomProperty "Parameter", "ParamInErrors", ""
			.SetCustomProperty "Parameter", "ParamInNUcastPkts", ""
			.SetCustomProperty "Parameter", "ParamInOctets", ""
			.SetCustomProperty "Parameter", "ParamInUcastPkts", ""
			.SetCustomProperty "Parameter", "ParamInUnknownProtos", ""
			.SetCustomProperty "Parameter", "ParamMtu", ""
			.SetCustomProperty "Parameter", "ParamOutDiscards", ""
			.SetCustomProperty "Parameter", "ParamOutErrors", ""
			.SetCustomProperty "Parameter", "ParamOutNUcastPkts", ""
			.SetCustomProperty "Parameter", "ParamOutOctets", ""
			.SetCustomProperty "Parameter", "ParamOutQLen", ""
			.SetCustomProperty "Parameter", "ParamOutUcastPkts", ""
			.SetCustomProperty "Parameter", "ParamOperStatus", ""
			.SetCustomProperty "Parameter", "ParamSpeed", ""
			.SetCustomProperty "Point", "SPSPoint", ""
			.ReloadContent
		end with
	else
		sParmBase = "localhost.[ROOT\SNMP\" & sSwitchName & "].SNMP_RFC1213_MIB_IFTABLE." & sIfKey
		with objShape
			.autoReloadContent = false
			.SetCustomProperty "Parameter", "ParamInDiscards", sParmBase & ".ifInDiscards"
			.SetCustomProperty "Parameter", "ParamInErrors", sParmBase & ".ifInErrors"
			.SetCustomProperty "Parameter", "ParamInNUcastPkts", sParmBase & ".ifInNUcastPkts"
			.SetCustomProperty "Parameter", "ParamInOctets", sParmBase & ".ifInOctets"
			.SetCustomProperty "Parameter", "ParamInUcastPkts", sParmBase & ".ifInUcastPkts"
			.SetCustomProperty "Parameter", "ParamInUnknownProtos", sParmBase & ".ifInUnknownProtos"
			.SetCustomProperty "Parameter", "ParamMtu", sParmBase & ".ifMtu"
			.SetCustomProperty "Parameter", "ParamOutDiscards", sParmBase & ".ifOutDiscards"
			.SetCustomProperty "Parameter", "ParamOutErrors", sParmBase & ".ifOutErrors"
			.SetCustomProperty "Parameter", "ParamOutNUcastPkts", sParmBase & ".ifOutNUcastPkts"
			.SetCustomProperty "Parameter", "ParamOutOctets", sParmBase & ".ifOutOctets"
			.SetCustomProperty "Parameter", "ParamOutQLen", sParmBase & ".ifOutQLen"
			.SetCustomProperty "Parameter", "ParamOutUcastPkts", sParmBase & ".ifOutUcastPkts"
			.SetCustomProperty "Parameter", "ParamOperStatus", sParmBase & ".ifOperStatus"
			.SetCustomProperty "Parameter", "ParamSpeed", sParmBase & ".ifSpeed"
			.SetCustomProperty "Point", "SPSPoint", sPoint
			.ReloadContent
		end with
	end if
	for each obj in objShape.Objects("grpDataItems").children
		obj.style.visibility = "hidden"
	next

end sub

sub ShowNumber(ByRef objMe)
	Dim nValue
	objMe.style.visibility = "inherit"
	nValue = CDbl(objMe.value)
	if nValue < 0 then nValue = 4294967296.0 + nValue
	objMe.value = FormatNumber(nValue, 0, TristateFalse,  TristateFalse, TristateTrue)
End Sub

sub ShowTextPath(ByRef objMe, ByRef objDisplay, sPath)
	if not objMe.DataChanged(sPath) then exit sub
	objDisplay.value = objMe.DataValue(sPath)
	objDisplay.style.visibility = "inherit"
End Sub

sub ShowMBitPath(ByRef objMe, ByRef objDisplay, sPath)
	Dim nValue
	if not objMe.DataChanged(sPath) then exit sub
	nValue = CDbl(objMe.DataValue(sPath))
	if Abs(nValue) < 10000 then
		objDisplay.value = "0"
	else
		if nValue < 0 then nValue = CDbl(4294967296.0) + nValue
		objDisplay.value = FormatNumber((nValue + 200000) / 1000000, 0, TristateFalse,  TristateFalse, TristateTrue)
	end if
	objDisplay.style.visibility = "inherit"
End Sub

sub ShowNumberPath(ByRef objMe, ByRef objDisplay, sPath)
	Dim nValue
	if not objMe.DataChanged(sPath) then exit sub

	sValue = objMe.DataValue(sPath)
	if sValue = "" or sValue = "0" then
		objDisplay.value = "0"
	else
		nValue = CDbl(sValue)
		if nValue < 0 then nValue = CDbl(4294967296.0) + nValue
		objDisplay.value = FormatNumber(nValue, 0, TristateFalse,  TristateFalse, TristateTrue)
	end if
	objDisplay.style.visibility = "inherit"
End Sub
' End General Section (sysdtlswitch_stat_detail.sha)
']]></script></scripts><parameters><parameter name="SwitchName" type="Value" description="input" defaultvalue=""/><parameter name="SNMPHost" type="Value" description="input" defaultvalue=""/><parameter name="SPSPoint" type="Point" description="internal" defaultvalue=""/><parameter name="ParamInDiscards" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamInErrors" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamInNUcastPkts" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamInOctets" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamInUcastPkts" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamInUnknownProtos" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamMtu" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamOutDiscards" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamOutErrors" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamOutNUcastPkts" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamOutOctets" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamOutQLen" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamOutUcastPkts" type="Parameter" description="internal" defaultvalue=""/><parameter name="PortIndex" type="Value" description="input" defaultvalue=""/><parameter name="ParamOperStatus" type="Parameter" description="internal" defaultvalue=""/><parameter name="ParamSpeed" type="Parameter" description="internal" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=alpha001 style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 24.72%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#H