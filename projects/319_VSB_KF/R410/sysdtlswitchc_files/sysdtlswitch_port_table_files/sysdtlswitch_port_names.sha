<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="40px" height="16px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><scripts><script event="" language="VBScript" id="1258BCC9-5FE9-4E87-B719-BE8478BD3442"><![CDATA['
' General Section (sysdtlswitch_port_table.sha)
option explicit
Dim nRememberedCount

Sub InitPortList(objShape)
Dim ix
'	on error resume next
	if nRememberedCount = nPortCount then exit sub
	nRememberedCount = nPortCount
	objShape.autoReloadContent = false
	for ix = 0 to nPortCount - 1
		objShape.SetCustomProperty "Parameter", "paramPort" & ix, sPartPath & ix
	next
	for ix = nPortCount to 49
		objShape.SetCustomProperty "Parameter", "paramPort" & ix, ""
	next
	objShape.SetCustomProperty "Point", "pointTable", sPoint
	objShape.ReloadContent
end sub
' End General Section (sysdtlswitch_port_table.sha)
']]></script></scripts><parameters><parameter name="paramPort0" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort1" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort2" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort3" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort4" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort5" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort6" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort7" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort8" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort9" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort10" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort11" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort12" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort13" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort14" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort15" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort16" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort17" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort18" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort19" type="Parameter" description="path to ifIndex" defaultvalue=""/><parameter name="paramPort20" type="Parameter" description="path to ifIndex" defaultvalue=""/><