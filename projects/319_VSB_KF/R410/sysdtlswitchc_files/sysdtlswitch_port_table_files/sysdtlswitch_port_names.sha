	on error resume next
	for ix = 0 to nRememberedCount - 1
		sFullPath = sPoint & "." & sPartPath & ix
		err.clear
		fQual = me.QualityGood(sFullPath)
		if (err.number = 0) and fQual and me.DataChanged(sFullPath) then PortNames(ix) = me.DataValue(sFullPath)
	next
	UpdatePortList]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::paramPort0%},{%Parameter::paramPort1%},{%Parameter::paramPort2%},{%Parameter::paramPort3%},{%Parameter::paramPort4%},{%Parameter::paramPort5%},{%Parameter::paramPort6%},{%Parameter::paramPort7%},{%Parameter::paramPort8%},{%Parameter::paramPort9%},{%Parameter::paramPort10%},{%Parameter::paramPort11%},{%Parameter::paramPort12%},{%Parameter::paramPort13%},{%Parameter::paramPort14%},{%Parameter::paramPort15%},{%Parameter::paramPort16%},{%Parameter::paramPort17%},{%Parameter::paramPort18%},{%Parameter::pa