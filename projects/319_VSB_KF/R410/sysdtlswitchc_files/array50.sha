faultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=alphaValues style="FONT-WEIGHT: normal; FONT-SIZE: 8pt; LEFT: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); OVERFLOW: hidden; WIDTH: 100%; COLOR: #90ee90; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 0%; HEIGHT: 93.75%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:transparent;numberOfChars:100;numericDisplayFormat:%s;textColor:#90ee90;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA['
' sub alphaValues_ondatachange
Dim ix, sPath, fRslt, sVal, fChanged
	on error resume next
'	msgbox "In " & me.id
	fChanged = false
	for ix = 0 to nArray50Size - 1
		sPath = grpValues.parentElement.GetCustomProperty("Point", "point" & ix) & "." & grpValues.parentElement.GetCustomProperty("Parameter", "param" & ix)
		err.clear
		fRslt = me.QualityGood(sPath)
		if (err.number = 0) and fRslt then
			fRslt = me.DataChanged(sPath)
			if (err.number = 0) and fRslt then
				sVal = me.DataValue(sPath)
				if err.number = 0 then
					if sArray50Data(ix) <> sVal then
						sArray50Data(ix) = sVal
						fChanged = true
					end if
'				else
'					msgbox "In " & me.id & ": err.number=" & err.number & vbcrlf &"sPath=""" & sPath & """"
				end if
'			else
'				msgbox "In " & me.id & ": err.number=" & err.number & ", me.DataChanged(sPath) returned " & fRslt & vbcrlf &"sPath=""" & sPath & """"
			end if
'		else
'			msgbox "In " & me.id & ": err.number=" & err.number & ", me.QualityGood(sPath) returned " & fRslt & vbcrlf &"sPath=""" & sPath & """"
		end if
	next
'	msgbox "In " & me.id & ": fChanged=" & fChanged
	if fChanged then Array50Changed
' end sub alphaValues_ondatachange
']]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::point0%},{%Point::point1%},{%Point::point2%},{%Point::point3%},{%Point::point4%},{%Point::point5%},{%Point::point6%},{%Point::point7%},{%Point::point8%},{%Point::point9%},{%Point::point10%},{%Point::point11%},{%Point::point12%},{%Point::point13%},{%Point::point14%},{%Point::point15%},{%Point::point16%},{%Point::point17%},{%Point::point18%},{%Point::point19%},{%Point::point20%},{%Point::point21%},{%Point::point22%},{%Point::point23%},{%Point::point24%},{%Point::point25%},{%Point::point26%},{%Point::point27%},{%Point::point28%},{%Point::point29%},{%Point::point30%},{%Point::point31%},{%Point::point32%},{%Point::point33%},{%Point::point34%},{%Point::point35%},{%Point::point36%},{%Point::point37%},{%Point::point38%},{%Point::point39%},{%Point::point40%},{%Point::point41%},{%Point::point42%},{%Point::point43%},{%Point::point44%},{%Point::point45%},{%Point::point46%},{%Point::point47%},{%Point::point48%},{%Point::point49%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::param0%},{%Parameter::param1%},{%Parameter::param2%},{%Parameter::param3%},{%Parameter::param4%},{%Parameter::param5%},{%Parameter::param6%},{%Parameter::param7%},{%Parameter::param8%},{%Parameter::param9%},{%Parameter::param10%},{%Parameter::param11%},{%Parameter::param12%},{%Parameter::param13%},{%Parameter::param14%},{%Parameter::param15%},{%Parameter::param16%},{%Parameter::param17%},{%Parameter::param18%},{%Parameter::param19%},{%Parameter::param20%},{%Parameter::param21%},{%Parameter::param22%},{%Parameter::param23%},{%Parameter::param24%},{%Parameter::param25%},{%Parameter::param26%},{%Parameter::param27%},{%Parameter::param28%},{%Parameter::param29%},{%Parameter: