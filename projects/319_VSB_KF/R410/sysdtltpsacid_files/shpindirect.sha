<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="160px" height="40px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><parameters><parameter name="mypoint" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="mybefaftidname" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/><parameter name="myeippcodename" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/><parameter name="myprimmodname" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 Data_value_left" id=BEFAFTID style="FONT-SIZE: 8pt; LEFT: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 99.37%; COLOR: black; BORDER-TOP-STYLE: none; FONT-FAMILY: Verdana; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 0%; HEIGHT: 40%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 then
			shpanamain.objects("txtBEFAFTID").innerText = me.innerText
		else
			shpanamain.objects("txtBEFAFTID").innerText = ""
		end if
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::mybefaftidname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 Data_value_left" id=EIPPCODE style="FONT-SIZE: 8pt; LEFT: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 99.37%; COLOR: black; BORDER-TOP-STYLE: none; FONT-FAMILY: Verdana; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 30%; HEIGHT: 40%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 then
			shpanamain.objects("txtEIPPCODE").innerText = me.innerText
			shpanamain.objects("txtLabelEIPPCODE").innerText = "EIP" & "PCODE:" 'dont ask
			shpanamain.objects("GrpEIPPCODE").style.visibility = "Inherit"
		else
			shpanamain.objects("GrpEIPPCODE").style.visibility = "Hidden"
			shpanamain.objects("txtEIPPCODE").innerText = ""
			shpanamain.objects("txtLabelEIPPCODE").innerText = ""

		end if
		call UpdatePointData2Group
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myeippcodename%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 Data_value_left" id=PRIMMOD style="FONT-SIZE: 8pt; LEFT: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 99.37%; COLOR: black; BORDER-TOP-STYLE: none; FONT-FAMILY: Verdana; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 60%; HEIGHT: 40%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 then
			shpanamain.objects("txtPRIMMOD").innerText = me.innerText
			shpanamain.objects("txtLabelPRIMMOD").innerText = "PRI" & "MMOD:" 'dont ask
			shpanamain.objects("GrpPRIMMOD").style.visibility = "Inherit"
		else
			shpanamain.objects("GrpPRIMMOD").style.visibility = "Hidden"
			shpanamain.objects("txtPRIMMOD").innerText = ""
			shpanamain.objects("txtLabelPRIMMOD").innerText = ""

		end if
		call UpdateGeneralGroup
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myprimmodname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV class=hvg.group.1 id=group002 style="FONT-SIZE: 0pt; LEFT: 46px; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 160px; POSITION: absolute; TOP: 31px; HEIGHT: 40px" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:40;lineColorBlink:False;Width:160;"></DIV>]]></content></html></group></shape></shapes></shapefile>
