<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="154px" height="476px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="onshapeload" language="JScript" id=""><![CDATA[	SL_LogEvent(this, "onshapeload");

	try
	{

		// Initially assume that there is no Control Module associated with the transmitter, which means the
		// "CM" label and the control module name link should be hidden. They will be made visible later
		// when the alphCMName control is populated with live data.

		textboxLabelCM.style.visibility = "hidden";
		alphaCMName.style.visibilty = "hidden";

		textboxScanrate.style.visibility = "hidden";
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.Page_onshapeload", "Could not hide Control Module user controls.", error);
	}]]></script><script event="" language="JScript" id="F4960F16-B7DB-42B2-8EA7-F6AA93A1C898"><![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///
/// History:
///
/// EXP510.1-36     June 4, 2018        Added the rate at which the dynamic variables are scheduled to be read to the faceplate.
/// [RLEAPFI-675]   May 25, 2018        Remove handling of the Device Revision. Move the IgnoreStatus custom property up to parent shape.
/// [RLEAPFI-407]   May 14, 2018        Removed the Hover behaviour for the units as it was preventing the setting of the long symbol as tooltip.
/// [RLEAPFI-639]	April 25, 2018		Add logic to check the quality of the value and status before updating the PV, SV, TV and QV controls.
/// EXP510.1-31		April 24, 2018		Initial Experion R510 testbed release
///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]></script><script event="" language="JScript" id="4C7A6EFC-59A6-4E66-BAE0-D69A1E68F818"><![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///
/// History:
///
/// [RLEAPFI-407]   May 14, 2018        Removed the Hover behaviour for the units as it was preventing the setting of the long symbol as tooltip.
/// [RLEAPFI-639]	April 25, 2018		Add logic to check the quality of the value and status before updating the PV, SV, TV and QV controls.
/// EXP510.1-31		April 24, 2018		Initial Experion R510 testbed release
///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="" defaultvalue=""/><parameter name="IgnoreStatus" type="Value" description="0 = Use variable status to determine text color, 1 = Ignore variable status" defaultvalue="0"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectBackground class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 99.78%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#303030;fillColorBlink:False;Height:475;LineColor:#000000;lineColorBlink:False;Width:154;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxTitle class="hvg.textbox.1 SLFP_Title" style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 4.62%; FONT-FAMILY: arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior)" hdxproperties="FillColor:#404040;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:22;lineColorBlink:False;LineStyle:0;styleClass:SLFP_Title;textColor:#FFFFFF;textColorBlink:False;TotalRotation:-1;Width:154;">HART Analog Input</DIV>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaAnalogChannel title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 SLFP_Label_Bold" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.78%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 4.62%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:transparent;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SLFP_Label_Bold;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");

	try
	{
		if (alphaItemNameEnable.value == 1)
		{
			this.value = this.DataValue("SLAnalogPoint.ItemName");
		}
		else
		{
			this.value = this.DataValue("SLAnalogPoint.Name");
		}

		SL_Device.pointID = this.value;
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaAnalogChannel_ondatachange", "Could not set the Analog Channel Name indicator.", error);
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="Name,ItemName,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaDeviceID title="" class="hsc.alpha.1  HSC.ScriptDataObject.1 SLFP_Label" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.36%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 8.82%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:transparent;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SLFP_Label;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");

	try
    {
		if (SL_UpdateDeviceType(this, "SLAnalogPoint"))
	    {
			this.value = SL_Device.type.manufacturer + " " + SL_Device.type.model;
			alphaDeviceDescription.value = SL_Device.type.description;
		}
	}
	catch (error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaDeviceID_ondatachange", "Could not update device info", error);
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HDEVTYPE7,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaDeviceDescription class="hsc.alpha.1  SLFP_Label" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.36%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 13.02%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SLFP_Label;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaDescription class="hsc.alpha.1  SLFP_Label" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.36%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 17.22%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:SLFP_Label;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="Description"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN tabIndex=0 id=comboboxPtExecState title="The current state of processing the analog signal into a PV is displayed. Use the pulldown to switch to a different state." class="hsc.combo.1 SLFP_ExecutionState" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 4.83%; FONT-FAMILY: arial; WIDTH: 100%; POSITION: absolute; COLOR: #ffffff; PADDING-BOTTOM: 1px; TEXT-ALIGN: center; PADDING-TOP: 1px; PADDING-LEFT: 1px; LEFT: 0%; TOP: 21.84%; PADDING-RIGHT: 1px; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #101010; TEXT-INDENT: 2px" hdxproperties="borderStyle:Solid;borderWidth:1px;fillColor:#101010;fillColorBlink:False;HDXBINDINGID:-4;lineColor:#000000;lineColorBlink:False;styleClass:SLFP_ExecutionState;textColor:#FFFFFF;textColorBlink:False;">Combobox</SPAN>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="1"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PTEXECST"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.ComboBox" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelCM title="This transmitter is used in the indicated Control Module (CM) . Click on the link to open the Point Detail display of the Control Module. This may require a higher login level." class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 3.78%; FONT-FAMILY: arial; WIDTH: 22.72%; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; LEFT: 0%; TOP: 36.76%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:18;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#FFFFFF;textColorBlink:False;TotalRotation:-1;Width:35;">CM</DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxHeaderDigitalVariables title="The HART protocol allows up to 4 process variables to be read digitally. These variables are read at a configurable rate and will update slower than the analog Process Variable." class="hvg.textbox.1 SLFP_SectionHeader HSC.ScriptDataObject.1" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 4.62%; FONT-FAMILY: arial; WIDTH: 100%; POSITION: absolute; COLOR: #b0b0b0; TEXT-ALIGN: left; LEFT: 0%; TOP: 46.84%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="FillColor:#404040;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:22;lineColorBlink:False;LineStyle:0;styleClass:SLFP_SectionHeader;textColor:#B0B0B0;textColorBlink:False;TotalRotation:-1;Width:154;">Digital Variables</DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");

	try
	{
		var scanConfiguration = new SL_ScriptData("HSCANCFG");
		scanConfiguration.Fetch(this, "SLAnalogPoint");

		if (scanConfiguration.changed && scanConfiguration.valid)
		{
			var configuration = IOM_ScanConfigurations[scanConfiguration.value];

			SL_LogDebugLevelMessage(4, "textboxHeaderDigitalVariables_ondatachange", "value = " + scanConfiguration.value + ", Dynamic Variables = " + configuration.dynamicVariables + ", Rate = " + configuration.rate);

			if (configuration.dynamicVariables)
			{
				if (configuration.rate > 0)
				{
					this.styleClass = "SLFP_SectionHeader";
	
					textboxScanrate.value = configuration.rate.toString() + " s";
					textboxScanrate.textColor = this.textColor;
					textboxScanrate.title = "The HART Dynamic Variables listed below are configured to update every " + configuration.rate.toString() + " seconds.";
					textboxScanrate.style.visibility = "visible";
				}
				else
					textboxScanrate.style.visibility = "hidden";
			}
			else
			{
				textboxScanrate.value = "0 s";
				textboxScanrate.textColor = "red";
				textboxScanrate.title = "The I/O Module is not confgured to read the Dynamic Variables from this transmitter. The values below will not update.\n\nCheck the Scan HART Variables parameter with Control Builder.";

				textboxScanrate.style.visibility = "visible";
			}
		}
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.textboxHeaderDigitalVariables_ondatachange", "Could not set the Dynamic Variables scan rate.", error);
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HSCANCFG,HSCANTIME,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxLabelAlarms class="hvg.textbox.1 SLFP_SectionHeader" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 4.62%; FONT-FAMILY: arial; WIDTH: 100%; POSITION: absolute; COLOR: #b0b0b0; TEXT-ALIGN: left; LEFT: 0%; TOP: 88.86%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior)" hdxproperties="FillColor:#404040;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:22;lineColorBlink:False;LineStyle:0;styleClass:SLFP_SectionHeader;textColor:#B0B0B0;textColorBlink:False;TotalRotation:-1;Width:154;">Alarms</DIV>]]></content></html><binding/></element><group><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=shapeAnalogPV_textboxVariableSymbol title="Process Variable calculated from the analog signal from the transmitter." class="hvg.textbox.1 SLFP_PVSymbol_Analog" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 45%; FONT-FAMILY: arial; WIDTH: 20.27%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ffffff; TEXT-ALIGN: left; LEFT: 0%; TOP: 10%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:18;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:SLFP_PVSymbol_Analog;textColor:#FFFFFF;textColorBlink:False;TotalRotation:-1;Width:30;">Text</DIV>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shapeAnalogPV_alphaVariableValue title="" class="hsc.alpha.1 HSC.ScriptDataObject.1 SLFP_PVValue_Analog" style="BORDER-TOP-STYLE: none; FONT-SIZE: 16pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 57.5%; FONT-FAMILY: arial; WIDTH: 52.7%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 23.64%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateNaNState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%.2f;styleClass:SLFP_PVValue_Analog;textColor:#FFFFFF;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[SL_LogEvent(this, "ondatachange");
	SL_AnalogPV_SetValue(this.parentElement.parentElement);]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%},{%Point::SLAnalogPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PV,PVSTS,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shapeAnalogPV_alphaVariableName title="" class="hsc.alpha.1 SLFP_PVName_Analog" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 42.5%; FONT-FAMILY: arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 57.5%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SLFP_PVName_Analog;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	var variableType = this.parentElement.parentElement.GetCustomProperty("Value", "VariableType");

	if (variableType == 0)
	{
		var deviceCode = this.DataValue("SLAnalogPoint.HDEVTYPE7");
		var deviceType = SL_GetDeviceType(deviceCode);

		switch (deviceType)
		{
			case "Level":
			case "Multivariable":
				var deviceVariableCodeParameter = "SLAnalogPoint.HDYNDVC[1]";
				var deviceVariableCode = this.DataValue(deviceVariableCodeParameter);

				this.value = SL_GetDeviceVariableName(deviceCode, deviceVariableCode);
				break;

			case "Pressure":
			case "Temperature":
				//this.value = SL_GetDeviceVariableName(deviceCode, 0);
				break;
			
			default:
				this.value = "";
		}
	}]]></script></scripts></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shapeAnalogPV_alphaUnit title="" class="hsc.alpha.1 HSC.ScriptDataObject.1 SLFP_PVUnits_Analog" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 40%; FONT-FAMILY: arial; WIDTH: 21.62%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 77.7%; TOP: 15%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:200;numericDisplayFormat:%s;styleClass:SLFP_PVUnits_Analog;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[	SL_LogEvent(this, "ondatachange");
