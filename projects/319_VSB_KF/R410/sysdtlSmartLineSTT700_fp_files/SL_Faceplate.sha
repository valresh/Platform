<DIV tabIndex=-1 id=shapeDigitalQV class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 8.4%; FONT-FAMILY: Arial; WIDTH: 96.1%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 1.29%; TOP: 78.57%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink); VISIBILITY: hidden" hdxproperties="FillColor:#303030;fillColorBlink:False;Height:40;lineColorBlink:False;textColor:#000000;Width:148;" value = "1" src = ".\SL_Faceplate_files\SL_DynamicVariable.sha" parameters = "Point?SLAnalogPoint:{%Point::SLAnalogPoint%};Value?UseNumDecimals:0;Value?NumDecimals:0;Value?VariableType:QV;Value?IgnoreStatus:1;Parameter?UnitParameter:HDYNEU[4];Parameter?ValueParameter:HDYNVAL[4];Parameter?StatusParameter:HDYNST[4];" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content><scripts><script event="onshapeload" language="JScript"><![CDATA[	SL_LogEvent(this, "onshapeload");
	SL_DynamicVariable_Initialize(this);]]></script></scripts></html></group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=alarmstate title="Bad Quality, Urgent, Active, Acknowledged" class=hsc.alarmstate.1 style="BORDER-TOP-STYLE: solid; FONT-SIZE: 12pt; TEXT-DECORATION: none; BORDER-LEFT-STYLE: solid; HEIGHT: 3.57%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 14.28%; WHITE-SPACE: nowrap; BORDER-BOTTOM-STYLE: solid; POSITION: absolute; BORDER-LEFT-COLOR: transparent; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: solid; LEFT: 1.94%; BORDER-RIGHT-COLOR: transparent; TOP: 94.53%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent" hdxproperties="acknowledged:true;HDXBINDINGID:-4;priority:3;quality:0;rtn:false;showDisableIcon:True;showJournalOnlyIcon:True;showTooltip:True;sizeableIcon:False;staticIcon:false;" ObjectType="6"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="6"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="ALMENBSTATE"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlarmState" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaAlarmStateDesc class="hsc.alpha.1 SLFP_AlarmState" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: break-word; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 4.2%; FONT-FAMILY: arial; WIDTH: 59.74%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 17.53%; TOP: 94.53%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:transparent;lineColorBlink:False;numberOfChars:11;numericDisplayFormat:%s;styleClass:SLFP_AlarmState;textColor:#FFFFFF;textColorBlink:False;">Acronym</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="alarmvalue"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="2"/><property name="AcronymSource" varianttype="VT_UI1" value="0"/><property name="AcronymRecord" varianttype="VT_UI4" value="17"/><property name="AcronymNumber" varianttype="VT_UI2" value="2"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaCMName title="" class="hsc.alpha.1 " style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 3.78%; FONT-FAMILY: arial; WIDTH: 66.88%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; COLOR: #ffffff; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 29.22%; TOP: 36.76%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:transparent;lineColorBlink:False;numberOfChars:30;numericDisplayFormat:%s;styleClass:;textColor:#FFFFFF;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onclick" language="JScript"><![CDATA[	SL_LogEvent(this, "onclick");

	try
	{
		if ((this.value != undefined) && (this.value.length > 0))
		{
			LoadCMPointDetailDisplay(this.value);
		}
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaCMName_onclick", "Could not navigate to the CM Point Detail display.", error);
	}]]></script><script event="onchange" language="JScript"><![CDATA[	SL_LogEvent(this, "onchange");

	try
	{
		SL_LogDebugLevelMessage(3, "alphaCMName_onchange", "CM Name = " + this.value);

		if (this.value.length > 0)
		{
			textboxLabelCM.StyleClass = "SLFP_Label";
			textboxLabelCM.style.visibility = "visible";

			this.styleClass = "SLFP_Link_Right";
			this.style.visibilty = "visible";
		}
		else
		{
			SL_LogDebugLevelMessage(3, "alphaCMName_onchange", "Empty CM Name = " + this.value);
		}
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaCMName_onchange", "Could not set the visibility of the Control Module user controls.", error);
	}]]></script><script event="onupdate" language="JScript"><![CDATA[	SL_LogEvent(this, "onupdate");

	try
	{
		SL_LogDebugLevelMessage(3, "alphaCMName_onupdate", "CM Name = " + this.value);

		if (this.value.length > 0)
		{
			textboxLabelCM.StyleClass = "SLFP_Label";
			textboxLabelCM.style.visibility = "visible";

			this.styleClass = "SLFP_Link_Right";
			this.style.visibilty = "visible";
		}
		else
		{
			textboxLabelCM.style.visibility = "hidden";
			this.style.visibilty = "hidden";
		}
	}
	catch (error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaCMName_onupdate", "Could not set the visibility of the Control Module user controls.", error);
	}]]></script><script event="onmouseenter" language="JScript"><![CDATA[	SL_LogEvent(this, "onmouseenter");

	try
	{
		if ((this.value != undefined) && (this.value.length > 0))
		{
			this.style.cursor = "hand";
			this.style.textDecorationUnderline = true;
		}
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaCMName_onmouseenter", "Could not set the Hand cursor style for the Control Module link.", error);
	}]]></script><script event="onmouseleave" language="JScript"><![CDATA[	SL_LogEvent(this, "onmouseleave");

	try
	{
		this.style.cursor = "default";
		this.style.textDecorationUnderline = false;
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaCMName_onmouseleave", "Could not set the Default cursor style for the Control Module link.", error);
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SLAnalogPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="CONTAINEDIN"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=1 id=pushbuttonAckAlarms title="Click here to acknowledge all unacknowledged alarms and events for this device." class="hsc.button.1 Pushbutton_Style" style="FONT-SIZE: 8pt; TEXT-DECORATION: none; BORDER-TOP: #ffffff 2px outset; HEIGHT: 4.41%; FONT-FAMILY: Arial; BORDER-RIGHT: #ffffff 2px outset; WIDTH: 14.93%; BACKGROUND-IMAGE: url(file:./SL_Faceplate_files/alarm.png); BACKGROUND-REPEAT: no-repeat; BORDER-BOTTOM: #ffffff 2px outset; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; LEFT: 81.16%; BORDER-LEFT: #ffffff 2px outset; TOP: 94.53%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #cbccce" type=button hdxproperties="fillColor:#CBCCCE;fillColorBlink:False;HDXBINDINGID:-4;indicateBadState:False;indicateNaNState:False;indicateScanState:False;lineColor:#FFFFFF;lineColorBlink:False;styleClass:Pushbutton_Style;textColor:#000000;textColorBlink:False;" shapesrc=".\SL_Faceplate_files\alarm.png">]]></content><scripts><script event="onclick" language="JScript"><![CDATA[	SL_LogEvent(this, "onclick");

	try
	{
		AcknowledgeAlarms();
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.pushbuttonAckAlarms_onclick", "Could not acknowledge alarms.", error);
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaItemNameEnable class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 4.62%; FONT-FAMILY: Arial; WIDTH: 15.58%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 83.11%; TOP: 15.96%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: #303030; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#303030;fillColorBlink:False;HDXBINDINGID:-4;lineColor:#000000;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.0f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[	SL_LogEvent(this, "onupdate");

	try
	{
		SL_LogDebugLevelMessage(3, "SL_Faceplate.alphaItemNameEnable_onupdate", "Value = " + this.value);
		if (this.value == 1)
		{
			alphaAnalogChannel.value = alphaAnalogChannel.DataValue("SLAnalogPoint.ItemName");
		}
		else
		{
			alphaAnalogChannel.value = alphaAnalogChannel.DataValue("SLAnalogPoint.Name");
		}
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaItemNameEnable_onupdate", "Could not set the Analog Channel name.", error);
	}]]></script><script event="onchange" language="JScript"><![CDATA[	SL_LogEvent(this, "onchange");

	try
	{
		SL_LogDebugLevelMessage(3, "SL_Faceplate.alphaItemNameEnable_onchange", "Value = " + this.value);
		if (this.value == 1)
		{
			alphaAnalogChannel.value = alphaAnalogChannel.DataValue("SLAnalogPoint.ItemName");
		}
		else
		{
			alphaAnalogChannel.value = alphaAnalogChannel.DataValue("SLAnalogPoint.Name");
		}
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Faceplate.alphaItemNameEnable_onchange", "Could not set the Analog Channel name.", error);
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="5"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="FileRefFile" varianttype="VT_UI4" value="8"/><property name="FileRefRecord" varianttype="VT_UI4" value="1"/><property name="FileRefWord" varianttype="VT_UI4" value="3041"/><property name="FileRefFlags" varianttype="VT_UI4" value="16777216"/><property name="FileRefFormat" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldStart" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldWidth" varianttype="VT_UI1" value="1"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textboxScanrate class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 4.2%; FONT-FAMILY: Arial; WIDTH: 19.48%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #b0b0b0; FONT-STYLE: normal; TEXT-ALIGN: right; LEFT: 74.67%; TOP: 47.26%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: visible" hdxproperties="FillColor:#404040;fillColorBlink:False;FillStyle:0;Height:20;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#B0B0B0;textColorBlink:False;TotalRotation:-1;Width:30;">16 s</DIV>]]></content></html></element><html><content><![CDATA[
<DIV tabIndex=-1 id=groupFaceplate class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 476px; WIDTH: 154px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:476;lineColorBlink:False;Width:154;"></DIV>]]></content></html></group></shape></shapes></shapefile>