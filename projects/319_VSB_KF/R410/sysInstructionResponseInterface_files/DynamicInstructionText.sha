		if ( IsAlphaNumeric(CustomAlphaState0.value)) {
			CustomAlphaNumeric0.style.visibility = "inherit";
			CustomAlphaState0.style.visibility = "hidden";
		} else {
			CustomAlphaNumeric0.style.visibility = "hidden";
			CustomAlphaState0.style.visibility = "inherit";
		}
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CUSTOMBINDING0POINT%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::CUSTOMBINDING0PARAM%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=BackgroundRight class="hvg.base.1 iri_content" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Helvetica; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="fillColorBlink:False;Height:176;LineColor:transparent;lineColorBlink:False;styleClass:iri_content;Width:8;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ConfirmBtn title="Confirm Message" class="hvg.textbox.1 iri_btnConfirm" style="COLOR: #000000; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="styleClass:iri_btnConfirm;fillColorBlink:False;FillStyle:1;Height:25;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:124;">Confirm</DIV>]]></content><scripts><script event="onclick" language="JScript"><![CDATA[// ask the table object of parent to confirm the current selected message
    if (ConfirmBtn.readonly == true)
        return;
        
    var tdo = null;
    try 
    {
        tdo = parent.Table.Binding.DataObjects.Item(0);
    }
    catch (err) 
    {
        tdo = null;
    }
    finally
    {
        if (tdo == null)
        {
            window.external.application.logMessage("ConfirmMessage(): unable to get the table object of parent");
            return;
        }
    }
    tdo.ConfirmMessage();]]></script><script event="onmousedown" language="JScript"><![CDATA[	OnBtnStateChanged(ConfirmBtn, "iri_btnConfirm", 'down', true);]]></script><script event="onmouseout" language="JScript"><![CDATA[	OnBtnStateChanged(ConfirmBtn, "iri_btnConfirm", 'hover', false);]]></script><script event="onmouseover" language="JScript"><![CDATA[	OnBtnStateChanged(ConfirmBtn, "iri_btnConfirm", 'hover', true);]]></script><script event="onmouseup" language="JScript"><![CDATA[	OnBtnStateChanged(ConfirmBtn, "iri_btnConfirm", 'down', false);]]></script></scripts></html></element><group><element><html><content><![CDATA[<SPAN tabIndex=0 id=TargetCombo title="" class="hsc.combo.1 iri_combobox iri_writeableField" style="FONT-SIZE: 11pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 96.15%; FONT-FAMILY: Helvetica; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: white; TEXT-INDENT: 2px" hdxproperties="borderStyle:inset;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;styleclass:iri_combobox;textColor:#000000;textColorBlink:False;">Combobox</SPAN>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[// Make either the alphanumeric or the combobox visible
	if (!IsValueEnum(TargetCombo)) {
	    TargetAlpha.style.visibility = "inherit";
	    TargetCombo.style.visibility = "hidden";
	} else {
	    TargetCombo.style.visibility = "inherit";
	    TargetAlpha.style.visibility = "hidden";
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="1"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TARGETVALPOINT%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::TARGETVALPARAM%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.ComboBox" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=TargetAlpha title="" class="hsc.alpha.1 iri_fieldData iri_writeableField" style="BORDER-TOP-STYLE: none; FONT-SIZE: 11pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 96.15%; FONT-FAMILY: Helvetica; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:24;numericDisplayFormat:%.2f;styleClass:iri_fieldData;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><bi