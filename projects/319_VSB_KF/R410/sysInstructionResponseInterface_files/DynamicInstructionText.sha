<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="660px" height="176px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><scripts><script event="onshapeload" language="JScript" id=""><![CDATA[// load up the custom alpha list
	CustomStateAlphaList = [CustomAlphaState0, CustomAlphaState1, CustomAlphaState2, CustomAlphaState3, CustomAlphaState4, CustomAlphaState5, CustomAlphaState6, CustomAlphaState7];
	CustomNumericAlphaList = [CustomAlphaNumeric0, CustomAlphaNumeric1, CustomAlphaNumeric2, CustomAlphaNumeric3, CustomAlphaNumeric4, CustomAlphaNumeric5, CustomAlphaNumeric6, CustomAlphaNumeric7];

	//register the confirm button to the document so the page can access it
	document.ConfirmButton = ConfirmBtn;
	
	if (document.InstructionText && document.InstructionText.length > 0) {
		InstructionTextArea.innerHTML = document.InstructionText;
	}

	if (group001.parentElement.GetCustomProperty ("Point", "ENTRYVALPOINT") != "") {
		EntryWritable.style.visibility= "inherit";
		EntryLabel.style.visibility="inherit";
	} else {
		EntryWritable.style.visibility= "hidden";
		EntryLabel.style.visibility="hidden";
	}
	
	if (document.UpdateConfirmState) {
		document.UpdateConfirmState();
	}
	
	// resize all the writable fields
	EntryAlpha.style.height = "24px";
	EntryCombo.style.height = "24px";
	EntryUnit.style.height = "24px";
	TargetAlpha.style.height = "24px";
	TargetCombo.style.height = "24px";
	TargetUnit.style.height = "24px";
	ConfirmBtn.style.height = "30px";
	TargetAlpha.style.paddingTop = "5px";
	EntryAlpha.style.paddingTop = "5px";
	EntryCombo.style.paddingTop = "5px";
	TargetCombo.style.paddingTop = "5px";

	BigStringScrollable.style.visibility = "inherit";
	BackgroundLeft.style.visibility = "inherit";

	var customBindingExists = moveCustomBindingAlphas(true, true);
	var callbackCounter = 8;
	var timerCallback = function() {
		moveCustomBindingAlphas(false, false);
		if (--callbackCounter > 0) {
			setTimeout(timerCallback, 1000/60);
		}
	}
	if (customBindingExists) {
		setTimeout(timerCallback, 1000/60);
	}

	TargetLabel.value = group001.parentElement.GetCustomProperty("Value", "TARGETLABEL");
	EntryLabel.value = group001.parentElement.GetCustomProperty("Value", "ENTRYLABEL");]]></script><script event="" language="JScript" id="50A6259D-75C4-45F3-A301-27FFFE304344"><![CDATA[// shape level global functions

var CustomStateAlphaList = [];
var CustomNumericAlphaList = [];

function moveCustomBindingAlphas(bChangeDom, bSetFormatting) {

	var bindingTargets = document.CustomBindingTargets;
	if (!bindingTargets) {
		return false;
	}

	if (bindingTargets.length == 0) {
		return false;
	}
	
	for (var i = 0; i < Math.min(bindingTargets.length, 8); ++i) {
		var spanParent = document.getElementById(bindingTargets[i].placeholder);
		if (!spanParent) {
			continue;
		}

		var alphaPair = {numeric: CustomNumericAlphaList[i], state: CustomStateAlphaList[i]};

		if (bChangeDom) {
			spanParent.appendChild(alphaPair.numeric);
			spanParent.appendChild(alphaPair.state);
		}

		if (bSetFormatting) {
			var decimalFormatter = "%.2f";
			switch (bindingTargets[i].decimals) {
			case 0:
				decimalFormatter = "%.0f";
				break;
			case 1:
				decimalFormatter = "%.1f";
				break;
			case 2:
				decimalFormatter = "%.2f";
				break;
			case 3:
				decimalFormatter = "%.3f";
				break;
			case 4:
				decimalFormatter = "%.4f";
				break;
			}
			alphaPair.numeric.numericDisplayFormat = decimalFormatter;
		}

		alphaPair.numeric.style.width = String(spanParent.clientWidth) + "px";
		alphaPair.numeric.style.height = String(spanParent.clientHeight + 5) + "px";
		alphaPair.numeric.style.left = String(spanParent.offsetLeft + 1) + "px";
		alphaPair.numeric.style.top = String(spanParent.offsetTop ) + "px";

		alphaPair.state.style.width = String(spanParent.clientWidth) + "px";
		alphaPair.state.style.height = String(spanParent.clientHeight+ 5) + "px";
		alphaPair.state.style.left = String(spanParent.offsetLeft + 1) + "px";
		alphaPair.state.style.top = String(spanParent.offsetTop ) + "px";
	}
	return true;
}

function OnBtnStateChanged(elem, baseClassName, state, bStart) {
    if (elem == null)
        return;
    var stateClassName = baseClassName + "_" + state;
    if (bStart)
        ClassNameReplace(elem, "", stateClassName);
    else
        ClassNameReplace(elem, stateClassName, "");
}

function ClassNameReplace(elem, oldClass, newClass) {
    if (elem == null)
        return;
    
    var newClassName = elem.className;
    if (oldClass.length > 0) {
        var classArray = newClassName.split(" ");
        for (var i = classArray.length - 1; i >= 0; --i) {
            if (classArray[i] == oldClass)
                classArray.splice(i, 1);
            
            // If existing class list already has the new class, don't add it again.    
            if (classArray[i] == newClass)
                newClass = "";
        }
        newClassName = classArray.join(" ");
    }
    
    if (newClass.length > 0) {
        newClassName += (" " + newClass);
    }
    
    elem.className = newClassName;
}

function IsValueEnum(cboElem) {
	var enumType = 8;
	try {
		return (cboElem.Binding.DataObjects.Item(0).ValueType == enumType);
	} catch (err) {
		return false;
	}
}

function IsAlphaNumeric(value) {
	var strValue = String(value).toLowerCase();
	if ((strValue.charAt(0) == " ") &&(parseInt(strValue) != NaN)) {
		// first char is space and first non-space char is a digit
		return true;
	} else if ((strValue == "nan") || (strValue == "+inf") || (strValue == "-inf")) {
		return true;
	}
	return false;
}

// register the alpha moving function on the document
document.moveCustomBindingAlphas = moveCustomBindingAlphas;]]></script></scripts><parameters><parameter name="MESSAGEPOINT" type="Point" description="" defaultvalue=""/><parameter name="TARGETCHANGEPARAM" type="Parameter" description="" defaultvalue=""/><parameter name="ENTRYVALPOINT" type="Point" description="" defaultvalue=""/><parameter name="ENTRYVALPARAM" type="Parameter" description="" defaultvalue=""/><parameter name="TARGETVALPOINT" type="Point" description="" defaultvalue=""/><parameter name="TARGETVALPARAM" type="Parameter" description="" defaultvalue=""/><parameter name="ENTRYEUDESCPOINT" type="Point" description="" defaultvalue=""/><parameter name="ENTRYEUDESCPARAM" type="Parameter" description="" defaultvalue=""/><parameter name="TARGETEUDESCPOINT" type="Point" description="" defaultvalue=""/><parameter name="TARGETEUDESCPARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOMBINDING1POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOMBINDING1PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOMBINDING2POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOMBINDING2PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOMBINDING3POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOMBINDING3PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOMBINDING4POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOMBINDING4PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOMBINDING0POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOMBINDING0PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="TARGETLABEL" type="Value" description="" defaultvalue="Target"/><parameter name="ENTRYLABEL" type="Value" description="" defaultvalue="Entry"/><parameter name="ACTENTITY" type="Value" description="" defaultvalue=""/><parameter name