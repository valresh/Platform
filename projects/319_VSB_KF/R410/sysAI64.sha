<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="1012px" height="716px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src=".\Styles\SystemDisplay_1276X849.css"/></stylesheets><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[Dim strIOPTYPE

	strIOPTYPE = me.GetCustomProperty("Parameter", "IOPTYPE")



	if  (ucase(strIOPTYPE)= "AI_LLMUX") then

		' show all 64 channel details



		grp64.style.visibility = "visible"

	end if]]></script></scripts><parameters><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="IOPTYPE" type="Parameter" description="IOP type to determine how many channels need to be shown." defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[

