or:Transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:Transparent;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="9999.99">State</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("Tagname.HRBALG_REGA.PATHBRKSTS") then
	if me.DataValue("Tagname.HRBALG_REGA.PATHBRKSTS") = 1 then
		me.style.visibility = "Hidden"
	else
		me.style.visibility = "Inherit"
	end if
else
	me.style.visibility = "Hidden"
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="HRBALG_REGA.PATHBRKSTS"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_REGA.PATHBRKSTS,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 20%; FONT-FAMILY: Arial; HEIGHT: 4.78%; VISIBILITY: hidden; COLOR: #808080; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 68.61%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior) url(#HSCScriptDataBehavior); LEFT: 2.66%" id=RGTxtCusParam class="hvg.textbox.1  HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:18;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:;textColor:Gray;textColorBlink:False;TotalRotation:-1;value:;Width:30;" HDX_LOCK="-1" globalscripts></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("TagName.RGParameter") and not me.QualityBad("TagName.HRBALG_REGA.SLOTNUM") then
sNum = me.DataValue("TagName.HRBALG_REGA.SLOTNUM")
	sParam = cstr(window.external.StationDataRepository.GetValue(cstr("S"&sNum&"RGParam")))
	if instr(sParam , ".")> 0 then
		DotLoc = instr(sParam , ".")
	 	RGTxtCusParam.value = Ucase(Mid(sParam, DotLoc+1))
		RGTxtCusParam.title = Ucase(Mid(sParam, DotLoc+1))
	else
	 	RGTxtCusParam.value = Ucase(sParam)
		RGTxtCusParam.title = Ucase(sParam)
	end if
	RGTxtCusParam.style.visibility = "Inherit"
	RGConAlpCusParam.style.visibility = "Inherit"
else
	RGTxtCusParam.style.visibility = "Hidden"
	RGConAlpCusParam.style.visibility = "Hidden"
	RGConTxtCusParam.style.visibility = "Hidden"
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::RGParameter%},HRBALG_REGA.SLOTNUM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 20%; FONT-FAMILY: Arial; HEIGHT: 4.78%; VISIBILITY: inherit; COLOR: #808080; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 75%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior); LEFT: 2.66%" id=RGTxtSP class="hvg.textbox.1 " tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:18;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:;textColor:Gray;textColorBlink:False;TotalRotation:-1;value:;Width:30;" HDX_LOCK="-1" globalscripts>SP</DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
