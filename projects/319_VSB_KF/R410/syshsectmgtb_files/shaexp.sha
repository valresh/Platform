if not me.QualityBad("TagName.HRBALG_REGA.SLOTNUM") then
	me.parentNode.parentNode.value = 2
elseif not me.QualityBad("TagName.HRBALG_AIA.SLOTNUM") then
	me.parentNode.parentNode.value = 3
elseif not me.QualityBad("TagName.HRBALG_DIA.SLOTNUM") then
	me.parentNode.parentNode.value = 4
else
	me.parentNode.parentNode.value = 1
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_REGA.SLOTNUM,HRBALG_AIA.SLOTNUM,HRBALG_DIA.SLOTNUM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
