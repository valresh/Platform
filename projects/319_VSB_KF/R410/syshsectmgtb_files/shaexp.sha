if me.value <> "" and me.value <> vbnullstring then
	sNum = DIsd.DataValue("TagName.HRBALG_DIA.SLOTNUM")
	window.external.StationDataRepository.PutValue cstr("S"&sNum&"DIParam") , me.value
	window.external.StationDataRepository.autoReloadContent = true
	me.style.visibility = "Hidden"
	for i = 1 to 8
		if (cstr(document.getElementById("AlpSlot"&i).value) = cstr(sNum)) then
			window.external.StationDataRepository.PutValue cstr("S"&i&"DIParam") , me.value
		end if
	Next
end if]]></script></scripts></html><binding/></element><element><html><content><![CDATA[<SPAN style="BORDER-BOTTOM: transparent 2px; POSITION: absolute; TEXT-ALIGN: right; BORDER-LEFT: transparent 2px; PADDING-BOTTOM: 2px; BACKGROUND-COLOR: #ffffff; FONT-STYLE: normal; TEXT-INDENT: 2px; PADDING-LEFT: 2px; WIDTH: 73.33%; PADDING-RIGHT: 2px; FONT-FAMILY: Arial; HEIGHT: 5.85%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; BORDER-TOP: transparent 2px; TOP: 80.58%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 2px; PADDING-TOP: 2px; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 24%" id=DIConCboPV class="hsc.combo.1 " title="" tabIndex=-1 hdxproperties="borderStyle:Inset;borderWidth:2;fillColor:#FFFFFF;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:True;lineColor:Gray;lineColorBlink:False;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" printValue="Combobox">Combobox</SPAN>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="1"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="DEVCTLA.PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef