	if instr(sParam , ".")> 0 then
		DotLoc = instr(sParam , ".")
	 	DITxtCusParam.value = Ucase(Mid(sParam, DotLoc+1))
		DITxtCusParam.title = Ucase(Mid(sParam, DotLoc+1))
	else
	 	DITxtCusParam.value = Ucase(sParam)
		DITxtCusParam.title = Ucase(sParam)
	end if
	DITxtCusParam.style.visibility = "Inherit"
	DIConAlpCusParam.style.visibility = "Inherit"
else
	DITxtCusParam.style.visibility = "Hidden"
	DIConAlpCusParam.style.visibility = "Hidden"
	DIConTxtCusParam.style.visibility = "Hidden"
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::DIParameter%},HRBALG_DIA.SLOTNUM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 20%; FONT-FAMILY: Arial; HEIGHT: 4.78%; VISIBILITY: inherit; COLOR: #808080; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 81.38%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior); LEFT: 2.66%" id=DITxtPV class="hvg.textbox.1 " tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:18;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:;textColor:Gray;textColorBlink:False;TotalRotation:-1;value:;Width:30;" HDX_LOCK="-1" globalscripts>PV</DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; FONT-STYLE: normal; WIDTH: 40%; FONT-FAMILY: Arial; HEIGHT: 3.98%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 8pt; OVERFLOW: hidden; TOP: 13.29%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); LEFT: 3.33%" id=DIsd class="hvg.textbox.1 HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:15;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#ff0000;textColorBlink:False;TotalRotation:-1;Width:60;" HDX_LOCK="-1">Script Data</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("Tagname.DEVCTLA.NUMSTATES") and not me.QualityBad("Tagname.HRBALG_DIA.SLOTNUM") then
	sNumOfState = me.DataValue("Tagname.DEVCTLA.NUMSTATES")
	if sNumOfState < 3 then
		DIConAlpStateText6.style.visibility = "Hidden"
		DIshpStateText6.style.visibility = "Hidden"
	else
		DIConAlpStateText6.style.visibility = "Inherit"
		DIshpStateText6.style.visibility = "Inherit"
	end if
end if
if not me.QualityBad("Tagname.DEVCTLA.GPV") and not me.QualityBad("Tagname.HRBALG_DIA.SLOTNUM") then
	sPvState = me.DataValue("Tagname.DEVCTLA.GPV")
	if sPvState = 4 then
		DIshpStateText4.value = 3
		DIshpStateText5.value = 2
		DIshpStateText6.value = 2
	elseif sPvState = 5 then
		DIshpStateText4.value = 2
		DIshpStateText5.value = 3
		DIshpStateText6.value = 2
	elseif sPvState = 6 then
		DIshpStateText4.value = 2
		DIshpStateText5.value = 2
		DIshpStateText6.value = 3
	else
		DIshpStateText4.value = 2
		DIshpStateText5.value = 2
		DIshpStateText6.value = 2
	end if
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="DEVCTLA.NUMSTATES,DEVCTLA.GPV,HRBALG_DIA.SLOTNUM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 1px; POSITION: absolute; TEXT-ALIGN: left; BORDER-LEFT: transparent 1px; PADDING-BOTTOM: 1px; BACKGROUND-COLOR: transparent; PADDING-LEFT: 1px; WIDTH: 67.33%; PADDING-RIGHT: 1px; FONT-FAMILY: Arial; WORD-WRAP: normal; HEIGHT: 5.31%; COLOR: black; FONT-SIZE: 12pt; OVERFLOW: hidden; BORDER-TOP: transparent 1px; TOP: 22.6%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 1px; PADDING-TOP: 1px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 4.66%; ROWS: 1" id=DIConAlpStateText5 class="hsc.alpha.1 " tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:1px;durationFormat:-1;fillColor:Transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:#808080;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;styleClass:;textColor:Black;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="State">State</TEXTAREA>]]></c