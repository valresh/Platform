; POSITION: absolute; TEXT-ALIGN: left; BORDER-LEFT: transparent 0px; PADDING-BOTTOM: 1px; BACKGROUND-COLOR: transparent; PADDING-LEFT: 1px; WIDTH: 97.33%; PADDING-RIGHT: 1px; FONT-FAMILY: Arial; WORD-WRAP: break-word; HEIGHT: 12.76%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; BORDER-TOP: transparent 0px; TOP: 6.64%; BORDER-RIGHT: transparent 0px; PADDING-TOP: 1px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 1.33%; ROWS: 1" id=RVConalpDescription class="hsc.alpha.1 " title="" tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:1px;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="Text">Text</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="DESC"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 2px; POSITION: absolute; TEXT-ALIGN: center; BORDER-LEFT: transparent 2px; PADDING-BOTTOM: 2px; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; PADDING-LEFT: 2px; WIDTH: 94.66%; PADDING-RIGHT: 2px; FONT-FAMILY: Arial; WORD-WRAP: normal; HEIGHT: 5.85%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; BORDER-TOP: transparent 2px; TOP: 60.37%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 2px; PADDING-TOP: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); LEFT: 2.66%; ROWS: 1" id=RVConAlpPBStatus class="hsc.alpha.1  HSC.ScriptDataObject.1" title="" tabIndex=-1 hdxproperties="borderStyle:None;borderWidth:2px;durationFormat:-1;fillColor:Transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:Transparent;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="9999.99">State</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("Tagname.HRBALG_AIA.PATHBRKSTS") then
	if me.DataValue("Tagname.Tagname.HRBALG_AIA.PATHBRKSTS") = 1 then
		me.style.visibility = "Hidden"
	else
		me.style.visibility = "Inherit"
	end if
else
	me.style.visibility = "Hidden"
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="HRBALG_AIA.PATHBRKSTS"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_AIA.PATHBRKSTS,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 20%; FONT-FAMILY: Arial; HEIGHT: 4.78%; VISIBILITY: hidden; COLOR: #808080; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 75%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior) url(#HSCScriptDataBehavior); LEFT: 2.66%" id=RVTxtCusParam class="hvg.textbox.1  HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:18;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:;textColor:Gray;textColorBlink:False;TotalRotation:-1;value:;Width:30;" HDX_LOCK="-1" globalscripts></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("TagName.RVParameter") and not me.QualityBad("TagName.HRBALG_AIA.SLOTNUM") then
	sNum = me.DataValue("TagName.HRBALG_AIA.SLOTNUM")
	sParam = cstr(window.external.StationDataRepository.GetValue(cstr("S"&sNum&"RVParam")))
	if instr(sParam , ".")> 0 then
		DotLoc = instr(sParam , ".")
	 	RVTxtCusParam.value = Ucase(Mid(sParam, DotLoc+1))
		RVTxtCusParam.title = Ucase(Mid(sParam, DotLoc+1))
	else
	 	RVTxtCusParam.value = Ucase(sParam)
		RVTxtCusParam.title = Ucase(sParam)
	end if
	RVTxtCusParam.style.visibility = "Inherit"
	RVConAlpCusParam.style.visibility = "Inherit"
else
	RVTxtCusParam.style.visibility = "Hidden"
	RVConAlpCusParam.style.visibility = "Hidden"
	RVConTxtCusParam.style.visibility = "Hidden"
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::RVParameter%},HRBALG_AIA.SLOTNUM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 20%; FONT-FAMILY: Arial; HEIGHT: 4.78%; VISIBILITY: inherit; COLOR: #808080; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 81.38%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior); LEFT: 2.66%" id=RVTxtPV class="hvg.textbox.1 " tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:18;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:;textColor:Gray;textColorBlink:False;TotalRotation:-1;value:;Width:30;" HDX_LOCK="-1" globalscripts>PV</DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; FONT-STYLE: normal; WIDTH: 40%; FONT-FAMILY: Arial; HEIGHT: 3.98%; VISIBILITY: hidden; COLOR: #ff0000; FONT-SIZE: 8pt; OVERFLOW: hidden; TOP: 13.29%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); LEFT: 3.33%" id=RVsd class="hvg.textbox.1 HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:15;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#ff0000;textColorBlink:False;TotalRotation:-1;Width:60;" HDX_LOCK="-1">Script Data</DIV>]]></content></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_AIA.SLOTNUM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 0.66%; FONT-FAMILY: Arial; HEIGHT: 5.85%; FONT-SIZE: 12pt; OVERFLOW: hidden; TOP: 80.58%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#line); LEFT: 22%" id=RVlinepv class=hvg.base.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:22;LineColor:#00bfbf;lineColorBlink:False;LineWidth:4;points:0.000000 0.000000 0.000000 100.000000 ;Width:1;" HDX_LOCK="-1"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 2px; POSITION: absolute; TEXT-ALIGN: right; BORDER-LEFT: transparent 2px; PADDING-BOTTOM: 2px; BACKGROUND-COLOR: #ffffff; FONT-STYLE: normal; PADDING-LEFT: 2px; WIDTH: 73.33%; PADDING-RIGHT: 2px; FONT-FAMILY: Arial; WORD-WRAP: normal; HEIGHT: 5.85%; VISIBILITY: hidden; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; BORDER-TOP: transparent 2px; TOP: 74.2%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 2px; PADDING-TOP: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 24%; ROWS: 1" id=RVConAlpCusParam class="hsc.alpha.1 " title="" tabIndex=-1 hdxproperties="borderStyle:inset;borderWidth:2px;durationFormat:-1;fillColor:#FFFFFF;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:-1;lineColor:#FFFFFF;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%.2f;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="9999.99" SHORTCUTMENUCUSTOM="0">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::RVParameter%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 2px; POSITION: absolute; TEXT-ALIGN: right; BORDER-LEFT: transparent 2px; PADDING-BOTTOM: 2px; BACKGROUND-COLOR: #ffffff; FONT-STYLE: normal; PADDING-LEFT: 2px; WIDTH: 73.33%; PADDING-RIGHT: 2px; FONT-FAMILY: Arial; WORD-WRAP: normal; HEIGHT: 5.85%; VISIBILITY: hidden; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; BORDER-TOP: transparent 2px; TOP: 74.2%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 2px; PADDING-TOP: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 24%; ROWS: 1" id=RVConTxtCusParam class="hsc.alpha.1 " title="" tabIndex=-1 hdxproperties="borderStyle:inset;borderWidth:2px;durationFormat:-1;fillColor:#FFFFFF;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:-1;lineColor:#FFFFFF;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%.2f;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="9999.99" SHORTCUTMENUCUSTOM="0">9999.99</TEXTAREA>]]></content><scripts><script event="onchange" language="VBScript"><![CDATA[On Error Resume Next
if me.value <> "" and me.value <> vbnullstring then
	sNum = RVsd.DataValue("TagName.HRBALG_AIA.SLOTNUM")
	window.external.StationDataRepository.PutValue cstr("S"&sNum&"RVParam") , me.value
	window.external.StationDataRepository.autoReloadContent = true
	me.style.visibility = "Hidden"
	for i = 1 to 8
		if (cstr(document.getElementById("AlpSlot"&i).value) = cstr(sNum)) then
			window.external.StationDataRepository.PutValue cstr("S"&i&"RVParam") , me.value
		end if
	Next
end if]]></script></scripts></html><binding/></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 2px; POSITION: absolute; TEXT-ALIGN: right; BORDER-LEFT: transparent 2px; PADDING-BOTTOM: 2px; BACKGROUND-COLOR: #ffffff; FONT-STYLE: normal; PADDING-LEFT: 2px; WIDTH: 73.33%; PADDING-RIGHT: 2px; FONT-FAMILY: Arial; WORD-WRAP: normal; HEIGHT: 5.85%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; BORDER-TOP: transparent 2px; TOP: 80.58%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 2px; PADDING-TOP: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 24%; ROWS: 1" id=RVConAlpPV class="hsc.alpha.1 " title="" tabIndex=-1 hdxproperties="borderStyle:Inset;borderWidth:2px;durationFormat:-1;fillColor:#FFFFFF;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:#FFFFFF;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%.2f;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="9999.99">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="DACA.PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN style="BORDER-BOTTOM: transparent 1px; POSITION: absolute; BORDER-LEFT: transparent 1px; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 12.66%; FONT-FAMILY: Arial; HEIGHT: 25.79%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 0pt; OVERFLOW: hidden; BORDER-TOP: transparent 1px; TOP: 23.67%; FONT-WEIGHT: 400; BORDER-RIGHT: transparent 1px; TEXT-DECORATION: none; BEHAVIOR: url(#HSCIndicatorBehavior) url(#BindingBehavior) url(#HSCScriptDataBehavior); LEFT: 72%" id=RVConIndPV class="hsc.indicator.1 HSC.ScriptDataObject.1" title="" tabIndex=-1 hdxproperties="borderStyle:inset;borderWidth:1px;fillColor:#ffffff;fillColorBlink:0;fillDirection:0;fillStyle:0;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;levelFillColor:#00bfbf;levelFillColorBlink:0;lineColor:black;lineColorBlink:0;" HDX_LOCK="-1" globalscripts SHORTCUTMENUCUSTOM="0" printValuePercent="33" printFillColor="#ffffff" printLevelFillColor="#00bfbf" printInverse="false"></SPAN>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("Tagname.DACA.PV") then
	 me.value =  me.DataValue("Tagname.DACA.PV")
end if
if not me.QualityBad("Tagname.DACA.PVEUHI")and not me.QualityBad("Tagname.DACA.PVEULO")then
	 me.rangeHi = me.DataValue("Tagname.DACA.PVEUHI")
	 me.rangeLo = me.DataValue("Tagname.DACA.PVEULO")
else
	me.rangeHi = 100
	me.rangeLo = 0
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="DACA.PV,DACA.PVEUHI,DACA.PVEULO,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><group><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; BORDER-TOP-COLOR: transparent; WIDTH: 78.12%; FONT-FAMILY: Arial; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 17.24%; COLOR: #000000; BORDER-RIGHT-COLOR: transparent; FONT-SIZE: 10pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; BORDER-LEFT-COLOR: transparent; TOP: 0%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); LEFT: 8.33%; ROWS: 1" id=RVConAlpPVEUHi class="hsc.alpha.1  HSC.ScriptDataObject.1 " tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numberOfChars:12;numericDisplayFormat:%.2f;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="9999.99">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("Tagname.DACA.PVEUHI") and not me.QualityBad("Tagname.DACA.PVEULO")then
	pvhi = me.DataValue("Tagname.DACA.PVEUHI")
	pvlo = me.DataValue("Tagname.DACA.PVEULO")
	RVConAlpPVEU1.value = pvlo + (pvhi - pvlo) * 1/4
	RVConAlpPVEU2.value = pvlo + (pvhi - pvlo) * 2/4
	RVConAlpPVEU3.value = pvlo + (pvhi - pvlo) * 3/4
