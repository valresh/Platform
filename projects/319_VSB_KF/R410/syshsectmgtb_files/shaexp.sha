<?xml version="1.0"?><shapefile version="1" type="sequence" title="" description="" useFirstShapeForBadValue="-1" width="150px" height="375px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="VBScript" id="198916C1-0B85-408D-B3C8-D156DEFA4C84"><![CDATA['Different regulatory algorithm type 
 sDAS  =  "DAS"
 sPIDNORM  =  "PIDNORM"
 sPIDRATIO  =  "PIDRATIO"
 sAUTRATIO  =  "AUTRATIO"
 sAUTOBIAS  =  "AUTOBIAS"
 sPIDCMA  =  "PIDCMA"
 sPIDCM  =  "PIDCM"
 sPIDSPC  =  "PIDSPC"
 sPIDERSQG  =  "PIDERSQG"
 sPIDERSQI  =  "PIDERSQI"
 sPIDGAP  =  "PIDGAP"
 sPIDEXFB  =  "PIDEXFB"
 sEXTRATBI  =  "EXTRATBI"
 sMASSFLOW  =  "MASSFLOW"
 sLEADLAG  =  "LEADLAG"
 sOVERHISL  =  "OVERHISL"
 sOVERLOSL  =  "OVERLOSL"
 sSUMRWMAN  =  "SUMRWMAN"
 sMULTWMAN  =  "MULTWMAN"
 sAUTOMAN  =  "AUTOMAN"
 sSWITCH  =  "SWITCH"
 sCBSUMR  =  "CBSUMR"
 sMULT  =  "MULT"
 sDIVIDR  =  "DIVIDR"
 sSQRT  =  "SQRT"
 sSQRTPROD  =  "SQRTPROD"
 sSUMSQRT  =  "SUMSQRT"
 sHISEL  =  "HISEL"
 sLOSEL  =  "LOSEL"
 sPIDDDC  =  "PIDDDC"
 sPIDDDCSP  =  "PIDDDCSP"
 sPIDNONLN  =  "PIDNONLN"
 sLEADLAGS  =  "LEADLAGS"
 sSELOVDDC  =  "SELOVDDC"
 sECSQRTPROD  =  "ECSQRTPROD"
 sECSUMR  =  "ECSUMR"
 sMULTDIV  =  "MULTDIV"
 sLEADLAGM  =  "LEADLAGM"
 sMIDOF3  =  "MIDOF3"
 sINCRMTL  =  "INCRMTL"
 sRAMPSOAK  =  "RAMPSOAK"
 sLOGIC  =  "LOGIC"
 sDEADTM  =  "DEADTM"
 sCHARACT  =  "CHARACT"


Sub AlgoRithm_Type_Onupdate(oSource)
On Error Resume Next
set oshape = oSource.ParentNode.ParentNode
if not oshape is nothing then
	salgoType = ucase(oSource.DataValue("TagName.HRBALG_REGA.ALGOTYPE"))
	select case salgoType
		case sLOGIC, sOVERHISL , sOVERLOSL, sSELOVDDC
			oshape.objects("RGgrpEUTick").style.visibility = "Hidden" 'PV not applicable to this type algorithm
			oshape.objects("RGlinepv").style.visibility = "Hidden"
			oshape.objects("RGlinesp").style.visibility = "Hidden" 
			oshape.objects("RGConAlpPV").style.visibility = "Hidden"
			oshape.objects("RGTxtPV").style.visibility = "Hidden" 
			oshape.objects("RGConIndSP").style.visibility = "Hidden"
			oshape.objects("RGConIndPV").style.visibility = "Hidden" 
			oshape.objects("RGConIndSP").style.visibility = "Hidden" 'SP not applicable to this type algorithm
			oshape.objects("RGlinesp").style.visibility = "Hidden"
			oshape.objects("RGConAlpSP").style.visibility = "Hidden"
			oshape.objects("RGTxtSP").style.visibility = "Hidden"
		case sCHARACT, sLOGIC, sAUTOMAN, sDEADTM , sLEADLAG, sINCRMTL
			oshape.objects("RGConIndSP").style.visibility = "Hidden" 'SP not applicable to this type algorithm
			oshape.objects("RGlinesp").style.visibility = "Hidden"
			oshape.objects("RGConAlpSP").style.visibility = "Hidden"
			oshape.objects("RGTxtSP").style.visibility = "Hidden"
		case sLOGIC 
			oshape.objects("RGTxtOP").style.visibility = "Hidden" 'OP not applicable to this type algorithm
			oshape.objects("RGConAlpOP").style.visibility = "Hidden"
			oshape.objects("RGlineop").style.visibility = "Hidden"
			oshape.objects("RGConIndOP").style.visibility = "Hidden"
			oshape.objects("RGgrpEUTick").style.visibility = "Hidden" 'PV not applicable to this type algorithm
			oshape.objects("RGlinepv").style.visibility = "Hidden"
			oshape.objects("RGlinesp").style.visibility = "Hidden" 
			oshape.objects("RGConAlpPV").style.visibility = "Hidden"
			oshape.objects("RGTxtPV").style.visibility = "Hidden" 
			oshape.objects("RGConIndSP").style.visibility = "Hidden"
			oshape.objects("RGConIndPV").style.visibility = "Hidden"
			oshape.objects("RGConIndSP").style.visibility = "Hidden" 'SP not applicable to this type algorithm
			oshape.objects("RGlinesp").style.visibility = "Hidden"
			oshape.objects("RGConAlpSP").style.visibility = "Hidden"
			oshape.objects("RGTxtSP").style.visibility = "Hidden"
		case else   ' By default all PV, SP, OP and Mode are applicable
	end select
end if

End Sub]]></script></scripts><parameters><parameter name="TagName" type="Point" description="Point Name" defaultvalue="."/><parameter name="RGParameter" type="Parameter" description="User Added Reg Parameter" defaultvalue="."/><parameter name="RVParameter" type="Parameter" description="User Added RV Parameter" defaultvalue="."/><parameter name="DIParameter" type="Parameter" description="User Added DI Parameter" defaultvalue="."/></parameters><shapes><shape><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 150px; FONT-FAMILY: Arial; HEIGHT: 375px; VISIBILITY: inherit; FONT-SIZE: 12pt; OVERFLOW: hidden; TOP: 14px; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect)  url(#BindingBehavior) url(#HSCScriptDataBehavior); LEFT: 0px" id=BadValue class="hvg.base.1 HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="FillColor:#cbccce;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:375;LineColor:#c0c0c0;lineColorBlink:False;LineStyle:1;Width:150;" HDX_LOCK="-1"></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("TagName.HRBALG_REGA.SLOTNUM") then
	me.parentNode.value = 2
elseif not me.QualityBad("TagName.HRBALG_AIA.SLOTNUM") then
	me.parentNode.value = 3
elseif not me.QualityBad("TagName.HRBALG_DIA.SLOTNUM") then
	me.parentNode.value = 4
else
	me.parentNode.value = 1
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="HRBALG_REGA.SLOTNUM,HRBALG_AIA.SLOTNUM,HRBALG_DIA.SLOTNUM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element></shape><shape><group><element><html><content><![CDATA[
