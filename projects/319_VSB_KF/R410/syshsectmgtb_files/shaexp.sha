if me.value <> "" and me.value <> vbnullstring then
	sNum = RGsd.DataValue("TagName.HRBALG_REGA.SLOTNUM")
	window.external.StationDataRepository.PutValue cstr("S"&sNum&"RGParam") , me.value
	window.external.StationDataRepository.autoReloadContent = true
	me.style.visibility = "Hidden"
	for i = 1 to 8
		if (cstr(document.getElementById("AlpSlot"&i).value) = cstr(sNum)) then
			window.external.StationDataRepository.PutValue cstr("S"&i&"RGParam") , me.value
		end if
	Next
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=""/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 2px; POSITION: absolute; TEXT-ALIGN: right; BORDER-LEFT: transparent 2px; PADDING-BOTTOM: 2px; BACKGROUND-COLOR: #ffffff; FONT-STYLE: normal; PADDING-LEFT: 2px; WIDTH: 73.33%; PADDING-RIGHT: 2px; FONT-FAMILY: Arial; WORD-WRAP: normal; HEIGHT: 5.85%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; BORDER-TOP: transparent 2px; TOP: 74.2%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 2px; PADDING-TOP: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 24%; ROWS: 1" id=RGConAlpSP class="hsc.alpha.1 " title="" tabIndex=-1 hdxproperties="borderStyle:inset;borderWidth:2px;durationFormat:-1;fillColor:#FFFFFF;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:-1;lineColor:#FFFFFF;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%.2f;styleClass:;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1" globalscripts printDisplayValue="9999.99" SHORTCUTMENUCUSTOM="0">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDat