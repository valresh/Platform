			if bInitialVisibilitySet = False then
				grp_32.style.visibility = "Inherit"
				bInitialVisibilitySet = True
			end if
		else	'not MC box, no NTIMER value
			if me.QualityGood("boxpoint.NTIMER") then
				if bInitialVisibilitySet = False then
					grp_32.style.visibility = "Inherit"
