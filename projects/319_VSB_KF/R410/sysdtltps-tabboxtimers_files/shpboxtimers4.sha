	'test for valid timer index
	if nTimerIndex < 1 or nTimerIndex > 64 then 
		window.parent.external.LogMessage "invalid nTimerIndex in sysdtltps-tabboxtimers shpboxtimers ResetTimerCommand"
		exit sub
	end if
	'use the appropriate parameter, based on box type, and global index value
	if bIsMCBox then
		sTemp = "boxpoint.TMRS(" & nTimerIndex & ")"   'MC uses e.g. TMRS(1) whereas others use TMCMD(1)
'		sd.SetDataValueSynchronous sTemp, "RESET"
	else
		sTemp = "boxpoint.TMCMD(" & nTimerIndex & ")"
'		sd.SetDataValueSynchronous sTemp, "RESET"
	end if

	sd.DataValue(sTemp) = "RESET"

	'reset timer to auto-hide
	window.clearInterval(intTimerID2)
  	intTimerID2 = window.setInterval ("HideGrpTimerCommands", g_nHideGrpTimerCommandsTimeout)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT style="POSITION: absolute; BORDER-BOTTOM-COLOR: #ffffff; BACKGROUND-COLOR: #d4d0c8; FONT-STYLE: normal; BORDER-TOP-COLOR: #ffffff; WIDTH: 16.02%; BACKGROUND-REPEAT: no-repeat; FONT-FAMILY: Arial; HEIGHT: 96.15%; COLOR: #000000; BORDER-RIGHT-COLOR: #ffffff; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: #ffffff; TOP: 0%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); LEFT: 46.79%" id=pbStop class=hsc.button.1 tabIndex=0 value="Stop Timer" type=button hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[	dim sTemp

 	'test for valid timer index
	if nTimerIndex < 1 or nTimerIndex > 64 then 
		window.parent.external.LogMessage "invalid nTimerIndex in sysdtltps-tabboxtimers shpboxtimers StartTimerCommand"
		exit sub
	end if

	'use the appropriate parameter, based on box type, and global index value
	if bIsMCBox then
		sTemp = "boxpoint.BOXSTRT(" & nTimerIndex & ")"
	else
		sTemp = "boxpoint.TMCMD(" & nTimerIndex & ")"
	end if


	'write the value NOW (and wait for action)
	sd.SetDataValueSynchronous sTemp, "STOP"

	'reset timer to auto-hide
	window.clearInterval(intTimerID2)
  	intTimerID2 = window.setInterval ("HideGrpTimerCommands", g_nHideGrpTimerCommandsTimeout)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT style="POSITION: absolute; BORDER-BOTTOM-COLOR: #ffffff; BACKGROUND-COLOR: #d4d0c8; FONT-STYLE: normal; BORDER-TOP-COLOR: #ffffff; WIDTH: 16.02%; BACKGROUND-REPEAT: no-repeat; FONT-FAMILY: Arial; HEIGHT: 96.15%; COLOR: #000000; BORDER-RIGHT-COLOR: #ffffff; FONT-SIZE: 12pt; BORDER-LEFT-COLOR: #ffffff; TOP: 0%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); LEFT: 28.33%" id=pbStart class=hsc.button.1 tabIndex=0 value="Start Timer" type=button hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[	dim sTemp

 	'test for valid timer index
	if nTimerIndex < 1 or nTimerIndex > 64 then 
		window.parent.external.LogMessage "invalid nTimerIndex in sysdtltps-tabboxtimers shpboxtimers StartTimerCommand"
		exit sub
	end if

	'use the appropriate parameter, based on box type, and global index value
	if bIsMCBox then
		sTemp = "boxpoint.BOXSTRT(" & nTimerIndex & ")"
	else
		sTemp = "boxpoint.TMCMD(" & nTimerIndex & ")"
	end if

	'reset timer to auto-hide
	window.clearInterval(intTimerID2)
  	intTimerID2 = window.setInterval ("HideGrpTimerCommands", g_nHideGrpTimerCommandsTimeout)

	'write the value NOW (and wait for action)
	sd.SetDataValueSynchronous sTemp, "START"]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[
