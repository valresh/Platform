			txt_TMST1.innerText = "RUN"
		elseif bIsMCBox and me.DataValue("boxpoint.TMAS(1)") = "TIMEUP" then
			txt_TMST1.innerText = "EXP"
		elseif me.DataValue("boxpoint.TMST(1)") = "STOPPED" and me.DataValue("boxpoint.TMPV(1)") > 0 and me.DataValue("boxpoint.TMPV(1)") = me.DataValue("boxpoint.TMSP(1)") then
