<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="726px" height="460px"><versionheaders><versionheader name="PS" value="4.1"/></versionheaders><scripts><script event="" language="VBScript" id="9D27584E-CD3F-41B8-8CFC-8FFA8951C12D"><![CDATA[sub SetLineVisibility (obj)
	if obj.value = "" then
	   	obj.parentElement.style.visibility = "hidden" 
	else
   		obj.parentElement.style.visibility = "visible" 
 	end if
end sub
sub SetBadColor (objSource, szCompare)
	if objSource.value = szCompare then
    	objSource.textColor = vbBlack
  	else
    	objSource.textColor = vbRed
  	end if
end sub
sub SetEnabledColor (obj)
	'msgbox txtEnabled.value
	SetBadColor obj, "ENABLE" 'group001.txtenabled.value
end sub
sub SetAssignedColor (obj)
	'msgbox txtyes.value
	SetBadColor obj, "YES" 'group001.txtyes.value
end sub]]></script></scripts><parameters><parameter name="PointName" type="Point" description="" defaultvalue="$prsts11"/></parameters><shapes><shape><group><element><html><content><![CDATA[
