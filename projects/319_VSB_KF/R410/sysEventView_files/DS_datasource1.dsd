				<SQLFilterPredefined id="Filter_PriorityHigh" FilterString="((Priority &amp; 0xF0) = 0x20) or ((Priority &amp; 0xF0) = 0xE0)" FilterDescription="High" Selected="false">
					<Selected>
						&lt;div title="Show high priority events" style="width: 100%;"&gt;
