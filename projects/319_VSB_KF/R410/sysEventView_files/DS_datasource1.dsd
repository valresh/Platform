			<SQLFilterGroup id="VideoLinkFilterGroup" SelectionPolicy="single">
				<SQLFilterPredefined id="Filter_VideoLinkTrue" FilterString="(((Link1Type &amp; 63) = 1) or ((Link2Type &amp; 63) = 1) or ((Link3Type &amp; 63) = 1))" FilterDescription="Available" Selected="false">
					<Selected>
						&lt;div title="Show events with video link" style="width: 100%;"&gt;
						&lt;img src="Images/Dot.gif"/&gt;
