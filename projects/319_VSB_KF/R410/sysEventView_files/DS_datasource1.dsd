				<column id="Recipe" name="Recipe" default="false">
					<title tooltip="Product Recipe or Product Grade">&lt;span class="textHeader"&gt;Recipe&lt;/span&gt;</title>
					<action/>
					<menu/>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Recipe" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="TPS Aux Unit" name="TPS Aux Unit" default="false">
					<title tooltip="Click to filter by the Auxiliary Unit">&lt;span class="textHeader"&gt;Aux Unit&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="AuxUnitColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="AUX UNIT" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="TPS TS Reliability" name="TPS TS Reliability" default="false">
					<title tooltip="Click to filter by the Time Stamp Reliability">&lt;span class="textHeader"&gt;TS Reliability&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="TSReliabilityColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="TS Reliable" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Sequence ID" name="Sequence ID" default="false">
					<title tooltip="Click to filter by the Sequence ID">&lt;span class="textHeader"&gt;Sequence ID&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="SequenceIDColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="SequenceID" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="EE Init ID" name="EE Init ID" default="false">
					<title tooltip="Click to filter by the EE Init ID">&lt;span class="textHeader"&gt;EE Init ID&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="EEInitIDColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="EEInitID" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Execution ID" name="Execution ID" default="false">
					<title tooltip="Click to filter by the Execution ID">&lt;span class="textHeader"&gt;Execution ID&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="ExecutionIDColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="ExecutionID" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="EE Code" name="EE Code" default="false">
					<title tooltip="Click to filter by the EE Code">&lt;span class="textHeader"&gt;EE Code&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="EECodeColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="EECode" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Block" name="Block" default="false">
					<title tooltip="Click to filter by the block">&lt;span class="textHeader"&gt;Block&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="BlockColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Block" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Criticality" name="Criticality" default="false">
					<title tooltip="Click to filter by the criticality">&lt;span class="textHeader"&gt;Criticality&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="CriticalityColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Criticality" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Suppression Group" name="Suppression Group" default="false">
					<title tooltip="Click to filter by the suppression group">&lt;span class="textHeader"&gt;Suppression Group&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="SuppressionGroupColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="SuppressionGroup" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Public Name" name="Public Name" default="false">
					<title tooltip="Click to filter by the public name">&lt;span class="textHeader"&gt;Public Name&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="PublicNameColumnFilterMainGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="PublicName" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
			</columns>
		</table>
	</TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
</DATAOBJECT>
<DATAOBJECT id="2" type="HMIPage.EntitySource" format="propertybag">
<PROPERTY name="Version">4.5</PROPERTY>
<PROPERTY name="AutoMigrate">0</PROPERTY>
<PROPERTY name="WaitForSelectionList">1</PROPERTY>
<PROPERTY name="StartLocation"></PROPERTY>
<PROPERTY name="AuxFilter">(IsAssigned or HasAssignedDescendents) and ((RemoteType != 8) or (SubType != 1001) or (ItemNumber != 2))</PROPERTY>
<PROPERTY name="TemplateXML"><![CDATA[
<TableTemplate>
	<FieldXML>
		<fields>
			<field id="Selected"/>
			<field id="NodeHandle" rowId="true"/>
			<field id="Depth"/>
			<field id="Expanded"/>
			<field id="NumChildren"/>
			<field id="SiblingNumber"/>
			<field id="PointNumber"/>
			<field id="IsAssigned"/>
			<field id="HasAssignedDescendents"/>
			<field id="EntityName"/>
			<field id="TagName"/>
			<field id="FullName"/>
			<field id="RemoteType"/>
			<field id="SubType"/>
			<field id="ItemNumber"/>
			<field id="Redundant"/>
			<field id="Type"/>
			<field id="DirectConnect"/>
			<field id="Flags"/>
		</fields>
	</FieldXML>
	<XFormXML>
		<xforms>
			<defaultValue id="xfEmptyVariantToString" value="" type="string"/>
			<script id="xfSelection" language="VBScript">
				Dim s
				s = "Unselected_Cells"
				If Not IsEmpty(Value(0)) Then
				    If Value(0) Then
					If g_bAreaTableIsActive Then
						If Value(1) Then 
							s = "Selected_Active_Cells"
						Else
							s = "Selected_Active_Unassigned_Cells"
						End If
					Else
						If Value(1) Then
							s = "Selected_Inactive_Cells"
						Else
							s = "Selected_Inactive_Unassigned_Cells"
						End If
					End If
				    ElseIf Not Value(1) Then
					s = "Unassigned_Cells"
				    End If
				End If
				Return = s
			</script>
			<script id="xfIconImg" language="VBScript">
				Return = GetNodeImagePath(Value)
			</script>
			<script id="xfPadding" language="VBScript">
				if ( IsEmpty(Value) ) then
				    Return = 0
				else
				    Return = (Value - 1) * 16
				end if
			</script>
			<script id="xfPlusMinusImg" language="VBScript">
				On Error Resume Next
				if (IsEmpty(Value(0)) or (Value(0) = 0)) then
					Return = "Images/blank.gif"
				elseif (Value(1)) then
				    if not window.external.IsOnTouchPanel then
					    Return = "Images/Collapse.png"
			        else 
					    Return = "Images/Collapse_Touch.png"
					end if
				else
				    if not window.external.IsOnTouchPanel then
					    Return = "Images/Expand.png"
					else
					    Return = "Images/Expand_Touch.png"
					end if
				end if
			</script>
			<script id="xfName" language="VBScript">
				Return = GetNodeDisplayName(Value)
			</script>
			<script id="xfUnavailableImg" language="VBScript">
				Return = GetUnavailableImagePath(Value)
			</script>
		</xforms>
	</XFormXML>
	<HTMLWrapperXML>
		<HTMLWrappers>
			<MenuItemWrapper>
				<Begin>
					&lt;div style="position: relative; width: 170px; padding-bottom: 2px; padding-top: 1px; padding-right: 5px;" onmouseenter="OnEnter_MenuItem(this)" onmouseleave="OnLeave_MenuItem(this)"&gt;&lt;span&gt;
				</Begin>
				<End>
					&lt;/span&gt;&lt;/div&gt;
				</End>
			</MenuItemWrapper>
			<FilterAppliedWrapper>
				<Begin>
					&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; margin-right: 1px; background-color: mediumblue; color: white; font-weight: bold;"&gt;
				</Begin>
				<End>
					&lt;/span&gt;
				</End>
			</FilterAppliedWrapper>
			<SortAscIndicator>
				&amp;nbsp;&lt;img src="Images/SortArrowUp.gif"&gt;
			</SortAscIndicator>
			<SortDescIndicator>
				&amp;nbsp;&lt;img src="Images/SortArrowDown.gif"&gt;
			</SortDescIndicator>
			<GroupSeparator>
				&lt;div style="position:relative; width: 160px; height: 2px; overflow: hidden; display: block; border: 1px inset; margin: 3px;" &gt;&lt;/div&gt;
			</GroupSeparator>
		</HTMLWrappers>
	</HTMLWrapperXML>
	<MenuGroupXML>
		<MenuGroups>
		</MenuGroups>
	</MenuGroupXML>
	<BaseFilterXML>
		<BaseFilterDef>
		</BaseFilterDef>
	</BaseFilterXML>
	<SortXML>
		<SortDef DefaultSortColumn="Tree" DefaultSortDir="asc">
			<colref id="Tree" 
				SortAscString="EntityName asc"
				SortDescString="EntityName desc"
				SortDir="asc"
				SortOrder="1"/>
		</SortDef>
	</SortXML>
	<ColumnStateXML>
		<state>
			<colref id="Tree" width="100" hidden="false" />
		</state>
	</ColumnStateXML>
	<TableDefinitionXML>
		<table>
			<tableMenu/>
			<contextMenu/>
			<columns>
				<column id="Tree">
					<title>Tree</title>
					<action/>
					<menu/>
					<content>
					    &lt;div language="javascript" onmousedown="if( event.button != 1 ) { event.cancelBubble = true; return false; }"
						    language="javascript" ExpandCollapseTrigger=0&gt;
					      &lt;div class="TreeNodeGroup"&gt;	    
						&lt;div class="TreeNodePlusMinus"
							onmousedown="if( event.button == 1 ) { this.parentElement.parentElement.ExpandCollapseTrigger = 1; event.cancelBubble = true; }"
							onclick="event.cancelBubble = true; return false;"&gt;
							&lt;img class="PlusMinusIcon" src="Images/blank.gif"/&gt;
						&lt;/div&gt;
					        &lt;div language="javascript" ondblclick="AreaTable.Binding.DataObjects(0).PointDetail();" class="TreeNodeIconGroup"&gt;
					        &lt;div class="TreeAssetIcon"&gt;
								&lt;img src="Images/blank.gif"&gt;
							&lt;/div&gt;
					        &lt;div class="TreeAssetIcon"&gt;
								&lt;img src="Images/blank.gif"&gt;
							&lt;/div&gt;
						&lt;/div&gt;
					        &lt;div language="javascript" ondblclick="AreaTable.Binding.DataObjects(0).PointDetail();" class="treeNodeLabel"&gt;&lt;/div&gt;
					      &lt;/div&gt;  
					    &lt;/div&gt;
					</content>
					<bindings>
						<in fields="Depth" properties="firstChild.style.pixelLeft" xforms="xfPadding" />
						<in fields="NumChildren;Expanded" properties="firstChild.firstChild.firstChild.src" xforms="xfPlusMinusImg" />
						<in fields="RemoteType;SubType;ItemNumber;Redundant;Flags" properties="firstChild.firstChild.nextSibling.firstChild.firstChild.src" xforms="xfIconImg" />
						<in fields="EntityName;Type;SubType;DirectConnect" properties="firstChild.firstChild.nextSibling.firstChild.nextSibling.firstChild.src" xforms="xfUnavailableImg" />
						<in fields="EntityName;RemoteType;SubType;ItemNumber" properties="firstChild.lastChild.innerText;title" xforms="xfName" />
						<in fields="Selected;IsAssigned" properties="firstChild.lastChild.id" xforms="xfSelection"/>
						<out properties="ExpandCollapseTrigger" fields="Expanded"/>
					</bindings>
				</column>
			</columns>
		</table>
	</TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
</DATAOBJECT>
</DATASOURCE>

