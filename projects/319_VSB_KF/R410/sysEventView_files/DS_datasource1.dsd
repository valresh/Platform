						&lt;/div&gt;
					</NotSelected>
				</SQLFilterPredefined>
				<SQLFilterPredefined id="Filter_VideoLinkFalse" FilterString="(((Link1Type is NULL) or ((Link1Type &amp; 63) = 0)) and ((Link2Type is NULL) or ((Link2Type &amp; 63) = 0)) and ((Link3Type is NULL) or ((Link3Type &amp; 63) = 0)))" FilterDescription="Not available" Selected="false">
					<Selected>
						&lt;div title="Show events with no video link" style="width: 100%;"&gt;
