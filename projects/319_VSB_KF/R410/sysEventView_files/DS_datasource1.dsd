			<SQLFilterGroup id="PriorityFilterGroup" SelectionPolicy="multi" DisableInLive="false">
				<SQLFilterPredefined id="Filter_PriorityUrgent" FilterString="((Priority &amp; 0xF0) = 0x30) or ((Priority &amp; 0xF0) = 0xF0)" FilterDescription="Urgent" Selected="false">
					<Selected>
						&lt;div title="Show urgent priority events" style="width: 100%;"&gt;
