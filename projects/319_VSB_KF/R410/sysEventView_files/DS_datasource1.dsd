	</ColumnStateXML>
	<TableDefinitionXML>
		<table>
			<tableMenu>
				<GroupRef GroupId="TableMenuGroup"/>
			</tableMenu>
			<contextMenu>
				<GroupRef GroupId="ContextMenuGroup"/>
			</contextMenu>
			<columns>
				<column id="Category Icon" name="Category Icon" fixed="true">
					<title tooltip="Click to filter by category">&lt;span class="blankHeader"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="CategoryColumnFilterMainGroup"/>
						<GroupRef GroupId="CategoryFilterGroup"/>
					</menu>
					<content>
						&lt;div style="width: 100%; 
							       height: 100%;
							       position: relative;
							       top: 0px;
							       z-index: 10;
							       white-space: nowrap;
 							       text-align: center;"&gt;
							&lt;img style="position: relative; 
								       left: 0px;
								       width: 16px; 
								       height: 16px; 
 								       z-index: 2;" 
								src=""/&gt;
						&lt;/div&gt;
					</content>
					<bindings>
						<in fields="Category" xforms="xfCategoryIcon" properties="firstChild.src" />
						<in fields="Category" xforms="xfCategoryIconVisibility" properties="firstChild.style.visibility" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Video Link" name="Video Link" fixed="true" default="false">
					<title tooltip="Click to filter by video link">&lt;span class="blankHeader"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="VideoLinkColumnFilterMainGroup"/>
						<GroupRef GroupId="VideoLinkFilterGroup"/>
					</menu>
					<content>
						&lt;div ondblclick="if(firstChild.style.visibility=='visible'){ g_TDO.NavigateLink1(); event.cancelBubble = true;}"
							       style="width: 100%; 
							       height: 100%;
							       position: relative;
							       top: 0px;
							       z-index: 10;
							       white-space: nowrap;
 							       text-align: center;"&gt;
							&lt;img src="Images/Video.gif" style="visibility: hidden;"/&gt;
						&lt;/div&gt;
					</content>
					<bindings>
						<in fields="VideoLinkAvailable" xforms="xfVisibility" properties="firstChild.style.visibility" />
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Event Time" name="Event Time">
