	<SortXML>
		<SortDef DefaultSortColumn="Event Time" DefaultSortDir="desc">
			<colref id="Event Time"
				SortAscString="Time asc"
				SortDescString="Time desc"
				SortAscDescription="Event Time ascending"
				SortDescDescription="Event Time descending"
				SortDir="desc"
				SortOrder="1"/>
			<colref id="Source"
				SortAscString="SourceSort asc"
				SortDescString="SourceSort desc"
				SortAscDescription="Source ascending"
				SortDescDescription="Source descending"
				SortDir="none"
				SortOrder="0"/>
		</SortDef>
	</SortXML>
	<ReportTemplateXML>
		<ReportTemplate>
			<colref id="Category Icon" header="" field="CategoryName" />
			<colref id="Video Link" header="" field="VideoLinkAvailable" />
			<colref id="Event Time" header="Event Time" field="TimeString" />
			<colref id="Field Time" header="Field Time" field="FieldTimeString" />
			<colref id="Changed Time" header="Changed Time" field="ChangedTimeString" />
			<colref id="Category" header="Category" field="CategoryName" />
			<colref id="Location" header="Location" field="LocationFullName" />
			<colref id="Item" header="Item" field="SourceEntityName" />
			<colref id="Location Tag" header="Location Tag" field="LocationTagName" />
			<colref id="Location Item" header="Location Item" field="LocationItemName" />
			<colref id="Source" header="Source" field="Source" />
			<colref id="Condition" header="Condition" field="ConditionName" />
			<colref id="Sub-Condition" header="Sub-Condition" field="SubConditionName" />
			<colref id="Action" header="Action" field="Action" />
			<colref id="Operator" header="Operator" field="Actor" />
			<colref id="Reason" header="Reason" field="Reason" />
			<colref id="Priority" header="Priority" field="PriorityString" />
			<colref id="Description" header="Description" field="Description" />
			<colref id="Alarm Limit" header="Alarm Limit" field="AlarmLimit" />
			<colref id="Value" header="Value" field="Value" />
			<colref id="Previous Value" header="Previous Value" field="PrevValue" />
			<colref id="Units" header="Units" field="Units" />
			<colref id="DSA Connection Name" header="DSA Connection Name" field="GDAConnectionName" />
			<colref id="DSA Server Name" header="DSA Server Name" field="GDAServerName" />
			<colref id="Station" header="Station" field="Station" />
			<colref id="Signature Meaning" header="Signature Meaning" field="SignatureMeaning" />
			<colref id="Quality" header="Quality" field="GDAQualityString" />
			<colref id="OPC Severity" header="OPC Severity" field="Severity" />
			<colref id="Shelved Reason" header="Shelved Reason" field="ShelvedReason" />
			<colref id="Flags" header="Flags" field="FlagsString" />
			<colref id="Section ID" header="Section ID" field="Section ID" />
			<colref id="Roll ID" header="Roll ID" field="Roll ID" />
			<colref id="Recipe" header="Recipe" field="Recipe" />
			<colref id="TPS Aux Unit" header="Aux Unit" field="AUX UNIT" />
			<colref id="TPS TS Reliability" header="TS Reliability" field="TS Reliable" />
			<colref id="Sequence ID" header="Sequence ID" field="SequenceID" />
			<colref id="EE Init ID" header="EE Init ID" field="EEInitID" />
			<colref id="Execution ID" header="Execution ID" field="ExecutionID" />
			<colref id="EE Code" header="EE Code" field="EECode" />
			<colref id="Block" header="Block" field="Block" />
			<colref id="Criticality" header="Criticality" field="Criticality" />
			<colref id="Suppression Group" header="Suppression Group" field="SuppressionGroup" />
			<colref id="Public Name" header="Public Name" field="PublicName" />
		</ReportTemplate>
	</ReportTemplateXML>
	<ColumnStateXML>
		<state>
			<colref id="Category Icon" width="26" hidden="false" />
			<colref id="Video Link" width="26" hidden="true" />
			<colref id="Event Time" width="150" hidden="false" />
			<colref id="Field Time" width="150" hidden="true" />
			<colref id="Changed Time" width="150" hidden="true" />
			<colref id="Category" width="150" hidden="false" />
			<colref id="Location Tag" width="150" hidden="false" />
			<colref id="Item" width="150" hidden="true"/>
			<colref id="Location" width="150" hidden="true"/>
			<colref id="Location Item" width="150" hidden="true" />
			<colref id="Source" width="180" hidden="false" />
			<colref id="Condition" width="60" hidden="false" />
