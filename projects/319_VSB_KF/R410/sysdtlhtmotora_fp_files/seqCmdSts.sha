	if oShape.objects("ConAlpCMD8").value = 1 then
		oShape.objects("ConCMDgrp8").style.visibility = "inherit" : oShape.objects("ConCMDgrp8").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConCMDgrp8").style.pixeltop
		oShape.objects("ConRectCMDSTATUS").style.pixelheight = iTop + 20
	else
