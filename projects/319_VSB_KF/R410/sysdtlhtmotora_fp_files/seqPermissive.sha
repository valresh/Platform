<?xml version="1.0"?><shapefile version="1" type="sequence" title="" description="" useFirstShapeForBadValue="0" width="146px" height="202px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src="..\Styles\SysFaceplate.css"/></stylesheets><scripts><script event="" language="VBScript" id="DE5C3042-D7D7-4DB3-91F2-1EAE5CB4E47B"><![CDATA[sub PermissiveInterlock(oSource)
dim oShape 
on error resume next
set oShape=oSource.parentnode.parentnode
dim iTop
iTop = 0
	if oShape.objects("ConAlpPer1").value = 0 then 
		oShape.objects("ConPergrp1").style.visibility = "inherit" : oShape.objects("ConPergrp1").style.pixeltop = 20 : iTop = oShape.objects("ConPergrp1").style.pixeltop
		oShape.objects("ConRectPermisive").style.pixelheight = iTop + 20
	else
		oShape.objects("ConPergrp1").style.visibility = "Hidden"
	end if

	if (oShape.objects("ConAlpPer2").value = 0 and oShape.objects("ConAlpPer3").value = 0) or (oShape.objects("ConAlpPer2").value = 1 and oShape.objects("ConAlpPer3").value = 1) then 
		oShape.objects("ConPergrp2").style.visibility = "inherit" : oShape.objects("ConPergrp2").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConPergrp2").style.pixeltop + 15
		oShape.objects("ConRectPermisive").style.pixelheight = iTop + 40
	else
		oShape.objects("ConPergrp2").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpPer4").value = 0 then
		oShape.objects("ConPergrp4").style.visibility = "inherit" : oShape.objects("ConPergrp4").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConPergrp4").style.pixeltop
		oShape.objects("ConRectPermisive").style.pixelheight = iTop + 20
	else
		oShape.objects("ConPergrp4").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpPer5").value = 0 then
		oShape.objects("ConPergrp5").style.visibility = "inherit" : oShape.objects("ConPergrp5").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConPergrp5").style.pixeltop
		oShape.objects("ConRectPermisive").style.pixelheight = iTop + 20
	else
		oShape.objects("ConPergrp5").style.visibility = "Hidden"
	end if

	if oShape.objects("ConAlpPer6").value = 0 then
		if iTop = 0 then
			itop =  - 20
		end if
			oShape.objects("ConPergrp6").style.visibility = "inherit" : oShape.objects("ConPergrp6").style.pixeltop = iTop + 20 : iTop = oShape.objects("ConPergrp6").style.pixeltop
			oShape.objects("ConRectPermisive").style.pixelheight = iTop + 45
	else
		oShape.objects("ConPergrp6").style.visibility = "Hidden"
	end if
end sub]]></script></scripts><parameters><parameter name="PointId" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
