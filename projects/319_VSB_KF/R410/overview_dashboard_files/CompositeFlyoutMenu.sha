<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="140px" height="180px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="JScript" id="8715E8B2-8A8D-45C3-A756-18B69C561ABA"><![CDATA[function checkDashboardGlobalScripts()
{
	try 
	{
		if (isDashboardGlobalScriptLinked == true)
		{
			return;
		}
	}
	catch (err){}

	var element_head=document.getElementsByTagName("HEAD")[0];
	if(element_head != null)
	{
		var scriptLink = document.createElement("script");
		scriptLink.language = "JScript";
	
		var systemSummaryPath = window.external.parent.FindFile("sysSystemSummary.htm");
		systemSummaryPath = systemSummaryPath.substr(0, systemSummaryPath.lastIndexOf("\\") + 1); 
		var scriptFilePath = systemSummaryPath + "/Scripts/DashboardScripts.js";

		scriptLink.src = scriptFilePath;
		element_head.appendChild(scriptLink);
	}
}

checkDashboardGlobalScripts();]]></script></scripts><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=menuOutline class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect)  url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:180;LineColor:#d1d1d1;lineColorBlink:False;Width:140;"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><group><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=auxMenu000_sysdspPath01 class=hvg.textbox.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 95.45%; FONT-FAMILY: Arial; WIDTH: 63.84%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 11.53%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:83;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=auxMenu000_icon01 class="hsc.image.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 15.38%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#image) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:20;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;Src:.\CompositeFlyoutMenu_files\CompositePulloutMenu_files\icon.png;Width:20;" shapesrc=".\CompositeFlyoutMenu_files\CompositePulloutMenu_files\icon.png"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	if (auxMenu000_sysdspPath01.value.length == 0)
	{
		GetSysdspPath(auxMenu000_sysdspPath01);
	}

	if (auxMenu000_sysdspPath01.value.length == 0)
	{
		return;
	}

	var imagePath = auxMenu000_sysdspPath01.value + "images\\SystemDashboardImages\\";
	var pointType = auxMenu000_icon01.DataValue("AuxPoint.PointType");
	var pointSubtype = auxMenu000_icon01.DataValue("AuxPoint.PointSubtype");
	var itemNumber = auxMenu000_icon01.DataValue("AuxPoint.ItemNumber");

	var imageFileName = DetermineGraphicIconFile(pointType, pointSubtype, itemNumber);
	auxMenu000_icon01.src = imagePath + imageFileName;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=""/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=auxMenu000_status01 class="hsc.image.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 15.38%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 84.61%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#image) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:20;lineColorBlink:False;Src:.\CompositeFlyoutMenu_files\CompositePulloutMenu_files\SSDUnknown.png;Width:20;" shapesrc=".\CompositeFlyoutMenu_files\CompositePulloutMenu_files\SSDUnknown.png"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	if (auxMenu000_sysdspPath01.value.length == 0)
	{
		GetSysdspPath(auxMenu000_sysdspPath01);
	}

	if (auxMenu000_sysdspPath01.value.length == 0)
	{
		return;
	}

	var imagePath = auxMenu000_sysdspPath01.value + "images\\";
	var mostImportantStatus = 1;

	try
	{
		mostImportantStatus = auxMenu000_status01.DataValue("AuxPoint.Status");
		if ((!mostImportantStatus) || isNaN(mostImportantStatus))
		{
			mostImportantStatus = 1;
		}
	}
	catch (err)
	{
	}

	if (mostImportantStatus == 1)
	{
		imagePath += "blank.png";
	}
	else if (mostImportantStatus == 2)
	{
		imagePath += "SSDDisabled.png";
	}
	else if (mostImportantStatus == 3)
	{
		imagePath += "SSDFailed.png";
	}
	else if (mostImportantStatus == 4)
	{
		imagePath += "SSDMarginal.png";
	}
	else if (mostImportantStatus == 5)
	{
		imagePath += "SSDOK.png";
	}
	else if (mostImportantStatus == 6)
	{
		imagePath += "SSDSimulation.png";
	}
	else
	{
		imagePath += "SSDUnknown.png";
	}

	auxMenu000_status01.src= imagePath;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=""/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=auxMenu000_alarmstate01 title="Bad Quality, Urgent, Active, Acknowledged" class="hsc.alarmstate.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 15.38%; WHITE-SPACE: nowrap; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; TOP: 4.54%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="acknowledged:True;HDXBINDINGID:-4;priority:3;quality:0;rtn:False;showDisableIcon:false;showTooltip:true;staticIcon:False;" ObjectType="6"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	var pointAlmState = TransformAlarmState(auxMenu000_alarmstate01.DataValue("AuxPoint.AlarmFlags"));
	
	// Hide icon graphics if there is alarm to display
	if ((pointAlmState & (ALARMPRIORITY_MASK|ALARM_SHELVED|ALARM_SUPPRESSED|ALARM_ACK_REQ)) > 0)
	{
		auxMenu000_icon01.style.visibility = "hidden";
	}
	else
	{
		auxMenu000_icon01.style.visibility = "inherit";
	}

	auxMenu000_alarmstate01.AlarmState = pointAlmState;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=""/></dataobjectdef></dataobject><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Null%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NAME"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="hsc.alarmstate" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabInd