<DIV tabIndex=-1 id=auxMenu01_status01 class="hsc.image.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 15.38%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 84.61%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#image) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:20;lineColorBlink:False;Src:.\CompositeFlyoutMenu_files\CompositePulloutMenu_files\SSDUnknown.png;Width:20;" shapesrc=".\CompositeFlyoutMenu_files\CompositePulloutMenu_files\SSDUnknown.png"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	if (auxMenu01_sysdspPath01.value.length == 0)
	{
		GetSysdspPath(auxMenu01_sysdspPath01);
	}

	if (auxMenu01_sysdspPath01.value.length == 0)
	{
		return;
	}

	var imagePath = auxMenu01_sysdspPath01.value + "images\\";
	var mostImportantStatus = 1;

	try
	{
		mostImportantStatus = auxMenu01_status01.DataValue("AuxPoint.Status");
		if ((!mostImportantStatus) || isNaN(mostImportantStatus))
		{
			mostImportantStatus = 1;
		}
	}
	catch (err)
	{
	}

	if (mostImportantStatus == 1)
	{
		imagePath += "blank.png";
	}
	else if (mostImportantStatus == 2)
	{
		imagePath += "SSDDisabled.png";
	}
	else if (mostImportantStatus == 3)
	{
		imagePath += "SSDFailed.png";
	}
	else if (mostImportantStatus == 4)
	{
		imagePath += "SSDMarginal.png";
	}
	else if (mostImportantStatus == 5)
	{
		imagePath += "SSDOK.png";
	}
	else if (mostImportantStatus == 6)
	{
		imagePath += "SSDSimulation.png";
	}
	else
	{
		imagePath += "SSDUnknown.png";
	}

	auxMenu01_status01.src= imagePath;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=""/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=auxMenu01_alarmstate01 title="Bad Quality, Urgent, Active, Acknowledged" class="hsc.alarmstate.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 15.38%; WHITE-SPACE: nowrap; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; TOP: 4.54%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="acknowledged:True;HDXBINDINGID:-4;priority:3;quality:0;rtn:False;showDisableIcon:false;showTooltip:true;staticIcon:False;" ObjectType="6"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	var pointAlmState = TransformAlarmState(auxMenu01_alarmstate01.DataValue("AuxPoint.AlarmFlags"));
	
	// Hide icon graphics if there is alarm to display
	if ((pointAlmState & (ALARMPRIORITY_MASK|ALARM_SHELVED|ALARM_SUPPRESSED|ALARM_ACK_REQ)) > 0)
	{
		auxMenu01_icon01.style.visibility = "hidden";
	}
	else
	{
		auxMenu01_icon01.style.visibility = "inherit";
	}

	auxMenu01_alarmstate01.AlarmState = pointAlmState;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=""/></dataobjectdef></dataobject><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Null%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NAME"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="hsc.alarmstate" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabInde