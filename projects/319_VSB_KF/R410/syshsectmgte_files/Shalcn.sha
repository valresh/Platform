end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="STATE3,PVSTATES(2),STATETEXT(2),"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,1,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN style="BORDER-BOTTOM: transparent 2px; POSITION: absolute; TEXT-ALIGN: right; BORDER-LEFT: transparent 2px; PADDING-BOTTOM: 2px; BACKGROUND-COLOR: #000000; FONT-STYLE: normal; TEXT-INDENT: 2px; PADDING-LEFT: 2px; WIDTH: 73.33%; PADDING-RIGHT: 2px; FONT-FAMILY: Arial; HEIGHT: 7.97%; VISIBILITY: inherit; COLOR: #00ffff; FONT-SIZE: 12pt; OVERFLOW: hidden; BORDER-TOP: transparent 2px; TOP: 73.91%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 2px; PADDING-TOP: 2px; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 24%" id=DIConCboPV class="hsc.combo.1 " title="" tabIndex=-1 hdxproperties="borderStyle:Inset;borderWidth:2;fillColor:#000000;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:True;lineColor:#000000;lineColorBlink:False;styleClass:;textColor:#00ffff;textColorBlink:False;" HDX_LOCK="-1" printValue="Combobox">Combobox</SPAN>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error Resume Ne