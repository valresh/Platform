If RGsd.QualityBad("TagName.SLOTNUM") then ' Point Doesn't Exist
	me.parentElement.style.visibility = "Hidden"
else
	me.parentElement.style.visibility = "Inherit"
end if

On Error Resume Next
if not RGsd.QualityBad("TagName.ALGIDDAC") and not RGsd.QualityBad("TagName.SLOTNUM")then
	call AlgoRithm_Type__Onupdate(RGsd)
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="Name"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 0px; POSITION: absolute; TEXT-ALIGN: left; BORDER-LEFT: transparent 0px; PADDING-BOTTOM: 1px; BACKGROUND-COLOR: #000000; PADDING-LEFT: 1px; WIDTH: 97.33%; PADDING-RIGHT: 1px; FONT-FAMILY: Arial; WORD-WRAP: break-word; HEIGHT: 17.39%; VISIBILITY: inherit; COLOR: #00ff44; FONT-SIZE: 10pt; OVERFLOW: hidden; BORDER-TOP: transparent 0px; TOP: 9.05%; BORDER-RIGHT: transparent 0px; PADDING-TOP: 1px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 1.33%; ROWS: 1" id=RGConalpDescription class="hsc.alpha.1 " title="" tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:1px;durationFormat:-1;fillColor:#000000;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#000000;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;styleClass:;textColor:#00ff44;