<?xml version="1.0"?><shapefile version="1" type="sequence" title="" description="" useFirstShapeForBadValue="0" width="150px" height="275px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="VBScript" id="58BD94E0-A954-46C6-99EB-250776A1F6A6"><![CDATA['Different regulatory algorithm type 
 sDAS  =  "DAS"
 sPIDNORM  =  "PIDNORM"
 sPIDRATIO  =  "PIDRATIO"
 sAUTRATIO  =  "AUTRATIO"
 sAUTOBIAS  =  "AUTOBIAS"
 sPIDCMA  =  "PIDCMA"
 sPIDCM  =  "PIDCM"
 sPIDSPC  =  "PIDSPC"
 sPIDERSQG  =  "PIDERSQG"
 sPIDERSQI  =  "PIDERSQI"
 sPIDGAP  =  "PIDGAP"
 sPIDEXFB  =  "PIDEXFB"
 sEXTRATBI  =  "EXTRATBI"
 sMASSFLOW  =  "MASSFLOW"
 sLEADLAG  =  "LEADLAG"
 sOVERHISL  =  "OVERHISL"
 sOVERLOSL  =  "OVERLOSL"
 sSUMRWMAN  =  "SUMRWMAN"
 sMULTWMAN  =  "MULTWMAN"
 sAUTOMAN  =  "AUTOMAN"
 sSWITCH  =  "SWITCH"
 sCBSUMR  =  "CBSUMR"
 sMULT  =  "MULT"
 sDIVIDR  =  "DIVIDR"
 sSQRT  =  "SQRT"
 sSQRTPROD  =  "SQRTPROD"
 sSUMSQRT  =  "SUMSQRT"
 sHISEL  =  "HISEL"
 sLOSEL  =  "LOSEL"
 sPIDDDC  =  "PIDDDC"
 sPIDDDCSP  =  "PIDDDCSP"
 sPIDNONLN  =  "PIDNONLN"
 sLEADLAGS  =  "LEADLAGS"
 sSELOVDDC  =  "SELOVDDC"
 sECSQRTPROD  =  "ECSQRTPROD"
 sECSUMR  =  "ECSUMR"
 sMULTDIV  =  "MULTDIV"
 sLEADLAGM  =  "LEADLAGM"
 sMIDOF3  =  "MIDOF3"
 sINCRMTL  =  "INCRMTL"
 sRAMPSOAK  =  "RAMPSOAK"
 sLOGIC  =  "LOGIC"
 sDEADTM  =  "DEADTM"
 sCHARACT  =  "CHARACT"


Sub AlgoRithm_Type__Onupdate(oSource)
On Error Resume Next
set oshape = oSource.ParentNode.ParentNode
if not oshape is nothing then
	salgoType = ucase(oSource.DataValue("TagName.ALGIDDAC"))
	select case salgoType
		case sLOGIC, sOVERHISL , sOVERLOSL, sSELOVDDC 'PV and SP not applicable to this type algorithm
			oshape.objects("RGConAlpPV").style.visibility = "Hidden"
			oshape.objects("RGTxtPV").style.visibility = "Hidden" 
			oshape.objects("RGConAlpSP").style.visibility = "Hidden"
			oshape.objects("RGTxtSP").style.visibility = "Hidden"
		case sCHARACT, sLOGIC, sAUTOMAN, sDEADTM , sLEADLAG, sINCRMTL 'SP not applicable to this type algorithm
			oshape.objects("RGConAlpSP").style.visibility = "Hidden"
			oshape.objects("RGTxtSP").style.visibility = "Hidden"
		case sLOGIC 
			oshape.objects("RGTxtOP").style.visibility = "Hidden" ' PV , SP , OP not applicable to this type algorithm
			oshape.objects("RGConAlpOP").style.visibility = "Hidden"
			oshape.objects("RGConAlpPV").style.visibility = "Hidden"
			oshape.objects("RGTxtPV").style.visibility = "Hidden" 
			oshape.objects("RGConAlpSP").style.visibility = "Hidden"
			oshape.objects("RGTxtSP").style.visibility = "Hidden"
		case else   ' By default all PV, SP, OP and Mode are applicable
	end select
end if

End Sub]]></script></scripts><parameters><parameter name="TagName" type="Point" description="Point Name" defaultvalue=","/></parameters><shapes><shape><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 150px; FONT-FAMILY: Arial; HEIGHT: 275px; VISIBILITY: inherit; FONT-SIZE: 12pt; OVERFLOW: hidden; TOP: 15px; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect)  url(#BindingBehavior) url(#HSCScriptDataBehavior); LEFT: 0px" id=BadValue class="hvg.base.1 HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="FillColor:#000000;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:275;indicateAlarmState:False;indicateScanState:False;LineColor:#00ff00;lineColorBlink:False;LineStyle:1;Width:150;" HDX_LOCK="-1"></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("TagName.PNTTYPE") then
	if me.DataValue("TagName.PNTTYPE") = 7 then
		me.parentNode.value = 2
	elseif me.DataValue("TagName.PNTTYPE") = 1 then
		me.parentNode.value = 3
	elseif me.DataValue("TagName.PNTTYPE") = 4 then
		me.parentNode.value = 4
	else
		me.parentNode.value = 1
	end if
else
	me.parentNode.value = 1
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PNTTYPE,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element></shape><shape><group><element><html><content><![CDATA[
