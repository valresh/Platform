<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 100%; FONT-FAMILY: Arial; HEIGHT: 99.63%; VISIBILITY: inherit; FONT-SIZE: 12pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect)  url(#BindingBehavior) url(#HSCScriptDataBehavior); LEFT: 0%" id=RVBase class="hvg.base.1 HSC.ScriptDataObject.1" tabIndex=-1 hdxproperties="FillColor:#000000;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:275;LineColor:#00ff00;lineColorBlink:False;LineStyle:1;Width:150;" HDX_LOCK="-1"></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[On Error Resume Next
if not me.QualityBad("TagName.PNTTYPE") then
	if me.DataValue("TagName.PNTTYPE") = 7 then
		me.parentNode.parentNode.value = 2
	elseif me.DataValue("TagName.PNTTYPE") = 1 then
		me.parentNode.parentNode.value = 3
	elseif me.DataValue("TagName.PNTTYPE") = 4 then
		me.parentNode.parentNode.value = 4
	else
		me.parentNode.parentNode.value = 1
	end if
else
	me.parentNode.parentNode.value = 1
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PNTTYPE,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 100%; FONT-FAMILY: Arial; HEIGHT: 0.36%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 8pt; OVERFLOW: hidden; TOP: 27.17%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#line); LEFT: 0%" id=RVLin1 class=hvg.base.1 tabIndex=-1 hdxproperties="EndArrow:0;fillColorBlink:False;Height:1;LineColor:#c0c0c0;lineColorBlink:False;LineStyle:1;points:0 0 100 0 ;textColorBlink:0;Width:150;" HDX_LOCK="-1" globalscripts></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 0px; POSITION: absolute; TEXT-ALIGN: left; BORDER-LEFT: transparent 0px; PADDING-BOTTOM: 1px; BACKGROUND-COLOR: #000000; PADDING-LEFT: 1px; WIDTH: 97.33%; PADDING-RIGHT: 1px; FONT-FAMILY: Arial; WORD-WRAP: normal; HEIGHT: 7.24%; VISIBILITY: inherit; COLOR: #00ff44; FONT-SIZE: 10pt; OVERFLOW: hidden; BORDER-TOP: transparent 0px; TOP: 1.44%; FONT-WEIGHT: bold; BORDER-RIGHT: transparent 0px; PADDING-TOP: 1px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 1.33%; ROWS: 1" id=RVConalpTagName class="hsc.alpha.1 " tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:1px;durationFormat:-1;fillColor:#000000;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;styleClass:;textColor:#00ff44;textColorBlink:False;" HDX_LOCK="-1">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error Resume Next
If RVsd.QualityBad("TagName.SLOTNUM") then ' Point Doesn't Exist
	me.parentElement.style.visibility = "Hidden"
else
	me.parentElement.style.visibility = "Inherit"
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="Name"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="BORDER-BOTTOM: transparent 0px; POSITION: absolute; TEXT-ALIGN: left; BORDER-LEFT: transparent 0px; PADDING-BOTTOM: 1px; BACKGROUND-COLOR: #000000; PADDING-LEFT: 1px; WIDTH: 97.33%; PADDING-RIGHT: 1px; FONT-FAMILY: Arial; WORD-WRAP: break-word; HEIGHT: 17.39%; VISIBILITY: inherit; COLOR: #00ff44; FONT-SIZE: 10pt; OVERFLOW: hidden; BORDER-TOP: transparent 0px; TOP: 9.05%; BORDER-RIGHT: transparent 0px; PADDING-TOP: 1px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 1.33%; ROWS: 1" id=RVConalpDescription class="hsc.alpha.1 " title="" tabIndex=-1 hdxproperties="borderStyle:none;borderWidth:1px;durationFormat:-1;fillColor:#000000;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#000000;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;styleClass:;textColor:#00ff44;