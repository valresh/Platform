<DIV tabIndex=-1 id=GrpI1 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 21.05%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 26.31%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:184;"></DIV>]]></content></html></group><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtI0 class="hvg.textbox.1 DetailText" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 100%; FONT-FAMILY: Verdana; WIDTH: 41.3%; POSITION: absolute; COLOR: #000000; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:DetailText;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:76;" HDX_LOCK="-1">I0:</DIV>]]></content></html></element><element><html><content><![CDATA[<SPAN tabIndex=0 id=cmbI0 class="hsc.combo.1 DetailCombo" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Verdana; WIDTH: 50.54%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: black; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 49.45%; TOP: 0%; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: white; TEXT-INDENT: 2px" hdxproperties="borderStyle:none;fillColor:White;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:False;lineColor:transparent;lineColorBlink:False;styleClass:DetailCombo;textColor:black;textColorBlink:False;" HDX_LOCK="-1">Combobox</SPAN>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="1"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="I0.external"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="Hsc.ComboBox" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=GrpI0 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 21.05%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 52.63%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:184;"></DIV>]]></content></html></group><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtI2 class="hvg.textbox.1 DetailText" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 100%; FONT-FAMILY: Verdana; WIDTH: 55.97%; POSITION: absolute; COLOR: #000000; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:DetailText;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:103;" HDX_LOCK="-1">I2:</DIV>]]></content></html></element><element><html><content><![CDATA[<SPAN tabIndex=0 id=cmbI2 class="hsc.combo.1 DetailCombo" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Verdana; WIDTH: 50.54%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: black; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 49.45%; TOP: 0%; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: white; TEXT-INDENT: 2px" hdxproperties="borderStyle:none;fillColor:White;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:False;lineColor:transparent;lineColorBlink:False;styleClass:DetailCombo;textColor:black;textColorBlink:False;" HDX_LOCK="-1">Combobox</SPAN>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="1"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="I2.external"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="Hsc.ComboBox" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=GrpI2 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 21.05%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 78.94%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:184;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=GrpOverrides class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 14.9%; WIDTH: 25.48%; POSITION: absolute; LEFT: 34.76%; TOP: 53.13%; BEHAVIOR: url(#HDXVectorFactory#group); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;Height:76;lineColorBlink:False;Width:184;" HDX_LOCK="-1"></DIV>]]></content></html></group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=sd class="hvg.textbox.1 Hidden_Data HSC.ScriptDataObject.1" style="FONT-SIZE: 7pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 3.33%; FONT-FAMILY: Small Fonts; WIDTH: 8.31%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #ff0000; TEXT-ALIGN: center; LEFT: 43.35%; TOP: 90%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:17;lineColorBlink:False;LineStyle:0;styleClass:Hidden_Data;textColor:red;textColorBlink:False;TotalRotation:-1;Width:60;" HDX_LOCK="-1">Text</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim bTPNServerOK
	on error resume next

	if bVisibilityUpdated = FALSE then
		GrpOverridesHeader.style.visibility = "Inherit"
		GrpPointDataHeader.style.visibility = "Inherit"
		GrpGeneralHeader.style.visibility = "Inherit"
		GrpPermissivesHeader.style.visibility = "Inherit"
	end if

	if not sd.QualityGood("tagname.NODE_NO") then
		txtLoading.value = "** Missing TPN Data **"
		txtLoading.style.visibility = "Inherit"
		bTPNServerOK = FALSE
	else
		bTPNServerOK = TRUE
		txtLoading.style.visibility = "Hidden"
	end if


	if sd.QualityGood("tagname.CONTCUT") then
		GrpCONTCUT.style.visibility = "Visible"
	  	if sd.DataValue("tagname.CONTCUT") then
	    	txt_CONTCUT.value = "ON"
	  	else 
	  		txt_CONTCUT.value = "OFF"
	  	end if
	else
		GrpCONTCUT.style.visibility = "Hidden"
	end if

	if not sd.QualityGood("tagname.PVSOURCE") then
		GrpPVSOURCE.style.visibility = "Hidden"
	else
		GrpPVSOURCE.style.visibility = "Visible"
 		cmbPVSOURCE.value = sd.DataValue("tagname.PVSOURCE")
	end if
	if sd.QualityGood("tagname.BYPASS") then
		GrpBYPASS.style.visibility = "Visible"
		if sd.DataValue("tagname.BYPASS") <> 0 then
			cmbBYPASS.innerText = "ON"
		else
			cmbBYPASS.innerText = "OFF"
		end if
	else
		GrpBYPASS.style.visibility = "Hidden"
	end if
	if not sd.QualityGood("tagname.PVNORMAL") then
		GrpPVNORMAL.style.visibility = "Hidden"
	else
		GrpPVNORMAL.style.visibility = "Visible"
 		cmbPVNORMAL.value = sd.DataValue("tagname.PVNORMAL")
	end if
'GrpOverrides
	if sd.QualityGood("tagname.SI0") then
		GrpSI0.style.visibility = "Visible"
	else
		GrpSI0.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.I1") then
		GrpI1.style.visibility = "Visible"
	else
		GrpI1.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.I0") then
		GrpI0.style.visibility = "Visible"
	else
		GrpI0.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.I2") and sd.DataValue("tagname.NOSTATES") > 2 then
		GrpI2.style.visibility = "Visible"
	else
		GrpI2.style.visibility = "Hidden"
	end if

'GrpPointData
	if not sd.QualityGood("tagname.PTEXECST") then
		GrpPTEXECST.style.visibility = "Hidden"
	else
		GrpPTEXECST.style.visibility = "Visible"
		cmbPTEXECST.value = sd.DataValue("tagname.PTEXECST")
	end if
	if not sd.QualityGood("tagname.ALENBST") then
		GrpALENBST.style.visibility = "Hidden"
	else
		GrpALENBST.style.visibility = "Visible"
		cmbALENBST.value = sd.DataValue("tagname.ALENBST")
	end if
	if not sd.QualityGood("tagname.REDTAG") then
		GrpREDTAG.style.visibility = "Hidden"
	else
		GrpREDTAG.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.NMODATTR") then
		GrpNMODATTR.style.visibility = "Hidden"
	else
		GrpNMODATTR.style.visibility = "Visible"
		cmbNMODATTR.value = sd.DataValue("tagname.NMODATTR")
	end if

	if not sd.QualityGood("tagname.CCSRC") or sd.DataValue("tagname.CCSRC") = -1 then
		GrpCCSRC.style.visibility = "Hidden"
	else
		GrpCCSRC.style.visibility = "Visible"
		param_CCSRC.value = FormatNumber(sd.DataValue("tagname.CCSRC"),0)
	end if

'GrpPermissives

	if sd.QualityGood("tagname.P1") then
		GrpP1.style.visibility = "Visible"
	else
		GrpP1.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.P0") then
		GrpP0.style.visibility = "Visible"
	else
		GrpP0.style.visibility = "Hidden"
	end if
	if sd.QualityGood("tagname.P2") and sd.DataValue("tagname.NOSTATES") > 2 then
		GrpP2.style.visibility = "Visible"
	else
		GrpP2.style.visibility = "Hidden"
	end if

' *** CPU Saver - KEEP ALL DYNAMIC UNBOUND VALUES ABOVE THIS LINE ***
	if bVisibilityUpdated and bTPNServerOK and not bPeriodicVisibilityUpdate then 
		exit sub
	end if

	bPeriodicVisibilityUpdate = FALSE 'cpu saver flag

'GrpGeneral
	if not sd.QualityGood("tagname.SVEUDESC") then
		GrpSVEUDESC.style.visibility = "Hidden"
	else
		GrpSVEUDESC.style.visibility = "Visible"
		param_SVEUDESC.value = sd.DataValue("tagname.SVEUDESC")
	end if
	if not sd.QualityGood("tagname.KEYWORD") then
		GrpKEYWORD.style.visibility = "Hidden"
	else
		GrpKEYWORD.style.visibility = "Visible"
		param_KEYWORD.value = sd.DataValue("tagname.KEYWORD")
	end if

	if not sd.QualityGood("tagname.ENT_TYPE") then
		GrpENT_TYPE.style.visibility = "Hidden"
	else
		GrpENT_TYPE.style.visibility = "Visible"
		param_ENT_TYPE.value = sd.DataValue("tagname.ENT_TYPE")
	end if
	if not sd.QualityGood("tagname.NODE_NO") then
		GrpNODE_NO.style.visibility = "Hidden"
	else
		GrpNODE_NO.style.visibility = "Visible"
		param_NODE_NO.value = sd.DataValue("tagname.NODE_NO")
	end if
	if not sd.QualityGood("tagname.NTWKNUM") then
		GrpNTWKNUM.style.visibility = "Hidden"
	else
		GrpNTWKNUM.style.visibility = "Visible"
		param_NTWKNUM.value = sd.DataValue("tagname.NTWKNUM")
	end if
	if not sd.QualityGood("tagname.NODENUM") then
		GrpNODENUM.style.visibility = "Hidden"
	else
		GrpNODENUM.style.visibility = "Visible"
		param_NODENUM.value = sd.DataValue("tagname.NODENUM")
	end if
	if not sd.QualityGood("tagname.NODETYP") then
		GrpNODETYP.style.visibility = "Hidden"
	else
		GrpNODETYP.style.visibility = "Visible"
		param_NODETYP.value = sd.DataValue("tagname.NODETYP")
	end if
	if not sd.QualityGood("tagname.SLOTNUM") then
		GrpSLOTNUM.style.visibility = "Hidden"
	else
		GrpSLOTNUM.style.visibility = "Visible"
		param_SLOTNUM.value = sd.DataValue("tagname.SLOTNUM")
	end if
	if not sd.QualityGood("tagname.PVAUTO") then
		GrpPVAUTO.style.visibility = "Hidden"
	else
		GrpPVAUTO.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.FBTIME") then
		GrpFBTIME.style.visibility = "Hidden"
	else
		GrpFBTIME.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.CMDFALTM") then
		GrpCMDFALTM.style.visibility = "Hidden"
	else
		GrpCMDFALTM.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.SVTV") then
		GrpSVTV.style.visibility = "Hidden"
	else
		GrpSVTV.style.visibility = "Visible"
	end if

	if not sd.QualityGood("tagname.PNTFORM") then
		GrpPNTFORM.style.visibility = "Hidden"
	else
		GrpPNTFORM.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.STSMSG") then
		GrpSTSMSG.style.visibility = "Hidden"
	else
		GrpSTSMSG.style.visibility = "Visible"
	end if
	if not sd.QualityGood("tagname.PERIOD") then
		GrpPERIOD.style.visibility = "Hidden"
	else
		GrpPERIOD.style.visibility = "Visible"
	end if

	if bVisibilityUpdated = FALSE then
		GrpOverrides.style.visibility = "Inherit"
		GrpPointData.style.visibility = "Inherit"
		GrpGeneral.style.visibility = "Inherit"
		GrpPermissives.style.visibility = "Inherit"
		txtLoading.style.visibility = "Hidden"
	end if

	bVisibilityUpdated = TRUE
