<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="110px" height="30px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="JScript" id="9172239A-B727-4DE9-972D-726C5100A410"><![CDATA[function checkDashboardGlobalScripts()
{
        try 
        {
                if (isDashboardGlobalScriptLinked == true)
                {
                        return;
                }
        }
        catch (err){}

        var element_head=document.getElementsByTagName("HEAD")[0];
        if(element_head != null)
        {
                var scriptLink = document.createElement("script");
                scriptLink.language = "JScript";
        
                var systemSummaryPath = window.external.parent.FindFile("sysSystemSummary.htm");
                systemSummaryPath = systemSummaryPath.substr(0, systemSummaryPath.lastIndexOf("\\") + 1); 
                var scriptFilePath = systemSummaryPath + "/Scripts/DashboardScripts.js";

                scriptLink.src = scriptFilePath;
                element_head.appendChild(scriptLink);
        }
}

checkDashboardGlobalScripts();
DEFAULT_TEXT_COLOR = GetDefaultStatusColor();
OFF_TEXT_COLOR = GetOffStatusColor();]]></script></scripts><parameters><parameter name="AuxPoint" type="Point" description="" defaultvalue=""/><parameter name="" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="AuxStatus" type="Parameter" description="Automatically added Parameter" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=sysdspPath01 class=hvg.textbox.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 70%; FONT-FAMILY: Arial; WIDTH: 75.45%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 18.18%; TOP: 13.33%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:83;"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::AuxPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::StatusParam%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=background01 class="hvg.base.1 shapeBackground" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:transparent; fillColorBlink:False; FillStyle:1; Height:30; LineColor:transparent; lineColorBlink:False; Width:110"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=backgroundStatus01 class=hsc.image.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 53.33%; FONT-FAMILY: Arial; WIDTH: 63.63%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 30.9%; TOP: 46.66%; BEHAVIOR: url(#HDXVectorFactory#image)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Src:.\CompositePulloutMenu_files\blank.png;Width:70;" shapesrc=".\CompositePulloutMenu_files\blank.png"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=statustext01 class="hvg.textbox.1  HSC.ScriptDataObject.1 compMenuStatusText" style="FONT-SIZE: 7pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 36.66%; FONT-FAMILY: Arial-BoldMT; WIDTH: 49.09%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #303030; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 45.45%; TOP: 53.33%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:11;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;styleClass:compMenuStatusText;textColor:#303030;textColorBlink:False;TotalRotation:-1;Width:54;"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[ 		checkDashboardGlobalScripts();
        //check the sysdsp path
        if(typeof sysdspPath01 == "undefined")
        {
                return;
        }
        if (sysdspPath01.value.length == 0)
        {
                GetSysdspPath(sysdspPath01);
        }

        if (sysdspPath01.value.length == 0)
        {
                return;
        }

        var statusValue = statustext01.DataValue("AuxPoint.AuxStatus");

        var backgroundImagePath = sysdspPath01.value + "images\\";
        var iconImagePath = sysdspPath01.value + "images\\";
        var iconImageBlinkPath = sysdspPath01.value + "images\\";

		background01.className = "shapeBackground";

        if(statusValue == 0)
        {
                statustext01.value = "UNKNOWN";
        }
        else if(statusValue == 2)
        {
                statustext01.value = "DISABLED";
				background01.className = "shapeBackgroundOff";
        }
        else if(statusValue == 3)
        {
                statustext01.value = "FAIL";
        }
        else if(statusValue == 4)
        {
                statustext01.value = "MARGINAL";
        }
        else if(statusValue == 5)
        {
                statustext01.value = "OK";
        }
        else if(statusValue == 7)
        {
                statustext01.value = "TRANSIT";
        }
        else
        {
            if(statusValue == 1 || statusValue !== statusValue)
            {
                    label01.style.top = "2px";
                    label01.style.height = "28px";
                    label01.style.lineHeight = "12px";
					label01.style.wordWrap = "break-word";
                    statustext01.value = "";
                    backgroundImagePath += "blank.png";
                    iconImagePath += "blank.png";
                    backgroundStatus01.src = backgroundImagePath;
                    status01.src= iconImagePath;
					checkTextBoxOverflow(label01,"30px","2px","80px","28px", "center")
                    return;
            }
            else
            {
                    statustext01.value = statusValue.toUpperCase();
                    statusValue = ConvertStatusTextToNumber(statusValue);
            }
        }
        
		checkTextBoxOverflow(label01,"30px","2px","80px","14px", "center")

        var statusImages = DetermineStatusImages(statusValue);

        iconImagePath += statusImages.nonblinkIcon;
        iconImageBlinkPath += statusImages.blinkIcon;
        backgroundImagePath += statusImages.background;

        backgroundStatus01.src = backgroundImagePath;
        status01.src= iconImagePath;

        if(statusValue == 5 || statusValue == "OK" || statusValue == "BACKUP")
        {
                statustext01.style.color = "#808080";
                status01.style.visibility = "hidden";
                statustext01.style.left = "36px";
                statustext01.style.width = "75px";
        }
		else if(statusValue == 2)
		{
				statustext01.style.color = OFF_TEXT_COLOR;
                status01.style.visibility = "inherit";
                statustext01.style.left = "50px";
                statustext01.style.width = "54px";
		}
        else
        {       
                statustext01.style.color = DEFAULT_TEXT_COLOR;
                status01.style.visibility = "inherit";
                statustext01.style.left = "50px";
                statustext01.style.width = "54px";
        }

        if(statusValue == 0 || statusValue == 3)
        {
                statustext01.style.color = "#FFFFFF";
        }]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::AuxPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::AuxStatus%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=status01 class="hsc.image.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 53.33%; FONT-FAMILY: Arial; WIDTH: 14.54%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 30.9%; TOP: 46.66%; BEHAVIOR: url(#HDXVectorFactory#image) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:16;lineColorBlink:False;Src:.\CompositePulloutMenu_files\SSDUnknown.png;Width:16;" shapesrc=".\CompositePulloutMenu_files\SSDUnknown.png"></DIV>]]></content></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::auxpoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="Status,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=icon01 class="hsc.image.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 73.33%; FONT-FAMILY: Arial; WIDTH: 20%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 4.54%; TOP: 13.33%; BEHAVIOR: url(#HDXVectorFactory#image) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:22;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;Src:.\CompositePulloutMenu_files\icon.png;Width:22;" shapesrc=".\CompositePulloutMenu_files\icon.png"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
        if (sysdspPath01.value.length == 0)
        {
                GetSysdspPath(sysdspPath01);
        }

        if (sysdspPath01.value.length == 0)
        {
                return;
        }

        var imagePath = sysdspPath01.value + "images\\SystemDashboardImages\\";
        var pointType = icon01.DataValue("AuxPoint.PointType");
        var pointSubtype = icon01.DataValue("AuxPoint.PointSubtype");
        var itemNumber = icon01.DataValue("AuxPoint.ItemNumber");
        var redundant = icon01.DataValue("AuxPoint.IsRedundant");

        var imageFileName = DetermineGraphicIconFile(pointType, pointSubtype, itemNumber, redundant);
        icon01.src = imagePath + imageFileName;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::auxpoint%},{%point::auxpoint%},{%point::auxpoint%},{%point::auxpoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PointType,PointSubType,ItemNumber,IsRedundant,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,32767,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=label01 class="hvg.textbox.1 HSC.ScriptDataObject.1 shapeTitle shapeTitle" style="FONT-SIZE: 11px; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 43.33%; FONT-FAMILY: Arial Narrow; WIDTH: 72.72%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #c0c0c0; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 27.27%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:13;lineColorBlink:False;LineStyle:0;styleClass:shapeTitle;textColor:#C0C0C0;textColorBlink:False;TotalRotation:-1;Width:80;"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[        if(label01.value == "")
        {
				label01.title = label01.DataValue("AuxPoint.ItemName");
                label01.value = label01.DataValue("AuxPoint.ItemName");
        }]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::AuxPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="ItemName,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=alarmstate01 title="Bad Quality, Urgent, Active, Acknowledged" class="hsc.alarmstate.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 73.33%; FONT-FAMILY: Arial; WIDTH: 20%; WHITE-SPACE: nowrap; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 4.54%; TOP: 13.33%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="acknowledged:True;HDXBINDINGID:-4;priority:3;quality:0;rtn:False;showDisableIcon:false;showTooltip:true;staticIcon:False;" objecttype="6"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
        var pointAlmState = TransformAlarmState(alarmstate01.DataValue("AuxPoint.AlarmFlags"));
        
        // Hide icon graphics if there is alarm to display
        if ((pointAlmState & (ALARMPRIORITY_MASK|ALARM_SHELVED|ALARM_SUPPRESSED|ALARM_ACK_REQ)) > 0)
        {
                icon01.style.visibility = "hidden";
        }
        else
        {
                icon01.style.visibility = "inherit";
        }

        alarmstate01.AlarmState = pointAlmState;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::auxpoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="AlarmFlags,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Null%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NAME"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="hsc.alarmstate" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectSelectionBox class="hvg.base.1 compSelectBorder" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect); VISIBILITY: hidden" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:30;LineColor:transparent;lineColorBlink:False;styleClass:compSelectBorder;Width:110;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=faceplateLink class="hvg.base.1 HSC.ScriptDataObject.1 dashboardLink" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect) url(#BindingBehavior) url(#HSCScriptDataBehavior); VISIBILITY: inherit" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:30;LineColor:transparent;lineColorBlink:False;Width:110;"></DIV>]]></content><scripts><script event="onclick" language="JScript"><![CDATA[SelectCompNode(faceplateLink.DataValue("AuxPoint.FullItemName"),faceplateLink,rectSelectionBox);]]></script><script event="onpropertychange" language="JScript"><![CDATA[if (this.selected == "false")
	{
		checkDashboardGlobalScripts();
		DeselectCompNode(rectSelectionBox);
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::AuxPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="FullItemName,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="32767,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=dashboardLink class="hvg.base.1 HSC.ScriptDataObject.1 dashboardLink" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect) url(#BindingBehavior) url(#HSCScriptDataBehavior); VISIBILITY: visible" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:30;LineColor:transparent;lineColorBlink:False;Width:110;"></DIV>]]></content><scripts><script event="onclick" language="JScript"><![CDATA[    var dashboardAlmGrpFullItemName = dashboardLink.DataValue("AuxPoint.FullItemName");
    NavigateToDashboard(dashboardAlmGrpFullItemName);
    window.event.cancelBubble = true;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::AuxPoint%},{%Point::AuxPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="FullItemName,DashboardDisplay,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="32767,32767,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaDashboardDisplay class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 0%; FONT-FAMILY: Arial; WIDTH: 0%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[if(alphaDashboardDisplay.value != "NaN")
    {
            dashboardLink.style.visibility = "inherit";
    }
    else
	{
            dashboardLink.style.visibility = "hidden";
    }]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::AuxPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="DashboardDisplay"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group001 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 30px; WIDTH: 110px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False; Height:30; lineColorBlink:False; Width:110"></DIV>]]></content></html></group></shape></shapes></shapefile>