<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="80px" height="70px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="JScript" id="3EA950A4-9FBD-4018-90FD-455EE400B4D6"><![CDATA[function checkDashboardGlobalScripts()
{
	try 
	{
		if (isDashboardGlobalScriptLinked == true)
		{
			return;
		}
	}
	catch (err){}

	var element_head=document.getElementsByTagName("HEAD")[0];
	if(element_head != null)
	{
		var scriptLink = document.createElement("script");
		scriptLink.language = "JScript";
	
		var systemSummaryPath = window.external.parent.FindFile("sysSystemSummary.htm");
		systemSummaryPath = systemSummaryPath.substr(0, systemSummaryPath.lastIndexOf("\\") + 1); 
		var scriptFilePath = systemSummaryPath + "/Scripts/DashboardScripts.js";

		scriptLink.src = scriptFilePath;
		element_head.appendChild(scriptLink);
	}
}

checkDashboardGlobalScripts();]]></script></scripts><parameters><parameter name="PrimaryPoint" type="Point" description="" defaultvalue=""/><parameter name="Label" type="Value" description="" defaultvalue=""/><parameter name="SecondaryPoint1" type="Point" description="" defaultvalue=""/><parameter name="SecondaryPoint2" type="Point" description="" defaultvalue=""/><parameter name="SecondaryPoint3" type="Point" description="" defaultvalue=""/><parameter name="SecondaryPoint4" type="Point" description="" defaultvalue=""/><parameter name="SecondaryPoint5" type="Point" description="" defaultvalue=""/><parameter name="SecondaryPoint6" type="Point" description="" defaultvalue=""/><parameter name="ExcludeFromAlarmGroup" type="Value" description="" defaultvalue="no"/><parameter name="ShapeTileName" type="Value" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectSpacer class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect); VISIBILITY: inherit" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:70;LineColor:transparent;lineColorBlink:False;Width:80;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=shapeOutline class="hvg.base.1 shapeOutline" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 85.71%; FONT-FAMILY: Arial; WIDTH: 75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 12.5%; TOP: 7.14%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="styleClass:shapeOutline;FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:60;LineColor:transparent;lineColorBlink:False;Width:60;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=sysdspPath class=hvg.textbox.1 style="FONT-SIZE: 8pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 15.71%; FONT-FAMILY: Arial; WIDTH: 37.5%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 31.25%; TOP: 67.14%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:11;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:30;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rectSelectionBox class="hvg.base.1 shapeSelectionBox" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 85.71%; FONT-FAMILY: Arial; WIDTH: 75%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 12.5%; TOP: 7.14%; BEHAVIOR: url(#HDXVectorFactory#rect) url(#BindingBehavior); VISIBILITY: hidden" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:60;LineColor:#1782e5;lineColorBlink:False;LineWidth:2;styleClass:shapeSelectionBox;Width:60;" SHORTCUTMENUCUSTOM="0"></DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=alarmStateIcon title="Bad Quality, Urgent, Active, Acknowledged" class="hsc.alarmstate.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 31.42%; FONT-FAMILY: Arial; WIDTH: 27.5%; WHITE-SPACE: nowrap; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 35%; TOP: 50%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior) url(#HSCScriptDataBehavior)" hdxproperties="acknowledged:True;HDXBINDINGID:-4;priority:3;quality:0;rtn:False;showDisableIcon:False;showJournalOnlyIcon:False;showTooltip:True;sizeableIcon:False;staticIcon:False;" ObjectType="6"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	// At least one alarm state changed in the script data point params for the alarm state icon
	var mostImportantState = 0;
	var secondaryAlmState = 0;

	// aggregate alarm state of primary and secondary points
	var primaryAlmState = TransformAlarmState(alarmStateIcon.DataValue("PrimaryPoint.AlarmFlags"));
	mostImportantState = primaryAlmState;

	if ("{%Point::SecondaryPoint1%}".length > 0)
	{
		secondaryAlmState = TransformAlarmState(alarmStateIcon.DataValue("SecondaryPoint1.AlarmFlags"));
		mostImportantState = AggregateAlarmState(mostImportantState, secondaryAlmState);
	}
	if ("{%Point::SecondaryPoint2%}".length > 0)
	{
		secondaryAlmState = TransformAlarmState(alarmStateIcon.DataValue("SecondaryPoint2.AlarmFlags"));
		mostImportantState = AggregateAlarmState(mostImportantState, secondaryAlmState);
	}
	if ("{%Point::SecondaryPoint3%}".length > 0)
	{
		secondaryAlmState = TransformAlarmState(alarmStateIcon.DataValue("SecondaryPoint3.AlarmFlags"));
		mostImportantState = AggregateAlarmState(mostImportantState, secondaryAlmState);
	}
	if ("{%Point::SecondaryPoint4%}".length > 0)
	{
		secondaryAlmState = TransformAlarmState(alarmStateIcon.DataValue("SecondaryPoint4.AlarmFlags"));
		mostImportantState = AggregateAlarmState(mostImportantState, secondaryAlmState);
	}
	if ("{%Point::SecondaryPoint5%}".length > 0)
	{
		secondaryAlmState = TransformAlarmState(alarmStateIcon.DataValue("SecondaryPoint5.AlarmFlags"));
		mostImportantState = AggregateAlarmState(mostImportantState, secondaryAlmState);
	}
	if ("{%Point::SecondaryPoint6%}".length > 0)
	{
		secondaryAlmState = TransformAlarmState(alarmStateIcon.DataValue("SecondaryPoint6.AlarmFlags"));
		mostImportantState = AggregateAlarmState(mostImportantState, secondaryAlmState);
	}

	// Hide icon graphics if there is alarm to display
	if ((mostImportantState & (ALARMPRIORITY_MASK|ALARM_SHELVED|ALARM_SUPPRESSED|ALARM_ACK_REQ)) > 0)
	{
		graphicsIcon.style.visibility = "hidden";
	}
	else
	{
		graphicsIcon.style.visibility = "visible";
	}

	alarmStateIcon.AlarmState = mostImportantState;]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="NAME"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::primarypoint%},{%point::secondarypoint1%},{%point::secondarypoint2%},{%point::secondarypoint3%},{%point::secondarypoint4%},{%point::secondarypoint5%},{%point::secondarypoint6%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="AlarmFlags,AlarmFlags,AlarmFlags,AlarmFlags,AlarmFlags,AlarmFlags,AlarmFlags,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,,,,"/></dataobjectdef></dataobject><class ID="hsc.alarmstate" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=graphicsIcon class="hsc.image.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 34.28%; FONT-FAMILY: Arial; WIDTH: 30%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 33.75%; TOP: 48.57%; BEHAVIOR: url(#HDXVectorFactory#image) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:24;lineColorBlink:False;Src:.\StatusShapeDefault_files\icon.png;Width:24;" shapesrc=".\StatusShapeDefault_files\icon.png"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	if (sysdspPath.value.length == 0)
	{
		GetSysdspPath(sysdspPath);
	}

	if (sysdspPath.value.length == 0)
	{
		return;
	}

	var imagePath = sysdspPath.value + "images\\SystemDashboardImages\\";
	var pointType = 0;
	var pointSubtype = 0;
	var itemNumber = 0;
	var redundant = 0;
	
	pointType = graphicsIcon.DataValue("PrimaryPoint.PointType");
	pointSubtype = graphicsIcon.DataValue("PrimaryPoint.PointSubtype");
	itemNumber = graphicsIcon.DataValue("PrimaryPoint.ItemNumber");
	redundant = graphicsIcon.DataValue("PrimaryPoint.IsRedundant");

	var imageFileName = DetermineGraphicIconFile(pointType, pointSubtype, itemNumber, redundant);
	graphicsIcon.src = imagePath + imageFileName;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::primarypoint%},{%point::primarypoint%},{%point::primarypoint%},{%point::primarypoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PointType,PointSubType,ItemNumber,IsRedundant,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="32767,32767,32767,32767,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtName class="hvg.textbox.1 HSC.ScriptDataObject.1 shapeLabel" style="FONT-SIZE: 8pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 21.43%; FONT-FAMILY: Arial; WIDTH: 65%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 17.5%; TOP: 17.14%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:15;lineColorBlink:False;LineStyle:0;styleClass:shapeLabel;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:58;" SHORTCUTMENUCUSTOM="0"></DIV>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	// shape initialization
	if (("{%Point::SecondaryPoint1%}".length > 0) ||
		("{%Point::SecondaryPoint2%}".length > 0) ||
		("{%Point::SecondaryPoint3%}".length > 0) ||
		("{%Point::SecondaryPoint4%}".length > 0) ||
		("{%Point::SecondaryPoint5%}".length > 0) ||
		("{%Point::SecondaryPoint6%}".length > 0))
	{
		btnCompositeTab.style.visibility = "inherit";
	}
	else
	{
		btnCompositeTab.style.visibility = "hidden";
	}

	// re-center alarm icon in case the overall shape is resized
	var newLeft = alarmStateIcon.parentElement.clientWidth/2 - 11;
	var newTop = Math.round(alarmStateIcon.parentElement.clientHeight * 0.65 - 11);
	alarmStateIcon.style.top = "" + newTop + "px";
	alarmStateIcon.style.left = "" + newLeft + "px";

	// end of shape initialization
	var displayText = "";
	var labelText = "{%Value::Label%}";
	// Use Label if defined. Otherwise use the item name of the Primary Point
	if (labelText.length > 0)
	{
		displayText = labelText;
	}
	else
	{
		displayText = txtName.DataValue("PrimaryPoint.ItemName");
	}
	
	tooltipRect.title =  displayText;
	txtName.value = displayText;
	
	// check if txtName needs to be expanded to two lines
	setTimeout(function(){checkTextBoxOverflow(txtName, "17.5%", "7.14%", "65%", "42.85%"); }, 0);
	
	//check the sysdsp path
	if (sysdspPath.value.length == 0)
	{
		GetSysdspPath(sysdspPath);
	}]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::primarypoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="ItemName,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="32767,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=statusIcon class="hsc.image.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 22.85%; FONT-FAMILY: Arial; WIDTH: 20%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 18.75%; TOP: 64.29%; BEHAVIOR: url(#HDXVectorFactory#image) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:16;lineColorBlink:False;Src:.\StatusShapeDefault_files\blank.png;Width:16;" shapesrc=".\StatusShapeDefault_files\blank.png"></DIV>]]></content><scripts><script event="ondatachange" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	//check the sysdsp path
	if (sysdspPath.value.length == 0)
	{
		GetSysdspPath(sysdspPath);
	}

	if (sysdspPath.value.length == 0)
	{
		return;
	}

	var imagePath = sysdspPath.value + "images\\";
	var mostImportantStatus = 0;
	var primaryStatus = 1;
	var secondaryStatus = 1;

	try
	{
		primaryStatus = statusIcon.DataValue("PrimaryPoint.Status");
	
		// aggregate status of primary and secondary points
		mostImportantStatus = primaryStatus;

		if ((!mostImportantStatus) || isNaN(mostImportantStatus) )
			mostImportantStatus = 1;

		if ("{%Point::SecondaryPoint1%}".length > 0)
		{
			mostImportantStatus = AggregateStatus(mostImportantStatus, statusIcon.DataValue("SecondaryPoint1.Status"));
		}
		if ("{%Point::SecondaryPoint2%}".length > 0)
		{
			mostImportantStatus = AggregateStatus(mostImportantStatus, statusIcon.DataValue("SecondaryPoint2.Status"));
		}
		if ("{%Point::SecondaryPoint3%}".length > 0)
		{
			mostImportantStatus = AggregateStatus(mostImportantStatus, statusIcon.DataValue("SecondaryPoint3.Status"));
		}
		if ("{%Point::SecondaryPoint4%}".length > 0)
		{
			mostImportantStatus = AggregateStatus(mostImportantStatus, statusIcon.DataValue("SecondaryPoint4.Status"));
		}
		if ("{%Point::SecondaryPoint5%}".length > 0)
		{
			mostImportantStatus = AggregateStatus(mostImportantStatus, statusIcon.DataValue("SecondaryPoint5.Status"));
		}
		if ("{%Point::SecondaryPoint6%}".length > 0)
		{
			mostImportantStatus = AggregateStatus(mostImportantStatus, statusIcon.DataValue("SecondaryPoint6.Status"));
		}

	}
	catch (err)
	{
	}



	if (mostImportantStatus == 1)
	{
		imagePath += "blank.png";
	}
	else if (mostImportantStatus == 2)
	{
		imagePath += "SSDDisabled.png";
	}
	else if (mostImportantStatus == 3)
	{
		imagePath += "SSDFailed.png";
	}
	else if (mostImportantStatus == 4)
	{
		imagePath += "SSDMarginal.png";
	}
	else if (mostImportantStatus == 5)
	{
		imagePath += "SSDOK.png";
	}
	else if (mostImportantStatus == 6)
	{
		imagePath += "SSDSimulation.png";
	}
	else
	{
		imagePath += "SSDUnknown.png";
	}

	statusIcon.src= imagePath;]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::primarypoint%},{%point::secondarypoint1%},{%point::secondarypoint2%},{%point::secondarypoint3%},{%point::secondarypoint4%},{%point::secondarypoint5%},{%point::secondarypoint6%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="Status,Status,Status,Status,Status,Status,Status,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,,,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtDisplayName class="hvg.textbox.1 shapeLabel" style="FONT-SIZE: 8pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 21.42%; FONT-FAMILY: Arial; WIDTH: 72.5%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 13.75%; TOP: 17.14%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:15;lineColorBlink:False;LineStyle:0;styleClass:shapeLabel;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:58;">{%Value::ShapeTileName%}</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=tooltipRect class="hvg.base.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 88.57%; FONT-FAMILY: Arial; WIDTH: 77.5%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 11.25%; TOP: 5.71%; BEHAVIOR: url(#HDXVectorFactory#rect) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:62;LineColor:transparent;lineColorBlink:False;Width:62;" SHORTCUTMENUCUSTOM="1" selected="False" SHORTCUTMENUFILE="sysdashboard_sm.xml"></DIV>]]></content><scripts><script event="onpropertychange" language="JScript"><![CDATA[if (this.selected == "false")
	{
		checkDashboardGlobalScripts();
		DeselectShape(rectSelectionBox);
	}]]></script><script event="onclick" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	window.event.cancelBubble = true;
	var locationFilterString = "";
	var fullItemName = String(tooltipRect.DataValue("PrimaryPoint.FullItemName"));
	if ((fullItemName.length > 0) && (fullItemName != "NaN"))
		locationFilterString += fullItemName + ";";

	if ("{%Point::SecondaryPoint1%}".length > 0)
	{
		fullItemName = String(tooltipRect.DataValue("SecondaryPoint1.FullItemName"));
		if ((fullItemName.length > 0) && (fullItemName != "NaN"))
			locationFilterString += fullItemName + ";";
	}
	if ("{%Point::SecondaryPoint2%}".length > 0)
	{
		fullItemName = String(tooltipRect.DataValue("SecondaryPoint2.FullItemName"));
		if ((fullItemName.length > 0) && (fullItemName != "NaN"))
			locationFilterString += fullItemName + ";";
	}
	if ("{%Point::SecondaryPoint3%}".length > 0)
	{
		fullItemName = String(tooltipRect.DataValue("SecondaryPoint3.FullItemName"));
		if ((fullItemName.length > 0) && (fullItemName != "NaN"))
			locationFilterString += fullItemName + ";";
	}
	if ("{%Point::SecondaryPoint4%}".length > 0)
	{
		fullItemName = String(tooltipRect.DataValue("SecondaryPoint4.FullItemName"));
		if ((fullItemName.length > 0) && (fullItemName != "NaN"))
			locationFilterString += fullItemName + ";";
	}
	if ("{%Point::SecondaryPoint5%}".length > 0)
	{
		fullItemName = String(tooltipRect.DataValue("SecondaryPoint5.FullItemName"));
		if ((fullItemName.length > 0) && (fullItemName != "NaN"))
			locationFilterString += fullItemName + ";";
	}
	if ("{%Point::SecondaryPoint6%}".length > 0)
	{
		fullItemName = String(tooltipRect.DataValue("SecondaryPoint6.FullItemName"));
		if ((fullItemName.length > 0) && (fullItemName != "NaN"))
			locationFilterString += fullItemName + ";";
	}

	SelectShape(tooltipRect, rectSelectionBox, locationFilterString.slice(0, -1));]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::primarypoint%},{%point::secondarypoint1%},{%point::secondarypoint2%},{%point::secondarypoint3%},{%point::secondarypoint4%},{%point::secondarypoint5%},{%point::secondarypoint6%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="FullItemName,FullItemName,FullItemName,FullItemName,FullItemName,FullItemName,FullItemName,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,1,1,1,1,1,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="32767,32767,32767,32767,32767,32767,32767,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,,,,"/></dataobjectdef></dataobject><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="32767"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::PrimaryPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="NAME"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=btnCompositeTab class="hvg.base.1 shapeCompositeTab" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 35.71%; FONT-FAMILY: Arial; WIDTH: 31.25%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 56.25%; TOP: 57.14%; BEHAVIOR: url(#HDXVectorFactory#polygon)" hdxproperties="styleClass:shapeCompositeTab;FillColor:#808080;fillColorBlink:False;Height:25;LineColor:transparent;lineColorBlink:False;points:100.000000 10.000000 100.000000 100.000000 10.000000 100.000000 ;Width:25;" selected="False"></DIV>]]></content><scripts><script event="onclick" language="JScript"><![CDATA[checkDashboardGlobalScripts();
	if (btnCompositeTab.selected == "true")
	{
		HideCompositeMenu();
		btnCompositeTab.selected = "false";
	}
	else
	{
		var strPointList = "";
		if ("{%Point::PrimaryPoint%}".length > 0)
			strPointList += "{%Point::PrimaryPoint%}" + ";" ;
		if ("{%Point::SecondaryPoint1%}".length > 0)
			strPointList += "{%Point::SecondaryPoint1%}" + ";" ;
		if ("{%Point::SecondaryPoint2%}".length > 0)
			strPointList += "{%Point::SecondaryPoint2%}" + ";" ;
		if ("{%Point::SecondaryPoint3%}".length > 0)
			strPointList += "{%Point::SecondaryPoint3%}" + ";" ;
		if ("{%Point::SecondaryPoint4%}".length > 0)
			strPointList += "{%Point::SecondaryPoint4%}" + ";" ;
		if ("{%Point::SecondaryPoint5%}".length > 0)
			strPointList += "{%Point::SecondaryPoint5%}" + ";" ;
		if ("{%Point::SecondaryPoint6%}".length > 0)
			strPointList += "{%Point::SecondaryPoint6%}" + ";" ;
		
		SetCompositeMenuBindings(strPointList);
		ShowCompositeMenu(btnCompositeTab);
		btnCompositeTab.selected = "true";
	}

	window.event.cancelBubble = true;]]></script></scripts></html></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group001 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 70px; WIDTH: 80px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:70;lineColorBlink:False;Width:80;"></DIV>]]></content></html></group></shape></shapes></shapefile>