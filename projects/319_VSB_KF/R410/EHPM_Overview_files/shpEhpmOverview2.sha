<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 19.09%; FONT-FAMILY: Arial; HEIGHT: 6.66%; VISIBILITY: visible; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; BEHAVIOR: url(#HDXVectorFactory#text); TOP: 5.18%; LEFT: 54.93%" id=txtCurrent_Temp004 class="hvg.textbox.1 " tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:18;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:89;">EUCN CPU</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: right; BACKGROUND-COLOR: transparent; BORDER-LEFT-STYLE: none; WIDTH: 13.73%; FONT-FAMILY: Arial; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 7.77%; VISIBILITY: visible; COLOR: black; BORDER-RIGHT-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); TOP: 4.81%; LEFT: 84.76%; ROWS: 1" id=alpCPU_free002 class="hsc.alpha.1 Readonly_Alpha_RightAlign_Style" title="" tabIndex=0 hdxproperties="durationFormat:-1;fillColor:Transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:6;numericDisplayFormat:%.0f;styleClass:Readonly_Alpha_RightAlign_Style;textColor:Black;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="16"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::myPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="CPUFREEAVG"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: center; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; BORDER-LEFT-STYLE: none; WIDTH: 7.29%; FONT-FAMILY: Arial; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 4.44%; VISIBILITY: hidden; COLOR: #dc143c; BORDER-RIGHT-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; FONT-WEIGHT: bold; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); TOP: 23.33%; LEFT: 52.36%; ROWS: 1" id=sd class="hsc.alpha.1 HSC.ScriptDataObject.1" tabIndex=0 hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;numberOfChars:9;numericDisplayFormat:%.0f;textColor:#dc143c;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[dim sFirstNum, sSecondNum

	if me.QualityGood("mypoint.UCNNW") and me.QualityGood("mypoint.HPMNODENO") then
		if me.DataValue("mypoint.UCNNW") < 10 then
			sFirstNum = "0" & me.DataValue("mypoint.UCNNW")
		else
			sFirstNum = me.DataValue("mypoint.UCNNW")
		end if
		if me.DataValue("mypoint.HPMNODENO") < 10 then
			sSecondNum = "0" & me.DataValue("mypoint.HPMNODENO")
		else
			sSecondNum = me.DataValue("mypoint.HPMNODENO")
		end if

		sBoxPointName = "$NM" & sFirstNum & "B" & sSecondNum
		window.external.parent.logmessage "sBoxPointName is: >>" & sBoxPointName & "<<"
		window.external.parent.logmessage "OnDataChange - calling initial UpdatePage"

		shpAvgValues.SetCustomProperty "point", "boxpoint", sBoxPointName
		shpAvgValues.ReloadContent
		shpAvgValues.autoReloadContent = TRUE
		window.external.parent.logmessage "Update Values DONE!"
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value=""/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::myPoint%},{%Point::myPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="UCNNW,HPMNODENO,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="32767,32767,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><group><group><element>