0;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[if (!customalpha7.firstUpdateReceived){
		switch(customalpha7.Binding.DataObjects.Item(0).ValueType) {
		case DT_INT2:
