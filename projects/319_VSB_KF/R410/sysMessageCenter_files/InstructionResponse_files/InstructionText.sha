<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="240px" height="200px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><scripts><script event="" language="JScript" id="F2956D8E-0997-4A5D-92C4-DE3321D0F3CD"><![CDATA[// global instruction text shape functions
function InitializeCustomBindingAlphas(bindingTargets, customAlphaList) {
	if (!bindingTargets){
		return;
	}
	
	for (var i = 0; i < Math.min(bindingTargets.length, customAlphaList.length); ++i) {
		var bindingTarget = bindingTargets[i];
		if (!bindingTarget.point || !bindingTarget.param || !bindingTarget.placeholder || (bindingTarget.decimals == null)) {
			window.external.application.logMessage("InstructionText: bindingTargets[" + i + "] is not valid");
			continue;
		}
		var spanParent = document.getElementById(bindingTarget.placeholder);
		if (!spanParent) {
			window.external.application.logMessage("InstructionText: spanParent with id:" + bindingTarget.placeholder + " not found");
			continue;
		}
		// move the alpha in the dom
		spanParent.appendChild(customAlphaList[i].numeric);
		spanParent.appendChild(customAlphaList[i].enumerate);
		customAlphaList[i].enumerate.firstUpdateReceived = false;
		customAlphaList[i].numeric.firstUpdateReceived = false;
		
		// format the alpha
		var decimalFormatter = "";
		switch (bindingTarget.decimals) {
		case 0:
		case 1:
		case 2:
		case 3:
		case 4:
			decimalFormatter = "%." + bindingTarget.decimals + "f";
			break;
		default:
			decimalFormatter = "%.2f";
			break;
		}
		customAlphaList[i].numeric.numericDisplayFormat = decimalFormatter;		
		customAlphaList[i].numeric.style.whiteSpace = "nowrap";
		customAlphaList[i].numeric.indicateBadState = false;
		
	}
	
	PositionCustomBindingAlphas(bindingTargets, customAlphaList);
}

// throttled alpha reposition function
var repositionThrottleTimer = null;
function PositionCustomBindingAlphas(bindingTargets, customAlphaList) {
	if (repositionThrottleTimer) {
		return;
	}
	// throttle to max 5 reposition of alpha per second
	repositionThrottleTimer = setTimeout(function() {
		PositionCustomBindingAlphasDelayed(bindingTargets, customAlphaList);
		repositionThrottleTimer = null;
	}, 200);
}

function PositionCustomBindingAlphasDelayed(bindingTargets, customAlphaList) {
	if (!bindingTargets){
		return;
	}
	for (var i = 0; i < Math.min(bindingTargets.length, customAlphaList.length); ++i) {
		var bindingTarget = bindingTargets[i];
		if (!bindingTarget.placeholder) {
			continue;
		}
		var spanParent = document.getElementById(bindingTarget.placeholder);
		if (!spanParent) {
			continue;
		}
		customAlphaList[i].numeric.style.width = spanParent.offsetWidth + "px";
		customAlphaList[i].numeric.style.height = (spanParent.offsetHeight - 1) + "px";
		customAlphaList[i].numeric.style.left = (spanParent.offsetLeft + 1) + "px";
		customAlphaList[i].numeric.style.top = (spanParent.offsetTop - 1) + "px";
		customAlphaList[i].enumerate.style.width = spanParent.offsetWidth + "px";
		customAlphaList[i].enumerate.style.height = (spanParent.offsetHeight - 1) + "px";
		customAlphaList[i].enumerate.style.left = (spanParent.offsetLeft + 1) + "px";
		customAlphaList[i].enumerate.style.top = (spanParent.offsetTop - 1) + "px";
		
	}
}

var DT_INT2 = 2;
var DT_INT4 = 3;
var DT_REAL = 4;
var DT_DBLE = 5;
var DT_INT8 = 15;
]]></script><script event="onshapeload" language="JScript" id=""><![CDATA[// remove vertical size restriction to enable scrollbar
	instructionTextElem.parentElement.style.overflow = "hidden";
	instructionTextElem.style.height = null;

	var bindingTargets = instructionTextElem.parentElement.parentElement.parentElement.customBindingTargets;
	var customAlphaList = [	{numeric: customalpha1, enumerate: customenum1}, 
							{numeric: customalpha2, enumerate: customenum2}, 
							{numeric: customalpha3, enumerate: customenum3},
							{numeric: customalpha4, enumerate: customenum4},
							{numeric: customalpha5, enumerate: customenum5},
							{numeric: customalpha6, enumerate: customenum6},
							{numeric: customalpha7, enumerate: customenum7},
							{numeric: customalpha8, enumerate: customenum8}];
	
	// get the instruction text string from shape's parent
	var instructionTextString = instructionTextElem.parentElement.parentElement.parentElement.instructionTextString;
	if ((typeof(instructionTextString) != 'string') || (instructionTextString.length == 0)) {
		return;
	}
	instructionTextElem.innerHTML = instructionTextString;

	// Resize the instruction text area
	// This is done in setTimeout to allow the instruction text innerHTML to be parsed, 
	// new DOM elements created and laid out correctly before resizing everything according to the instruction text.
	setTimeout(function() {
		var MAX_INSTRUCTION_TEXT_HEIGHT = 300;
		var newHeight = Math.min(MAX_INSTRUCTION_TEXT_HEIGHT, instructionTextElem.clientHeight);
		instructionTextElem.parentElement.style.height = newHeight.toString() + "px";
		instructionTextElem.parentElement.parentElement.style.height = newHeight.toString() + "px";

		// Once the instruction area size has been set, allow it to be rendered, then 
		// resize the whole instruction response shape accordingly
		setTimeout(function() {
			if (instructionTextElem.parentElement.parentElement.parentElement.OnResize) {
				instructionTextElem.parentElement.parentElement.parentElement.OnResize();
			}
			
			// setup the custom scrollbar only if it is necessary
			instructionTextElem.parentElement.classList.remove("instruction-response-shape-text-with-scrollbar");
			if (instructionTextElem.clientHeight > MAX_INSTRUCTION_TEXT_HEIGHT) {
				setTimeout(function() {
					var elNC = document.getElementsByTagName("hn-notification-center")[0];
					if (elNC && elNC.applyCustomScrollbar) {
						instructionTextElem.parentElement.classList.add("instruction-response-shape-text-with-scrollbar");
						elNC.applyCustomScrollbar(instructionTextElem.parentElement, instructionTextElem.clientHeight);
					}
					// once scrollbar is set, position the live value alphas
					setTimeout(function() {
						InitializeCustomBindingAlphas(bindingTargets, customAlphaList);
					}, 0);
				}, 0);
			} else {
				// if we don't need a scrollbar, position the live value alphas now
				InitializeCustomBindingAlphas(bindingTargets, customAlphaList);
			}
		}, 0);
	}, 0);
	
	instructionTextElem.parentElement.parentElement.parentElement.parentElement.RepositionLiveValueAlphas = function() {
		PositionCustomBindingAlphas(bindingTargets, customAlphaList);
	};]]></script></scripts><parameters><parameter name="CUSTOM1POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOM1PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOM2POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOM2PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOM3POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOM3PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOM4POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOM4PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOM5POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOM5PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOM6POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOM6PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOM7POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOM7PARAM" type="Parameter" description="" defaultvalue=""/><parameter name="CUSTOM8POINT" type="Point" description="" defaultvalue=""/><parameter name="CUSTOM8PARAM" type="Parameter" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=customalpha1 class="hsc.alpha.1 instruction-response-live-value-alpha" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 12%; FONT-FAMILY: Arial; WIDTH: 50%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; WHITESPACE: TEXT-DECORATION: none; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateBadState:-1;lineColor:black;lineColorBlink:False;numberOfChars:40;numericDisplayFormat:%.2f;styleClass:instruction-response-live-value-alpha;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[if (!customalpha1.firstUpdateReceived){
		switch(customalpha1.Binding.DataObjects.Item(0).ValueType) {
		case DT_INT2:
		case DT_INT4:
		case DT_REAL:
		case DT_DBLE:
		case DT_INT8:
			customalpha1.style.textAlign = "right";
			break;
		default:
			customalpha1.style.textAlign = "center";
			break;
		}
		customalpha1.firstUpdateReceived = true;
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CUSTOM1POINT%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::CUSTOM1PARAM%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=customalpha2 class="hsc.alpha.1 instruction-response-live-value-alpha" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 12%; FONT-FAMILY: Arial; WIDTH: 50%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 12.5%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateBadState:-1;lineColor:black;lineColorBlink:False;numberOfChars:40;numericDisplayFormat:%.2f;styleClass:instruction-response-live-value-alpha;textColor:#000