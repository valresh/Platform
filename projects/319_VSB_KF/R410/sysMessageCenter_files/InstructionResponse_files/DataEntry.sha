<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="200px" height="52px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><scripts><script event="onshapeload" language="JScript" id=""><![CDATA[	// update label text
	txtLabel.value= txtLabel.parentElement.parentElement.GetCustomProperty("Value", "LABEL");
	// decide if unit should be shown
	if ((txtLabel.parentElement.parentElement.GetCustomProperty("Point","EUDESCPOINT") != "") && 
	    (txtLabel.parentElement.parentElement.GetCustomProperty("Parameter","EUDESCPARAM") != "")) {
		alphaUnit.style.visibility = "inherit";
	} else {
		alphaUnit.style.visibility = "hidden";
	}
	// decide if the writable field should be shown
	if ((txtLabel.parentElement.parentElement.GetCustomProperty("Point","VALPOINT") == "") || 
	    (txtLabel.parentElement.parentElement.GetCustomProperty("Parameter","VALPARAM") == "")) {
		grpWritable.style.visibility = "hidden";
	}]]></script></scripts><parameters><parameter name="LABEL" type="Value" description="" defaultvalue=""/><parameter name="VALPOINT" type="Point" description="" defaultvalue=""/><parameter name="VALPARAM" type="Parameter" description="" defaultvalue=""/><parameter name="EUDESCPOINT" type="Point" description="" defaultvalue=""/><parameter name="EUDESCPARAM" type="Parameter" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtLabel class="hvg.textbox.1 instruction-response-data-entry-label" style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 48.07%; FONT-FAMILY: Arial; WIDTH: 90%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:25;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:180;styleClass:instruction-response-data-entry-label;">Label 
<P>&nbsp;</P>
<P></P></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaUnit class="hsc.alpha.1 instruction-response-data-entry-unit" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 48.07%; FONT-FAMILY: Arial; WIDTH: 35%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 65%; TOP: 48.07%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:7;numericDisplayFormat:%s;styleClass:instruction-response-data-entry-unit;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::EUDESCPOINT%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::EUDESCPARAM%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alphaWritable class="hsc.alpha.1 instruction-response-data-entry-alpha" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 96.15%; FONT-FAMILY: Arial; WIDTH: 99.2%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:24;numericDisplayFormat:%.2f;styleClass:instruction-response-data-entry-alpha;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::VALPOINT%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::VALPARAM%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN tabIndex=0 id=cboWritable class="hsc.combo.1 instruction-response-data-entry-combobox" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 96.15%; FONT-FAMILY: Arial; WIDTH: 99.2%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: white; TEXT-INDENT: 2px" hdxproperties="borderStyle:inset;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;styleClass:instruction-response-data-entry-combobox;textColor:#000000;textColorBlink:False;">Combobox</SPAN>]]></content><scripts><script event="onupdate" language="JScript"><![CDATA[var enumType = 8;
	var bIsEnum = false;

	try {
		bIsEnum = (cboWritable.Binding.DataObjects.Item(0).ValueType == enumType);
	} catch (err) {	}

	if (bIsEnum) {
	    cboWritable.style.visibility = "inherit";
	    alphaWritable.style.visibility = "hidden";
	} else {
	    cboWritable.style.visibility = "hidden";
	    alphaWritable.style.visibility = "inherit";
	}]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="1"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::VALPOINT%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::VALPARAM%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.ComboBox" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=grpWritable class="hvg.group.1 instruction-response-data-entry-writable" style="FONT-SIZE: 0pt; HEIGHT: 50%; WIDTH: 63%; POSITION: absolute; LEFT: 0%; TOP: 48.07%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:26;lineColorBlink:False;Width:126;styleClass:instruction-response-data-entry-writable;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=group001 class="hvg.group.1 instruction-response-data-entry" style="FONT-SIZE: 0pt; HEIGHT: 52px; WIDTH: 200px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:52;lineColorBlink:False;Width:200;styleClass:instruction-response-data-entry;"></DIV>]]></content></html></group></shape></shapes></shapefile>