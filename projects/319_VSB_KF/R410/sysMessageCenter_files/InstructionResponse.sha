<DIV tabIndex=-1 id=InstructionText_instructionTextElem class="hvg.textbox.1 instruction-response-instruction-text" style="OVERFLOW: hidden; HEIGHT: 59.5%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%" hdxproperties="fillColorBlink:False;FillStyle:1;Height:120;lineColorBlink:False;LineStyle:0;textColorBlink:False;TotalRotation:-1;Width:240;styleClass:instruction-response-instruction-text"></DIV>]]></content></html></element><html><content><![CDATA[
<DIV tabIndex=-1 id=InstructionText_group001 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 100%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:200;lineColorBlink:False;Width:240;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=InstructionText class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 86.2%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink)" hdxproperties="fillColorBlink:False;Height:200;lineColorBlink:False;Width:240;" value = "1" src = ".\InstructionResponse_files\InstructionText.sha" parameters = "Point?CUSTOM1POINT:;Parameter?CUSTOM1PARAM:;Point?CUSTOM2POINT:;Parameter?CUSTOM2PARAM:;Point?CUSTOM3POINT:;Parameter?CUSTOM3PARAM:;Point?CUSTOM4POINT:;Parameter?CUSTOM4PARAM:;Point?CUSTOM5POINT:;Parameter?CUSTOM5PARAM:;Point?CUSTOM6POINT:;Parameter?CUSTOM6PARAM:;Point?CUSTOM7POINT:;Parameter?CUSTOM7PARAM:;Point?CUSTOM8POINT:;Parameter?CUSTOM8PARAM:;" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content><scripts><script event="onshapeload" language="JScript"><![CDATA[// remove vertical size restriction to enable scrollbar
	InstructionText_instructionTextElem.parentElement.style.overflow = "hidden";
	InstructionText_instructionTextElem.style.height = null;

	var bindingTargets = InstructionText_instructionTextElem.parentElement.parentElement.parentElement.customBindingTargets;
	var customAlphaList = [	{numeric: InstructionText_customalpha1, enumerate: InstructionText_customenum1}, 
							{numeric: InstructionText_customalpha2, enumerate: InstructionText_customenum2}, 
							{numeric: InstructionText_customalpha3, enumerate: InstructionText_customenum3},
							{numeric: InstructionText_customalpha4, enumerate: InstructionText_customenum4},
							{numeric: InstructionText_customalpha5, enumerate: InstructionText_customenum5},
							{numeric: InstructionText_customalpha6, enumerate: InstructionText_customenum6},
							{numeric: InstructionText_customalpha7, enumerate: InstructionText_customenum7},
							{numeric: InstructionText_customalpha8, enumerate: InstructionText_customenum8}];
	
	// get the instruction text string from shape's parent
	var instructionTextString = InstructionText_instructionTextElem.parentElement.parentElement.parentElement.instructionTextString;
	if ((typeof(instructionTextString) != 'string') || (instructionTextString.length == 0)) {
		return;
	}
	InstructionText_instructionTextElem.innerHTML = instructionTextString;

	// Resize the instruction text area
	// This is done in setTimeout to allow the instruction text innerHTML to be parsed, 
	// new DOM elements created and laid out correctly before resizing everything according to the instruction text.
	setTimeout(function() {
		var MAX_INSTRUCTION_TEXT_HEIGHT = 300;
		var newHeight = Math.min(MAX_INSTRUCTION_TEXT_HEIGHT, InstructionText_instructionTextElem.clientHeight);
		InstructionText_instructionTextElem.parentElement.style.height = newHeight.toString() + "px";
		InstructionText_instructionTextElem.parentElement.parentElement.style.height = newHeight.toString() + "px";

		// Once the instruction area size has been set, allow it to be rendered, then 
		// resize the whole instruction response shape accordingly
		setTimeout(function() {
			if (InstructionText_instructionTextElem.parentElement.parentElement.parentElement.OnResize) {
				InstructionText_instructionTextElem.parentElement.parentElement.parentElement.OnResize();
			}
			
			// setup the custom scrollbar only if it is necessary
			InstructionText_instructionTextElem.parentElement.classList.remove("instruction-response-shape-text-with-scrollbar");
			if (InstructionText_instructionTextElem.clientHeight > MAX_INSTRUCTION_TEXT_HEIGHT) {
				setTimeout(function() {
					var elNC = document.getElementsByTagName("hn-notification-center")[0];
					if (elNC && elNC.applyCustomScrollbar) {
						InstructionText_instructionTextElem.parentElement.classList.add("instruction-response-shape-text-with-scrollbar");
						elNC.applyCustomScrollbar(InstructionText_instructionTextElem.parentElement, InstructionText_instructionTextElem.clientHeight);
					}
					// once scrollbar is set, position the live value alphas
					setTimeout(function() {
						InitializeCustomBindingAlphas(bindingTargets, customAlphaList);
					}, 0);
				}, 0);
			} else {
				// if we don't need a scrollbar, position the live value alphas now
				InitializeCustomBindingAlphas(bindingTargets, customAlphaList);
			}
		}, 0);
	}, 0);
	
	InstructionText_instructionTextElem.parentElement.parentElement.parentElement.parentElement.RepositionLiveValueAlphas = function() {
		PositionCustomBindingAlphas(bindingTargets, customAlphaList);
	};]]></script></scripts></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=group002 class="hvg.group.1 instruction-response-shape" style="FONT-SIZE: 0pt; HEIGHT: 232px; WIDTH: 240px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:232;lineColorBlink:False;styleClass:instruction-response-shape;Width:240;"></DIV>]]></content></html></group></shape></shapes></shapefile>