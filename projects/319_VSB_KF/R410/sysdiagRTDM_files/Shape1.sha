<DIV class=hvg.base.1 id=rect005 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 0%; VISIBILITY: visible; BEHAVIOR: url(#HDXVectorFactory#rect); OVERFLOW: hidden; WIDTH: 38.28%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 60.16%; HEIGHT: 39.63%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:#00bfff;fillColorBlink:False;Height:195;LineColor:transparent;lineColorBlink:False;LineStyle:0;Width:291;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alpha043 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 65%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 24.34%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 80.48%; HEIGHT: 6.7%; BACKGROUND-COLOR: #00bfff; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:#00bfff;fillColorBlink:False;HDXBINDINGID:-4;lineColor:transparent;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[dim str,str1
str = me.value
str1 = left(str,4)	

	if str1 = "RTD " then
  			 rect005.style.visibility = "visible"
   			 line001.style.visibility = "visible"
			 
			 
	end if

	if str1 = "Univ" then
  			 rect005.style.visibility = "hidden"
   			 line001.style.visibility = "hidden"
			 
			 
	end if]]></script><script event="onupdate" language="VBScript"><![CDATA[dim str,str1
str = me.value
str1 = left(str,4)	

	if str1 = "RTD " then
  			 rect005.style.visibility = "visible"
   			 line001.style.visibility = "visible"
			 
			 
	end if

	if str1 = "Univ" then
  			 rect005.style.visibility = "hidden"
   			 line001.style.visibility = "hidden"
			 
			 
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="IOMTYPE"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[
