Sub CommonIntermediateTicMarkValues

'on error resume next 'to allow time for ConAlpEUTickMarksServerBits.value to be set

	'window.external.parentdocument.parentwindow.external.logmessage "CommonIntermediateTicMarkValues, ConAlpPVEULo visibility= " & ConAlpPVEULo.Style.visibility
    If  ("0" = ConAlpEUTickMarksServerBits.Value) or UCase(ConAlpPVEULo.Style.visibility) = "HIDDEN" then
       'window.external.parentdocument.parentwindow.external.logmessage  "Intermediate tickmark values OFF"
        ConAlpPVEU1.Style.visibility = "Hidden"
        ConAlpPVEU2.Style.visibility = "Hidden"
        ConAlpPVEU3.Style.visibility = "Hidden"
        ConAlpEUDesc.Style.pixelWidth = 80
		ConAlpEUDesc.Style.pixelHeight = 20 'was 15
        bServerBitsFlagTicMarkValues = False
    Else
       'window.external.parentdocument.parentwindow.external.logmessage  "Intermediate tickmark values ON"
        ConAlpPVEU1.Style.visibility = "Inherit"
        ConAlpPVEU2.Style.visibility = "Inherit"
        ConAlpPVEU3.Style.visibility = "Inherit"
        ConAlpEUDesc.Style.pixelWidth = 45 'uses two lines if necessary, wrapping even if ugly
		ConAlpEUDesc.Style.pixelHeight = 44 'was 30
' 		if the tick mark value is just too big to fit, then blank it out
'        If Len(ConAlpPVEU2.Value) > 5 Then 'compensate for big/small numbers
'			if Len(ConAlpEUDesc.Value) > 2 then 'but only if not a tiny EUDESC
		If (Len(ConAlpPVEU2.Value) + Len(ConAlpEUDesc.Value)) > 10 then
	        	ConAlpEUDesc.Style.pixelWidth = 80 'full length again
	        	ConAlpPVEU2.Style.visibility = "Hidden" ' just hide the middle tick value altogether			
				ConAlpEUDesc.Style.pixelHeight = 20 '15
'			end if
		end if
        bServerBitsFlagTicMarkValues = True
    End If
End Sub

sub SetPVFormat
    
    'window.external.parentdocument.parentwindow.external.logmessage  "PV Format= " & sd.DataValue("CurrentPoint.PVFORMAT")
    If sd.QualityGood("CurrentPoint.PVFORMAT") Then
    
        Select Case sd.DataValue("CurrentPoint.PVFORMAT")
        Case "D0"
            formatPV = 0
        Case "D1"
            formatPV = 1
        Case "D2"
            formatPV = 2
        Case "D3"
            formatPV = 3
        Case "D4"
            formatPV = 4
        Case "D5"
            formatPV = 5
        Case "D6"
            formatPV = 6
        Case Else
            formatPV = -1  ' use default - i.e. computer's regional setting
        End Select
    End If   'defaulted to -1
    
End Sub

Sub SetSPFormat

    'window.external.parentdocument.parentwindow.external.logmessage  "SP Format= " & sd.DataValue("CurrentPoint.SPFORMAT")
    If sd.QualityGood("CurrentPoint.SPFORMAT") Then
    
        Select Case sd.DataValue("CurrentPoint.SPFORMAT")
        Case "D0"
            formatSP = 0
        Case "D1"
            formatSP = 1
        Case "D2"
            formatSP = 2
        Case "D3"
            formatSP = 3
        Case "D4"
            formatSP = 4
        Case "D5"
            formatSP = 5
        Case "D6"
            formatSP = 6
        Case Else
            formatSP = -1  ' use default - i.e. computer's regional setting
        End Select
    Else
        formatSP = formatPV 'drop back to formatPV in case PVFORMAT is OK
    End If
        
End Sub

Sub PVFormatUpdate

    Call SetPVFormat
    If Not formatPV = -1 Then
        edit_PV.numericdisplayformat = "%." & formatPV & "f"
    End If

End Sub

Sub SPFormatUpdate

    Call SetSPFormat
    If Not formatSP = -1 Then
        edit_SP.numericdisplayformat = "%." & formatSP & "f"
    End If

End Sub

Sub AnalogUpdateValues
    ConIndSP.Value = sd.DataValue("CurrentPoint.SP")
    ConIndPV.Value = sd.DataValue("CurrentPoint.PV")
    ConIndOP.Value = sd.DataValue("CurrentPoint.OP")
	if sd.QualityGood("CurrentPoint.EUDESC") then
		ConAlpEUDesc.style.visibility = "inherit"
	    If bToolTips = True Then
    	    ConAlpEUDesc.Title = "EUDESC= " & sd.DataValue("CurrentPoint.EUDESC")
    	End If
	else
		ConAlpEUDesc.style.visibility = "hidden"
	end if
	if sd.QualityGood("CurrentPoint.PTDESC") then
	    ConAlpDescription.Value = sd.DataValue("CurrentPoint.PTDESC")
	end if	   
'window.external.parentdocument.parentwindow.external.logmessage  "AnalogUpdateValues indicators SP:" & sd.DataValue("CurrentPoint.SP") & " PV:" & sd.DataValue("CurrentPoint.PV") & " OP:" & sd.DataValue("CurrentPoint.OP")

End Sub

'set alarm zone
Sub CommonAlarm

    Dim state_PNTSTATE
    ' point state indicator
    If sd.QualityGood("CurrentPoint.PNTSTATE") And UCase(sd.DataValue("CurrentPoint.PNTSTATE")) <> "OK" Then
        state_PNTSTATE = Left(sd.DataValue("CurrentPoint.PNTSTATE"), 1)
	'window.external.parentdocument.parentwindow.external.logmessage  "CommonAlarm - PNTSTATE=" & state_PNTSTATE
    Else
        state_PNTSTATE = ""
    End If
    
    '   Replace HIGHAL with ALENBST if inhibited
    If UCase(sd.DataValue("CurrentPoint.ALENBST")) <> "INHIBIT" Then
        If UCase(sd.DataValue("CurrentPoint.HIGHAL")) = "NOALARM" Or Not sd.QualityGood("CurrentPoint.HIGHAL") Then
            If state_PNTSTATE <> "" Then
                state_alarmState.Value = state_PNTSTATE
                If bToolTips = True Then
                    state_alarmState.Title = "PNTSTATE= " & sd.DataValue("CurrentPoint.PNTSTATE")
                End If
                state_alarmState.Style.visibility = "Visible"
            Else
                state_alarmState.Style.visibility = "Hidden"
            End If  ' state_PNTSTATE
           'window.external.parentdocument.parentwindow.external.logmessage  "CommonAlarm - NOALARM (or not config)"
        Else
           'window.external.parentdocument.parentwindow.external.logmessage  "CommonAlarm - in alarm: " & sd.DataValue("CurrentPoint.HIGHAL")
            state_alarmState.Style.visibility = "Visible"
            state_alarmState.Value = sd.DataValue("CurrentPoint.HIGHAL")
            If state_PNTSTATE <> "" Then
                state_alarmState.Value = state_alarmState.Value & " " & state_PNTSTATE
                If bToolTips = True Then
                    state_alarmState.Title = "HIGHAL= " & sd.DataValue("CurrentPoint.HIGHAL") & ", PNTSTATE= " & sd.DataValue("CurrentPoint.PNTSTATE")
                End If
            Else
                If bToolTips = True Then
                    state_alarmState.Title = "HIGHAL= " & sd.DataValue("CurrentPoint.HIGHAL")
                End If
            End If  ' state_PNTSTATE
        End If  ' state_HIGHAL
    Else
	'window.external.parentdocument.parentwindow.external.logmessage  "CommonAlarm - INHIBIT"
        state_alarmState.Style.visibility = "Visible"
        state_alarmState.Value = sd.DataValue("CurrentPoint.ALENBST")
        If state_PNTSTATE <> "" Then
            If bToolTips = True Then
                state_alarmState.Title = "ALENBST= INHIBIT, PNTSTATE=" & sd.DataValue("CurrentPoint.PNTSTATE")
            End If
            state_alarmState.Value = state_alarmState.Value & " " & state_PNTSTATE
        Else
            If bToolTips = True Then
                state_alarmState.Title = "ALENBST= INHIBIT"
            End If
       End If  'state_PNTSTATE
    End If  ' state_ALENBST


'   Show "DISABLED" in case below
    If UCase(sd.DataValue("CurrentPoint.ALENBST")) = "DISABLE" Then
        textAlarmDisabled.Style.visibility = "Visible"
	'window.external.parentdocument.parentwindow.external.logmessage  "CommonAlarm - DISABLED"
    Else
        textAlarmDisabled.Style.visibility = "Hidden"
    End If
End Sub


'ALPSTATUS will be displayed if the status is not "ACTIVE"
Sub CommonPointState

'   Update "point state" in the description zone
'   Called when either PTEXECST or REDTAG params change
    If sd.QualityGood("CurrentPoint.PTEXECST") Then
        If UCase(sd.DataValue("CurrentPoint.PTEXECST")) = "INACTIVE" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState - INACTIVE"
            state_pointState.Value = "INACTIVE"
            state_pointState.Style.visibility = "Visible"
            Exit Sub
        End If
    End If
    If sd.QualityGood("CurrentPoint.STSMSG") Then
	'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState, STSMSG=" & sd.DataValue("CurrentPoint.STSMSG")
        If UCase(sd.DataValue("CurrentPoint.STSMSG")) <> "NONE" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState - Showing STSMSG!"
            state_pointState.Style.visibility = "Visible"
            state_pointState.Value = sd.DataValue("CurrentPoint.STSMSG")
            'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState - Set state_pointState to (STSMSG), state_PointState now:" & state_pointState.Value
            Exit Sub
        End If
    End If
    If sd.QualityGood("CurrentPoint.PTORST") Then
	'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState, STSMSG=" & sd.DataValue("CurrentPoint.STSMSG")
        If UCase(sd.DataValue("CurrentPoint.PTORST")) = "SEL" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState - Showing STSMSG!"
            state_pointState.Style.visibility = "Visible"
            state_pointState.Value = "OR in SEL"
            'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState - Set state_pointState to (STSMSG), state_PointState now:" & state_pointState.Value
            Exit Sub
		ElseIf UCase(sd.DataValue("CurrentPoint.PTORST")) = "NOTSEL" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState - Showing STSMSG!"
            state_pointState.Style.visibility = "Visible"
            state_pointState.Value = "OR not SEL"
            'window.external.parentdocument.parentwindow.external.logmessage  "CommonPointState - Set state_pointState to (STSMSG), state_PointState now:" & state_pointState.Value
            Exit Sub
        End If
    End If
    state_pointState.Style.visibility = "Hidden"

End Sub


Sub CommonModeOffNormalCheck
    'window.external.parentdocument.parentwindow.external.logmessage  "CommonModeOffNormalCheck"
    If GrpMD.Style.visibility <> "Hidden" Then
        If sd.QualityGood("CurrentPoint.MODE") And sd.QualityGood("CurrentPoint.NMODE") Then
            If UCase(sd.DataValue("CurrentPoint.NMODE")) <> "NONE" Then
                If sd.DataValue("CurrentPoint.MODE") = sd.DataValue("CurrentPoint.NMODE") Then
                    textMDLabel.Style.visibility = "Inherit"
                    textMDLabelOffNormal.Style.visibility = "Hidden"
                Else
                    'window.external.parentdocument.parentwindow.external.logmessage  "MODE is off-normal"
                    textMDLabel.Style.visibility = "Hidden"
                    textMDLabelOffNormal.Style.visibility = "Inherit"
                End If
            Else
              textMDLabel.Style.visibility = "Inherit"
              textMDLabelOffNormal.Style.visibility = "Hidden"
            End If
        End If
    End If
End Sub

Sub CommonModattrOffNormalCheck
    'window.external.parentdocument.parentwindow.external.logmessage  "CommonModattrOffNormalCheck"
    If GrpMDAttr.Style.visibility <> "Hidden" Then
        If sd.QualityGood("CurrentPoint.MODATTR") And sd.QualityGood("CurrentPoint.NMODATTR") Then
            If UCase(sd.DataValue("CurrentPoint.NMODATTR")) <> "NONE" Then
                If sd.DataValue("CurrentPoint.MODATTR") = sd.DataValue("CurrentPoint.NMODATTR") Then
                    grpModAttr.Style.visibility = "Inherit"
                    grpModAttrOffNormal.Style.visibility = "Hidden"
                Else
                    'window.external.parentdocument.parentwindow.external.logmessage  "...MODATTR off-normal"
                    grpModAttr.Style.visibility = "Hidden"
                    grpModAttrOffNormal.Style.visibility = "Inherit"
                End If
            Else
                   grpModAttr.Style.visibility = "Inherit"
                   grpModAttrOffNormal.Style.visibility = "Hidden"
            End If
        End If
    End If
End Sub

Sub CommonRedTag
    If sd.QualityGood("CurrentPoint.REDTAG") Then
        If UCase(sd.DataValue("CurrentPoint.REDTAG")) = "ON" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "CommonRedTag - REDTAG=ON"
            redtagIndicator.Style.visibility = "Visible"
        Else
            redtagIndicator.Style.visibility = "Hidden"
        End If
    End If
End Sub

Sub AnalogPVStatus
'
'   See Faceplate ocx for comment-matrix as to behavior here

    Dim bExOK

    If sd.QualityGood("CurrentPoint.PVEXHIFL") And Not sd.IsNan("CurrentPoint.PVEXHIFL") And sd.QualityGood("CurrentPoint.PVEXLOFL") And Not sd.IsNan("CurrentPoint.PVEXLOFL") Then
        bExOK = True
    Else
        bExOK = False
    End If

'   PV may be "not configured" in which case we hide the PV Status shape
    If UCase(sd.DataValue("CurrentPoint.PVSTS")) = "NORMAL" Or sd.QualityConfigError("CurrentPoint.PV") Then
		if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
			window.external.parentdocument.parentwindow.external.logmessage "PV has path issue ($PATHSTS)"
			shpPvstatus.Value = 15 'Path status input error (alone)
			shpPvstatus.Style.visibility = "Visible"
		else
	        shpPvstatus.Value = 1  '1st is invisible
    	    shpPvstatus.Style.visibility = "Hidden"
	        'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - Normal (or not configured)"
		end if
    ElseIf UCase(sd.DataValue("CurrentPoint.PVSTS")) = "BAD" Then
        If bExOK And sd.DataValue("CurrentPoint.PVEXHIFL") <> 0 And sd.DataValue("CurrentPoint.PVEXLOFL") <> 0 Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'B'"
            shpPvstatus.Value = 2   ' red "B"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf bExOK And sd.DataValue("CurrentPoint.PVEXHIFL") <> 0 And (Not sd.DataValue("CurrentPoint.PVEXLOFL") <> 0) Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'H'"
            shpPvstatus.Value = 3   ' red "H"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf bExOK And sd.DataValue("CurrentPoint.PVEXLOFL") <> 0 And (Not sd.DataValue("CurrentPoint.PVEXHIFL") <> 0) Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'L'"
            shpPvstatus.Value = 4   ' red "L"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf UCase(sd.DataValue("CurrentPoint.PVSOURCE")) = "MAN" Then
            'both EX..FL params must be 'off' ...look at PVSOURCE
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - M'"
            shpPvstatus.Value = 5   ' red "M"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf UCase(sd.DataValue("CurrentPoint.PVSOURCE")) = "SUB" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'S'"
            shpPvstatus.Value = 6   ' red "S"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf UCase(sd.DataValue("CurrentPoint.PVSOURCE")) = "BAD" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'B'(2)"
            shpPvstatus.Value = 13   ' red "B"
            shpPvstatus.Style.visibility = "Visible"
        Else
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'B'(3)"
            shpPvstatus.Value = 2   ' just make it bad - red "B"
            shpPvstatus.Style.visibility = "Visible"
        End If

		'for all of the above cases, if the path status is also bad, then adding "14" will update the tooltip accordingly in the shape sequence
		'if $PATHSTS (new EHB parameter) indicates INERR or INOUTERR, then show
		if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
			window.external.parentdocument.parentwindow.external.logmessage "PV has path issue ($PATHSTS)"
			shpPvstatus.Value = shpPvstatus.value + 14  'include *Path Status Error* in tooltip ALONG WITH above status 
		end if

    ElseIf UCase(sd.DataValue("CurrentPoint.PVSTS")) = "UNCERTN" Then
        If bExOK And sd.DataValue("CurrentPoint.PVEXHIFL") <> 0 And sd.DataValue("CurrentPoint.PVEXLOFL") <> 0 Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'U'"
            shpPvstatus.Value = 7   ' yellow "U"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf bExOK And sd.DataValue("CurrentPoint.PVEXHIFL") <> 0 And (Not sd.DataValue("CurrentPoint.PVEXLOFL") <> 0) Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'H'(yellow)"
            shpPvstatus.Value = 8   ' yellow "H"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf bExOK And sd.DataValue("CurrentPoint.PVEXLOFL") <> 0 And (Not sd.DataValue("CurrentPoint.PVEXHIFL") <> 0) Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'L'(yellow)"
            shpPvstatus.Value = 9   ' yellow "L"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf UCase(sd.DataValue("CurrentPoint.PVSOURCE")) = "MAN" Then
            'both EX..FL params must be 'off' ...look at PVSOURCE
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'M'(yellow)"
            shpPvstatus.Value = 10   ' yellow "M"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf UCase(sd.DataValue("CurrentPoint.PVSOURCE")) = "SUB" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'S'(yellow)"
            shpPvstatus.Value = 11  ' red "S"
            shpPvstatus.Style.visibility = "Visible"
        ElseIf UCase(sd.DataValue("CurrentPoint.PVSOURCE")) = "BAD" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'U'(2)"
            shpPvstatus.Value = 7   ' yellow "U"
            shpPvstatus.Style.visibility = "Visible"
        Else
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'U'(3)"
            shpPvstatus.Value = 7   ' just make it uncertain - yellow "U"
            shpPvstatus.Style.visibility = "Visible"
        End If

		'for whatever the above is - adding "14" appends the "Path status error" msg to the tooltip.
		'if $PATHSTS (new EHB parameter) indicates INERR or INOUTERR, then show
		if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
			window.external.parentdocument.parentwindow.external.logmessage "PV has path issue ($PATHSTS)"
			shpPvstatus.Value = shpPvstatus.value + 14  'include *Path Status Error* in tooltip ALONG WITH above status
		end if

    Else ' non-configured PVSTS parameter; GUS fp then looks for only SUB/MAN
        If UCase(sd.DataValue("CurrentPoint.PVSOURCE")) = "MAN" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'M'(2, yellow)"
            shpPvstatus.Value = 14   ' yellow "M" 
            shpPvstatus.Style.visibility = "Visible"
 			'if $PATHSTS (new EHB parameter) indicates INERR or INOUTERR, then show
			if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
				window.external.parentdocument.parentwindow.external.logmessage "PV has path issue ($PATHSTS)"
				shpPvstatus.Value = shpPvstatus.value + 14 
			end if
       ElseIf UCase(sd.DataValue("CurrentPoint.PVSOURCE")) = "SUB" Then
            'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - 'S'(2, yellow)"
            shpPvstatus.Value = 12  ' yellow "S" 
            shpPvstatus.Style.visibility = "Visible"

			'if $PATHSTS (new EHB parameter) indicates INERR or INOUTERR, then show
			if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
				window.external.parentdocument.parentwindow.external.logmessage "PV has path issue ($PATHSTS)"
				shpPvstatus.Value = shpPvstatus.value + 14 
			end if
        Else    ' hide it "OK" (unless path bad)
			'if $PATHSTS (new EHB parameter) indicates INERR or INOUTERR, then show
			if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
				window.external.parentdocument.parentwindow.external.logmessage "PV has path issue ($PATHSTS)"
				shpPvstatus.Value = 15 
            	shpPvstatus.Style.visibility = "Visible"
			else
		    	'window.external.parentdocument.parentwindow.external.logmessage  "AnalogPVStatus - Normal (2)"
            	shpPvstatus.Value = 1  'invisible
            	shpPvstatus.Style.visibility = "Hidden"
			end if
	    End If
    End If

End Sub

Sub AnalogSPStatus

    If UCase(sd.DataValue("CurrentPoint.SPSTS")) = "BAD" then
        ConShpSPsts.Value = 2  'B' for bad
	elseif sd.DataValue("CurrentPoint.SPHIFL") <> 0  and sd.QualityGood("CurrentPoint.SPHIFL") then
        ConShpSPsts.Value = 3  'H' 
	elseif sd.DataValue("CurrentPoint.SPLOFL") <> 0  and sd.QualityGood("CurrentPoint.SPLOFL") then 
        ConShpSPsts.Value = 4 'L' 
	else
		ConShpSPsts.Value = 1 'invisible
	end if

	if UCase(sd.DataValue("CurrentPoint.ARWNET")) = "HILO" then
        ConShpWindupSPsts.Value = 4  
	elseif UCase(sd.DataValue("CurrentPoint.ARWNET")) = "HI" then
        ConShpWindupSPsts.Value = 2
	elseif UCase(sd.DataValue("CurrentPoint.ARWNET")) = "LO" then
        ConShpWindupSPsts.Value = 3
	else 
        ConShpWindupSPsts.Value = 1 ' invisible
	end if

End Sub


Sub AnalogOPStatus

	on error resume next 'because not all faceplates have grp_Initman
  	'INIT trumps OP status
	If sd.QualityGood("CurrentPoint.INITMAN") And sd.DataValue("CurrentPoint.INITMAN") <> 0 Then
		'show INIT and we don't (have room to) show any other status for OP  (done in faceplates themselves that HAVE initman)
		if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "OUTERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
			'augment tooltip only
			grp_InitMan.title = "Initialization manual state; Output path status error"
			grp_InitSI.title = "Init Manual; output path status error; Safety interlock (SHUTDOWN) is ON, OP is SAFEOP"
		else 'possibly recovered path status
			grp_InitMan.title = "Initialization manual state"
			grp_InitSI.title = "Init Manual; Safety interlock (SHUTDOWN) is ON, OP is SAFEOP"
		end if
	else
    	if sd.DataValue("CurrentPoint.OPHIFL") <> 0 and sd.QualityGood("CurrentPoint.OPHIFL") then
			if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "OUTERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
				window.external.parentdocument.parentwindow.external.logmessage "OP has path issue ($PATHSTS)"
				ConShpOPsts.Value = 8 'H' with tool tip also about $PATHSTS issue
			else
	        	ConShpOPsts.Value = 5  'H' 
			end if
		elseif sd.DataValue("CurrentPoint.OPLOFL") <> 0  and sd.QualityGood("CurrentPoint.OPLOFL") then 
			if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "OUTERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
				window.external.parentdocument.parentwindow.external.logmessage "OP has path issue ($PATHSTS)"
				ConShpOPsts.Value = 9 'L' with tool tip also about $PATHSTS issue
			else
	        	ConShpOPsts.Value = 6  'L' 
			end if
		else
			if UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "OUTERR" or UCase(sd.DataValue("CurrentPoint.$PATHSTS")) = "INOUTERR" then
				window.external.parentdocument.parentwindow.external.logmessage "OP has path issue ($PATHSTS)"
				ConShpOPsts.Value = 7 'P' ONLY the $PATHSTS error
			else		
				ConShpOPsts.Value = 1 'invisible
			end if
		end if
	end if

	if UCase(sd.DataValue("CurrentPoint.ARWOP")) = "HILO" then
       	ConShpWindupOPsts.Value = 7  
	elseif UCase(sd.DataValue("CurrentPoint.ARWOP")) = "HI" then
        ConShpWindupOPsts.Value = 5
	elseif UCase(sd.DataValue("CurrentPoint.ARWOP")) = "LO" then
        ConShpWindupOPsts.Value = 6
	else 
        ConShpWindupOPsts.Value = 1 ' invisible
	end if
End Sub

Sub CommonModeComboEx(SecurityLevel)
    
    If SecurityLevel < 2 Then
        combo_MD.hostpopulation = True
        Exit Sub
    End If
    
    Dim sVal
    sVal = combo_MD.innerText
    If sd.QualityGood("CurrentPoint.mode") Then
        combo_MD.hostpopulation = False
        combo_MD.ResetContent
        If sd.QualityGood("CurrentPoint.modeappl(1)") And sd.DataValue("CurrentPoint.modeappl(1)") <> 0 Then
            combo_MD.AddString "MAN"
            'dbtrace 27, "CommonModeCombo - Adding MAN"
        End If
        If sd.QualityGood("CurrentPoint.modeappl(2)") And sd.DataValue("CurrentPoint.modeappl(2)") <> 0 Then
            combo_MD.AddString "AUTO"
            'dbtrace 27, "CommonModeCombo - Adding AUTO"
        End If
        If sd.QualityGood("CurrentPoint.modeappl(3)") And sd.DataValue("CurrentPoint.modeappl(3)") <> 0 Then
            combo_MD.AddString "CAS"
            'dbtrace 27, "CommonModeCombo - Adding CAS"
        End If
        If sd.QualityGood("CurrentPoint.modeappl(4)") And sd.DataValue("CurrentPoint.modeappl(4)") <> 0 Then
            'dbtrace 27, "CommonModeCombo - Adding BCAS"
            combo_MD.AddString "BCAS"
        End If
   		If sd.QualityGood("CurrentPoint.NMODE") and sd.DataValue("CurrentPoint.NMODE") <> "NONE" Then
            'dbtrace 27, "CommonModeCombo - Adding NMODE"
			combo_MD.AddString "NORMAL"
		End If
             
        combo_MD.innerText = sVal
    End If
    
End Sub

Sub CommonModAttrComboEx(SecurityLevel)
    
    If SecurityLevel < 2 Then
        combo_MDAttr.hostpopulation = True
        Exit Sub
    End If
    
    Dim sVal
    sVal = combo_MDAttr.innerText
    
    If sd.QualityGood("CurrentPoint.modAttr") Then
        combo_MDAttr.hostpopulation = False
        combo_MDAttr.ResetContent
        If sd.QualityGood("CurrentPoint.$modesel(5)") Then
            If sd.DataValue("CurrentPoint.$modesel(5)") <> "0" Then
                'dbtrace 27, "CommonModAttrCombo - Adding PROGRAM (we always add OPERATOR)"
                combo_MDAttr.AddString "PROGRAM"
            End If
        End If
        combo_MDAttr.AddString "OPERATOR"
        combo_MDAttr.innerText = sVal
    
    End If
    
End Sub

'--------------------------------------------------------------------------------------------------------------------------
'
' RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING RAMPING
'
'--------------------------------------------------------------------------------------------------------------------------
 
Function RaiseLowerConfirm()

	nConfirmCount = 0
	window.clearInterval(intRaiseLowerTimerID) 'clear old/other timers
  	intRaiseLowerTimerID = window.setInterval ("CheckRaiseLowerResponse()", 500)

End Function

sub CancelRaiseLowerConfirmation

	'generic routine to clean up and bail out of confirmation of raise/lower OP/MODE/MODATTR
	window.external.parentdocument.parentwindow.external.CancelResponse
	nConfirmCount = 0
	window.clearInterval(intRaiseLowerTimerID)
	sCurrentShownRaiseLowerValue = ""
	sElementRaiseLower = ""
	sConfirmRaiseLowerMsg = ""
end sub

Function OnDeactivateCancelRamp2

	window.clearInterval(intCancelRampOnPageDeactivateID)
	call CancelRaiseLowerConfirmation

end function


sub CheckRaiseLowerResponse

	dim sResponse
	dim iStatus
	dim ptPromptType 
	dim sMsgZoneText
	ptPromptType = 1

	nConfirmCount = nConfirmCount + 1

	sMsgZoneText = window.external.parentdocument.parentwindow.external.MessageZoneText 

'	sConfirmRaiseLowerMsg = "<" & nConfirmCount & "> " & "Change state of TPS:" & text_NAME.value & "." & sElementRaiseLower & " to " & sCurrentShownRaiseLowerValue
	sConfirmRaiseLowerMsg = "Change state of TPS:" & alphaTagName.value & "." & sElementRaiseLower & " to " & sCurrentShownRaiseLowerValue
	iStatus = window.external.parentdocument.parentwindow.external.GetResponse3 (sConfirmRaiseLowerMsg, ptPromptType, sResponse)

	'window.external.parentdocument.parentwindow.external.logmessage "RaiseLowerConfirm: status returned= " & iStatus

	if iStatus = 0 and nConfirmCount > 1 then

		window.external.parentdocument.parentwindow.external.logmessage "RaiseLowerConfirm: - action cancelled by user" 
		call CancelRaiseLowerConfirmation
		exit sub
	elseif iStatus = 1 then
		if sResponse = "" then
			'no response yet... let timer fire again shortly
		else
			'recieved response, process it and we're DONE
			if UCase(sResponse) = "Y" then

				window.external.parentdocument.parentwindow.external.logmessage "RaiseLowerConfirm: setting: " & sElementRaiseLower & " to: " & sCurrentShownRaiseLowerValue
				if UCase(sElementRaiseLower) = "MODE" then
					combo_MD.hostpopulation = true
'					page.AutoSelectOnNextModeChange = true
					Call SetAutoSelect
					combo_MD.value = sCurrentShownRaiseLowerValue
					if 1 = trigger_update.value then 
						sd.TriggerDataUpdate("CurrentPoint.MODE"), 1
					end if
					combo_MD.focus
				elseif UCase(sElementRaiseLower) = "MODATTR" then
					combo_MDATTR.hostpopulation = true
					combo_MDATTR.value = sCurrentShownRaiseLowerValue
					if 1 = trigger_update.value then 
						sd.TriggerDataUpdate("CurrentPoint.MODATTR"), 1
					end if
					combo_MDATTR.focus
				end if
			end if

			call CancelRaiseLowerConfirmation

		end if
	end if

	if nConfirmCount > 2 and (sMsgZoneText = "" or (sConfirmRaiseLowerMsg <> sMsgZoneText)) then		
		window.external.parentdocument.parentwindow.external.logmessage "RaiseLowerConfirm: message text changed operation cancelled" 
		call CancelRaiseLowerConfirmation
		exit sub

	end if

	'expire after Experion's "operator timeout" - e.g. 60 seconds (x2 as timer is .5 secs)
	if nConfirmCount > oper_timeout.value * 2 then 

		window.external.parentdocument.parentwindow.external.logmessage "RaiseLowerConfirm: nConfirmCount > Experion operator timeout: " & oper_timeout.value & "; operation cancelled" 
		call CancelRaiseLowerConfirmation
		exit sub

	end if


end sub


Function GetNextRaiseMode(sThisValue)

	if sThisValue = "MAN" then
		GetNextRaiseMode = "MAN"
	elseif sThisValue = "AUTO" then
		if sd.DataValue("CurrentPoint.MODEAPPL(1)") <> 0 then
			GetNextRaiseMode = "MAN"
		else
			GetNextRaiseMode = "AUTO"
		end if
	elseif sThisValue = "CAS" then
		if sd.DataValue("CurrentPoint.MODEAPPL(2)") <> 0 then
			GetNextRaiseMode = "AUTO"
		elseif sd.DataValue("CurrentPoint.MODEAPPL(1)") <> 0 then
			GetNextRaiseMode = "MAN"
		else
			GetNextRaiseMode = "CAS"
		end if
	elseif sThisValue = "BCAS" then
		if sd.DataValue("CurrentPoint.MODEAPPL(3)") <> 0 then
			GetNextRaiseMode = "CAS"
		elseif sd.DataValue("CurrentPoint.MODEAPPL(2)") <> 0 then
			GetNextRaiseMode = "AUTO"
		elseif sd.DataValue("CurrentPoint.MODEAPPL(1)") <> 0 then
			GetNextRaiseMode = "MAN"
		else
			GetNextRaiseMode = "BCAS"
		end if
	else 
		GetNextRaiseMode = sThisValue
	end if

end function

Function GetNextLowerMode(sThisValue)

	if sThisValue = "MAN" then
		if sd.DataValue("CurrentPoint.MODEAPPL(2)") <> 0 then
			GetNextLowerMode = "AUTO"
		elseif sd.DataValue("CurrentPoint.MODEAPPL(3)") <> 0 then
			GetNextLowerMode = "CAS"
		elseif sd.DataValue("CurrentPoint.MODEAPPL(4)") <> 0 then
			GetNextLowerMode = "BCAS"
		else
			GetNextLowerMode = "MAN"
		end if
	elseif sThisValue = "AUTO" then
		if sd.DataValue("CurrentPoint.MODEAPPL(3)") <> 0 then
			GetNextLowerMode = "CAS"
		elseif sd.DataValue("CurrentPoint.MODEAPPL(4)") <> 0 then
			GetNextLowerMode = "BCAS"
		else
			GetNextLowerMode = "AUTO"
		end if
	elseif sThisValue = "CAS" then
		if sd.DataValue("CurrentPoint.MODEAPPL(4)") <> 0 then
			GetNextLowerMode = "BCAS"
		else
			GetNextLowerMode = "CAS"
		end if
	elseif sThisValue = "BCAS" then
		GetNextLowerMode = "BCAS"
	else 
		GetNextLowerMode = sThisValue
	end if

end function

Function GetNextLowerModAttr(sThisValue)

'no option but "OPERATOR"
	GetNextLowerModAttr = "OPERATOR"

end function

Function GetNextRaiseModAttr(sThisValue)

	if sThisValue = "OPERATOR" then
		if not sd.QualityConfigError("CurrentPoint.$MODESEL(5)") and sd.DataValue("CurrentPoint.$MODESEL(5)") <> 0 then
			GetNextRaiseModAttr = "PROGRAM"
		else 
			GetNextRaiseModAttr = "OPERATOR"
		end if
	else 'if sThisValue = "PROGRAM" then   <don't wrap from Program back to Operator>
		GetNextRaiseModAttr = "PROGRAM"
	end if

end function]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%currentpoint%}"/></parameters><shapes><shape><group><element><html><content><![CDATA[
