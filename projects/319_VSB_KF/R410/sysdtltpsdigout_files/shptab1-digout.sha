<DIV tabIndex=-1 id=txtPVSOURCE class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; HEIGHT: 100%; FONT-FAMILY: Verdana; WIDTH: 44.94%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:;textColor:Black;textColorBlink:False;TotalRotation:-1;Width:80;" HDX_LOCK="-1">PVSOURCE:<BR></DIV>]]></content></html></element><element><html><content><![CDATA[<SPAN tabIndex=0 id=cmbPVSource title="" class="hsc.combo.1 DetailCombo" style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 100%; FONT-FAMILY: Verdana; WIDTH: 52.24%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: black; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 47.75%; TOP: 0%; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: white; TEXT-INDENT: 2px" hdxproperties="borderStyle:none;fillColor:White;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:False;lineColor:transparent;lineColorBlink:False;styleClass:DetailCombo;textColor:black;textColorBlink:False;" HDX_LOCK="-1">Combobox</SPAN>]]></content><scripts><script event="onmousedown" language="VBScript"><![CDATA[	dim sVal
	sVal = me.value
	me.ResetContent
	me.AddString "AUTO"
	me.AddString "MAN"
	me.AddString "SUB"
	me.AddString "TRACK"
	me.value = sVal]]></script><script event="onchange" language="VBScript"><![CDATA[	on error resume next

	dim bRet 
	bRet = sd.SetDataValueSynchronous ("tagname.PVSOURCE", me.value)	'wait for write!
	if bRet = False then
		me.innerText = sd.DataValue("tagname.PVSOURCE") 			'reassign in case write failed!
	end if]]></script></scripts></html><binding/></element><html><content><![CDATA[
<DIV tabIndex=-1 id=GrpPVSOURCE class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 3.73%; WIDTH: 94.68%; POSITION: absolute; LEFT: 0%; TOP: 46.49%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:178;" HDX_LOCK="-1"></DIV>]]></content></html></group><group><element><html><content><![CDATA[
