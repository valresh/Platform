	sVal = me.value
	me.ResetContent
  	me.AddString sdDataValue("tagname.STATETXT(0)")
  	me.AddString sdDataValue("tagname.STATETXT(1)")
  	me.AddString sdDataValue("tagname.STATETXT(2)")
  	me.value = sVal]]></script><script event="onchange" language="VBScript"><![CDATA[	on error resume next

	dim bRet
	bRet = sd.SetDataValueSynchronous ("tagname.PVNORMAL", me.value)	'wait for write!
