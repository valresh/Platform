ty name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PISRC(12).external"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; WIDTH: 16.3%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 3.92%; COLOR: black; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 62.15%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 77.58%; ROWS: 1" id=alp_dest12 class="hsc.alpha.1 Data_bold_left" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:9;numericDisplayFormat:%s;styleClass:Data_bold_left;textColor:black;">Text</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="PIDSTN(12).external"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; WIDTH: 46.06%; FONT-FAMILY: Helvetica; HEIGHT: 100%; COLOR: #000000; FONT-SIZE: 10pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 0%" id=txt_nbrInpts class="hvg.textbox.1 Label_Text" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;styleClass:Label_Text;textColor:black;textColorBlink:False;TotalRotation:-1;Width:82;">NOPINPTS =</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; WIDTH: 53.37%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 83.33%; COLOR: black; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 5.55%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 46.62%; ROWS: 1" id=alp_nbrInputs class="hsc.alpha.1 Data_bold_left" title="" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:9;numericDisplayFormat:%.0f;styleClass:Data_bold_left;textColor:black;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if not sd.QualityGood("CurrentPoint.NOPINPTS") then
		exit sub 'leaving entire group hidden
	end if

	if me.value < 12 then
		alp_source12.style.visibility = "Hidden"
		alp_dest12.style.visibility = "Hidden"
	end if
	if me.value < 11 then
		alp_source11.style.visibility = "Hidden"
		alp_dest11.style.visibility = "Hidden"
	end if
	if me.value < 10 then
		alp_source10.style.visibility = "Hidden"
		alp_dest10.style.visibility = "Hidden"
	end if
	if me.value < 9 then
		alp_source9.style.visibility = "Hidden"
		alp_dest9.style.visibility = "Hidden"
	end if
	if me.value < 8 then
		combo_constat8.style.visibility = "Hidden"
		alp_accstat8.style.visibility = "Hidden"
		alp_source8.style.visibility = "Hidden"
		alp_dest8.style.visibility = "Hidden"
	end if
	if me.value < 7 then
		combo_constat7.style.visibility = "Hidden"
		alp_accstat7.style.visibility = "Hidden"
		alp_source7.style.visibility = "Hidden"
		alp_dest7.style.visibility = "Hidden"
	end if
	if me.value < 6 then
		combo_constat6.style.visibility = "Hidden"
		alp_accstat6.style.visibility = "Hidden"
		alp_source6.style.visibility = "Hidden"
		alp_dest6.style.visibility = "Hidden"
	end if
	if me.value < 5 then
		combo_constat5.style.visibility = "Hidden"
		alp_accstat5.style.visibility = "Hidden"
		alp_source5.style.visibility = "Hidden"
		alp_dest5.style.visibility = "Hidden"
	end if
	if me.value < 4 then
		combo_constat4.style.visibility = "Hidden"
		alp_accstat4.style.visibility = "Hidden"
		alp_source4.style.visibility = "Hidden"
		alp_dest4.style.visibility = "Hidden"
	end if
	if me.value < 3 then
		combo_constat3.style.visibility = "Hidden"
		alp_accstat3.style.visibility = "Hidden"
		alp_source3.style.visibility = "Hidden"
		alp_dest3.style.visibility = "Hidden"
	end if
	if me.value < 2 then
		combo_constat2.style.visibility = "Hidden"
		alp_accstat2.style.visibility = "Hidden"
		alp_source2.style.visibility = "Hidden"
		alp_dest2.style.visibility = "Hidden"
	end if
	if me.value < 1 then
		combo_constat1.style.visibility = "Hidden"
		alp_accstat1.style.visibility = "Hidden"
		alp_source1.style.visibility = "Hidden"
		alp_dest1.style.visibility = "Hidden"
	end if

	' if first combo_constat is bad, then this point type doesn't support the status (left two) columns
	if not sd.QualityGood("CurrentPoint.PIACTSTS(1)") then
		combo_constat1.style.visibility = "Hidden"
