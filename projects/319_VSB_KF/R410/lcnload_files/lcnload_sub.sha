<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="188px" height="142px"><versionheaders><versionheader name="PS" value="5.4"/></versionheaders><scripts><script event="" language="VBScript" id="BC1E1E61-CE46-4DBF-B3AF-0260C1DE4AB2"><![CDATA[dim parspermsg]]></script></scripts><parameters><parameter name="NodeName" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textbox001 style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 0.53%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 41.48%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 16.9%; HEIGHT: 14.78%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:78;">Nodetype:</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textbox002 style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 0.53%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 41.48%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 33.8%; HEIGHT: 14.78%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:78;">PARSEC=</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textbox003 style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 0.53%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 41.48%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 50.7%; HEIGHT: 14.78%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:78;">MSG/SEC=</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textbox004 style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 0.53%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 41.48%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 67.6%; HEIGHT: 14.78%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:78;">PAR/MSG=</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=textbox005 style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 0%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 41.48%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 84.5%; HEIGHT: 14.78%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:78;">CPUFREE=</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=rect001 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 39.89%; BEHAVIOR: url(#HDXVectorFactory#rect); OVERFLOW: hidden; WIDTH: 51.06%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 33.09%; HEIGHT: 12.67%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:#008000;fillColorBlink:False;Height:18;LineColor:#008000;lineColorBlink:False;Width:96;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=rect002 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 39.89%; BEHAVIOR: url(#HDXVectorFactory#rect); OVERFLOW: hidden; WIDTH: 51.06%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 49.29%; HEIGHT: 12.67%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:#008000;fillColorBlink:False;Height:18;LineColor:#008000;lineColorBlink:False;Width:96;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=rect003 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 39.89%; BEHAVIOR: url(#HDXVectorFactory#rect); OVERFLOW: hidden; WIDTH: 51.06%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 66.19%; HEIGHT: 12.67%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:#008000;fillColorBlink:False;Height:18;LineColor:#008000;lineColorBlink:False;Width:96;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.base.1 id=rect004 style="FONT-WEIGHT: 400; FONT-SIZE: 12pt; LEFT: 39.89%; BEHAVIOR: url(#HDXVectorFactory#rect); OVERFLOW: hidden; WIDTH: 51.06%; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 83.09%; HEIGHT: 12.67%; TEXT-DECORATION: none" tabIndex=-1 hdxproperties="FillColor:#008000;fillColorBlink:False;Height:18;LineColor:#008000;lineColorBlink:False;Width:96;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alpha_Parsec title="" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 42.02%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 48.4%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 33.09%; HEIGHT: 13.38%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numericDisplayFormat:%.2f;textColor:#000000;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[TxtLoad.style.visibility = "hidden"

if (alpha_CPUFree.Quality and &HFF ) = &HC0 then
	if alpha_CPUFree.value <= 65 then
		if alpha_CPUFree.value <=40 then
			TxtLoad.style.visibility = "inherit"
			TxtLoad.innertext = "Node: Heavy Load"
			TxtLoad.textColor = "YELLOW"
			TxtLoad.textColorBlink = false
			if alpha_CPUFree.value <=20 then
				TxtLoad.innertext = "Node: OVER LOAD"
				TxtLoad.textColor = "RED"
				TxtLoad.textColorBlink = true
			end if
		else
			if alpha_Parsec.value >= 175 then
				if alpha_requests.value > 35 then
					TxtLoad.style.visibility = "inherit"
					TxtLoad.textColor = "YELLOW"
					TxtLoad.textColorBlink = false
					TxtLoad.innertext = "High msg rate"
					if alpha_requests.value > 40 then
						TxtLoad.innertext = "Excessive msg rate"
						TxtLoad.textColor = "RED"
						TxtLoad.textColorBlink = true
					end if
				else
					if parspermsg < 50 then
						TxtLoad.style.visibility = "inherit"
						TxtLoad.textColor = "YELLOW"
						TxtLoad.textColorBlink = false
						TxtLoad.innertext = "Low msg efficiency"
						if parspermsg < 20 then
							TxtLoad.innertext = "VLow msg efficiency"
							TxtLoad.textColor = "RED"
							TxtLoad.textColorBlink = true
						end if
					end if
				end if
			end if 
		end if	
			
	end if

end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::NodeName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="parsec"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alpha_requests title="" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 42.02%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 48.4%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 48.59%; HEIGHT: 13.38%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numericDisplayFormat:%.2f;textColor:#000000;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[if ((me.Quality and &HFF ) = &HC0) and ((alpha_Parsec.Quality and &HFF ) = &HC0) then
	alpha_Parmsg.value = formatnumber(alpha_Parsec.value / me.value,2)
	parspermsg = alpha_Parsec.value / me.value
	if parspermsg < 100 then
		alpha_parmsg.textColor = "YELLOW"
	end if
	if parspermsg < 20 then
		alpha_parmsg.textColor = "RED"
	end if
	if parspermsg >= 100 then
		alpha_parmsg.textColor = "BLACK"
	end if
end if

TxtLoad.style.visibility = "hidden"

if (alpha_CPUFree.Quality and &HFF ) = &HC0 then
	if alpha_CPUFree.value <= 65 then
		if alpha_CPUFree.value <=40 then
			TxtLoad.style.visibility = "inherit"
			TxtLoad.innertext = "Node: Heavy Load"
			TxtLoad.textColor = "YELLOW"
			TxtLoad.textColorBlink = false
			if alpha_CPUFree.value <=20 then
				TxtLoad.innertext = "Node: OVER LOAD"
				TxtLoad.textColor = "RED"
				TxtLoad.textColorBlink = true
			end if
		else
			if alpha_Parsec.value >= 175 then
				if alpha_requests.value > 35 then
					TxtLoad.style.visibility = "inherit"
					TxtLoad.textColor = "YELLOW"
					TxtLoad.textColorBlink = false
					TxtLoad.innertext = "High msg rate"
					if alpha_requests.value > 40 then
						TxtLoad.innertext = "Excessive msg rate"
						TxtLoad.textColor = "RED"
						TxtLoad.textColorBlink = true
					end if
				else
					if parspermsg < 50 then
						TxtLoad.style.visibility = "inherit"
						TxtLoad.textColor = "YELLOW"
						TxtLoad.textColorBlink = false
						TxtLoad.innertext = "Low msg efficiency"
						if parspermsg.value < 20 then
							TxtLoad.innertext = "VLow msg efficiency"
							TxtLoad.textColor = "RED"
							TxtLoad.textColorBlink = true
						end if
					end if
				end if
			end if 
		end if	
			
	end if

end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::NodeName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="requests"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alpha_CPUFree title="" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 42.02%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 48.4%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 83.09%; HEIGHT: 13.38%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numericDisplayFormat:%.2f;textColor:#000000;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[if (me.Quality and &HFF ) = &HC0 then
	if me.value < 35 then
		rect004.fillColor = "YELLOW"
		rect004.lineColor = "GREEN"
		if me.value < 20 then
			rect004.fillColor = "RED"
			rect004.lineColor = "YELLOW"
		end if
	else
		rect004.fillColor = "GREEN"
		rect004.lineColor = "GREEN"
	end if
end if

	TxtLoad.style.visibility = "hidden"

if (alpha_CPUFree.Quality and &HFF ) = &HC0 then
	if alpha_CPUFree.value <= 60 then
		if alpha_CPUFree.value <=40 then
			TxtLoad.style.visibility = "inherit"
			TxtLoad.innertext = "Node: Heavy Load"
			TxtLoad.textColor = "YELLOW"
			TxtLoad.textColorBlink = false
			if alpha_CPUFree.value <=20 then
				TxtLoad.innertext = "Node: OVER LOAD"
				TxtLoad.textColor = "RED"
				TxtLoad.textColorBlink = true
			end if
		else
			if alpha_Parsec.value >= 175 then
				if alpha_requests.value > 35 then
					TxtLoad.style.visibility = "inherit"
					TxtLoad.textColor = "YELLOW"
					TxtLoad.textColorBlink = false
					TxtLoad.innertext = "High msg rate"
					if alpha_requests.value > 40 then
						TxtLoad.innertext = "Excessive msg rate"
						TxtLoad.textColor = "RED"
						TxtLoad.textColorBlink = true
					end if
				else
					if parspermsg < 50 then
						TxtLoad.style.visibility = "inherit"
						TxtLoad.textColor = "YELLOW"
						TxtLoad.textColorBlink = false
						TxtLoad.innertext = "Low msg efficiency"
						if parspermsg < 20 then
							TxtLoad.innertext = "VLow msg efficiency"
							TxtLoad.textColor = "RED"
							TxtLoad.textColorBlink = true
						end if
					end if
				end if
			end if 
		end if	
			
	end if

end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::NodeName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="cpufree"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=Nodetype style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 40.42%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 59.04%; COLOR: #e47301; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 17.6%; HEIGHT: 14.78%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:21;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#e47301;textColorBlink:False;TotalRotation:-1;Width:111;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alpha_nodetype style="FONT-WEIGHT: normal; FONT-SIZE: 9pt; LEFT: 44.14%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 38.29%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Arial; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 71.83%; HEIGHT: 9.15%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: center; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numericDisplayFormat:%.2f;textColor:#000000;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim node_type_string
if (alpha_CPUFree.Quality and &HFF ) = &HC0 then


select case me.value
	case	0
		node_type_string = "CG_"
	case	1
		node_type_string = "HG_"
	case	2
		node_type_string = "HM_"
	case 3
		node_type_string = "AM_"
	case 4
		node_type_string = "US_"
	case 8
		node_type_string = "NIM_"
	case 9
		node_type_string = "NG_"
	case else
		node_type_string = "unknown_"
end select
node_type_string =node_type_string & Right("{%point::nodename%}",2)
Nodetype.innertext = node_type_string

end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::NodeName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="nodetype"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=TxtLoad style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 0.53%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 96.27%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 0%; HEIGHT: 14.78%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:21;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:181;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=alpha_Parmsg style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 42.55%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 43.61%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Arial; POSITION: absolute; TOP: 66.9%; HEIGHT: 11.26%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:82;">Text</DIV>]]></content></html></element><html><content><![CDATA[
<DIV class=hvg.group.1 id=group001 style="FONT-SIZE: 0pt; LEFT: 24px; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 188px; POSITION: absolute; TOP: 7px; HEIGHT: 142px" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:142;lineColorBlink:False;Width:188;"></DIV>]]></content></html></group></shape></shapes></shapefile>