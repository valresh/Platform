<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="286px" height="48px"><versionheaders><versionheader name="PS" value="5.91"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[ntimer = window.setInterval("myfunction(group001)",500)]]></script><script event="" language="VBScript" id="8C97F32F-E79F-4A3B-A7E0-2BD0D79ABE2E"><![CDATA[dim ntimer 
dim sha, obj
function myfunction(sha)
set obj = sha.parentelement
if obj.objects("visi").value =1 then
	obj.style.visibility="visible"
	obj.style.Top=0 'position the group besides the navigation pane
	obj.style.Left=55 'position the group below the title bar
	obj.objects("rect4").style.posLeft=65 'moving the shaects diferently
	obj.objects("rect4").style.Top=0 'moving rect4 to match top and left coordinate of group
	obj.objects("pushbutton1").style.posLeft=65 'moving pushbutton1 to match top and left coordinate of group
	obj.objects("pushbutton1").style.Top=0
	obj.objects("rect4").style.width=890 'resizing rect4 to cover the required area without resizing the text
	obj.objects("rect4").style.height=780
	obj.objects("pushbutton1").style.width=890 'resizing rect4 to cover the required area without resizing the text
	obj.objects("pushbutton1").style.height=780
	obj.objects("text1").style.posTop=592 'aligning the text middle to the rect4
	obj.objects("text1").style.posLeft=174 'aligning the text center to the rect4
	For i=1 to page.all.length-1
		If (page.all(i).style.posLeft > obj.objects("rect4").style.posLeft) And (page.all(i).style.posTop > obj.objects("rect4").style.posTop) Then
			page.all(i).style.visibility = "hidden"
		End If 
		' this code is used to hide any objects beyond shapes boundary after resizing. 
	next 
	obj.objects("text1").style.visibility="visible"
end if
window.clearInterval(ntimer)
end function]]></script></scripts><shapes><shape><group><element><html><content><![CDATA[<INPUT style="BORDER-BOTTOM: #ffffff 1px; POSITION: absolute; TEXT-ALIGN: center; BORDER-LEFT: #ffffff 1px; BACKGROUND-COLOR: #ffffff; FONT-STYLE: normal; WIDTH: 100%; BACKGROUND-REPEAT: no-repeat; FONT-FAMILY: Helvetica; HEIGHT: 100%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 11pt; BORDER-TOP: #ffffff 1px; TOP: 0%; FONT-WEIGHT: normal; BORDER-RIGHT: #ffffff 1px; TEXT-DECORATION: none; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); LEFT: 0%" id=pushbutton1 class=hsc.button.1 tabIndex=-1 type=button hdxproperties="fillColor:#ffffff;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColor:#000000;textColorBlink:False;">]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="0"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value=""/><property name="TaskParam2" varianttype="VT_BSTR" value=""/><property name="TaskParam3" varianttype="VT_BSTR" value=""/><property name="TaskParam4" varianttype="VT_BSTR" value=""/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: center; FONT-STYLE: normal; WIDTH: 53.14%; FONT-FAMILY: Helvetica; HEIGHT: 41.66%; VISIBILITY: inherit; COLOR: #000000; FONT-SIZE: 12pt; OVERFLOW: hidden; TOP: 27.08%; FONT-WEIGHT: bold; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior); LEFT: 23.42%" id=text1 class=hvg.textbox.1 tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:20;indicateAlarmState:0;indicateScanState:0;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;value:;Width:152;">Option not licensed</DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV style="POSITION: absolute; FONT-STYLE: normal; WIDTH: 98.6%; FONT-FAMILY: Arial; HEIGHT: 97.91%; VISIBILITY: inherit; FONT-SIZE: 12pt; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: 400; TEXT-DECORATION: none; BEHAVIOR: url(#HDXVectorFactory#rect) url(#BindingBehavior); LEFT: 0.69%" id=rect4 class=hvg.base.1 tabIndex=-1 hdxproperties="FillColor:#ffffff;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:47;indicateAlarmState:0;indicateScanState:0;LineColor:transparent;lineColorBlink:False;Width:282;"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><element><html><content><![CDATA[<SPAN style="POSITION: absolute; TEXT-ALIGN: left; BACKGROUND-COLOR: transparent; WIDTH: 24.82%; FONT: 8pt Helvetica; HEIGHT: 37.5%; VISIBILITY: hidden; OVERFLOW: hidden; TOP: 54.16%; CURSOR: default; TEXT-DECORATION: none; BEHAVIOR: url(#HSCCheckBoxBehavior) url(#BindingBehavior); LEFT: 50.69%" id=visi class=hsc.checkbox.1 tabIndex=-1 hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;inverseLogic:0;textColor:#ff0000;textColorBlink:False;" printInverse="false" printValue="true"><INPUT style="BACKGROUND-COLOR: transparent; MARGIN: 1px" tabIndex=-1 type=checkbox></INPUT><SPAN style="COLOR: #ff0000">Visible</SPAN></SPAN>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="240"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.CheckBox" refcount="1"/></binding></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 286px; HEIGHT: 48px; FONT-SIZE: 0pt; TOP: 186px; BEHAVIOR: url(#HDXVectorFactory#group); LEFT: 103px" id=group001 class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:48;lineColorBlink:False;Width:286;"></DIV>]]></content></html></group></shape></shapes></shapefile>