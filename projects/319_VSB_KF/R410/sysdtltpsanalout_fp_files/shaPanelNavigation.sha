<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="46px" height="14px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="..\Styles\SysFaceplate.css"/></stylesheets><scripts><script event="" language="JScript" id="44E2F4AF-016E-4438-83E1-2015B17A2118"><![CDATA[var centerPanelCurrentPage = 1;
centerPanelCurrentDot = 1;
var centerPanelMaxPage = 5;
var centerPanelMaxPageConfigured = 5;
var oShape
var ColorTheme = 'Light';
var colorTheme = 1;
var bshow2ndPage = true;
var bshow3rdPage = true;
var bshow4thPage = true;
var PageContentBaseId = 'CenterPanelPage';

function calculateActualDots()
{

	//Calculate actual dots as per the boolean configured like show2ndPage, show3rdPage
	if (bshow2ndPage != true && centerPanelMaxPageConfigured >= 2)
	{
		centerPanelMaxPage = centerPanelMaxPage - 1
	}
	if (bshow3rdPage != true && centerPanelMaxPageConfigured >= 3)
	{
		centerPanelMaxPage = centerPanelMaxPage - 1
	}
	if (bshow4thPage != true && centerPanelMaxPageConfigured >= 4)
	{
		centerPanelMaxPage = centerPanelMaxPage - 1
	}

	//Once Actual dots calculated initialize the Navigation button with dots
	initializeNavButton()
}

function initializeNavButton()
{

	//Default hide all and show only dots which are applicable
	oShape.objects("btn" + ColorTheme + 'Closed').style.visibility = "inherit";

	switch (centerPanelMaxPage)
	{
		case 2:
			oShape.objects("dotSelected" + ColorTheme + 21).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 22).style.visibility = "inherit";
			break;
		case 3:
			oShape.objects("dotSelected" + ColorTheme + 31).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 32).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 33).style.visibility = "inherit";
			break;
		case 4:
			oShape.objects("dotSelected" + ColorTheme + 41).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 42).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 43).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 44).style.visibility = "inherit";
			break;
		case 5:
			oShape.objects("dotSelected" + ColorTheme + 51).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 52).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 53).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 54).style.visibility = "inherit";
			oShape.objects("dotUnselected" + ColorTheme + 55).style.visibility = "inherit";
			break;
		default:
			oShape.style.visibility = 'hidden';
	}
}

function PanelNavigation()
{

	// centerPanelCurrentDot to handle current dots to be selected.
	// centerPanelCurrentPage page to handle current Page to be shwon

	//Hide all
	centerPanelCurrentPage = centerPanelCurrentPage + 1;
	centerPanelCurrentDot = centerPanelCurrentDot + 1;


	//skipping current page based on the boolean configured like show2ndPage, show3rdPage and show4thPage
	if (bshow2ndPage != true && centerPanelCurrentPage < centerPanelMaxPageConfigured && centerPanelCurrentPage == 2)
	{
		centerPanelCurrentPage = centerPanelCurrentPage + 1;

	}
	if (bshow3rdPage != true && centerPanelCurrentPage < centerPanelMaxPageConfigured && centerPanelCurrentPage == 3)
	{
		centerPanelCurrentPage = centerPanelCurrentPage + 1;

	}
	if (bshow4thPage != true && centerPanelCurrentPage < centerPanelMaxPageConfigured && centerPanelCurrentPage == 4)
	{
		centerPanelCurrentPage = centerPanelCurrentPage + 1;
	}
	//Resetting the centerPanelCurrentPage to default in case centerPanelCurrentPage crossed the limit as per the boolean configured like show2ndPage, show3rdPage and show4thPage
	if (bshow2ndPage != true && centerPanelCurrentPage >= centerPanelMaxPageConfigured && centerPanelCurrentPage == 2)
	{
		centerPanelCurrentPage = 1
	}
	if (bshow3rdPage != true && centerPanelCurrentPage >= centerPanelMaxPageConfigured && centerPanelCurrentPage == 3)
	{
		centerPanelCurrentPage = 1
	}
	if (bshow4thPage != true && centerPanelCurrentPage >= centerPanelMaxPageConfigured && centerPanelCurrentPage == 4)
	{
		centerPanelCurrentPage = 1
	}

	//Applying the style to the button as per the Closed and Open Status, If the selected dots is other than 1 then its open button.
	if (centerPanelCurrentDot == 1)
	{
		oShape.objects("btn" + ColorTheme + 'Closed').style.visibility = "inherit";
	}
	else
	{
		oShape.objects("btn" + ColorTheme + 'Open').style.visibility = "inherit";
	}
	//Applying the style to the dots as per selected/unselected dots.
	for (var i = 1; i <= centerPanelMaxPage; i++)
	{
		if (i == centerPanelCurrentDot)
		{
			oShape.objects("dotSelected" + ColorTheme + centerPanelMaxPage + i).style.visibility = "inherit";
		}
		else
		{
			oShape.objects("dotUnselected" + ColorTheme + centerPanelMaxPage + i).style.visibility = "inherit";
		}
	}
	// Showing only the applicable page as per the selected dots
	for (obj in oShape.parentElement.children)
	{
		if (obj.toUpperCase().indexOf(PageContentBaseId) !== -1)
		{
			if (obj.slice(-1) == centerPanelCurrentPage)
			{
				document.getElementById(obj).style.display = "block"
				document.getElementById(obj).style.visibility = "Inherit";
			}
			else
			{
				document.getElementById(obj).style.display = "None"
				document.getElementById(obj).style.visibility = "Hidden";
			}
		}
	}
	// Resetting the centerPanelCurrentPage in case it ha crossed the max of configured page
	if (centerPanelCurrentPage >= centerPanelMaxPageConfigured)
	{
		centerPanelCurrentPage = 0;
	}
	// Resetting the dots in case it ha crossed the max of configured page
	if (centerPanelCurrentDot >= centerPanelMaxPage)
	{
		centerPanelCurrentDot = 0;
	}
}]]></script><script event="onshapeload" language="JScript" id=""><![CDATA[this.style.height = "13px";
this.style.width = "46px";
oShape = this;
//Read the custom propetry
centerPanelMaxPage = parseInt(oShape.GetCustomProperty("Value", "NumOfPages"))
centerPanelMaxPageConfigured = parseInt(oShape.GetCustomProperty("Value", "NumOfPages"))
PageContentBaseId = this.GetCustomProperty("Value", "CenterPanelPageBaseId").toUpperCase();
if (oShape.GetCustomProperty("Value", "show2ndPage").toUpperCase() != 'TRUE')
{
	bshow2ndPage = false
}
else
{
	bshow2ndPage = true
}
if (oShape.GetCustomProperty("Value", "show3rdPage").toUpperCase() != 'TRUE')
{
	bshow3rdPage = false
}
else
{
	bshow3rdPage = true
}
if (oShape.GetCustomProperty("Value", "show4thPage").toUpperCase() != 'TRUE')
{
	bshow4thPage = false
}
else
{
	bshow4thPage = true
}

if (window.external.application.ColorTheme == 1)
{
	ColorTheme = 'Dark';
}
else
{
	ColorTheme = 'Light';
}
calculateActualDots();]]></script></scripts><parameters><parameter name="NumOfPages" type="Value" description="Number of pages" defaultvalue="5"/><parameter name="show2ndPage" type="Value" description="Set to True or False to show the 2nd page" defaultvalue="True"/><parameter name="show3rdPage" type="Value" description="Set to True or False to show the 3rd page" defaultvalue="True"/><parameter name="show4thPage" type="Value" description="Set to True or False to show the 4th page" defaultvalue="True"/><parameter name="CenterPanelPageBaseId" type="Value" description="Panel page base id" defaultvalue="CenterPanelPage"/></parameters><shapes><shape><group><element><html><content><![CDATA[
