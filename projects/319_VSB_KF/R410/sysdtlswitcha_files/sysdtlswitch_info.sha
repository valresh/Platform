<?xml version="1.0"?>
<shapefile version="1" type="dynamic" title="Computer System Properties" description="System properties shape for computers detail display - simple version - as little scripting as possible" useFirstShapeForBadValue="0" width="604px" height="458px"><versionheaders><versionheader name="PS" value="5.1"/></versionheaders><scripts><script event="" language="VBScript" id="E8EF6CEB-B18B-42C7-929B-EF8C784ED2DE"><![CDATA['
' General Section (sysdtlswitch_info.sha)
Dim nBaseUptime
Dim sRememberedTarget
nBaseUptime = 0

sub InitSwitchInfo(objShape, sPoint, sTarget)

	on error resume next
	nBaseUptime = 0
'	sTarget = objShape.GetCustomProperty("Value", "SwitchTarget")
	if sRememberedTarget = sTarget then exit sub
	sRememberedTarget = sTarget
	if sTarget = "" then
		with objShape
			.autoReloadContent = false
			.SetCustomProperty "Parameter", "sysUpTime", ""
			.SetCustomProperty "Parameter", "sysContact", ""
			.SetCustomProperty "Parameter", "sysLocation", ""
			.SetCustomProperty "Parameter", "sysDescr", ""
			.SetCustomProperty "Parameter", "sysName", ""
			.SetCustomProperty "Point", "SPSPoint", ""
			.ReloadContent
		end with
	else
		with objShape
			.autoReloadContent = false
			.SetCustomProperty "Parameter", "sysUpTime", sTarget & ".sysUpTime"
			.SetCustomProperty "Parameter", "sysContact", sTarget & ".sysContact"
			.SetCustomProperty "Parameter", "sysLocation", sTarget & ".sysLocation"
			.SetCustomProperty "Parameter", "sysDescr", sTarget & ".sysDescr"
			.SetCustomProperty "Parameter", "sysName", sTarget & ".sysName"
			.SetCustomProperty "Point", "SPSPoint", sPoint
			.ReloadContent
		end with
	end if
end sub

function GetValidString( objVal, nType )

dim strVal

	on error resume next

	if NOT IsNull(objVal) And IsObject(objVal) then	
		if ((objVal.quality AND 192)=192) then
			strVal = MakeValidString(objVal.currentValue, nType)
			'MsgBox "GetValidString() - " & objVal.id & " - Quality Good: " & strVal
			GetValidString = strVal
		else
			'MsgBox "GetValidString() - " & objVal.id & " - Quality Bad (" & objVal.quality & ")"
			GetValidString = ""
			exit function
		end if
	else
		' MsgBox "GetValidString() - Invalid Object"
		GetValidString = ""
		exit function
	end if
end function


function MakeValidString( InVal, nType )

dim strVal

	on error resume next

	if IsNull(InVal) then
		' MsgBox "NULL"
		MakeValidString = ""
		exit function
	end if

	if IsEmpty(InVal) then 
		' MsgBox "Empty"
		MakeValidString = ""
		exit function
	end if
	
	Err.Clear	
	if nType = vbBoolean then
		strVal = CStr(CBool(InVal))
	else 
		if nType = vbDate then
			strVal = FormatDateTime(CDate(InVal),vbGeneralDate)
		else
			strVal = CStr(InVal)
		end if
	end if
	nAscVal = Asc(strVal)
	if Err.Number <> 0 then
		' MsgBox "MakeValidString Error: " & Err.Description
		Err.Clear
		MakeValidString = ""
		exit function
	else
		' MsgBox "MakeValidString() - " & strVal
		MakeValidString = strVal
	end if
	
end function
' General Section (sysdtlswitch_info.sha)
']]></script></scripts><parameters><parameter name="SwitchTarget" type="Value" description="Switch to show detail data for" defaultvalue=""/><parameter name="SPSPoint" type="Point" description="" defaultvalue=""/><parameter name="sysUpTime" type="Parameter" description="" defaultvalue=""/><parameter name="sysContact" type="Parameter" description="" defaultvalue=""/><parameter name="sysLocation" type="Parameter" description="" defaultvalue=""/><parameter name="sysDescr" type="Parameter" description="" defaultvalue=""/><parameter name="sysName" type="Parameter" description="" defaultvalue=""/><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/></parameters><shapes><shape><group><group><element><html><content><![CDATA[<TEXTAREA class="hsc.alpha.1 HSC.ScriptDataObject.1" id=alphaUpTime title="" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 17.72%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 82.28%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 0%; HEIGHT: 114.81%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: normal; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=-1 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[Dim nVal, sDataPath, dateVal, fDataFlag

	on error resume next
	sDataPath = "{%Point::SPSPoint%}.{%Parameter::sysUpTime%}"
	Err.clear
	fDataFlag = me.QualityGood(sDataPath)
	if err.number = 0 and fDataFlag then
		Err.clear
		fDataFlag = me.DataChanged(sDataPath)
		if err.number = 0 and fDataFlag then
			Err.clear
			nVal = int(me.DataValue(sDataPath))
			if err.number <> 0 then exit sub
			' if this is first time or sysUpTime has reset, do this calculation
			if (nBaseUptime = 0) or (nVal < nBaseUptime) then
				nBaseUptime = nVal
				dateVal = DateAdd("s", 0 - (nVal /100), Now())
				me.value = dateVal
				me.style.visibility = "inherit"
			end if
		end if
	end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SPSPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::sysUpTime%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="10,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV class=hvg.textbox.1 id=txtUpTime style="FONT-WEIGHT: normal; FONT-SIZE: 10pt; LEFT: 0%; BEHAVIOR: url(#HDXVectorFactory#text); OVERFLOW: hidden; WIDTH: 15.73%; COLOR: #000000; FONT-STYLE: normal; FONT-FAMILY: Tahoma; POSITION: absolute; TOP: 0%; HEIGHT: 74.07%; TEXT-ALIGN: left" tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:20;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:95;">Up since:</DIV>]]></content></html></element><html><content><![CDATA[
<DIV class=hvg.group.1 id=grpUpTime style="FONT-SIZE: 0pt; LEFT: 0%; BEHAVIOR: url(#HDXVectorFactory#group); WIDTH: 100%; POSITION: absolute; TOP: 93.88%; HEIGHT: 5.89%" tabIndex=-1 hdxproperties="fillColorBlink:False;Height:27;lineColorBlink:False;Width:604;"></DIV>]]></content></html></group><group><element><html><content><![CDATA[<TEXTAREA class=hsc.alpha.1 id=alphaContact title="" style="FONT-WEIGHT: bold; FONT-SIZE: 10pt; LEFT: 17.72%; VISIBILITY: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); OVERFLOW: hidden; WIDTH: 82.28%; COLOR: #000000; BORDER-TOP-STYLE: none; FONT-STYLE: normal; FONT-FAMILY: Tahoma; BORDER-RIGHT-STYLE: none; BORDER-LEFT-STYLE: none; POSITION: absolute; TOP: 0%; HEIGHT: 108.6%; BACKGROUND-COLOR: transparent; TEXT-ALIGN: left; TEXT-DECORATION: none; WORD-WRAP: break-word; BORDER-BOTTOM-STYLE: none; ROWS: 1" tabIndex=-1 hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:120;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	on error resume next
	me.value = GetValidString(me,vbString)
	me.style.visibility = "inherit"]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="10"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::SPSPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::sysContact%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[
