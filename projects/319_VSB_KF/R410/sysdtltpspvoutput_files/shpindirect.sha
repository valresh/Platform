<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="160px" height="50px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><parameters><parameter name="mypoint" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="mybefaftidname" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/><parameter name="myeippcodename" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/><parameter name="myprimmodname" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/><parameter name="boxpoint" type="Point" description="" defaultvalue=""/><parameter name="myboxntwkname" type="Parameter" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BACKGROUND-COLOR: transparent; BORDER-LEFT-STYLE: none; WIDTH: 99.37%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 32%; COLOR: black; BORDER-RIGHT-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); TOP: 0%; LEFT: 0%; ROWS: 1" id=BEFAFTID class="hsc.alpha.1 Data_value_left" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 then
			shpanamain.objects("txtBEFAFTID").innerText = me.innerText
		else
			shpanamain.objects("txtBEFAFTID").innerText = ""
		end if
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::mybefaftidname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BACKGROUND-COLOR: transparent; BORDER-LEFT-STYLE: none; WIDTH: 99.37%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 32%; COLOR: black; BORDER-RIGHT-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); TOP: 24%; LEFT: 0%; ROWS: 1" id=EIPPCODE class="hsc.alpha.1 Data_value_left" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 then
			shpanamain.objects("txtEIPPCODE").innerText = me.innerText
			shpanamain.objects("txtLabelEIPPCODE").innerText = "EIP" & "PCODE:" 'dont ask
			shpanamain.objects("GrpEIPPCODE").style.visibility = "Inherit"
		else
			shpanamain.objects("GrpEIPPCODE").style.visibility = "Hidden"
			shpanamain.objects("txtEIPPCODE").innerText = ""
			shpanamain.objects("txtLabelEIPPCODE").innerText = ""

		end if
		call UpdatePointData2Group
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myeippcodename%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BACKGROUND-COLOR: transparent; BORDER-LEFT-STYLE: none; WIDTH: 99.37%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 32%; COLOR: black; BORDER-RIGHT-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); TOP: 48%; LEFT: 0%; ROWS: 1" id=PRIMMOD class="hsc.alpha.1 Data_value_left" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 then
			shpanamain.objects("txtPRIMMOD").innerText = me.innerText
			shpanamain.objects("txtLabelPRIMMOD").innerText = "PRI" & "MMOD:" 'dont ask
			shpanamain.objects("GrpPRIMMOD").style.visibility = "Inherit"
		else
			shpanamain.objects("GrpPRIMMOD").style.visibility = "Hidden"
			shpanamain.objects("txtPRIMMOD").innerText = ""
			shpanamain.objects("txtLabelPRIMMOD").innerText = ""

		end if
		call UpdateGeneralGroup
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myprimmodname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BACKGROUND-COLOR: transparent; BORDER-LEFT-STYLE: none; WIDTH: 99.37%; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 32%; COLOR: black; BORDER-RIGHT-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); TOP: 68%; LEFT: 0%; ROWS: 1" id=BOXNTWK class="hsc.alpha.1 Data_value_left" tabIndex=0 hdxproperties="durationFormat:-1;fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:Data_value_left;textColor:black;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if me.value = "FTE" then
		window.external.parent.logmessage "$BOXNTWK is FTE: this is an EHB point"
		g_bEmulatedHG = TRUE
	else
		window.external.parent.logmessage "$BOXNTWK is >>" & me.value & "<< this is NOT an EHB point"		
	end if

	call UpdateEHBStatus()]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::boxpoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myboxntwkname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV style="POSITION: absolute; WIDTH: 160px; HEIGHT: 50px; FONT-SIZE: 0pt; BEHAVIOR: url(#HDXVectorFactory#group); TOP: 31px; LEFT: 46px" id=group001 class=hvg.group.1 tabIndex=-1 hdxproperties="fillColorBlink:False;Height:50;lineColorBlink:False;Width:160;"></DIV>]]></content></html></group></shape></shapes></shapefile>