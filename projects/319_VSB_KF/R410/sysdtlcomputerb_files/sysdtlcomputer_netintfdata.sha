<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="148px" height="194px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="VBScript" id="E20DA3CC-0F27-46AB-95FC-18A835AC64BA"><![CDATA['
' General Section (sysdtlcomputer_net_interface.sha)
option explicit
Dim sAutoconfig
Dim sAutoconfigActive
Dim sHaveWins
Dim sWinsPrimaryServer
Dim sWinsSecondaryServer
Dim sDhcpServer
Dim sDhcpEnabled

sub InitNetIntfData(objMe, sAdapKey, sAdapName, sAdapPath)
Dim objArray, sPoint

'	AddToDiagMsg vbcrlf & "in InitNetIntfData: objMe.id=""" & objMe.id & """"
	objMe.autoReloadContent = false
	objMe.SetCustomProperty "Value", "AdapterKey", sAdapKey
	if sAdapPath = "" then
		RemoveTreeRoot sAdapKey
		objMe.SetCustomProperty "Point", "SPSPoint", ""
		objMe.SetCustomProperty "Parameter", "paramFriendlyName", ""
		objMe.SetCustomProperty "Parameter", "paramFteEnabled", ""
		objMe.SetCustomProperty "Parameter", "paramIPConnectionMetric", ""
		objMe.SetCustomProperty "Parameter", "paramDynamicDNSRegistrationEnabled", ""
		objMe.SetCustomProperty "Parameter", "paramCurrentDNSServer", ""
		objMe.SetCustomProperty "Parameter", "paramGatewayAddress0", ""
		objMe.SetCustomProperty "Parameter", "paramIPSubnetMask0", ""
		objMe.SetCustomProperty "Parameter", "paramOperStatus", ""
		objMe.SetCustomProperty "Parameter", "paramMACAddress", ""
		objMe.SetCustomProperty "Parameter", "paramDescription", ""
		objMe.SetCustomProperty "Parameter", "paramSpeedDuplexDescription", ""
		objMe.SetCustomProperty "Parameter", "paramDriverVersion", ""
		objMe.SetCustomProperty "Parameter", "paramPreferenceOrder", ""
		objMe.SetCustomProperty "Parameter", "paramDriverDescription", ""
		objMe.SetCustomProperty "Parameter", "paramDNSSuffix", ""
		objMe.SetCustomProperty "Parameter", "paramDhcpEnabled", ""
		objMe.SetCustomProperty "Parameter", "paramDHCPServer", ""
		objMe.SetCustomProperty "Parameter", "paramAutoconfigEnabled", ""
		objMe.SetCustomProperty "Parameter", "paramAutoconfigActive", ""
		objMe.SetCustomProperty "Parameter", "paramHaveWins", ""
		objMe.SetCustomProperty "Parameter", "paramPrimaryWinsServer", ""
		objMe.SetCustomProperty "Parameter", "paramSecondaryWinsServer", ""
		objMe.SetCustomProperty "Parameter", "paramDNSServerName0", ""
		objMe.SetCustomProperty "Parameter", "paramDNSServerName1", ""
		objMe.SetCustomProperty "Parameter", "paramDNSServerName2", ""
		objMe.SetCustomProperty "Parameter", "paramIPAddress0", ""
		objMe.SetCustomProperty "Parameter", "paramIPAddress1", ""
		objMe.SetCustomProperty "Parameter", "paramIPAddress2", ""
		objMe.SetCustomProperty "Parameter", "paramDNSSuffixSearch0", ""
		objMe.autoReloadContent = true	' cause data refresh - doesn't work if moved down 1 line
		objMe.SetCustomProperty "Parameter", "paramDNSSuffixSearch1", ""
		objMe.SetCustomProperty "Parameter", "paramDNSSuffixSearch2", ""
'FTE Physical adapters (yellow/green) link/duplex
		objMe.SetCustomProperty "Parameter", "paramBoundAdapterFriendlyNames0", ""
		objMe.SetCustomProperty "Parameter", "paramBoundAdapterFriendlyNames1", ""
		objMe.SetCustomProperty "Parameter", "paramBoundSpeedDuplexDescriptions0", ""
		objMe.SetCustomProperty "Parameter", "paramBoundSpeedDuplexDescriptions1", ""

	else
		AddTreeRoot sAdapKey, sAdapName
		objMe.SetCustomProperty "Parameter", "paramFriendlyName", sAdapPath & ".sFriendlyName"
		objMe.SetCustomProperty "Parameter", "paramFteEnabled", sAdapPath & ".bFteEnabled"
		objMe.SetCustomProperty "Parameter", "paramIPConnectionMetric", sAdapPath & ".sIPConnectionMetric"
		objMe.SetCustomProperty "Parameter", "paramDynamicDNSRegistrationEnabled", sAdapPath & ".bDynamicDNSRegistrationEnabled"
		objMe.SetCustomProperty "Parameter", "paramCurrentDNSServer", sAdapPath & ".sCurrentDNSServer"
		objMe.SetCustomProperty "Parameter", "paramGatewayAddress0", sAdapPath & ".sGatewayAddresses.0"
		objMe.SetCustomProperty "Parameter", "paramIPSubnetMask0", sAdapPath & ".sIPSubnetMasks.0"
		objMe.SetCustomProperty "Parameter", "paramOperStatus", sAdapPath & ".sOperStatus"
		objMe.SetCustomProperty "Parameter", "paramMACAddress", sAdapPath & ".sMACAddress"
		objMe.SetCustomProperty "Parameter", "paramDescription", sAdapPath & ".sDescription"
		objMe.SetCustomProperty "Parameter", "paramSpeedDuplexDescription", sAdapPath & ".sSpeedDuplexDescription"
		objMe.SetCustomProperty "Parameter", "paramDriverVersion", sAdapPath & ".sDriverVersion"
		objMe.SetCustomProperty "Parameter", "paramPreferenceOrder", sAdapPath & ".nPreferenceOrder"
		objMe.SetCustomProperty "Parameter", "paramDriverDescription", sAdapPath & ".sDriverDescription"
		objMe.SetCustomProperty "Parameter", "paramDNSSuffix", sAdapPath & ".sDNSSuffix"
		objMe.SetCustomProperty "Parameter", "paramDhcpEnabled", sAdapPath & ".bDhcpEnabled"
		objMe.SetCustomProperty "Parameter", "paramDHCPServer", sAdapPath & ".sDhcpServer"
		objMe.SetCustomProperty "Parameter", "paramAutoconfigEnabled", sAdapPath & ".bAutoconfigEnabled"
		objMe.SetCustomProperty "Parameter", "paramAutoconfigActive", sAdapPath & ".bAutoconfigActive"
		objMe.SetCustomProperty "Parameter", "paramHaveWins", sAdapPath & ".bHaveWins"
		objMe.SetCustomProperty "Parameter", "paramPrimaryWinsServer", sAdapPath & ".sPrimaryWinsServer"
		objMe.SetCustomProperty "Parameter", "paramSecondaryWinsServer", sAdapPath & ".sSecondaryWinsServer"
		objMe.SetCustomProperty "Parameter", "paramDNSServerName0", sAdapPath & ".sDNSServers.0"
		objMe.SetCustomProperty "Parameter", "paramDNSServerName1", sAdapPath & ".sDNSServers.1"
		objMe.SetCustomProperty "Parameter", "paramDNSServerName2", sAdapPath & ".sDNSServers.2"
		objMe.SetCustomProperty "Parameter", "paramIPAddress0", sAdapPath & ".sIPAddresses.0"
		objMe.SetCustomProperty "Parameter", "paramIPAddress1", sAdapPath & ".sIPAddresses.1"
		objMe.SetCustomProperty "Parameter", "paramIPAddress2", sAdapPath & ".sIPAddresses.2"
		objMe.SetCustomProperty "Parameter", "paramDNSSuffixSearch0", sAdapPath & ".sDNSSuffixSearchList.0"
		objMe.SetCustomProperty "Parameter", "paramDNSSuffixSearch1", sAdapPath & ".sDNSSuffixSearchList.1"
		objMe.autoReloadContent = true	' cause data refresh - doesn't work if moved down 1 line
		objMe.SetCustomProperty "Parameter", "paramDNSSuffixSearch2", sAdapPath & ".sDNSSuffixSearchList.2"
		objMe.SetCustomProperty "Point", "SPSPoint", objMe.GetCustomProperty("Point", "CurrentPoint")
'FTE Physical adapters (yellow/green) link/duplex
		objMe.SetCustomProperty "Parameter", "paramBoundAdapterFriendlyNames0",  sAdapPath & ".sBoundAdapterFriendlyNames.0"
		objMe.SetCustomProperty "Parameter", "paramBoundAdapterFriendlyNames1",  sAdapPath & ".sBoundAdapterFriendlyNames.1"
		objMe.SetCustomProperty "Parameter", "paramBoundSpeedDuplexDescriptions0",  sAdapPath & ".sBoundSpeedDuplexDescriptions.0"
		objMe.SetCustomProperty "Parameter", "paramBoundSpeedDuplexDescriptions1",  sAdapPath & ".sBoundSpeedDuplexDescriptions.1"

	end if

end sub

sub UpdateWinsDisplay(sAdapKey)
	if sHaveWins <> "" then
		netintfdata_AddNetTreeProp sAdapKey, "", "WINSROOT", "WINS", "", ""
		netintfdata_AddNetTreeProp sAdapKey, "WINSROOT", "WINSENABLED", "Enabled", "WINSENABLEDVAL", sHaveWins
	end if

	if sHaveWins = "True" and sWinsPrimaryServer <> "" then
		netintfdata_AddNetTreeProp sAdapKey, "WINSROOT", "WINSPRIMSERVER", "Primary Server", "WINSPRIMSERVERVAL", sWinsPrimaryServer
	else
		netintfdata_AddNetTreeProp sAdapKey, "WINSROOT", "WINSPRIMSERVER", "", "", ""
	end if

	if sHaveWins = "True" and sWinsSecondaryServer <> "" then
		netintfdata_AddNetTreeProp sAdapKey, "WINSROOT", "WINSSECSERVER", "Secondary Server", "WINSSECSERVERVAL", sWinsSecondaryServer
	else
		netintfdata_AddNetTreeProp sAdapKey, "WINSROOT", "WINSSECSERVER", "", "", ""
	end if
end sub

Sub UpdateDhcp(sAdapKey)
	if sDhcpEnabled <> "" then
		netintfdata_AddNetTreeProp sAdapKey, "", "DHCPROOT", "DHCP", "", ""
		netintfdata_AddNetTreeProp sAdapKey, "DHCPROOT", "DHCPENABLED", "Enabled", "DHCPENABLEDVAL", sDhcpEnabled
	else
		netintfdata_AddNetTreeProp sAdapKey, "", "DHCPROOT", "", "", ""
	end if
	if sDhcpEnabled = "True" and sDhcpServer <> "" then
		netintfdata_AddNetTreeProp sAdapKey, "DHCPROOT", "DHCPSERVER", "DHCP Server", "DHCPSERVERVAL", sDhcpServer
	else
		netintfdata_AddNetTreeProp sAdapKey, "DHCPROOT", "DHCPSERVER", "", "", ""
	end if
End Sub

Sub UpdateAutoconfig(sAdapKey)
	if sAutoconfig <> "" then
		netintfdata_AddNetTreeProp sAdapKey, "", "AUTOCONFIGROOT", "Auto-Configure", "", ""
		netintfdata_AddNetTreeProp sAdapKey, "AUTOCONFIGROOT", "AUTOCONFIGENABLED", "Enabled", "AUTOCONFIGENABLEDVAL", sAutoconfig
	else
		netintfdata_AddNetTreeProp sAdapKey, "AUTOCONFIGROOT", "", "", "", ""
	end if
	if sAutoconfig = "True" and sAutoconfigActive <> "" then
		netintfdata_AddNetTreeProp sAdapKey, "AUTOCONFIGROOT", "AUTOCONFIGACTIVE", "Active", "AUTOCONFIGACTIVEVAL", sAutoconfigActive
	else
		netintfdata_AddNetTreeProp sAdapKey, "AUTOCONFIGROOT", "AUTOCONFIGACTIVE", "", "", ""
	end if
End Sub

sub UpdateDNSSuffixSearch(sAdapKey, nIx, objMe)
Dim sVal
	on error resume next
	sVal = GetValidString(objMe, vbString)
	if sVal <> "" then netintfdata_AddNetTreeProp sAdapKey, "", "DNSROOT", "DNS", "", ""
	netintfdata_AddNetTreeProp sAdapKey, "DNSROOT", "DNSSUFFIXCATEGORY", "Suffix Search List", "DNSSEARCHSUFFIX" & nIx, sVal
end sub

sub UpdateIPAddress(sAdapKey, nIx, objMe)
Dim sVal
	on error resume next
	sVal = GetValidString(objMe, vbString)
	if sVal <> "" then netintfdata_AddNetTreeProp sAdapKey, "", "IPADDRESSROOT", "IP Addresses", "", ""
	netintfdata_AddNetTreeProp sAdapKey, "IPADDRESSROOT", "IPADDRESS" & nIx, sVal, "", ""
end sub

sub UpdateDNSServerName(sAdapKey, nIx, objMe)
Dim sVal
	on error resume next
	sVal = GetValidString(objMe, vbString)
	if sVal <> "" then netintfdata_AddNetTreeProp sAdapKey, "", "DNSROOT", "DNS", "", ""
	netintfdata_AddNetTreeProp sAdapKey, "DNSROOT", "DNSSERVERS", "DNS Servers", "DNSSERVER" & nIx, sVal
end sub
' End General Section (sysdtlcomputer_net_interface.sha)
']]></script></scripts><parameters><parameter name="CurrentPoint" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="paramFriendlyName" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="SPSPoint" type="Point" description="" defaultvalue=""/><parameter name="AdapterKey" type="Value" description="" defaultvalue=""/><parameter name="paramFteEnabled" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramIPConnectionMetric" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDynamicDNSRegistrationEnabled" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramCurrentDNSServer" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramGatewayAddress0" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramIPSubnetMask0" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramOperStatus" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramMACAddress" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDescription" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramSpeedDuplexDescription" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDriverVersion" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramPreferenceOrder" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDriverDescription" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDNSSuffix" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDhcpEnabled" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDHCPServer" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramAutoconfigEnabled" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramAutoconfigActive" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramHaveWins" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramPrimaryWinsServer" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramSecondaryWinsServer" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDNSServerName2" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDNSServerName1" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDNSServerName0" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramIPAddress2" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramIPAddress1" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramIPAddress0" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDNSSuffixSearch2" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDNSSuffixSearch1" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramDNSSuffixSearch0" type="Parameter" description="Automatically added Parameter" defaultvalue=""/><parameter name="paramBoundAdapterFriendlyNames0" type="Parameter" description="" defaultvalue=""/><parameter name="paramBoundAdapterFriendlyNames1" type="Parameter" description="" defaultvalue=""/><parameter name="paramBoundSpeedDuplexDescriptions0" type="Parameter" description="" defaultvalue=""/><parameter name="paramBoundSpeedDuplexDescriptions1" type="Parameter" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV style="POSITION: absolute; TEXT-ALIGN: left; FONT-STYLE: normal; WIDTH: 32.43%; FONT-FAMILY: Tahoma; HEIGHT: 7.73%; VISIBILITY: hidden; COLOR: #000000; FONT-SIZE: 8pt; OVERFLOW: hidden; TOP: 91.75%; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXVectorFactory#text); LEFT: 67.56%" id=textNoneValue class=hvg.textbox.1 tabIndex=-1 hdxproperties="fillColorBlink:False;FillStyle:1;Height:15;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:48;">&lt;none&gt;</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: #afeeee; FONT-STYLE: normal; WIDTH: 32.43%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 7.73%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 74.22%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); LEFT: 67.56%; ROWS: 1" id=alphaWinsSecondaryServer class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:#afeeee;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
