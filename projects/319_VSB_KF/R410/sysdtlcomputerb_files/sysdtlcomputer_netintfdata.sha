Dim sVal
'	AddToDiagMsg vbcrlf & "In " & me.id
	sVal = GetValidString(me, vbString)
	if sVal <> "" then
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "SUBNETMASKROOT", "Subnet Mask", "SUBNETMASKVAL", sVal
	else
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "SUBNETMASKROOT", "", "", ""
	end if
' end sub alphaSubnetMask0_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramIPSubnetMask0%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: #afeeee; FONT-STYLE: normal; WIDTH: 32.43%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 7.73%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 41.23%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); LEFT: 67.56%; ROWS: 1" id=alphaOperStatus class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:#afeeee;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
' sub alphaOperStatus_onupdate
Dim sVal
'	AddToDiagMsg vbcrlf & "In " & me.id
	sVal = GetValidString(me, vbString)
	if sVal <> "" then
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "OPERSTATUSROOT", "Operational Status", "OPERSTATUSVAL", sVal
	else
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "OPERSTATUSROOT", "", "", ""
	end if
' end sub alphaOperStatus_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramOperStatus%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: #afeeee; FONT-STYLE: normal; WIDTH: 32.43%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 7.73%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 32.98%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); LEFT: 67.56%; ROWS: 1" id=alphaMACAddress class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:#afeeee;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[' sub alphaMACAddress_onupdate
Dim sVal
Dim sFriendlyName
sFriendlyName = alphaFriendlyName.value 'e.g. Honeywell FTE Adapter

'	AddToDiagMsg vbcrlf & "In " & me.id
	sVal = GetValidString(me, vbString)
	if sVal <> "" then
		if InStr(sFriendlyName, "FTE") <> 0 then
			netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "MACADDRROOT", "Honeywell FTE MUX MAC Address", "MACADDRVAL", sVal			
		else
			netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "MACADDRROOT", "MAC Address", "MACADDRVAL", sVal
	 	end if
	else
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "MACADDRROOT", "", "", ""
	end if
' end sub alphaMACAddress_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramMACAddress%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: #afeeee; FONT-STYLE: normal; WIDTH: 32.43%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 7.73%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 24.74%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); LEFT: 67.56%; ROWS: 1" id=alphaIPConnectionMetric class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:#afeeee;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
