' sub alphaFteEnabled_onupdate
Dim sVal
'	AddToDiagMsg vbcrlf & "In " & me.id
	sVal = GetValidString(me, vbBoolean)
	if sVal = "True" then
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "FTEROOT", "FTE", "FTEENABLED", "Enabled"
	elseif sVal = "False" then
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "FTEROOT", "FTE", "FTEENABLED", "Disabled"
	else
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "FTEROOT", "", "", ""
	end if
' end sub alphaFteEnabled_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramFteEnabled%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: #afeeee; FONT-STYLE: normal; WIDTH: 32.43%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 7.73%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 57.73%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); LEFT: 33.78%; ROWS: 1" id=alphaDriverVersion class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:#afeeee;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
' sub alphaDriverVersion_onupdate
Dim sVal
'	AddToDiagMsg vbcrlf & "In " & me.id
	sVal = ""
	if IsStsGoodQuality(me) then
		sVal = MakeValidString(me.value, vbString)
		if sVal <> "" then netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "DRIVERROOT", "Driver", "", ""
	end if
	if sVal <> "" then
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "DRIVERROOT", "DRIVERVERSION", "Version", "DRIVERVERSIONVAL", sVal
	else
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "DRIVERROOT", "DRIVERVERSION", "", "", ""
	end if
' end sub alphaDriverVersion_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramDriverVersion%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: #afeeee; FONT-STYLE: normal; WIDTH: 32.43%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 7.73%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 49.48%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); LEFT: 33.78%; ROWS: 1" id=alphaDriverSpeedDuplexDescription class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:#afeeee;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
' sub alphaDriverSpeedDuplexDescription_onupdate
Dim sVal
Dim sFriendlyName

	sFriendlyName = alphaFriendlyName.value
'	AddToDiagMsg vbcrlf & "In " & me.id
	sVal = ""
	if IsStsGoodQuality(me) then
		sVal = MakeValidString(me.value, vbString)
		if sVal <> "" then netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "DRIVERROOT", "Driver", "", ""
	end if
	if sVal <> "" then
		if InStr(sFriendlyName, "FTE") <> 0 then
			netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "DRIVERROOT", "SPEEDDUPLEX", "Speed/Duplex", "SPEEDDUPLEXVAL", "N/A (see Physical Adapters)"
		else
			netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "DRIVERROOT", "SPEEDDUPLEX", "Speed/Duplex", "SPEEDDUPLEXVAL", sVal
		end if
	else
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "DRIVERROOT", "SPEEDDUPLEX", "", "", ""
	end if
' end sub alphaDriverSpeedDuplexDescription_onupdate
']]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramSpeedDuplexDescription%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: #afeeee; FONT-STYLE: normal; WIDTH: 32.43%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 7.73%; COLOR: #000000; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 41.23%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); LEFT: 33.78%; ROWS: 1" id=alphaDriverPreferenceOrder class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:#afeeee;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;numberOfChars:100;numericDisplayFormat:%s;textColor:#000000;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['
' sub alphaDriverPreferenceOrder_onupdate
Dim sVal
'	AddToDiagMsg vbcrlf & "In " & me.id
	sVal = ""
	if IsStsGoodQuality(me) then
		sVal = MakeValidString(me.value, vbString)
		if sVal <> "" then netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "", "DRIVERROOT", "Driver", "", ""
	end if
	if sVal <> "" then
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "DRIVERROOT", "PREFERENCEORDERROOT", "Preference Order", "PREFERENCEORDER", sVal
	else
		netintfdata_AddNetTreeProp "{%Value::AdapterKey%}", "DRIVERROOT", "PREFERENCEORDERROOT", "", "", ""
