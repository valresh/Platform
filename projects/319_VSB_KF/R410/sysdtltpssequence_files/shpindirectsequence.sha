<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="170px" height="16px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><parameters><parameter name="mypoint" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="myprimmodname" type="Parameter" description="Automatically added Parameter" defaultvalue="NAME"/></parameters><shapes><shape><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 170px; FONT-FAMILY: Verdana; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 16px; VISIBILITY: hidden; COLOR: black; FONT-SIZE: 12pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 16px; FONT-WEIGHT: normal; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 15px; ROWS: 1" id=PRIMMOD class="hsc.alpha.1 " tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:32;numericDisplayFormat:%s;styleClass:;textColor:black;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[	if bDynamicUpdateOK = true then
		if (me.quality and &HFF) = &HC0 then
			me.style.visibility = "Inherit"
		else
			me.style.visibility = "Hidden"
		end if
	end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::mypoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::myprimmodname%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element></shape></shapes></shapefile>