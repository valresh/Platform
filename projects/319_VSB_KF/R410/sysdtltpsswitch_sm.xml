	<menuitem id="mnu_ss" acceleratorKey="">
		<script type="onclick">
			if (window.external.application.CurrentPointID == null)
				window.external.application.currentpage='sysCfgAlarmSuppression.htm';
			else
			{
				var pointName = String(window.external.application.CurrentPointID);
				window.external.application.currentpage='sysCfgAlarmSuppression.htm?PointName=' + pointName;
			}
			window.external.CloseShortcutMenu();
		</script>
		<script type="onpage">
			if( !window.external.IsAccessPermitted( window.external.parentWindow.document.activeElement ))
				this.disabled=true;
			return true;
		</script>
		<text>Suppression Status</text>
		<image>.\Images\SuppressionStatus.gif</image>
	</menuitem>
