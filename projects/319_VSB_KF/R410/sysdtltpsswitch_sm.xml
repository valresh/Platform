	<menuitem id="mnu_ah" acceleratorKey="">
		<script type="onclick">
		   	if (window.external.application.CurrentPointID != null &amp;&amp; window.external.application.CurrentPointID != '')
		   	{
                   			   var wmSingleWindow = 0; // single window mode
			                   var wmMultiWindow  = 1; // multi window mode
			                   var ptSchematic    = 0;    // schematic popup type
			                   var ptFaceplate    = 1;    // faceplate popup type
			                   var displayName = 'sysalarmhelp?PointName=' + String(window.external.application.CurrentPointID);
			                   if (window.external.application.WindowMode === wmSingleWindow) {
			                          window.external.application.InvokePopup2(displayName, 0, 0, ptSchematic, false);
			                   } else if (window.external.application.WindowMode === wmMultiWindow) {
			                          window.external.application.currentpage = displayName;
		                   }
			}
			window.external.CloseShortcutMenu();
		</script>
		<script type="onpage">
			if( !window.external.IsAccessPermitted( window.external.parentWindow.document.activeElement ))
				this.disabled=true;
			return true;
		</script>
		<text>Alarm Help</text>
		<image>.\Images\AlarmHelp.gif</image>
	</menuitem>
