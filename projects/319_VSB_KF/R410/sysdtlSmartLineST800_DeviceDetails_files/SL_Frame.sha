<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="1276px" height="850px"><versionheaders><versionheader name="PS" value="6.21"/></versionheaders><stylesheets><stylesheet src=".\Styles\SmartLineStyles.css"/></stylesheets><scripts><script event="onshapeload" language="JScript" id=""><![CDATA[	SL_LogEvent(this, "onshapeload");

	try
	{
		// Initially disable all buttons to avoid navigation until the required global values are initialized.
		SL_DisableButtons(this);

		// Check to see if the FDM Maintenance View files have been loaded onto this client.
		// Set the visibility and availability of the Maintenace View menu item accordingly.
		SL_Frame_FDMInstalled = CheckForFDM();
		SL_SetVisibility(textboxMaintenanceView, SL_Frame_FDMInstalled);

		// Since this shape is contained in all pages, the tab to select when the page loads must be determined.
		SL_get_Current_Group_and_Expected_Model();

		// The selected tab is highlighted by making the blue line under the text visible (the default is to be hidden).
		this.objects("line" + SL_Frame_CurrentTab).style.visibility = "visible";

		SL_EnableButtons(this, SL_Frame_CurrentTab);

		// Add trace information to log if enabled.
		SL_LogDebugLevelMessage(3, "SL_Frame.Page_onshapeload", "CurrentTab = " + SL_Frame_CurrentTab + ", ExpectedModel = " + SL_Frame_ExpectedModel + ", FDMInstalled = " + SL_Frame_FDMInstalled);
	}
	catch(error)
	{
		SL_LogErrorMessage("SL_Frame.Page_onshapeload", "CurrentTab = " + SL_Frame_CurrentTab + ", ExpectedModel = " + SL_Frame_ExpectedModel + ", FDMInstalled = " + SL_Frame_FDMInstalled, error);
	}]]></script><script event="" language="JScript" id="3B9143C6-E455-47E7-A790-B424745CCE17"><![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///
/// History:
///
/// [RLEAPFI-675]   May   27, 2018      Use the dictionary to provide expected model to Range and MaintenanceView tabs. 
/// [RLEAPFI-646]   May    3, 2018      Added displaying of Transmitter model mismatch message. 
/// [RLEAPFI-645]	April 30, 2018		Modified the logic that generates the target display name for all displays in order
///                                     to support the new display set navigation (see JIRA).
/// [RLEAPFI-642]	April 25, 2018		Modified the logic that generates the target display name to support the STT700.
/// EXP510.1-31		April 24, 2018		Initial Experion R510 testbed release
///
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

var SL_Frame_CurrentTab = "";
var SL_Frame_ExpectedModel = "";
var SL_Frame_FDMInstalled = false;


function SL_get_Current_Group_and_Expected_Model()
{
	var myName = window.location.pathname.split("/").pop();
	var full_name_len = myName.length;
	var name_base_len = myName.indexOf("_");

	try
	{
		if (name_base_len > 0)
		{
			SL_Frame_CurrentTab = myName.substr(name_base_len + 1, full_name_len - name_base_len - 5);

			// For the "Range" and "MaintenanceView" displays the expected model cannot be determined from the
			// the file name. For these displays the previously opened "Overview" display should have left a
			// copy of the expected model type in the dictionary.
			if (SL_Frame_CurrentTab == "Range" || SL_Frame_CurrentTab == "MaintenanceView")
				SL_Frame_ExpectedModel = window.external.Dictionary.Item("sysdtlSmartLine_ExpectedModel").value
			else
				SL_Frame_ExpectedModel = myName.substr(15, name_base_len - 15);
		}
		else
		{
			SL_Frame_CurrentTab = "Overview";
			SL_Frame_ExpectedModel = myName.substr(15, full_name_len - 19);
		}
	}
	catch (error)
	{
		SL_LogErrorMessage("SL_get_Current_Group_and_Expected_Model", "Could not update group and model: filename = " + myName, error);
	}
}

function SL_DisableButtons(shape)
{
	shape.objects("pushbuttonOverview").disabled = true;
	shape.objects("pushbuttonDeviceDetails").disabled = true;
	shape.objects("pushbuttonRange").disabled = true;
	shape.objects("pushbuttonFaultsResolutions").disabled = true;
	shape.objects("pushbuttonMaintenanceView").disabled = true;
}

function SL_EnableButtons(shape, except_button)
{
	shape.objects("pushbuttonOverview").disabled = false;
	shape.objects("pushbuttonDeviceDetails").disabled = false;
	shape.objects("pushbuttonRange").disabled = false;
	shape.objects("pushbuttonFaultsResolutions").disabled = false;
	if (SL_Frame_FDMInstalled)
		shape.objects("pushbuttonMaintenanceView").disabled = false;

	shape.objects("pushbutton" + except_button).disabled = true;
}

function SL_DeviceTypeIsCorrect()
{
	//compare actual model with expected one
	if (SL_Frame_ExpectedModel == "Any")
	{
		var model_is_correct = false;

		for(i=0; i<SL_SmartLineDeviceTypes.length; i++)
		{
			var element = SL_SmartLineDeviceTypes[i];
			if (element.model == SL_Device.type.model)
			{
				model_is_correct = true;
				break;
			}
		}

		if (!model_is_correct)
		{
			return false;
		}
	}
	else
	{
		if (SL_Frame_ExpectedModel != SL_Device.type.model)
		{
			return false;
		}
	}
	return true;
}

function SL_Frame_onclickHandler(pushbutton, groupName)
{
	SL_LogEvent(pushbutton, "onclick");

	// Defualt display name beginning for all SmartLine displays
	var displayName = "sysdtlSmartLine";

	// "Overview", "DeviceDetails", and "FaultsResolutions" display names include the transmitter model.
	// "Range" and "MaintenanceView" display names do not include the model; those are same for all transmitters.
	if (groupName == "Overview" || groupName == "DeviceDetails" || groupName == "FaultsResolutions")
		displayName += SL_Frame_ExpectedModel;

	// The "Overview" display names do not include the display type but all others do.
	if (groupName != "Overview")
		displayName += "_" + groupName;

	// Leave a trace of the Expected Model Type in the dictionary so that the "Range" and "MaintenaceView"
	// displays can figure out the correct display name required to return to either the "Overview",
	// "FaultsResolutions" or "DeviceDetails" displays for this model if they are selected from the menu.

	// Initially the actual DeviceType read from the transmitter was used for this purpose but if the
	// communications to the transmitter is down, this value goes to 0 and can not be used for this purpose.
	// The new method allows the user to navigate through the menu to see the CDA parameters even when the
	// communication to the transmitter is down.
	window.external.Dictionary.remove("sysdtlSmartLine_ExpectedModel");
	window.external.Dictionary.Add("sysdtlSmartLine_ExpectedModel" , SL_Frame_ExpectedModel);

	// Switch to the selected display tab.
	LoadDisplayTab(displayName + ".htm");

}]]></script></scripts><parameters><parameter name="SLAnalogPoint" type="Point" description="Mapped to the current selected AI Channel." defaultvalue=""/><parameter name="DisplayTab" type="Value" description="Identifies the type of display, such as Overview, that the shape is contained in." defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
