	<XFormXML>
		<xforms>
			<script id="xfLocationFormat" language="JScript">
				var rootLocation = "/Assets";
				if (Value)
				{
					var posn = Value.indexOf( rootLocation );
					if ( posn == 0 )
						return Value.substr( rootLocation.length );
					else
						return Value;
				}
				return "";
			</script>
			<script id="xfDTCellFormat" language="jscript">
				try {
					return DTFormat.Localize(Value, g_dateTimeFormat);
				} catch(e) {
					return "";
				}
			</script>
			<script id="xfAlarmDTCellFormat" language="vbscript">
				' Value = Array (AlarmTime,AlarmTimeMicroSeconds,UnsuppressedTime)
				Dim s
				s = ""
				If Not ( IsEmpty(Value(0)) Or IsEmpty(Value(1)) ) Then
					Dim aAlarmTime
					aAlarmTime = Array(Value(0), Value(1))
					s = DTLocalize(aAlarmTime, g_dateTimeFormat)
					' do we have unsuppressed time?
					If Not ( IsEmpty(Value(2)) Or IsEmpty(Value(3)) ) Then
						' is the displayed time the unsuppressed time? If yes show the asterisk
						If (Value(2) = Value(0) And Value(3) = Value(1)) Then
							s = s &amp; " *"
						End IF
					End If
				End If
				Return = s
			</script>
			<script id="xfNumCellFormat" language="jscript">
				try {
					return DTFormat.Localize(Value, g_dateTimeFormat);
				} catch(e) {
					return "";
				}
			</script>
			<script id="xfLiveValueCellFormat" language="vbscript">
				Return = LiveValueLocalize ( Value(0), Value(1), g_nDecimalPaddingWidth, g_dateTimeFormat )
			</script>
			<script id="xfLiveValueFormat" language="vbscript">
				Return = LiveValueLocalize ( Value(0), Value(1), 0, g_dateTimeFormat )
			</script>
			<script id="xfDTTooltipFormat" language="jscript">
				try {
					return DTFormat.Localize(Value, g_dateTimeFormatTip);
				} catch(e) {
					return "";
				}
			</script>
			<script id="xfAlarmDTTooltipFormat" language="vbscript">
				' Value = Array (AlarmTime,AlarmTimeMicroSeconds,UnsuppressedTime,UnsuppressedTimeMicroSeconds)
				Dim s
				s = ""
				If Not ( IsEmpty(Value(0)) Or IsEmpty(Value(1)) ) Then
					Dim aAlarmTime
					aAlarmTime = Array(Value(0), Value(1))
					s = "Host Time: " &amp; DTLocalize(aAlarmTime, g_dateTimeFormatTip)
					' we have unsuppressed time so show it in tooltip
					If Not ( IsEmpty(Value(2)) Or IsEmpty(Value(3)) ) Then
						Dim aUnsuppTime
						aUnsuppTime = Array(Value(2), Value(3))
						s = s &amp; vbCRLF &amp; "Unsuppressed Time: " &amp; DTLocalize(aUnsuppTime, g_dateTimeFormatTip)
					End If
				End If
				Return = s
			</script>
			<script id="xfSelection" language="VBScript">
				Dim s
				s = "Unselected_Cells"
				If Value Then
					If g_bTableIsActive Then 
						s = "Selected_Active_Cells"
					Else
						s = "Selected_Inactive_Cells"
					End If
				End If
				Return = s
			</script>
			<script id="xfCentreAlarmIcon" language="jscript">
				return window.external.IsOnTouchPanel;
			</script>
			<script id="xfVisibility" language="VBScript">
				Dim s
				s = ""
				If Value Then
					s = "visible"
				Else
					s = "hidden"
				End If
				Return = s
			</script>
						<script id="xfTimeDeleted" language="VBScript">
				Dim s
				s = ""
				If Not ( IsEmpty(Value(0)) ) then
					If Value(0) Or Value(1) then
						s = "line-through"
					End If
				End If
				Return = s
			</script>
			<enum id="xfDeleted">
				<entry value="0" text=""/>
				<entry value="-1" text="line-through"/>
			</enum>
			<enum id="xfPriorityString">
