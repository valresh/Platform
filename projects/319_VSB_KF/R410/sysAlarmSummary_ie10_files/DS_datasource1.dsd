	<TableDefinitionXML>
		<table>
			<tableMenu>
				<GroupRef GroupId="TableMenuGroup"/>
			</tableMenu>
			<contextMenu>
				<GroupRef GroupId="ContextMenuGroup"/>
			</contextMenu>
			<columns>
				<column id="Video Link" name="Video Link" fixed="true" default="false">
					<title tooltip="Click to filter or sort by video link">&lt;span class="blankHeader"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="VideoLinkColumnFilterMainGroup"/>
						<GroupRef GroupId="VideoLinkFilterGroup"/>
						<GroupRef GroupId="VideoLinkSortGroup"/>
					</menu>
					<content>
						&lt;div ondblclick="if(firstElementChild.style.visibility=='visible'){ g_TDO.NavigateLink1(); window.event.cancelBubble = true;}"
							       style="width: 100%; 
							       height: 100%;
							       position: relative;
							       top: 0px;
							       z-index: 10;
							       white-space: nowrap;
 							       text-align: center;"&gt;
							&lt;img src="Images/Video.gif" style="visibility: hidden;"/&gt;
						&lt;/div&gt;
					</content>
					<bindings>
						<in fields="VideoLinkAvailable" xforms="xfVisibility" properties="firstElementChild.style.visibility" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Comments Added" name="Comments Added" fixed="true" default="false">
					<title tooltip="Click to filter or sort by the comments added field">&lt;span class="blankHeader"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="CommentsAddedColumnFilterMainGroup"/>
						<GroupRef GroupId="CommentsAddedFilterGroup"/>
						<GroupRef GroupId="CommentsAddedSortGroup"/>
					</menu>
					<content>
						&lt;div style="width: 100%; 
							       height: 100%;
							       position: relative;
							       top: 0px;
							       z-index: 10;
							       white-space: nowrap;
 							       text-align: center;"&gt;
							&lt;img src="Images/CommentsAdded.gif" style="visibility: hidden;"/&gt;
						&lt;/div&gt;
					</content>
					<bindings>
