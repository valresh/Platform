						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Section ID" name="Section ID" default="false">
					<title tooltip="Process Section or Process Area">&lt;span class="textHeader"&gt;Section ID&lt;/span&gt;</title>
					<action/>
					<menu/>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Section ID" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Roll ID" name="Roll ID" default="false">
					<title tooltip="Roll ID or Product ID">&lt;span class="textHeader"&gt;Roll ID&lt;/span&gt;</title>
					<action/>
					<menu/>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Roll ID" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Recipe" name="Recipe" default="false">
					<title tooltip="Product Recipe or Product Grade">&lt;span class="textHeader"&gt;Recipe&lt;/span&gt;</title>
					<action/>
					<menu/>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Recipe" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Live Value" name="Live Value">
					<title tooltip="Live Value">&lt;span class="textHeader"&gt;Live Value&lt;/span&gt;</title>
					<action/>
					<menu/>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px; text-align: right;"/&gt;</content>
					<bindings>
						<in fields="LiveValue;PVFormat" xforms="xfLiveValueCellFormat;EmptyVariantToString" properties="innerHTML" />
						<in fields="LiveValue;PVFormat" xforms="xfLiveValueFormat;EmptyVariantToString" properties="title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Shelved Reason" name="Shelved Reason" default="false">
					<title tooltip="Click to filter or sort by the Shelved Reason">&lt;span class="textHeader"&gt;Shelved Reason&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="ShelvedReasonColumnFilterMainGroup"/>
						<GroupRef GroupId="ShelvedReasonSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="ShelvedReason" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Expiry Time" name="Expiry Time" default="false">
					<title tooltip="Click to filter or sort by the Expiry Time">&lt;span class="textHeader"&gt;Expiry Time&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="ExpiryTimeColumnFilterMainGroup"/>
						<GroupRef GroupId="ExpiryTimeSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="ExpiryTime;ExpiryMicroSeconds" xforms="xfDTCellFormat" properties="innerText" />
						<in fields="ExpiryTime;ExpiryMicroSeconds" xforms="xfDTTooltipFormat" properties="title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Remaining Time" name="Unshelved In" default="false">
					<title tooltip="Click to filter or sort by the time remaining until unshelved">&lt;span class="textHeader"&gt;Unshelved In&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="RemainingTimeSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="RemainingTime" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Unshelved Time" name="Unshelved Time" default="false">
					<title tooltip="Click to filter or sort by the Unshelved Time">&lt;span class="textHeader"&gt;Unshelved Time&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="UnshelvedTimeColumnFilterMainGroup"/>
						<GroupRef GroupId="UnshelvedTimeSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="UnshelvedTime;UnshelvedMicroSeconds" xforms="xfDTCellFormat" properties="innerText" />
						<in fields="UnshelvedTime;UnshelvedMicroSeconds" xforms="xfDTTooltipFormat" properties="title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="TPS Aux Unit" name="TPS Aux Unit" default="false">
					<title tooltip="Click to filter or sort by the Auxiliary Unit">&lt;span class="textHeader"&gt;Aux Unit&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="AuxUnitColumnFilterMainGroup"/>
						<GroupRef GroupId="AuxUnitSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="AUX UNIT" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="TPS TS Reliability" name="TPS TS Reliability" default="false">
					<title tooltip="Click to filter or sort by the Time Stamp Reliability">&lt;span class="textHeader"&gt;TS Reliability&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="TSReliabilityColumnFilterMainGroup"/>
						<GroupRef GroupId="TSReliabilitySortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="TS Reliable" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Block" name="Block" default="false">
					<title tooltip="Click to filter or sort by the block">&lt;span class="textHeader"&gt;Block&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="BlockColumnFilterMainGroup"/>
						<GroupRef GroupId="BlockSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Block" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Criticality" name="Criticality" default="false">
					<title tooltip="Click to filter or sort by the criticality">&lt;span class="textHeader"&gt;Criticality&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="CriticalityColumnFilterMainGroup"/>
						<GroupRef GroupId="CriticalitySortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="Criticality" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Suppression Groups" name="Suppression Groups" default="false">
					<title tooltip="Suppression Groups">&lt;span class="textHeader"&gt;Suppression Groups&lt;/span&gt;</title>
					<action/>
					<menu/>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px; text-align: right;"/&gt;</content>
					<bindings>
						<in fields="SuppressionGroups" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Public Name" name="Public Name" default="false">
					<title tooltip="Click to filter or sort by the public name">&lt;span class="textHeader"&gt;Public Name&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="PublicNameColumnFilterMainGroup"/>
						<GroupRef GroupId="PublicNameSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="PublicName" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Batch ID" name="Batch ID" default="false">
					<title tooltip="Click to filter or sort by Batch ID">&lt;span class="textHeader"&gt;Batch ID&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="BatchIDFilterMainGroup"/>
						<GroupRef GroupId="BatchIDSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="BatchID" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
				<column id="Source Tag Name" name="Source Tag Name" default="false">
					<title tooltip="Click to filter or sort by source tag name">&lt;span class="textHeader"&gt;Source Tag Name&lt;/span&gt;</title>
					<action/>
					<menu>
						<GroupRef GroupId="SourceTagNameFilterMainGroup"/>
						<GroupRef GroupId="SourceTagNameSortGroup"/>
					</menu>
					<content>&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&gt;</content>
					<bindings>
						<in fields="SourceTagName" xforms="EmptyVariantToString" properties="innerText;title" />
						<in fields="Deleted" properties="style.textDecoration" xforms="xfDeleted"/>
						<in fields="Selected" properties="id" xforms="xfSelection"/>
					</bindings>
				</column>
			</columns>
		</table>
	</TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
</DATAOBJECT>
<DATAOBJECT id="2" type="HMIPage.EntitySource" format="propertybag">
<PROPERTY name="Version">4.5</PROPERTY>
<PROPERTY name="SummaryType">1</PROPERTY> 
<PROPERTY name="AutoMigrate">0</PROPERTY>
<PROPERTY name="WaitForSelectionList">1</PROPERTY>
<PROPERTY name="StartLocation"></PROPERTY>
<PROPERTY name="AuxFilter">IsAssigned or HasAssignedDescendents</PROPERTY>
<PROPERTY name="TemplateXML"><![CDATA[
<TableTemplate>
	<FieldXML>
		<fields>
			<field id="Selected"/>
			<field id="NodeHandle" rowId="true"/>
			<field id="Depth"/>
			<field id="Expanded"/>
			<field id="NumChildren"/>
			<field id="SiblingNumber"/>
			<field id="PointNumber"/>
			<field id="IsAssigned"/>
			<field id="HasAssignedDescendents"/>
			<field id="EntityName"/>
			<field id="TagName"/>
			<field id="FullName"/>
			<field id="AlmState"/>
			<field id="TotalAlarms(%StationNumber%)"/>
			<field id="TotalLowAlarms(%StationNumber%)"/>
			<field id="TotalHighAlarms(%StationNumber%)"/>
			<field id="TotalUrgentAlarms(%StationNumber%)"/>
			<field id="TotalCriticalAlarms(%StationNumber%)"/>
			<field id="TotalDisabledAlarms(%StationNumber%)"/>
			<field id="TotalShelvedAlarms(%StationNumber%)"/>
			<field id="RemoteType"/>
			<field id="SubType"/>
			<field id="ItemNumber"/>
			<field id="Redundant"/>
			<field id="Flags"/> 
			<field id="Type"/>
			<field id="DirectConnect"/>
			<field id="Description"/>
			<field id="ConsoleAlarmDisabled"/>
			<field id="AssignedConsoleAlarmDisabledDescendants"/>
		</fields>
	</FieldXML>
	<XFormXML>
		<xforms>
			<defaultValue id="xfEmptyVariantToString" value="" type="string"/>
			<script id="xfSelection" language="VBScript">
				Dim s
				s = "Unselected_Cells"
				If Not IsEmpty(Value(0)) Then
				    If Value(0) Then
					If g_bAreaTableIsActive Then
						If Value(1) Then 
							s = "Selected_Active_Cells"
						Else
							s = "Selected_Active_Unassigned_Cells"
						End If
					Else
						If Value(1) Then
							s = "Selected_Inactive_Cells"
						Else
							s = "Selected_Inactive_Unassigned_Cells"
						End If
					End If
				    ElseIf Not Value(1) Then
					s = "Unassigned_Cells"
				    End If
				End If
				Return = s
			</script>
			<script id="xfBold" language="VBScript">
				if ( (IsEmpty(Value(0)) or Value(0) = 0) and (IsEmpty(Value(1)) or Value(1) = 0) )then
				    Return = ""
				else
				    Return = "bold"
				end if
			</script>
			<script id="xfIconImg" language="VBScript">
				Return = GetNodeImagePath(Value)
			</script>
			<script id="xfIconVisible" language="VBScript">
				if ( (IsEmpty(Value(0)) or Value(0) = 0) and (IsEmpty(Value(1)) or Value(1) = 0) and (IsEmpty(Value(2)) or Value(2) = 0) ) then
				    Return = "visible"
				else
				    Return = "hidden"
				end if
			</script>
			<script id="xfPadding" language="VBScript">
				if ( IsEmpty(Value) ) then
                    Return = "0px"
                else
                    Return = CStr((Value - 1) * 16) &amp; "px"
				end if
			</script>
			<script id="xfPlusMinusImg" language="VBScript">
			    On Error Resume Next
				if (IsEmpty(Value(0)) or (Value(0) = 0)) then
					Return = "Images/blank.gif"
				elseif (Value(1)) then
				    if not window.external.IsOnTouchPanel then
					    Return = "Images/Collapse.png"
			        else 
					    Return = "Images/Collapse_Touch.png"
					end if
				else
				    if not window.external.IsOnTouchPanel then
					    Return = "Images/Expand.png"
					else
					    Return = "Images/Expand_Touch.png"
					end if
				end if
			</script>
			<script id="xfStatusIconImg" language="VBScript">
				if (Value(0) = 1 or Value(1) = 1) then
					Return = "Images/ConsoleAlarmDisabled.png"
				else
					Return = "Images/blank.gif"
				end if
			</script>
			<script id="xfStatusIconTitle" language="VBScript">
				Dim thisAsset
				thisAsset = ""
				Dim descendantAsset
				descendantAsset = ""
				Return = ""
				if (Value(0) = 1) then
					thisAsset = "Alarms disabled on console"
				end if
				if (Value(1) = 1) then
					descendantAsset = "Alarms disabled on console for descendant asset"
				end if
				if (thisAsset &lt;&gt; "") then
					Return = thisAsset
				end if
				if (descendantAsset &lt;&gt; "") then
					if (Return &lt;&gt; "") then
						Return = Return &amp; vbCrLf &amp; descendantAsset
					else
						Return = descendantAsset
					end if
				end if
			</script>
			<script id="xfNameAndCount" language="VBScript">
				Return = GetNodeDisplayName(Value)
				if( Return &lt;&gt; "" ) then
				    if( (Value(4) &gt; 0) or (Value(5) &gt; 0) ) then
					Return = Return &amp; " (" &amp; Value(4) + Value(5) &amp; ")"
				    end if
				end if
			</script>
			<script id="xfTitle" language="VBScript">
				if( IsEmpty(Value(0)) or g_bDisplayToolTips = false) then
					Return = ""
				else
					Return = "Name: " &amp; Value(4) &amp; vbCrLf &amp; "Description: " &amp; Value(5) &amp; vbCrLf &amp; "Critical: " &amp; Value(7) &amp; vbCrLf &amp; "Urgent: " &amp; Value(2) &amp; vbCrLf &amp; "High: " &amp; Value(1) &amp; vbCrLf &amp; "Low: " &amp; Value(0) &amp; vbCrLf &amp; "Disabled: " &amp; Value(3) &amp; vbCrLf &amp; "Shelved: " &amp; Value(6)
				end if
			</script>
			<script id="xfDisplay" language="VBScript">
				if( IsEmpty(Value) ) then
					Return = "none"
				else
					Return = "inline"
				end if
			</script>
			<script id="xfUnavailableImg" language="VBScript">
				Return = GetUnavailableImagePath(Value)
			</script>
		</xforms>
	</XFormXML>
	<HTMLWrapperXML>
		<HTMLWrappers>
			<MenuItemWrapper>
				<Begin>
					&lt;div style="position: relative; width: 170px; padding-bottom: 2px; padding-top: 1px; padding-right: 5px;" onmouseenter="OnEnter_MenuItem(this)" onmouseleave="OnLeave_MenuItem(this)"&gt;&lt;span&gt;
				</Begin>
				<End>
					&lt;/span&gt;&lt;/div&gt;
				</End>
			</MenuItemWrapper>
			<FilterAppliedWrapper>
				<Begin>
					&lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; margin-right: 1px; background-color: mediumblue; color: white; font-weight: bold;"&gt;
				</Begin>
				<End>
					&lt;/span&gt;
				</End>
			</FilterAppliedWrapper>
			<SortAscIndicator>
				&amp;nbsp;&lt;img src="Images/SortArrowUp.gif"&gt;
			</SortAscIndicator>
			<SortDescIndicator>
				&amp;nbsp;&lt;img src="Images/SortArrowDown.gif"&gt;
			</SortDescIndicator>
			<GroupSeparator>
				&lt;div style="position:relative; width: 160px; height: 2px; overflow: hidden; display: block; border: 1px inset; margin: 3px;" &gt;&lt;/div&gt;
			</GroupSeparator>
		</HTMLWrappers>
	</HTMLWrapperXML>
	<MenuGroupXML>
		<MenuGroups>
			<CommandGroup id="LocationContextMenuGroup">
				<StandardCommand id="Command_ShelveLocation" Command="ShelveLocation">
					&lt;div title="Shelve the selected location" style="padding: 1px; width: 100%;" class="contextMenu_Shelve"&gt;
					&amp;nbsp;Shelve Location...
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_UnshelveLocation" Command="UnshelveLocation">
					&lt;div title="Unshelve the selected location" style="padding: 1px; width: 100%;" class="contextMenu_Unshelve"&gt;
					&amp;nbsp;Unshelve Location
					&lt;/div&gt;
				</StandardCommand>
			</CommandGroup>
		</MenuGroups>
	</MenuGroupXML>
	<BaseFilterXML>
		<BaseFilterDef>
		</BaseFilterDef>
	</BaseFilterXML>
	<SortXML>
		<SortDef DefaultSortColumn="Tree" DefaultSortDir="asc">
			<colref id="Tree" 
				SortAscString="EntityName asc"
				SortDescString="EntityName desc"
				SortDir="asc"
				SortOrder="1"/>
		</SortDef>
	</SortXML>
	<ColumnStateXML>
		<state>
			<colref id="Tree" width="100" hidden="false" />
		</state>
	</ColumnStateXML>
	<TableDefinitionXML>
		<table>
			<tableMenu/>
			<contextMenu>
				<GroupRef GroupId="LocationContextMenuGroup"/>
			</contextMenu>
			<columns>
				<column id="Tree">
					<title>Tree</title>
					<action/>
					<menu/>
					<content>
					&lt;div class="TreeNodeContainer" language="javascript" onmousedown="if( window.event.button != 1 ) { window.event.cancelBubble = true; return false; }" ExpandCollapseTrigger = 0&gt;
                            &lt;div class="TreeNodeGroup"&gt;
                                &lt;div class="TreeNodePlusMinus"
                                    onmousedown="if( window.event.button == 1 ) { this.parentElement.parentElement.setAttribute('ExpandCollapseTrigger', 1); window.event.cancelBubble = true; }"
                                    onclick="window.event.cancelBubble = true; return false;"&gt;
                                    &lt;img class="PlusMinusIcon" src="Images/blank.gif"/&gt;
							&lt;/div&gt;
							&lt;div language="javascript" ondblclick="AreaTable.Binding.DataObjects(0).PointDetail();" class="TreeNodeIconGroup"&gt;
								&lt;div class="TreeAssetIcon"&gt;
									&lt;img src="Images/blank.gif"/&gt;
								&lt;/div&gt;
								&lt;div class="TreeAssetIcon"&gt;
									&lt;img src="Images/blank.gif"/&gt;
								&lt;/div&gt;
								&lt;div class="TreeStatusIcon"&gt;
									&lt;img src="Images/blank.gif"/&gt;
								&lt;/div&gt;
								&lt;div _opacityACKED="60"
									_opacityON="100"
									_opacityOFF="30"
									_tooltipType="1"
									class="TreeNodeAlarmIcon"
									style="behavior: url(#AlarmStateIconFactory#AlarmIcon);"&gt;
								&lt;/div&gt;
							&lt;/div&gt;
							&lt;div language="javascript" ondblclick="AreaTable.Binding.DataObjects(0).PointDetail();" class="treeNodeLabel"&gt;&lt;/div&gt;
						&lt;/div&gt;  
					&lt;/div&gt;
					</content>
					<bindings>
						<in fields="Depth" properties="firstElementChild.style.left" xforms="xfPadding" />
						<in fields="Depth" properties="style.display" xforms="xfDisplay" />
						<in fields="NumChildren;Expanded" properties="firstElementChild.firstElementChild.firstElementChild.src" xforms="xfPlusMinusImg" />
						<in fields="RemoteType;SubType;ItemNumber;Redundant;Flags" properties="firstElementChild.firstElementChild.nextElementSibling.firstElementChild.firstElementChild.src" xforms="xfIconImg" />
						<in fields="EntityName;Type;SubType;DirectConnect" properties="firstElementChild.firstElementChild.nextElementSibling.firstElementChild.nextElementSibling.firstElementChild.src" xforms="xfUnavailableImg" />
						<in fields="EntityName;RemoteType;SubType;ItemNumber;TotalAlarms(%StationNumber%);TotalDisabledAlarms(%StationNumber%)" properties="firstElementChild.lastElementChild.innerText" xforms="xfNameAndCount" />
						<in fields="TotalLowAlarms(%StationNumber%);TotalHighAlarms(%StationNumber%);TotalUrgentAlarms(%StationNumber%);TotalDisabledAlarms(%StationNumber%);FullName;Description;TotalShelvedAlarms(%StationNumber%);TotalCriticalAlarms(%StationNumber%)" properties="title" xforms="xfTitle" />
						<in fields="TotalAlarms(%StationNumber%);TotalDisabledAlarms(%StationNumber%)" properties="firstElementChild.lastElementChild.style.fontWeight" xforms="xfBold" />
						<in fields="ConsoleAlarmDisabled;AssignedConsoleAlarmDisabledDescendants" properties="firstElementChild.firstElementChild.nextElementSibling.firstElementChild.nextElementSibling.nextElementSibling.firstElementChild.src" xforms="xfStatusIconImg" />
						<in fields="ConsoleAlarmDisabled;AssignedConsoleAlarmDisabledDescendants" properties="firstElementChild.firstElementChild.nextElementSibling.firstElementChild.nextElementSibling.nextElementSibling.firstElementChild.title" xforms="xfStatusIconTitle"/>
						<in fields="Selected;IsAssigned" properties="firstElementChild.lastElementChild.id" xforms="xfSelection"/>
						<in fields="AlmState" properties="firstElementChild.firstElementChild.nextElementSibling.lastElementChild.AlarmState"/>
						<in fields="TotalAlarms(%StationNumber%);TotalDisabledAlarms(%StationNumber%);TotalShelvedAlarms(%StationNumber%)" properties="firstElementChild.firstElementChild.nextElementSibling.firstElementChild.style.visibility;firstElementChild.firstElementChild.nextElementSibling.firstElementChild.nextElementSibling.style.visibility" xforms="xfIconVisible"/>
						<out properties="ExpandCollapseTrigger" fields="Expanded"/>
					</bindings>
				</column>
			</columns>
		</table>
	</TableDefinitionXML>
</TableTemplate>
]]></PROPERTY>
