			<CommandGroup id="ContextMenuGroup">
				<StandardCommand id="Command_Acknowledge" Command="Acknowledge">
					&lt;div title="Acknowledge the selected alarm" style="width: 100%;" class="contextMenu_Ack"&gt;
					&amp;nbsp;Acknowledge Alarm
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_QuickShelve" Command="QuickShelve">
					&lt;div title="Quick shelve the selected alarm" style="padding: 1px; width: 100%;" class="contextMenu_Shelve"&gt;
					&amp;nbsp;Quick Shelve Alarm
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_Shelve" Command="Shelve">
					&lt;div title="Shelve the selected alarm" style="padding: 1px; width: 100%;" class="contextMenu_Shelve"&gt;
					&amp;nbsp;Shelve Alarm...
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_Unshelve" Command="Unshelve">
					&lt;div title="Unshelve the selected alarm" style="padding: 1px; width: 100%;" class="contextMenu_Unshelve"&gt;
					&amp;nbsp;Unshelve Alarm
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_PointDetail" Command="PointDetail">
					&lt;div title="Navigate to the detail page of the selected alarm" style="padding: 1px; width: 100%;" class="contextMenu_PointDetail"&gt;
					&amp;nbsp;Detail Display
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_AssociatedDisplay" Command="AssociatedDisplay">
					&lt;div title="Navigate to the associated display of the selected alarm" style="padding: 1px; width: 100%;" class="contextMenu_AssDisplay"&gt;
					&amp;nbsp;Associated Display
					&lt;/div&gt;
				</StandardCommand>
				<StandardCommand id="Command_SuppressionStatus" Command="SuppressionStatus">
					&lt;div title="Navigate to the suppression status page of the selected alarm" style="padding: 1px; width: 100%;" class="contextMenu_SuppStatus"&gt;
					&amp;nbsp;Suppression Status
					&lt;/div&gt;
				</StandardCommand>
				<ScriptCommand id="Command_AlarmHelp" script="if ( DetailsPane.style.display == &quot;none&quot; ) ToggleDetailsPane(); TabDetailsPane(3);" language="jscript">
					&lt;div title="Open the alarm help for the selected alarm" style="padding: 1px; width: 100%;" class="contextMenu_AlarmHelp"&gt;
					&amp;nbsp;Alarm Help
					&lt;/div&gt;
				</ScriptCommand>
				<ScriptCommand 
					id="ContextMenu_ProcedureExplorer"
					script="if (InvokeProcedureExplorer){InvokeProcedureExplorer(getActivityPointFromNotificationSummary());}"
					language="jscript">
					&lt;div title="Open the Procedure Explorer" style="padding: 1px; width: 100%;" class="contextMenu_PE"&gt;
					&amp;nbsp;Procedure Explorer
					&lt;/div&gt;
				</ScriptCommand>
