<DIV tabIndex=-1 id=txtNodeType_93 class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.58%; FONT-FAMILY: arial; WIDTH: 11.17%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #585858; TEXT-ALIGN: left; LEFT: 88.71%; TOP: 85.16%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="FillColor:white;fillColorBlink:False;FillStyle:0;Height:16;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#585858;textColorBlink:False;TotalRotation:-1;Width:110;">Text</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtNodeType_94 class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.58%; FONT-FAMILY: arial; WIDTH: 11.17%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #585858; TEXT-ALIGN: left; LEFT: 88.71%; TOP: 89.03%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="FillColor:white;fillColorBlink:False;FillStyle:0;Height:16;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#585858;textColorBlink:False;TotalRotation:-1;Width:110;">Text</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtNodeType_95 class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.58%; FONT-FAMILY: arial; WIDTH: 11.17%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #585858; TEXT-ALIGN: left; LEFT: 88.71%; TOP: 93.22%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="FillColor:white;fillColorBlink:False;FillStyle:0;Height:16;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#585858;textColorBlink:False;TotalRotation:-1;Width:110;">Text</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=txtNodeType_96 class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 2.58%; FONT-FAMILY: arial; WIDTH: 11.17%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #585858; TEXT-ALIGN: left; LEFT: 88.71%; TOP: 97.41%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="FillColor:white;fillColorBlink:False;FillStyle:0;Height:16;lineColorBlink:False;LineStyle:0;LineWidth:0;styleClass:;textColor:#585858;textColorBlink:False;TotalRotation:-1;Width:110;">Text</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=line001 class="hvg.base.1 " style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 95%; FONT-FAMILY: Arial; WIDTH: 0.1%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 24.49%; TOP: 3.7%; BEHAVIOR: url(#HDXVectorFactory#line); VISIBILITY: inherit" hdxproperties="fillColorBlink:False;Height:589;LineColor:#c0c0c0;lineColorBlink:False;points:0 0 0 100 ;styleClass:;Width:1;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=line002 class="hvg.base.1 " style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 95%; FONT-FAMILY: Arial; WIDTH: 0.1%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 49.18%; TOP: 3.7%; BEHAVIOR: url(#HDXVectorFactory#line); VISIBILITY: inherit" hdxproperties="fillColorBlink:False;Height:589;LineColor:#c0c0c0;lineColorBlink:False;points:0 0 0 100 ;styleClass:;Width:1;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=line003 class="hvg.base.1 " style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 95%; FONT-FAMILY: Arial; WIDTH: 0.1%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 74.69%; TOP: 3.87%; BEHAVIOR: url(#HDXVectorFactory#line); VISIBILITY: inherit" hdxproperties="fillColorBlink:False;Height:589;LineColor:#c0c0c0;lineColorBlink:False;points:0 0 0 100 ;styleClass:;Width:1;"></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=sd class="hsc.alpha.1  HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 1.93%; FONT-FAMILY: Arial; WIDTH: 2.23%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #8b0000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 30.99%; TOP: 5.48%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;styleClass:;textColor:#8b0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[' iterate across all 96 possible nodes, building shpLEDLCN_nn and shpLEDELCN_nn objects to pass to UpdateLED routine
' this approach consolidates update of 96 pairs of LED objects into two short routines

	dim nNode
	nNode = 1

on error resume next

	if bShapeReady = false then
		window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange TOO SOON (bShapeReady=false) skipping logic"
		exit sub
	else 
		window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange OK (bShapeReady=true) proceeding..."
	end if
		

		' test - hammered way...  one at a time...

	if sd.QualityGood("SrvCurrentPoint.BRDGLCLTYARR(1)") then
		select case sd.DataValue("SrvCurrentPoint.BRDGLCLTYARR(1)")
			case 0 'NONE  (both gray)
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(1) is 0"
				shpLEDLCN_01.value = 2 :	shpLEDELCN_01.value = 2
			case 1 'LCN   (LCN green, ELCN gray)
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(1) is 1"
				shpLEDLCN_01.value = 3 : shpLEDELCN_01.value = 2
			case 2 'ELCN  (LCN gray, ELCN green)
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(1) is 2"
				shpLEDLCN_01.value = 2 : shpLEDELCN_01.value = 3
			case 3 'BOTH *ERROR*  (both red)
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(1) is 3"
				shpLEDLCN_01.Value = 4 : shpLEDELCN_01.value = 4
			case else 'both gray
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(1) is undef"
				shpLEDLCN_01.Value = 2 : shpLEDELCN_01.value = 2
		end select	
	end if	
	if sd.QualityGood("SrvPRSTS01.$NODETYP") then
		txtNodeType_01.value = sd.DataValue("SrvPRSTS01.$NODETYP")
		txtNodeType_01.style.visibility = "Inherit"
	else
		txtNodeType_01.style.visibility = "Hidden"
	end if

	if sd.QualityGood("SrvCurrentPoint.BRDGLCLTYARR(2)") then
		select case sd.DataValue("SrvCurrentPoint.BRDGLCLTYARR(2)")
			case 0 'NONE  (both gray)
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(2) is 0"
				shpLEDLCN_02.value = 2 :	shpLEDELCN_02.value = 2
			case 1 'LCN   (LCN green, ELCN gray)
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(2) is 1"
				shpLEDLCN_02.value = 3 : shpLEDELCN_02.value = 2
			case 2 'ELCN  (LCN gray, ELCN green)
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(2) is 2"
				shpLEDLCN_02.value = 2 : shpLEDELCN_02.value = 3
			case 3 'BOTH *ERROR*  (both red)
				shpLEDLCN_02.Value = 4 : shpLEDELCN_02.value = 4
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(2) is 3"
			case else 'both gray
				shpLEDLCN_02.Value = 2 : shpLEDELCN_02.value = 2
				window.external.parentdocument.parentwindow.external.logmessage "BRDGLCLTYARR(2) is undef"
		end select	
	end if	
	if sd.QualityGood("SrvPRSTS02.$NODETYP") then
		txtNodeType_02.value = sd.DataValue("SrvPRSTS02.$NODETYP")
		txtNodeType_02.style.visibility = "Inherit"
	else
		txtNodeType_02.style.visibility = "Hidden"
	end if

	if sd.QualityGood("SrvCurrentPoint.BRDGLCLTYARR(3)") then
		select case sd.DataValue("SrvCurrentPoint.BRDGLCLTYARR(3)")
			case 0 'NONE  (both gray)
				shpLEDLCN_03.value = 2 :	shpLEDELCN_03.value = 2
			case 1 'LCN   (LCN green, ELCN gray)
				shpLEDLCN_03.value = 3 : shpLEDELCN_03.value = 2
			case 2 'ELCN  (LCN gray, ELCN green)
				shpLEDLCN_03.value = 2 : shpLEDELCN_03.value = 3
			case 3 'BOTH *ERROR*  (both red)
				shpLEDLCN_03.Value = 4 : shpLEDELCN_03.value = 4
			case else 'both gray
				shpLEDLCN_03.Value = 2 : shpLEDELCN_03.value = 2
		end select	
	end if	
	if sd.QualityGood("SrvPRSTS03.$NODETYP") then
		txtNodeType_03.value = sd.DataValue("SrvPRSTS03.$NODETYP")
		txtNodeType_03.style.visibility = "Inherit"
	else
		txtNodeType_03.style.visibility = "Hidden"
	end if

	if sd.QualityGood("SrvCurrentPoint.BRDGLCLTYARR(4)") then
		select case sd.DataValue("SrvCurrentPoint.BRDGLCLTYARR(4)")
			case 0 'NONE  (both gray)
				shpLEDLCN_04.value = 2 :	shpLEDELCN_04.value = 2
			case 1 'LCN   (LCN green, ELCN gray)
				shpLEDLCN_04.value = 3 : shpLEDELCN_04.value = 2
			case 2 'ELCN  (LCN gray, ELCN green)
				shpLEDLCN_04.value = 2 : shpLEDELCN_04.value = 3
			case 3 'BOTH *ERROR*  (both red)
				shpLEDLCN_04.Value = 4 : shpLEDELCN_04.value = 4
			case else 'both gray
				shpLEDLCN_04.Value = 2 : shpLEDELCN_04.value = 2
		end select	
	end if	
	if sd.QualityGood("SrvPRSTS04.$NODETYP") then
		txtNodeType_04.value = sd.DataValue("SrvPRSTS04.$NODETYP")
		txtNodeType_04.style.visibility = "Inherit"
	else
		txtNodeType_04.style.visibility = "Hidden"
	end if








	exit sub

	' right way below, but passing as object failing why?


	Do While nNode <= 2 '20 '96
		sBridgeNode = "SrvCurrentPoint.BRDGLCLTYARR(" & nNode & ")"
		if nNode < 10 then
'			UpdateLED GrpTopology.children("shpLEDLCN_0" & nNode), GrpTopology.children("shpLEDELCN_0" & nNode)
			if sd.QualityGood(sBridgeNode)then
				msgbox "SD OnDataChange, quality good for sBridgeNode= >" & sBridgeNode & "<"
				window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange, qualitygood (" & sBridgeNode & "), value: " & sd.DataValue(sBridgeNode) & ", node# " & nNode & " calling UpdateLED"
				UpdateLED "shpLEDLCN_0" & nNode, "shpLEDELCN_0" & nNode, sd.DataValue(sBridgeNode)
			else 
				msgbox "SD OnDataChange, quality BAD for sBridgeNode= >" & sBridgeNode & "<"
				window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange, quality *NOT* good (" & sBridgeNode & "), node# " & nNode & " NOT calling UpdateLED"
			end if
		else 
'			UpdateLED GrpTopology.children("shpLEDLCN_" & nNode), GrpTopology.children("shpLEDELCN_" & nNode)
			if sd.QualityGood(sBridgeNode)then
				window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange, qualitygood (" & sBridgeNode & "), value: " & sd.DataValue(sBridgeNode) & ", node# " & nNode & " calling UpdateLED"
				UpdateLED "shpLEDLCN_" & nNode, "shpLEDELCN_" & nNode, sd.DataValue(sBridgeNode)
			else 
				window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange, quality *NOT* good (" & sBridgeNode & "), node# " & nNode & " NOT calling UpdateLED"
			end if
		end if

		' $NODETYP
		if nNode < 10 then
			sBridgeNodeType = "SrvPRSTS0" & nNode & ".$NODETYP"
			if sd.QualityGood(sBridgeNodeType) then
				msgbox "SD OnDataChange, quality good for sBridgeNodeType= >" & sBridgeNodeType & "<"
				window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange, qualitygood (" & sBridgeNodeType & "), value: " & sd.DataValue(sBridgeNodeType) & ", node# " & nNode & " calling UpdateNodeType"
'				UpdateNodeType GrpTopology.children("txtNodeType_0" & nNode)
				UpdateNodeType ("txtNodeType_" & nNode), sd.DataValue(sBridgeNodeType)
			else
				msgbox "SD OnDataChange, quality BAD for sBridgeNodeType= >" & sBridgeNodeType & "<"
				window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange, quality *NOT* good (" & sBridgeNodeType & "), node# " & nNode & " NOT calling UpdateNodeType"
			end if
		else 
			sBridgeNodeType = "SrvPRSTS"  & nNode & ".$NODETYP"
			if sd.QualityGood(sBridgeType) then
				window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange, qualitygood (" & sBridgeNodeType & "), value: " & sd.DataValue(sBridgeNodeType) & ", node# " & nNode & " calling UpdateNodeType"
'				UpdateNodeType GrpTopology.children("txtNodeType_" & nNode)
				UpdateNodeType ("txtNodeType_" & nNode), sd.DataValue(sBridgeNodeType)
			else
				window.external.parentdocument.parentwindow.external.logmessage "SD OnDataChange, quality *NOT* good (" & sBridgeNodeType & "), node# " & nNode & " NOT calling UpdateNodeType"
			end if
		end if

		nNode = nNode + 1
	Loop]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},{%Point::SrvCurrentPoint%},&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;CurrentPoint&gt;,&lt;Cur