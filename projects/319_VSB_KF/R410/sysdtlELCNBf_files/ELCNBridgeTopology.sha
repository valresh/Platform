'
'
'  ELCN Bridge Topology display based on BRDGLCLTYARR(1)..(96) showing
'  whether nodes are on the LCN or on the ELCN (or neither, or bad/both)
'  Inside shape.

''sub UpdateLED(objLED1, objLED2, nVal)
' generic routine for updating the LEDs for 1-96 nodes

'	if sd2.QualityGood(sBridgeNode) then
'		window.external.parentdocument.parentwindow.external.logmessage sBridgeNode & " value is: " & sd2.DataValue(sBridgeNode)
'		select case sd2.DataValue(sBridgeNode)
''	msgbox "UpdateLED, params: " & objLED1 & ", " & objLED2 & ", " & nVal
''	msgbox ".... "
''	msgbox "objects by name: " & objLED1.title & ", " & objLED2.title
''		window.external.parentdocument.parentwindow.external.logmessage "UpdateLED, params: " & objLED1 & ", " & objLED2 & ", " & nVal
''		select case nVal
''			case 0 'NONE  (both gray)
''				objLED1.value = 2 :	objLED2.value = 2
''			case 1 'LCN   (LCN green, ELCN gray)
''				objLED1.value = 3 : objLED2.value = 2
''			case 2 'ELCN  (LCN gray, ELCN green)
''				objLED1.value = 2 : objLED2.value = 3
''			case 3 'BOTH *ERROR*  (both red)
''				objLED1.Value = 4 : objLED2.value = 4
''			case else 'both gray
''				objLED1.Value = 2 : objLED2.value = 2
''		end select	
'	else ' temp test
'		window.external.parentdocument.parentwindow.external.logmessage sBridgeNode & " quality is BAD"
'		objLED1.value = 2 : objLED2.value = 2
'	end if

'end sub

''sub UpdateNodeType(objTxtNodetype, nVal)
' generic routine for updating $PRSTSnn.$NODETYP for 1-96 nodes

'	if sd2.QualityGood(sBridgeNodeType) then
'		window.external.parentdocument.parentwindow.external.logmessage sBridgeNodeType & " value is: " & sd2.DataValue(sBridgeNodeType)
''	msgbox "UpdateNodeType, params: " & objTxtNodetype & ", " & nVal
		
''		window.external.parentdocument.parentwindow.external.logmessage "UpdateNodeType, params: " & objTxtNodetype & ", " & nVal
''		objTxtNodeType.value = nVal
'		objTxtNodeType.value = sd2.DataValue(sBridgeNodeType)
''		objTxtNodeType.style.visibility = "Inherit"
'	else
'		window.external.parentdocument.parentwindow.external.logmessage sBridgeNodeType & "quality bad (no node exists?) hiding $NODETYP on Bridge Status display"
'		objTxtNodeType.style.visibility = "Hidden"
'	end if
'
''end sub]]></script></scripts><parameters><parameter name="SrvCurrentPoint" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS01" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS02" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS03" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS04" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS05" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS06" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS07" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS08" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS09" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS10" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS11" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS12" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS13" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS14" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS15" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS16" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS17" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS18" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS19" type="Point" description="" defaultvalue=""/><parameter name="SrvPRSTS20" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
