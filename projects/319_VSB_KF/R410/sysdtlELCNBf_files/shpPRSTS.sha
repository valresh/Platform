4" type="Point" description="" defaultvalue=""/><parameter name="Point55" type="Point" description="" defaultvalue=""/><parameter name="Point56" type="Point" description="" defaultvalue=""/><parameter name="Point57" type="Point" description="" defaultvalue=""/><parameter name="Point58" type="Point" description="" defaultvalue=""/><parameter name="Point59" type="Point" description="" defaultvalue=""/><parameter name="Point60" type="Point" description="" defaultvalue=""/><parameter name="Point61" type="Point" description="" defaultvalue=""/><parameter name="Point62" type="Point" description="" defaultvalue=""/><parameter name="Point63" type="Point" description="" defaultvalue=""/><parameter name="Point64" type="Point" description="" defaultvalue=""/><parameter name="Point65" type="Point" description="" defaultvalue=""/><parameter name="Point66" type="Point" description="" defaultvalue=""/><parameter name="Point67" type="Point" description="" defaultvalue=""/><parameter name="Point68" type="Point" description="" defaultvalue=""/><parameter name="Point69" type="Point" description="" defaultvalue=""/><parameter name="Point70" type="Point" description="" defaultvalue=""/><parameter name="Point71" type="Point" description="" defaultvalue=""/><parameter name="Point72" type="Point" description="" defaultvalue=""/><parameter name="Point73" type="Point" description="" defaultvalue=""/><parameter name="Point74" type="Point" description="" defaultvalue=""/><parameter name="Point75" type="Point" description="" defaultvalue=""/><parameter name="Point76" type="Point" description="" defaultvalue=""/><parameter name="Point77" type="Point" description="" defaultvalue=""/><parameter name="Point78" type="Point" description="" defaultvalue=""/><parameter name="Point79" type="Point" description="" defaultvalue=""/><parameter name="Point80" type="Point" description="" defaultvalue=""/><parameter name="Point81" type="Point" description="" defaultvalue=""/><parameter name="Point82" type="Point" description="" defaultvalue=""/><parameter name="Point83" type="Point" description="" defaultvalue=""/><parameter name="Point84" type="Point" description="" defaultvalue=""/><parameter name="Point85" type="Point" description="" defaultvalue=""/><parameter name="Point86" type="Point" description="" defaultvalue=""/><parameter name="Point87" type="Point" description="" defaultvalue=""/><parameter name="Point88" type="Point" description="" defaultvalue=""/><parameter name="Point89" type="Point" description="" defaultvalue=""/><parameter name="Point90" type="Point" description="" defaultvalue=""/><parameter name="Point91" type="Point" description="" defaultvalue=""/><parameter name="Point92" type="Point" description="" defaultvalue=""/><parameter name="Point93" type="Point" description="" defaultvalue=""/><parameter name="Point94" type="Point" description="" defaultvalue=""/><parameter name="Point95" type="Point" description="" defaultvalue=""/><parameter name="Point96" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=mySD class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 16px; FONT-FAMILY: Arial; WIDTH: 18px; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #8b0000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 126px; TOP: 34px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#8b0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[	dim nValue
	dim sPoint
	nValue = 1


	' here we update our 'quality good' array called valueOK (1..96), if not good, then we don't have
	' a local good $PRSTS## number, so we don't show any value.
	' this avoids potentially showing a DSA'd value
	Do While nValue <= 96
		sPoint = "Point" & nValue & ".$NODETYP"
'window.external.parentdocument.parentwindow.external.logmessage "sPoint is: >" & sPoint & "<"
		if me.QualityGood(sPoint)then
			valueOK(nValue) = 1
			prstsArray(nValue) = me.DataValue(sPoint)
'window.external.parentdocument.parentwindow.external.logmessage "shpPRSTS value GOOD: " & sPoint & ", prstsArray(" & nValue & ") = >" & prstsArray(nValue) & "<"
		else
			valueOK(nValue) = 0
			                     '1234567890123 
			prstsArray(nValue) = "             "
'window.external.parentdocument.parentwindow.external.logmessage "shpPRSTS value BAD: " & sPoint & ", prstsArray(" & nValue & ") = >" & prstsArray(nValue) & "<"
		end if
		nValue = nValue + 1
	Loop

	call UpdateData]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Point1%},{%Point::Point2%},{%Point::Point3%},{%Point::Point4%},{%Point::Point5%},{%Point::Point6%},{%Point::Point7%},{%Point::Point8%},{%Point::Point9%},{%Point::Point10%},{%Point::Point11%},{%Point::Point12%},{%Point::Point13%},{%Point::Point14%},{%Point::Point15%},{%Point::Point16%},{%Point::Point17%},{%Point::Point18%},{%Point::Point19%},{%Point::Point20%},{%Point::Point21%},{%Point::Point22%},{%Point::Point23%},{%Point::Point24%},{%Point::Point25%},{%Point::Point26%},{%Point::Point27%},{%Point::Point28%},{%Point::Point29%},{%Point::Point30%},{%Point::Point31%},{%Point::Point32%},{%Point::Point33%},{%Point::Point34%},{%Point::Point35%},{%Point::Point36%},{%Point::Point37%},{%Point::Point3