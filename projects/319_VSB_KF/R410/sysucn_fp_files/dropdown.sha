<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="130px" height="80px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src="..\Styles\SysFaceplate.css"/></stylesheets><scripts><script event="" language="JScript" id="17A05BD8-2C52-40A6-8431-1F9FB7FB8117"><![CDATA[dropdownOpen = false;
function toggleDropdown(iconDropdown, options)
{
	if(iconDropdown.open == false)
	{
		iconDropdown.className = "dropdownClose";
		iconDropdown.open = true;
		options.style.visibility = "visible";
	}
	else if(iconDropdown.open == true)
	{
		iconDropdown.className = "dropdownOpen";
		iconDropdown.open = false;
		options.style.visibility = "hidden";
	}
}]]></script><script event="onshapeload" language="JScript" id=""><![CDATA[iconDropdown.open = false]]></script></scripts><parameters><parameter name="AuxPoint" type="Point" description="" defaultvalue=""/><parameter name="AuxReadParameter" type="Parameter" description="" defaultvalue=""/><parameter name="AuxWriteParameter" type="Parameter" description="" defaultvalue=""/></parameters><shapes><shape><group><group><group><element><html><content><![CDATA[
