armState:-1;indicateScanState:-1;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.9f;textColor:#ff0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['Code for event OnDisconnect
If (IsNumeric(me.value)) Then
  	Select Case me.value
		Case 3,8,9,10
'			' PlantScape 
'			'Parent.objects("HoneywellPlantScape").visible = True
		Case 4
'			' ProcessLogix 
'			'Parent.objects("HoneywellPlantScape").visible = False
		Case Else
'			' Default PlantScape 
'			'Parent.objects("HoneywellPlantScape").visible = True
	End Select

End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="FileRefFile" varianttype="VT_UI4" value="121"/><property name="FileRefRecord" varianttype="VT_UI4" value="1"/><property name="FileRefWord" varianttype="VT_UI4" value="1726"/><property name="FileRefFlags" varianttype="VT_UI4" value="16777216"/><property name="FileRefFormat" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldStart" varianttype="VT_UI1" value="12"/><property name="FileRefBitFieldWidth" varianttype="VT_UI1" value="4"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alarm" refcount="1"/><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><group><element><html><content><![CDATA[
