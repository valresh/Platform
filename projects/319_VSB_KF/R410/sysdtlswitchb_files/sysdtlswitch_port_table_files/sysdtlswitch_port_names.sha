WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 93.75%; COLOR: #00bfff; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); LEFT: 0%; ROWS: 1" id=alphaPortFetch class="hsc.alpha.1 HSC.ScriptDataObject.1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:40;numericDisplayFormat:%s;textColor:#00bfff;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[Dim ix, sFullPath, fQual
	on error resume next'  << Jim removed to not hide errors...

	for ix = 0 to nRememberedCount - 1
'		sFullPath = sPoint & "." & sPartPath & ix   << Jim modified, since "pointTable" already assigned sPoint
		sFullPath = "pointTable." & sPartPath & ix  'e.g. $switch_130.localhost.[ROOT\SNMP\]PCDI2955Y.SNMP_FRC1213_MIB_IFTABLE.__branchenum.10

'window.external.Parent.LogMessage "alphaPortFetch_ondatachange ix:" & ix 
'window.external.Parent.LogMessage "... sFullPath= " & sFullPath
		err.clear
		fQual = me.QualityGood(sFullPath)
		if (err.number = 0) and fQual and me.DataChanged(sFullPath) then PortNames(ix) = me.DataValue(sFullPath)
'window.external.Parent.LogMessage "... PortNames(" & ix & ") = " & PortNames(ix)
	next

'window.external.Parent.LogMessage "... calling UpdatePortList"
	UpdatePortList]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},{%Point::pointTable%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::paramPort0%},{%Parameter::paramPort1%},{%Parameter::paramPort2%},{%Parameter::paramPort3%},{%Parameter::paramPort4%},{%Parameter::paramPort5%},{%Parameter::paramPort6%},{%Parameter::paramPort7%},{%Parameter::paramPort8%},{%Parameter::paramPort9%},{%Parameter::paramPort10%},{%Parameter