<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="90px" height="16px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="" language="VBScript" id="9835D403-2091-47BC-92F2-4F2554C0C82E"><![CDATA['
' General Section (sysdtlswitch_port_table.sha)
option explicit
Dim sPartPath
Dim nRememberedCount

Sub InitPortTable(objShape, sSwitch)


'	window.external.Parent.LogMessage "InitPortTable TOP - sSwitchName: " & sSwitch & "; sPoint: " & sPoint
	sPartPath = "localhost.[ROOT\SNMP\" & sSwitch & "].SNMP_RFC1213_MIB_IFTABLE.__branchenum."
	objShape.autoReloadContent = false
	objShape.SetCustomProperty "Parameter", "paramPortCount", sPartPath & "#"
	objShape.SetCustomProperty "Point", "pointPortCount", sPoint
	objShape.ReloadContent		' trigger fetch of interface count
end sub

' This routine lives in sysdtlswitch_port_names.sha
Sub InitPortList(objShape)
Dim ix
	on error resume next
	if nRememberedCount = nPortCount then exit sub
	nRememberedCount = nPortCount
	objShape.autoReloadContent = false
	for ix = 0 to nPortCount - 1
		objShape.SetCustomProperty "Parameter", "paramPort" & ix, sPartPath & ix
	next
	for ix = nPortCount to 59
		objShape.SetCustomProperty "Parameter", "paramPort" & ix, ""
	next
	objShape.SetCustomProperty "Point", "pointTable", sPoint
	objShape.ReloadContent
end sub

' End General Section (sysdtlswitch_port_table.sha)
']]></script><script event="" language="VBScript" id="BB9BC535-EB6F-4C39-ACF2-2E88B5FD8410"><![CDATA['!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
