'	next
'	for ix = nPortCount to 49
'		objShape.SetCustomProperty "Parameter", "paramPort" & ix, ""
'	next
'	objShape.SetCustomProperty "Point", "pointTable", sPoint
'	objShape.ReloadContent
'end sub
'
' End General Section (sysdtlswitch_port_table.sha)
']]></script></scripts><parameters><parameter name="paramPortCount" type="Parameter" description="" defaultvalue=""/><parameter name="pointPortCount" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 44.44%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 93.75%; COLOR: #0000ff; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); LEFT: 0%; ROWS: 1" id=alphaPortCount class=hsc.alpha.1 tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:black;numberOfChars:40;numericDisplayFormat:%s;textColor:#0000ff;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[Dim ix
	nPortCount = me.value
	for ix = 0 to 59 '50 plus several extra such as VLAN, Gigabit, ...
		PortNames(ix) = "<none>"
	next
	InitPortList shpPortNames]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::pointPortCount%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::paramPortCount%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><group><group><element><html><content><![CDATA[<TEXTAREA style="POSITION: absolute; BORDER-BOTTOM-STYLE: none; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; BACKGROUND-COLOR: transparent; FONT-STYLE: normal; WIDTH: 100%; FONT-FAMILY: Tahoma; WORD-WRAP: normal; BORDER-TOP-STYLE: none; HEIGHT: 93.75%; COLOR: #00bfff; FONT-SIZE: 8pt; BORDER-LEFT-STYLE: none; OVERFLOW: hidden; TOP: 0%; FONT-WEIGHT: normal; TEXT-DECORATION: none; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); LEFT: 0%; ROWS: 1" id=shpPortNames_alphaPortFetch class="hsc.alpha.1 HSC.ScriptDataObject.1" tabIndex=0 hdxproperties="fillColor:transparent;HDXBINDINGID:-4;lineColor:black;numberOfChars:40;numericDisplayFormat:%s;textColor:#00bfff;">Text</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[Dim ix, sFullPath, fQual
	on error resume next'  << Jim removed to not hide errors...

	for ix = 0 to nRememberedCount - 1
'		sFullPath = sPoint & "." & sPartPath & ix   << Jim modified, since "pointTable" already assigned sPoint
		sFullPath = "pointTable." & sPartPath & ix  'e.g. $switch_130.localhost.[ROOT\SNMP\]PCDI2955Y.SNMP_FRC1213_MIB_IFTABLE.__branchenum.10

'window.external.Parent.LogMessage "alphaPortFetch_ondatachange ix:" & ix 
'window.external.Parent.LogMessage "... sFullPath= " & sFullPath
		err.clear
		fQual = me.QualityGood(sFullPath)
		if (err.number = 0) and fQual and me.DataChanged(sFullPath) then PortNames(ix) = me.DataValue(sFullPath)
'window.external.Parent.LogMessage "... PortNames(" & ix & ") = " & PortNames(ix)
	next

'window.external.Parent.LogMessage "... calling UpdatePortList"
	UpdatePortList]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=""/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
