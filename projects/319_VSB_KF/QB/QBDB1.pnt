SCRIPT   10FI03_HZ	BEGINSCRIPT
SCRIPT   10FI03_HZ	<HWSCRIPTCOLLECTION><HWSCRIPTS>
SCRIPT   10FI03_HZ	<HWSCRIPT ObjectType="Param" ObjectID="10FI03_HZ.PV" EventType="OnChange" EngineID="Testing">Dim Pref, MyArrayA, MyArrayB, L, H, ItemH, ItemL
SCRIPT   10FI03_HZ	Pref = "10FI03"
SCRIPT   10FI03_HZ	MyArrayA = Array("0", "1", "6", "7")
SCRIPT   10FI03_HZ	MyArrayB = Array("A", "B", "C", "D", "E", "F", "G", "H")
SCRIPT   10FI03_HZ	H = UBound (MyArrayA)
SCRIPT   10FI03_HZ	L = UBound (MyArrayB)
SCRIPT   10FI03_HZ	IF me.value = "Disable" then
SCRIPT   10FI03_HZ	For i = 0 to H Step 1
SCRIPT   10FI03_HZ	ItemH = MyArrayA (i)
SCRIPT   10FI03_HZ	For j = 0 to L Step 1
SCRIPT   10FI03_HZ			ItemL = MyArrayB (j)
SCRIPT   10FI03_HZ		 ParamValue(Pref &amp; ItemH &amp; ItemL &amp; "_HZ.AlmenbState") = 0
SCRIPT   10FI03_HZ		Next
SCRIPT   10FI03_HZ	Next
SCRIPT   10FI03_HZ	Else
SCRIPT   10FI03_HZ	For i = 0 to H Step 1
SCRIPT   10FI03_HZ	ItemH = MyArrayA (i)
SCRIPT   10FI03_HZ	For j = 0 to L Step 1
SCRIPT   10FI03_HZ			ItemL = MyArrayB (j)
SCRIPT   10FI03_HZ		 ParamValue(Pref &amp; ItemH &amp; ItemL &amp; "_HZ.AlmenbState") = 1
SCRIPT   10FI03_HZ		Next
SCRIPT   10FI03_HZ	Next
SCRIPT   10FI03_HZ	End If</HWSCRIPT></HWSCRIPTS><HWPERIODICEVENTS/></HWSCRIPTCOLLECTION>
SCRIPT   10FI03_HZ	ENDSCRIPT

