%--------------------------------------------------------------------------------------------------
% name=0 по умолчанию
% name=1 присутствует только имя объекта
% name=2 сообщение без параметров
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% string=0  по умолчанию
% string=1  Для double и float значения выводятся как строки (чтобы не потерять точность)
%           Для int и bool выводится техт, определяемый в txtN="xxx" N = 0..7
% string=2  Выводится только новое значение
% string=3  Текст берётся из Tegs.scn
% string=-1 Заменяет строку {string=1 txt0=AAUT txt1=MMAN txt2=CCAS txt3=" O/S"}
%--------------------------------------------------------------------------------------------------
% Квитирование
<mnemo  =Квитирование filtr="'%s' - Квитирование" name=1>
%--------------------------------------------------------------------------------------------------
% Изменение моды
<klapan="Мода" filtr="Клапан '%s' переведен в режим %s" string=2 txt0="AAuto" txt1="MManual">
<zadv  ="Мода" filtr="'%s' переведён из %s в %s" string=1 txt0="AA" txt1="MM" txt2="CC" txt3=" OFF">
<hs    ="Мода" filtr="'%s' переведён из %s в %s" string=1 txt0="AA" txt1="MM" txt2="CC" txt3=" OFF">
%--------------------------------------------------------------------------------------------------
%
% Универсальные переменные
%
<value=INT filtr="Кнопка '%s' нажата" name=1>
<value=DBL filtr="Задание '%s' изменилось с %s до %s" string=1>
<value=Задание    value=DBL filtr="Задание '%s' изменилось с %s до %s" string=1>
<value=Турбонасос value=INT filtr="'%s' дана команда на %s" txt0="выключение" txt1="включение" string=2>
%--------------------------------------------------------------------------------------------------
%
% Датчики
%
<sensor=PV  filtr="Показания '%s'" name=1>

<switch=SP filtr="Переключатель '%s' переведён из положения %d в %d">
%--------------------------------------------------------------------------------------------------
%
% Насосы
%
<pump=Вкл/Выкл   value=ON/OFF filtr="'%s' нажата кнопка %s насоса"   txt0="выключения" txt1="включения" string=2>
<pump=Показания  value=ON>
<pump=Вход   filtr="Положение входной задвижки '%s' изменилось с %s %% до %s %%" string=1>
<pump=Выход  filtr="Положение выходной задвижки '%s' изменилось с %s %% до %s %%" string=1>
<pump=Дренаж filtr="Положение дренажа '%s' изменилось с %s %% до %s %%" string=1>
<pump=Auto   filtr="Пуск '%s' переведён в %s" txt0="AUTO" txt1="MAN" string=2>
<pump=Стопор filtr="'%s' %s" txt1="заблокирован на включение" txt0="разрешено включать" string=2>
<pump="Открыть" filtr="Кнопка открытия насоса '%s' %s"   txt0="отжата" txt1="нажата" string=2>
<pump="Остановить" filtr="Кнопка остановки насоса '%s' %s"   txt0="отжата" txt1="нажата" string=2>
<pump=Включен  value=ON>
<pump=Выход2  filtr="Положение задания '%s' изменилось с %s %% до %s %%" string=1>
<pump="LocalRemote" filtr="Переключатель  '%s' переведён из положения %d в %d">
%--------------------------------------------------------------------------------------------------
%
% КВО
%
<kvo=Вкл/Выкл value=ON/OFF filtr="'%s' нажата кнопка %s" txt0="выключения" txt1="включения" string=2>
<kvo=ON2/ON filtr="'%s' нажата кнопка %s" txt0="включения половины скорости" txt1="включения полной скорости" string=2>
<kvo="Входной дренаж"     filtr="Положение входного дренажа '%s' изменилось с %s %% до %s %%" string=1>
<kvo="Выходной дренаж"    filtr="Положение выходного дренажа '%s' изменилось с %s %% до %s %%" string=1>
<kvo="Показания" value=ON>
<kvo="Пуск" filtr="Ручка '%s' в положении %s" txt0="СТОП" txt1="ПУСК" string=2>
<kvo="Задание" filtr="Задание '%s' изменилось с %s %% до %s %%"  string=1>
