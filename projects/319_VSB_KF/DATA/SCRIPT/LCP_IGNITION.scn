<rect=paramx,paramy,paramx+param0,paramy+param1>
<word="param2"
 rect=paramx+2,paramy+2,paramx+param0-2,paramy+param1-2 a=cv>
</macros>
<macros=RM_LEFT param0=110 param1=28>
<rect=paramx,paramy,paramx+param0,paramy+param1>
<word="param2"
 rect=paramx+2,paramy+2,paramx+param0-2,paramy+param1-2 a=lt>
</macros>
<macros=RM_RIGHT param0=110 param1=28>
<rect=paramx,paramy,paramx+param0,paramy+param1>
<word="param2"
 rect=paramx+2,paramy+2,paramx+param0-2,paramy+param1-2 a=rt>
</macros>
<macros=TM param0=110 param1=28>
<word="param2"
 rect=paramx+2,paramy+2,paramx+param0-2,paramy+param1-2 a=cv>
</macros>
<macros=TM_LEFT param0=110 param1=28>
<word="param2"
 rect=paramx+2,paramy+2,paramx+param0-2,paramy+param1-2 a=lt>
</macros>
<macros=TM_RIGHT param0=110 param1=28>
<word="param2"
 rect=paramx+2,paramy+2,paramx+param0-2,paramy+param1-2 a=rt>
</macros>
<font=Arial bold=900 height=13>
<textcolor=000000>
<pen=solid color=000000>
<brush=FFFFFF>
<RM=10,80 par0=100 par1=42 par2="Зажигание пилота 1">
<RM=130,80 par0=100 par1=42 par2="Зажигание пилота 2">
<RM=250,80 par0=100 par1=42 par2="Зажигание пилота 3">
<RM=370,80 par0=100 par1=42 par2="Зажигание пилота 4">
