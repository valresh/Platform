    <btn="AM STATS"         rc=" 623+paramx, 84+paramy,56,53">
    <btn="UNIT TREND"       rc=" 623+paramx,151+paramy,56,53">
    <btn="ALM SUMM"         rc=" 706+paramx, 17+paramy,58,53">
    <btn="UNIT ALM SUMM"    rc=" 780+paramx, 17+paramy,58,53">
    <btn="ALM ANNC"         rc=" 854+paramx, 17+paramy,58,53">
    <btn="MSG SUMM"         rc=" 706+paramx, 84+paramy,58,53">
    <btn="MSG CONFM"        rc=" 780+paramx, 84+paramy,58,53">
    <btn="MSG CLEAR"        rc=" 854+paramx, 84+paramy,58,53">
    <btn="ACK"              rc=" 706+paramx,151+paramy,86,53">
    <btn="SIL"              rc=" 824+paramx,151+paramy,88,55">
    <btn="MAN"              rc=" 939+paramx, 17+paramy,56,53">
    <btn="AUTO"             rc=" 939+paramx, 84+paramy,56,53">
    <btn="NORM"             rc=" 939+paramx,151+paramy,56,53">
    <btn="LOAD"             rc="1012+paramx, 17+paramy,56,53">
    <btn="SP"               rc="1012+paramx, 84+paramy,56,53">
    <btn="OUT"              rc="1012+paramx,151+paramy,56,53">
    <btn="UP"               rc="1098+paramx, 84+paramy,56,53">
    <btn="DOWN"             rc="1098+paramx,151+paramy,56,53">
    <btn="UPUP"             rc="1178+paramx, 84+paramy,56,53">
