<macros=Q param7=param4>
  <round=4 rc=param3,74,65>
  <bitmap=alarms rc=param3+1,74,15>
  <draw=param7 align=cv rc=param3+18,74,42>
  <Objects>
    <alarm=param4 rc=param3,74,65 real=registr0 red=10,3 yel=-18,3 lampNumber=param1>
  </Objects>
</macros>

<macros=QEMPTY param7=param4>
  <round=4 rc=param3,74,65>
  <bitmap=alarms rc=param3+1,74,15>
  <draw=param7 align=cv rc=param3,74,56>
</macros>

<macros=L param7=param4>
  <round=4 rc=param3,74,65>
  <draw=param7 align=left rc=param3+2,74,28>
  <draw="param6" align=cv rc=param3+2,74,64>
  <Objects>
    <btn=param4 goto=param5 rc=param3,74,66 alpha=1>
  </Objects>
</macros>

<macros=LSHIFT param7=param4>
  <round=4 rc=param3,74,65>
  <draw=param7 align=left rc=param3+2,74,28>
  <draw="param6" align=cv rc=param3+2,74,64>
  <Objects>
    <btn=param4  goto=param5 rc=param3,74,66 alpha=1 shift=1>
  </Objects>
</macros>

<macros=B1 param7=param4>
  <round=4 rc=param3,74,65>
  <bitmap=1Lamp rc=param3+1,74,15>
  <draw=param7 align=cv rc=param3+param5,74,28>
  <Objects>
     <btn=param4 rc=param3,74,66 virtual=1 pt=10,3>
  </Objects>
</macros>
