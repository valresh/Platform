e="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=shpSub_alpDyn4 class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 90%; FONT-FAMILY: Tahoma; WIDTH: 29.76%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 23.57%; BORDER-LEFT-STYLE: none; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="dateFormat:0;dateTimeFormat:0;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:50;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;timeFormat:1;timeIncludeMS:0;">28.10.2005 23:05:43.005</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value=""/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="10"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=shpSub_group001 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 100%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:20;lineColorBlink:False;Width:420;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=shpSub class=hsc.shape.1 style="FONT-SIZE: 0px; TEXT-DECORATION: none; HEIGHT: 4.44%; FONT-FAMILY: Arial; WIDTH: 52.5%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 36.12%; TOP: 89.55%; BEHAVIOR: url(#HSCShapeLinkBehavior) url(#HDXVectorFactory#shapelink); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;Height:20;lineColorBlink:False;Width:420;" HDX_LOCK="-1" value = "1" src = ".\sysscdaActiveXCM_files\SubShape.sha" parameters = "Point?PointName:;Parameter?ParamName:;Value?strValue:;Value?nDataType:;Value?bFlag:;" linkType = "embedded" globalscripts = "" styleClass = ""></DIV>]]></content><scripts><script event="onshapeload" language="VBScript"><![CDATA[Set o = me
Value = me.GetCustomProperty("Value","strValue")
Flag = me.GetCustomProperty("Value","bFlag")
DataType = me.GetCustomProperty("Value","nDataType")

If Flag = "True" then
	intTimerID = window.setInterval ("UpdateValue()", 100)
End If]]></script></scripts></html></group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=LostMessage class=hvg.textbox.1 style="OVERFLOW: hidden; FONT-SIZE: 8pt; TEXT-DECORATION: ; HEIGHT: 4.88%; FONT-FAMILY: Arial; WIDTH: 25.5%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 37.5%; TOP: 66.66%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;Height:22;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:204;" HDX_LOCK="-1">Lost Connection with ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=SuccMessage class=hvg.textbox.1 style="OVERFLOW: hidden; FONT-SIZE: 8pt; TEXT-DECORATION: ; HEIGHT: 4.22%; FONT-FAMILY: Arial; WIDTH: 34.87%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 37.5%; TOP: 66.66%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;Height:19;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:279;" HDX_LOCK="-1">Re-established Connection with ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[
<OBJECT tabIndex=-1 id=CmActiveX1 class=hsc.activexcontrol.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 99.77%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%" classid=clsid:B094BC79-20ED-11D4-A744-0000F87B069E HDX_LOCK="-1"><PARAM NAME="_Version" VALUE="65536"><PARAM NAME="_ExtentX" VALUE="21167"><PARAM NAME="_ExtentY" VALUE="11880"><PARAM NAME="_StockProps" VALUE="32"><PARAM NAME="BorderStyle" VALUE="0">]]></content><scripts><script event="InvokeChart(lpszPointName)" language="VBScript"><![CDATA[on error resume next
window.external.Application.RequestTask 21, 73, 0, 0, 0, lpszPointName]]></script><script event="InvokeERDBStatus(nERDBStatus)" language="VBScript"><![CDATA[On Error Resume Next
	
	'Update the ERDB Status in the Display
    

If ((nERDBStatus = ErdbDiscFromA Or nERDBStatus = ErdbDiscFromB) And intERDBStatus <> -1) Then
	    'objEStat.Value = "LOST"
		window.external.Application.MessageZoneText = Me.parentElement.children.namedItem("LostMessage").Value
    ElseIf ((nERDBStatus = ErdbDiscFromA Or nERDBStatus = ErdbDiscFromB) And intERDBStatus = -1) Then
	'objEStat.Value = "FAIL"
		window.external.Application.MessageZoneText = Me.parentElement.children.namedItem("FailMessage").Value
    ElseIf (intERDBStatus = -1) Then
        

	'objEStat.Value = "INIT"
		window.external.Application.MessageZoneText = ""
    Else
        'objEStat.Value = "SUCCESS"
		window.external.Application.MessageZoneText = Me.parentElement.children.namedItem("SuccMessage").Value

    End If
    
    intERDBStatus = nERDBStatus]]></script><script event="InvokeValueChanged(bstrPoint, bstrParam, vValue, nDataType)" language="VBScript"><![CDATA[shpSub.autoReloadContent = False
shpSub.SetCustomProperty "Point", "PointName", CStr(bstrPoint)
shpSub.SetCustomProperty "Parameter", "ParamName", CStr(bstrParam)
shpSub.SetCustomProperty "Value", "bFlag", "True"
shpSub.SetCustomProperty "Value", "strValue", CStr(vValue)
shpSub.SetCustomProperty "Value", "nDataType", CStr(nDataType)
shpSub.ReloadContent]]></script><script event="NavigateToChart(lpszPointName, lpszSysDisplayFileName)" language="VBScript"><![CDATA[	Pointname = split(lpszPointName,".")
	Chartname = lpszSysDisplayFileName & "_Chart.htm"
	
	if not window.external.Application.FindFile(Chartname) = "" then
		window.external.Application.ExecuteOperatorCommand Chartname&"?HSCPOINT="&Pointname(0)
	else
		window.external.Application.RequestTask 21, 73, 0, 0, 0, Pointname(0)
	end if

	window.external.Application.Dictionary.Add "IsNavigationLinkClicked", "True"
	window.external.Application.Dictionary.Add "NavigationBlock", lpszPointName]]></script></scripts></html></element><element><html><content><![CDATA[<INPUT tabIndex=-1 id=DSAPointError class=hsc.button.1 style="FONT-SIZE: 10pt; TEXT-DECORATION: none; BORDER-TOP: #ffffff 2px; HEIGHT: 99.77%; FONT-FAMILY: Arial; BORDER-RIGHT: #ffffff 2px; WIDTH: 100%; BACKGROUND-REPEAT: no-repeat; BORDER-BOTTOM: #ffffff 2px; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; BORDER-LEFT: #ffffff 2px; TOP: 0%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: #ffffff" type=button value="Control builder charts do not operate between DSA connected servers/clients of different releases" hdxproperties="fillColor:#ffffff;fillColorBlink:False;HDXBINDINGID:-4;indicateBadState:False;indicateNaNState:False;indicateScanState:False;lineColorBlink:False;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1">]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=-1 id=MultipleChartInPageError class=hsc.button.1 style="FONT-SIZE: 10pt; TEXT-DECORATION: none; BORDER-TOP: #ffffff 2px; HEIGHT: 99.77%; FONT-FAMILY: Arial; BORDER-RIGHT: #ffffff 2px; WIDTH: 100%; BACKGROUND-REPEAT: no-repeat; BORDER-BOTTOM: #ffffff 2px; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; BORDER-LEFT: #ffffff 2px; TOP: 0%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: #ffffff" type=button value="Only one chart can be embedded per display&#13;&#10;Extra charts need to be removed from the display to allow the one remaining chart to be functional" hdxproperties="fillColor:#ffffff;fillColorBlink:False;HDXBINDINGID:-4;indicateBadState:False;indicateNaNState:False;indicateScanState:False;lineColorBlink:False;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1">]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=grpChart class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 450px; WIDTH: 800px; POSITION: absolute; LEFT: 0px; TOP: 0px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:450;lineColorBlink:False;Width:800;"></DIV>]]></content></html></group></shape></shapes></shapefile>