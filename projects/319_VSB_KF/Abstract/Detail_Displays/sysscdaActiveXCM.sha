<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="800px" height="450px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[On Error resume Next
	intERDBStatus = -1
	set oChartShape = me
	CmActiveX1.height = me.style.height
	CmActiveX1.width = me.style.width
	'Check for the multiple chart shape in the page
	set objPage = document.getElementById("Page")
	call Do_Page_Contains_Multiple_Charts(objPage)]]></script><script event="" language="VBScript" id="8B69480C-E532-4D3E-B365-165D80E0A9D8"><![CDATA[Dim intERDBStatus
Dim oChartShape 'Shape file issue
Dim blnEsigEnabled
blnEsigEnabled = 0 ' Disabled
Dim isServerVersionOK
isServerVersionOK = True
Dim isMultipleChartInPage
isMultipleChartInPage = True
Dim blnChartInitialized
blnChartInitialized = False
Dim oShape
Dim blnControlConfirmRequired
blnControlConfirmRequired = 0

ErdbConnToA = 0
ErdbDiscFromA = 1
ErdbConnToB = 2
ErdbDiscFromB = 3

'Check if the page contains multiple chart shape
Sub Do_Page_Contains_Multiple_Charts(objElem)
On Error Resume Next
Dim NumShpChart
NumShpChart = 0
set oShape = Nothing
set objshpElem = objElem
For i = objshpElem.children.length -1 to 0 Step -1 
	if objshpElem.children(i).ClassName = "hvg.group.1" then
		Do_Page_Contains_Multiple_Charts objshpElem.children(i)
	end if
	if (objshpElem.children(i).ClassName = "hsc.shape.1") then
		if instr(objshpElem.children(i).src,"sysscdaActiveXAC.sha") or instr(objshpElem.children(i).src,"sysscdaActiveXCM.sha") then
			NumShpChart =  NumShpChart+1
			set oShape =  objshpElem.children(i)
			oShape.style.visibility = "Hidden"
		end if
	end if
next
if NumShpChart > 1 then
	isMultipleChartInPage = True
else
	isMultipleChartInPage = false
end if
	oShape.style.visibility = "Inherit"
End sub

' Chart Intialize function

Sub Initialize_Chart(oSource)
On Error resume Next
	Set oChartActivex = oChartShape.Objects("CmActiveX1")
	Set oDSAPointError = oChartShape.Objects("DSAPointError")
	set oMultipleChartInPageError = oChartShape.Objects("MultipleChartInPageError")
if oSource.QualityGood("TagName.LocationFullItemName") then
	if isServerVersionOK = False then
		oChartActivex.style.visibility = "Hidden"
		oDSAPointError.style.visibility = "Inherit"
		oMultipleChartInPageError.style.visibility = "Hidden"
		blnChartInitialized = false
		Exit sub
	end if
	if (isMultipleChartInPage = True) then
		oChartActivex.style.visibility = "Hidden"
		oDSAPointError.style.visibility = "Hidden"
		oMultipleChartInPageError.style.visibility = "Inherit"
		blnChartInitialized = false
		Exit sub
	end if
	if ucase(oSource.DataValue("TagName.BLOCKTYPNAME")) = Ucase("SYSTEM:CONTROLMODULE") or ucase(oSource.DataValue("TagName.BLOCKTYPNAME")) = Ucase("SYSTEM:UCM")  then
		Dim NumSig
		NumSig=0
		If (len(oSource.DataValue("TagName.PrimarySignatureMeaning"))) <> 255  Then
			NumSig=1
		End If
		If NumSig=1 And len(oSource.DataValue("TagName.SecondarySignatureMeaning")) <> 255  Then
			NumSig=2
		End If
		oChartActivex.NavigateBlockName = ""
		isFunctionBlockToFocus = window.external.Application.Dictionary.Item("IsNavigationLinkClicked").Value
		if  (isFunctionBlockToFocus) then
			FunctioBlockName = window.external.Application.Dictionary.Item("NavigationBlock").Value
			'Assigning the block name that need to highlighted
			oChartActivex.NavigateBlockName = FunctioBlockName
		end if
		oChartActivex.PointName = cstr(oSource.DataValue("TagName.Name"))
		oChartActivex.ServerName = cstr(oSource.DataValue("TagName.SrvConLinkNum"))
		oChartActivex.SecurityLevel = window.external.Application.SecurityLevel 
		oChartActivex.OperatorName = window.external.Application.OperatorID 
		oChartActivex.StationServerName = window.external.Application.ServerName 
		oChartActivex.StationNumber = window.external.Application.StationNumber	
		oChartActivex.ElectronicSignature = blnEsigEnabled
		oChartActivex.ControlConfirm = blnControlConfirmRequired 'Control Confirmation is not enabled or not retuning proper value'
		oChartActivex.NumberSignatures = NumSig
		oChartActivex.StationAcronym = window.external.Application.Parent.RuntimeStatus.StationAcronym
		oChartActivex.style.visibility = "Inherit"
		oDSAPointError.style.visibility = "Hidden"
		oMultipleChartInPageError.style.visibility = "Hidden"
		window.external.Application.Dictionary.Remove "IsNavigationLinkClicked"
		window.external.Application.Dictionary.Remove "NavigationBlock"
		blnChartInitialized = True
	end if
end if
End sub]]></script><script event="" language="VBScript" id="CA508B2A-D50E-4AC2-BA0A-B8B64050478D"><![CDATA[Dim intTimerID
Dim Value
Dim DataType
Dim Flag
Dim o


Function UpdateValue()
'If o <> Null Then
	If( (DataType=4) OR (DataType=6) OR (DataType=20) OR (DataType=7) ) Then	
		o.Objects("alpDyn1").value = Value		'Bool/Boolean/Enum/SdEnum/BitString
	ElseIf(DataType=32) Then	
		o.Objects("alpDyn2").value = Value		'TimeOfDay
	ElseIf(DataType=5) Then	
		o.Objects("alpDyn4").value = Value		'Time
	Else
		o.Objects("alpDyn3").value = Value		'Treat rest all in text control
	End If
'End If
	window.clearInterval(intTimerID)
End Function]]></script><script event="onshapeunload" language="VBScript" id=""><![CDATA[on error resume next
Set oChartActivex = oChartShape.Objects("CmActiveX1")
oChartActivex.ReloadInPrgs = true
if blnChartInitialized = false then
	window.external.Application.Dictionary.Remove "IsNavigationLinkClicked"
	window.external.Application.Dictionary.Remove "NavigationBlock"
end if]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%CurrentPoint%}"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=LimitMessage class=hvg.textbox.1 style="OVERFLOW: hidden; FONT-SIZE: 8pt; TEXT-DECORATION: ; HEIGHT: 3.77%; FONT-FAMILY: Arial; WIDTH: 50.5%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 0.87%; TOP: 66.66%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;Height:17;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:404;" HDX_LOCK="-1">Unable to open Display. Maximum limit reached. Try again Later.</DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=FailMessage class=hvg.textbox.1 style="OVERFLOW: hidden; FONT-SIZE: 8pt; TEXT-DECORATION: ; HEIGHT: 5.11%; FONT-FAMILY: Arial; WIDTH: 22.5%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 1.12%; TOP: 66.66%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;Height:23;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:180;" HDX_LOCK="-1">Cannot Connect to ERDB</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=alpOwerTagname class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 2.22%; FONT-FAMILY: Arial; WIDTH: 1.25%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #ff0000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 8.25%; BORDER-LEFT-STYLE: none; TOP: 64.44%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:255;numericDisplayFormat:%s;textColor:#ff0000;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error Resume Next
shaSrvVersion.autoReloadContent = false
shaSrvVersion.SetCustomProperty "Point" , "TagName" , me.DataValue("TagName.Name")
shaSrvVersion.SetCustomProperty "Point" , "SrvTagName" , me.DataValue("TagName.OwnerTagName")
shaSrvVersion.ReloadContent()]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="Name"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="Name,OwnerTagName,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><group><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=shaSrvVersion_alpOperId class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 83.33%; FONT-FAMILY: Arial; WIDTH: 83.33%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #ff0000; FONT-STYLE: normal; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; BORDER-LEFT-STYLE: none; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error Resume Next
if blnChartInitialized = true then
	oChartShape.Objects("CmActiveX1").OperatorName = window.external.Application.OperatorID
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="FileRefFile" varianttype="VT_UI4" value="2"/><property name="FileRefRecord" varianttype="VT_UI4" value="1"/><property name="FileRefWord" varianttype="VT_UI4" value="98"/><property name="FileRefFlags" varianttype="VT_UI4" value="2048"/><property name="FileRefFormat" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldStart" varianttype="VT_UI1" value="0"/><property name="FileRefBitFieldWidth" varianttype="VT_UI1" value="4"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=shaSrvVersion_ESig class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 83.33%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 83.33%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; FONT-WEIGHT: normal; COLOR: #ff0000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; BORDER-LEFT-STYLE: none; BORDER-RIGHT-COLOR: transparent; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:none;borderWidth:;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:1;numericDisplayFormat:%.0f;textColor:#ff0000;textColorBlink:False;" HDX_LOCK="-1">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error Resume Next
blnEsigEnabled = me.value]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="1"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="FileRefFile" varianttype="VT_UI4" value="121"/><property name="FileRefRecord" varianttype="VT_UI4" value="1"/><property name="FileRefWord" varianttype="VT_UI4" value="1733"/><property name="FileRefFlags" varianttype="VT_UI4" value="0"/><property name="FileRefFormat" varianttype="VT_UI1" value="5"/><property name="FileRefBitFieldStart" varianttype="VT_UI1" value="10"/><property name="FileRefBitFieldWidth" varianttype="VT_UI1" value="1"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=shaSrvVersion_alpsrvVersion class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; OVERFLOW: hidden; WORD-WRAP: normal; FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 91.66%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #ff0000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0%; BORDER-LEFT-STYLE: none; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[On Error Resume Next
if me.QualityGood("TagName.Name") and me.QualityGood("srVTagName.Release") and me.QualityGood("TagName.LocationFullItemName") then
	if me.DataValue("srVTagName.Release") = window.external.Application.ServerVersion then
		isServerVersionOK = true
		Call Initialize_Chart(me)
	else
		isServerVersionOK = false
		Call Initialize_Chart(me)
	end if
end if
if me.QualityGood("TagName.ControlConfirmRequired") and me.DataValue("TagName.ControlConfirmRequired") = 1 then
	blnControlConfirmRequired = 1
else
	blnControlConfirmRequired = 0
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="Release"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%CurrentPoint%},{%CurrentPoint%},{%CurrentPoint%},{%CurrentPoint%},{%CurrentPoint%},{%CurrentPoint%},{%CurrentPoint%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="Name,LocationFullItemName,PrimarySignatureMeaning,SecondarySignatureMeaning,SrvConLinkNum,ControlConfirmRequired,BLOCKTYPNAME,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,1,1,1,1,0,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,,,,"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
