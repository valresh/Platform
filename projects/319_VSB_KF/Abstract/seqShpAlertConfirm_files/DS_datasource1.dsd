			&lt;script id="xfDTCellFormat" language="jscript"&gt;
					try {
						return DTFormat.Localize(Value, $$DateTimeCellFormat$$);
					} catch(e) {
						return "";
					}
				&lt;/script&gt;
			&lt;script id="xfDTTooltipFormat" language="jscript"&gt;
					try {
						return DTFormat.Localize(Value, $$DateTimeTooltipFormat$$);
					} catch(e) {
						return "";
					}
				&lt;/script&gt;
			&lt;script id="xfAlarmDTCellFormat" language="jscript"&gt;
					try {
						var javalue = new VBArray(Value).toArray();
						var jaalarmtime = new Array(javalue[0], javalue[1]);
						var alarmtimelocalized = DTFormat.Localize(jaalarmtime, $$DateTimeCellFormat$$);
						if (javalue[2] == null || javalue[2] == "")
						{
							return alarmtimelocalized;
						}
						else
						{
							return alarmtimelocalized + "*";
						}
					} catch(e) {
						return "";
					}
				&lt;/script&gt;
			&lt;script id="xfAlarmDTTooltipFormat" language="jscript"&gt;
					try {
						var javalue = new VBArray(Value).toArray();
						var jaalarmtime = new Array(javalue[0], javalue[1]);
						var alarmtimelocalized = "Host Time: " + DTFormat.Localize(jaalarmtime, $$DateTimeTooltipFormat$$);
						if (javalue[2] == null || javalue[2] == "")
						{
							return alarmtimelocalized;
						}
						else
						{
							var jaunsuppressedtime = new Array(javalue[2], javalue[3]);
							var unsuppressedtimelocalized = "Unsuppressed Time: " + DTFormat.Localize(jaunsuppressedtime, $$DateTimeTooltipFormat$$);
							return alarmtimelocalized + "\n" + unsuppressedtimelocalized;
						}
					} catch(e) {
						return "";
					}
				&lt;/script&gt;
			&lt;script id="xfNumCellFormat" language="jscript"&gt;
					try {
						return DTFormat.Localize(Value, 0);
					} catch(e) {
						return "";
					}
				&lt;/script&gt;
