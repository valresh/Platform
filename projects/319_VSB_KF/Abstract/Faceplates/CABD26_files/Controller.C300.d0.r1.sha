<DIV tabIndex=-1 id=UDI class=hvg.textbox.1 style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 12.22%; FONT-FAMILY: Arial; WIDTH: 35%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: right; LEFT: 64%; TOP: 0.55%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:22;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:35;">{%Text::UpDevIndex%}</DIV>]]></content></html></element><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=UCTemp class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 93.75%; FONT-FAMILY: Arial; WIDTH: 100%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:4;numericDisplayFormat:%.1f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::UC300%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="CTEMP"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textbox002 class=hvg.textbox.1 style="FONT-SIZE: 8pt; OVERFLOW: hidden; TEXT-DECORATION: ; HEIGHT: 93.75%; FONT-FAMILY: Arial; WIDTH: 32.5%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 67.5%; TOP: 6.25%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:15;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:13;">°C</DIV>]]></content></html></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group004 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 8.88%; WIDTH: 40%; POSITION: absolute; LEFT: 15%; TOP: 14.44%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:40;"></DIV>]]></content></html></group><html><content><![CDATA[
<DIV tabIndex=-1 id=Up class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 42.85%; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:180;lineColorBlink:False;Width:100;"></DIV>]]></content></html></group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=CheckC300 class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 3.57%; FONT-FAMILY: Arial; WIDTH: 12%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 2px; BORDER-RIGHT-STYLE: none; PADDING-LEFT: 2px; LEFT: 0%; TOP: 0%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:Solid;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[Dim oShape, C300Name, C300Prime, C300Sec, CID, UpID
on error resume next
Set oShape = me.parentnode.parentnode
C300Name = oShape.getcustomproperty("Point","ControlC")  		'К имени контроллера добавляем символу "P" и "S"

	C300Prime = C300Name
	C300Sec = mid(C300Name, 1, 8) & "S"

Set CID = me.value					

Set UpID = oShape.CustomProperty("Text","UpDevIndex")			

if UpID = CID then												'Сравнение, если индекс Primary контроллера равен "железному" индексу 
	oShape.setCustomProperty "Point", "UC300", C300Prime		'с нечетным номером, а нечетный всегда на верху. То отображаем его наверху
	oShape.setCustomProperty "Point", "BC300", C300Sec			'если нет то внизу
else
	oShape.setCustomProperty "Point", "UC300", C300Sec	
	oShape.setCustomProperty "Point", "BC300", C300Prime
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::ControlC%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="RdnDEVICEIDX"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group008 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 420px; WIDTH: 100px; POSITION: absolute; LEFT: 20px; TOP: 20px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:420;lineColorBlink:False;Width:100;"></DIV>]]></content></html></group></shape></shapes></shapefile>