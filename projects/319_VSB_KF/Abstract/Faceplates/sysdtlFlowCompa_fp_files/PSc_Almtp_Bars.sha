<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="8px" height="144px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><scripts><script event="" language="VBScript" id="C68B991D-826F-4483-8F2A-92C4D0F0CC64"><![CDATA[sub AlmTP_OnUpdate(oSource, oSource1, oRect)
dim iTop, iHeight, oShape, sToolTipTxt, sEUDesc
on error resume next
if isnumeric(oSource.currentvalue)and oSource1.value>1 then 
 set oShape=oSource.parentnode.parentnode
 itop=oSource.parentnode.style.pixeltop
 iheight=oSource.parentnode.style.pixelheight
 if right(oRect.id,1)="H" then
   oRect.style.pixelheight=iheight-(oSource.value-oShape.objects("ConAlpPVEULo").value)/(oShape.objects("ConAlpPVEUHi").value-oShape.objects("ConAlpPVEULo").value)*iheight
 else
   oRect.style.pixelheight=(oSource.value-oShape.objects("ConAlpPVEULo").value)/(oShape.objects("ConAlpPVEUHi").value-oShape.objects("ConAlpPVEULo").value)*iheight
   oRect.style.pixeltop=iheight-oRect.style.pixelheight	
 end if
 call AlmPriority_OnUpdate(oSource1,oRect)
 select Case right(oRect.id,2)
   case "HH" sToolTipTxt="High High "
   case "cH"  sToolTipTxt="High "
   case "LL" sToolTipTxt="Low Low "
   case "cL"  sToolTipTxt="Low "
 end select
 sEUDesc=page.all("ConAlpEUDesc").value
 oRect.title="PV " & sToolTipTxt & "alarm limit: " & oSource.value & " " & sEUDesc
else
 oRect.style.visibility="hidden"
end if
end sub

sub AlmPriority_OnUpdate(oSource,oRect)
On Error resume next
if oRect.style.pixelheight>0 then 
  select case oSource.value
    case 2 
			oRect.Fillcolor=AlarmStateIconFactory.lowcolor
			oRect.style.visibility="visible"
    case 3 
			oRect.Fillcolor=AlarmStateIconFactory.highcolor
			oRect.style.visibility="visible"
    case 4 
			oRect.Fillcolor=AlarmStateIconFactory.urgentcolor
			oRect.style.visibility="visible"
    case else
		    	oRect.style.pixelheight=0
		        oRect.Fillcolor=transparent
    end select
else
    oRect.style.visibility="hidden"
end if

end sub]]></script></scripts><parameters><parameter name="tagname" type="Point" description="" defaultvalue="{%currentpoint%}"/><parameter name="DACFBName" type="Text" description="" defaultvalue="daca"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ConAlpLLAlmTP class=hsc.alpha.1 style="FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-TOP: transparent 2px; HEIGHT: 8.33%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 2px; WIDTH: 75%; BORDER-BOTTOM: transparent 2px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #ff0000; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 2px; PADDING-LEFT: 2px; LEFT: 0%; BORDER-LEFT: transparent 2px; TOP: 44.44%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:none;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;" printDisplayValue="9999.99" globalscripts>9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
call AlmTP_OnUpdate(me, ConAlpLLAlmPR, RecLL)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Text::DACFBName%}.pvllalm.tp"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ConAlpLoAlmTP class=hsc.alpha.1 style="FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-TOP: transparent 2px; HEIGHT: 8.33%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 2px; WIDTH: 75%; BORDER-BOTTOM: transparent 2px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #ff0000; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 2px; PADDING-LEFT: 2px; LEFT: 0%; BORDER-LEFT: transparent 2px; TOP: 50%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:none;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;num