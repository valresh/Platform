<?xml version="1.0"?><shapefile version="1" type="sequence" title="" description="" useFirstShapeForBadValue="0" width="63px" height="19px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[cmbCom.AddString "---"
'cmbCom.AddString "Start"
'cmbCom.AddString "Stop"
'cmbCom.AddString "ESD"
cmbcom.AddString "Reset SC"
cmbcom.AddString "Reset ESD"
cmbCom.value =  "---"]]></script></scripts><parameters><parameter name="Tag" type="Point" description="" defaultvalue="{%CurrentPoint%}"/></parameters><shapes><shape><element><html><content><![CDATA[<SPAN tabIndex=0 id=cmbCom class="hsc.combo.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 19px; FONT-FAMILY: Arial; WIDTH: 63px; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 11px; TOP: 20px; BEHAVIOR: url(#HSCComboboxBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: white; TEXT-INDENT: 2px" hdxproperties="borderStyle:inset;fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:False;lineColorBlink:False;textColor:#000000;textColorBlink:False;">Combobox</SPAN>]]></content><scripts><script event="onchange" language="VBScript"><![CDATA[select case cmbCom.value
	case "Start" me.DataValue("Tag.cStart.PVFL") = "ON"
	case "Stop" me.DataValue("Tag.cStop.PVFL") = "ON"
	case "ESD" 	me.DataValue("Tag.cESD.PVFL") = "ON"
	case "Reset SC" me.DataValue("Tag.cResetSC.PV") = "ON"
	case "Reset ESD" me.DataValue("Tag.cResetESD.PV") = "ON"
end select]]></script><script event="ondatachange" language="VBScript"><![CDATA[cmbCom.value =  "---"]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tag%},{%Point::Tag%},{%Point::Tag%},{%Point::Tag%},{%Point::Tag%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="cESD.PVFL,cStart.PVFL,cStop.PVFL,cResetSC.PV,cResetESD.PV,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,1,1,1,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element></shape></shapes></shapefile>