<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="540px" height="22px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="\\HCUSRV1A\abstract\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="tagname" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="cp_pv" type="Parameter" description="" defaultvalue="PV"/><parameter name="EULO" type="Parameter" description="" defaultvalue="EULO"/><parameter name="EUHI" type="Parameter" description="" defaultvalue="EUHI"/><parameter name="FaceplateFile" type="Text" description="Custom Faceplate File" defaultvalue=""/><parameter name="ContextMenuFile" type="Text" description="Context Menu Filename" defaultvalue="sp_sysdtlKIN_sm.xml"/><parameter name="CustAssocDspl" type="Text" description="Custom Associated Display" defaultvalue=""/><parameter name="Trd_PointPV" type="Parameter" description="Trace to be added to trend group" defaultvalue="Tagname.cp_pv"/><parameter name="pvformat" type="Text" description="Numeric Display Format - a number between 0-6" defaultvalue="2"/><parameter name="TaglimitName" type="Point" description="Name display" defaultvalue="20SH1001CM1"/><parameter name="PriAlarm" type="Parameter" description="" defaultvalue="NUM.PV[1]"/><parameter name="LimitLO" type="Parameter" description="" defaultvalue="NUM.PV[2]"/><parameter name="LimitHI" type="Parameter" description="" defaultvalue="NUM.PV[3]"/><parameter name="Delta" type="Parameter" description="" defaultvalue="NUM.PV[4]"/><parameter name="cp_almenbstate" type="Parameter" description="Alarm Enable State" defaultvalue="alarmdisabled"/></parameters><shapes><shape><group><element><html><content><![CDATA[
