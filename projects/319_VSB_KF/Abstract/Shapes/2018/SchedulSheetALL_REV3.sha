<DIV tabIndex=-1 id=ConAlarmState title="Bad Quality, Urgent, Active, Acknowledged" class=hsc.alarmstate.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 4.07%; WHITE-SPACE: nowrap; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 34.44%; TOP: 0%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior)" hdxproperties="acknowledged:true;HDXBINDINGID:-4;priority:3;quality:0;rtn:false;showDisableIcon:True;showTooltip:True;staticIcon:false;" ObjectType="6"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="6"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_almenbstate%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlarmState" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=TxtName002 class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; HEIGHT: 72.72%; FONT-FAMILY: Arial; WIDTH: 22.4%; POSITION: absolute; COLOR: #000000; TEXT-ALIGN: right; LEFT: 0%; TOP: 13.63%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: visible" hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#000000;textColorBlink:False;TotalRotation:-1;value:;Width:121;">{%Point::TagName%} </DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=RecFrame008 class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 20.74%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 79.25%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;FillStyle:0;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:112;" globalscripts></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=RecFrame009 class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 20.74%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 58.14%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;FillStyle:0;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:112;" globalscripts></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=LimitLO class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 20.74%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 58.14%; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HoverBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:black;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TaglimitName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::LimitLO%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=LimitHI class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 20.74%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 79.25%; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)   url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TaglimitName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::LimitHI%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=RecFrame010 class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 6.29%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 24.44%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;FillStyle:0;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:34;" globalscripts></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=PriAlarm class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 6.29%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; PADDING-BOTTOM: 1px; FONT-STYLE: normal; TEXT-ALIGN: right; PADDING-TOP: 1px; BORDER-RIGHT-STYLE: none; PADDING-LEFT: 1px; LEFT: 24.44%; TOP: 4.54%; PADDING-RIGHT: 1px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HoverBehavior)     url(#HSCScriptDataBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:None;borderWidth:1px;durationFormat:-1;fillColor:transparent;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:black;numberOfChars:9;numericDisplayFormat:%.1f;textColor:#000000;">9999.99</TEXTAREA>]]></content><scripts><script event="onchange" language="VBScript"><![CDATA[dim EULO, EUHI, Del
on error resume next

	EULO = me.DataValue("TagName.EULO")
	EUHI = me.DataValue("TagName.EUHI")
	Del = PriAlarm.value
    Delta.value = Del/100*(EUHI - EULO)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TaglimitName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::PriAlarm%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::EULO%},{%Parameter::EUHI%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ScConAlpPV class="hsc.alpha.1  HSC.ScriptDataObject.1 hsc.faceplate.1 ScConAlpPV" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 16.48%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; COLOR: #000000; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 41.29%; BORDER-RIGHT-COLOR: transparent; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior) url(#HDXPopupBehavior#Faceplate); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderWidth:;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:#000000;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;styleClass:ScConAlpPV;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim sFormat, oShape, nNumericFormat, dLimitHI, dLimitLO
on error resume next
dLimitHI = LimitHI.value - Delta.value
dLimitLO = LimitLO.value + Delta.value
If (me.value > LimitHI.value and LimitHI.value <> "NaN") or (me.value < LimitLO.value and LimitLO.value <> "NaN") or me.value = "NaN" Then
   me.fillcolor = vbred
     If me.value > LimitHI.value and LimitHI.value <> "NaN" Then
        LimitHI.fillColor = vbred
	 else LimitHI.fillColor = &hDDDDDD
	 end if
	 If me.value < LimitLO.value and LimitLO.value <> "NaN" Then
        LimitLO.fillColor = vbred
	 else LimitLO.fillColor = &hDDDDDD
	 end if
else    
    If (me.value > dLimitHI and LimitHI.value <> "NaN") or (me.value < dLimitLO and LimitLO.value <> "NaN") and me.value <> "NaN" Then
       me.fillcolor = vbYellow
         If me.value > dLimitHI and LimitHI.value <> "NaN" Then
            LimitHI.fillColor = vbYellow
	     else LimitHI.fillColor = &hDDDDDD
	     end if
	     If me.value < dLimitLO and LimitLO.value <> "NaN" Then
            LimitLO.fillColor = vbYellow
	     else LimitLO.fillColor = &hDDDDDD
	     end if
    else me.fillcolor= &hDDDDDD
         LimitHI.fillColor = &hDDDDDD
         LimitLO.fillColor = &hDDDDDD
    end if

end if
set oShape = me.parentnode.parentnode
    nNumericFormat = oShape.getcustomproperty("text","pvformat")
    sFormat="%." & nNumericFormat & "f"
  	oShape.objects("ScConAlpPV").numericdisplayformat=sFormat
	oShape.objects("LimitHI").numericdisplayformat=sFormat
	oShape.objects("LimitLO").numericdisplayformat=sFormat]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_pv%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value=""/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=""/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ScTxtSelectBox class="hvg.base.1 " style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 16.48%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 41.29%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:;Width:89;" globalscripts></DIV>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[call All_OnClick(me)]]></script><script event="oncontextmenu" language="VBScript"><![CDATA[call All_OnCMenu(me)]]></script></scripts></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=AssocDsplButton class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 4.44%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 38.14%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#polygon)  url(#BindingBehavior)" hdxproperties="FillColor:#c0c0c0;fillColorBlink:False;HDXBINDINGID:-4;Height:20;indicateScanState:False;LineColor:#808080;lineColorBlink:False;points:0.000000 0.000000 0.000000 100.000000 83.333336 100.000000 100.000000 50.000000 83.333336 0.000000 0.000000 0.000000 ;Width:24;"></DIV>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=AssocDisplay class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 3.7%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #c0c0c0; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 38.14%; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;HDXBINDINGID:-4;lineColor:transparent;numberOfChars:9;numericDisplayFormat:%s;textColor:#c0c0c0;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[dim oTemp, oSheip, oConst
on error resume next
oTemp = me.Value
Set oSheip = me.parentnode.parentnode
oConst = oSheip.getcustomproperty("Text","CustAssocDspl")
If oConst <> "" then 
	window.external.currentpage=oConst
		else
	window.external.currentpage=oTemp
