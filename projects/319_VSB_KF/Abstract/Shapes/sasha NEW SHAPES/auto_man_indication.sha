<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="80px" height="40px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><parameters><parameter name="tagname" type="Point" description="" defaultvalue=""/><parameter name="paramAV" type="Parameter" description="" defaultvalue="anda.out"/></parameters><shapes><shape><group><element><html><content><![CDATA[
