<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="160px" height="26px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="\\HCUSRV1A\abstract\NAVs\CSS\sp.css"/></stylesheets><parameters><parameter name="Tagname" type="Point" description="Alarm group or asset name" defaultvalue=""/><parameter name="DspDesc" type="Text" description="Custom Display description" defaultvalue=""/><parameter name="DspName" type="Text" description="CallUp Display filename" defaultvalue=""/><parameter name="Revision" type="Num" description="Revision" defaultvalue="R410 Rev.2"/></parameters><shapes><shape><group><element><html><content><![CDATA[<A tabIndex=-1 id=DspNum class=hsc.hyperlink.1 style="FONT-SIZE: 6pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 61.53%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; TOP: 0%; VISIBILITY: hidden">{%Text::DspName%} </A>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ScPlgAlarm class="hvg.base.1 HSC.ScriptDataObject.1 NavFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 61.53%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; LEFT: 0%; TOP: 38.46%; BEHAVIOR: url(#HDXVectorFactory#rect) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:#C0C0C0;fillColorBlink:False;HDXBINDINGID:-4;Height:16;LineColor:#969696;lineColorBlink:False;styleClass:NavFrame;textColor:#808080;textColorBlink:False;Width:160;"></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[Call NavsArrow_HP_AlpAlarm_OnDataChange(me)

dim oShape, dData, dDesc
set oShape = me.parentElement.parentElement
	dData = me.DataValue("tagname.description")
	dDesc = oShape.getcustomproperty("text","DspDesc")
	if dDesc = "" then oShape.setcustomproperty "text" , "DspDesc", dData]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tagname%},{%Point::Tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="name,description,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="1,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<A tabIndex=-1 id=HprlnkDsp class=hsc.hyperlink.1 style="FONT-SIZE: 10pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 61.53%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; TOP: 38.46%" href="page://{%Text::DspName%}/">{%Text::DspDesc%} </A>]]></content></html></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 26px; WIDTH: 160px; POSITION: absolute; LEFT: 11px; TOP: 13px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:26;lineColorBlink:False;Width:160;"></DIV>]]></content></html></group></shape></shapes></shapefile>