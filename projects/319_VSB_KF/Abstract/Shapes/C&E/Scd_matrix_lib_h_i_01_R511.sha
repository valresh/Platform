<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="1492px" height="906px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="C:\ProgramData\Honeywell\Experion PKS\Client\Abstract\Displays\CSS\sp.css"/></stylesheets><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[dim oShape, sNCTShow
	on error resume next
	page.setattribute "ESD_matrix", me.id
	call matrix_size
	sNCTShow=window.external.dictionary.item("NameCText").value
	if err.number<>0 then 
		window.external.dictionary.add "NameCText","НОМЕР ПОЗИЦИИ"
		sNCTShow="НОМЕР ПОЗИЦИИ"
	end if
	for each oShape in Page.children.tags("DIV")  
 		if typename(oShape.objects("TxtPName"))<>"Nothing" then
    	call NCT_Page_OnShapeLoad(oShape,sNCTShow)
 	end if 
	next]]></script><script event="" language="VBScript" id="871006B6-C4C1-4F72-BAC0-2D72F6FF9152"><![CDATA[dim HSel_width, HSel_Top
dim VSel_height, VSel_Left
dim iSHeight,iSLeft,iSTop,iSWidth
	iSHeight=0 
	iSleft=0
	iSTop=0
	iSWidth=0

sub Matrix_RCSelect_OnClick
	dim oShape
	on error resume next  
	set oShape=document.getelementbyid(page.getattribute("ESD_matrix"))
	set oObjH=oShape.objects("rectHSel")
	set oObjV=oShape.objects("rectVSel")
    iX=window.event.offsetX
	iY=window.event.offsetY	
	if iSHeight=0 then iSHeight=oObjV.style.pixeltop+oObjV.style.pixelheight-4
	iOffsetY=oObjV.style.pixeltop+oObjV.style.pixelheight 
	Y=iY+iOffsetY
	mF=(iY)\24
	if mF>=0 and Y>iOffsetY then mF=mF+1
    oObjV.style.pixelheight=iSHeight+mF*24		
	if iSleft=0 then iSLeft=oObjV.style.pixelLeft
	iOffsetX=oObjV.style.pixelLeft+oObjV.style.pixelwidth 
	X=iX+iOffsetX
	mF=(iX)\24
	if mF<0 and X<iOffsetX then mF=mF-1
    oObjV.style.pixelLeft=iSLeft+mF*24    
	if iSWidth=0 then iSWidth=oObjH.style.pixelLeft+oObjH.style.pixelwidth-4
	iOffsetX=oObjH.style.pixelLeft+oObjH.style.pixelwidth 
	X=iX+iOffsetX
	mF=(iX)\24
	if mF>=0 and X>iOffsetX then mF=mF+1
    oObjH.style.pixelwidth=iSWidth+mF*24
	if iSTop=0 then iSTop=oObjH.style.pixelTop
	iOffsetY=oObjH.style.pixelTop+oObjH.style.pixelheight 
	Y=iY+iOffsetY
	mF=(iY)\24
	if mF<0 and Y<iOffsetY then mF=mF-1
    oObjH.style.pixelTop=iSTop+mF*24
	oObjH.style.visibility="visible"
	oObjV.style.visibility="visible"
	if err.number<>0 then window.external.LogMessage "Matrix_RCSelect_OnClick ->" & oSource.id & " " & err.description 
end sub

sub matrix_size
	dim oShape
	on error resume next
	set oShape=document.getelementbyid(page.getattribute("ESD_matrix"))
	sizeH=oShape.getcustomproperty("Num","cp_rows")
	if SizeH="" then sizeH=20
	sizeV=oShape.getcustomproperty("Num","cp_cols")
	if SizeV="" then sizeV=20
	for i=1 to 20
		if i<10 then suff="0" & i:else:suff=i:end if
		if i<=cint(sizeH) then oShape.objects("RectH" & suff).style.visibility="visible":else:oShape.objects("RectH" & suff).style.visibility="hidden":end if
		if i<=cint(sizeV) then oShape.objects("RectV" & suff).style.visibility="visible":else:oShape.objects("RectV" & suff).style.visibility="hidden":end if
	next
	oShape.objects("GroupV").style.pixelheight=oShape.objects("GroupV").style.pixelheight-(20-sizeH)*24
	oShape.objects("GroupH").style.pixelwidth=oShape.objects("GroupH").style.pixelwidth-(20-sizeV)*24
	oShape.objects("PlDark").style.pixelheight=oShape.objects("PlDark").style.pixelheight-(20-sizeH)*24
	oShape.objects("PlLight").style.pixelheight=oShape.objects("PlLight").style.pixelheight-(20-sizeH)*24
	oShape.objects("PlDark").style.pixelwidth=oShape.objects("PlDark").style.pixelwidth-(20-sizeV)*24
	oShape.objects("PlLight").style.pixelwidth=oShape.objects("PlLight").style.pixelwidth-(20-sizeV)*24
	oShape.objects("RectBckg").style.pixelheight=oShape.objects("RectBckg").style.pixelheight-(20-sizeH)*24
	oShape.objects("RectBckg").style.pixelwidth=oShape.objects("RectBckg").style.pixelwidth-(20-sizeV)*24
	oShape.objects("RecTarg").style.pixelheight=oShape.objects("RecTarg").style.pixelheight-(20-sizeH)*24
	oShape.objects("RecTarg").style.pixelwidth=oShape.objects("RecTarg").style.pixelwidth-(20-sizeV)*24
	if err.number<>0 then window.external.LogMessage "Matrix_size ->" & oShape.id & " " & err.description 
end sub

sub NCT_Page_OnShapeLoad(oSource, sNCTShow)
	on error resume next
	set txtPName = oSource.objects("TxtPName")
	set txtCText = oSource.objects("TxtCText")
	set txtAVal = oSource.objects("TxtAnValue")
	if instr(ucase(oSource.src),"SCD_CECAUSE_LIB_H_PAI_0")=0 then
		if sNCTShow="НОМЕР ПОЗИЦИИ" then
	  		txtPName.style.visibility="visible"
	  		txtCText.style.visibility="hidden"  		
		elseif sNCTShow="ОПИСАНИЕ" then
	  		txtPName.style.visibility="hidden"
	 		txtCText.style.visibility="visible"  		
		end if
	end if
end sub

sub set_choice(oSource)
	dim oShape
	on error resume next
	sNCTShow=oSource.value
	sErr=window.external.dictionary.item("NameCText").value
	if err.number=0 then  
 		window.external.dictionary.item("NameCText").value=sNCTShow
	else
 		window.external.dictionary.add "NameCText",sNCTShow
	end if
	for each oShape in Page.children.tags("DIV")  
 		if typename(oShape.objects("TxtPName"))<>"Nothing" then call NCT_Page_OnShapeLoad(oShape, sNCTShow)                                           
	next
end sub

sub Assoc_Dsp
	dim oShape
	on error resume next
	set oShape=document.getelementbyID(page.getattribute("lastselection")).parentnode.parentnode
	oshape.objects("ScConAlpPV").focus
  	window.external.invokemenu2("Associated Display") ' updated from 13.05.2021. Error "No assocoated display". Changed "associated display" to "Associated Display" due after migration to R511 the old value mo more working
	call SetN
end sub

sub SetN
	set oShape=document.getelementbyID(page.getattribute("lastselection")).parentnode.parentnode
	set oShape.objects("ScTxtSelectBox").onfocus=nothing
end sub

sub Effect_OnClick(oSource) 
	dim oShape,soldsel
  	on error resume next
	set oShape=oSource.parentnode.parentnode
	call SelectBox_Color(oSource)
    set otarget=oshape.objects("ScConAlpPV")
    if not isobject(oSource.onfocus) then set oSource.onfocus=getref("Assoc_Dsp") ' update from 19.07.2012
    oSource.focus ' update from 19.07.2012
	call Assoc_Dsp ' update from 19.07.2012
end sub]]></script></scripts><parameters><parameter name="cp_rows" type="Num" description="max 20" defaultvalue=""/><parameter name="cp_cols" type="num" description="max 20" defaultvalue=""/><parameter name="cp_FT" type="text" description="" defaultvalue="Отключ. блок. при обслуж."/><parameter name="cp_MO" type="text" description="" defaultvalue="Неисправный датчик"/><parameter name="cp_SO" type="text" description="" defaultvalue="Отключ. блок. при пуске"/><parameter name="cp_FF" type="text" description="" defaultvalue="Первопричина блокировки"/><parameter name="cp_Ovr_E" type="text" description="" defaultvalue="Сброс на месте"/><parameter name="cp_Rst_E" type="text" description="" defaultvalue="Готов к сбросу"/><parameter name="cp_Diag_E" type="text" description="" defaultvalue="Диагностика"/><parameter name="Revision" type="Num" description="Revision" defaultvalue="R300 rev.1"/></parameters><shapes><shape><group><element><html><content><![CDATA[
