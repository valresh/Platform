"HSC.Indicator" refcount="1"/></binding></element><group><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ConShpAlm_ConAlpLLAlmTP class=hsc.alpha.1 style="FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-TOP: transparent 2px; HEIGHT: 8.33%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 2px; WIDTH: 60%; BORDER-BOTTOM: transparent 2px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #ff0000; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 2px; PADDING-LEFT: 2px; LEFT: 0%; BORDER-LEFT: transparent 2px; TOP: 44.44%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:none;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;" printDisplayValue="9999.99" globalscripts>9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
call AlmTP_OnUpdate(me, ConShpAlm_ConAlpLLAlmPR, ConShpAlm_RecLL)
call AlmTP_OnUpdate(ConShpAlm_ConAlpLoAlmTP, ConShpAlm_ConAlpLoAlmPR, ConShpAlm_RecL)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::CurrentPoint%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="daca.pvllalm.tp"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ConShpAlm_ConAlpLoAlmTP class=hsc.alpha.1 style="FONT-SIZE: 8pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-TOP: transparent 2px; HEIGHT: 8.33%; FONT-FAMILY: Arial; BORDER-RIGHT: transparent 2px; WIDTH: 60%; BORDER-BOTTOM: transparent 2px; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #ff0000; PADDING-BOTTOM: 2px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 2px; PADDING-LEFT: 2px; LEFT: 0%; BORDER-LEFT: transparent 2px; TOP: 50%; PADDING-RIGHT: 2px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:none;borderWidth:2px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:#ffffff;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#ff0000;textColorBlink:False;" printDisplayValue="9999.99" globalscripts>9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
