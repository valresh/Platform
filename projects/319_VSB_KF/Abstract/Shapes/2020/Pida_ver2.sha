<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="204px" height="460px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><scripts><script event="" language="VBScript" id="2ABB0A5E-30E7-4F98-9818-C30C1F230627"><![CDATA[sub PVSourceUpdate

on error resume next
	If rect002.DataValue("CurrentPoint.DACA.PVSOURCE")="MAN" then
		alphaDacaPV.style.visibility="visible" : AlphaPidaPV.style.visibility="hidden"
	else
		alphaDacaPV.style.visibility="hidden" : AlphaPidaPV.style.visibility="visible"
	End if
end sub


sub PVFormatUpdate
dim sFormat, PVFormat
PVFormat = rect002.DataValue("CurrentPoint.daca.pvformat")
on error resume next

if (NOT rect002.IsNaN("CurrentPoint.daca.pvformat")) AND (trim(PVFormat)<> vbNullstring) then

	sFormat="%." & PVFormat & "f" : AlphaPidaPV.numericdisplayformat=sFormat : AlphaSP.numericdisplayformat=sFormat
	PVEUHi.numericdisplayformat=sFormat : PVEULo.numericdisplayformat=sFormat : AlphaDacaPV.numericdisplayformat=sFormat
	AlphaLGPV.numericdisplayformat=sFormat
	'call ApplyPVFormat
End If
end sub




sub RecToolTip()


pvllalm = rect002.DataValue("CurrentPoint.daca.pvllalm.tp")
pvloalm = rect002.DataValue("CurrentPoint.daca.pvloalm.tp")
pvhialm = rect002.DataValue("CurrentPoint.daca.pvhialm.tp")
pvhhalm = rect002.DataValue("CurrentPoint.daca.pvhhalm.tp")
pvllalmp = rect002.DataValue("CurrentPoint.daca.pvllalm.pr")
pvloalmp = rect002.DataValue("CurrentPoint.daca.pvloalm.pr")
pvhialmp = rect002.DataValue("CurrentPoint.daca.pvhialm.pr")
pvhhalmp = rect002.DataValue("CurrentPoint.daca.pvhhalm.pr")



 if pvhhalmp = 0 then 
    strHH = ""
 elseif pvhhalm = "1.#QNAN" or pvhhalm = "NaN"then 
    strHH = ""
  else 
  
  strHH = FormatNumber(pvhhalm,rect002.DataValue("CurrentPoint.daca.pvformat"))
  
  strHH = "High High:   "  & strHH & VBCR 
  
 end if

 if pvhialmp = 0 then 
    strHi = ""
 elseif pvhialm = "1.#QNAN" or pvhialm = "NaN" then
    strHi = ""
	
  else 
  
  strHi = FormatNumber(pvhialm,rect002.DataValue("CurrentPoint.daca.pvformat"))
  strHi = "High:           " &  strHi & VBCR 
  
 end if

 
 if pvllalmp = 0 then 
    strLL = ""
 elseif pvllalm = "1.#QNAN" or pvloalm = "NaN" then
    strLL = ""
  else 
  strLL = FormatNumber(pvllalm,rect002.DataValue("CurrentPoint.daca.pvformat"))
  strLL = "Low Low:     " & strLL  
 end if

 if pvloalmp = 0 then 
    strLo = ""
 elseif pvloalm = "1.#QNAN" or pvloalm = "NaN" then
    strLo = ""
  else   
  strLo = FormatNumber(pvloalm,rect002.DataValue("CurrentPoint.daca.pvformat"))
  strLo = "Low:            " & strLo & VBCR
 end if 

 If StrHH = "" and StrHi = "" and StrLL = "" and Strlo = "" then
 RecTT.title ="" 
  else
  RecTT.title = "PV Alarm Limits:    " & vbcr & strHH  & strHi &  strLo  & strLL
 end if


 end sub]]></script><script event="" language="VBScript" id="640F5715-3967-48EB-9990-6BF7327D1DA5"><![CDATA[sub AlmTP_OnUpdate(oSource, oSource1, oRect)
dim iTop, iHeight, oShape, sToolTipTxt, sEUDesc ,Hilimit
on error resume next
if isnumeric(oSource.currentvalue)and oSource1.value>0 then 
 set oShape=oSource.parentnode.parentnode
 itop=oSource.parentnode.style.pixeltop
 iheight=oSource.parentnode.style.pixelheight
 iheight=oSource.parentnode.style.pixelheight
 pvRange = (oShape.objects("ConAlpPVEUHi").value-oShape.objects("ConAlpPVEULo").value)
 pvRangelo =   oShape.objects("ConAlpPVEULo").value
 iVal = oSource.value

 if oShape.objects("ConAlpHHAlmTP").value = "NaN" or oShape.objects("ConAlpHiAlmTP").value = "NaN"then
    HiFlag = 0
 elseif (oShape.objects("ConAlpHHAlmTP").value-oShape.objects("ConAlpHiAlmTP").value) = 0 then  
    HiFlag = 0
 else 
    HiFlag = 1
 end if

 if (oShape.objects("ConAlpLoAlmTP").value = "NaN" or oShape.objects("ConAlpLLAlmTP").value) = "NaN" then
    LoFlag = 0
 elseif (oShape.objects("ConAlpLoAlmTP").value-oShape.objects("ConAlpLLAlmTP").value) = 0 then  
    LoFlag = 0
 else 
    LoFlag = 1
 end if

 
 'If (oShape.objects("ConAlpHHAlmTP").value-oShape.objects("ConAlpHiAlmTP").value) = 0 then
 '    HiFlag = 0
 'else
 '    HiFlag = 1
 'end if
 
 'If (oShape.objects("ConAlpLoAlmTP").value-oShape.objects("ConAlpLLAlmTP").value) = 0 then
 '    LoFlag = 0
 'else
 '    LoFlag = 1
 'end if
Select Case Right(oRect.id, 1)

            Case "H"
                If pvRange * iHeight <> 0 Then
                    oRect.Style.pixelHeight = (iHeight ) - (iVal - pvRangeLo) / pvRange * iHeight
                Else
                    oRect.Style.pixelHeight = iHeight
                End If
                oRect.Style.pixelTop = iTop
                
                If Right(oRect.id, 2) = "HH" Then
                    If oRect.Style.pixelHeight < 1 Then oRect.Style.pixelHeight = 1
					
				 Else
					 
					If (oRect.Style.pixelHeight <= 1) Then oRect.Style.pixelHeight = 1  + HiFlag
					 
				 End If 
				
			

            Case "L"
                If pvRange * iHeight <> 0 Then
                    oRect.Style.pixelHeight = (iVal - pvRangeLo) / pvRange * iHeight
                Else
                    oRect.Style.pixelHeight = 0
                End If
                
                If Right(oRect.id, 2) = "LL" Then
                    If oRect.Style.pixelHeight < 1 Then oRect.Style.pixelHeight = 1     'min LoLo pixel height is 3, for tooltip access
                Else
				    'If oRect.Style.pixelHeight <= 1 Then oRect.Style.pixelHeight = 2
                    If ( oRect.Style.pixelHeight <= 1) Then oRect.Style.pixelHeight = 1  + LoFlag   'min Lo pixel height is 4, so not *arbitrarily* occluded by above
                End If

                oRect.Style.pixelTop = iTop + iHeight - oRect.Style.pixelHeight

  End Select
  call AlmPriority_OnUpdate(oSource1,oRect)
 
else
 oRect.style.visibility="hidden"
end if

end sub

sub AlmPriority_OnUpdate(oSource,oRect)
On Error resume next
if oRect.style.pixelheight>0 then 
  select case oSource.value
    case 1 
			oRect.Fillcolor="#969696"
			oRect.style.visibility="visible"
	case 2 
			oRect.Fillcolor=AlarmStateIconFactory.lowcolor
			oRect.style.visibility="visible"
    case 3 
			oRect.Fillcolor=AlarmStateIconFactory.highcolor
			oRect.style.visibility="visible"
    case 4 
			oRect.Fillcolor=AlarmStateIconFactory.urgentcolor
			oRect.style.visibility="visible"
    case else
		    	oRect.style.pixelheight=0
		        oRect.Fillcolor=transparent
    end select
else
    oRect.style.visibility="hidden"
end if

end sub]]></script></scripts><parameters><parameter name="CurrentPoint" type="Point" description="" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=All class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 99.56%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0.21%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#ded8cf;fillColorBlink:False;Height:458;LineColor:#000000;lineColorBlink:False;LineStyle:2;Width:204;"></DIV>]]></content></html></element><group><element><html><content><![CDATA[<INPUT tabIndex=0 id=PbAlmAck class=hsc.button.1 style="FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 52.5%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 10.89%; BACKGROUND-IMAGE: url(file:./Pida_ver2_files/ackbell.bmp); BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; LEFT: 85.14%; BORDER-RIGHT-COLOR: #ffffff; TOP: 5%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: transparent" type=button hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" shapesrc=".\Pida_ver2_files\ackbell.bmp">]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="3"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="24"/><property name="TaskParam2" varianttype="VT_BSTR" value="1"/><property name="TaskParam3" varianttype="VT_BSTR" 