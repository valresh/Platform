<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="340px" height="70px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="\\DCSSTN001-2\abstract\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="TagName" type="Point" description="" defaultvalue=""/><parameter name="cp_pv" type="Parameter" description="" defaultvalue="FIRSTOUTA.FIRSTOUTINPUT"/><parameter name="cp_almenbstate" type="Parameter" description="Alarm Enable State" defaultvalue="almenbstate"/><parameter name="cp_execstate" type="Parameter" description="Point Execution State" defaultvalue="execstate"/><parameter name="ContextMenuFile" type="Text" description="Context Menu Filename" defaultvalue="sp_sysdtlKIN_sm.xml"/><parameter name="FaceplateFile" type="Text" description="Custom Faceplate File" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ScConAlpPV class="hsc.alpha.1 hsc.faceplate.1 HSC.ScriptDataObject.1 ScConAlpPV" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 7.14%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 1.47%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; COLOR: #000000; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 0%; BORDER-RIGHT-COLOR: transparent; TOP: 32.85%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HDXPopupBehavior#Faceplate) url(#HSCScriptDataBehavior); VISIBILITY: visible; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderWidth:;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:Color_OtherState;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;styleClass:ScConAlpPV;textColor:#000000;textColorBlink:False;" printDisplayValue="9999.99" globalscripts>State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim state
'on error resume next


If me.value <> "NONE" Then
state = Mid(ucase(me.Value), 7, 2)
ScTxtSelectBox.value = me.DataValue("TagName.FIRSTOUTA.INDESC" & state)
ScTxtSelectBox.textColor = vbred
    If ConAlarmState.Acknowledged = False Then
	  	ScTxtSelectBox.textColorBlink = True
		Else
		ScTxtSelectBox.textColorBlink = False
	End If
Else 
ScTxtSelectBox.value = ""
ScTxtSelectBox.textColorBlink = False
ScTxtSelectBox.textColor = vbblack
End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_pv%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="FIRSTOUTA.INDESC1,FIRSTOUTA.INDESC2,FIRSTOUTA.INDESC3,FIRSTOUTA.INDESC4,FIRSTOUTA.INDESC5,FIRSTOUTA.INDESC6,FIRSTOUTA.INDESC7,FIRSTOUTA.INDESC8,FIR