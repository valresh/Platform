<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="40px" height="17px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><parameters><parameter name="TagName" type="Point" description="" defaultvalue=""/><parameter name="OP" type="Parameter" description="" defaultvalue="PIDA.OP"/><parameter name="Delta1" type="Parameter" description="" defaultvalue="AUXCALCPOS.C[2]"/><parameter name="Delta2" type="Parameter" description="" defaultvalue="AUXCALCPOS.C[3]"/><parameter name="TagNameVal" type="Point" description="" defaultvalue=""/><parameter name="HartParam" type="Parameter" description="" defaultvalue="HDYNVAL[2]"/></parameters><shapes><shape><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alpha001 class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 10pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 17px; FONT-FAMILY: Arial; WIDTH: 40px; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; PADDING-BOTTOM: 1px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 1px; BORDER-RIGHT-STYLE: none; PADDING-LEFT: 1px; LEFT: 58px; TOP: 33px; PADDING-RIGHT: 1px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:Solid;borderWidth:1px;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.1f;textColor:#000000;textColorBlink:False;" POPUPDISPLAYFILE="\\hcusrv1a\abstract\Faceplates\sysPUPHartValve.htm" POPUPLEFT="200" POPUPTOP="200" POSITIONING="0">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[If me.DataValue("TagName.FLAGPOS.PVFL") = 1 OR me.DataValue("TagName.FLAGOP.PVFL") = 1 Then
	me.lineColor = vbBlue
	me.fillColor = "#00FFFF"
Else
	me.lineColor = vbBlack
	me.fillColor = "#C0C0C0"
End If]]></script><script event="oncontextmenu" language="VBScript"><![CDATA[dim oSheip, oTag, oVal, oOp, oDelta1, oDelta2
on error resume next
Set oSheip = me.parentnode
oTag = oSheip.getcustomproperty("Point","TagName")
oOP = oSheip.getcustomproperty("Parameter","OP")
oVal = oSheip.getcustomproperty("Point","TagNameVal")
oDelta1 = oSheip.getcustomproperty("Parameter","Delta1")
oDelta2 = oSheip.getcustomproperty("Parameter","Delta2")
HDXPopupBehavior.CreatePopupWindow "sysPUPHartValve21.htm?TagName=" & oTag & "&TagNameVal=" & oVal & "&OP=" & oOP & "&Delta1=" & oDelta1 & "&Delta2=" & oDelta2, 0, 0, 0]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TagNameVal%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::HartParam%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::TagName%},{%Point::TagName%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="FLAGPOS.PVFL,FLAGOP.PVFL,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element></shape></shapes></shapefile>