<DIV tabIndex=-1 id=BCRed class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 13.15%; FONT-FAMILY: Arial; WIDTH: 13.88%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 86.11%; TOP: 55.26%; BEHAVIOR: url(#HDXVectorFactory#oval) url(#BindingBehavior) url(#hscbreakpointbehavior)" hdxproperties="BreakpointType:1;DiscreteColors:16777215_255_65280_42495_16777215_16777215_16777215_16777215;DiscreteStates:00000000;fillColorBlink:False;HDXBINDINGID:-4;Height:10;indicateScanState:True;LineColor:#000000;lineColorBlink:False;Width:10;"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="1"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::BC300%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="RDNROLESTATE"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.ColorBreakpoints" refcount="1"/><class ID="HSC.HVG" refcount="1"/><class ID="HSC.Quality" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alpha class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 1.31%; FONT-FAMILY: Arial; WIDTH: 1.38%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; PADDING-BOTTOM: 3px; FONT-STYLE: normal; TEXT-ALIGN: center; PADDING-TOP: 3px; BORDER-RIGHT-STYLE: none; PADDING-LEFT: 3px; LEFT: 98.61%; TOP: 97.36%; PADDING-RIGHT: 3px; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderStyle:Solid;borderWidth:3px;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[Dim oShape, C300Name, C300Prime, C300Sec, CID
on error resume next
Set oShape = me.parentnode.parentnode
C300Name = oShape.getcustomproperty("Point","PrimaryC300")  		'К имени контроллера добавляем символу "P" и "S"
C300Prime = C300Name
C300Sec = mid(C300Name, 1, 8) & "S"

Set CID = me.value

if	Right(CID*5, 1) = 5 then									'Сравнение, если индекс Primary контроллера с нечетным номером, 
	oShape.setCustomProperty "Point", "UC300", C300Prime		'tо отображаем его наверху
	oShape.setCustomProperty "Point", "BC300", C300Sec			'если нет то внизу
else
	oShape.setCustomProperty "Point", "UC300", C300Sec	
	oShape.setCustomProperty "Point", "BC300", C300Prime
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::PrimaryC300%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="DEVICEIDX"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group001 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 76px; WIDTH: 72px; POSITION: absolute; LEFT: 10px; TOP: 15px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:76;lineColorBlink:False;Width:72;"></DIV>]]></content></html></group></shape></shapes></shapefile>