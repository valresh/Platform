<DIV tabIndex=-1 id=ViewLogic class="hvg.base.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 1.94%; FONT-FAMILY: Arial; WIDTH: 2.66%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 41.5%; TOP: 3.15%; BEHAVIOR: url(#HDXVectorFactory#rect) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:0;LineColor:#000000;lineColorBlink:False;LineStyle:0;Width:0;"></DIV>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next
if me.datavalue("surge_reg.surgereg1.out") = 1 then
 
t1.style.visibility = "inherit"
lin4.style.visibility = "inherit"
lin3.style.visibility = "inherit"

t2.style.visibility = "hidden"
t3.style.visibility = "hidden"
t4.style.visibility = "hidden"

lin1.style.visibility = "hidden"
lin2.style.visibility = "hidden"

else 

if me.datavalue("surge_reg.surgereg2.out") = 1 then

t2.style.visibility = "inherit"
lin4.style.visibility = "inherit"
lin2.style.visibility = "inherit"

t1.style.visibility = "hidden"
t3.style.visibility = "hidden"
t4.style.visibility = "hidden"

lin1.style.visibility = "hidden"
lin3.style.visibility = "hidden"


else

if me.datavalue("surge_reg.surgereg3.out") = 1 then

t3.style.visibility = "inherit"
lin1.style.visibility = "inherit"
lin2.style.visibility = "inherit"

t1.style.visibility = "hidden"
t2.style.visibility = "hidden"
t4.style.visibility = "hidden"

lin3.style.visibility = "hidden"
lin4.style.visibility = "hidden"


else 

if me.datavalue("surge_reg.surgereg4.out") = 1 then

t4.style.visibility = "inherit"
lin4.style.visibility = "inherit"
lin2.style.visibility = "inherit"

t1.style.visibility = "hidden"
t3.style.visibility = "hidden"
t2.style.visibility = "hidden"

lin1.style.visibility = "hidden"
lin3.style.visibility = "hidden"

end if
end if
end if
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::surge_reg%},{%Point::surge_reg%},{%Point::surge_reg%},{%Point::surge_reg%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="SurgeReg1.out,SurgeReg3.out,SurgeReg4.out,SurgeReg2.out,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
