<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="672px" height="64px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><scripts><script event="" language="VBScript" id="303B75FD-599B-4323-B9BD-DE498428A678"><![CDATA[dim tid_timeout,sAlarmGroupName, bCancel, bTrdResp, Xorig, Yorig
dim oPrntSrc

const  iQualityGood = 192
const  iQualityOffScan = 8
const  iQualityBad = 4
const  iQualityBadComm = 20
const  iQualityAccessNotPermitted = 1024


tid_timeout = 0 	'Used by Com_GraphTitle.sha. Counts the time before resetting to originally configured alarm group.
sAlarmGroupName="" 	'Used by Com_GraphTitle.sha. Stores the alarm group name as configured in the shape.

'Allow only tags of type INPUT and TEXTAREA to be selected.
sub Page_OnSelectStart	
	dim InpName
	on error resume next
	InpName=window.event.SrcElement.TagName
	if InpName <> "INPUT" and InpName<>"TEXTAREA" then window.event.returnvalue = false
end sub


'Show the appropriate tooltip 
sub Page_OnMouseOver	
	dim oObj, iNrPoints,sPointNames(20),sCPNames(20)
	on error resume next
	set oobj=window.event.srcelement
	if isobject (oObj.onmouseover) then exit sub
	if len(oObj.id)<14 then exit sub
	if ucase(right(oObj.id,14))="SCTXTSELECTBOX" then 
		set oShape = oObj.parentnode.parentnode
 		oObj.style.cursor = "hand"
 		if oShape.getcustomproperty("point","tagname")<>"" then 		    
 			for n=0 to oShape.customProperties.Count -1
 			   if lcase(oShape.customProperties.Item(n).type) = "point" and instr(oShape.customProperties.Item(n).name,"Analog")=0 then 
				  iNrPoints = iNrPoints + 1
 				  sPointNames(iNrPoints) =	oshape.customProperties.Item(n).value
 				  sCPNames(iNrPoints) =	oshape.customProperties.Item(n).name
    		   end if
 			next 
			if instr(oShape.src,"MultBPIL")>0 then iNrPoints=1
  			If iNrPoints = 1 Then
  	 			sPoints = sPointNames(1)
				if inStr(sPoints,"{%")>0 then sPoints=oShape.objects("ScConAlpPV").datavalue("Tagname.name")
	  			status = "Analog"
				if instr(oShape.src,"MultBPIL")>0 or (oShape.objects("TxtEUDesc") is nothing) or (not oShape.objects("TxtPV") is nothing) or (not oShape.objects("RecPV") is nothing) then status = "Status"
      			if (not oShape.objects("IndVal") is nothing or not oShape.objects("TxtOP")is nothing) then status = "RegValve"
                if (not oShape.objects("LinScale") is nothing) then status = "Analog"
				if status = "Analog" then
					PvTxt = ToolTip_PV(oShape,status)
					SpTxt = ToolTip_SP(oShape,status)
					OpTxt = ToolTip_OP(oShape)
					ModeTxt = ToolTip_Mode(oShape) 
					AlarmTxt = ToolTip_Alm(oShape,"")
					sToolTip= sPoints & vbCR & SPTxt  & PVTxt & OpTxt &  ModeTxt & AlarmTxt
					if AlarmTxt <> "" then
						oObj.title = sToolTip
					else
						oObj.title = mid(sToolTip,1,len(sToolTip)-1)
					end if
	  			elseif status = "RegValve" then
	  				PVTxt = ToolTip_PV(oShape,status)
					OPTxt = ToolTip_OP(oShape)
					AlarmTxt = ToolTip_Alm(oShape,"")
					sToolTip= sPoints & vbCR & PVTxt  & OPTxt & AlarmTxt
					if AlarmTxt <> "" then
						oObj.title = sToolTip
					else
						oObj.title = mid(sToolTip,1,len(sToolTip)-1)
					end if
	  			else
					AlarmTxt = ToolTip_Alm(oShape,"")
					sToolTip = sPoints & vbcr &  PVTxt &  AlarmTxt 
					if AlarmTxt <> "" then
						oObj.title = sToolTip
					else
						oObj.title = mid(sToolTip,1,len(sToolTip)-1)
					end if
	  			end if
  			Elseif iNrPoints > 1 Then 
				if instr(sPointNames(1),"{%")>0 then
					sPoints=ucase(oShape.objects("ScConAlpPV").datavalue(sCPNames(1)&".name")) & vbcr
				else
					sPoints = ucase(sPointNames(1)) & vbcr	
				end if 
				For i=2 to iNrPoints
				    if instr(sPointNames(i),"{%")>0 then
						sPoints=sPoints & vbcr & ucase(oShape.objects("ScConAlpPV").datavalue(sCPNames(i)&".name"))
					else
						sPoints = sPoints & vbcr & ucase(sPointNames(i))
					end if				      					
					AlarmTxt = ToolTip_Alm(oShape, i-1)
					if AlarmTxt <> "" and typename(oShape.objects("ConAlarmState" & i-1))<>"Nothing" then
						if oShape.objects("ConAlarmState" & i-1).style.visibility = "inherit" then sAlm = AlarmTxt
					end if       				
     			Next 
				if sAlm<>"" then sPoints = sPoints & vbcr & vbcr & sAlm
				oObj.title= sPoints 
  			End If
			if oShape.getcustomproperty("Text","FaceplateFile")="-" then 
				oObj.style.cursor="default"
			else
				oObj.style.cursor="hand"
			end if
			if oShape.getcustomproperty("text","faceplatefile")="-" then oShape.objects("sctxtselectbox").style.cursor="default"
   		end if
 	elseif ucase(right(oObj.id,14))="SCTXTSELECTION" then 
    	set oShape=oObj.parentnode.parentnode
		oShape.objects("ScTxtSelection").style.cursor="hand"
 	end if
end sub

'Get the PV Text shown in tooltip. Called within Page_OnMouseOver
function ToolTip_PV (oShape,PointType)
	on error resume next
	select case PointType
		case "Analog"
			sPV = oShape.getcustomproperty("parameter","cp_pv")
			sPos = instr(sPV,".")
			if spos>0 then sPV = mid(sPV,sPos+1,len(sPv)-sPos)
    		EUDesc = oShape.objects("ScConAlpPV").Datavalue("tagname.cp_eudesc")
			PVFormat = oShape.getcustomproperty("Text","cp_pvformat")
			if PVFormat="" then PVFormat = 2
			PVFormat = oShape.objects("ScConAlpPV").Datavalue("tagname.cp_pvformat")
			PV = oShape.objects("ScConAlpPV").value
			If isnumeric(PV) and sPV<>"" Then 
				PVTxt = ucase(sPV) & "="  & FormatNumber (PV, PVFormat) & " " & EuDesc & vbcr
			elseif sPV<>"" then
				PVTxt =ucase(sPV) & "="  & PV & vbcr
			end if	
		case "RegValve"
			sPV = oShape.getcustomproperty("parameter","cp_pv")
			sPos = instr(sPV,".")
			if spos>0 then sPV = mid(sPV,sPos+1,len(sPv)-sPos)
	    	PV = oShape.objects("ScConAlpPV").value
	    	If sPV<>"" Then PVTxt = ucase(sPV) & "="  & FormatNumber (PV, 0) & " " & "%" & vbcr			
	end select
	ToolTip_PV= PVTxt
end function

'Get the SP Text shown in tooltip. Called within Page_OnMouseOver
function ToolTip_SP (oShape,PointType)
	on error resume next
	select case PointType
		case "Analog"
			sSP = oShape.getcustomproperty("parameter","cp_sp")
			sPos = instr(sSP,".")
			if spos>0 then sSP = mid(sSP,sPos+1,len(sSP)-sPos)
			if sSP = "" and oShape.getcustomproperty("parameter","cp_dev") <>"" then sSP = "SP"		
			SP=""
			SP = oShape.objects("ConAlpSP").value
			SP = oShape.objects("ScConAlpPV").datavalue("Tagname.cp_sp")
			SP = oShape.objects("ScConAlpPV").value - oShape.objects("ScConAlpPV").Datavalue("tagname.cp_dev")
			PVFormat = oShape.getcustomproperty("Text","cp_pvformat")
			if PVFormat="" then PVFormat = 2
			PVFormat = oShape.objects("ScConAlpPV").Datavalue("tagname.cp_pvformat")
			EUDesc = oShape.objects("ScConAlpPV").Datavalue("tagname.cp_eudesc")		
			If isnumeric(SP) Then SPTxt = vblf & ucase(sSP) & "="  & FormatNumber (SP, PVFormat) & " " & EuDesc & vbcr
	end select
	ToolTip_SP= SPTxt
end function

'Get the OP Text shown in tooltip. Called within Page_OnMouseOver
function ToolTip_OP(oShape)',PointType)
	on error resume next
			sOP = oShape.getcustomproperty("parameter","cp_op")
			sPos = instr(sOP,".")
			if spos>0 then sOP = mid(sOP,sPos+1,len(sOP)-sPos)
        	PVFormat=1
			OP=""
			OP = oShape.objects("ScConAlpPV").value
			OP = oShape.objects("ConAlpOP").value
			OP = oShape.objects("ConIndOP").value
			OP = oShape.objects("ScConAlpOP").datavalue("Tagname.cp_op")
	    	If sOP<>"" Then OPTxt = ucase(sOP) & "="  & FormatNumber (OP, PVFormat) & " " & "%" & vbcr
	ToolTip_OP = OPTxt
end function

'Get the Mode Text shown in tooltip. Called within Page_OnMouseOver
function ToolTip_Mode(oShape)
	on error resume next
	ModeTxt = oShape.objects("ScConAlpPV").Datavalue("tagname.cp_mode")
	if len(ModeTxt)>0 Then ToolTip_Mode = "Mode= " & ModeTxt &vbcr
end function

'Get the Alarm Text shown in tooltip. Called within Page_OnMouseOver
function ToolTip_Alm (oShape,index)
	on error resume next
	if typename(oShape.objects("ConAlarmState" & index))<> "Nothing" then 
		AlarmTxt = oShape.objects("ConAlarmState" & index).title
		IF len(AlarmTxt)<>0 and instr(AlarmTxt,"Quality")=0 Then 
			ToolTip_Alm = "Alarm= " & AlarmTxt
		elseif index="" then 
			ToolTip_Alm = "No Alarm "
		else
			 ToolTip_Alm=""
		end if
	end if
end function

'Focus ConAlarmState if an alarm is present or ScConAlpPV when there is no alarm.
sub ObjSel
	dim oShape
	on error resume next
	set oShape=document.getelementbyID(page.getattribute("lastselection")).parentnode.parentnode
	set oAlarmIcon = nothing
  	for each oAlarmState in oShape.children(0).all
    	if instr(oAlarmState.classname, "alarmstate")>0 and (oAlarmState.Style.Visibility = "inherit" or oAlarmState.Style.Visibility = "")  then
			if instr(oAlarmState.title,"Unack") or instr(ucase(page.getattribute("lastselection")),"ALM_SCTXTSELECTBOX")>0 and oAlarmState.title<>"" then
				set oAlarmIcon = oAlarmState	
			end if						
    	end if
  	next
  	if oAlarmIcon is nothing Then
		for each oAlphaNum in oShape.all.tags("TEXTAREA")
			if (oAlphaNum.alarm and &H400)=&H400 then 
				set oAlarmIcon=oAlphaNum
				exit for
			end if	             
  		next
    end if 
  	if oAlarmIcon is nothing Then
    	oshape.objects("ScConAlpPV").focus
  	else
    	oAlarmIcon.focus
  	end if
end sub

'Provide Left Click behavior. Invoke Faceplate
sub All_OnClick(oSource) 
	dim oShape,soldsel
  	on error resume next
	set oPrntSrc=window.external
	if bTrdResp=true then bCancel=true	' Check to prevent message zone flickering, when All_TrdSel_lib_h_01_R300.sha is not present in the current display.
										' See Trend_Sup_GSH.sha trdresp subroutine
	set oShape=oSource.parentnode.parentnode
	call SelectBox_Color(oSource)
    set otarget=oshape.objects("ScConAlpPV")
    sfaceplatefile=oshape.getcustomproperty("text","faceplatefile")
    if sfaceplatefile="" then
   	   set oSource.onfocus = nothing
       otarget.click 
	   oTarget.style.color = oTarget.textcolor
    elseif sfaceplatefile="-" then
       if not isobject(oSource.onfocus) then set oSource.onfocus=getref("ObjSel")
       oSource.focus
    else
       scurrentpoint=oshape.getcustomproperty("point","tagname")
       sPoints= "?CurrentPoint=" & sCurrentPoint 
       for n=1 to oshape.customProperties.Count -1
  	      if oshape.customProperties.Item(n).type = "Point" or oshape.customProperties.Item(n).type = "Parameter" then 
    	    sPoints = sPoints & "&" & oshape.customProperties.Item(n).name & "=" & oshape.customProperties.Item(n).value
	      end if
		  if oShape.getcustomproperty("Text","cp_pvformat")<>"" then sPoints=sPoints & "&cp_pvformat=" & oShape.getcustomproperty("Text","cp_pvformat")
       next	   
       sfaceplatefile = mid(sfaceplatefile,1,instr(1,sfaceplatefile,".htm")+3)
	   if oTarget.quality = 0  then 
	   		if ucase(Left(oShape.customproperties.Item(1).Name,3))="TAG" then
				Quality = oTarget.DataQuality(oShape.customproperties.Item(1).Name & ".cp_Tag1_pv" ) ' Used for F&G Shapes
			else
				Quality = oTarget.DataQuality(oShape.customproperties.Item(1).Name & ".cp_AlmPar1" ) ' Used for Multialarm shapes
			end if
	   else
	   		Quality = oTarget.quality
	   end if
       if instr(sfaceplatefile,"sysPUP")>0 then 
	   		ifpmode=0
			set oPop=hdxpopupbehavior.findpopup("1oo1")
			if typename(oPop)<>"Nothing" then oPop.close
			set oPop=hdxpopupbehavior.findpopup("1oo2")
			if typename(oPop)<>"Nothing" then oPop.close
			set oPop=hdxpopupbehavior.findpopup("2oo2")
			if typename(oPop)<>"Nothing" then oPop.close
			set oPop=hdxpopupbehavior.findpopup("2oo2")
			if typename(oPop)<>"Nothing" then oPop.close
			set oPop=hdxpopupbehavior.findpopup("2oo3")
			if typename(oPop)<>"Nothing" then oPop.close 
	   else 
	   		ifpmode=1 
	   end if
       if (Quality and iQualityAccessNotPermitted) <> iQualityAccessNotPermitted then call hdxpopupbehavior.createpopupwindow(sfaceplatefile & spoints,0,0,ifpmode)
    end if 
end sub

sub All_MultInt_OnClick(oSource)
	on error resume next
	set oShape=oSource.parentnode.parentnode
	window.external.currentpage=oshape.getcustomproperty("Text","cp_CEDisplay") 
end sub

sub All_MultAlm_OnClick(oSource) 
	dim oShape,soldsel
  	on error resume next
 	set oShape=oSource.parentnode.parentnode
	call SelectBox_Color(oSource)
  	for each oAlarmState in oShape.children(0).all
    	if instr(oAlarmState.classname, "alarmstate")>0 and oAlarmState.Style.Visibility = "inherit" then
			set oTarget = oAlarmState
    	end if
  	next
    sfaceplatefile=oshape.getcustomproperty("text","faceplatefile" & right(otarget.id,1))
    if sfaceplatefile="" then
   	   set oSource.onfocus = nothing
       otarget.click 
    elseif sfaceplatefile="-" then
       if not isobject(oSource.onfocus) then set oSource.onfocus=getref("ObjSel")
       oSource.focus
    else
       scurrentpoint=oshape.getcustomproperty("point","tagname")
       sPoints= "?CurrentPoint=" & sCurrentPoint 
       for n=1 to oshape.customProperties.Count -1
  	      if oshape.customProperties.Item(n).type = "Point" or oshape.customProperties.Item(n).type = "Parameter" then 
    	    sPoints = sPoints & "&" & oshape.customProperties.Item(n).name & "=" & oshape.customProperties.Item(n).value
	      end if
       next	   
       sfaceplatefile = mid(sfaceplatefile,1,instr(1,sfaceplatefile,".htm")+3)
       if (Quality and iQualityAccessNotPermitted) <> iQualityAccessNotPermitted then call hdxpopupbehavior.createpopupwindow(sfaceplatefile & spoints,0,0,1)
    end if 
end sub

sub All_MultAlm_OnCMenu(oSource) 
	dim oShape,soldsel
  	on error resume next
 	set oShape=oSource.parentnode.parentnode
	call SelectBox_Color(oSource)
  	for each oAlarmState in oShape.children(0).all
    	if instr(oAlarmState.classname, "alarmstate")>0 and oAlarmState.Style.Visibility = "inherit" then
			set oTarget = oAlarmState
    	end if
  	next
   	set oSource.onfocus = nothing    
    sCMfile=oshape.getcustomproperty("text","ContextMenuFile" & right(otarget.id,1))
    if isnull(page.getattribute("CMenu_GSH")) then
		use_cm_shape=false
	else 
		use_cm_shape = true
	end if
	if not isobject(oSource.onfocus) then set oSource.onfocus=getref("ObjSel")
    if sCMfile="-" then
      oSource.focus
    elseif sCMfile="" or use_cm_shape = false then
      oTarget.fireevent("oncontextmenu")
      oSource.focus
    else
      hdxpopupbehavior.invokeshortcutmenu sCMfile,0,0
      oSource.focus    
    end if
end sub

'Provide Right Click behavior. Invoke Context Menu.
sub All_OnCMenu(oSource)
    dim oShape,soldsel
    on error resume next
    if bTrdResp=true then bCancel=true	' Check to prevent message zone flickering, when All_TrdSel_lib_h_01_R300.sha is not present in the current display.									
										' See Trend_Sup_GSH.sha trdresp subroutine	
	set oShape=oSource.parentnode.parentnode    
	call SelectBox_Color(oSource)
    if not isobject(oSource.onactivate) then set oSource.onactivate=getref("ObjSel")
    sCMfile=oshape.getcustomproperty("text","ContextMenuFile")
    if isnull(page.getattribute("CMenu_GSH")) then
		use_cm_shape=false
	else 
		use_cm_shape = true
	end if
    if sCMfile="-" then
      oSource.focus
    elseif sCMfile="" or use_cm_shape = false then
      oSource.focus
	  oShape.objects("ScConAlpPV").fireevent("oncontextmenu")
    else
	  oSource.focus 
      hdxpopupbehavior.invokeshortcutmenu sCMfile,0,0
    end if
	if oShape.object("ScConAlpPV").style.pixelwidth>0 then
		if not isobject(oShape.objects("ScConAlpPV").onblur) then set oShape.objects("ScConAlpPV").onblur=getref("CM_focus") 
    end if 
end sub

sub CM_Focus
    on error resume next
    soldsel=page.getattribute("lastselection")
	set oShape=document.getelementbyid(soldsel).parentnode.parentnode
	oShape.objects("ScConAlpPV").styleclass=oShape.objects("ScConAlpPV").styleclass
	oShape.objects("ScConAlpPV").style.color=oShape.objects("ScConAlpPV").textcolor
	oShape.objects("ScConAlpPV").style.backgroundcolor=oShape.objects("ScConAlpPV").fillcolor 
end sub

'Change the ScTxtSelectBox color when selected
sub SelectBox_Color(oSource)
	dim soldsel
	on error resume next
	soldsel=page.getattribute("lastselection")
	if not isnull(soldsel) then page.all.item(soldsel).styleclass = "ScTxtSelectBox_NotSelected"
    page.setattribute "lastselection",osource.id
    if ucase(right(oSource.id,18)) <> "ALM_SCTXTSELECTBOX" then osource.styleclass = "ScTxtSelectBox_Selected"
end sub

'Determine the most importatnt alarm. Used in shapes with multiple tagnames
Sub Multiple_Alarm_Icon(oSource)
	Dim sMostImportantAlarm, sAlarmState, iThisImportancy, iMostImportant, oAlarmState, iAlarmCount, iInActiveAlarmCount
	On error resume next
	iMostImportant=0
	for each oAlarmState in oSource.parentnode.children 		
		if instr(oAlarmState.classname, "alarmstate")>0 then		    
 			iAlarmCount = iAlarmCount + 1
    		iThisImportancy = 0
    		iThisImportancy = 24+oAlarmState.Acknowledged*16 + oAlarmState.Priority*2 + oAlarmState.RTN*8
    		if iThisImportancy  = 16 then iThisImportancy = 8
    		if iThisImportancy >iMostImportant then 
       			sMostImportantAlarm = oAlarmState.id
       			iMostImportant = iThisImportancy
    		end if
			if iThisImportancy = 0 then iInActiveAlarmCount = iInActiveAlarmCount + 1 
 		end if
	next
	for each oAlarmState in oSource.parentnode.children
   		if instr(oAlarmState.classname, "alarmstate")>0 then 
      		if oAlarmState.id = sMostImportantAlarm or iAlarmCount = iInActiveAlarmCount then
 	  	 		oAlarmState.Style.Visibility = "inherit"
      		else
         		oAlarmState.Style.Visibility = "hidden"
      		end if
    	end if
	next
End Sub

' -------------------------------------
' Navigations 
' -------------------------------------

sub Nav_SelectBox_OnClick(oSource)
	on error resume next
	window.external.currentpage = oSource.parentnode.parentnode.getcustomproperty("Text","DspName")
end sub

Sub NavsArrow_HP_AlpAlarm_OnDataChange(oSource)
	dim oShape,iUnack,iAck
	on error resume next
	set oShape=oSource.parentnode.parentnode
	oShape.Objects("HprLnkDsp").style.color=page.GetStyleClassProperty("TagNameEUDesc", "hw-text-color")
	iPr=(oSource.dataalarm("tagname.name") and 48)/16
	iUnack=(oSource.dataalarm("tagname.name") and 1024)=1024
	if iUnack = True then
	  	oShape.objects("ScPlgAlarm").fillcolorblink=true
	else
   		oShape.objects("ScPlgAlarm").fillcolorblink=false
	end if
	select case iPr
    case 0
		if oShape.objects("ScPlgAlarm").fillcolorblink=true then
			oShape.objects("ScPlgAlarm").styleclass = "NavFrame_Unack"
		else
		 	oShape.objects("ScPlgAlarm").styleclass = "NavFrame"			
		end if
	case 1
		oShape.objects("ScPlgAlarm").fillcolor=AlarmStateIconfactory.lowColor	
	case 2
		oShape.objects("ScPlgAlarm").fillcolor=AlarmStateIconfactory.highColor
	case 3
		oShape.objects("ScPlgAlarm").fillcolor=AlarmStateIconfactory.urgentColor    
	end select			
	if err.number<>0 then window.external.LogMessage " NavsArrow_HP_AlpAlarm_OnDataChange ->" & oSource.id & " " & err.description
end sub

' -------------------------------------
'Building Blocks
' -------------------------------------
sub All_DigState_AlpPV_OnUpdate(oSource)
   dim oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   set oPV=oShape.objects("ScConAlpPV")
  	iPV=oSource.breakpointvalueenum
   	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
   	oPV.styleclass="ScConAlpPV_" & index		
   if err.number<>0 then window.external.LogMessage " All_DigState_AlpPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

sub All_DigStateCText_AlpPV_OnUpdate(oSource)
   dim oShape,oPVObj
   on error resume next
   set oShape=oSource.parentnode.parentnode
   set oPVObj=oShape.objects("TxtPV")
   if (oSource.quality and iQualityBad)=iQualityBad and  (oSource.quality and iQualityOffScan)<>iQualityOffScan then
      oPVObj.innertext="--------" 
      oPVObj.textcolor=vbRed
   else
	  oPVObj.innertext=oShape.GetCustomProperty("Text","cp_TextForPV" &  cstr(oSource.value))
      oPVObj.styleclass="ScConAlpPV_" & oShape.getcustomproperty("Style","cp_StyleForPV" & cstr(oSource.value))
   end if
   if err.number<>0 then window.external.LogMessage " All_DigStateCText_AlpPV_OnUpdate ->" & oSource.id & " " & err.description 
end sub

'-------------------------------------
'Interlock and Bypass
'-------------------------------------
sub All_ILBP_AlpPV_OnUpdate(oSource)
	dim oShape, iPV
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iValueONInt = cint(oShape.getcustomproperty("Num","cp_PlgInterlock_ONValue"))
	if instr(oSource.value,"#")=0 then if iValueONInt=cint(oSource.value) then : iPV=1 : else : iPV=0 : end if
	if (oSource.quality and 192)<>192 then iPV=2  
	index = oShape.getcustomproperty("Style","cp_Style" & iPV)
    oShape.objects("PlgInterLock").styleclass = "PlgInterLock_" & index	
	if err.number<>0 then window.external.LogMessage "Scd_ILBP_AlpPV_OnUpdate ->" & oSource.id & " " & err.description       			
end sub]]></script><script event="" language="VBScript" id="2323F590-AA88-4454-AE52-8E4F915B2FB7"><![CDATA['This shape provides the ability to view, edit and invoke trend groups.
dim tid				'Timer ID
dim bGroupSelected	'Used if All_TrdSel_lib_h_01_R300.sha is missing to ensure the operator responce
dim sParameter		'Used to store the parameter to be added in the selected trend group
dim bLoaded			'Used to to ensure once off update of the chart shape if present 
dim oWindow_Tnd			'Used to reload trend in SafeView Environment when trace added
dim selrecoffset	'Used to reload trend in SafeView Environment when trace added
dim bTrendSet		'Used to set the trend number to the last selected trend

'Check the number of empty pens left in the currently selected trend group. Called within AlpTrendGrp.onupdate
sub is_empty
	dim tagn, e_pl, pointpar, oShape, oShape_sel
	on error resume next
	if isnull(page.getattribute("TrdSel")) then exit sub
	set oshape=document.getelementbyid(page.getattribute("Trend_Sup_GSH"))
	set oshape_sel=document.getelementbyid(page.getattribute("trdsel"))
	if oShape.objects("alpisprotected").value = 1 and window.external.securitylevel<4 then 
   		oShape_sel.title = "Protected"
		if typename(oShape_sel.objects("TxtFreePens"))<>"Nothing" then oShape_sel.objects("TxtFreePens").value="Protected"
		if oshape.objects("TrdTbl").style.visibility = "visible" then oshape.objects("RecProtected").style.pixelwidth=400
		exit sub		 
	else
		oshape.objects("RecProtected").style.pixelwidth=0
	end if	
	e_pl =0
	for i= 0 to 31   
		pointpar = oShape.objects("TrdTbl").fields.item("Point.value").getvalue(i)
		if pointpar=" " then e_pl=e_pl+1
	next
	oShape_sel.title = "Free Pens " & e_pl
	if typename(oShape_sel.objects("TxtFreePens"))<>"Nothing" then oShape_sel.objects("TxtFreePens").value="Free Pens " & e_pl
	if err.number <> 0 then window.external.LogMessage "is_empty ->" & oShape.id & " " & err.description 
end sub

'Update the contents of the chart shape object with the pens in the currently selected trend group. Called within AlpTrendGrp.onupdate
sub upd_chart
	dim oShape
	on error resume next
	if isnull(page.getattribute("Trend_Sup_GSH")) then exit sub
	if isnull(page.getattribute("TrdSel")) then exit sub
	set oshape=document.getelementbyid(page.getattribute("Trend_Sup_GSH"))
	for each oObj in page.all.tags("DIV")
  		if oObj.classname="hsc.shape.1" then
     		if not (oObj.objects("Custtrd") is nothing) then
				for i=0 to 31
	      			point = oshape.objects("TrdTbl").fields.item("Point.value").getvalue(i)
		  			par = oshape.objects("TrdTbl").fields.item("Parameter.value").getvalue(i)		  							
					if oObj.objects("CustTrd").legend.PointID(i+1)<>"" then oObj.objects("CustTrd").legend.PointID(i+1)=" "					
					oObj.objects("CustTrd").legend.parameter(i+1)=""
					if asc(left(point,1))<>32 then
		     			oObj.objects("CustTrd").legend.PointID(i+1)=point
		     			oObj.objects("CustTrd").legend.parameter(i+1)=par
						oObj.objects("CustTrd").legend.PlotVisible(i+1)=true
		  			end if
				next    
     		end if
  		end if 
	next
	if err.number <> 0 then window.external.LogMessage "upd_chart ->" & oShape.id & " " & err.description 
end sub

'Prompt to select a trend group in case All_TrdSel.sha is not present in the display
sub trdresp
	on error resume next
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oPage=page
		set oWnd=window.external
    else
	    set	oPage=window.external.parentdocument.parentwindow.document.all.page 
		set oWnd=window.external.parentdocument.parentwindow.external
	end if
	
	if bCancel=true then 
    	window.clearinterval(tid)
		bCancel=false
		bTrdResp=false
		bGroupSelected = false
    	exit sub
	end if
	istatus=oWnd.getresponse3 ( "No trend group selected! Please select one. ", 0, resp)
	if istatus=1 and resp<>"" then 
		trdg = csng(resp)
		if err.number = 0 and trdg > 0 then 	
			set oshape_TrendSup=oPage.document.getelementbyid(oPage.getattribute("Trend_Sup_GSH"))
			oshape_TrendSup.objects("AlpTrendGrp").value = trdg
		else
    		oWnd.messagezonetext "this is not a valid trend number!"
			istatus=0
		end if
		bTrdResp=false
		bGroupSelected = true
    	window.clearinterval (tid)
		call add2trend(sParameter)
	end if
	if istatus=0 then window.clearinterval (tid)
	if err.number <> 0 then window.external.LogMessage "trdresp ->" & oShape.id & " " & err.description
end sub

'Add the parameter stored in sParameter to the selected trend group
sub add2trend(sparam)
	dim oshape, oshape_c, oshape_sel,cm_point, cm_param, trd_num, empty_place, pointpar, tagn
	on error resume next
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oPage=page
		set oWnd=window.external
    else
	    set	oPage=window.external.parentdocument.parentwindow.document.all.page 
		set oWnd=window.external.parentdocument.parentwindow.external
	end if

	set oshape_sel=oPage.document.getelementbyid(oPage.getattribute("trdsel"))
	selrecoffset=oshape_sel.objects("AlpTrendGrp").value
	set oshape = page.document.getelementbyid(page.getattribute("lastselection")).parentnode.parentnode
	set oshape_c=oPage.document.getelementbyid(oPage.getattribute("Trend_Sup_GSH"))
	Trd_Par= oShape.GetCustomProperty("Parameter",sParam)
	DotLoc= Instr(1, Trd_Par,".")
	sPoint_CP= Mid(Trd_Par,1, DotLoc-1)
	sParameter_CP = Mid(Trd_Par, DotLoc+1, 24)
	cm_point = oShape.GetCustomProperty("Point",sPoint_CP)
	if cm_point = "" then cm_point = sPoint_cp
	if instr(cm_point,"{%")>0 then cm_point=oShape.objects("ScConAlpPV").datavalue("tagname.name")
	cm_param = oShape.GetCustomProperty("Parameter",sParameter_CP)
	if cm_param = "" then cm_param = sParameter_CP
	trd_num = oShape_c.objects("AlpTrendGrp").value
	if isnull(oPage.getattribute("TrdSel")) and bGroupSelected = false then 
		sParameter = sparam 
		oPage.focus
		bTrdResp=true
		tid = window.setinterval ("trdresp",500)
    	exit sub
	end if
	if oShape_c.objects("alpisprotected").value = 1 and oWnd.securitylevel<4 then 
		oWnd.messagezonetext "The trend group no " & trd_num & " is protected!"
		exit sub
	end if	 
	exist = 0
	empty_place = -1
	for i=0 to 31
		pointpar = oShape_c.objects("TrdTbl").fields.item("Point.value").getvalue(i)
		if ucase(pointpar) = ucase (cm_point) and ucase(oShape_c.objects("TrdTbl").fields.item("Parameter.value").getvalue(i)) = ucase (cm_param) then exist = 1	
		if pointpar=" " and empty_place = -1 then empty_place = i 
	next
	if exist = 0 then
		if empty_place >= 0 then
			oShape_c.objects("TrdTbl").fields.item("Point.value").setvalue empty_place, cm_point
			oShape_c.objects("TrdTbl").fields.item("Parameter.value").setvalue empty_place, cm_param
			free = right(oShape_sel.title,2)
			free=free-1
        	oShape_sel.title="Free Pens " & free
			if typename(oShape_sel.objects("TxtFreePens"))<>"Nothing" then oShape_sel.objects("TxtFreePens").value="Free Pens " & free
			oWnd.messagezonetext ucase(cm_point) & "." & ucase(cm_param) & " Has been added to trend group no " & trd_num
			set oSview=getobject("","Honeywell.Workspace.Client")
			If oSview.IsManagerActive = true then
				reload_trend=false
				reload_popup=false
				for each oWndw in ownd.parent.StationWindows
					recoffset=oWndw.currentrecordoffset
					currpage=oWndw.currentpage 
					if lcase(currpage)="systnd03.htm" and cint(recoffset)=cint(selrecoffset) then                      
					   reload_trend=true
					   set oWindow_Tnd=oWndw										   
					elseif lcase(currpage)="chart_popup_cp.htm" then
						if cint(selrecoffset)=cint(mid(oWndw.document.title,14)) then 
					   		reload_popup=true
					   		set oWindow_Pop=oWndw					
						end if
					end if
				next
				if reload_trend=true then 
					oSview.setoutputfocuswnd(oWindow_Tnd.AppWindow.HWND)
					window.setTimeout "reloadTrend", 1000 
				end if	
				if reload_popup=true then 
					oSview.setoutputfocuswnd(oWindow_Pop.AppWindow.HWND)
					window.setTimeout "reloadPopup", 1000 
				end if
			else
				set chrt_pop=hdxpopupbehavior.findpopup("dummy" & selrecoffset)
				if typename(chrt_pop)<>"Nothing" then
					chrt_pop.close
					window.setTimeout "reloadPopup", 1000
				end if
			end if	
		else 
			oWnd.messagezonetext "Trend group no " & trd_num & " is full!"
		end if
	else
		oWnd.messagezonetext ucase(cm_point) & "." & ucase(cm_param) & " Has been already configured in trend group no " & trd_num 
	end if
	window.settimeout "upd_chart", 1000
	bGroupSelected = false
	if err.number <> 0 then oWnd.LogMessage "add2trend ->" & oShape.id & " " & sparam & " " & err.description
end sub

sub reloadTrend()
	oWindow_Tnd.requestserverlrn 21, 8, selrecoffset
end sub

sub reloadPopup()
	call trd_popup
end sub]]></script><script event="" language="VBScript" id="1FD1EC49-26E5-4ADD-BB13-EDDC2E8FAD53"><![CDATA['This shape provides the Solution Pack Context Menu functionality.
'All subroutines are called within SP context menu files

'Acknowledge the alarm on currently selected point
sub acknowledge()
    on error resume next
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oWnd=window.external
    else
	    set	oWnd=window.external.parentdocument.parentwindow.external 
	end if	
	oWnd.invokemenu2 "Acknowledge Alarm"
end sub

'Invoke detail display of currently selected point 
sub detail()
	on error resume next
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oWnd=window.external
    else
	    set	oWnd=window.external.parentdocument.parentwindow.external 
	end if
	oWnd.invokemenu2("Request Point Detail")	
end sub

'Invoke the trend group where currently selected point is configured or prompt for trend group number.
sub trd_invoke()
	on error resume next
	dim oshape, custtrd
	set oshape = document.getelementbyid(page.getattribute("lastselection")).parentnode.parentnode
	custtrd=oshape.getcustomproperty("num","cp_custtrd")
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oWnd=window.external
    else
	    set	oWnd=window.external.parentdocument.parentwindow.external 
	end if
	if custtrd<>"" then 
		oWnd.requestserverlrn 21,8,custtrd
	else
		oWnd.invokemenu2("request trend")
	end if			
end sub

'Invoke the group where currently selected point is configured or prompt for group number.
sub grp_invoke()
	on error resume next
	dim oshape, custgrp
	set oshape = document.getelementbyid(page.getattribute("lastselection")).parentnode.parentnode
	custgrp = oshape.getcustomproperty("num","cp_custgrp")
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oWnd=window.external
    else
	    set	oWnd=window.external.parentdocument.parentwindow.external 
	end if
	if custgrp <> "" then
		oWnd.requestserverlrn 21,49,custgrp
	else
		oWnd.invokemenu2("request group")
	end if
end sub

'Invoke associated display for currently selected point
sub ascdsp()
    on error resume next 
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oWnd=window.external
    else
	    set	oWnd=window.external.parentdocument.parentwindow.external 
	end if
	oWnd.invokemenu2("associated display")
end sub

'Open help file using Windows Explorer, if configured in cm_file custom property
sub help ()
	on error resume next
	dim oshape, spath, cm_file
	set oshape = document.getelementbyid(page.getattribute("lastselection")).parentnode.parentnode
	cm_file = oshape.getcustomproperty("text","cm_file")
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oWnd=window.external
    else
	    set	oWnd=window.external.parentdocument.parentwindow.external 
	end if
	if instr(cm_file,"\")>0 then
 		oWnd.shell "explorer.exe " & cm_file,1
	else
 		spath = page.document.url
 		spath=mid (spath,8,len(spath))
 		spath=mid (spath,1,instrrev(spath,"\"))  & "helpfiles\" & cm_file
 		spath = Replace(spath,"%20"," ")
 		oWnd.shell "explorer.exe " & spath,1
	end if
end sub

'Called in OnPage event of the Help Item of the Context Menu. Manipulates the menu item text.
sub pageload(osource)
	on error resume next
	dim oshape, spath, cm_file
	set oshape = document.getelementbyid(page.getattribute("lastselection")).parentnode.parentnode
	cm_label = oshape.getcustomproperty("text","cm_label")
	if (cm_label <> "") then	
		oSource.all("text").innertext=" " & cm_label	
		cm_file=oshape.getcustomproperty("text","cm_file")
		if cm_file="" then osource.disabled=true		
	end if
end sub

' Enable/Disable Add Traces to Trend functionality 
sub AddTrdCnfg (oSource, sText)
	On Error Resume Next
	dim oShape, spath, cm_param
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oPage=page
    else
	    set	oPage=window.external.parentdocument.parentwindow.document.all.page 
	end if
	if isnull(oPage.getattribute("Trend_Sup_GSH")) then 
   		oSource.disabled = True
  		exit sub
	end if
	set oShape = document.getElementById(page.getattribute("LastSelection")).parentnode.parentnode
	cm_param = oShape.GetCustomProperty("Parameter",sText)
	if cm_param = "" then oSource.disabled = True
end sub

'Enable/Disable View Trend Configuration functionality. Called in OnPage event of View Trend Item
Sub View_Trd_Load(oSource)
	on error resume next
		if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oPage=page
    else
	    set	oPage=window.external.parentdocument.parentwindow.document.all.page 
	end if
	
	if isnull(oPage.getattribute("Trend_Sup_GSH")) or isnull(oPage.getattribute("TrdSel"))  then oSource.disabled = True
    if oSource.id="mnu_View_TrdCnf" then
		for each oObj in oPage.all
	   		if instr(ucase(oObj.classname),"HSC.TREND.1")<>0 then oSource.disabled = True
		next
	end if	  
end sub

'View Trend Configuration if enabled in View_Trd_Load
sub view_trd
	dim oShape
	on error resume next
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oPage=page
		set oWnd=window.external
    else
	    set	oPage=window.external.parentdocument.parentwindow.document.all.page 
		set oWnd=window.external.parentdocument.parentwindow.external
	end if

	set oshape=oPage.document.getelementbyid(oPage.getattribute("Trend_Sup_GSH"))
	if oshape.objects("PbHide").style.visibility="visible" then oshape.objects("PbHide").click
	oshape.style.zindex=5000
	iPageWidth = oPage.style.pixelwidth
	iSelectedShapeX = oPage.document.getelementbyid(oPage.getattribute("lastselection")).parentnode.parentnode.style.pixelleft
	if iSelectedShapeX > iPageWidth/2 then
		iTableLeft = 20
	else
		iTableLeft = iPageWidth - 420
	end if
	oshape.style.pixelleft=iTableLeft
	oshape.style.pixeltop=80
	oshape.objects("trdtbl").style.visibility="visible"
	oshape.objects("trdtbl").style.pixelwidth=400
	oshape.objects("PbHide").style.visibility="visible"
	oshape.objects("PbHide").style.pixelleft=oshape.objects("PbHide").style.pixelleft+336
	if oShape.objects("alpisprotected").value = 1 and oWnd.securitylevel<4 then oshape.objects("RecProtected").style.pixelwidth=400	
end sub

'Invoke mini trend popup
sub view_mini_trend
	dim oShape
	on error resume next
	set oShape = document.getElementById(page.getattribute("LastSelection")).parentnode.parentnode    
	Trd_ParSP= oShape.GetCustomProperty("Parameter","Trd_PointSP")
	DotLoc= Instr(1, Trd_ParSP,".")
	sPointSP_CP= Mid(Trd_ParSP,1, DotLoc-1)
	sParameterSP_CP = Mid(Trd_ParSP, DotLoc+1, 24)
	cm_pointSP = oShape.GetCustomProperty("Point",sPointSP_CP)
	if cm_pointSP = "" then cm_pointSP = sPointSP_cp
	cm_paramSP = oShape.GetCustomProperty("Parameter",sParameterSP_CP)
	if cm_paramSP = "" then cm_paramSP = sParameterSP_CP
	Trd_ParPV= oShape.GetCustomProperty("Parameter","Trd_PointPV")
	DotLoc= Instr(1, Trd_ParPV,".")
	sPointPV_CP= Mid(Trd_ParPV,1, DotLoc-1)
	sParameterPV_CP = Mid(Trd_ParPV, DotLoc+1, 24)
	cm_pointPV = oShape.GetCustomProperty("Point",sPointPV_CP)
	if cm_pointPV = "" then cm_pointPV = sPointPV_cp
	cm_paramPV = oShape.GetCustomProperty("Parameter",sParameterPV_CP)
	if cm_paramPV = "" then cm_paramPV = sParameterPV_CP
    Trd_ParOP= oShape.GetCustomProperty("Parameter","Trd_PointOP")
	DotLoc= Instr(1, Trd_ParOP,".")
	sPointOP_CP= Mid(Trd_ParOP,1, DotLoc-1)
	sParameterOP_CP = Mid(Trd_ParOP, DotLoc+1, 24)
	cm_pointOP = oShape.GetCustomProperty("Point",sPointOP_CP)
	if cm_pointOP = "" then cm_pointOP = sPointOP_cp
	cm_paramOP = oShape.GetCustomProperty("Parameter",sParameterOP_CP)
	if cm_paramOP = "" then cm_paramOP = sParameterOP_CP
	xcoord=page.getstyleclassproperty("Mini_Trend","left_position")
	ycoord=page.getstyleclassproperty("Mini_Trend","top_position")
	set oSview=getobject("","Honeywell.Workspace.Client")
	If oSview.IsManagerActive = false then
		if xcoord="default" or ycoord="default" then
			hdxpopupbehavior.createpopupwindow "Mini_Trend_Popup.htm?currentpoint=minitrd"& round (rnd*10000) & "&Point1=" & cm_pointPV & "&Point2=" & cm_pointSP & "&Point3=" & cm_pointOP & "&Parameter1=" & cm_paramPV & "&Parameter2=" & cm_paramSP & "&Parameter3="& cm_paramOP, 0, 0, 1
		else 
			set oMini_trd=HdxPopupBehavior.FindPopup("minitrd")
			if typename(oMini_trd)<>"Nothing" then oMini_trd.close
			hdxpopupbehavior.createpopupwindow "Mini_Trend_Popup.htm?currentpoint=minitrd"& round (rnd*10000) & "&Point1=" & cm_pointPV & "&Point2=" & cm_pointSP & "&Point3=" & cm_pointOP & "&Parameter1=" & cm_paramPV & "&Parameter2=" & cm_paramSP & "&Parameter3="& cm_paramOP, xcoord, ycoord, 0
		end if
    else
		hdxpopupbehavior.createpopupwindow "Mini_Trend_Popup.htm?currentpoint=minitrd"& round (rnd*10000) & "&Point1=" & cm_pointPV & "&Point2=" & cm_pointSP & "&Point3=" & cm_pointOP & "&Parameter1=" & cm_paramPV & "&Parameter2=" & cm_paramSP & "&Parameter3="& cm_paramOP, 0, 0, 1
	end if
end sub

' Invoke trend popup. called within sp_systrdsel_sm.xml
sub trd_popup
    on error resume next
	if instr(typename(window.external),"IHDXPopupWindow")=0 then
		set	oPage=page
		set oWnd=window.external
    else
	    set	oPage=window.external.parentdocument.parentwindow.document.all.page 
		set oWnd=window.external.parentdocument.parentwindow.external
	end if
	set oShape = oPage.document.getElementById(oPage.getattribute("Trend_Sup_GSH"))
	sFP = "Chart_Popup_CP.htm?currentpoint=dummy" & oShape.objects("AlpTrendGrp").value
	for i = 1 to 32
		point = oshape.objects("TrdTbl").fields.item("Point.value").getvalue(i-1)
		par = oshape.objects("TrdTbl").fields.item("Parameter.value").getvalue(i-1)
		sFP = sFP & "&Point" & i & "=" & point & "&Parameter"& i & "=" & par
	next
	xcoord=page.getstyleclassproperty("Trend_popup","left_position")
	ycoord=page.getstyleclassproperty("Trend_popup","top_position")
	set oSview=getobject("","Honeywell.Workspace.Client")
	If oSview.IsManagerActive = false then
		if xcoord="default" or ycoord="default" then
			hdxpopupbehavior.createpopupwindow sFP,0,0,1
		else 
			set oChrt_Popup=HdxPopupBehavior.FindPopup("dummy")
			if typename(oChrt_Popup)<>"Nothing" then oChrt_Popup.close
			hdxpopupbehavior.createpopupwindow sFP,xcoord,ycoord,0
		end if
    else
		hdxpopupbehavior.createpopupwindow sFP,0,0,1
	end if
end sub

'Enable/Disable Detail Display Functionality in Fire and Gas Context Menu.
sub fire_gas_pageload(oSource)
	dim oShape
	on error resume next
	set oshape = document.getelementbyid(page.getattribute("lastselection")).parentnode.parentnode
	index = cint(right(oSource.id,1) )
	mn_txt=oShape.getcustomproperty("Point",oShape.customproperties.Item(index).name)
	if mn_txt="" then 
   		oSource.disabled=true
	else
  		oSource.all("text").innertext="Detail " & ucase(mn_txt)  
   		oSource.disabled=false
	end if
	if err.number <>0 then window.external.LogMessage "fire_gas_pageload ->" & oShape.ID & " " & oSource & " " & err.description 
end sub

'Invoke Detail Display for Fire and Gas point if enabled in fire_gas_pageload
sub fire_gas_detail(oSource)
    on error resume next
	window.external.requesttask 21,73,0,0,0,mid(oSource.all("text").innertext,8,len(oSource.all("text").innertext)-7)
end sub

'Invoke the C&E popup for the appropriate fire and gas points .
sub InvokeCE(oSource)
	on error resume next
	dim oshape, sPoint
	set oshape = document.getelementbyid(page.getattribute("lastselection")).parentnode.parentnode
	sPoint=oshape.getcustomproperty("Point","tagname")
	hdxpopupbehavior.CreatePopupWindow spoint & "_CE.htm?currentpoint=" & sPoint, 0,0,0				
end sub]]></script><script event="" language="VBScript" id="E632C282-AEAE-49CF-82C0-2DBD94E8D056"><![CDATA['--------------------------------------
'RegCntl - Mode; EUDesc; 
'--------------------------------------
sub CDA_RegCntl_Mode_EUDesc_OnUpdate(oSource)
   dim sMode, iPID_HialmT, iDac_HialmT, iAlmEnbState, iRedTag, oShape,oPIDAlm,oDACAlm
   on error resume next
   set oShape=oSource.parentnode.parentnode
   if oshape.getcustomproperty("parameter","cp_mode")<>"" then
      sMode=oSource.DataValue("tagname.cp_mode")
	  oShape.objects("TxtMode").innertext=left(sMode,1)
	  if instr(sMode,"#")<>0 then oShape.objects("TxtMode").innertext=""
   end if
   if oshape.getcustomproperty("parameter","cp_nmode")<>"" then
      sNMode=oSource.DataValue("tagname.cp_nmode")
	  if sMode=sNMode then
      	oShape.objects("TxtMode").styleclass="TxtMode_in_NMode"
      else 
      	oShape.objects("TxtMode").styleclass="TxtMode_not_in_NMode"
      end if 
   end if   
   sComQual=oShape.getattribute("BadQual")
   if isNull(sComQual) then 
   		oShape.setAttribute "BadQual","OK"
		sComQual="OK"
   end if
   if oShape.getcustomproperty("Text","cp_TagnameEU")="" then oShape.objects("TxtEUDesc").innertext = oSource.DataValue("tagname.cp_eudesc")   
   if instr(oShape.objects("ScConAlpPV").value,"N")>0 then 
   		oShape.objects("ScConAlpPV").currentvalue="--------"
   		oShape.objects("ScConAlpPV").textcolor=vbred
   elseif sComQual="BAD" then
 		oShape.objects("ScConAlpPV").styleclass="ScConAlpPV_BAD"
		oShape.objects("ScConAlpPV").style.color=oShape.objects("ScConAlpPV").textcolor
		oShape.objects("ScConAlpPV").style.backgroundcolor=oShape.objects("ScConAlpPV").fillcolor
   else
   		oShape.objects("ScConAlpPV").styleclass="ScConAlpPV"    
   end if
   if err.number <>0 then window.external.LogMessage " CDA_RegCntl_Mode_EUDesc_OnUpdate ->" & oSource.id & " " & err.description 
end sub

'--------------------------------------
'Numeric Values
'--------------------------------------
sub CDA_Numeric_AlpPVFormat_OnUpdate(oSource)
   dim sFormat,oShape, nNumericFormat
   on error resume next
   set oShape=oSource.parentnode.parentnode
   if oShape.getcustomProperty("Parameter","cp_pvformat")<>"" then	
		nNumericFormat=oSource.Datavalue("tagname.cp_pvformat")  
   else
   		nNumericFormat=oShape.getcustomProperty("Text","cp_pvformat")
   end if
   if IsNumeric(nNumericFormat) and instr(nNumericFormat,".")=0 then
  		sFormat="%." & nNumericFormat & "f"
  		if typename(oshape.objects("ScConAlpPV"))<>"Nothing" then oShape.objects("ScConAlpPV").numericdisplayformat=sFormat
   else 
   		window.external.LogMessage "CDA_Numeric_AlpPVFormat_OnUpdate ->" & oSource.id & " " & "Invalid PV Format: " & nNumericFormat 
   end if
   if err.number<>0 then window.external.LogMessage " CDA_Numeric_AlpPVFormat_OnUpdate ->" & oSource.id & " " & err.description 
end sub

'--------------------------------------
'Graph objects
'--------------------------------------
sub CDA_ExecState_Alp_OnUpdate(oSource)
   dim oShape,oExStObj
   on error resume next
   set oShape=oSource.parentnode.parentnode
   set oExStObj=oShape.objects("LinExecState")
   if oSource.DataValue("tagname.cp_execstate")=1 then
      oExStObj.styleclass="LinExecState_OnScan_Active"
   else
	  oExStObj.styleclass="LinExecState_OffScan_InActive"
   end if
   if err.number<>0 then window.external.LogMessage " CDA_ExecState_Alp_OnUpdate ->" & oSource.id & " " & err.description    
end sub

'--------------------------------------
'Graph objects
'--------------------------------------
sub CDA_ExecState_1_Alp_OnUpdate(oSource)
   dim oShape,oExStObj
   on error resume next
   set oShape=oSource.parentnode.parentnode
   set oExStObj=oShape.objects("LinExecState")
   set oBad=oShape.objects("RecFrame")
   if oSource.value=1 then
      oExStObj.styleclass="LinExecState_OnScan_Active"
   else
	  oExStObj.styleclass="LinExecState_OffScan_InActive"
   end if
   if (oSource.quality and iQualityGood)<>iQualityGood then 
   		oBad.styleclass="RecPV_" & oShape.getcustomProperty("Style","cp_StyleForPVBad")
   else	
		oBad.styleclass="RecFrame" 
   end if
   if err.number<>0 then window.external.LogMessage " CDA_ExecState_1_Alp_OnUpdate ->" & oSource.id & " " & err.description    
end sub

'-------------------------------------------------------
'onOffValves
'-------------------------------------------------------
sub CDA_OnOffValves_AlpGPV_OnUpdate(oSource) 
   dim igPV,oShape,igOP,index,indexOP
   on error resume next
   set oShape=oSource.parentnode.parentnode
   igPV=oSource.value
   if (oSource.quality and iQualityGood)<>iQualityGood then igPV="Bad"
   index=oShape.getCustomProperty("Style","cp_styleForPV" & igPV)
   oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
   oShape.objects("PlgOut").styleclass="PlgOut_" & index 
   if cstr(igPV)="Bad" then 
   	  iBad="B" 
   elseif igPV=0 then 
      iBad="B"
   end if   
   blf=false
   if iBad="B" then
     oShape.objects("WdgC").styleclass = "WdgC_" & index
	 if typename(oShape.objects("WdgESD"))<>"Nothing" then oShape.objects("WdgESD").styleclass = "WdgESD_" & index
   else
     if oShape.getCustomProperty("Point","tagnameLF")<>"" then
		if oSource.datavalue("tagnameLF.cp_pvLF")=cint(oshape.getCustomProperty("Num","cp_LFActive")) then
		   bLF=true
		   if typename(oShape.objects("WdgESD"))<>"Nothing" then 
		   		oShape.objects("WdgESD").styleclass="WdgESD_" & oShape.getCustomProperty("Style","cp_styleForPV0")
		   		oShape.objects("WdgC").styleclass="WdgC_Regvalve"
		   elseif typename(oShape.objects("WdgC"))<>"Nothing" then 
		   		oShape.objects("WdgC").styleclass="WdgC_" & oShape.getCustomProperty("Style","cp_styleForPV0")	   
           end if
		end if   
	 end if 
	 if not bLF then 	       
	 	if oShape.getcustomproperty("Num","cp_ESDValue")<>"" then
		   iESDval=oShape.getcustomproperty("Num","cp_ESDValue")
		   sFState=oShape.getcustomproperty("Text","cp_FailState")		   		   
		   if oSource.datavalue("tagnameDO.cp_opDO")=cint(iESDval) then
			  if sFState="FC" then: iGOP=4 :else: iGOP=5: end if
		   else	 
		      if sFState="FC" then: iGOP=5 :else: iGOP=4: end if
		   end if		   
		   if typename(oShape.objects("WdgESD"))<>"Nothing" then 
		   	  oShape.objects("WdgESD").styleclass="WdgESD_" & oShape.getCustomProperty("Style","cp_styleForPV" & iGOP)
			  oShape.objects("WdgC").styleclass="WdgC_Regvalve"
		   elseif typename(oShape.objects("WdgC"))<>"Nothing" then 
		   	  oShape.objects("WdgC").styleclass="WdgC_" & oShape.getCustomProperty("Style","cp_styleForPV" & iGOP)	   
           end if 				 	   
	    end if	 
	 end if
   end if	 	 
   if err.number<>0 then window.external.LogMessage " CDA_OnOffValves_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description
end sub

sub CDA_OnOffValvesC_AlpGPV_OnUpdate(oSource)
   dim igPV,oShape,igOP,index,indexOP
   on error resume next
   set oShape=oSource.parentnode.parentnode
   if (oSource.quality and iQualityGood)<>iQualityGood then: igPV="Bad": else: igPV=oSource.value: end if 
   index=oShape.getCustomProperty("Style","cp_styleForPV" & igPV)
   oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
   oShape.objects("PlgOut").styleclass="PlgOut_" & index
   if cstr(igPV)="Bad" then 
   	  iBad="B" 
   elseif igPV=0 then 
      iBad="B"
   end if 
   if iBad="B" then 
        if typename(oShape.objects("WdgC")) <> "Nothing" then oShape.objects("WdgC").styleclass = "WdgC_" & index
   else	
   		if oShape.getcustomproperty("Parameter","cp_gop")<>"" then
   			igOP = oSource.datavalue("Tagname.cp_gop")
			indexOP = oShape.getCustomProperty("Style","cp_styleForPV" & igOP)
			if typename(oShape.objects("WdgC")) <> "Nothing" then oShape.objects("WdgC").styleclass = "WdgC_" & indexOP
        else
			oShape.objects("WdgC").styleclass = "WdgC_OnOffValve_OPNA"
   		end if
   end if
   if err.number<>0 then window.external.LogMessage " CDA_OnOffValvesC_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description
end sub

'-------------------------------------------------------
'MOV
'-------------------------------------------------------
sub CDA_MOV_AlpGPV_OnUpdate(oSource) 
   dim igPV,oShape,igOP,index,indexOP
   on error resume next
   set oShape=oSource.parentnode.parentnode
   igPV=oSource.value 
   if (oSource.quality and iQualityGood)<>iQualityGood then igPV="Bad"
   index=oShape.getCustomProperty("Style","cp_styleForPV" & igPV)
   oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
   oShape.objects("PlgOut").styleclass="PlgOut_" & index
   if cstr(igPV)="Bad" then 
   	  iBad="B" 
   elseif igPV=0 then 
      iBad="B"
   end if
   if iBad="B" then
       oShape.objects("WdgC").styleclass = "WdgC_" & index
       oShape.objects("PlgC").style.visibility = "hidden"
	   oShape.objects("PlgO").style.visibility = "hidden"
   else
   	   if oShape.getcustomProperty("Parameter","cp_ts")<>"" then
			iTorque=oSource.datavalue("tagname.cp_ts")
			sStyleTrq=oShape.getCustomProperty("Style","cp_styleForTorque" & iTorque)
			oShape.objects("WdgC").styleclass = "WdgC_" & sStyleTrq 
   	   else	
	        oShape.objects("WdgC").styleclass = "WdgC_MOV"
       end if
	   if oShape.getcustomproperty("Parameter","cp_gop")<>"" then
   		   igOP = oSource.datavalue("Tagname.cp_gop")
		   indexOP = oShape.getCustomProperty("Style","cp_styleForPV" & igOP)
           oShape.objects("PlgO").styleclass="PlgO_" & indexOP
		   oShape.objects("PlgC").styleclass="PlgC_" & indexOP
		   if index=IndexOP then
		       oShape.objects("PlgC").style.visibility = "hidden"
		       oShape.objects("PlgO").style.visibility = "hidden"
           end if
	   end if
   end if
   if err.number<>0 then window.external.LogMessage " CDA_MOV_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description
end sub

sub CDA_MOVInd_AlpPV_OnUpdate(oSource) 
   dim oShape,rVal
   on error resume next
   set oShape=oSource.parentnode.parentnode
   rVal=oSource.value
   if oShape.getcustomproperty("Parameter","cp_gpv")<>"" then rVal=oSource.datavalue("Tagname.cp_op")
'   if instr(ucase(rVal),"N")=0 then
'   		if rVal>100 then 
'      		rVal=100
'   		elseif rVal<0 then 
'      		rVal=0
'   		end if
'   end if 
   oShape.objects("TxtOP").innertext=round(rVal) & "%"	
   oShape.objects("TxtOP").styleclass="ConAlpOP"
   if (oSource.quality and iQualityBad)=iQualityBad and instr(rVal,"N")=0 then
      oShape.objects("TxtOP").styleclass="ConAlpOP_Bad"
   elseif (oSource.quality and iQualityBad)=iQualityBad or instr(rVal,"N")<>0 then
      oShape.objects("TxtOP").value="------"
      oShape.objects("TxtOP").textcolor=vbred
   end if
   if err.number<>0 then window.external.LogMessage " CDA_MOVInd_AlpPV_OnUpdate ->" & oSource.id & " " & err.description
end sub

'-------------------------------------------------------
'Regulatory Control Valves
'-------------------------------------------------------

sub CDA_RegCntlValve_AlpVal_OnUpdate(oSource)
   dim rVal,rClosed,oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   rVal=oSource.value
   rClosed=oShape.getcustomproperty("Num","ClosedValue")
   rOpen=oShape.getcustomproperty("Num","OpenValue")
   if rClosed<>"" then rClosed=csng(rClosed)
   if rOpen<>"" then rOpen=csng(rOpen)	
'   if rVal>100 then 
'      rVal=100
'   elseif rVal<0 then 
'      rVal=0
'   end if
   oShape.objects("TxtOP").innertext=round(rVal) & "%"	
   if rClosed<>"" and rOpen<>"" then	
   	if rVal > rClosed and rVal < rOpen then
      	index=oShape.getCustomProperty("Style","cp_styleForInbet" )	  
   	elseif rVal<=rClosed then	  
	  	index=oShape.getCustomProperty("Style","cp_styleForClose" )
   	else
	  	index=oShape.getCustomProperty("Style","cp_styleForOpen" ) 
   	end if
   end if

   if (oSource.quality and iQualityBad)=iQualityBad and instr(oSource.value,"N")=0 then
		index="RegValve_Bad"
		oShape.objects("TxtOP").styleclass="ConAlpOP_Bad"
		indWdgC=index	
   elseif (oSource.quality and iQualityGood)=iQualityGood and oSource.datavalue("tagname.cp_badctlfl")=1 then
		index="RegValve_BadPV"
		 if instr(ucase(oShape.getcustomproperty("parameter","cp_op")),"OP")=0 then
			oShape.objects("TxtOP").styleclass="ConAlpOP"
			oShape.objects("TxtOP").value="------"
			oShape.objects("TxtOP").textcolor=vbred
			indWdgC=index      
         else
			indWdgC=index   
		 end if	   
   elseif (oSource.quality and iQualityBad)=iQualityBad and instr(oSource.value,"N")<>0 then
		index="RegValve_Bad"
		if instr(ucase(oShape.getcustomproperty("parameter","cp_op")),"OP")=0 then
			oShape.objects("TxtOP").styleclass="ConAlpOP"
			oShape.objects("TxtOP").value="------"
			oShape.objects("TxtOP").textcolor=vbred
			indWdgC=index      
         else
			indWdgC=index   
		 end if
   else
   		oShape.objects("TxtOP").styleclass="ConAlpOP"
		indWdgC="RegValve"
   end if		
   if typename(oShape.objects("PlgIn"))<>"Nothing" then oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
   if typename(oShape.objects("PlgOut"))<>"Nothing" then oShape.objects("PlgOut").styleclass="PlgOut_" & index
   oShape.objects("WdgC").styleclass="WdgC_" & indWdgC 
   if oshape.getcustomproperty("parameter","cp_modeattr")<>"" then
      iMode=oSource.DataValue("tagname.cp_modeattr")
	  if iMode=1 then
	  	oShape.objects("TxtMode").innertext=left(oShape.getcustomproperty("Text","cp_mdattrtxt"),1)
	  else
	    oShape.objects("TxtMode").innertext=right(oShape.getcustomproperty("Text","cp_mdattrtxt"),1)
	  end if 	 	 
	  if instr(sMode,"#")<>0 then oShape.objects("TxtMode").innertext=""
	  if iMode=2 then
  			oShape.objects("TxtMode").styleclass="TxtMode_in_NMode"
  	  else 
   			oShape.objects("TxtMode").styleclass="TxtMode_not_in_NMode"
  	  end if
   end if
   if err.number<>0 then window.external.LogMessage " CDA_RegCntlValve_AlpVal_OnUpdate ->" & oSource.id & " " & err.description     
end sub


sub CDA_RegValves_AlpGPVGOP_OnUpdate(oSource) 
   dim igPV,oShape,igOP,index,indexOP
   on error resume next
   set oShape=oSource.parentnode.parentnode
   igPV=oSource.value
   sClosed=oShape.getcustomproperty("Num","ClosedValue")
   if sClosed<>"" then fClosed=csng(sClosed)
   sOpen=oShape.getcustomproperty("Num","OpenValue")
   if sOpen<>"" then fOpen=csng(sOpen)
   if sOpen<>"" and sClosed<>"" then
	   iOP=oSource.datavalue("tagname.cp_op") 
	   stxt4=oSource.datavalue("tagname.cp_text4")
	   stxt5=oSource.datavalue("tagname.cp_text5")	   
	   if instr(stxt4,"ДВИЖЕНИЕ")>0 and iGPV=4 then
	   		if iOP<=fClosed then iGPV=4 else igPV=1
       elseif instr(stxt5,"ДВИЖЕНИЕ")>0 and iGPV=5 then
			if iOP>=fOpen then iGPV=5 else igPV=1
       else
			igPV=oSource.value
       end if
   end if
   if (oSource.quality and iQualityGood)<>iQualityGood then igPV="Bad"
   index=oShape.getCustomProperty("Style","cp_styleForPV" & igPV)
   if typename(oShape.objects("PlgIn"))<>"Nothing" then oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
   if typename(oShape.objects("PlgOut"))<>"Nothing" then oShape.objects("PlgOut").styleclass="PlgOut_" & index 
   if cstr(igPV)="Bad" then 
   	  iBad="B" 
   elseif igPV=0 then 
      iBad="B"
   end if   
    if iBad="B" then
     if typename(oShape.objects("WdgC"))<>"Nothing" then oShape.objects("WdgC").styleclass = "WdgC_" & index
	 if typename(oShape.objects("WdgESD"))<>"Nothing" then oShape.objects("WdgESD").styleclass = "WdgESD_" & index
   else
     
	 if typename(oShape.objects("WdgESD"))<>"Nothing" then
	      if oShape.getcustomproperty("Parameter","cp_gop")<>"" then 
		  	  iGOP=oSource.datavalue("tagname.cp_gop")
          elseif oShape.getcustomproperty("Parameter","cp_sifl")<>"" then
		      iSIFL=oSource.datavalue("tagname.cp_sifl")
			  sFState=oShape.getCustomProperty("Text","cp_FailState")
			  if iSIFL=1 then
					  if sFState="FC" then: iGOP=4 :else: iGOP=5: end if
				   else	 
					  if sFState="FC" then: iGOP=5 :else: iGOP=4: end if
              end if 
		   end if
		   oShape.objects("WdgESD").styleclass="WdgESD_" & oShape.getCustomProperty("Style","cp_styleForPV" & iGOP)
		   if typename(oShape.objects("WdgC"))<>"Nothing" then oShape.objects("WdgC").styleclass="WdgC_Regvalve"				   
     end if 				 	   
   end if	 	 
   if err.number<>0 then window.external.LogMessage " CDA_RegValves_AlpGPVGOP_OnUpdate ->" & oSource.id & " " & err.description
end sub

sub CDA_Damper_AlpVal_OnUpdate(oSource)
   on error resume next   
   set oShape=oSource.parentnode.parentnode
   if instr(oShape.src,"poai")=0 then    
	   rVal=oSource.value
	   rClosed=oShape.getcustomproperty("Num","ClosedValue")
	   rOpen=oShape.getcustomproperty("Num","OpenValue")
	   if rClosed<>"" then rClosed=csng(rClosed)
	   if rOpen<>"" then rOpen=csng(rOpen)	
'	   if rVal>100 then 
'	      rVal=100
'	   elseif rVal<0 then 
'	      rVal=0
'	   end if
	   if rClosed<>"" and rOpen<>"" then	
		   	if rVal > rClosed and rVal < rOpen then
		      	index=oShape.getCustomProperty("Style","cp_styleForInbet" )	  
		   	elseif rVal<=rClosed then	  
			  	index=oShape.getCustomProperty("Style","cp_styleForClose" )
		   	else
			  	index=oShape.getCustomProperty("Style","cp_styleForOpen" ) 
		   	end if
	   end if
		if (oSource.quality and iQualityBad)=iQualityBad and instr(oSource.value,"N")=0 then
			index="RegValve_Bad"	
		elseif (oSource.quality and iQualityGood)=iQualityGood and oSource.datavalue("tagname.cp_badctlfl")=1 then
			index="RegValve_BadPV"
	    elseif (oSource.quality and iQualityBad)=iQualityBad and instr(oSource.value,"N")<>0 then
			index="RegValve_Bad"		
	    end if 
	   oShape.objects("PlgIn").styleclass="PlgIn_" & index
   else
   		rVal=oSource.datavalue("tagname.cp_op")	
'		if rVal>100 then 
'	      rVal=100
'	    elseif rVal<0 then 
'	      rVal=0
'	    end if
   end if
   rval=-round(rval)*0.9
   if rVal<-90 then 
      rVal=-90
    elseif rVal>0 then 
      rVal=0
    end if
   set oLinDamper=oShape.objects("LinDamper") 
   oLinDamper.style.visibility="hidden"
   oLinDamper.rotation=rval
   oLinDamper.style.visibility="inherit"
 end sub


'--------------------------------------------
' Pumps
'--------------------------------------------
sub CDA_PumpsM_AlpGPV_OnUpdate(oSource) 
   dim igPV,oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   if (oSource.quality and iQualityGood)<>iQualityGood then igPV="Bad": else: igPV=oSource.value	    
   if cstr(igPV)="Bad" then 
   	  iBad="B" 
   elseif igPV=0 and (instr(lcase(oShape.src),"cda_heater_din_h_pai_02_r300.sha")=0 _ 
      		and instr(lcase(oShape.src),"03_r300.sha")=0 _ 
			and instr(lcase(oShape.src),"04_r300.sha")=0) then 
      iBad="B"
   end if
   if oShape.getcustomproperty("parameter","cp_healthy")<>"" then 
        iHealthy=oSource.datavalue("tagname.cp_healthy")
   		if iHealthy = 1 then  
			iHealthy="PV" & igPV
            if iGPV=6 then iHealthy="PV5"
	    else 
			iHealthy="NotHealthy" 
		end if
   else
   		iHealthy="PV" & igPV	
   end if
   if iBad<>"B" and typename(oShape.objects("OvlBodyH")) <> "Nothing" then
        index=oShape.getCustomProperty("Style","cp_styleFor" & iHealthy)
		if iHealthy="NotHealthy" then: sName="OvlBodyH_": else: sName="OvlBody_": end if
		oShape.objects("OvlBodyH").styleclass=sName & index
   else
        index=oShape.getCustomProperty("Style","cp_styleForPV" & igPV) 
   	    oShape.objects("OvlBodyH").styleclass="OvlBodyH_" & index		   
   end if
   index=oShape.getCustomProperty("Style","cp_styleForPV" & igPV)
   if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
   if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
   if typename(oShape.objects("RecBody")) <> "Nothing" then oShape.objects("RecBody").styleclass="RecBody_" & index
   
   if oShape.getcustomproperty("Num","cp_speed")="2" and typename(oShape.objects("OvlBody")) <> "Nothing" then  
	   iSpeed=iGPV-4
	   if iSpeed>0 then
	        if iGPV=6 then iGPV=5  
            index=oShape.getCustomProperty("Style","cp_styleForPV" & igPV)
	        if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
            if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
            if typename(oShape.objects("RecBody")) <> "Nothing" then oShape.objects("RecBody").styleclass="RecBody_" & index
	   		oShape.objects("TxtM").value=iSpeed
	   else
	    	oShape.objects("TxtM").value="M"
	   end if
   elseif oShape.getcustomproperty("Num","cp_speed")="-" and typename(oShape.objects("OvlBody")) <> "Nothing" then 
		oShape.objects("TxtM").value=""
   end if

   if oShape.getcustomproperty("parameter","cp_dol")<>"" and typename(oShape.objects("OvlBody")) <> "Nothing" then  	
   		idol=oSource.datavalue("tagname.cp_dol")
		if iDol=1 then 
        	oShape.objects("TxtM").value=oShape.getcustomproperty("Text","cp_doltxt")
			oShape.objects("TxtM").styleclass="TxtMDOL"
		else
		    oShape.objects("TxtM").value="M"  
		    oShape.objects("TxtM").styleclass="TxtM"
        end if
   end if

   if oshape.getcustomproperty("parameter","cp_modeattr")<>"" then
      iMode=oSource.DataValue("tagname.cp_modeattr")
	  if iMode=1 then
	  	oShape.objects("TxtMode").innertext=left(oShape.getcustomproperty("Text","cp_mdattrtxt"),1)
	  else
	    oShape.objects("TxtMode").innertext=right(oShape.getcustomproperty("Text","cp_mdattrtxt"),1)
	  end if 	 	 
	  if instr(sMode,"#")<>0 then oShape.objects("TxtMode").innertext=""
   end if
   if oshape.getcustomproperty("parameter","cp_nmodeattr")<>"" then
      iNMode=oSource.DataValue("tagname.cp_nmodeattr")
	  if iMode=iNMode then
      	oShape.objects("TxtMode").styleclass="TxtMode_in_NMode"
      else 
      	oShape.objects("TxtMode").styleclass="TxtMode_not_in_NMode"
      end if 
   end if 
   if err.number<>0 then window.external.LogMessage " CDA_PumpsM_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

'--------------------------------------------
' Motors still not used
'--------------------------------------------
sub CDA_Motors_AlpGPV_OnUpdate(oSource) 
   dim igPV,oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   if (oSource.quality and iQualityGood)<>iQualityGood then igPV="Bad": else: igPV=oSource.value	    
   index=oShape.getCustomProperty("Style","cp_styleForPV" & igPV)
   if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
   if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
   if err.number<>0 then window.external.LogMessage " CDA_Motors_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

'---------------------------------------------------
'Digital States
'---------------------------------------------------
sub CDA_DigStateCColor_AlpPV_OnUpdate(oSource)
   dim oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   if (oSource.quality and iQualityGood)<>iQualityGood then iPV="Bad": else: iPV=oSource.value
   index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
   oShape.objects("RecPV").styleclass="RecPV_" & index	
   if err.number<>0 then window.external.LogMessage " CDA_DigStateCColor_AlpPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

sub CDA_DigState_AlpPV_OnUpdate(oSource)
   dim oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   iPV=oSource.breakpointvalueenum
   index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
   oShape.objects("ScConAlpPV").styleclass="ScConAlpPV_" & index
   if instr(oSource.value,"1.#QNAN")=0 and (oSource.quality and iQualityGood)<>iQualityGood then    
   		sBad=oShape.getcustomproperty("Style","cp_StyleForPVBad")
		oSource.styleclass="ScConAlpPV_" & sBad
		oSource.getstyleproperty("hw-fill-color")
		oSource.style.backgroundcolor=oSource.getstyleproperty("hw-fill-color")
		oSource.style.color=oSource.getstyleproperty("hw-text-color")
   else
   		oSource.styleclass=oShape.objects("ScConAlpPV").styleclass    
   end if
   if err.number<>0 then window.external.LogMessage " CDA_DigState_AlpPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

sub CDA_DigState4_AlpPV_OnUpdate(oSource)
   dim oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   iPV=0
   for i=0 to 3
   		if oSource.datavalue("tagname.flag_" & i & ".pvfl")=1 then
			iPV=i	
			exit for
		end if
   next   
   inNulls=0
   for i=0 to 3
   		if oSource.datavalue("tagname.flag_" & i & ".pvfl")=0 then
			inNulls=inNulls+1	
		end if
   next
   
   if inNulls=4 then 
   	oShape.objects("TxtPV").innertext=oShape.objects("TxtPV").innertext
   else
    oShape.objects("TxtPV").innertext=oSource.datavalue("tagname.flag_" & iPV & ".statetext[1]")
   end if
   index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
   oShape.objects("TxtPV").styleclass="ScConAlpPV_" & index
   if instr(oSource.value,"NAN")>0 or (oSource.quality and iQualityGood)<>iQualityGood then 
	   if instr(oSource.value,"N")>0 then 
	   		oShape.objects("txtPV").value="--------"
	   		oShape.objects("txtPV").textcolor=vbred
	   else
   	   		sBad=oShape.getcustomproperty("Style","cp_StyleForPVBad")
	   		oShape.objects("TxtPV").styleclass="ScConAlpPV_" & sBad    
	   end if 
   end if
   if err.number<>0 then window.external.LogMessage " CDA_DigState4_AlpPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

sub CDA_DigState5_AlpPV_OnUpdate(oSource,nSts)
   dim oShape, sName(7)
   on error resume next
   set oShape=oSource.parentnode.parentnode
   iPV=0
   for i=0 to nSts
   		sName(i)=oShape.getcustomproperty("Parameter","cp_name_flag" & i)
		sNm="tagname." & sName(i) & ".pvfl"
		if oSource.datavalue(sNm)=1 then
			iPV=i
			exit for	
		end if
   next   
   inNulls=0
   for i=0 to nSts
   		sName(i)=oShape.getcustomproperty("Parameter","cp_name_flag" & i)
		sNm="tagname." & sName(i) & ".pvfl"
   		if oSource.datavalue(sNm)=0 then
			inNulls=inNulls+1	
		end if
   next
   if inNulls=nSts+1 then 
   		oShape.objects("TxtPV").innertext=oShape.objects("TxtPV").innertext
   else
   		sNm=oShape.getcustomproperty("Parameter","cp_name_flag" & iPV)
   		sNm="tagname." & sNm & ".statetext[1]"
    	oShape.objects("TxtPV").innertext=oSource.datavalue(sNm)
   end if
   index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
   oShape.objects("TxtPV").styleclass="ScConAlpPV_" & index
   if instr(oSource.value,"NAN")>0 or (oSource.quality and iQualityGood)<>iQualityGood then 
	   if instr(oSource.value,"N")>0 then 
	   		oShape.objects("txtPV").value="--------"
	   		oShape.objects("txtPV").textcolor=vbred
	   else
   	   		sBad=oShape.getcustomproperty("Style","cp_StyleForPVBad")
	   		oShape.objects("TxtPV").styleclass="ScConAlpPV_" & sBad    
	   end if 
   end if
   if err.number<>0 then window.external.LogMessage " CDA_DigState4_AlpPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

'---------------------------------------------------
'SCMs
'---------------------------------------------------

sub Scm_Alp_OnUpdate(oSource)
	dim hnd, stp, state,p
	on error resume next
	strip=1
	set oShape=oSource.parentnode.parentnode
	if strip=1 then
   		hnd=oSource.datavalue("tagname.cp_handler")
   		p=instrrev(hnd,".")
   		hnd=mid(hnd,p+1,len(hnd)-p)
   		oShape.objects("TxtHandler").innertext=hnd
	elseif strip=2 then
		hnd=oSource.datavalue("tagname.cp_handler")
   		p=instrrev(hnd,".")
   		hndh=mid(hnd,p+1,len(hnd)-p)
   		hndn=left(hnd,p)
   		oShape.objects("TxtHandler").innertext=hndn & vbCRLF & hndh
	else
   		oShape.objects("TxtHandler").innertext=oSource.datavalue("tagname.cp_handler")
	end if
	stp=oSource.datavalue("tagname.cp_step")
	p=instrrev(stp,".")
	stp=mid(stp,p+1,len(stp)-p)
	oShape.objects("TxtStep").innertext=stp	
	state=oSource.datavalue("tagname.cp_state")
	select case state
		case 0  oShape.objects("TxtState").value="Loading"
        		oShape.objects("ScConAlpPV").style.visibility="inherit"
		case 1  oShape.objects("TxtState").value="LOADED"
		case 2  oShape.objects("TxtState").value="INACTIVE"        
		case 3  oShape.objects("TxtState").value="VALIDATED"
		case 4  oShape.objects("TxtState").value="RUNNING"
        		oShape.objects("ScConAlpPV").style.visibility="inherit"
		case 5  oShape.objects("TxtState").value="COMPLETE"
		case 6  oShape.objects("TxtState").value="CHECKING"
        		oShape.objects("ScConAlpPV").style.visibility="inherit"
		case 7  oShape.objects("TxtState").value="IDLE"      
		case 8  oShape.objects("TxtState").value="INTERRUPTING"
        		oShape.objects("ScConAlpPV").style.visibility="inherit"
		case 9  oShape.objects("TxtState").value="INTERRUPTED"
		case 10 oShape.objects("TxtState").value="RESTARTING"
        		oShape.objects("ScConAlpPV").style.visibility="inherit"
		case 11 oShape.objects("TxtState").value="RESTARTED"
		case 12 oShape.objects("TxtState").value="HOLDING"
        		oShape.objects("ScConAlpPV").style.visibility="inherit"
		case 13 oShape.objects("TxtState").value="HELD"
		case 14 oShape.objects("TxtState").value="STOPPING"
        		oShape.objects("ScConAlpPV").style.visibility="inherit"
		case 15 oShape.objects("TxtState").value="STOPPED"
		case 16 oShape.objects("TxtState").value="ABORTING"
        		oShape.objects("ScConAlpPV").style.visibility="inherit"
		case 17 oShape.objects("TxtState").value="ABORTED"
		case 18 oShape.objects("TxtState").value="COMERR"
	end select
	iPer=oSource.datavalue("tagname.period")
	select case iPer
		case 0 iPeriod=1
		case 1 iPeriod=0.005
		case 2 iPeriod=0.01
		case 3 iPeriod=0.02
		case 4 iPeriod=0.05
		case 5 iPeriod=0.1
		case 6 iPeriod=0.2
		case 7 iPeriod=0.5
		case 8 iPeriod=1
		case 9 iPeriod=2
	end select
	if (oSource.quality and iQualityGood)<>iQualityGood then
		oShape.objects("TxtState").value=""
		oShape.objects("TxtHandler").value=""
		oShape.objects("TxtStep").value=""		
    else
		oSource.innertext=oSource.value*iPeriod
	end if   
end sub

sub Scm_Step_Alp_OnUpdate(oSource)
	on error resume next
	set oShape=oSource.parentnode.parentnode
	sName=oShape.getcustomproperty("Parameter","cp_StepName")
	if sName<>"" then
		iPer=oSource.datavalue("tagname.period")
		select case iPer
			case 0 iPeriod=1
			case 1 iPeriod=0.005
			case 2 iPeriod=0.01
			case 3 iPeriod=0.02
			case 4 iPeriod=0.05
			case 5 iPeriod=0.1
			case 6 iPeriod=0.2
			case 7 iPeriod=0.5
			case 8 iPeriod=1
			case 9 iPeriod=2
		end select
		sTime="tagname." & sName & ".time"
	    oShape.objects("txtTime").value=oSource.datavalue(sTime)*iPeriod & " s"
		set oFrm=oShape.objects("RecFrame")
		oFrm.styleclass="RecFrame"
		sProcessed="tagname." & sName & ".processed"
		iProcessed=oSource.datavalue(sProcessed)
		if iProcessed=1 then oFrm.styleclass="RecFrame_" & oShape.getcustomproperty("Style","cp_StyleForStepProcessed")
	    sActive="tagname." & sName & ".ActiveFL"
		iActive=oSource.datavalue(sActive)
		if iActive=1 then oFrm.styleclass="RecFrame_" & oShape.getcustomproperty("Style","cp_StyleForStepActive")
		sFail="tagname." & sName & ".Execsts"
		iFail=oSource.datavalue(sFail)
		if iFail<>0 then oFrm.styleclass="RecFrame_" & oShape.getcustomproperty("Style","cp_StyleForStepFail")
	else
		sName=oShape.getcustomproperty("Parameter","cp_TrnsName")
		if sName<>"" then
			set oFrm=oShape.objects("RecFrame")
			oFrm.styleclass="RecFrame"
			sON="tagname." & sName & ".SO"
			iON=oSource.datavalue(sON)
			if iON=1 then oFrm.styleclass="RecFrame_" & oShape.getcustomproperty("Style","cp_StyleForTrnsON")
			sFail="tagname." & sName & ".Execsts"
			iFail=oSource.datavalue(sFail)
			if iFail<>0 then oFrm.styleclass="RecFrame_" & oShape.getcustomproperty("Style","cp_StyleForStepFail")		
		end if	
    end if 
end sub

sub CDA_PsaTimer_AlpPV_OnUpdate(oSource)
   dim oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   iPvFormat=cint(oShape.getcustomproperty("text","cp_pvformat"))
   iPV=oSource.value
   set oTxtPV=oShape.objects("TxtPV")
   if not isNAN(oSource.value) then oTxtPV.value=formatnumber(iPV/10,iPvFormat)
   oTxtPV.styleclass="ScConAlpPV"
   if instr(oSource.value,"NaN")=0 and (oSource.quality and iQualityGood)<>iQualityGood then    
		oTxtPV.textcolor="#DDDDDD"
		oTxtPV.fillcolor=vbBlack
   elseif instr(oSource.value,"NaN")>0 then
    	oTxtPV.styleclass="ScConAlpPV"
		oTxtPV.textcolor=vbred
		oTxtPV.value="--------"    
   end if
   if err.number<>0 then window.external.LogMessage " CDA_PsaTimer_AlpPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub]]></script><script event="" language="VBScript" id="5BF1BCCD-D7D8-4739-ACC6-6EF453A031A7"><![CDATA[Dim iBit0, iBit1, iBit2, iBit3, iBit4, iBit5, iBit6, iBit7, iBit8, iBit9, iBit10, iBit11, iBit12, iBit13, iBit14, iBit15, iBit16

	iBit15=32768: iBit14=16384: iBit13=8192: iBit12=4096: iBit11=2048: iBit10=1024: iBit9=512: iBit8=256
	iBit7=128: iBit6=64: Bit5=32: iBit4=16: iBit3=8: iBit2=4: iBit1=2: iBit0=1


'MOS and OOS shapes in process displays
'***********************************************************************************************************************************************


sub Scd_MOS_OOS_OnUpdate(oSource)
	dim oShape, iPV
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iValueON = csng(oShape.getcustomproperty("Num","cp_ONValue"))
    iPV=100
	if instr(oShape.src,"_02_")>0 then 	
    	iPV2=oSource.datavalue("Tagname2.cp_pv")
	    if iPV2 = iValueON then: iPV = 1: else: iPV = 0: end if
		if (oSource.dataquality("Tagname2.cp_pv") and iQualityGood)<>iQualityGood then iPV = 2
	end if  
    if iPV=100 or iPV=0 then
		if oSource.value = iValueON then: iPV = 1: else: iPV = 0: end if
		if (oSource.quality and iQualityGood)<>iQualityGood then iPV = 2
	end if
	if oShape.getcustomproperty("parameter","cp_mode")<>"" then
		iMode=oSource.datavalue("tagname.cp_mode")
		if iMode=1 and iPV<>2 then oShape.objects("RecMode").style.visibility="inherit" else oShape.objects("RecMode").style.visibility="hidden"	
	end if
	index = oShape.getcustomproperty("Style","cp_Style" & iPV)
	if typename(oShape.objects("TxtMOS"))<>"Nothing" then oShape.objects("TxtMOS").styleclass = "TxtMOS_" & index
	if typename(oShape.objects("TxtOOS"))<>"Nothing" then oShape.objects("TxtOOS").styleclass = "TxtOOS_" & index
	if err.number<>0 then window.external.LogMessage "Scd_MOS_OOS_AlpPV_OnUpdate ->" & oSource.id & " " & err.description       			
end sub

'--------------------------------------------
' Pumps
'--------------------------------------------
sub Scd_PumpsM_AlpGPV_OnUpdate(oSource) 
   dim iPV,oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   if (oSource.quality and iQualityOffScan)=iQualityOffScan then 
   		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
		index=oShape.getCustomProperty("Style","cp_styleForPV0")
   		if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
   		if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
   		if typename(oShape.objects("RecBody")) <> "Nothing" then oShape.objects("RecBody").styleclass="RecBody_" & index 
		if typename(oShape.objects("OvlBodyH")) <> "Nothing" then oShape.objects("OvlBodyH").styleclass=oShape.objects("OvlBody").styleclass 
   elseif (oSource.quality and iQualityGood)=iQualityGood then 
   		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
   		iPV=oSource.value	    
   		index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
   		if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
   		if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
   		if typename(oShape.objects("RecBody")) <> "Nothing" then oShape.objects("RecBody").styleclass="RecBody_" & index
		ibadstate=oShape.getcustomproperty("Parameter","cp_badstate"):if ibadstate="" then ibadstate=0
		ibad=ibadstate 
   		if oShape.getcustomproperty("Point","TagnameBAD")<>"" then 
        	ibad=oSource.datavalue("tagnameBAD.cp_pvbad")
   			if cint(ibad)=cint(ibadstate) and typename(oShape.objects("OvlBodyH")) <> "Nothing" then
				oShape.objects("OvlBodyH").styleclass="OvlBodyH_" & oShape.getCustomProperty("Style","cp_styleForFault")
            else
				oShape.objects("OvlBodyH").styleclass=oShape.objects("OvlBody").styleclass
			end if
   		end if
   else
        index=oShape.getCustomProperty("Style","cp_styleForBAD")
   		if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
   		if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
   		if typename(oShape.objects("RecBody")) <> "Nothing" then oShape.objects("RecBody").styleclass="RecBody_" & index 
		if typename(oShape.objects("OvlBodyH")) <> "Nothing" then oShape.objects("OvlBodyH").styleclass=oShape.objects("OvlBody").styleclass
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active" 
   end if
   if err.number<>0 then window.external.LogMessage " CDA_PumpsM_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

sub Scd_PumpsM1_AlpGPV_OnUpdate(oSource) 
   dim iPV,oShape
   on error resume next
   set oShape=oSource.parentnode.parentnode
   if (oSource.quality and iQualityOffScan)=iQualityOffScan then 
   		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
		index=oShape.getCustomProperty("Style","cp_styleForPV0")
   		if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
   		if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
   		if typename(oShape.objects("RecBody")) <> "Nothing" then oShape.objects("RecBody").styleclass="RecBody_" & index 
		if typename(oShape.objects("OvlBodyH")) <> "Nothing" then oShape.objects("OvlBodyH").styleclass=oShape.objects("OvlBody").styleclass 
   elseif (oSource.quality and iQualityGood)=iQualityGood then 
   		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
   		iPV=oSource.value	    
   		index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
   		if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
   		if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
   		if typename(oShape.objects("RecBody")) <> "Nothing" then oShape.objects("RecBody").styleclass="RecBody_" & index
   		if typename(oShape.objects("OvlBodyH")) <> "Nothing" then oShape.objects("OvlBodyH").styleclass=oShape.objects("OvlBody").styleclass
		if oShape.getcustomproperty("Point","TagnameRTS")<>"" then 
        	iRTS=oSource.datavalue("tagnameRTS.cp_pv")
   			if iRTS=0 then oShape.objects("OvlBodyH").styleclass="OvlBodyH_" & oShape.getCustomProperty("Style","cp_StyleForNotHealthy")
   		end if
   else
        index=oShape.getCustomProperty("Style","cp_styleForBAD")
   		if typename(oShape.objects("OvlBody")) <> "Nothing" then oShape.objects("OvlBody").styleclass="OvlBody_" & index	   
   		if typename(oShape.objects("PlgBody")) <> "Nothing" then oShape.objects("PlgBody").styleclass="PlgBody_" & index
   		if typename(oShape.objects("RecBody")) <> "Nothing" then oShape.objects("RecBody").styleclass="RecBody_" & index 
		if typename(oShape.objects("OvlBodyH")) <> "Nothing" then oShape.objects("OvlBodyH").styleclass=oShape.objects("OvlBody").styleclass
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active" 
   end if
   
   if oshape.getcustomproperty("parameter","cp_mode")<>"" then
      iMode=oSource.DataValue("tagname.cp_mode")
	  if iMode=0 then
	  	oShape.objects("TxtMode").innertext=left(oShape.getcustomproperty("Text","cp_mdtxt"),1)
	  else
	    oShape.objects("TxtMode").innertext=right(oShape.getcustomproperty("Text","cp_mdtxt"),1)
	  end if 	 	 
	  if instr(sMode,"#")<>0 then oShape.objects("TxtMode").innertext=""
   end if
   if oshape.getcustomproperty("parameter","cp_nmode")<>"" then
      iNMode=oSource.DataValue("tagname.cp_nmode")
	  if iMode=iNMode then
      	oShape.objects("TxtMode").styleclass="TxtMode_in_NMode"
      else 
      	oShape.objects("TxtMode").styleclass="TxtMode_not_in_NMode"
      end if 
   end if
   if err.number<>0 then window.external.LogMessage " CDA_PumpsM1_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description    
end sub

'------------------------------------------
'Digital States
'------------------------------------------
sub Scd_DigStateOnScanQual(oSource) 
	dim oShape
	on error resume next
	set oShape=oSource.parentnode.parentnode
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif (oSource.quality and iQualityGood)<>iQualityGood then
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		oShape.objects("RecFrame").styleclass="RecPV_" & oShape.getCustomProperty("Style","cp_StyleForPVBad")
	else
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		oShape.objects("RecFrame").styleclass="RecFrame"
	end if
	if err.number<>0 then window.external.LogMessage "Scd_DigStateOnScanQual ->" & oSource.id & " " & err.description       
end sub

Sub Scd_DigStateCText_AlpPV_OnUpdate(oSource)
	dim oShape,oPVObj
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iBadStatePV=oShape.getcustomproperty("Parameter","cp_badstate")
	if iBadStatePV="" then iBadStatePV=oShape.getcustomproperty("Num","cp_badstate")
	iBad=100
	if oshape.getcustomproperty("Point","TagnameBAD")<>"" then iBad=oSource.datavalue("tagnameBAD.cp_pvbad") 
	set oPVObj=oShape.objects("TxtPV")	
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
  		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
  		oPVObj.innertext=oShape.GetCustomProperty("Text","cp_TextForPV" &  cstr(oSource.value))
  		oPVObj.styleclass="ScConAlpPV_" & oShape.GetCustomProperty("Style","cp_StyleForPV" &  cstr(oSource.value))
	elseif (oSource.quality and iQualityBadComm)=iQualityBadComm then 
  		oPVObj.styleclass="ScConAlpPV_Bad"
  		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		oPVObj.innertext=oShape.GetCustomProperty("Text","cp_TextForPV" &  cstr(oSource.value))
    elseif cint(ibad)=cint(iBadStatePV) then
        oPVObj.styleclass="ScConAlpPV_Bad_LG"
        oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active" 
	    oPVObj.innertext=oShape.GetCustomProperty("Text","cp_TextForPV" &  cstr(oSource.value)) 
	else
  		oPVObj.innertext=oShape.GetCustomProperty("Text","cp_TextForPV" &  cstr(oSource.value))
  		oPVObj.styleclass="ScConAlpPV_" & oShape.GetCustomProperty("Style","cp_StyleForPV" &  cstr(oSource.value))
  		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if
	if err.number<>0 then window.external.LogMessage "Scd_DigStateCText_AlpPV_OnUpdate ->" & oSource.id & " " & err.description 
end sub

Sub Scd_DigStateCColor_AlpPV_OnUpdate(oSource)
	dim oShape
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iPV=oSource.value
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
	oShape.objects("RecPV").styleclass="RecPV_" & index
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
  		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
  	elseif (oSource.quality and iQualityGood)<>iQualityGood then
  		sBad=oShape.getcustomproperty("Style","cp_StyleForPVBad")
		oShape.objects("RecPV").styleclass="RecPV_" & sBad
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
    else
   		oSource.styleclass=oShape.objects("ScConAlpPV").styleclass    
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
    end if
	if err.number<>0 then window.external.LogMessage "Scd_DigStateCColor_AlpPV_OnUpdate ->" & oSource.id & " " & err.description       
end sub

Sub Scd_DigStateCColorSPM_AlpPV_OnUpdate(oSource)
	dim oShape
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iSysState=oShape.getcustomproperty("Parameter","cp_sysstate"):if iSysState="" then iSysState=0 		
    iBMSState=oShape.getcustomproperty("Parameter","cp_bmsstate"):if iBMSState="" then iBMSState=0		
    iChnState=oShape.getcustomproperty("Parameter","cp_chnstate"):if iChnState="" then iChnState=0	
	iSYS=iSysState
	sysUnack=false
	if oshape.getcustomproperty("Point","TagnameSYS")<>"" then 
		iSYS=oSource.datavalue("tagnameSYS.cp_pvsys")  
		sysUnack=(oSource.dataalarm("tagnameSYS.cp_pvsys") and 1024)=1024
    end if 
	iBMS=iBMSState
    bmsUnack=false 
	if oshape.getcustomproperty("Point","TagnameBMS")<>"" then 
		iBMS=oSource.datavalue("tagnameBMS.cp_pvbms")
		bmsUnack=(oSource.dataalarm("tagnameBMS.cp_pvbms") and 1024)=1024
    end if 
	iChn=iChnState
    chnUnack=false 
	if oshape.getcustomproperty("Point","TagnameCHN")<>"" then 
		iChn=oSource.datavalue("tagnameCHN.cp_pvchn")
		chnUnack=(oSource.dataalarm("tagnameCHN.cp_pvchn") and 1024)=1024
    end if
    iPV=oSource.value

    if oShape.getCustomProperty("Num","cp_bit")<>"" then 
			nBit=cint(oShape.getCustomProperty("Parameter","cp_bit"))
			s="(iPV and iBit" & nbit & ")/iBit" & nbit
			iPV=eval(s)
	end if		 

    iPVUnack=(oSource.alarm and 1024)=1024 
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
	oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
    oShape.objects("RecPV").styleclass="RecPV_" & index
	oShape.objects("RecPV").fillcolorblink=false
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
  		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
    elseif (oSource.quality and iQualityBadComm)=iQualityBadComm then
  		sBad=oShape.getcustomproperty("Style","cp_StyleForPVBad")
		oShape.objects("RecPV").styleclass="RecPV_" & sBad
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
    elseif cint(iSysState)<>cint(iSYS) then
		oShape.objects("RecPV").styleclass="RecPV_" & oShape.getCustomProperty("Style","cp_styleForSysPV" & iSys)
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"  
    elseif cint(iBMSState)<>cint(iBMS) then
		oShape.objects("RecPV").styleclass="RecPV_" & oShape.getCustomProperty("Style","cp_styleForBMSPV" & iBMS)
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
    elseif cint(iChnState)<>cint(iChn) then
		oShape.objects("RecPV").styleclass="RecPV_" & oShape.getCustomProperty("Style","cp_styleForChnPV" & iChn)
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if
    if iPVUnack=true or sysUnack=true or bmsUnack=true or chnUnack=true then 
		oShape.objects("RecPV").fillcolorblink=true
    end if 
	if err.number<>0 then window.external.LogMessage "Scd_DigStateCColorSPM_AlpPV_OnUpdate ->" & oSource.id & " " & err.description       
end sub

Sub Scd_DigState_AlpPV_OnUpdate(oSource)	
	dim oShape
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iBad=100
	if oshape.getcustomproperty("Point","TagnameBAD")<>"" then iBad=oSource.datavalue("tagnameBAD.cp_pvbad")
	iBadStatePV=oShape.getcustomproperty("Num","cp_badstate")
	if oShape.getcustomproperty("Parameter","cp_File")="" then
		iPV=oSource.breakpointvalueenum
		index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
		oShape.objects("ScConAlpPV").styleclass="ScConAlpPV_" & index
    else
		oSource.styleclass="ScConAlpPV" 
	end if	 
	if instr(oSource.value,"1.#QNAN")=0 and (oSource.quality and iQualityGood)<>iQualityGood or cint(ibad)=cint(iBadStatePV) then
	  if (oSource.quality and iQualityOffScan)<>iQualityOffScan or cint(ibad)=cint(iBadStatePV) then   
   			sBad=oShape.getcustomproperty("Style","cp_StyleForPVBad")
			oSource.styleclass="ScConAlpPV_" & sBad
			oSource.getstyleproperty("hw-fill-color")
			oSource.style.backgroundcolor=oSource.getstyleproperty("hw-fill-color")
			oSource.style.color=oSource.getstyleproperty("hw-text-color")
      end if 
    end if	
	if instr(oShape.src,"PU_")>0 then oShape.objects("TxtName").value=oSource.datavalue("tagname.name")
    if err.number<>0 then window.external.LogMessage " Scd_DigState_AlpPV_OnUpdate ->" & oSource.id & " " & err.description       
end sub

sub Scd_Burner_AlpPV_OnUpdate(oSource)
	dim oShape
	on error resume next
	set oShape=oSource.parentnode.parentnode
	if ((oSource.quality and iQualityOffScan)=iQualityOffScan) or ((oSource.dataquality("TagnameB.cp_pv") and iQualityOffScan)=iQualityOffScan) then 
	   oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
       iPV="0"
	elseif ((oSource.quality and iQualityGood)<>iQualityGood) or ((oSource.dataquality("TagnameB.cp_pv") and iQualityGood)<>iQualityGood) then
	   oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	   iPV="Bad"	
	else   
	   oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	   iPVm=oSource.value
	   iPVb=oSource.datavalue("TagnameB.cp_pv")
	   iPV=cstr(iPVm*2+iPVb)
	end if
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV) 
	oShape.objects("RecBrnrPV").styleclass="RecBrnrPV_" & index
	if err.number<>0 then window.external.LogMessage " Scd_Burner_AlpPV_OnUpdate ->" & oSource.id & " " & err.description           	
end sub

sub Scd_BrnrCTxt_AlpOnupdate(oSource)
	dim oShape
	on error resume next
	set oShape=oSource.parentnode.parentnode
    iPV=cstr(oSource.value)
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif (oSource.quality and iQualityGood)<>iQualityGood then
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		iPV="Bad"
	end if
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
	oShape.objects("RecFrame").styleclass="RecFrame_" & index
	oShape.objects("TxtCtext").styleclass="TxtCtext_" & index
	if err.number<>0 then window.external.LogMessage " Scd_BrnrCTxt_AlpOnupdate(oSource) ->" & oSource.id & " " & err.description           	
end sub


'--------------------------------------
'Numeric Values
'--------------------------------------
sub Scd_Numeric_AlpPVFormat_OnUpdate(oSource)
	dim sFormat,oShape, nNumericFormat
	on error resume next
	set oShape=oSource.parentnode.parentnode
	nNumericFormat = oshape.getcustomproperty("Text","cp_PVFormat")
	if isnumeric(trim(nNumericFormat)) then
		sFormat="%." & trim(nNumericFormat) & "f"
		if typename(oshape.objects("ScConAlpPV"))<>"Nothing" then oShape.objects("ScConAlpPV").numericdisplayformat=sFormat
		if typename(oshape.objects("ConAlpSP"))<>"Nothing" then oShape.objects("ConAlpSP").numericdisplayformat=sFormat
	else
		window.external.LogMessage "Scd_Numeric_AlpPVFormat_OnUpdate ->" & oSource.id & " " & "Invalid PV Format: " & nNumericFormat
	end if
    iBadStatePV=oShape.getcustomproperty("Parameter","cp_badstate")
	iBad=100
	if oShape.getcustomproperty("Point","tagnameBAD")<>"" then iBad=oSource.datavalue("TagnameBad.cp_pvBad")

   	if (oSource.quality and iQualityOffscan)=iQualityOffscan then
   	elseif (oSource.quality and iQualityBadComm)=iQualityBadComm then
		oSource.styleclass="ScConAlpPV_Bad"
		oSource.style.backgroundcolor=oSource.fillcolor
    elseif cint(ibad)=cint(iBadStatePV)  then
	 	if instr(ucase(oShape.src),"PU")>0 then
			oSource.styleclass="ScConAlpPV"
			oSource.textcolor=vbred
			oSource.innertext="--------"
		else
			oSource.styleclass="ScConAlpPV_Bad_LG"
        end if
	else
	    oShape.objects("ScConAlpPV").styleclass="ScConAlpPV"
    end if
	if (oSource.quality and iQualityOffscan)<>iQualityOffscan then
	   oSource.style.backgroundcolor=oSource.fillcolor
       oSource.style.color=oSource.textcolor
    end if
	if oShape.getcustomproperty("Text","cp_TagnameEU")="" then oShape.objects("TxtEUDesc").innertext = oSource.DataValue("tagname.cp_eudesc")
    if oSource.dataexists("tagname.name") then oShape.objects("TxtName").value=oSource.datavalue("tagname.name")
	if err.number<>0 then window.external.LogMessage "Scd_Numeric_AlpPVFormat_OnUpdate ->" & oSource.id & " " & err.description
end sub

'*******************************************************************************************************************************
sub Scd_Numeric_AlpPVFormatTGS_OnUpdate(oSource)
	dim sFormat,oShape, nNumericFormat
	on error resume next
	set oShape=oSource.parentnode.parentnode
	nNumericFormat = oshape.getcustomproperty("Text","cp_PVFormat")  
	if isnumeric(trim(nNumericFormat)) then
		sFormat="%." & trim(nNumericFormat) & "f"
		if typename(oshape.objects("ScConAlpPV"))<>"Nothing" then oShape.objects("ScConAlpPV").numericdisplayformat=sFormat
		if typename(oshape.objects("ConAlpSP"))<>"Nothing" then oShape.objects("ConAlpSP").numericdisplayformat=sFormat
	else
		window.external.LogMessage "Scd_Numeric_AlpPVFormat_OnUpdate ->" & oSource.id & " " & "Invalid PV Format: " & nNumericFormat 
	end if
 
	iCIUState=oShape.getcustomproperty("Parameter","cp_ciustate"):if iCIUState="" then iCIUState=0 		
    iTNKState=oShape.getcustomproperty("Parameter","cp_tnkstate"):if iTNKState="" then iTNKState=0		
    iChnState=oShape.getcustomproperty("Parameter","cp_chnstate"):if iChnState="" then iChnState=0	
	iTXState=oShape.getcustomproperty("Parameter","cp_txstate"):if iTXState="" then iTXState=0	

	iCIU=iCIUState:	if oshape.getcustomproperty("Point","TagnameCIU")<>"" then iCIU=oSource.datavalue("tagnameCIU.cp_pvciu")  
	iTNK=iTNKState:	if oshape.getcustomproperty("Point","TagnameTank")<>"" then iTNK=oSource.datavalue("tagnametank.cp_pvtank")
	iChn=iChnState:	if oshape.getcustomproperty("Point","TagnameBAD")<>"" then 	iChn=oSource.datavalue("tagnameBAD.cp_pvbad")
	iTX=iTXState:	if oshape.getcustomproperty("Point","TagnameCHN")<>"" then 	iTX=oSource.datavalue("tagnameCHN.cp_pvchn")

    if (oSource.quality and iQualityBadComm)=iQualityBadComm then 
		oSource.styleclass="ScConAlpPV_Bad"
		oSource.style.backgroundcolor=oSource.fillcolor 
		oSource.style.color=oSource.textcolor 
    elseif cint(iCIUState)<>cint(iCIU) then
		oSource.styleclass="ScConAlpPV_" & oShape.getCustomProperty("Style","cp_styleForCIUPV" & iCIU)
    elseif cint(iTNKState)<>cint(iTNK) then
		oSource.styleclass="ScConAlpPV_" & oShape.getCustomProperty("Style","cp_styleForTNKPV" & iTNK)
    elseif cint(iTXState)<>cint(iTX) then
		oSource.styleclass="ScConAlpPV_" & oShape.getCustomProperty("Style","cp_styleForTXPV" & iTX)
    elseif cint(iChnState)<>cint(iChn) then
		oSource.styleclass="ScConAlpPV_" & oShape.getCustomProperty("Style","cp_styleForChnPV" & iChn)
    else 
	    oSource.styleclass="ScConAlpPV"
	end if 
	if oShape.getcustomproperty("Text","cp_TagnameEU")="" then oShape.objects("TxtEUDesc").innertext = oSource.DataValue("tagname.cp_eudesc")
    if oSource.dataexists("tagname.name") then oShape.objects("TxtName").value=oSource.datavalue("tagname.name")
	if err.number<>0 then window.external.LogMessage "Scd_Numeric_AlpPVFormatTGS_OnUpdate ->" & oSource.id & " " & err.description 
end sub


'----------------------------------------
'Deviation Alarm
'----------------------------------------
sub Scd_Dev_Alarm_Icon(oSource,iTagN)
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iDev=0
	iAllUnack=0
	for i=1 to iTagN
		iDev=iDev+oSource.datavalue ("AlmTag" & i & ".cp_DevL" & i)
		iDev=iDev+oSource.datavalue ("AlmTag" & i & ".cp_DevH" & i)
		iUnack=oSource.dataAlarm ("AlmTag" & i & ".cp_DevL" & i)
		if (iUnack and 1024)=1024 then iAllUnack=iAllUnack+1
	next
	if iDev>0 then 
		oShape.objects("AlarmState").priority=1	  
		if iAllUnack>0 then
		    oShape.objects("AlarmState").Acknowledged=0
        else
			oShape.objects("AlarmState").Acknowledged=1 
        end if
     else
		oShape.objects("AlarmState").priority=0
	 end if
	 if err.number<>0 then window.external.LogMessage "Scd_Dev_Alarm_Icon ->" & oSource.id & " " & err.description
end sub

'----------------------------------------
'Cause and Effect
'----------------------------------------

sub Scd_CEXXX_Click
    dim oShape
	set oShape=document.getelementbyid(page.getattribute("ESD_matrix"))
	oShape.objects("RecTarg").click
	if err.number<>0 then window.external.LogMessage "Scd_CEXXX_Click ->" & oShape.id & " " & err.description       
end sub


Sub Scd_CEXXX_AlpPV_OnUpdate(oSource)
	dim oShape
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iPV=oSource.value
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
	  		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	else
	  		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	  		if (oSource.quality and iQualityGood)<>iQualityGood then iPV=2	
    end if
	if oShape.getcustomproperty("parameter","cp_mode")<>"" then
		iMode=oSource.datavalue("tagname.cp_mode")
		if iMode=1 and iPV<>2 then oShape.objects("RecMode").style.visibility="inherit" else oShape.objects("RecMode").style.visibility="hidden"	
	end if
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
	oShape.objects("RecPV").styleclass="RecPV_" & index
	if instr(lcase(oShape.src),"scd_cetp_lib_h_pai_") then
		sp=right(oShape.src,12)
		if left(sp,1)="_" then 
			N=cint(left(right(oShape.src,11),2))
        else
			N=cint(left(right(oShape.src,12),2))
        end if
		for i=1 to N
			oShape.objects("TxtCText" & i).styleclass="TxtCText_" & index
		Next
	else
		oShape.objects("TxtCText").styleclass="TxtCText_" & index
	end if
	if typename(oShape.objects("TxtPName"))<>"Nothing" then 
		oShape.objects("TxtPName").styleclass="TxtPName_" & index	
		sTxt=oShape.objects("TxtPName").value
		if right(sTxt,3)="_CA" then 
			sTxt=mid(sTxt,1,len(stxt)-3)
			oShape.objects("TxtPName").value = sTxt
		end if
    end if
	if iPV<2 then 
	   oShape.objects("RecPV").alarm=oSource.alarm
    else
	   oShape.objects("RecPV").alarm=2048
    end if
	if typename(oShape.objects("TxtAnValue"))<>"Nothing" then
		iAType=cint(right(oShape.getcustomproperty("Parameter","cp_tp"),1))
		select case iAType
			case 1: sLim="HH"
			case 2: sLim="H"
			case 3: sLim="L"
			case 4: sLim="LL"
		end select	   
		sEuDesc=oSource.datavalue("tagnameA.cp_eudesc")
		iPVFrmt=oShape.getcustomproperty("Text","cp_pvformat")
		fAnValue=oSource.datavalue("tagnameA.cp_pv")
		fTP=oSource.datavalue("tagnameA.cp_tp")
		oShape.objects("TxtAnValue").value=FormatNumber(fAnValue,iPVFrmt) & "   " & sEuDesc 	
		oShape.objects("TxtAnValue").styleclass="TxtCText_" & index
		oShape.objects("TxtTpValue").value = FormatNumber(fTP,iPVFrmt) & "   " & sLim
		oShape.objects("TxtTpValue").styleclass="TxtCText_" & index
	end if

	if err.number<>0 then window.external.LogMessage "Scd_CEXXX_AlpPV_OnUpdate ->" & oSource.id & " " & err.description                
end sub

'----------------------------------------
'onOff Valves
'----------------------------------------

sub Scd_OnOffValves_AlpPV_OnUpdate(oSource) 
	dim iPV,oShape,iOP,index,indexOP
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iPV=oSource.value
	iOP=10
	if oShape.getcustomproperty("Parameter","cp_op")<>"" then iOP=oSource.datavalue("tagname.cp_op")
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif (oSource.quality and iQualityGood)<>iQualityGood then
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		iPV="Bad"
	else
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if

	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
	oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
	oShape.objects("PlgOut").styleclass="PlgOut_" & index      
	if cstr(iPV)="Bad" then 
		iBad="B" 
	elseif iPV=3 then 
		iBad="B"
	end if   
	
	blf=false
	if iBad="B" then
		oShape.objects("WdgC").styleclass = "WdgC_" & index
	else 
		if oShape.getCustomProperty("Point","tagnameLF")<>"" then
			if oSource.datavalue("tagnameLF.cp_pvLF")=cint(oshape.getCustomProperty("Num","cp_LFActive")) then
				bLF=true
				if typename(oShape.objects("WdgC"))<>"Nothing" then 
					oShape.objects("WdgC").styleclass="WdgC_" & oShape.getCustomProperty("Style","cp_styleForPV3")	   
				end if
			end if   
		end if	 
		if not bLF then 		           
			if typename(oShape.objects("WdgC"))<>"Nothing" and iOP<>10 then 
				oShape.objects("WdgC").styleclass="WdgC_" & oShape.getCustomProperty("Style","cp_styleForOP" & iOP)
			elseif typename(oShape.objects("WdgC"))<>"Nothing" and iOP=10 then
				oShape.objects("WdgC").styleclass="WdgC_OnOffValve_OPNA"							   
			end if
		end if	 
	end if
	if err.number<>0 then window.external.LogMessage " SCD_OnOffValves_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description
end sub

sub Scd_OnOffValves_Deluge_AlpPV_OnUpdate(oSource) 
	dim iPV,oShape,iOP,index,indexOP
	on error resume next
	set oShape=oSource.parentnode.parentnode
	
	iCmd=oSource.datavalue("tagnameCMD.cp_pv")
	iPV=oSource.datavalue("TagnameP.cp_pv")
	iOP=oSource.value*2
	iMOS=oSource.datavalue("TagnameMOS.cp_pv")
	
	if iCmd=0 then iPV=3
	if iMOS=1 or iPV=1 then IPV=0
		
	if ((oSource.quality and iQualityOffScan)=iQualityOffScan) or ((oSource.dataquality("tagnameCMD.cp_pv") and iQualityOffScan)=iQualityOffScan) or ((oSource.dataquality("tagnameP.cp_pv") and iQualityOffScan)=iQualityOffScan) or ((oSource.dataquality("tagnameMOS.cp_pv") and iQualityOffScan)=iQualityOffScan)then
		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif ((oSource.quality and iQualityGood)<>iQualityGood) or ((oSource.dataquality("tagnameCMD.cp_pv") and iQualityGood)<>iQualityGood) or ((oSource.dataquality("tagnameP.cp_pv") and iQualityGood)<>iQualityGood) or ((oSource.dataquality("tagnameMOS.cp_pv") and iQualityGood)<>iQualityGood) then
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		iPV="Bad"
		iOP="Bad"
	else
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
	oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
	oShape.objects("PlgOut").styleclass="PlgOut_" & index      
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iOP)
	oShape.objects("WdgC").styleclass = "WdgC_" & index
	if err.number<>0 then window.external.LogMessage " SCD_OnOffValves_Deluge_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description
end sub
'----------------------------------------
'Reg Valves
'----------------------------------------

sub Scd_RegValves_AlpPV_OnUpdate(oSource) 
   dim iPV,oShape,iOP,index,indexOP
   on error resume next
   set oShape=oSource.parentnode.parentnode
   iPV=oSource.value
    if (oSource.quality and iQualityOffScan)=iQualityOffScan then
		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif (oSource.quality and iQualityGood)<>iQualityGood then
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		iPV="Bad"
	else
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
	oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
	oShape.objects("PlgOut").styleclass="PlgOut_" & index 
	if cstr(iPV)="Bad" then 
		iBad="B" 
	elseif iPV=3 then 
		iBad="B"
	end if   
   blf=false
   if iBad="B" then
     oShape.objects("WdgC").styleclass = "WdgC_" & index
	 if typename(oShape.objects("WdgESD"))<>"Nothing" then oShape.objects("WdgESD").styleclass = "WdgESD_" & index
   else
     if oShape.getCustomProperty("Point","tagnameLF")<>"" then
		if oSource.datavalue("tagnameLF.cp_pvLF")=cint(oshape.getCustomProperty("Num","cp_LFActive")) then
		   bLF=true
		   if typename(oShape.objects("WdgESD"))<>"Nothing" then 
		   		oShape.objects("WdgESD").styleclass="WdgESD_" & oShape.getCustomProperty("Style","cp_styleForPV0")
		   		oShape.objects("WdgC").styleclass="WdgC_Regvalve"
		   elseif typename(oShape.objects("WdgC"))<>"Nothing" then 
		   		oShape.objects("WdgC").styleclass="WdgC_" & oShape.getCustomProperty("Style","cp_styleForPV0")	   
           end if
		end if   
	 end if 
	 if not bLF then     	       
	 	if oShape.getcustomproperty("Num","cp_ESDValue")<>"" then
		   iESDval=oShape.getcustomproperty("Num","cp_ESDValue")
		   sFState=oShape.getcustomproperty("Text","cp_FailState")		   		   
		   if oSource.datavalue("tagnameDO.cp_opDO")=cint(iESDval) then
			  if sFState="FC" then: iOP=1 :else: iOP=2: end if
		   else	 
		      if sFState="FC" then: iOP=2 :else: iOP=1: end if
		   end if		   
		   if typename(oShape.objects("WdgESD"))<>"Nothing" then 
		   	  oShape.objects("WdgESD").styleclass="WdgESD_" & oShape.getCustomProperty("Style","cp_styleForPV" & iOP)
			  oShape.objects("WdgC").styleclass="WdgC_Regvalve"
		   elseif typename(oShape.objects("WdgC"))<>"Nothing" then 
		   	  oShape.objects("WdgC").styleclass="WdgC_" & oShape.getCustomProperty("Style","cp_styleForPV" & iOP)	   
           end if 				 	   
	    end if	 
	 end if
   end if	 	 
   if err.number<>0 then window.external.LogMessage " CDA_OnOffValves_AlpGPV_OnUpdate ->" & oSource.id & " " & err.description
end sub


'----------------------------------------
'MOValves
'----------------------------------------

sub Scd_MOV_FG_AlpPV_OnUpdate(oSource)
dim iPV,oShape,index
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iPV=oSource.value
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif (oSource.quality and iQualityGood)<>iQualityGood then
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		iPV="Bad"
    else
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
    oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
    oShape.objects("PlgOut").styleclass="PlgOut_" & index
	oShape.objects("WdgC").styleclass = "WdgC_MOV"	
	if iPV="Bad" then
       oShape.objects("WdgC").styleclass = "WdgC_" & index
       oShape.objects("PlgC").style.visibility = "hidden"
	   oShape.objects("PlgO").style.visibility = "hidden"
    else
	   if oShape.getcustomProperty("Point","TagnameTrq")<>"" then
			iTorque=oSource.datavalue("TagnameTrq.cp_pv")
			sStyleTrq=oShape.getCustomProperty("Style","cp_styleForTorque" & iTorque)
			oShape.objects("WdgC").styleclass = "WdgC_" & sStyleTrq 
   	   else	
	        oShape.objects("WdgC").styleclass = "WdgC_MOV"
       end if
	   
	   if oShape.getcustomproperty("Parameter","cp_op")<>"" then
   		   iOP = oSource.datavalue("Tagname.cp_op")
		   indexOP = oShape.getCustomProperty("Style","cp_styleForOP" & iOP) 
           oShape.objects("PlgO").styleclass="PlgO_" & indexOP
		   oShape.objects("PlgC").styleclass="PlgC_" & indexOP
		   if indexOP=index then
		   		oShape.objects("PlgC").style.visibility = "hidden"
	   			oShape.objects("PlgO").style.visibility = "hidden"
           end if
	   end if
    end if
		
	if err.number<>0 then window.external.LogMessage " Scd_MOV_FG_AlpPV_OnUpdate ->" & oSource.id & " " & err.description
end sub

'----------------------------------------
'Fire and Gas
'----------------------------------------

Sub Scd_HornBeacon_AlpPV_OnUpdate(oSource)
	dim oShape,iQuality(2)
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iQuality(0)=oSource.quality
	iQuality(1)=oSource.dataquality("TagnameB.cp_pv")
	for j=0 to 1
		ipQuality = 4
		ipQuality = iQuality(j)
		if (ipQuality and 8)=8 then
      		sOffScan="Active"
			elseif (ipQuality and 4)=4 then
      		sBad="Bad"
    	end if 
	next
	if sOffScan="Active" then
	  	oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif sBad="Bad"then
	    oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
  		oShape.objects("DetBody").styleclass="DetBody_" & oShape.getCustomProperty("Style","cp_StyleForPVBad") 
		oShape.objects("WdgBeac").styleclass="WdgBeac_" & oShape.getCustomProperty("Style","cp_StyleForPVBad")  		
	else
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		iPV=oSource.value
		iPVbc=oSource.datavalue("TagnameB.cp_pv")
		index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
		indexbc=oShape.getCustomProperty("Style","cp_styleForPV" & iPVbc)
		oShape.objects("DetBody").styleclass="DetBody_" & index
		oShape.objects("WdgBeac").styleclass="WdgBeac_" & indexbc
	end if
	if err.number<>0 then window.external.LogMessage "Scd_HornBeacon_AlpPV_OnUpdate ->" & oSource.id & " " & err.description       
end sub

'*********************************************************************************************
' Fire and gas navigation
'*********************************************************************************************

sub FG_ZoneGrid_OnUpdate(oSource)
	
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iFrAlarm=oSource.dataalarm("TagnameFire.name")
	iFlAlarm=oSource.dataalarm("TagnameFlame.name")
	iTxAlarm=oSource.dataalarm("TagnameToxic.name")

	set oFire=document.getelementbyid(oshape.id & "_plFire")
	set oFlame=document.getelementbyid(oshape.id & "_plFlame")
	set oToxic=document.getelementbyid(oshape.id & "_plToxic")

	sActive=oShape.getcustomproperty("Style","cpStyleForDetActive")
	sNormal=oShape.getcustomproperty("Style","cpStyleForDetNormal")

	iAlmFrAct=(iFrAlarm<>2048)*-1 : iUnckAlmFr=(iFrAlarm and 1024)/1024 : iAlmStateFr=2*iAlmFrAct+iUnckAlmFr 
	iAlmFlAct=(iFlAlarm<>2048)*-1 : iUnckAlmFl=(iFlAlarm and 1024)/1024 : iAlmStateFl=2*iAlmFlAct+iUnckAlmFl
	iAlmTxAct=(iTxAlarm<>2048)*-1 : iUnckAlmTx=(iTxAlarm and 1024)/1024 : iAlmStateTx=2*iAlmTxAct+iUnckAlmTx

	select case iAlmStateFr
	case 1,3 : oFire.styleclass="plFire_" & sActive : oFire.linecolorblink=true
	case 2 : oFire.styleclass="plFire_" & sActive : oFire.linecolorblink=false
	case 0 : oFire.styleclass="plAll_" & sNormal : oFire.linecolorblink=false 
	end select 

	select case iAlmStateFl
	case 1,3 : oFlame.styleclass="plFlame_" & sActive : oFlame.linecolorblink=true
	case 2 : oFlame.styleclass="plFlame_" & sActive : oFlame.linecolorblink=false
	case 0 : oFlame.styleclass="plAll_" & sNormal : oFlame.linecolorblink=false 
	end select 

	select case iAlmStateTx
	case 1,3 : oToxic.styleclass="plToxic_" & sActive : oToxic.linecolorblink=true
	case 2 : oToxic.styleclass="plToxic_" & sActive : oToxic.linecolorblink=false
	case 0 : oToxic.styleclass="plAll_" & sNormal : oToxic.linecolorblink=false 
	end select 
end sub

sub FG_OnUpdate(oSource)
	dim oShape,iQuality(2)
	on error resume next
	set oShape=oSource.parentnode.parentnode
	if oShape.getCustomProperty("Num","cp_orientation")<>"" then oShape.objects("WdgB").rotation=oShape.getCustomProperty("Num","cp_orientation")
	set DetBody=oShape.objects("DetBody")
	if typename(oShape.objects("TxtMos"))<>"Nothing" then set DetMOS=oShape.objects("TxtMos")
	iQuality(0)=oSource.quality
	if instr(lcase(oShape.src),"nm_fgs")=0 then
		iQuality(1)=oSource.dataquality("TagnameInh.cp_inh_pv")
		inh_OP=oSource.datavalue("TagnameInh.cp_inh_op")
		inh_PV=oSource.datavalue("TagnameInh.cp_inh_pv")
	else 
		iQuality(1)=33216
        inh_OP=3
		inh_PV=3 
	end if
	for j=0 to 0
		ipQuality = 4
		ipQuality = iQuality(j)
		if (ipQuality and 8)=8 then
      		sOffScan="Active"
			elseif (ipQuality and 4)=4 then
      		sBad="Bad"
    	end if 
	next
	if sOffScan="Active" then
	  	oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
		index=oShape.GetCustomProperty("Style","cp_StyleForPV" &  cstr(oSource.value))
        if typename(oShape.objects("DetBodyB"))<>"Nothing" then oShape.objects("DetBodyB").styleclass="DetBodyB_" & index
		DetBody.styleclass="DetBody_" & index
		if inh_OP=1 then 
			index=oShape.GetCustomProperty("Style","cp_StyleForInhOP")
			DetMOS.styleclass="TxtMos_" & index
		end if
		if inh_PV=1 then
			index=oShape.GetCustomProperty("Style","cp_StyleForInhPV")
         	DetMOS.styleclass="TxtMos_" & index
        end if
		if inh_PV=0 then
         	DetMOS.styleclass="TxtMos_FG_NotInhibit"
        end if 
	elseif sBad="Bad"then
	    oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
  		DetBody.styleclass="DetBody_" & oShape.getCustomProperty("Style","cp_StyleForPVBad")
		if typename(oShape.objects("DetBodyB"))<>"Nothing" then oShape.objects("DetBodyB").styleclass="DetBody_" & oShape.getCustomProperty("Style","cp_StyleForPVBad")  		
	else
  		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		index=oShape.GetCustomProperty("Style","cp_StyleForPV" &  cstr(oSource.value))
		DetBody.styleclass="DetBody_" & index
		if typename(oShape.objects("DetBodyB"))<>"Nothing" then oShape.objects("DetBodyB").styleclass="DetBodyB_" & index
		if inh_OP=1 then 
			index=oShape.GetCustomProperty("Style","cp_StyleForInhOP")
			DetMOS.styleclass="TxtMos_" & index
		end if
		if inh_PV=1 then
			index=oShape.GetCustomProperty("Style","cp_StyleForInhPV")
         	DetMOS.styleclass="TxtMos_" & index
        end if
		if inh_PV=0 then
         	DetMOS.styleclass="TxtMos_FG_NotInhibit"
        end if
	end if
	if err.number<>0 then window.external.LogMessage " FG_OnUpdate ->" & oSource.id & " " & err.description 
end sub

sub FG_OnUpdate2C(oSource)
	dim oShape,iQuality(3),iOffScan(2),iBad(2)
	'on error resume next
	set oShape=oSource.parentnode.parentnode
	set DetBody=oShape.objects("DetBody")
	set DetBodyB=oShape.objects("DetBodyB")
	if typename(oShape.objects("TxtMos"))<>"Nothing" then set DetMOS=oShape.objects("TxtMos")
	iQuality(0)=oSource.quality
    iQuality(1)=oSource.dataquality("tagnameF.cp_pv")
	if instr(lcase(oShape.src),"nm_fgs")=0 then
		iQuality(2)=oSource.dataquality("TagnameInh.cp_inh_pv")
		inh_OP=oSource.datavalue("TagnameInh.cp_inh_op")
		inh_PV=oSource.datavalue("TagnameInh.cp_inh_pv")
	else 
		iQuality(2)=33216
        inh_OP=3
		inh_PV=3 
	end if

	for j=0 to 1
		ipQuality = 4
		ipQuality = iQuality(j)
		if (ipQuality and 8)=8 then
      		iOffScan(j)=1
			elseif (ipQuality and 4)=4 then
      		iBad(j)=1
    	end if 
	next
	
	iPVC=oSource.value
	iPVF=oSource.datavalue("tagnameF.cp_pv")
	indexC=oShape.GetCustomProperty("Style","cp_StyleForPV" &  iPVC)
	indexF=oShape.GetCustomProperty("Style","cp_StyleForPV" &  iPVF)	
    DetBodyB.styleclass="DetBodyB_" & indexC
	DetBody.styleclass="DetBody_" & indexF
	if inh_OP=1 then 
		index=oShape.GetCustomProperty("Style","cp_StyleForInhOP")
		DetMOS.styleclass="TxtMos_" & index
	end if
	if inh_PV=1 then
		index=oShape.GetCustomProperty("Style","cp_StyleForInhPV")
     	DetMOS.styleclass="TxtMos_" & index
    end if
	if inh_PV=0 then
     	DetMOS.styleclass="TxtMos_FG_NotInhibit"
    end if	
    oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	if iOffScan(0)=1 or iOffScan(1)=1 then
		if iOffScan(0)=1 then oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
		if iOffScan(1)=1 then DetBody.styleclass="DetBody_" & oShape.getCustomProperty("Style","cp_StyleForPVBad")
    end if
 	if iBad(0)=1 or iBad(1)=1 then
  		if iBad(0)=1 then DetBodyB.styleclass="DetBody_" & oShape.getCustomProperty("Style","cp_StyleForPVBad")
		if iBad(1)=1 then DetBody.styleclass="DetBody_" & oShape.getCustomProperty("Style","cp_StyleForPVBad")
	end if
	if err.number<>0 then window.external.LogMessage " FG_OnUpdate2C ->" & oSource.id & " " & err.description 
end sub



'*******************************************************************************************
'Channels and RTUs
'*******************************************************************************************
sub Scd_ChnRtu_OnUpdate(oSource)
	on error resume next
    set oShape=oSource.parentnode.parentnode
	if oSOurce.value=0 then
		oShape.objects("IndbarB").style.visibility="hidden"
		oShape.objects("OvlStsB").style.visibility="hidden"
		oShape.objects("TxtLinkB").style.visibility="hidden"
		oShape.objects("LinScaleB").style.visibility="hidden"
		oShape.objects("TxtLinkA").value="  Lnk"
	else
		oShape.objects("IndbarB").style.visibility="inherit"
		oShape.objects("OvlStsB").style.visibility="inherit"
		oShape.objects("TxtLinkB").style.visibility="inherit"
		oShape.objects("LinScaleB").style.visibility="inherit"
		oShape.objects("TxtLinkA").value="Lnk A"
	end if	
    if oSource.DataChanged("tagname.cp_BarFail") then 
	    oShape.objects("IndbarA").rangeHi=oSource.datavalue("tagname.cp_BarFail")
	    oShape.objects("IndbarB").rangeHi=oShape.objects("IndbarA").rangeHi
	    oShape.objects("IndbarA").rangeLo=0
	    oShape.objects("IndbarB").rangeLo=0
	end if   	
    if oSource.DataChanged("tagname.cp_LnkABarCnt") then
		oShape.objects("IndbarA").value=oSource.DataValue("tagname.cp_LnkABarCnt")
	end if
	if oSource.DataChanged("tagname.cp_LnkBBarCnt") then
		oShape.objects("IndbarB").value=oSource.DataValue("tagname.cp_LnkBBarCnt")
	end if
	if oSource.DataChanged("tagname.cp_LnkStsA") then
		oShape.objects("OvlStsA").styleclass="OvlStsA_" & oShape.getcustomproperty("Style","cp_StyleForSts" & oSource.Datavalue("tagname.cp_LnkStsA") )
		oShape.objects("IndbarA").styleclass="IndbarA_" & oShape.getcustomproperty("Style","cp_StyleForSts" & oSource.Datavalue("tagname.cp_LnkStsA") )
	end if
	if oSource.DataChanged("tagname.cp_LnkStsB") then
		oShape.objects("OvlStsB").styleclass="OvlStsB_" & oShape.getcustomproperty("Style","cp_StyleForSts" & oSource.Datavalue("tagname.cp_LnkStsB") )
		oShape.objects("IndbarB").styleclass="IndbarB_" & oShape.getcustomproperty("Style","cp_StyleForSts" & oSource.Datavalue("tagname.cp_LnkStsB") )
	end if
	if err.number<>0 then window.external.LogMessage " Scd_ChnRtu_OnUpdate ->" & oSource.id & " " & err.description
end sub

'*******************************************************************************************
'MOS Key
'*******************************************************************************************

sub Scd_MntOvrKey_AlpPV_OnUpdate(oSource)
	on error resume next
    set oShape=oSource.parentnode.parentnode
    iPV=oSource.value
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif (oSource.quality and iQualityGood)<>iQualityGood then
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	else
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
    oShape.objects("GrpKey").styleclass=index
end sub

'*******************************************************************************************
'Stack Damper
'*******************************************************************************************

sub Scd_Damper_AlpPV_OnUpdate(oSource) 
	dim iPV,oShape,iOP,index,indexOP
	on error resume next
	set oShape=oSource.parentnode.parentnode
	iPV=oSource.datavalue("TagnameVLV.cp_pv")
	iOP=10
	if oShape.getcustomproperty("Parameter","cp_eop")<>"" then iOP=oSource.datavalue("tagnameVLV.cp_eop")
	iBadCtlFl=oSource.DataValue("tagname.cp_badctlfl") 
	if iBadCtlFl=1 then iPV=3
	if oSource.DataValue("tagname.cp_execstate")=1 then
      oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
    else
	  oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
    end if
	if (oSource.dataquality("tagnameVLV.cp_pv") and iQualityOffScan)=iQualityOffScan then
	    oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif (oSource.dataquality("tagnameVLV.cp_pv") and iQualityGood)<>iQualityGood then
		if oSource.DataValue("tagname.cp_execstate")=1 then oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		iPV="Bad"
	else
		if oSource.DataValue("tagname.cp_execstate")=1 then oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if
    if typename(oShape.objects("WdgESD"))<>"Nothing" and iOP<>10 then 
		oShape.objects("WdgESD").styleclass="WdgESD_" & oShape.getCustomProperty("Style","cp_styleForOP" & iOP)
	elseif typename(oShape.objects("WdgESD"))<>"Nothing" and iOP=10 then		
		oShape.objects("WdgC").styleclass="WdgESD_OnOffValve_OPNA"							   
	end if
	index=oShape.getCustomProperty("Style","cp_styleForPV" & iPV)
	oShape.objects("PlgIn").styleclass="PlgIn_" & index	   
    if instr(lcase(index),"bad") then oShape.objects("WdgESD").styleclass = "WdgESD_" & index
      
    rVal=oSource.value
    rval=-round(rval)*0.9
    if rVal<-90 then 
      rVal=-90
    elseif rVal>0 then 
      rVal=0
    end if
    set oLinDamper=oShape.objects("LinDamper") 
    oLinDamper.style.visibility="hidden"
    oLinDamper.rotation=rval
    oLinDamper.style.visibility="inherit"

	if err.number<>0 then window.external.LogMessage " Scd_Damper_AlpPV_OnUpdate ->" & oSource.id & " " & err.description
end sub

sub Scd_Compass_OnUpdate(oSource)
	on error resume next
	set oShape=oSource.parentnode.parentnode
	rBias=csng(oShape.getcustomproperty("num","cp_northbias"))
	oShape.objects("grpCompass").rotation=rbias
	oShape.objects("plgSouth").styleclass="PlgSouth"
	oShape.objects("plgNorth").styleclass="plgNorth"
	if (oSource.quality and iQualityOffScan)=iQualityOffScan then
		oShape.objects("LinExecState").styleclass="LinExecState_OffScan_InActive"
	elseif (oSource.quality and iQualityGood)<>iQualityGood then
	    oShape.objects("plgSouth").styleclass="PlgSouthBad"
		oShape.objects("plgNorth").styleclass="plgNorthBad"
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
		exit sub
	else
		oShape.objects("LinExecState").styleclass="LinExecState_OnScan_Active"
	end if
	rDir=csng(oSource.value)+rBias
	oShape.objects("grpArrow").style.visibility="hidden"
    oShape.objects("grpArrow").rotation=rDir
	oShape.objects("grpArrow").style.visibility="inherit"
	if oShape.getcustomproperty("Text","cp_TagnameEU")="" then oShape.objects("TxtEUDesc").innertext = oSource.DataValue("tagname.cp_eudesc")
	if err.number<>0 then window.external.LogMessage " Scd_Compass_OnUpdate ->" & oSource.id & " " & err.description
end sub]]></script><script event="" language="VBScript" id="0A963845-6453-47D8-B8C8-49A8FDA26857"><![CDATA['----------------------------------------------------
'Takt Shape for Adsorber
'----------------------------------------------------

sub OnStageUpdate(oSource)

dim iStep, oStage, iStageNum

on error resume next

set oShape=oSource.parentnode.parentnode
iStep=oSource.DataValue("Tagname.cp_pv")
set oStage=oShape.Objects("RecPV")
iStageNum=oShape.getCustomProperty("Value","StageNum")

oStage.fillColor="#696969"

select case iStep
	case 0		if iStageNum=0 then 
				oStage.fillColor="#C8C800"
				end if
	case 1		if iStageNum=1 then 
				oStage.fillColor="#C8C800"
				end if

	case 2		if iStageNum=2 then 
				oStage.fillColor="#C8C800"
				end if
	case 3		if iStageNum=3 then 
				oStage.fillColor="#C8C800"
				end if
	case 4		if iStageNum=4 then 
				oStage.fillColor="#C8C800"
				end if
	case 5		if iStageNum=5 then 
				oStage.fillColor="#C8C800"
				end if
	case 6		if iStageNum=6 then 
				oStage.fillColor="#C8C800"
				end if
	case 7		if iStageNum=7 then 
				oStage.fillColor="#C8C800"
				end if
	case 8		if iStageNum=8 then 
				oStage.fillColor="#C8C800"
				end if
	case 9		if iStageNum=9 then 
				oStage.fillColor="#C8C800"
				end if
	case 10		if iStageNum=10 then 
				oStage.fillColor="#C8C800"
				end if
	case 11		if iStageNum=11 then 
				oStage.fillColor="#C8C800"
				end if
	case 12		if iStageNum=12 then 
				oStage.fillColor="#C8C800"
				end if
	case 13		if iStageNum=13 then 
				oStage.fillColor="#C8C800"
				end if
	case 14		if iStageNum=14 then 
				oStage.fillColor="#C8C800"
				end if
	case 15		if iStageNum=15 then 
				oStage.fillColor="#C8C800"
				end if
	case 16		if iStageNum=16 then 
				oStage.fillColor="#C8C800"
				end if
	case 17		if iStageNum=17 then 
				oStage.fillColor="#C8C800"
				end if
	case 18		if iStageNum=18 then 
				oStage.fillColor="#C8C800"
				end if
	case 19		if iStageNum=19 then 
				oStage.fillColor="#C8C800"
				end if
	case 20		if iStageNum=20 then 
				oStage.fillColor="#C8C800"
				end if
	case 21		if iStageNum=21 then 
				oStage.fillColor="#C8C800"
				end if
	case 22		if iStageNum=22 then 
				oStage.fillColor="#C8C800"
				end if
	case 23		if iStageNum=23 then 
				oStage.fillColor="#C8C800"
				end if
	case 24		if iStageNum=24 then 
				oStage.fillColor="#C8C800"
