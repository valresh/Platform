<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="652px" height="22px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><parameters><parameter name="TagNameCM" type="Point" description="Tag Name" defaultvalue=""/><parameter name="cp_pv" type="Parameter" description="" defaultvalue="DIGACQA"/><parameter name="FaceplateFile" type="Text" description="Custom Faceplate File" defaultvalue=""/><parameter name="ContextMenuFile" type="Text" description="Context Menu Filename" defaultvalue="sp_sysdtlKIN_sm.xml"/><parameter name="CustAssocDspl" type="Text" description="Custom Associated Display" defaultvalue=""/><parameter name="cp_almenbstate" type="Parameter" description="Alarm Enable State" defaultvalue="almenbstate"/><parameter name="TagNameDI" type="Parameter" description="Name DICHANNEL" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ScConAlpPVScript class="hsc.alpha.1 ScConAlpPV" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 54.54%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 1.99%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; COLOR: #000000; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 28.22%; BORDER-RIGHT-COLOR: transparent; TOP: 18.18%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderWidth:;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;styleClass:ScConAlpPV;textColor:#000000;textColorBlink:False;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[on error resume next

