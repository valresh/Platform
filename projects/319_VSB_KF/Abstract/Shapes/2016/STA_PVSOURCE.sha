<DIV tabIndex=-1 id=ScTxtSelectBox class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 18.4%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 78.06%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;FillStyle:0;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:120;" globalscripts></DIV>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[call All_OnClick(me)]]></script><script event="oncontextmenu" language="VBScript"><![CDATA[call All_OnCMenu(me)]]></script></scripts></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ScConAlpPV class="hsc.alpha.1  HSC.ScriptDataObject.1 hsc.faceplate.1 " style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 18.4%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 78.06%; BORDER-RIGHT-COLOR: transparent; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior) url(#HDXPopupBehavior#Faceplate); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderWidth:;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;styleClass:;textColor:#000000;textColorBlink:False;">State</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varian