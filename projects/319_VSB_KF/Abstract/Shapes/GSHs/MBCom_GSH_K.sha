<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="103px" height="40px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[page.setattribute "MB_qual_sub", me.id
window.settimeout "MB_qual",5000]]></script><script event="" language="VBScript" id="5A035ADE-0F2E-4AFB-BCDF-D6AD651D26C4"><![CDATA[dim Passed_once
    Passed_once=false

sub MB_qual
	   
   dim oQualObj,s
  
   set oQualObj=document.getelementbyid(page.getattribute("MB_qual_sub")).children(0) 
   s=""
   for i=1 to 37
      if oQualObj.datavalue("tagname" & i & ".cp_par" & i )=1 then
			s=s & ucase(window.external.StationDataRepository.getvalue("MBStr" & i))
	  end if 
   next

   for each oshape in page.children.tags("DIV")
   	  if instr(lcase(oShape.classname),"hsc.shape.1")>0 then
   	    if oShape.getcustomproperty("Point","tagname")<>"" then
			if instr(s,ucase(oShape.getcustomproperty("Point","tagname")))>0 then
				oShape.setAttribute "BadQual","BAD"
				call oShape.objects("ScConAlpPV").onupdate
            else
				oShape.setAttribute "BadQual","OK" 
				call oShape.objects("ScConAlpPV").onupdate
			end if
		end if	
      end if
   next
   Passed_once=true
  
end sub]]></script></scripts><parameters><parameter name="Tagname1" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par1" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname2" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par2" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname3" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par3" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname4" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par4" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname5" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par5" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname6" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par6" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname7" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par7" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname8" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par8" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname9" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par9" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname10" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par10" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname11" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par11" type="Parameter" description="Array error flag" def