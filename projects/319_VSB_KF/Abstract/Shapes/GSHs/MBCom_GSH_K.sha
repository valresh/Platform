ameter name="Tagname34" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par34" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname35" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par35" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname36" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par36" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Tagname37" type="Point" description="Array Point name" defaultvalue=""/><parameter name="cp_par37" type="Parameter" description="Array error flag" defaultvalue=""/><parameter name="Revision" type="Num" description="Rev.0" defaultvalue="R300"/></parameters><shapes><shape><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ConTxtMB_qual class="hvg.textbox.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 8pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 40px; FONT-FAMILY: Arial; WIDTH: 103px; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 42px; TOP: 10px; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior); VISIBILITY: hidden" globalscripts hdxproperties="FillColor:#ff8c00;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:40;lineColorBlink:False;LineStyle:1;textColor:#000000;textColorBlink:False;TotalRotation:-1;value:;Width:103;">MB comm quality GSH</DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[   dim oQualObj,s

   if Passed_once=true then 
	   s=""
	   for i=1 to 37
	      if me.datavalue("tagname" & i & ".cp_par" & i )=1 then
				s=s & ucase(window.external.StationDataRepository.getvalue("MBStr" & i))
		  end if 
	   next

	   for each oshape in page.children.tags("DIV")
	   	  if instr(lcase(oShape.classname),"hsc.shape.1")>0 then
	   	    if oShape.getcustomproperty("Point","tagname")<>"" then
				if instr(s,ucase(oShape.getcustomproperty("Point","tagname")))>0 then
					oShape.setAttribute "BadQual","BAD"
					call oShape.objects("ScConAlpPV").onupdate
            	else
					oShape.setAttribute "BadQual","OK" 
					call oShape.objects("ScConAlpPV").onupdate
				end if
			end if	
	      end if
	   next
    end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tagname1%},{%Point::Tagname2%},{%Point::Tagname3%},{%Point::Tagname4%},{%Point::Tagname5%},{%Point::Tagname6%},{%Point::Tagname7%},{%Point::Tagname8%},{%Point::Tagname9%},{%Point::Tagname10%},{%Point::Tagname11%},{%Point::Tagname12%},{%Point::Tagname13%},{%Point::Tagname14%},{%Point::Tagname15%},{%Point::Tagname16%},{%Point::Tagname17%},{%Point::Tagname18%},{%Point::Tagname19%},{%Point::Tagname20%},{%Point::Tagname21%},{%Point::Tagname22%},{%Point::Tagname23%},{%Point::Tagname24%},{%Point::Tagname25%},{%Point::Tagname26%},{%Point::Tagname27%},{%Point::Tagname28%},{%Point::Tagname29%},{%Point::Tagname30%},{%Point::Tagname31%},{%Point::Tagname32%},{%Point::Tagname33%},{%Point::Tagname34%},{%Point::Tagname35%},{%Point::Tagname36%},{%Point::Tagname37%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_par1%},{%Parameter::cp_par2%},{%Parameter::cp_par3%},{%Parameter::cp_par4%},{%Parameter::cp_par5%},{%Parameter::cp_par6%},{%Parameter::cp_par7%},{%Parameter::cp_par8%},{%Parameter::cp_par9%},{%Parameter::cp_par10%},{%Parameter::cp_par11%},{%Parameter::cp_par12%},{%Parameter::cp_par13%},{%Parameter::cp_par14%},{%Parameter::cp_par15%},{%Parameter::cp_par16%},{%Parameter::cp_par17%},{%Parameter::cp_par18%},{%Parameter::cp_par19%},{%Parameter::cp_par20%},{%Parameter::cp_par21%},{%Parameter::cp_par22%},{%Parameter::cp_par23%},{%Parameter::cp_par24%},{%Parameter::cp_par25%},{%Parameter::cp_par26%},{%Parameter::cp_par27%},{%Parameter::cp_par28%},{%Parameter::cp_par29%},{%Parameter::cp_par30%},{%Parameter::cp_par31%},{%Parameter::cp_par32%},{%Parameter::cp_par33%},{%Parameter::cp_par34%},{%Parameter::cp_par35%},{%Parameter::cp_par36%},