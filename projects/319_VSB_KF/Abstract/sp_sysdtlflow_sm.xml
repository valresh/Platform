	<menuitem id="mnu_expnd" acceleratorKey="">
		<script type="onclick">
			window.external.parentwindow.flowExpand ();
			window.external.CloseShortcutMenu()
		</script>
		<script type="onpage">
			if(window.external.parentWindow.Page.cmenusource) {
				if(window.external.parentWindow.myDebug){window.external.parentWindow.debugWrite("cmenusource = ", window.external.parentWindow.Page.cmenusource);}
				if(window.external.parentWindow.Page.getAttribute('cmenusource').indexOf(':X:')>-1){this.disabled=false}else{this.disabled=true};
			}else{this.disabled=true}
		</script>
		<text>Expand</text>
		<image>.\Toolbar\tb017.png</image>
	</menuitem>

	<menuitem id="mnu_reload" acceleratorKey="">
		<script type="onclick">
			var lastsel=window.external.parentwindow.Page.getAttribute('lastselection');
			var obj=window.external.parentwindow.document.getElementById(lastsel);
			obj.fireEvent('ondblclick');
			window.external.CloseShortcutMenu()
		</script>
		<script type="onpage">
			var lastsel=window.external.parentwindow.Page.getAttribute('lastselection');
			if (lastsel.search(':')>-1){this.disabled=true}else{this.disabled=false}
		</script>
		<text>Reload</text>
		<image>.\Toolbar\tb009.png</image>
	</menuitem>
	
	<separator/>
	
	<menuitem id="mnu_gotoactive" acceleratorKey="">
		<script type="onclick">
			var oPage = window.external.parentwindow.Page;
			var oShape = window.external.parentwindow.document.getElementById(oPage.getAttribute('lastselectionseq')).parentElement.parentElement;
			var tmpName=oShape.GetCustomProperty('Point','pointName');
			if(tmpName.indexOf("%")>0){
				var pntName = window.external.parentwindow.DisplayDataRepository.GetValue(tmpName.split("%")[1]);
			}else{
				var pntName = tmpName;
			}
			window.external.parentwindow.DisplayDataRepository.PutValue("ACTSEL",pntName);
			//call "showActiveList" function with timeout to allow the "ActiveSteps" shape to populate the data.
			window.external.parentwindow.setTimeout(function(){window.external.parentwindow.showActiveList();},1000);
			window.external.CloseShortcutMenu()
		</script>
		<script type="onpage">
			
		</script>
		<text>Goto Active...</text>
		<image>.\Toolbar\tb009.png</image>
	</menuitem>
