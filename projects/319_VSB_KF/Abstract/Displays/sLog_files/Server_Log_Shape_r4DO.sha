<DIV tabIndex=-1 id=pbActionlogMan class=hvg.textbox.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 2%; FONT-FAMILY: Arial; WIDTH: 13.35%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 32.58%; TOP: 97.99%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:207;" HDX_LOCK="-1">Log for actions in pntblds</DIV>]]></content></html></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=pbActionlog title="Click to see the actionlog" class=hsc.button.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 4.45%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 13.54%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 32.58%; BORDER-RIGHT-COLOR: #ffffff; TOP: 93.54%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #a0a0a4" type=button value="actionLog " hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" HDX_LOCK="-1" BaseFilterTranslateSQLchars="" BaseFilterXML="" BaseFilter="">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[ilog = "actionlog.txt"]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><