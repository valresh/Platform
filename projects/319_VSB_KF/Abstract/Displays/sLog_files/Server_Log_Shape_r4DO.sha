<?xml version="1.0"?><shapefile version="1" type="dynamic" title="LogShape" description="Dinamic Shape for ExperionPKS Log" useFirstShapeForBadValue="0" width="1550px" height="898px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><parameters><parameter name="lPath" type="Text" description="Path to LogFile Directory" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=border class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 89.08%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="fillColorBlink:False;Height:800;LineColor:#808080;lineColorBlink:False;LineWidth:2;Width:1550;"></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=activeXlog class=hsc.activexdoc.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 89.08%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HSCActiveXDocumentBehavior)  url(#BindingBehavior); BACKGROUND-COLOR: #ffffff" hdxproperties="ActiveXDocumentFile:<Path>;HDXBINDINGID:-4;" SHORTCUTMENUCUSTOM="0" HDX_LOCK="-1"></DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
<DIV tabIndex=0 id=PathView class=hvg.textbox.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: underline; HEIGHT: 2.78%; FONT-FAMILY: Arial; WIDTH: 87.09%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 0%; TOP: 89.64%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:25;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:1350;" HDX_LOCK="-1">{%Text::lPath%}</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=alpha class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 1.78%; FONT-FAMILY: Arial; WIDTH: 1.41%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 85.67%; TOP: 90.64%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior)  url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;" HDX_LOCK="-1">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim oShape, pProp, customPath, oAX, ilog
on error resume next
set oShape = me.parentElement.parentElement
	pProp = oShape.getCustomProperty("Text","lPath")
	ilog = "log.txt"	
	customPath = "\\" & window.external.ServerName & "\c$\ProgramData\Honeywell\Experion PKS\Server\data\" & ilog

		if pProp = "" then oShape.setCustomProperty "Text", "lPath", customPath]]></script><script event="ondatachange" language="VBScript"><![CDATA[on error resume next

ilog = "log.txt"
if me.DataChanged("test.pida.op") then activeXlog.file = "\\" & window.external.ServerName & "\c$\ProgramData\Honeywell\Experion PKS\Server\data\" & ilog]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="test,"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="pida.op,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=pblogMan class=hvg.textbox.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 2%; FONT-FAMILY: Arial; WIDTH: 13.35%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 1.48%; TOP: 97.99%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:207;" HDX_LOCK="-1">Server Log</DIV>]]></content></html></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=pblog title="Click to see the Server log" class=hsc.button.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 4.45%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 13.54%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 1.48%; BORDER-RIGHT-COLOR: #ffffff; TOP: 93.54%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #a0a0a4" type=button value="Log " hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" HDX_LOCK="-1" BaseFilterTranslateSQLchars="" BaseFilterXML="" BaseFilter="">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[ilog = "log.txt"]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=pbSrlogMan class=hvg.textbox.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 2%; FONT-FAMILY: Arial; WIDTH: 13.35%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 17.03%; TOP: 97.99%; BEHAVIOR: url(#HDXVectorFactory#text)" hdxproperties="fillColorBlink:False;FillStyle:1;Height:18;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:207;" HDX_LOCK="-1">Log for Sysrep.exe</DIV>]]></content></html></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=pbSrlog title="Click to see the srlog" class=hsc.button.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 4.45%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 13.54%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 17.03%; BORDER-RIGHT-COLOR: #ffffff; TOP: 93.54%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #a0a0a4" type=button value="srLog " hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" HDX_LOCK="-1" BaseFilterTranslateSQLchars="" BaseFilterXML="" BaseFilter="">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[ilog = "srlog.txt"]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" variantty