<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="144px" height="58px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="\\HCUSRV1A\abstract\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="Tagname" type="Point" description="Point Name" defaultvalue=""/><parameter name="cp_pv" type="Parameter" description="" defaultvalue="DIGACQA.PVFL"/><parameter name="RunningState" type="Text" description="" defaultvalue="ON"/><parameter name="cp_healthy" type="Parameter" description="" defaultvalue="HEALTHY.PVFL"/><parameter name="HealthyState" type="Text" description="" defaultvalue="ON"/><parameter name="cp_almenbstate" type="Parameter" description="Alarm Enable State" defaultvalue="almenbstate"/><parameter name="cp_execstate" type="Parameter" description="Point Execution State" defaultvalue="execstate"/><parameter name="ContextMenuFile" type="Text" description="Context Menu Filename" defaultvalue="sp_sysdtlKIN_sm.xml"/><parameter name="FaceplateFile" type="Text" description="Custom Faceplate File" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=OvalBody class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 41.37%; FONT-FAMILY: Arial; WIDTH: 16.66%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 13.88%; TOP: 31.03%; BEHAVIOR: url(#HDXVectorFactory#oval) url(#BindingBehavior)" hdxproperties="BreakpointType:0;ContinuousColors:16777181_65535_65280_16777215_13434880_16711935_255_12632256_0;ContinuousValues:0_0_0_0_0_0_0_0;FillColor:#c0c0c0;fillColorBlink:False;HDXBINDINGID:-4;Height:24;LineColor:#000000;lineColorBlink:False;Width:24;"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="1"/><property name="PointRefPointName" varianttype="VT_BSTR" value=""/><property name="PointRefParamName" varianttype="VT_BSTR" value="PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.HVG" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=OvalBodyH class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 20.68%; FONT-FAMILY: Arial; WIDTH: 8.33%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 18.05%; TOP: 41.37%; BEHAVIOR: url(#HDXVectorFactory#oval) url(#BindingBehavior)" hdxproperties="FillColor:#c0c0c0;fillColorBlink:False;HDXBINDINGID:-4;Height:12;LineColor:#000000;lineColorBlink:False;Width:12;"></DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=textbox001 class=hvg.textbox.1 style="FONT-SIZE: 10pt; OVERFLOW: hidden; HEIGHT: 29.31%; FONT-FAMILY: Arial; WIDTH: 11.11%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 17.36%; TOP: 37.93%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: inherit" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:17;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:16;">t</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ScConAlpPV class="hsc.alpha.1 hsc.faceplate.1 HSC.ScriptDataObject.1 ScConAlpPV" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: ; BORDER-LEFT-STYLE: none; HEIGHT: 6.89%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 3.47%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; COLOR: #000000; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 11.11%; BORDER-RIGHT-COLOR: transparent; TOP: 65.51%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HDXPopupBehavior#Faceplate) url(#HSCScriptDataBehavior); VISIBILITY: visible; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderWidth:;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:Color_OtherState;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;styleClass:ScConAlpPV;textColor:#000000;textColorBlink:False;" printDisplayValue="9999.99" globalscripts>State</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[dim oShape, oRunningState, oHealthyState, oHealthy
'on error resume next

set oShape = me.parentnode.parentnode
    oRunningState = oShape.getcustomproperty("text","RunningState")
	oHealthyState = oShape.getcustomproperty("text","HealthyState")

oHealthy = me.DataValue("TagName.cp_healthy")

If me.value = oRunningState Then
OvalBody.fillColor = &h329632
	If oHealthy = oHealthyState Then
	OvalBodyH.fillColor = &h329632
	Else 
	OvalBodyH.fillColor = vbred
	End If
Else 
OvalBody.fillColor = &hC0C0C0
	If oHealthy = oHealthyState Then
	OvalBodyH.fillColor = &hC0C0C0
	Else 
	OvalBodyH.fillColor = vbred
	End If
End If]]></script><script event="onupdate" language="VBScript"><![CDATA[dim oShape, oRunningState, oHealthyState, oHealthy
'on error resume next

set oShape = me.parentnode.parentnode
    oRunningState = oShape.getcustomproperty("text","RunningState")
	oHealthyState = oShape.getcustomproperty("text","HealthyState")

oHealthy = me.DataValue("TagName.cp_healthy")

If me.value = oRunningState Then
OvalBody.fillColor = &h329632
	If oHealthy = oHealthyState Then
	OvalBodyH.fillColor = &h329632
	Else 
	OvalBodyH.fillColor = vbred
	End If
Else 
OvalBody.fillColor = &hC0C0C0
	If oHealthy = oHealthyState Then
	OvalBodyH.fillColor = &hC0C0C0
	Else 
	OvalBodyH.fillColor = vbred
	End If
End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_pv%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tagname%},{%Point::Tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_execstate%},{%Parameter::cp_healthy%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,1,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.Alarm" refcount="1"/><class ID="HSC.AlphaReadOnl