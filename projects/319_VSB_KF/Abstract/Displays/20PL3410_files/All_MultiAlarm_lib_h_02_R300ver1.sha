<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="24px" height="26px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="C:\ProgramData\Honeywell\Experion PKS\Client\Abstract\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="tagname" type="Point" description="Descriptor shown in tooltip" defaultvalue=""/><parameter name="AlmTag1" type="Point" description="Alarm Tag 1" defaultvalue=""/><parameter name="AlmTag2" type="Point" description="Alarm Tag 2" defaultvalue=""/><parameter name="cp_AlmPar1" type="Parameter" description="Alarm Tag 1 Parameter" defaultvalue="PV"/><parameter name="cp_AlmPar2" type="Parameter" description="Alarm Tag 2 Parameter" defaultvalue="DACA.BADPVALM.FL"/><parameter name="FaceplateFile1" type="Text" description="Custom Faceplate File" defaultvalue=""/><parameter name="FaceplateFile2" type="Text" description="Custom Faceplate File" defaultvalue=""/><parameter name="cp_custtrd" type="Num" description="Custom Trend Group Number" defaultvalue=""/><parameter name="cp_custgrp" type="Num" description="Custom Group Number" defaultvalue=""/><parameter name="cm_label" type="Text" description="Context Menu Help Item Text" defaultvalue="Help"/><parameter name="cm_file" type="Text" description="Help File Name" defaultvalue=""/><parameter name="ContextMenuFile1" type="Text" description="Context Menu Filename" defaultvalue="sp_sysdtlmultalm_sm.xml"/><parameter name="ContextMenuFile2" type="Text" description="Context Menu Filename" defaultvalue="sp_sysdtlmultalm_sm.xml"/><parameter name="Revision" type="Num" description="Revision" defaultvalue="R300 Rev.0"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=ScConAlpPV class="hsc.alpha.1 hsc.faceplate.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 11.53%; FONT-FAMILY: Arial; WIDTH: 8.33%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 45.83%; TOP: 42.3%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HDXPopupBehavior#Faceplate) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[call Multiple_Alarm_Icon(me)

if me.datavalue("AlmTag1.cp_AlmPar1") = 0 and me.datavalue("AlmTag2.cp_AlmPar2")=0 then
   ConAlarmState1.Priority=1
   ConAlarmState1.Style.Visibility = "inherit"
   'ConAlarmState1.Acknowledged=1
   ConAlarmState1.Rtn=False
   ConAlarmState2.Priority=0
   ConAlarmState2.Style.Visibility = "hidden"
else
   if me.datavalue("AlmTag1.cp_AlmPar1") = 0 and me.datavalue("AlmTag2.cp_AlmPar2")=1 then
      ConAlarmState1.Priority=1
      ConAlarmState1.Style.Visibility = "inherit"
      ConAlarmState1.Rtn=False
      ConAlarmState2.Priority=1
      ConAlarmState2.Style.Visibility = "inherit"
      ConAlarmState2.Rtn=False
   else
      if me.datavalue("AlmTag1.cp_AlmPar1") = 1 and me.datavalue("AlmTag2.cp_AlmPar2")=1 then
	     ConAlarmState1.Priority=0
         ConAlarmState1.Style.Visibility = "hidden"
		 ConAlarmState2.Priority=1
         ConAlarmState2.Style.Visibility = "inherit"
         ConAlarmState2.Rtn=False
      else
         ConAlarmState1.Priority=0
         ConAlarmState2.Rtn=True
		 ConAlarmState1.Acknowledged=True
         ConAlarmState1.Style.Visibility = "inherit"
		 ConAlarmState2.Priority=0
         ConAlarmState2.Style.Visibility = "hidden"
      end if
   end if
end if
on error resume next]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::AlmTag1%},{%Point::AlmTag2%},{%Point::AlmTag1%},{%Point::AlmTag2%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="alarmdisabled,almenbstate,{%Parameter::cp_AlmPar1%},{%Parameter::cp_AlmPar2%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
