<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="14px" height="16px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><parameters><parameter name="Tagname" type="Point" description="" defaultvalue=""/><parameter name="cp_ma" type="Parameter" description="" defaultvalue="devctla.modeattrfl.prog"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=TxtMode class="hvg.textbox.1 TxtMode_not_in_NMode HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; COLOR: #dddddd; TEXT-ALIGN: center; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:#808080;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:16;lineColorBlink:False;LineStyle:0;styleClass:TxtMode_not_in_NMode;textColor:#DDDDDD;textColorBlink:False;TotalRotation:-1;Width:14;"></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[IF me.DataValue("Tagname.cp_ma")=1 then
	me.value = "P"
	me.fillColor = "#C0C0C0"
	me.textColor = "#000000"
ELSE
	me.value = "O"
	me.fillColor = "#808080"
	me.textColor = "#DDDDDD"
END IF]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_ma%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=face class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:16;LineColor:transparent;lineColorBlink:False;Width:14;"></DIV>]]></content></html></element><html><content><![CDATA[
<DIV tabIndex=-1 id=progoper class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 16px; WIDTH: 14px; POSITION: absolute; LEFT: 33px; TOP: 87px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:14;"></DIV>]]></content></html></group></shape></shapes></shapefile>