<DIV tabIndex=-1 id=AlarmState title="Low, Active, Acknowledged" class="hsc.alarmstate.1 hsc.faceplate.1" style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; WHITE-SPACE: nowrap; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior) url(#HDXPopupBehavior#Faceplate)" hdxproperties="acknowledged:True;HDXBINDINGID:-4;priority:1;quality:192;rtn:False;showDisableIcon:True;showTooltip:True;sizeableIcon:False;staticIcon:True;" ObjectType="6"></DIV>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=ScConAlpPV class="hsc.alpha.1 hsc.faceplate.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 0%; FONT-FAMILY: Arial; WIDTH: 0%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 0%; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HDXPopupBehavior#Faceplate) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: white; ROWS: 1" hdxproperties="fillColor:white;fillColorBlink:False;HDXBINDINGID:-4;lineColor:black;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;" SHORTCUTMENUCUSTOM="0">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[call Scd_Dev_Alarm_Icon(me,3)]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::AlmTag1%},{%Point::AlmTag1%},{%Point::AlmTag2%},{%Point::AlmTag2%},{%Point::AlmTag3%},{%Point::AlmTag3%},"/><propert