oShapeID=me.parentnode.parentnode.id

s=0
for i=1 to 10
	s=s+document.getelementbyid(oShapeID & "_ConAlpPeerCon" & i).value 
next


TxtSumPeerPPS.value=formatNumber(s,2) 
