<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="88px" height="48px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><parameters><parameter name="HSTag" type="Point" description="" defaultvalue="HS"/><parameter name="Pmp1" type="Point" description="" defaultvalue="HX"/><parameter name="Pmp2" type="Point" description="" defaultvalue="HX"/><parameter name="cv_gop" type="Parameter" description="" defaultvalue="DEVCTLA.GOP"/><parameter name="Text1" type="Text" description="" defaultvalue="P-9998"/><parameter name="Text2" type="Text" description="" defaultvalue="P-9999"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=t2 class=hvg.textbox.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 41.66%; FONT-FAMILY: Arial; WIDTH: 95.45%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 2.27%; TOP: 52.08%; BEHAVIOR: url(#HDXVectorFactory#text)  url(#BindingBehavior)" hdxproperties="FillColor:#d4d0c8;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:20;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:84;">{%Text::Text2%} </DIV>]]></content></html><binding/></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=scT1 class="hvg.textbox.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 41.66%; FONT-FAMILY: Arial; WIDTH: 95.45%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 2.27%; TOP: 52.08%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:#d4d0c8;fillColorBlink:False;FillStyle:0;HDXBINDINGID:-4;Height:20;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:84;">{%Text::Text1%} </DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[IF me.DataValue("HSTag.cv_gop")=4 Then
	scT1.style.visibility = "inherit"
	r1.style.visibility = "inherit"
	r2.style.visibility = "hidden"
	t2.style.visibility = "hidden"
	
Else
	scT1.style.visibility = "hidden"
	r1.style.visibility = "hidden"
	r2.style.visibility = "inherit"
	t2.style.visibility = "inherit"
	
End IF]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::HSTag%},{%Point::Pmp1%},{%Point::Pmp2%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cv_gop%},EXECSTATE,EXECSTATE,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="5,5,5,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=scBtn1 class=hsc.button.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; BORDER-TOP: #ffffff 2px outset; HEIGHT: 50%; FONT-FAMILY: Arial; BORDER-RIGHT: #ffffff 2px outset; WIDTH: 100%; BACKGROUND-REPEAT: no-repeat; BORDER-BOTTOM: #ffffff 2px outset; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; LEFT: 0%; BORDER-LEFT: #ffffff 2px outset; TOP: 47.91%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: transparent" type=button hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColor:#000000;textColorBlink:False;">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[  '0 = LVL 1
  '1 = LVL 2
  '2 = Operator
  '3 = Supervisor
  '4 = Engineer
  '5 = Manager
  Dim Level
  'Set Level variable on page loading
  Level = window.external.SecurityLevel
  'Check for presence of manager mode.        
  If Level = 5 Then


if msgbox("Заменить насос?", vbYesNo) = vbYes then

	IF scT1.DataValue("HSTag.cv_gop")=4 then
	scT1.DataValue("HSTag.cv_gop")=5
	scT1.DataValue("Pmp2.EXECSTATE")=1
	scT1.DataValue("Pmp1.EXECSTATE")=0
	Else
	scT1.DataValue("HSTag.cv_gop")=4
	scT1.DataValue("Pmp2.EXECSTATE")=0
	scT1.DataValue("Pmp1.EXECSTATE")=1

End If
end if

Else
window.external.MessageZoneText = "Недостаточно прав для замены насоса. Вызовите Антона Анисимова."
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=Btn2 class=hsc.button.1 style="FONT-SIZE: 10pt; TEXT-DECORATION: none; HEIGHT: 50%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 100%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 0%; BORDER-RIGHT-COLOR: #ffffff; TOP: 0%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #d4d0c8" type=button value=НАРАБОТКА hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;">]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value=""/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[
