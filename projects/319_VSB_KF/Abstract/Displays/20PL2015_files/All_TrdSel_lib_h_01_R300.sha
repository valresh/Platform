<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="128px" height="24px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="D:\WORK\KIRISHI\Displays\CSS\sp.css"/></stylesheets><scripts><script event="" language="VBScript" id="F2D41784-CE8D-4F80-AC6A-8D79F73B61EC"><![CDATA[sub AllTrdSel_CMenu
	on error resume next
	hdxpopupbehavior.invokeshortcutmenu window.event.srcelement.parentnode.parentnode.getcustomproperty ("Text","ContextMenuFile"), 0, 0
end sub]]></script><script event="onshapeload" language="VBScript" id=""><![CDATA[on error resume next
Page.SetAttribute "TrdSel",me.id

  s=document.url
  p=instrrev(s,"\")
  p1=instrrev(s,".htm")
  s=mid(s,p,p1-p)

  su1="url(." & s & "_files\All_TrdSel_lib_h_01_R300_files\up1.gif)"
  su10="url(." & s & "_files\All_TrdSel_lib_h_01_R300_files\up10.gif)"	
  sl1="url(." & s & "_files\All_TrdSel_lib_h_01_R300_files\lo1.gif)"
  sl10="url(." & s & "_files\All_TrdSel_lib_h_01_R300_files\lo10.gif)"

document.getelementbyid(me.id &"_PbUp10").style.backgroundImage=su10
document.getelementbyid(me.id &"_PbUp1").style.backgroundImage=su1
document.getelementbyid(me.id &"_PbLo1").style.backgroundImage=sl1
document.getelementbyid(me.id &"_PbLo10").style.backgroundImage=sl10]]></script></scripts><parameters><parameter name="ContextMenuFile" type="Text" description="" defaultvalue="sp_alltrdsel_sm.xml"/><parameter name="Revision" type="Num" description="Rev.0" defaultvalue="R300"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=recFrame class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 91.66%; FONT-FAMILY: Arial; WIDTH: 99.21%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 4.16%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;Height:22;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:127;"></DIV>]]></content></html></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=PbLo10 class="hsc.button.1 Buttons" style="FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Courier New; BORDER-TOP-COLOR: #ffffff; WIDTH: 15.62%; BACKGROUND-IMAGE: url(file:./All_TrdSel_lib_h_01_R300_files/lo10.gif); BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 0%; BORDER-RIGHT-COLOR: #ffffff; TOP: 0%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #d4d0c8" type=button hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;styleClass:Buttons;textColor:#000000;textColorBlink:False;" shapesrc=".\All_TrdSel_lib_h_01_R300_files\lo10.gif">]]></content><scripts><script event="oncontextmenu" language="VBScript"><![CDATA[call AllTrdSel_CMenu]]></script><script event="onclick" language="VBScript"><![CDATA[if alptrendgrp.value>10 then
   alptrendgrp.value=alptrendgrp.value-10
else
   alptrendgrp.value=1
end if
window.external.Dictionary.Item("TrendNo").value=alptrendgrp.value
call alptrendgrp.onchange]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=Pblo1 class="hsc.button.1 Buttons" style="FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Courier New; BORDER-TOP-COLOR: #ffffff; WIDTH: 15.62%; BACKGROUND-IMAGE: url(file:./All_TrdSel_lib_h_01_R300_files/lo1.gif); BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 15.62%; BORDER-RIGHT-COLOR: #ffffff; TOP: 0%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); BACKGROUND-COLOR: #d4d0c8" type=button hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;styleClass:Buttons;textColor:#000000;textColorBlink:False;" shapesrc=".\All_TrdSel_lib_h_01_R300_files\lo1.gif">]]></content><scripts><script event="oncontextmenu" language="VBScript"><![CDATA[call AllTrdSel_CMenu]]></script><script event="onclick" language="VBScript"><![CDATA[if alptrendgrp.value>1 then
