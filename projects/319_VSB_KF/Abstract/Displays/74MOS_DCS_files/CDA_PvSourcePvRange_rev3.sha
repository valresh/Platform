<DIV tabIndex=-1 id=RecFrame008 class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 83.33%; FONT-FAMILY: Arial; WIDTH: 8.67%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 18.43%; TOP: 4.16%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;FillStyle:0;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:103;" globalscripts></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=PVAUTOEU class="hsc.alpha.1 ScConAlpPV" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 79.16%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 8.67%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; COLOR: #000000; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 18.35%; BORDER-RIGHT-COLOR: transparent; TOP: 8.33%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HoverBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderWidth:;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.3f;styleClass:ScConAlpPV;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Null%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Null%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="Hsc.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ScConAlpTrips class="hsc.alpha.1  HSC.ScriptDataObject.1 " style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 79.16%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 1.34%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; COLOR: #000000; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 27.1%; BORDER-RIGHT-COLOR: transparent; TOP: 8.33%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)   url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: #ffff00; ROWS: 1" hdxproperties="borderWidth:;fillColor:#ffff00;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;styleClass:;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim EURange, Current1, Current2, A, B

A = me.DataValue("tagname.cp_pveuhi")
B = me.datavalue("tagname.cp_pveulo")
EURange = A - B

if me.value<>"NaN" then
Current1 = me.value
pveu.value=(Current1*EURange)/100+B
else
pveu.value="- - - -"
end if

if me.datavalue("tagname.cp_pvauto")<>"NaN" then
Current2 = me.datavalue("tagname.cp_pvauto")
pvautoeu.value=(Current2*EURange/100)+B
else
pvautoeu.value="-----"
end if

if  PVEU.value="1.#QNAN" then
PVEU.value="- - - -"
end if

if  PVAUTOEU.value="1.#QNAN" then
PVAUTOEU.value="- - - -"
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_pv%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_pveulo%},{%Parameter::cp_pveuhi%},{%Parameter::cp_pv%},{%Parameter::cp_pvauto%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,"/>