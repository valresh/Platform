<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="144px" height="70px"><versionheaders><versionheader name="PS" value="5.511"/></versionheaders><stylesheets><stylesheet src="D:\WORK\KIRISHI\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="tagname" type="Point" description="Point Name" defaultvalue=""/><parameter name="cp_FailState" type="Text" description="Fail State - &quot;FC&quot; or &quot;FO&quot;" defaultvalue="FC"/><parameter name="cp_op" type="Parameter" description="OP" defaultvalue="pida.op"/><parameter name="cp_badctlfl" type="Parameter" description="Bad Control Flag" defaultvalue="pida.badctlfl"/><parameter name="cp_execstate" type="Parameter" description="Point Execution State" defaultvalue="execstate"/><parameter name="cp_TagnameEU" type="Text" description="[Custom Name]" defaultvalue=""/><parameter name="ClosedValue" type="Num" description="Value below which the valve is assumed to be closed" defaultvalue="5"/><parameter name="Openvalue" type="Num" description="Value above which valve is asumed to be open" defaultvalue="95"/><parameter name="cp_styleForClose" type="Style" description="CSS style for State Closed" defaultvalue="RegValve_Close"/><parameter name="cp_styleForOpen" type="Style" description="CSS style for State Open" defaultvalue="RegValve_Open"/><parameter name="cp_styleForInbet" type="Style" description="CSS style for Inbetween" defaultvalue="RegValve_Inbet"/><parameter name="Trd_PointPV" type="Parameter" description="Trace to be added to trend group" defaultvalue="Tagname.pida.pv"/><parameter name="Trd_PointOP" type="Parameter" description="Trace to be added to trend group" defaultvalue="Tagname.cp_op"/><parameter name="FaceplateFile" type="Text" description="Custom Faceplate File" defaultvalue=""/><parameter name="cp_custtrd" type="Num" description="Custom Trend Group Number" defaultvalue=""/><parameter name="cp_custgrp" type="Num" description="Custom Gro