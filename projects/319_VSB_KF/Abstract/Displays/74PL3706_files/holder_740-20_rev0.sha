sub OnStageUpdate(oSource)

dim iStep, oStage, iStageNum

on error resume next

set oShape=oSource.parentnode.parentnode
iStep=oSource.DataValue("Tagname.cp_pv")
set oStage=oShape.Objects("RecPV")
iStageNum=oShape.getCustomProperty("Value","StageNum")

oStage.fillColor="#696969"

select case iStep
	case 0		if iStageNum=0 then 
				oStage.fillColor="#C8C800"
				end if
	case 1		if iStageNum=1 then 
