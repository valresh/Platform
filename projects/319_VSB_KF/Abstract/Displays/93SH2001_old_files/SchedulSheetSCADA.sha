<DIV tabIndex=-1 id=AssocDsplButton class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 4.74%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 28.85%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#polygon)  url(#BindingBehavior)" hdxproperties="FillColor:#c0c0c0;fillColorBlink:False;HDXBINDINGID:-4;Height:20;indicateScanState:False;LineColor:#808080;lineColorBlink:False;points:0.000000 0.000000 0.000000 100.000000 83.333336 100.000000 100.000000 50.000000 83.333336 0.000000 0.000000 0.000000 ;Width:24;"></DIV>]]></content></html><binding/></element><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=AssocDisplay class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 3.95%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #c0c0c0; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 28.85%; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;lineColor:transparent;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%s;textColor:#c0c0c0;textColorBlink:False;">Text</TEXTAREA>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[dim oTemp, oSheip, oConst
on error resume next
oTemp = me.Value
Set oSheip = me.parentnode.parentnode
oConst = oSheip.getcustomproperty("Text","CustAssocDspl")
If oConst <> "" then 
	window.external.currentpage=oConst
		else
	window.external.currentpage=oTemp
End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="AssociatedDisplay"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="12"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="AssociatedDisplay,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="-2,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group001 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 22px; WIDTH: 506px; POSITION: absolute; LEFT: -70px; TOP: 47px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:22;lineColorBlink:False;Width:506;"></DIV>]]></content></html></group></shape></shapes></shapefile>