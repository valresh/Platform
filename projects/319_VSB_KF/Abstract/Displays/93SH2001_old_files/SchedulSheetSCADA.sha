<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="506px" height="22px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="\\HCUSRV1A\abstract\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="tagname" type="Point" description="Automatically added Point" defaultvalue=""/><parameter name="cp_pv" type="Parameter" description="" defaultvalue="PV"/><parameter name="FaceplateFile" type="Text" description="Custom Faceplate File" defaultvalue=""/><parameter name="ContextMenuFile" type="Text" description="Context Menu Filename" defaultvalue="sp_sysdtlKIN_sm.xml"/><parameter name="CustAssocDspl" type="Text" description="Custom Associated Display" defaultvalue=""/><parameter name="Trd_PointPV" type="Parameter" description="Trace to be added to trend group" defaultvalue="Tagname.cp_pv"/><parameter name="cp_almenbstate" type="Parameter" description="Alarm Enable State" defaultvalue="alarmdisabled"/><parameter name="pvformat" type="Text" description="Numeric Display Format - a number between 0-6" defaultvalue=""/><parameter name="TaglimitName" type="Point" description="Name display" defaultvalue="20SH0001"/><parameter name="LimitLO" type="Parameter" description="" defaultvalue="NUMERIC_LO"/><parameter name="LimitHI" type="Parameter" description="" defaultvalue="NUMERIC_HI"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ConAlarmState title="Bad Quality, Urgent, Active, Acknowledged" class=hsc.alarmstate.1 style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 4.34%; WHITE-SPACE: nowrap; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 24.11%; TOP: 0%; BEHAVIOR: url(#AlarmStateIconFactory#AlarmIcon) url(#BindingBehavior)" hdxproperties="acknowledged:true;HDXBINDINGID:-4;priority:3;quality:0;rtn:false;showDisableIcon:True;showTooltip:True;staticIcon:false;" ObjectType="6"></DIV>]]></content></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="6"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_almenbstate%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.AlarmState" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=TxtName002 class="hvg.textbox.1 " style="FONT-SIZE: 10pt; OVERFLOW: hidden; HEIGHT: 72.72%; FONT-FAMILY: Arial; WIDTH: 23.91%; POSITION: absolute; COLOR: #000000; TEXT-ALIGN: right; LEFT: 0%; TOP: 13.63%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: visible" hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#000000;textColorBlink:False;TotalRotation:-1;value:;Width:121;">{%Point::TagName%} </DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ScTxtSelectBox class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 22.13%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 32.6%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;FillStyle:0;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:112;" globalscripts></DIV>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[call All_OnClick(me)]]></script><script event="oncontextmenu" language="VBScript"><![CDATA[call All_OnCMenu(me)]]></script></scripts></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ScConAlpPV class="hsc.alpha.1 ScConAlpPV HSC.ScriptDataObject.1 hsc.faceplate.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 22.13%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; COLOR: #000000; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 32.6%; BORDER-RIGHT-COLOR: transparent; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior) url(#HSCScriptDataBehavior) url(#HDXPopupBehavior#Faceplate); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderWidth:;durationFormat:-1;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:black;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;styleClass:ScConAlpPV;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim sFormat, oShape, nNumericFormat
on error resume next
If (me.value > LimitHI.value and LimitHI.value <> "NaN") or (me.value < LimitLO.value and LimitLO.value <> "NaN") or me.value = "NaN" Then
   me.fillcolor = vbred
     If me.value > LimitHI.value and LimitHI.value <> "NaN" Then
        LimitHI.fillColor = vbred
	 else LimitHI.fillColor = &hDDDDDD
	 end if
	 If me.value < LimitLO.value and LimitLO.value <> "NaN" Then
        LimitLO.fillColor = vbred
	 else LimitLO.fillColor = &hDDDDDD
	 end if
else me.fillcolor= &hDDDDDD
     LimitHI.fillColor = &hDDDDDD
     LimitLO.fillColor = &hDDDDDD
end if
set oShape = me.parentnode.parentnode
    nNumericFormat = oShape.getcustomproperty("text","pvformat")
    sFormat="%." & nNumericFormat & "f"
  	oShape.objects("ScConAlpPV").numericdisplayformat=sFormat
	oShape.objects("LimitHI").numericdisplayformat=sFormat
	oShape.objects("LimitLO").numericdisplayformat=sFormat]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_pv%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::tagname%},{%point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="EULO,EUHI,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=RecFrame008 class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 22.13%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 77.66%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;FillStyle:0;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:112;" globalscripts></DIV>]]></content></html></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=RecFrame009 class="hvg.base.1 RecFrame" style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 22.13%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 55.13%; TOP: 4.54%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:#DDDDDD;fillColorBlink:False;FillStyle:0;Height:20;LineColor:#969696;lineColorBlink:False;styleClass:RecFrame;Width:112;" globalscripts></DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=LimitLO class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 22.13%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 55.13%; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HoverBehavior)    url(#HSCScriptDataBehavior); VISIBILITY: inherit; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;HDXBINDINGID:-4;indicateAlarmState:0;lineColor:black;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;">9999.99</TEXTAREA>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[on error resume next
me.DataValue("TaglimitName.{%Parameter::LimitLO%}.PVLOLM") = ScConAlpPV.DataValue("TagName.EULO")
me.DataValue("TaglimitName.{%Parameter::LimitLO%}.PVHILM") = ScConAlpPV.DataValue("TagName.EUHI")]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TaglimitName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::LimitLO%}.PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::taglimitname%},{%point::taglimitname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::LimitLO%}.PVLOLM,{%Parameter::LimitLO%}.PVHILM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.Alpha" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=LimitHI class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 90.9%; FONT-FAMILY: Arial; WIDTH: 22.13%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 77.66%; TOP: 4.54%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)   url(#HoverBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:transparent;HDXBINDINGID:-4;indicateScanState:0;lineColor:black;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;">9999.99</TEXTAREA>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[on error resume next
me.DataValue("TaglimitName.{%Parameter::LimitHI%}.PVLOLM") = ScConAlpPV.DataValue("TagName.EULO")
me.DataValue("TaglimitName.{%Parameter::LimitHI%}.PVHILM") = ScConAlpPV.DataValue("TagName.EUHI")]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::TaglimitName%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::LimitHI%}.PV"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%point::taglimitname%},{%point::taglimitname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::LimitHI%}.PVLOLM,{%Parameter::LimitHI%}.PVHILM,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT