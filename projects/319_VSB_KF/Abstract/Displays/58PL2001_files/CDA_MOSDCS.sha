<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="20px" height="20px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="\\HCUSRV1A\abstract\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="tagname" type="Point" description="Point Name" defaultvalue=""/><parameter name="cp_pvsource" type="Parameter" description="PVSOURCE" defaultvalue="pvsource"/><parameter name="cp_Display" type="Text" description="mos_dcs display" defaultvalue=".htm"/><parameter name="cp_popup" type="Text" description="mos_dcs popup" defaultvalue=".htm"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=PVSOURCE class=hsc.alpha.1 style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 10%; FONT-FAMILY: Arial; WIDTH: 10%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 40%; TOP: 50%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HoverBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: #ffffff; ROWS: 1" hdxproperties="durationFormat:-1;fillColor:#ffffff;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:#000000;numberOfChars:9;numericDisplayFormat:%s;textColor:#000000;textColorBlink:False;">State</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA['dim AlmDtls
if PVSOURCE<>"AUTO" then
MO_DCS.textColor=vbred
'Set AlmDtls=Server.CreateAlarmDetails
'AlmDtls.Description = "Включена деблокация аналогового входа"
'AlmDtls.Priority = hscUrgent
'AlmDtls.Area = ""
'Server.GenerateAlarm AlmDtls
else MO_DCS.textcolor=vbBlack
end if]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="0"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_pvsource%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=MO_DCS class=hvg.textbox.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text) url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:20;indicateAlarmState:False;indicateScanState:False;lineColorBlink:False;LineStyle:0;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:20;">M</DIV>]]></content><scripts><script event="oncontextmenu" language="VBScript"><![CDATA[dim oTemp1
on error resume next
oTemp1 = PVSOURCE.parentElement.parentElement.getCustomProperty("Text","cp_popup")
window.external.currentpage=oTemp1
PVSOURCE.focus]]></script><script event="onclick" language="VBScript"><![CDATA[dim oTemp
on error resume next
oTemp = PVSOURCE.parentElement.parentElement.getCustomProperty("Text","cp_Display")
window.external.currentpage=oTemp]]></script></scripts></html><binding/></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group002 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 20px; WIDTH: 20px; POSITION: absolute; LEFT: 65px; TOP: 25px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="FillColor:#ffffff;fillColorBlink:False;Height:20;lineColorBlink:False;textColor:#000000;textColorBlink:False;Width:20;"></DIV>]]></content></html></group></shape></shapes></shapefile>