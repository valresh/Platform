<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="76px" height="32px"><versionheaders><versionheader name="PS" value="6.11"/></versionheaders><stylesheets><stylesheet src="C:\ProgramData\Honeywell\Experion PKS\Client\Abstract\CSS\sp.css"/></stylesheets><scripts><script event="onshapeload" language="VBScript" id=""><![CDATA[on error resume next

  s=document.url
  p=instrrev(s,"\")
  p1=instrrev(s,".htm")
  s=mid(s,p,p1-p)

  sl="url(." & s & "_files\All_NavTitle_lib_01_R300_files\left.gif)"
  sr="url(." & s & "_files\All_NavTitle_lib_01_R300_files\right.gif)"	
  su="url(." & s & "_files\All_NavTitle_lib_01_R300_files\up.gif)"
  sd="url(." & s & "_files\All_NavTitle_lib_01_R300_files\down.gif)"

document.getelementbyid(me.id &"_ScPbLeft").style.backgroundImage=sl
document.getelementbyid(me.id &"_ScPbRight").style.backgroundImage=sr
document.getelementbyid(me.id &"_ScPbUp").style.backgroundImage=su
document.getelementbyid(me.id &"_ScPbDown").style.backgroundImage=sd

if me.getcustomproperty("text","cp_left")="" then 
  document.getelementbyid(me.id &"_ScPbLeft").disabled=true
  document.getelementbyid(me.id &"_ScPbLeft").title="Display is not configured"
else
  document.getelementbyid(me.id &"_ScPbLeft").title=me.getcustomproperty("text","cp_left")
end if
if me.getcustomproperty("text","cp_right")="" then 
  document.getelementbyid(me.id &"_ScPbRight").disabled=true
  document.getelementbyid(me.id &"_ScPbRight").title="Display is not configured"
else
  document.getelementbyid(me.id &"_ScPbRight").title=me.getcustomproperty("text","cp_right")
end if
if me.getcustomproperty("text","cp_up")="" then 
  document.getelementbyid(me.id &"_ScPbUp").disabled=true
  document.getelementbyid(me.id &"_ScPbUp").title="Display is not configured"
else
  document.getelementbyid(me.id &"_ScPbUp").title=me.getcustomproperty("text","cp_up")
end if
if me.getcustomproperty("text","cp_down")="" then 
  document.getelementbyid(me.id &"_ScPbDown").disabled=true
  document.getelementbyid(me.id &"_ScPbDown").title="Display is not configured"
else
  document.getelementbyid(me.id &"_ScPbDown").title=me.getcustomproperty("text","cp_down")
end if]]></script></scripts><parameters><parameter name="cp_left" type="text" description="Display Left" defaultvalue=""/><parameter name="cp_right" type="text" description="Display Right" defaultvalue=""/><parameter name="cp_up" type="text" description="Display Up" defaultvalue=""/><parameter name="cp_down" type="text" description="Display Down" defaultvalue=""/></parameters><shapes><shape><group><element><html><content><![CDATA[
