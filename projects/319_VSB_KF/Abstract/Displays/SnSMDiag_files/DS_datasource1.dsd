	&lt;CommandGroup id="ContextMenuGroup"&gt;
		&lt;StandardCommand id="Command_Acknowledge" Command="Acknowledge"&gt;
						&amp;lt;div title="Acknowledge the selected alarm" style="width: 100%;"&amp;gt;
						&amp;lt;img style="position: relative; top: 2px; left: 2px; margin-right: 3px;" src="res://AlarmStateIcon/PNG/#357"&amp;gt;
						&amp;amp;nbsp;Acknowledge alarm
						&amp;lt;/div&amp;gt;
					&lt;/StandardCommand&gt;
		&lt;StandardCommand id="Command_PointDetail" Command="PointDetail"&gt;
						&amp;lt;div title="Navigate to the detail page of the selected alarm" style="padding: 1px; width: 100%;"&amp;gt;
						&amp;lt;img style="position: relative; top: 2px; left: 2px; margin-right: 3px;" src="res://AlarmStateIcon/PNG/#362"&amp;gt;
						&amp;amp;nbsp;Detail display
						&amp;lt;/div&amp;gt;
					&lt;/StandardCommand&gt;
		&lt;StandardCommand id="Command_AssociatedDisplay" Command="AssociatedDisplay"&gt;
						&amp;lt;div title="Navigate to the associated display of the selected alarm" style="padding: 1px; width: 100%;"&amp;gt;
						&amp;lt;img style="position: relative; top: 2px; left: 3px; margin-right: 3px;" src="res://AlarmStateIcon/PNG/#359"&amp;gt;
						&amp;amp;nbsp;Associated display
						&amp;lt;/div&amp;gt;
					&lt;/StandardCommand&gt;
		&lt;ScriptCommand id="Command_AlarmHelp" script="if (window.external.application.CurrentPointID != null &amp;amp;&amp;amp; window.external.application.CurrentPointID != '') {var displayname = 'sysalarmhelp_fp?PointName='+String(window.external.application.CurrentPointID); window.external.application.InvokePopup2(displayname, 0, 0, 1, false); }" language="jscript"&gt;
						&amp;lt;div title="Display alarm help for the selected alarm" style="padding: 1px; width: 100%;"&amp;gt;
						&amp;lt;img style="position: relative; top: 2px; left: 3px; margin-right: 3px;" src="res://AlarmStateIcon/PNG/#358"&amp;gt;
						&amp;amp;nbsp;Alarm Help
						&amp;lt;/div&amp;gt;
					&lt;/ScriptCommand&gt;
		&lt;ScriptCommand id="ContextMenu_ProcedureExplorer" script="window.external.application.InvokeProcedureExplorer(DisplayDataRepository.GetValue('#SelectedNotifSourceTagName#'));" language="jscript"&gt;
						&amp;lt;div title="Open the Procedure Explorer" style="padding: 1px; width: 100%;"&amp;gt;
						&amp;lt;img style="position: relative; top: 2px; left: 3px; margin-right: 3px;" src="res://AlarmStateIcon/PNG/#363"&amp;gt;
						&amp;amp;nbsp;Procedure Explorer
						&amp;lt;/div&amp;gt;
					&lt;/ScriptCommand&gt;
	&lt;/CommandGroup&gt;
