<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="144px" height="62px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="Z:\WORK\KIRISHI\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="tagname_OPEN" type="Point" description="Point Name" defaultvalue=""/><parameter name="tagname_CLOSE" type="Point" description="Point Name" defaultvalue=""/><parameter name="cp_FailState" type="Text" description="Fail State - &quot;FC&quot; or &quot;FO&quot;" defaultvalue="FC"/><parameter name="cp_NDE" type="Text" description="Deenergized state &quot;NDE&quot; or &quot;&quot;" defaultvalue=""/><parameter name="cp_TagNameEU" type="Text" description="[Custom Name]" defaultvalue=""/><parameter name="Trd_PointPV" type="Parameter" description="Trace to be added to trend group" defaultvalue="Tagname.cp_pv"/><parameter name="Trd_PointOP" type="Parameter" description="Trace to be added to trend group" defaultvalue="Tagname.cp_op"/><parameter name="FaceplateFile" type="Text" description="Custom Faceplate File" defaultvalue="-"/><parameter name="cp_custtrd" type="Num" description="Custom Trend Group Number" defaultvalue=""/><parameter name="cp_custgrp" type="Num" description="Custom Group Number" defaultvalue=""/><parameter name="cm_label" type="Text" description="Context Menu Help Item Text" defaultvalue="Help"/><parameter name="cm_file" type="Text" description="Help File Name" defaultvalue=""/><parameter name="ContextMenuFile" type="Text" description="Context Menu Filename" defaultvalue="-"/><parameter name="Revision" type="Num" description="Revision" defaultvalue="R300 Rev.0"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=alpha001 class="hsc.alpha.1 HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 16.12%; FONT-FAMILY: Arial; WIDTH: 13.88%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 39.58%; TOP: 56.45%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateScanState:0;lineColor:transparent;lineColorBlink:False;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[If me.DataValue("tagname_OPEN.PV")=1 and me.DataValue("tagname_CLOSE.PV")=0 then
    PlgIn_1.fillColor="#008000"
	PlgOut_1.fillColor="#008000"
 End if

 If me.DataValue("tagname_OPEN.PV")=0 and me.DataValue("tagname_CLOSE.PV")=1 then
    PlgIn_1.fillColor="#C0C0C0"
	PlgOut_1.fillColor="#C0C0C0"
	 End if

 If me.DataValue("tagname_OPEN.PV")=1 and me.DataValue("tagname_CLOSE.PV")=1 then
    PlgIn_1.fillColor="#00FFFF"
	PlgOut_1.fillColor="#00FFFF"
 End if

 If me.DataValue("tagname_OPEN.PV")=0 and me.DataValue("tagname_CLOSE.PV")=0 then
    PlgIn_1.fillColor="#008000"
	PlgOut_1.fillColor="#C0C0C0"
 End if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname_CLOSE%},{%Point::tagname_OPEN%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="PV,PV,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,"/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=TxtName class="hvg.textbox.1 TxtTagname_TxtEUdesc" style="FONT-SIZE: 10pt; OVERFLOW: hidden; HEIGHT: 25.8%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; COLOR: #808080; TEXT-ALIGN: center; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text); VISIBILITY: hidden" hdxproperties="fillColorBlink:False;FillStyle:1;Height:16;lineColorBlink:False;LineStyle:0;styleClass:TxtTagname_TxtEUdesc;textColor:#808080;textColorBlink:False;TotalRotation:-1;value:;Width:144;">{%Point::TagName%}</DIV>]]></content></html></element><element><html><content><![CDATA[<TEXTAREA tabIndex=-1 id=ScConAlpPV class="hsc.alpha.1 hsc.faceplate.1 ScConAlpPV HSC.ScriptDataObject.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; BORDER-LEFT-STYLE: none; HEIGHT: 0%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: transparent; WIDTH: 0%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; BORDER-LEFT-COLOR: transparent; COLOR: #000000; BORDER-BOTTOM-COLOR: transparent; TEXT-ALIGN: right; BORDER-RIGHT-STYLE: none; LEFT: 21.52%; BORDER-RIGHT-COLOR: transparent; TOP: 25.8%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior) url(#HDXPopupBehavior#Faceplate) url(#HSCScriptDataBehavior); VISIBILITY: visible; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="borderWidth:;fillColor:transparent;fillColorBlink:False;HDXBINDINGID:-4;indicateAlarmState:0;indicateScanState:0;lineColor:Color_OtherState;lineColorBlink:False;numericDisplayFormat:%.2f;styleClass:ScConAlpPV;textColor:#000000;textColorBlink:False;" globalscripts printDisplayValue="9999.99">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[call Scd_OnOffValves_AlpPV_OnUpdate(me)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="DataSourceObj.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value