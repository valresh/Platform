<DIV tabIndex=-1 id=group003 class="hvg.group.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 0pt; HEIGHT: 872px; WIDTH: 24px; POSITION: absolute; LEFT: 205px; TOP: 3px; BEHAVIOR: url(#HDXVectorFactory#group) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;Height:872;lineColorBlink:False;Width:24;"></DIV>]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[dim vis
vis="{%value::visibility%}"
if vis = 1 then
	if me.DataValue("tagname.parameter")=1 then 
	me.style.visibility="visible"
	else 
	me.style.visibility="hidden"
	end if
else

	if me.DataValue("tagname.parameter")=1 then 
	me.style.visibility="hidden"
	else 
	me.style.visibility="visible"
	end if
end if]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::parameter%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></group></shape></shapes></shapefile>