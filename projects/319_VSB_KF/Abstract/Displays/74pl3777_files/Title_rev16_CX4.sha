<DIV tabIndex=-1 id=group4 class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 60px; WIDTH: 242px; POSITION: absolute; LEFT: 9px; TOP: 7px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:60;lineColorBlink:False;Width:242;"></DIV>]]></content></html></group></shape></shapes></shapefile>