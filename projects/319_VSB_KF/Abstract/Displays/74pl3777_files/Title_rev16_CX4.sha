<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="242px" height="60px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><parameters><parameter name="ST0" type="Point" description="" defaultvalue="74CX_ST0"/><parameter name="cp_mode" type="Parameter" description="Управление" defaultvalue="74XL476.pv"/><parameter name="cp_status" type="Parameter" description="Готовность к пуску" defaultvalue="74XL485.pv"/><parameter name="Tag_Reset" type="Point" description="" defaultvalue="74HS486"/><parameter name="Tag_TO" type="Point" description="" defaultvalue="74HS487"/><parameter name="Tag_Lamp" type="Point" description="" defaultvalue="74HS460"/><parameter name="Tag_Power" type="Point" description="" defaultvalue="74HS462"/><parameter name="Tag_Start" type="Point" description="" defaultvalue="74HS464"/><parameter name="Tag_Stop" type="Point" description="" defaultvalue="74HS465"/><parameter name="Tag_Check" type="Point" description="" defaultvalue="74HS488"/><parameter name="Tag_Next" type="Point" description="" defaultvalue="74HS489"/><parameter name="cp_gop" type="Parameter" description="" defaultvalue="devctla.gop"/><parameter name="cp_pvfl" type="Parameter" description="" defaultvalue="DIGACQA.pvfl"/><parameter name="Tag_PP" type="Point" description="" defaultvalue="74CX_PP"/><parameter name="PASS_OUT" type="Parameter" description="" defaultvalue="PASS_OUT.PVFL"/><parameter name="PASS_IN" type="Parameter" description="" defaultvalue="PASS_IN.PVFL"/><parameter name="pass" type="Parameter" description="" defaultvalue="PASS.STR[1]"/><parameter name="Rev" type="Num" description="" defaultvalue="rev8. 24Feb2012"/></parameters><shapes><shape><group><element><html><content><![CDATA[<INPUT tabIndex=0 id=btnAck class="hsc.button.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 33.33%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 49.58%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 0%; BORDER-RIGHT-COLOR: #ffffff; TOP: 0%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #ece9d8" type=button value=Квит.ламп hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" POPUPDISPLAYFILE="C:\Program Files\Honeywell\Experion PKS\Client\Abstract\Feed_control.htm" POPUPLEFT="180" POPUPTOP="180" POSITIONING="1">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[intAnswer = Msgbox("Вы хотите выполнить это действие?", vbYesNo)

If intAnswer = vbYes Then
	me.DataValue("Tag_Lamp.cp_gop")=5
Else
	Msgbox "Действие отменено"
End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="feed_control"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tag_Lamp%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_gop%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=btnPower class="hsc.button.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 33.33%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 49.58%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 0%; BORDER-RIGHT-COLOR: #ffffff; TOP: 33.33%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #ece9d8" type=button value=Отключ.гл.питания hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" POPUPDISPLAYFILE="C:\Program Files\Honeywell\Experion PKS\Client\Abstract\Feed_control.htm" POPUPLEFT="180" POPUPTOP="180" POSITIONING="1">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[intAnswer = Msgbox("Вы хотите отключить питание установки?", vbYesNo)

If intAnswer = vbYes Then
	me.DataValue("Tag_Power.cp_gop")=5
Else
	Msgbox "Действие отменено"
End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="feed_control"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tag_Power%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_gop%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=btnTO class="hsc.button.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 33.33%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 49.58%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 0%; BORDER-RIGHT-COLOR: #ffffff; TOP: 66.66%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #ece9d8" type=button value=Подтв.выполн.ТО hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" POPUPDISPLAYFILE POPUPLEFT="180" POPUPTOP="180" POSITIONING="1">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[intAnswer = Msgbox("Вы хотите подтвердить выполнение ТО?", vbYesNo)

If intAnswer = vbYes Then
	me.DataValue("Tag_TO.cp_gop")=5
Else
	Msgbox "Действие отменено"
End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="feed_control"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tag_TO%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_gop%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=btnCheck class="hsc.button.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 33.33%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 49.58%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 50.41%; BORDER-RIGHT-COLOR: #ffffff; TOP: 0%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #ece9d8" type=button value='Режим "ПРОВЕРКА"' hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" POPUPDISPLAYFILE POPUPLEFT="180" POPUPTOP="180" POSITIONING="0">]]></content><scripts><script event="ondatachange" language="VBScript"><![CDATA[If me.DataValue("Tag_PP.PASS_OUT")=1 Then
	me.fillColor = "#008000"
Else
	me.fillColor = "#ECE9D8"
End If]]></script><script event="onclick" language="VBScript"><![CDATA[IF me.DataValue("Tag_Check.cp_gop")=5 Then
	intAnswer = Msgbox("Вы хотите отключить режим проверки?", vbYesNo)
	IF intAnswer = vbYes Then
		me.DataValue("Tag_Check.cp_gop")=4
		me.DataValue("Tag_PP.PASS_OUT")=0
	Else
		Msgbox "Действие отменено"
	End If
END IF


IF me.DataValue("ST0.cp_mode")=1 Then
	IF me.DataValue("Tag_Check.cp_gop")=4 Then
		HDXPopupBehavior.CreatePopupWindow "74PL3737.htm",0,0,0
	END IF

ElseIF me.DataValue("ST0.cp_mode")=0 Then
	Msgbox "Режим ПРОВЕРКИ доступен только в автоматическом режиме!"
	me.DataValue("Tag_Check.cp_gop")=4
	me.DataValue("Tag_PP.PASS_OUT")=0
END IF]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="feed_control"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tag_Check%},{%Point::Tag_PP%},{%Point::Tag_PP%},{%Point::Tag_PP%},{%Point::ST0%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_gop%},{%Parameter::pass%},{%Parameter::PASS_IN%},{%Parameter::PASS_OUT%},{%Parameter::cp_mode%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,0,0,0,0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,2,2,2,2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,0,0,0,0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,0,0,0,0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=",,,,,"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=btnNext class="hsc.button.1 HSC.ScriptDataObject.1" style="FONT-SIZE: 8pt; TEXT-DECORATION: none; HEIGHT: 33.33%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 49.58%; BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; TEXT-ALIGN: center; LEFT: 50.41%; BORDER-RIGHT-COLOR: #ffffff; TOP: 33.33%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior)  url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #ece9d8" type=button value="Следующий такт" hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;textColorBlink:False;" POPUPDISPLAYFILE POPUPLEFT="180" POPUPTOP="180" POSITIONING="1">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[intAnswer = Msgbox("Вы хотите перейти к следующему шагу?", vbYesNo)

If intAnswer = vbYes Then
	me.DataValue("Tag_Next.cp_gop")=5
Else
	Msgbox "Действие отменено"
End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="feed_control"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tag_Next%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_gop%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=btnINIT class="hsc.button.1 hsc.p