<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="20px" height="16px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="\\HCUSRV1A\abstract\Displays\CSS\sp.css"/></stylesheets><parameters><parameter name="Tagname" type="Point" description="Имя Точки" defaultvalue=""/><parameter name="cp_CText" type="Text" description="Отображаемый текст" defaultvalue="GA"/><parameter name="cp_pv" type="Parameter" description="Параметр точки" defaultvalue="PV"/><parameter name="NumAlarrmState" type="Value" description="Аларменное состояние точки" defaultvalue="0"/><parameter name="FaceplateFile" type="Text" description="Свой Faceplate" defaultvalue=""/><parameter name="ContextMenuFile" type="Text" description="Своё контекстное меню" defaultvalue="sp_sysdtlKIN_sm.xml"/></parameters><shapes><shape><group><element><html><content><![CDATA[<TEXTAREA tabIndex=0 id=ScConAlpPV class="hsc.alpha.1 HSC.ScriptDataObject.1 hsc.faceplate.1" style="BORDER-TOP-STYLE: none; FONT-SIZE: 12pt; OVERFLOW: hidden; WORD-WRAP: normal; TEXT-DECORATION: none; BORDER-LEFT-STYLE: none; HEIGHT: 6.25%; FONT-FAMILY: Arial; WIDTH: 5%; BORDER-BOTTOM-STYLE: none; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; BORDER-RIGHT-STYLE: none; LEFT: 95%; TOP: 87.5%; BEHAVIOR: url(#HDXAlphaBehavior) url(#BindingBehavior)   url(#HSCScriptDataBehavior) url(#HDXPopupBehavior#Faceplate); VISIBILITY: hidden; BACKGROUND-COLOR: transparent; ROWS: 1" hdxproperties="BreakpointType:1;DiscreteColors:255_-16777216_65280_16777215_13434880_16711935_255_12632256;DiscreteStates:00000000;durationFormat:-1;fillColor:transparent;HDXBINDINGID:-4;indicateAlarmState:0;indicateBadState:0;indicateScanState:0;lineColor:transparent;lineColorBlink:False;numberOfChars:9;numericDisplayFormat:%.2f;textColor:#000000;textColorBlink:False;">9999.99</TEXTAREA>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim oSheip, oConst
on error resume next
Set oSheip = me.parentnode.parentnode
oConst = oSheip.getcustomproperty("Value","NumAlarmState")

If me.DataValue("TagName.cp_pv") = oConst then
ScTxtSelectBox.textColor = vbred
else
ScTxtSelectBox.textColor = vbBlack
End If]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.Generic"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="ObjectType" varianttype="VT_UI1" value="0"/><property name="UpdatePeriod" varianttype="VT_UI2" value="0"/><property name="SecurityLevel" varianttype="VT_UI1" value="0"/><property name="AddressType" varianttype="VT_UI1" value="0"/><property name="AddressFlags" varianttype="VT_UI1" value="1"/><property name="PointRefPointName" varianttype="VT_BSTR" value="{%Point::Tagname%}"/><property name="PointRefParamName" varianttype="VT_BSTR" value="{%Parameter::cp_pv%}"/><property name="PointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::Tagname%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="{%Parameter::cp_pv%},"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=ScTxtSelectBox class=hvg.textbox.1 style="FONT-SIZE: 10pt; OVERFLOW: hidden; HEIGHT: 93.75%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: normal; COLOR: #00ffff; FONT-STYLE: normal; TEXT-ALIGN: left; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#text)   url(#BindingBehavior)" hdxproperties="BreakpointType:1;DiscreteColors:255_-16777216_65280_16777215_13434880_16711935_255_12632256;DiscreteStates:00000000;FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:15;indicateAlarmState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;textColor:#00ffff;textColorBlink:False;TotalRotation:-1;Width:20;">{%Text::cp_CText%}</DIV>]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[call All_OnClick(me)]]></script><script event="oncontextmenu" language="VBScript"><![CDATA[call All_OnCMenu(me)]]></script></scripts></html><binding/></element><html><content><![CDATA[
<DIV tabIndex=-1 id=group class=hvg.group.1 style="FONT-SIZE: 0pt; HEIGHT: 16px; WIDTH: 20px; POSITION: absolute; LEFT: 35px; TOP: 19px; BEHAVIOR: url(#HDXVectorFactory#group)" hdxproperties="fillColorBlink:False;Height:16;lineColorBlink:False;Width:20;"></DIV>]]></content></html></group></shape></shapes></shapefile>