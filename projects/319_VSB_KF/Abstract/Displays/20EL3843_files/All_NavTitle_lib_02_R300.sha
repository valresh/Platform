<?xml version="1.0"?><shapefile version="1" type="dynamic" title="" description="" useFirstShapeForBadValue="0" width="76px" height="32px"><versionheaders><versionheader name="PS" value="6.32"/></versionheaders><stylesheets><stylesheet src="C:\Documents and Settings\Administrator\Desktop\Displays\CSS\sp.css"/></stylesheets><scripts><script event="" language="VBScript" id="89C3751B-05B4-4247-9C2F-BC2E1A7FB362"><![CDATA[sub PbNav_Alarm_Indication(oSource)
	dim oShape,iUnack,iAck
	on error resume next
	set oShape=oSource.parentnode.parentnode
	if instr(oSource.id,"Right")>0 then sDir=oShape.getcustomProperty("text","cp_right")
	if instr(oSource.id,"Left")>0 then sDir=oShape.getcustomProperty("text","cp_left")
	if instr(oSource.id,"Down")>0 then sDir=oShape.getcustomProperty("text","cp_down")
	if instr(oSource.id,"UP")>0 then sDir=oShape.getcustomProperty("text","cp_up")
    sParam=sDir & "_G.name"	
    iPr=(oSource.dataalarm(sparam) and 48)/16
	iUnack=(oSource.dataalarm(sparam) and 1024)=1024
	if iUnack = True then
	  	oSource.fillcolorblink=true
	else
   		oSource.fillcolorblink=false
	end if
	
	select case iPr
    case 0
	    oSource.styleclass="Buttons"			
	case 1
		oSource.fillcolor=AlarmStateIconfactory.lowColor	
	case 2
		oSource.fillcolor=AlarmStateIconfactory.highColor
	case 3
		oSource.fillcolor=AlarmStateIconfactory.urgentColor    
	end select
end sub]]></script><script event="onshapeload" language="VBScript" id=""><![CDATA[  s=document.url
  p=instrrev(s,"\")
  p1=instrrev(s,".htm")
  s=mid(s,p,p1-p)

  sl="url(." & s & "_files\All_NavTitle_lib_02_R300_files\left.gif)"
  sr="url(." & s & "_files\All_NavTitle_lib_02_R300_files\right.gif)"	
  su="url(." & s & "_files\All_NavTitle_lib_02_R300_files\up.gif)"
  sd="url(." & s & "_files\All_NavTitle_lib_02_R300_files\down.gif)"

document.getelementbyid(me.id &"_ScPbLeft").style.backgroundImage=sl
document.getelementbyid(me.id &"_ScPbRight").style.backgroundImage=sr
document.getelementbyid(me.id &"_ScPbUp").style.backgroundImage=su
document.getelementbyid(me.id &"_ScPbDown").style.backgroundImage=sd


on error resume next
if me.getcustomproperty("text","cp_left")="blank" then 
  document.getelementbyid(me.id &"_ScPbLeft").style.visibility="hidden"
  document.getelementbyid(me.id &"_ScPbLeft").title="Display is not configured"
else
  document.getelementbyid(me.id &"_ScPbLeft").style.visibility="inherit"
  document.getelementbyid(me.id &"_ScPbLeft").title=me.getcustomproperty("text","cp_left")
end if
if me.getcustomproperty("text","cp_right")="blank" then 
  document.getelementbyid(me.id &"_ScPbRight").style.visibility="hidden"
  document.getelementbyid(me.id &"_ScPbRight").title="Display is not configured"
else
  document.getelementbyid(me.id &"_ScPbRight").style.visibility="inherit"
  document.getelementbyid(me.id &"_ScPbRight").title=me.getcustomproperty("text","cp_right")
end if
if me.getcustomproperty("text","cp_up")="blank" then 
  document.getelementbyid(me.id &"_ScPbUp").style.visibility="hidden"
  document.getelementbyid(me.id &"_ScPbUp").title="Display is not configured"
else
  document.getelementbyid(me.id &"_ScPbUp").style.visibility="inherit"
  document.getelementbyid(me.id &"_ScPbUp").title=me.getcustomproperty("text","cp_up")
end if
if me.getcustomproperty("text","cp_down")="blank" then 
  document.getelementbyid(me.id &"_ScPbDown").style.visibility="hidden"
  document.getelementbyid(me.id &"_ScPbDown").title="Display is not configured"
else
  document.getelementbyid(me.id &"_ScPbDown").style.visibility="inherit" 
  document.getelementbyid(me.id &"_ScPbDown").title=me.getcustomproperty("text","cp_down")
end if]]></script></scripts><parameters><parameter name="cp_left" type="text" description="Display Left" defaultvalue="blank"/><parameter name="cp_right" type="text" description="Display Right" defaultvalue="blank"/><parameter name="cp_up" type="text" description="Display Up" defaultvalue="blank"/><parameter name="cp_down" type="text" description="Display Down" defaultvalue="blank"/></parameters><shapes><shape><group><element><html><content><![CDATA[
<DIV tabIndex=-1 id=rect001 class=hvg.base.1 style="FONT-SIZE: 12pt; OVERFLOW: hidden; TEXT-DECORATION: none; HEIGHT: 100%; FONT-FAMILY: Arial; WIDTH: 100%; POSITION: absolute; FONT-WEIGHT: 400; FONT-STYLE: normal; LEFT: 0%; TOP: 0%; BEHAVIOR: url(#HDXVectorFactory#rect)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;Height:32;LineColor:transparent;lineColorBlink:False;LineStyle:0;LineWidth:2;Width:76;"></DIV>]]></content></html></element><element><html><content><![CDATA[<INPUT tabIndex=0 id=ScPbUP class="hsc.button.1 Buttons HSC.ScriptDataObject.1" style="FONT-SIZE: 12pt; TEXT-DECORATION: none; HEIGHT: 50%; FONT-FAMILY: Arial; BORDER-TOP-COLOR: #ffffff; WIDTH: 31.57%; BACKGROUND-IMAGE: url(file:./All_NavTitle_lib_02_R300_files/up.gif); BACKGROUND-REPEAT: no-repeat; POSITION: absolute; BORDER-LEFT-COLOR: #ffffff; FONT-WEIGHT: 400; COLOR: #000000; FONT-STYLE: normal; BORDER-BOTTOM-COLOR: #ffffff; LEFT: 35.52%; BORDER-RIGHT-COLOR: #ffffff; TOP: 3.12%; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior) url(#HSCScriptDataBehavior); BACKGROUND-COLOR: #d4d0c8" type=button hdxproperties="fillColor:#D4D0C8;fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;styleClass:Buttons;textColor:#000000;textColorBlink:False;" shapesrc=".\All_NavTitle_lib_02_R300_files\up.gif">]]></content><scripts><script event="onclick" language="VBScript"><![CDATA[window.external.currentpage = me.title]]></script><script event="ondatachange" language="VBScript"><![CDATA[call PbNav_Alarm_Indication(me)]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.3"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/>