ointRefParamOffset" varianttype="VT_UI4" value="0"/><property name="PointRefFlags" varianttype="VT_UI4" value="0"/><property name="CalloutElement" varianttype="VT_BSTR" value=""/><property name="ParameterFormat" varianttype="VT_BOOL" value="0"/><property name="PresentationType" varianttype="VT_UI1" value="1"/></dataobjectdef></dataobject><class ID="HSC.AlphaReadOnly" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=TxtStateA1 class="hvg.textbox.1  HSC.ScriptDataObject.1" style="FONT-SIZE: 10pt; OVERFLOW: hidden; HEIGHT: 25%; FONT-FAMILY: Arial; WIDTH: 19.48%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 27.15%; TOP: 35.93%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:16;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:145;"></DIV>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim State

State=me.Datavalue("tag_StepN.daca.pv")
select case State
	case 1 me.value="Пуск"
	case 2 me.value="Работает"
	case 3 me.value="Работает"
	case 4 me.value="Работает"
	case 5 me.value="Работает"
	case 6 me.value="Работает"
	case 7 me.value="Работает"
	case 8 me.value="Работает"
	case 9 me.value="Работает"
	case 10 me.value="Работает"
	case 11 me.value="Сброс давления"
	case 12 me.value="Доп.сброс давления"
	case 13 me.value="Нагрев"
	case 14 me.value="Доп.нагрев"
	case 15 me.value="Охлаждение"
	case 16 me.value="Доп.Охлаждение"
	case 17 me.value="Нагнетание"
	case 18 me.value="Доп.нагнетание"
	case 19 me.value="Параллел."
	case 20	me.value="Остановлен"
	case else me.value="--------"
end select]]></script></scripts></html><binding><dataobject ID="sdo1" class="progid:HSCDataSources.Application" type="HMIPage.ScriptData"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.1"/><property name="CommaDelimitedPointNames" varianttype="VT_BSTR" value="{%Point::tag_StepN%},"/><property name="CommaDelimitedParameters" varianttype="VT_BSTR" value="daca.pv,"/><property name="CommaDelimitedPresentationTypes" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedSecurityLevels" varianttype="VT_BSTR" value="2,"/><property name="CommaDelimitedUpdateRates" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedAllowFastUpdateValues" varianttype="VT_BSTR" value="0,"/><property name="CommaDelimitedCalloutElements" varianttype="VT_BSTR" value=","/></dataobjectdef></dataobject><class ID="HSC.ScriptDataobject.1" refcount="1"/></binding></element><element><html><content><![CDATA[
<DIV tabIndex=-1 id=TxtStateA2 class="hvg.textbox.1  HSC.ScriptDataObject.1" style="FONT-SIZE: 10pt; OVERFLOW: hidden; HEIGHT: 25%; FONT-FAMILY: Arial; WIDTH: 19.48%; POSITION: absolute; FONT-WEIGHT: bold; COLOR: #000000; FONT-STYLE: normal; TEXT-ALIGN: center; LEFT: 27.15%; TOP: 68.75%; BEHAVIOR: url(#HDXVectorFactory#text) url(#HSCScriptDataBehavior) url(#BindingBehavior)" hdxproperties="FillColor:transparent;fillColorBlink:False;FillStyle:1;HDXBINDINGID:-4;Height:16;indicateAlarmState:False;indicateScanState:False;LineColor:transparent;lineColorBlink:False;LineStyle:0;styleClass:;textColor:#000000;textColorBlink:False;TotalRotation:-1;Width:145;"></DIV>]]></content><scripts><script event="onupdate" language="VBScript"><![CDATA[dim State

State=me.Datavalue("tag_StepN.daca.pv")
select case State
	case 1 me.value="Пуск"
	case 2 me.value="Сброс давления"
	case 3 me.value="Доп.сброс давления"
	case 4 me.value="Нагрев"
	case 5 me.value="Доп.нагрев"
