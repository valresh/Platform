call alptrendgrp.onchange]]></script></scripts></html><binding><dataobject ID="dso1" class="progid:HSCDataSources.Application" type="HMIPage.PushButton"><dataobjectdef format="propertybag"><property name="version" varianttype="VT_R4" value="1.2"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="version" varianttype="VT_R4" value="1.2"/><property name="SecurityLevel" varianttype="VT_UI1" value="2"/><property name="PBActionType" varianttype="VT_UI1" value="0"/><property name="TaskLrn" varianttype="VT_UI2" value="21"/><property name="StationIndex" varianttype="VT_UI1" value="0"/><property name="Flags" varianttype="VT_UI4" value="0"/><property name="TaskParam1" varianttype="VT_BSTR" value="1"/><property name="TaskParam2" varianttype="VT_BSTR" value="11"/><property name="TaskParam3" varianttype="VT_BSTR" value="0"/><property name="TaskParam4" varianttype="VT_BSTR" value="0"/><property name="RepeatFlag" varianttype="VT_UI1" value="0"/></dataobjectdef></dataobject><class ID="HSC.PushButton" refcount="1"/></binding></element><element><html><content><![CDATA[<INPUT class="hsc.button.1 Buttons" id=Pblo1 style="FONT-WEIGHT: 400; FONT-SIZE: 8pt; BORDER-LEFT-COLOR: #ffffff; LEFT: 15.62%; BACKGROUND-IMAGE: url(.\All_TrdSel_lib_h_01_R300_files\lo1.gif); BORDER-BOTTOM-COLOR: #ffffff; BEHAVIOR: url(#HDXPushButtonBehavior) url(#BindingBehavior); WIDTH: 15.62%; COLOR: #000000; BORDER-TOP-COLOR: #ffffff; BACKGROUND-REPEAT: no-repeat; FONT-STYLE: normal; FONT-FAMILY: Courier New; POSITION: absolute; TOP: 0%; HEIGHT: 100%; BACKGROUND-COLOR: #d4d0c8; TEXT-ALIGN: center; TEXT-DECORATION: none; BORDER-RIGHT-COLOR: #ffffff" tabIndex=0 type=button hdxproperties="fillColorBlink:False;HDXBINDINGID:-4;lineColorBlink:False;styleClass:Buttons;textColor:#000000;textColorBlink:False;" shapesrc=".\All_TrdSel_lib_h_01_R300_files\lo1.gif">]]></content><scripts><script event="oncontextmenu" language="VBScript"><![CDATA[call AllTrdSel_CMenu]]></script><script event="onclick"