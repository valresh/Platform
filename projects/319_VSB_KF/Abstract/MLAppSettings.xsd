  <xs:simpleType name="Separator_Validation">
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
      <xs:maxLength value="1" />
      <xs:pattern value="[#$]" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DirectVariableSymbol_Validation">
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
      <xs:maxLength value="1" />
      <xs:pattern value="[%]" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Priority_Validation">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="3" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SubPriority_Validation">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="15" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Area_Validation">
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
      <xs:maxLength value="1" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ScanPeriod_Validation">
    <xs:restriction base="xs:long">
      <xs:minInclusive value="0" />
      <xs:maxInclusive value="3600" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="YesNo_Validation">
    <xs:restriction base="xs:string">
      <xs:pattern value="[Y/y][E/e][S/s]|[N/n][O/o]" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DataType_Validation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="BIT" />
      <xs:enumeration value="BYTE" />
      <xs:enumeration value="WORD" />
      <xs:enumeration value="DWORD" />
      <xs:enumeration value="LWORD" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Command_Validation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SEP" />
      <xs:enumeration value="CON" />
      <xs:enumeration value="TB" />
      <xs:enumeration value="COS" />
      <xs:enumeration value="DEV" />
	<xs:enumeration value="IO" />
	<xs:enumeration value="L" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Name_Validation">
