                                        &lt;columns&gt;
                                            &lt;column id="Alert State Indication" fixed="true"&gt;
                                                &lt;title tooltip="Alert State Indication"&gt;&amp;amp;nbsp;&lt;/title&gt;
                                                &lt;action/&gt;
                                                &lt;menu/&gt;
                                                &lt;content&gt;
                                                    &amp;lt;div _opacityACKED="60"
                                                        _opacityON="100"
                                                        _opacityOFF="30"
                                                        style="behavior: url(#AlarmStateIconFactory#AlarmIcon);
                                                               width: 100%;
                                                               height: 100%;
                                                               position: relative;
                                                               top: 0px;
                                                               z-index: 10;
                                                               white-space: nowrap;
                                                               text-align: center;"&amp;gt;&amp;lt;/div&amp;gt;
                                                &lt;/content&gt;
                                                &lt;bindings&gt;
                                                    &lt;in fields="Category" properties="Category"/&gt;
                                                    &lt;in fields="MainPriority" properties="Priority"/&gt;
                                                    &lt;in fields="RTN" properties="RTN"/&gt;
                                                    &lt;in fields="Acknowledged" properties="Acknowledged"/&gt;
                                                    &lt;in fields="Responded" properties="Responded"/&gt;
                                                    &lt;in fields="AlarmMgmtMethod" properties="AlarmMgmtMethod"/&gt;
                                                    &lt;in fields="Disabled" properties="Disabled"/&gt;
                                                    &lt;in fields="GDAQuality" properties="Quality"/&gt;
                                                    &lt;in fields="Selected" properties="style.backgroundColor" xforms="xfSelectionBG"/&gt;
                                                &lt;/bindings&gt;
                                            &lt;/column&gt;
                                            &lt;column id="Alert Time"&gt;
                                                &lt;title tooltip="Date &amp;amp; Time"&gt;Date &amp;amp; Time&lt;/title&gt;
                                                &lt;action/&gt;
                                                &lt;menu/&gt;
                                                &lt;content&gt;&amp;lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&amp;gt;&lt;/content&gt;
                                                &lt;bindings&gt;
                                                    &lt;in fields="Time;TimeMilliSeconds" xforms="xfDTCellFormat" properties="innerText" /&gt;
                                                    &lt;in fields="Time;TimeMilliSeconds" xforms="xfDTTooltipFormat" properties="title" /&gt;
                                                    &lt;in fields="Selected" properties="style.color" xforms="xfSelectionFG"/&gt;
                                                    &lt;in fields="Selected" properties="style.backgroundColor" xforms="xfSelectionBG"/&gt;
                                                &lt;/bindings&gt;
                                            &lt;/column&gt;
                                            &lt;column id="Location" default="false"&gt;
                                                &lt;title tooltip="Location"&gt;Location&lt;/title&gt;
                                                &lt;action/&gt;
                                                &lt;menu/&gt;
                                                &lt;content&gt;&amp;lt;span style="overflow: hidden; text-overflow: ellipsis; width: 100%; height: 100%; padding-left: 2px; padding-top: 1px;"/&amp;gt;&lt;/content&gt;
                                                &lt;bindings&gt;
                                                    &lt;in fields="LocationFullName" xforms="EmptyVariantToString" properties="innerText;title" /&gt;
                                                    &lt;in fields="Selected" properties="style.color" xforms="xfSelectionFG"/&gt;
                                                    &lt;in fields="Selected" properties="style.backgroundColor" xforms="xfSelectionBG"/&gt;
                                                &lt;/bindings&gt;
                                            &lt;/column&gt;
