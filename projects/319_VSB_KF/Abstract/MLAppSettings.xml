			<MemoryInfo Area="M" Readable="Yes" Writeable="Yes" ScanPeriod="10" BitLow="00000" BitHigh="2047F" DataTypesSupported="XBWDLwdl" AddressFormat="wwwwB" CustomAreaType="COMMON_AREA"/>
			<MemoryInfo Area="L" Readable="Yes" Writeable="Yes" ScanPeriod="10" BitLow="00000" BitHigh="11263F" DataTypesSupported="XBWDLwdl" AddressFormat="wwwwwB"/>
			<MemoryInfo Area="K" Readable="Yes" Writeable="Yes" ScanPeriod="10" BitLow="00000" BitHigh="2047F" DataTypesSupported="XBWDLwdl" AddressFormat="wwwwB"/>
			<MemoryInfo Area="F" Readable="Yes" Writeable="No" ScanPeriod="10" BitLow="00000" BitHigh="2047F" DataTypesSupported="XBWDLwdl" AddressFormat="wwwwB"/>
			<MemoryInfo Area="T" Readable="Yes" Writeable="Yes" ScanPeriod="10" BitLow="0000" BitHigh="2047" DataTypesSupported="XWDLwdl" AddressFormat="cccc" CustomAreaType="BIT_WORD_AREA"/>
			<MemoryInfo Area="C" Readable="Yes" Writeable="Yes" ScanPeriod="10" BitLow="0000" BitHigh="2047" DataTypesSupported="XWDLwdl" AddressFormat="cccc" CustomAreaType="BIT_WORD_AREA"/>
			<MemoryInfo Area="S" Readable="Yes" Writeable="Yes" ScanPeriod="10" BitLow="000.00" BitHigh="127.99" DataTypesSupported="X" AddressFormat="www.ww"/>
