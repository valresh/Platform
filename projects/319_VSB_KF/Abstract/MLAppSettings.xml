			<CommandSupported Name="COS" MaxPacketSize="1024" NumberOfVariables="64" StartTransactionID="600" NumberOfTransactionID="8" CommandType="Command"/>
			<CommandSupported Name="IO" MaxPacketSize="512" MaxPerPacketSize="512" ResponseReadDataType="WORD" CommandType="Data"/>
