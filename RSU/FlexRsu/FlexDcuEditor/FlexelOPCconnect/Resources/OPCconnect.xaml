<Expander IsExpanded="True" Header="Связь через OPC" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                              xmlns:FlexDesigner="clr-namespace:FlexDesigner;assembly=FlexDesigner">
  <FlexDesigner:Toolbox ItemSize="60,30" Header="Связь через OPC">
    <ItemsControl.Items>

      <Grid Width="70" Height="20" Background="LightBlue" x:Name="OpcDI" FlexDesigner:DesignerItem.ShowItemName="True" FlexDesigner:DesignerItem.ShowExecOrder="False">
        <Grid.ToolTip>
          <TextBlock Text="Получение цифровых данных с OPC"/>
        </Grid.ToolTip>
        <Border Width="60" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="OPC-&gt;DI"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M65,10 70,10"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="OUT" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="35,10"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
      </Grid>

      <Grid Width="70" Height="20" Background="LightBlue" x:Name="OpcDO" FlexDesigner:DesignerItem.ShowItemName="True" FlexDesigner:DesignerItem.ShowExecOrder="False">
        <Grid.ToolTip>
          <TextBlock Text="Выдача цифровых данных в OPC"/>
        </Grid.ToolTip>
        <Border Width="60" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="DO-&gt;OPC"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,10 5,10"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-35,10"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
      </Grid>

      <Grid Width="70" Height="20" Background="LightBlue" x:Name="OpcAI" FlexDesigner:DesignerItem.ShowItemName="True" FlexDesigner:DesignerItem.ShowExecOrder="False">
        <Grid.ToolTip>
          <TextBlock Text="Получение аналоговых данных с OPC"/>
        </Grid.ToolTip>
        <Border Width="60" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center" CornerRadius="10">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="OPC-&gt;AI"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M65,10 70,10"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="OUT" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="35,10"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
      </Grid>

      <Grid Width="70" Height="20" Background="LightBlue" x:Name="OpcAO" FlexDesigner:DesignerItem.ShowItemName="True" FlexDesigner:DesignerItem.ShowExecOrder="False">
        <Grid.ToolTip>
          <TextBlock Text="Выдача аналоговых данных в OPC"/>
        </Grid.ToolTip>
        <Border Width="60" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center" CornerRadius="10">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="AO-&gt;OPC"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,10 5,10"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-35,10"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
      </Grid>
      
    </ItemsControl.Items>
  </FlexDesigner:Toolbox>
</Expander>
  