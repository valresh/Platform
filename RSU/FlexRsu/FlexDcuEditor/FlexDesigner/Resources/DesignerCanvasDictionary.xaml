<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FlexDesigner">
  <VisualBrush x:Key="SnappingGridBrush_Points" TileMode="Tile" Viewbox="0,0,10,10" Viewport="0,0,10,10" ViewportUnits="Absolute" ViewboxUnits="Absolute">
    <VisualBrush.Visual>
      <Ellipse Fill="Black" Height="1" Width="1"/>
    </VisualBrush.Visual>
  </VisualBrush>
  <ContextMenu x:Key="DesignerCanvasContextMenu">
    <MenuItem Header="Копировать" Command="{x:Static ApplicationCommands.Copy}">
      <MenuItem.Icon>
        <Image Source="pack://application:,,/FlexDesigner;Component/Images/64х64/Копировать.png" Width="16"/>
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Вставить" Command="{x:Static ApplicationCommands.Paste}">
      <MenuItem.Icon>
        <Image Source="pack://application:,,/FlexDesigner;Component/Images/64х64/Вставить.png" Width="16"/>
      </MenuItem.Icon>
    </MenuItem>
  </ContextMenu>

</ResourceDictionary>
