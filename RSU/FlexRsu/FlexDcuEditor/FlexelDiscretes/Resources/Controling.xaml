<Expander IsExpanded="True" Header="Управление" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                              xmlns:FlexDesigner="clr-namespace:FlexDesigner;assembly=FlexDesigner">
  <FlexDesigner:Toolbox ItemSize="60,60" Header="Управление">
    <ItemsControl.Items>

      <Grid Width="40" Height="50" Background="LightBlue" x:Name="PID" SnapsToDevicePixels="True" FlexDesigner:DesignerItem.ShowItemName="True">
        <Grid.ToolTip>
          <TextBlock Text="PID"/>
        </Grid.ToolTip>
        <Border Width="30" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="PID"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,10 5,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M35,25 40,25"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="PV" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-20,10"/>
              <FlexDesigner:Connector x:Name="CV" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="20,25"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
        <FlexDesigner:DesignerItem.HiddenProperties>
          <FlexDesigner:HiddenPropertiesContainer>
            <FlexDesigner:HiddenProperty Key="P" Value="100"/>
            <FlexDesigner:HiddenProperty Key="I" Value="10"/>
            <FlexDesigner:HiddenProperty Key="SH" Value="100"/>
            <FlexDesigner:HiddenProperty Key="SL" Value="0"/>
            <FlexDesigner:HiddenProperty Key="MH" Value="100"/>
            <FlexDesigner:HiddenProperty Key="ML" Value="0"/>
            <FlexDesigner:HiddenProperty Key="MA" Value="0"/>
            <FlexDesigner:HiddenProperty Key="Inverse" Value="1"/>
            <FlexDesigner:HiddenProperty Key="EU" Value="%"/>
          </FlexDesigner:HiddenPropertiesContainer>
        </FlexDesigner:DesignerItem.HiddenProperties>
      </Grid>

      <Grid Width="40" Height="70" Background="LightBlue" x:Name="PIDA" SnapsToDevicePixels="True" FlexDesigner:DesignerItem.ShowItemName="True">
        <Grid.ToolTip>
          <TextBlock Text="PIDA"/>
        </Grid.ToolTip>
        <Border Width="30" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="PIDA"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,10 5,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,20 5,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,30 5,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,40 5,40"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,50 5,50"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,60 5,60"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M35,10 40,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M35,20 40,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M35,30 40,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M35,40 40,40"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M35,50 40,50"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M35,60 40,60"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="LOCK_IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-20,10"/>
              <FlexDesigner:Connector x:Name="INTERLOCK" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-20,20"/>
              <FlexDesigner:Connector x:Name="CAS_IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-20,30"/>
              <FlexDesigner:Connector x:Name="IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-20,40"/>
              <FlexDesigner:Connector x:Name="TRK_IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-20,50"/>
              <FlexDesigner:Connector x:Name="TRK_IND" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-20,60"/>
              <FlexDesigner:Connector x:Name="LOCK" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="20,10"/>
              <FlexDesigner:Connector x:Name="HH" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="20,20"/>
              <FlexDesigner:Connector x:Name="H" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="20,30"/>
              <FlexDesigner:Connector x:Name="OUT" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="20,40"/>
              <FlexDesigner:Connector x:Name="L" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="20,50"/>
              <FlexDesigner:Connector x:Name="LL" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="20,60"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
        <FlexDesigner:DesignerItem.HiddenProperties>
          <FlexDesigner:HiddenPropertiesContainer>
            <FlexDesigner:HiddenProperty Key="DESCR" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR1" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR2" Value=""/>
            <FlexDesigner:HiddenProperty Key="VALUE_FORMAT" Value="#.##"/>
            <FlexDesigner:HiddenProperty Key="EU" Value="%"/>
            <FlexDesigner:HiddenProperty Key="MODE" Value="0"/>
            <FlexDesigner:HiddenProperty Key="SP" Value="0"/>
            <FlexDesigner:HiddenProperty Key="P" Value="100"/>
            <FlexDesigner:HiddenProperty Key="I" Value="10"/>
            <FlexDesigner:HiddenProperty Key="MAXIMUM" Value="100"/>
            <FlexDesigner:HiddenProperty Key="MINIMUM" Value="0"/>
            <FlexDesigner:HiddenProperty Key="MAX_OUT" Value="100"/>
            <FlexDesigner:HiddenProperty Key="MIN_OUT" Value="0"/>
            <FlexDesigner:HiddenProperty Key="INVERSE" Value="1"/>
            <FlexDesigner:HiddenProperty Key="HH_LIM_PV" Value=""/>
            <FlexDesigner:HiddenProperty Key="H_LIM_PV" Value=""/>
            <FlexDesigner:HiddenProperty Key="L_LIM_PV" Value=""/>
            <FlexDesigner:HiddenProperty Key="LL_LIM_PV" Value=""/>
            <FlexDesigner:HiddenProperty Key="HYST" Value="1"/>
            <FlexDesigner:HiddenProperty Key="ALGORITHM" Value="0"/>
            <FlexDesigner:HiddenProperty Key="SP_LIMIT" Value="0"/>
            <FlexDesigner:HiddenProperty Key="MAX_SP" Value="99"/>
            <FlexDesigner:HiddenProperty Key="MIN_SP" Value="1"/>
            <FlexDesigner:HiddenProperty Key="SetValOpened" Value="99"/>
            <FlexDesigner:HiddenProperty Key="SetValClosed" Value="1"/>
            <FlexDesigner:HiddenProperty Key="DeadZoneCtrl" Value="0"/>
            <FlexDesigner:HiddenProperty Key="SSV" Value="0.5"/>
            <FlexDesigner:HiddenProperty Key="FSV" Value="2.5"/>
            <FlexDesigner:HiddenProperty Key="SMV" Value="1"/>
            <FlexDesigner:HiddenProperty Key="FMV" Value="5"/>
           </FlexDesigner:HiddenPropertiesContainer>
        </FlexDesigner:DesignerItem.HiddenProperties>
      </Grid>

      <Grid Width="60" Height="60" Background="LightBlue" x:Name="RAMP" FlexDesigner:DesignerItem.ShowItemName="True">
        <Grid.ToolTip>
          <TextBlock Text="RAMP"/>
        </Grid.ToolTip>
        <Border Width="50" Height="50" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="RAMP"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,15 5,15"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,30 5,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,45 5,45"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,15 60,15"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,35 60,35"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,15"/>
              <FlexDesigner:Connector x:Name="ENABLE" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,30"/>
              <FlexDesigner:Connector x:Name="PAUSE" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,45"/>
              <FlexDesigner:Connector x:Name="OUT" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,15"/>
              <FlexDesigner:Connector x:Name="COMPLETE" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,35"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
        <FlexDesigner:DesignerItem.HiddenProperties>
          <FlexDesigner:HiddenPropertiesContainer>
            <FlexDesigner:HiddenProperty Key="END_VALUE" Value="100"/>
            <FlexDesigner:HiddenProperty Key="RAMP_RATE" Value="10"/>
            <FlexDesigner:HiddenProperty Key="RAMP_TYPE" Value="0"/>
            <FlexDesigner:HiddenProperty Key="RAMP_TIME" Value="60"/>
          </FlexDesigner:HiddenPropertiesContainer>
        </FlexDesigner:DesignerItem.HiddenProperties>
      </Grid>

      <Grid Width="60" Height="80" Background="LightBlue" x:Name="MOTOR" SnapsToDevicePixels="True" FlexDesigner:DesignerItem.ShowItemName="True">
        <Grid.ToolTip>
          <TextBlock Text="MOTOR"/>
        </Grid.ToolTip>
        <Border Width="50" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="MOTOR"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,10 5,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,20 5,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,30 5,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,40 5,40"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,50 5,50"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,60 5,60"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,70 5,70"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,10 60,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,20 60,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,30 60,30"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="MODE" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,10"/>
              <FlexDesigner:Connector x:Name="SV" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,20"/>
              <FlexDesigner:Connector x:Name="INTERLOCK" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,30"/>
              <FlexDesigner:Connector x:Name="IN" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,40"/>
              <FlexDesigner:Connector x:Name="PERMISSIVE" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,50"/>
              <FlexDesigner:Connector x:Name="STARTCOUNT1" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,60"/>
              <FlexDesigner:Connector x:Name="STARTCOUNT2" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,70"/>
              <FlexDesigner:Connector x:Name="ERR" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,10"/>
              <FlexDesigner:Connector x:Name="OUT1" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,20"/>
              <FlexDesigner:Connector x:Name="OUT2" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,30"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
        <FlexDesigner:DesignerItem.HiddenProperties>
          <FlexDesigner:HiddenPropertiesContainer>
            <FlexDesigner:HiddenProperty Key="LOCK_IN" Value="0"/>
            <FlexDesigner:HiddenProperty Key="DESCR" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR1" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR2" Value=""/>
            <FlexDesigner:HiddenProperty Key="EU" Value=""/>
            <FlexDesigner:HiddenProperty Key="MODE" Value="0"/>
            <FlexDesigner:HiddenProperty Key="LOCK_MODE" Value="0"/>
            <FlexDesigner:HiddenProperty Key="SAVE_MODE" Value="0"/>
           </FlexDesigner:HiddenPropertiesContainer>
        </FlexDesigner:DesignerItem.HiddenProperties>
      </Grid>

      <Grid Width="60" Height="90" Background="LightBlue" x:Name="VLV" SnapsToDevicePixels="True" FlexDesigner:DesignerItem.ShowItemName="True">
        <Grid.ToolTip>
          <TextBlock Text="VLV - используется для управления отсекателями"/>
        </Grid.ToolTip>
        <Border Width="50" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="VLV"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,10 5,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,20 5,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,30 5,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,40 5,40"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,50 5,50"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,60 5,60"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,70 5,70"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,80 5,80"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,10 60,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,20 60,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,30 60,30"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="MODE" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,10"/>
              <FlexDesigner:Connector x:Name="SV" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,20"/>
              <FlexDesigner:Connector x:Name="INTERLOCK" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,30"/>
              <FlexDesigner:Connector x:Name="IN1" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,40"/>
              <FlexDesigner:Connector x:Name="IN2" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,50"/>
              <FlexDesigner:Connector x:Name="PERMISSIVE" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,60"/>
              <FlexDesigner:Connector x:Name="STARTCOUNT1" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,70"/>
              <FlexDesigner:Connector x:Name="STARTCOUNT2" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,80"/>
              <FlexDesigner:Connector x:Name="ERR" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,10"/>
              <FlexDesigner:Connector x:Name="OUT1" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,20"/>
              <FlexDesigner:Connector x:Name="OUT2" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,30"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
        <FlexDesigner:DesignerItem.HiddenProperties>
          <FlexDesigner:HiddenPropertiesContainer>
            <FlexDesigner:HiddenProperty Key="LOCK_IN" Value="0"/>
            <FlexDesigner:HiddenProperty Key="DESCR" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR1" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR2" Value=""/>
            <FlexDesigner:HiddenProperty Key="EU" Value=""/>
            <FlexDesigner:HiddenProperty Key="MODE" Value="0"/>
            <FlexDesigner:HiddenProperty Key="SAVE_MODE" Value="0"/>
            <FlexDesigner:HiddenProperty Key="HOLD_IL" Value="0"/>
          </FlexDesigner:HiddenPropertiesContainer>
        </FlexDesigner:DesignerItem.HiddenProperties>
      </Grid>

      <Grid Width="60" Height="90" Background="LightBlue" x:Name="EV" SnapsToDevicePixels="True" FlexDesigner:DesignerItem.ShowItemName="True">
        <Grid.ToolTip>
          <TextBlock Text="EV - используется для управления электрозадвижкой"/>
        </Grid.ToolTip>
        <Border Width="50" BorderThickness="2" BorderBrush="BlueViolet" HorizontalAlignment="Center">
          <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="EV"/>
        </Border>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,10 5,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,20 5,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,30 5,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,40 5,40"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,50 5,50"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,60 5,60"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,70 5,70"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M0,80 5,80"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,10 60,10"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,20 60,20"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,30 60,30"/>
        <Path Stroke="Black" StrokeThickness="1" Data="M55,40 60,40"/>
        <FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
          <ControlTemplate>
            <FlexDesigner:ReferenceCenterPositionPanel>
              <FlexDesigner:Connector x:Name="MODE" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,10"/>
              <FlexDesigner:Connector x:Name="SV" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,20"/>
              <FlexDesigner:Connector x:Name="INTERLOCK" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,30"/>
              <FlexDesigner:Connector x:Name="IN1" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,40"/>
              <FlexDesigner:Connector x:Name="IN2" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,50"/>
              <FlexDesigner:Connector x:Name="PERMISSIVE" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,60"/>
              <FlexDesigner:Connector x:Name="Opening" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,70"/>
              <FlexDesigner:Connector x:Name="Closing" Orientation="Left" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="-30,80"/>
              <FlexDesigner:Connector x:Name="ERR" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,10"/>
              <FlexDesigner:Connector x:Name="OUT1" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,20"/>
              <FlexDesigner:Connector x:Name="OUT2" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,30"/>
              <FlexDesigner:Connector x:Name="OUT3" Orientation="Right" FlexDesigner:ReferenceCenterPositionPanel.ReferenceCenterPosition="30,40"/>
            </FlexDesigner:ReferenceCenterPositionPanel>
          </ControlTemplate>
        </FlexDesigner:DesignerItem.ConnectorDecoratorTemplate>
        <FlexDesigner:DesignerItem.HiddenProperties>
          <FlexDesigner:HiddenPropertiesContainer>
            <FlexDesigner:HiddenProperty Key="LOCK_IN" Value="0"/>
            <FlexDesigner:HiddenProperty Key="DESCR" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR1" Value=""/>
            <FlexDesigner:HiddenProperty Key="DESCR2" Value=""/>
            <FlexDesigner:HiddenProperty Key="EU" Value=""/>
            <FlexDesigner:HiddenProperty Key="MODE" Value="0"/>
          </FlexDesigner:HiddenPropertiesContainer>
        </FlexDesigner:DesignerItem.HiddenProperties>
      </Grid>

    </ItemsControl.Items>
  </FlexDesigner:Toolbox>
</Expander>
  