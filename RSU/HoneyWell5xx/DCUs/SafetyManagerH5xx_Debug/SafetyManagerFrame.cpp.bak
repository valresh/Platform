int KSafetyManagerFrame::OnCreate(LPCREATESTRUCT lpCreateStruct)
{
  if (CFrameWnd::OnCreate(lpCreateStruct) == -1)
    return -1;

  //AfxGetApp()->m_pMainWnd = this;
  // TODO:  Add your specialized creation code here
  //EnableDocking(CBRS_ALIGN_ANY);

  if( !m_wndStatusBar.Create(this) || !m_wndStatusBar.SetIndicators(indicators, _countof(indicators)) )
  {
    TRACE0("Failed to create status bar\n");
    return -1;      // fail to create
  }

  m_wndStatusBar.SetPaneInfo( 0,IDS_DEBUGTEXT , SBPS_NORMAL |SBPS_STRETCH, 425);

  return 0;
}
enum
{
SECINMINUTE = 60,
SECINHOUR = 3600,
};

void KSafetyManagerFrame::OnUpdateUI(CCmdUI *pCmdUI)
{
  switch( pCmdUI->m_nID )
  {
  case ID_VIEW_POINTS:
    //pCmdUI->SetCheck( m_wndWorkspace.IsWindowVisible() ? 1 : 0 );
    break;
  case IDS_DEBUGTEXT:
    pCmdUI->SetText( FormText() );
    break;
  }
}

CString KSafetyManagerFrame::FormText()
{
  CString cValue;
  if( !m_pDocument || !m_pDocument->m_pOwner )
    return cValue;
  IFscStorage *pCur = m_pDocument->m_pOwner;
  double h = pCur->GetTimeAccum();
  double secs = h * 3600.;
  int nElapsed = (int)secs;
  int nHour = nElapsed / SECINHOUR, nReminder = nElapsed - nHour * SECINHOUR;
  int nMinute = nReminder / SECINMINUTE;
  int nSec = nReminder - nMinute * SECINMINUTE;

  secs *= 1000.;
  nElapsed = (int)secs;
  nElapsed = nElapsed % 1000;

  LPCSTR szFormat = "%02d:%02d:%02d.%03d %f %I64d";

  cValue.Format( szFormat, nHour, nMinute, nSec, nElapsed, h, pCur->GetNSteps() );
  return cValue;
}

void KSafetyManagerFrame::OnTimer(UINT_PTR nIDEvent)
{
  m_wndStatusBar.SetPaneText( 0, FormText() );
  __super::OnTimer(nIDEvent);
}

void KSafetyManagerFrame::OnPowerUpValue()
{
  if( !m_pDocument )
    return;
  UINT nItem = 0;
  IFscStorage *pCur = m_pDocument->m_pOwner;
  for( LFscBase* base = pCur->GetItem( nItem ); base; ++nItem, base = pCur->GetItem( nItem ) )
  {
    int nName = -1;
    SDotValue* pV = NULL;
    switch( base->mT )
    {
    case 0x46://BI
      {
        SPointIn* data = (SPointIn*)pCur->FscGiveData( base->nBuff );
        nName = data->nDbf;
        pV = pCur->DotV(data->nOut);
      }
      break;
    case 0x47://BO
      {
        SPointOut* data = (SPointOut*)pCur->FscGiveData( base->nBuff );
        nName = data->nDbf;
        pV = pCur->DotV(data->nIn);
      }
      break;
    default:
      continue;
    }
    if( !pV )
      continue;
    LPCSTR pszVal = pCur->DbfName( nName, 24 );
    if( !pszVal || !*pszVal )
      continue;
    switch( pV->eType )
    {
    case enumValueDbl:
      pV->dVal = atof( pszVal );
      break;
    case enumValueBol:
      pV->bVal = atoi( pszVal )!=0 ? true : false;
      break;
    default:
      ASS(0);
    }
  }
}
