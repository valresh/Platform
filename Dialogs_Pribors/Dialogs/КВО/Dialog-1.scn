%
% Диалог стандартного КВО с дренажём на выходе
%
<header color=dbe5ed size=630,262 code=3>
%------------------------------------------------------------------------------
<image="@Выходная часть КВО" rc=320,24,293,204>
%------------------------------------------------------------------------------
<Objects="КВО">
  <KvoST=Вкл/Выкл  pt= 10,20 image="Включение прибора">
  <KvoST=Показания pt=170,24 image="Показания прибора" scale=0.8>
  %
  <font=a height=15 bold=900>
    <#if="Выходной дренаж">
      <KvoST="Выходной дренаж" pt=318,161 image="Дренажный Вентиль">
      <KvoSH rc=323,206,60,20 >// Процент открытия вентиля
      <KvoSH rc=298,227,120,20 type=1>// Вещество вытекаемое через вентиль
    <#endif>
  </font>
  %
  <font=a height=22 bold=900>
  <LabelD rect=0,0,320,30>
  </font>
</Objects>
