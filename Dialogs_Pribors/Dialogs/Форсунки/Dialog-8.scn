%------------------------------------------------------------------------------
%
% Вызов пламени форсунки
%
<header color=0 size=200,300 code=3>
%------------------------------------------------------------------------------
<brush=004060>
  <pen=solid color=0>
    <round=20 rect=30,30,170,270>
    <ellipse=70,220,130,240>
    <ellipse=80,225,120,235>
  </pen>
</brush>
%
<Objects="Форсунка">
  <ForsAvi=.0 rect=0,0,200,300 image=Пламя>
  <ForsSH =.0 rc=-50,250,40,30 type=2 image="@prev" dlg=8>
  <ForsSH =.0 rc=210,250,40,30 type=3 image="@next" dlg=8>
  <ForsSH =.0 rc=-50,10,40,40  type=5 image="@prev" dir=right>
</Objects>
%------------------------------------------------------------------------------
