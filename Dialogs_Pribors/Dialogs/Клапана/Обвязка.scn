%------------------------------------------------------------------------------
%
% Сценарий обвязки клапана
%
%------------------------------------------------------------------------------
<Objects="Клапан">
% Задвижки
<font=a height=20 bold=900>
  <#if="Входная задвижка">
    <#if="Шаровая задвижка">
      <KlapST=Вход pt=130,260 image="Шаровая Задвижка">
    <#else>
      <KlapST=Вход pt=130,262 image="Простая Задвижка">
      <KlapSH rc=160,330,100,20>
    <#endif>
  <#endif>
  %
  <#if="Выходная задвижка">
    <#if="Шаровая задвижка">
      <KlapST=Выход pt=500,260 image="Шаровая Задвижка">
    <#else>
      <KlapST=Выход pt=500,262 image="Простая Задвижка">
      <KlapSH rc=530,330,100,20>
    <#endif>
  <#endif>
  %
<#if="Пусковой байпас">
    <#if="Шаровая задвижка">
      <KlapST=Байпас pt=210,514 image="Шаровая Задвижка">
    <#else>
      <KlapST=Байпас pt=210,516 image="Простая Задвижка">
      <KlapSH=.3 rc=240,585,100,20>
    <#endif>
    <#if="Шаровая задвижка">
      <KlapST=Байпас2 pt=410,514 image="Шаровая Задвижка">
    <#else>
      <KlapST=Байпас2 pt=410,516 image="Простая Задвижка">
      <KlapSH=.14 rc=440,585,100,20>
    <#endif>
  <#else>
  <#if="Байпасная задвижка">
    <#if="Шаровая задвижка">
      <KlapST=Байпас pt=310,515 image="Шаровая Задвижка">
    <#else>
      <KlapST=Байпас pt=310,517 image="Простая Задвижка">
      <KlapSH rc=340,585,100,20>
    <#endif>
  <#endif>
  <#endif>
  %
%Ammiak-2   <#if="Пусковой байпас">
%Ammiak-2     <#if="Шаровая задвижка">
%Ammiak-2       <KlapST="Пусковой байпас" pt=350,670 image="Шаровая Задвижка" scale=0.50>
%Ammiak-2     <#else>
%Ammiak-2       <KlapST="Пусковой байпас" pt=350,671 image="Простая Задвижка" scale=0.50>
%Ammiak-2       <KlapSH rc=340,710,100,20>
%Ammiak-2     <#endif>
%Ammiak-2   <#endif>
</font>
% Дренажные вентили на входе, выходе и манометр на выходе
<font=a height=16 bold=900>
  <#if="Входной дренаж">
    <KlapST="Входной дренаж" pt=295,325 image="Дренажный Вентиль">
    <KlapSH rc=275,375,100,20>
    <KlapSH rc=250,400,120,20 type=2>// Вещество вытекаемое через вентиль
  <#endif>
  <#if="Выходной дренаж">
    <KlapST="Выходной дренаж" pt=475,325 image="Дренажный Вентиль">
    <KlapSH rc=455,375,100,20>
    <KlapSH rc=430,400,120,20 type=2>// Вещество вытекаемое через вентиль
  <#endif>
  <#if="Выходное давление">
    <KlapST="Выходное давление" pt=700,80 image=Манометр delta=-1>
  <#endif>
</font>
</Objects>
%------------------------------------------------------------------------------
