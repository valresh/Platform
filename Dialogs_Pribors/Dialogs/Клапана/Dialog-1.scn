%------------------------------------------------------------------------------
%
% Диалог клапана с гидравлическим дублёром
%
%------------------------------------------------------------------------------
<include=Header>
%------------------------------------------------------------------------------
<textcolor=0>
<font=a height=16 bold=900>
  <draw="Клапан" rc="10,10,80,25" align=cv>
</font>
<frame=0 rc=10,10,80,50>
%------------------------------------------------------------------------------
<Objects="Клапан">
  <KlapST="Гидравлическая помпа" pt=320,20 image="Гидравлический дублёр">
  <KlapST="Положение помпы"      pt=480,40 image="Направление качания">
  <KlapST="Байпас по воздуху"    pt=380,70 image="Вентилёк" step=4 direct=right>
  <KlapST="Байпас по маслу"      pt=408,38 image="Вентилёк" step=4 direct=right>
  <KlapST="Байпас по воздуху"    pt=328,80 image="Вентиль">                     
  <KlapST="Байпас по маслу"      pt=328,38 image="Вентиль">                     
  %
  <font=a height=14 bold=900>
  <KlapSH=.5 rect=430,70,490,90>
  <KlapSH=.6 rect=430,40,490,60>
  </font>
  %
  <include=Обвязка>
  %
  <font=a height=16 bold=900>
  <KlapSH=.0  rc=10,35,80,25>
  </font>
  %
  <font=a height=22 bold=900>
    <LabelD rc=100,0,200,40>
  </font>
</Objects>
%------------------------------------------------------------------------------
