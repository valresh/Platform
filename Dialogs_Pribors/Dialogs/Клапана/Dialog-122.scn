  <draw="Клапан" rc="10,10,80,25" align=cv>
</font>
<frame=0 rc=10,10,80,50>
%------------------------------------------------------------------------------
<Objects="Клапан">
  %
  <include=Обвязка>
  %
  <font=a height=16 bold=900>
  <KlapSH=.0  rc=10,35,80,25>
 %<KlapSH=.4  rc=10,35,80,25>
  </font>
  %
  <font=a height=22 bold=900>
    <LabelD rc=100,0,200,40>
  </font>
  <DataST=. shift="#Зацепление"         pt=470,20 image="Zaceplen" zalip=0>
  <DataST=. shift="#Зацепление"         pt=440,40 image="Зацепление дублёраКнопка" zalip=0>
  <DataST=. shift="#Положение колеса дублера" pt=320,20 image="Дублёр с зацеплением">
