%------------------------------------------------------------------------------
%
% Диалог электрического клапана с линейным дублёром и пультом открытия/закрытия
%
<header bitmap=".@KlapDubler.png" code=3>
%------------------------------------------------------------------------------
<textcolor=0>
<font=a height=16 bold=900>
  <draw="Клапан" rc="205,275,85,25" align=cv>
</font>
<frame=0 rect=205,275,295,325>
<GradRM="  5,350,295,380" count=3>
%------------------------------------------------------------------------------
<Objects="Клапан">
  <KlapST=Дублёр pt=" 70, 20" image="Дублёр с зацеплением" min=-100>
  <HsST="MV" pt=267,53  suff="-OP" set=1 image=OPEN_B>
  <HsST="MV" pt=267,130 suff="-CL" set=1 image=CLOSE_B>
  %
  <font=a height=16 bold=900>
  <KlapSH=.0 rect="205,300,290,325" type=0>
//<KlapSH=.4 rect="205,325,290,350" type=0>
//<KlapSH=.7 rect="205,350,290,375" type=0>
  <KlapSH=.4 rect=" 10,355,290,375" type=1>
  </font>
  %
  <font=a height=22 bold=900>
  <align=lt>
  <LabelD rect=0,0,300,30>
  </font>
</Objects>
%------------------------------------------------------------------------------
