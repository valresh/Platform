<textcolor=0>
<font=a height=16 bold=900>
  <draw="Open"   rc="250, 20,48,24" align=cv>
  <draw="Stop"   rc="250, 80,48,24" align=cv>
  <draw="Close"  rc="250,140,48,24" align=cv>
  <draw="Клапан" rc="205,275,85,25" align=cv>
</font>
<frame=0 rect=205,275,295,325>
<GradRC="260, 50,288, 74">
<GradRC="260,110,288,134">
<GradRC="260,170,288,194">
%------------------------------------------------------------------------------
<Objects="Клапан">
  <KlapST="Зацепленный дублёр"  pt=" 70, 20" image="Дублёр с зацеплениемNew" min=0 max=100>
  <KlapST="Зацепление"   pt=180,80 image="Зацепление дублёраNew">
  <KlapST=Открыть pt="260, 50" image="Кнопка красная" set=1>
  <KlapST=Остановить pt="260,110" image="Кнопка чёрная"  set=1>
  <KlapST=Закрыть pt="260,170" image="Кнопка чёрная"  set=1>
  %
  <font=a height=16 bold=900>
  <KlapSH=.0 rect="205,300,290,325" type=0>
  <KlapSH=.0 type=15  rc=100,30,80,25>
  
  
  </font>
  %
  <DataST=. shift="#Мест-Дист" pt=114,4   image="RuchkaDubler" zalip=0>
  <font=a height=22 bold=900>
  <align=lt>
  <LabelD rect=0,0,300,30>
  </font>
</Objects>
