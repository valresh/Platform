%------------------------------------------------------------------------------
%
% Диалог стандартного клапана сдвумя кнопками
% открыть закрыть
%------------------------------------------------------------------------------
<include=Header>
<image="@Регулирующий клапан" rc=320,20,132,320>
%------------------------------------------------------------------------------
<textcolor=0>
<font=a height=16 bold=900>
  <draw="Клапан" rc="10,10,80,25" align=cv>
</font>
<frame=0 rc=10,10,80,50>
%------------------------------------------------------------------------------
<Objects="Клапан">
  <include=Обвязка>
  % Показания регулирующего клапана
  <HsST="MV" pt=450,50  suff="-OP" image=OPEN_B>
  <HsST="MV" pt=450,120 suff="-CL" image=CLOSE_B>
  <font=a height=16 bold=900>
    <KlapSH=.0  rc=10,35,80,25>
  </font>
  %
  <font=a height=22 bold=900>
    <LabelD rc=280,0,200,40>
  </font>
</Objects>
%------------------------------------------------------------------------------
