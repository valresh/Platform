%------------------------------------------------------------------------------
%
% Диалог электро-задвижки
%
<header color=dbe5ed size=140,180 code=3>
%------------------------------------------------------------------------------
<textcolor=0>
<font=a height=16 bold=900>
  <draw="Open"   rc="70, 30,48,24" align=lv>
  <draw="Stop"   rc="70, 75,48,24" align=lv>
  <draw="Close"  rc="70,120,48,24" align=lv>
</font>
<GradRC="30, 30,58, 54">
<GradRC="30, 75,58, 99">
<GradRC="30,120,58,144">
%------------------------------------------------------------------------------
<Objects="Задвижка">
  <ZadvST=Открыть    pt="30, 30" image="Кнопка красная">
  <ZadvST=Остановить pt="30, 75" image="Кнопка чёрная">
  <ZadvST=Закрыть    pt="30,120" image="Кнопка чёрная">
  <font=a height=16 bold=900>
  <ZadvSH=.0 rect=0,160,140,180>
  </font>
  %
  <font=a height=22 bold=900>
  <LabelD rect=0,0,140,20>
  </font>
</Objects>
%------------------------------------------------------------------------------
