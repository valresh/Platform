% Диалог насоса Ярославля с двумя кнопками без тумблера и с амперметорм
%-----------------------------------------------------------------------------------
<header color=0 bitmap=".@bigScafWithPribor.png" code=3>
%-----------------------------------------------------------------------------------
<macros=RM param0=110 param1=40>
  <rect=paramx,paramy,paramx+param0,paramy+param1>
  <rect=paramx+2,paramy+2,paramx+param0-2,paramy+param1-2>
  <word="param2"
   rect=paramx+2,paramy+2,paramx+param0-2,paramy+param1-2 a=cv>
</macros>
<RM= 47,20 par0=100 par1=30 par2="">
<Objects="Пульт">
<PumpST=. shift=Открыть image="GreenKnopka" pt=65,280 set=1>
<PumpST=. shift=Остановить image="RedKnopka" pt=65,354 set=1>
<PumpST=. shift=Амперметр image=Манометр pt=97,105  ManomType=6 radius=50 min=0 max=1 denom=100>
<font=Arial bold=900 height=16>
<PumpSH=. rc=47,20,100,30 type=7> 
</font>
</Objects>